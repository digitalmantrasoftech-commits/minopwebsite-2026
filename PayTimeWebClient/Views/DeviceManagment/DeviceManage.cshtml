
@{
    ViewBag.Title = "DeviceManage";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
  ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
  : "false"; // Default to "false" if the session is null
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            @if (isClientDBMatchFlag == "True")
            {
                <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
            }
            else
            {
                <a href="/Dashboard/AdminDashboard"><i class="fa-regular fa-house"></i></a>
            }            
        </li>
        <li>
            <span><i class="fa-light fa-angle-right"></i> Device Management</span>
        </li>
    </ul>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="portlet light bordered">
            <div class="portlet-title">
                <div class="caption">
                    <i class="icon-bubble font-green-sharp"></i>
                    <span class="caption-subject font-green-sharp bold uppercase">Device Management</span>
                </div>
                
            </div>
            <div class="portlet-body">
                <div id="tree_2" class="tree-demo"> </div>
            </div>
        </div>
    </div>
</div>