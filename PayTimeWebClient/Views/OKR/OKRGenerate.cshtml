    function validateKeyPresskeyinput(keyinput) {
        var keyCode = keyinput;
        // Allow alphanumeric characters
        if ((keyCode >= 48 && keyCode <= 57) || (keyCode >= 65 && keyCode <= 90)
          || (keyCode >= 97 && keyCode <= 122)) {
            return true;
        }
        // Allow specific special characters: +, -, %, & ,.,,-,(,),""
        if (keyCode === 43 || keyCode === 45 || keyCode === 37 || keyCode === 38 || keyCode === 46 || keyCode === 44 || keyCode === 95 || keyCode === 39 || (keyCode === 57 && shiftKey) || (keyCode === 48 && shiftKey) || (keyCode === 222 && shiftKey)) {
            return true;
        }
        // Allow backspace and space
        if (keyCode === 8 || keyCode === 32) {
            return true;
        }
        return false;
    }

    function validateKeyPresskeyinputfortitle(keyinput) {
        var keyCode = keyinput;
        // Allow alphanumeric characters
        if ((keyCode >= 48 && keyCode <= 57) || (keyCode >= 65 && keyCode <= 90) || (keyCode >= 97 && keyCode <= 122)) {
            return true;
        }
        // Allow specific special characters: +, -, %, &, ., ,, _, ',(,),""
        if (keyCode === 43 || keyCode === 45 || keyCode === 37 || keyCode === 38 ||
            keyCode === 46 || keyCode === 44 || keyCode === 95 || keyCode === 39 || (keyCode === 57 && shiftKey) || (keyCode === 48 && shiftKey) || (keyCode === 222 && shiftKey)) {
            return true;
        }
        // Allow backspace and space
        if (keyCode === 8 || keyCode === 32) {
            return true;
        }
        return false;
    }
