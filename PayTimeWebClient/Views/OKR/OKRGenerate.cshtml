    function calculateTotalWeightage(objectiveId, additionalWeightage) {
        let totalWeightage = 0;

        $('#okr_list_' + objectiveId + '  .no_bd_radius .portlet-body .okr_acc_based[id^="kr_weightage_"]').each(function () {
            const weightageText = $(this).text().trim(); // Get the text
            const weightage = parseInt(weightageText.split(":")[1]) || 0; // Extract the weightage value
            totalWeightage += weightage;
        });

        // Add the additional weightage outside the loop, after calculating existing weightages
        totalWeightage += additionalWeightage - 0;
        return totalWeightage;
    }
    function FillEmpReporting(selectedEmployeeID) {
        var _urlcmp = '/MasterData/EmployeeGetReporting';
