@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "OKRGenerate";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _webapiurlokr = ConfigurationManager.AppSettings["webapiurlokr"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _userid = HttpContext.Current.Session["UserId"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _companyid = 0;
    int _branchid = 0;
    int _empid = 0;
    int _departmentid = 0;
    if (_RoleId == 6805 || _RoleId == 6806)
    {
        _companyid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"].ToString());
        _branchid = Convert.ToInt32(HttpContext.Current.Session["BranchId"].ToString());

    }
    else if (_RoleId > 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _companyid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"].ToString());
        _branchid = Convert.ToInt32(HttpContext.Current.Session["BranchId"].ToString());
        _empid = Convert.ToInt32(HttpContext.Current.Session["EmpId"].ToString());
        _departmentid = Convert.ToInt32(HttpContext.Current.Session["DepartmentId"].ToString());
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();    
}
<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">
<script src="~/Newlayout/js/pako.min.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>

<style type="text/css">
    @@import url("../Newlayout/css/CustomDesign/mysubscription.css");
</style>

<style>
    .form-group .select2 {
        width: 100% !important;
    }

    .tooltips {
        position: relative;
    }

        .tooltips .fa-info-circle {
            color: #007bff;
            cursor: pointer;
        }

    .tooltip-text {
        visibility: hidden;
        width: 230px;
        background-color: #F60B0B;
        color: #fff;
        text-align: center;
        border-radius: 4px !important;
        padding: 5px;
        position: absolute;
        z-index: 1;
        bottom: -12px;
        left: 0;
        margin-left: -240px;
        opacity: 0;
        transition: opacity 0.3s;
    }

        .tooltip-text:after {
            position: absolute;
            top: 13px;
            right: -7px;
            display: inline-block !important;
            border-top: 7px solid #fff;
            border-left: 7px solid #F60B0B;
            border-bottom: 7px solid #fff;
            content: '';
        }

    .tooltips:hover .tooltip-text {
        visibility: visible;
        opacity: 1;
    }
</style>

