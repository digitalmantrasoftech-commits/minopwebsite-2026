    function exportToExcel() {
        const table = document.getElementById('okrreviewtbl');
        const rows = table.querySelectorAll('tr');

        const data = [];
        const headersFirstRow = [];
        const headersSecondRow = [];

        // Extracting headers from the table
        const headerRow = rows[0];
        const headerCells = headerRow.querySelectorAll('th');
        for (let i = 0; i < headerCells.length; i++) {
            headersFirstRow.push(headerCells[i].innerText);
        }
        data.push(headersFirstRow);

        // Extracting the second row of headers
        const secondHeaderRow = rows[1];
        const secondHeaderCells = secondHeaderRow.querySelectorAll('th');
        for (let i = 0; i < secondHeaderCells.length; i++) {
            headersSecondRow.push(secondHeaderCells[i].innerText);
        }

        const updatedHeadersSecondRow = [...headersSecondRow]; // Create a copy to store the updated headers

        updatedHeadersSecondRow.unshift('EmpDetails', 'EmpID', 'AssignOKR');

        // Remove the three positions after the fixed columns
        updatedHeadersSecondRow.splice(3, 3);

        const existingMonthNames = headersSecondRow.filter(function (key) {
            return key.match(/^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)-\d{2}$/);
        });

        // Remove existing month names from updatedHeadersSecondRow
        const filteredHeaders = updatedHeadersSecondRow.filter(function (key) {
            return !key.match(/^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)-\d{2}$/);
        });

        const monthNames = existingMonthNames; // Assuming monthNames is calculated elsewhere in your code based on data

        // Add dynamic month headers to the updated headers array
        monthNames.forEach(function (month) {
            filteredHeaders.push(month);
        });

        // Push additional headers to the updated headers array
        filteredHeaders.push('Total', 'ManagerGiven');

        const wb = XLSX.utils.book_new();

        for (let k = 1; k < rows.length; k++) {
            const row = rows[k];
            const rowData = [];
            const cells = row.querySelectorAll('td');
            for (let j = 0; j < cells.length-1; j++) {
                rowData.push(cells[j].innerText);
            }
            data.push(rowData);
        }

        const ws = XLSX.utils.aoa_to_sheet(data);

        XLSX.utils.sheet_add_aoa(ws, [filteredHeaders], { origin: 'A2' });

        XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');

        const wbout = XLSX.write(wb, { bookType: 'xlsx', bookSST: true, type: 'binary' });

        function s2ab(s) {
            const buf = new ArrayBuffer(s.length);
            const view = new Uint8Array(buf);
            for (let i = 0; i < s.length; i++) view[i] = s.charCodeAt(i) & 0xFF;
            return buf;
        }

        const fileName = 'OKRReview.xlsx';
        saveAs(new Blob([s2ab(wbout)], { type: 'application/octet-stream' }), fileName);
    }

