    function SaveReview() {
        if ($("#review_score").val().trim() == "") {
            $("#review_score").addClass('field_error');
            $("#review_score").focus();
            return false;
        }
        else {
            $("#review_score").removeClass('field_error');
        }
        var flag_type = $("#review_type").val();
        if (flag_type == 1)
        {
            var weightage = parseInt($("#div_KR_weightage").text().trim());
            var score = parseInt($("#review_score").val());
            if (score > weightage) {
                toastr.remove();
                toastr.error("Score should not be greater than weighatge.");
                return false;
            }
        }
        var per = "";

        if ($("#review_type").val() == 2) {
            var review_score = parseFloat($("#review_score").val()); // Getting the review score as a floating-point number
            var weightage = parseFloat($("#div_KR_weightage").text().trim()); // Getting weightage as a floating-point number

            var total_marks = 100; // Assuming the maximum score is out of 100
            // Converting percentage into marks
            var marks = (review_score / total_marks) * weightage;
            per = marks; // Assigning marks to 'per'
        } else {
            per = $("#review_score").val();
        }
        if(disflag == 1)
        {
            return false;
        }

        var obj = {
            "EmpID": $("#empid_review").val(),
            "EmpName": $("#empname_review").val(),
            "DesignationId": $("#Designationid_review").val(),
            "objectiveId": $("#obj_id_review").val(),
            "KRId": $("#KR_id_review").val(),
            "review_type": $("#review_type").val(),
            "score": per,
            "description": $("#notes_review").val(),
            "Weightage": $("#div_KR_weightage").text().trim(),
            "review_status":4
        };
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurlokr' + 'Objectve/SaveOKRReview',
            data: JSON.stringify(obj),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                if (response.success == true) {
                    toastr.remove();
                    toastr.success("Note has been saved sucessfully;employees are not allowed to upload it again.");
                    $('#reviewnotes_modal').modal('toggle');

                    if (Saveflag == 1) {
                        var empId = $('#empid').text();
                        var effecteddate = $("#Effectedfrom").val();
                        GetOKRempwise(empId, effecteddate, 0);
                    }
                    else {
                        var empId = $('#empid').text();
                        getassignobjectiveKR(empId, 0);
                    }
                    frmclearOKRReview();
                }
                if (response.success == false) {
                    toastr.remove();
                    toastr.error(response.message);
                    $('#reviewnotes_modal').modal('toggle');
                }
            },
            error: function () {
                $("#ajax_loader").hide();
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }
