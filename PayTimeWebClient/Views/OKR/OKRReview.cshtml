    function bindEffectedFromDropdown() {
    // Make an AJAX request to get the active transaction year
    $.ajax({
        url: '@_webapiurl' + 'Master/GetActiveTransactionYear',  // Replace with your actual API endpoint
        method: 'GET',
        headers: { 'Authorization': '@_tokan' },
        contentType: "application/json; charset=utf-8",
        dataType: 'json',
        success: function (response) {
            if (response && response.length > 0) {
                // Parse the FromDate and ToDate from the response
                var fromDate = new Date(response[0].FromDate);  // Start date from the transaction year
                var toDate = new Date(response[0].ToDate);      // End date from the transaction year

                // Set initial month and year based on FromDate
                var currentMonth = fromDate.getMonth(); // Get the month (0-11)
                var currentYear = fromDate.getFullYear(); // Get the year

                // Populate the dropdown with months from FromDate to ToDate
                var lastMonth = toDate.getMonth(); // Get the last month (0-11)
                var lastYear = toDate.getFullYear(); // Get the last year

                // Loop to fill the months between FromDate and ToDate
                while (currentYear < lastYear || (currentYear === lastYear && currentMonth <= lastMonth)) {
                    // Create the formatted date for the first day of the current month
                    var formattedDate = currentYear + '-' + ('0' + (currentMonth + 1)).slice(-2) + '-01';

                    // Create the option element
                    var option = $('<option>', {
                        value: formattedDate, // Set the date as value (first day of the month)
                        text: GetMonthFullName(currentMonth) + ' ' + currentYear
                    });

                    // Append the option to the dropdown
                    $("#Effectedfrom").append(option);

                    // Move to the next month
                    currentMonth++;

                    // If currentMonth exceeds December (11), move to the next year
                    if (currentMonth > 11) {
                        currentMonth = 0;
                        currentYear++;
                    }
                }
                // Set the default value to the current month (if within the range)
                var _gmonth = new Date().getMonth() + 1;
                if (_gmonth.toString().length == 1) {
                    $("#Effectedfrom").val(new Date().getFullYear() + "-0" + _gmonth + "-01");
                } else {
                    $("#Effectedfrom").val(new Date().getFullYear() + "-" + _gmonth + "-01");
                }
            } else {
                toastr.error("No transaction year data available.");
            }
        },
        error: function (jqXHR, status, error) {
            // Improved error handling based on response status
            switch (jqXHR.status) {
                case 500: // InternalServerError
                    toastr.error("Internal Server Error occurred.");
                    break;
                case 400: // BadRequest
                    toastr.error("Bad Request. Please check the input parameters.");
                    break;
                case 401: // Unauthorized
                    window.location.href = "/PayTime/LoginPage"; // Redirect to login
                    break;
                default:
                    toastr.error("An error occurred: " + jqXHR.statusText);
                    break;
            }
        }
    });
    }

