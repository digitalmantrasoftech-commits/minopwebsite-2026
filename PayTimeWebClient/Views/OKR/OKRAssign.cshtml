@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "OKRAssign";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _webapiurlokr = ConfigurationManager.AppSettings["webapiurlokr"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _userid = HttpContext.Current.Session["UserId"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _companyid = 0;
    int _branchid = 0;
    if (_RoleId == 6805 || _RoleId == 6806 || _RoleId > 1)
    {
        _companyid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"].ToString());
        _branchid = Convert.ToInt32(HttpContext.Current.Session["BranchId"].ToString());

    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
}

<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<style type="text/css">
    #okrassigntbl thead tr:nth-child(2) th:nth-child(1) .search_input,
    #okrassigntbl thead tr:nth-child(2) th:nth-child(1) i,
    #okrassigntbl thead tr:nth-child(2) th:nth-last-child(-n+3) .search_input,
    #okrassigntbl thead tr:nth-child(2) th:nth-last-child(-n+3) i {
        display: none;
    }

    .search-dropdown {
        width: 100%;
        padding: 3px 3px 3px 6px;
        box-sizing: border-box;
        border: 1px solid #dddddd;
        border-radius: 3px !important;
        font-size: 12px;
        font-weight: 300;
        position: relative;
    }

    .modal-open { /* ap problem fix of modal */
        overflow-y: auto !important;
    }
</style>

<script type="text/javascript">
    var table = "";
    var emprole = '@_RoleId';
    var flag = 0;
    var $Companyselect = "";
    var $Branchselect = "";
    var $Departmentselect = "";
    var CompIdlst = "";
    var DeptIdlst = "";
    var BranchIdlst = "";
    var cmpid = '@_companyid';
    var brnid = '@_branchid';
    var selectedcompNames = [];
    var selectedbrnname = [];
    var selecteddeptnames = [];
    var targetperiod = ["Please Select"];
    var empidassign = "";
    $(document).ready(function () {
        targetperiod.push("Quarterly", "Monthly", "Yearly");
        //$("#OKR_assigntbl").css('display', 'none');
        $("#tblempty").hide();
        $Companyselect = $("#CompanyID").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Company'

        });
        $Branchselect = $("#BranchIds").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Branch'

        });
        $Departmentselect = $("#DeptIds").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Department',

        });
        //$("#applied_filter").hide();
        fillcompany();
        if (emprole > 1 && emprole != 6805 && emprole != 6806 && emprole != 6000) {
            // show the loader first
            $(".loading").show();
            setTimeout(function () {
                fillBranchbycompnyid(cmpid, brnid);
                fillDeptTable(brnid, '');
                var dept = DeptIdlst.replace(/\s/g, '');
                var obj = {
                    "Userid": "@_userid",
                    "Roleid": "@_RoleId",
                    "Companyid": cmpid,
                    "Branchid": brnid,
                    "Departmentid": ''
                }
                $(".loading").show(); // Show loader
                tableGet(obj);
                $(".div_head_1").hide();
                $('.attendance_selected_emp').html('<div class="selected_list">Selected Employee: <span id="selectedemp"></span></div><div class="selected_list_btn"><a href="javascript:;" class="btn add_btn margin-right-15" id="MulAssignOkr"> Assign OKR </a><a href="javascript:;" class="btn add_btn white_btn" id="MulClearBtn">Clear</a></div>');
                $('div.tbl_text').html('<div class="dft_view">Default View</div>');
                $(".loading").hide();
            }, 0);//  loader
        }
        // assign text click event assigned employee show.
        $(document).on('click', '.assign_text', function () {
            var index = $(this).attr('id').replace('ass_text_', '');
            var obj_id = $("#obj_chk_" + index).text().trim();
            $("#obj_right").css('display', 'none');
            GetAssignedemployee(obj_id, index);
        });
        // close button click the modal  div close of assign objectives.
        $(document).on('click', '#assobjbtn', function () {
            $("#ass_obj_block").css('display', 'none');
            $("#obj_right").css('display', 'block');
            $("#modal_Btn").css('visibility', 'visible');
        });
        GetObjective();
        getobjectiveassign();
        // click method of assign objective.
        $(document).on('click', '#OpenModalAssign', function (e) {
            clearModalContent();
            e.preventDefault();
            $('#Objective_modal').modal('show');
            var rowData = table.row($(this).closest('tr')).data();
            GetAssignObjectiveEmpwise(rowData["EmpID"]);
            getKRdetailsEmpWise(rowData["EmpID"]);
            empidassign = rowData["EmpID"];
        });
        // close function of the assignobjective datatable refresh
        $(document).on('click', '#assign_obj_modal_lst', function (e) {
            // Check if the DataTable instance exists before attempting to reload
            if ($.fn.DataTable.isDataTable('#okrassigntbl')) {
                $('#okrassigntbl').DataTable().ajax.reload();
            } else {
                // Handle the case where the DataTable instance is not initialized
                console.error('DataTable instance not found or not initialized.');
            }
        });

        $(document).on("input", "#search_assign_objective", function () {
            var searchText = $(this).val().trim().toLowerCase(); // Trim and convert search text to lowercase

            $('#ul_obj_assign_list #li_obj_assign_list').each(function (index) {
                var listItemText = $(this).text().trim().toLowerCase(); // Trim and convert list item text to lowercase
                // Check if the list item text contains the search text
                if (listItemText.includes(searchText)) {
                    var $checkbox = $(this).find('.objselect_assign');
                    if (!$checkbox.prop('checked')) {
                        // Remove the closest li element when checkbox is unchecked
                        $(this).hide();
                        var $okrAcc = $("#acc_box_assign_" + index);
                        $okrAcc.hide();
                    }
                    else {
                        $(this).show(); // Show the list item if it matches the search text
                        var $okrAcc = $("#acc_box_assign_" + index);
                        $okrAcc.show();
                    }
                } else {
                    $(this).hide(); // Hide the list item if it does not match the search text
                    var $okrAcc = $("#acc_box_assign_" + index);
                    $okrAcc.hide();
                }
            });

            // Show all list items if search input is empty
            if (searchText === '') {
                $('#ul_obj_assign_list li').show();
                $('#ul_obj_assign_list #li_obj_assign_list').each(function (index) {
                    var $checkbox = $(this).find('.objselect_assign');
                    if (!$checkbox.prop('checked')) {
                        // Remove the closest li element when checkbox is unchecked
                        $(this).hide();
                        var $okrAcc = $("#acc_box_assign_" + index);
                        $okrAcc.hide();
                    }
                });
            }
        });

        // Filtersearch click  filter hide/show
        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        // clear opertaion  dropdown
        $("#clear_operation").click(function () {
            $("#CompanyID").val('0');
            $("#txt5").val('0');
            $Companyselect.multiselect('rebuild');
            $("#BranchIds").val('0');
            $("#BranchIds option:selected").prop("selected", false);
            $("#BranchIds").multiselect('refresh');
            $("#BranchIds").empty();
            $("#BranchIds").multiselect('disable');
            //BranchIds
            $("#txt2").val(0);
            $("#DeptIds").val('0');
            $("#DeptIds option:selected").prop("selected", false);
            $("#DeptIds").multiselect('refresh');
            $("#DeptIds").empty();
            $("#DeptIds").multiselect('disable');
            //departmentid
            $("#txt3").val(0);
        });


        // OKR remove assign objective
        $(document).on('click', '[id^="remove_assign_obj_"]', function () {
            var index = $(this).attr("id").replace("remove_assign_obj_", "");
            var objectiveid = $("#obj_chk_assign_" + index).text();
            var IsActive = false;
            var empid = empidassign;
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlokr' + 'Objectve/RemoveAssignObjective/' + objectiveid + '/' + IsActive + '/' + empid,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (response) {
                    if (response.success == true) {
                         toastr.remove();
                         toastr.success("Assigned objective removed sucessfully.");
                        $('#Objective_modal').modal('show');
                        setTimeout(function () {
                            GetAssignObjectiveEmpwise(empid);
                        }, 100);
                    }
                    if (response.success == false) {
                        toastr.remove();
                        toastr.error(response.message);
                        $('#Objective_modal').modal('show');
                    }
                },
                error: function () {
                    $(".loading").hide();
                },
                complete: function () {
                    $(".loading").hide();
                }
            });

        });
        //okr list assign click event

        // click event of oke title collapse class and aria expanded
        $(document).on('click', '[id^="okr_acc_assign_"]', function () {
            var index = $(this).attr("id").replace("okr_acc_assign_", "");

            // Check if the element has the class "in"
            if ($("#okr_list_assign_col_" + index).hasClass('in')) {
                // If it has the class, remove it and set aria-expanded to 'false'
                $("#okr_list_assign_col_" + index).removeClass('in');
                $("#okr_list_assign_col" + index).attr('aria-expanded', 'false');
            } else {
                // If it doesn't have the class, add it and set aria-expanded to 'true'
                $("#okr_list_assign_col_" + index).addClass('in');
                $("#okr_list_assign_col_" + index).attr('aria-expanded', 'true');
            }
        });
        $("#btnapply").click(function (event) {
            if ($("#CompanyID").val() == "" || $("#CompanyID").val() == null) {
                toastr.remove();
                toastr.error("Please  select company.");
                event.preventDefault();
                return false;
            }
            if ($("#BranchIds").val() == "" || $("#BranchIds").val() == null) {
                toastr.remove();
                toastr.error("Please  select branch.");
                event.preventDefault();
                return false;
            }



            $("#fltrSearchdrpEmpID").val(0);
            $("#fltrSearchdrpDesg").val(0);
            $("#fltrSearchdrpDesg").val(0);

            if (emprole > 1 && emprole != 6805 && emprole != 6806 && emprole != 6000) {
                var dept = DeptIdlst.replace(/\s/g, '');
                var obj = {
                    "Userid": "@_userid",
                    "Roleid": "@_RoleId",
                    "Companyid": cmpid,
                    "Branchid": brnid,
                    "Departmentid": dept
                }
            }
            else {
                var dept = DeptIdlst.replace(/\s/g, '');
                var obj = {
                    "Userid": "@_userid",
                    "Roleid": "@_RoleId",
                    "Companyid": CompIdlst,
                    "Branchid": BranchIdlst,
                    "Departmentid": dept
                }
            }
            $(".loading").show();

            setTimeout(function () {
                // Create search inputs in footer ================
                tableGet(obj);
                $(".loading").hide();
                $(".div_head_1").hide();
                $('.attendance_selected_emp').html('<div class="selected_list">Selected Employee: <span id="selectedemp"></span></div><div class="selected_list_btn"><a href="javascript:;" class="btn add_btn margin-right-15" id="MulAssignOkr"> Assign OKR </a><a href="javascript:;" class="btn add_btn white_btn" id="MulClearBtn">Clear</a></div>');
                $('div.tbl_text').html('<div class="dft_view">Default View</div>');
                //$("#applied_filter").show();
                $("#appl_com").text(selectedcompNames.join(', '));
                $("#appl_brn").text(selectedbrnname.join(', '));
                $("#appl_dept").text(selecteddeptnames.join(', '));
            }, 10)
        });
        //by click div head 1 OKR modal open and close.
            
        $('body').on('click', '#MulAssignOkr', function () {
            frmclearOKRassign();
            $("#MulAssignOkr").attr("data-toggle", "modal");
            $("#MulAssignOkr").attr("data-target", "#assign_okrModal");
            getAssignobjective();
            $(".assign_text span").text("0");
            $("#lstcon").css('display', 'none');
            $("#div_total_weightage").css('display', 'none');
            $("#selectemployee").text($("#chkempall:checked").length);
            flag = 1;
        });

        // if all  datatable rows click then  all check box clicked
        $('#okrassigntbl tbody').on('change', 'input[type="checkbox"]', function () {
            if ($('#okrassigntbl tbody input[type="checkbox"]:checked').length === table.rows().count()) {
                // If all rows are selected, check the "select all" checkbox
                $('#selectall').prop('checked', true);
            } else {
                // If not all rows are selected, uncheck the "select all" checkbox
                $('#selectall').prop('checked', false);
            }
        });
        //Save Assign Objective
        $("#btnsave").click(function () {
            SaveOKRASSign();
        });
        //employee id search fiilter
        $(document).on('change', '#fltrSearchdrpEmpID', function () {
            var empIDFilter = $(this).val(); // Using $(this) to refer to the element triggering the event

            if (empIDFilter === '0') {
                table.column(1).search('').draw();
            } else {
                table.column(1).search(empIDFilter).draw();
            }
        });
        //designation serach filter

        $(document).on('change', '#fltrSearchdrpDesg', function () {
            var desgfltr = $('#fltrSearchdrpDesg').val();
            // If "All" is selected, clear the designation filter
            if (desgfltr === '0') {
                table.column(3).search('').draw();
            } else {
                // Otherwise, perform the search based on the selected value
                table.column(3).search(desgfltr).draw();
            }
        });

        $(document).on('change', '#fltrSearchdrpObjective', function () {
            var objfltr = $('#fltrSearchdrpObjective').val();
            if (objfltr === '0') {
                table.column(4).search('').draw();
            }
            else {
                table.column(4).search(objfltr).draw();
            }
        });

        // Apply the Search ================
        $("#okrassigntbl thead").on("keyup", "input", function () {
            var columnIndex = $(this).closest('th').index();
            table.column(columnIndex).search(this.value).draw();
        });

        // Modal Open Close Code ================
        $("#okrassigntbl").on('click', '.assign_okr', function () {
            var rowData = table.row($(this).closest('tr')).data();
            GetObjectiveEmpwise(rowData["EmpID"]);
            getAssignobjective();
            $(".assign_text span").text("0");
            $("#Empname").val(rowData["Empname"]);
            $("#EmpID").val(rowData["EmpID"]);
            $("#Designationid").val(rowData["Designationid"]);
            frmclearOKRassign();
            $(".assign_okr").attr("data-toggle", "modal");
            $(".assign_okr").attr("data-target", "#assign_okrModal"); 
            $("#lstcon").css('display', 'none');
            $(".accordion_box_main").css('display', 'none');
            $("#div_total_weightage").css('display', 'none');
            $("#selectemployee").text(1);
            var anyCheckboxChecked = $(".objselect:checked").length > 0;
            var objData = $("#obj_img_data");
            if (anyCheckboxChecked) {
                objData.hide();
            } else {
                objData.css("display", "flex");
            }
            flag = 0;
        });
        // check box objective checked.
        $("body").on('change', ".objselect", function () {
            $("#obj_img_data").css('display', 'none');
            // Hide all data inside "accordion_box_main"
            $(".accordion_box_main").hide();
            $("#lstcon").show();
            $("#div_total_weightage").show();
            // Loop through all elements with class "objselect"
            $(".objselect").each(function () {
                var isChecked = $(this).prop('checked');
                var $objData = $(this).closest('.objselect');
                var objDataId = $objData.attr('id').replace('obj_select_', "");
                var $okrAcc = $("#acc_box_" + objDataId);
                var initialTotalWeightage = parseFloat($("#ttlweightage").text()) || 0;
                if (initialTotalWeightage > 100) {
                    $("#obj_select_" + objDataId).prop('checked', false);
                }
                if (isChecked) {
                    $okrAcc.css('display', 'block');
                } else {
                    $okrAcc.css('display', 'none');
                }
            });
        });
        // By clicking clear Button.
        $('body').on('click', '#MulClearBtn', function () {
            $(".Selectallemp").prop('checked', false);
            $("#selectall").prop('checked', false);
            $("#selectedemp").text('0'); // Update the text to '0'
            $(".div_head_1").css('display', 'none'); // Hide the element with ID 'div_head_1'
            $(".div_head_2").css('display', 'block'); // Show the element with ID 'div_head_2'
            $('.assign_okr').prop('disabled', false);
        });
        // All check box checked.
        $(document).on("change", "#selectall", function () {
            if ($(this).is(":checked")) {
                var numberOfCheckedCheckboxes = 0;
                $("#okrassigntbl #chkempall").each(function () {
                    $(this).prop('checked', true);
                    $('.assign_okr').prop('disabled', true);
                    numberOfCheckedCheckboxes++;
                });
                if (emprole == 1 || emprole == 6805 || emprole == 6806) {
                    $(".div_head_1").hide();
                }
                else {
                    if (numberOfCheckedCheckboxes > 1)
                    {
                        $(".div_head_1").show();
                    }
                }
                $(".div_head_2").hide();
                $("#selectedemp").html(numberOfCheckedCheckboxes);
            } else {
                $("#okrassigntbl .ClsChkEmp").each(function () {
                    $(this).prop('checked', false);
                    if (emprole == 1 || emprole == 6805 || emprole == 6806) {
                        $('.assign_okr').prop('disabled', true);
                    }
                    else {
                        $('.assign_okr').prop('disabled', false);
                    }
                });
                $(".div_head_2").show();
                $(".div_head_1").hide();
            }
        });
        //by clicking checkbox the div_head_1 head show.
        $('#okrassigntbl').on('change', '#chkempall', function () {
            if ($('#chkempall:checked').length > 1) {
                if (emprole == 1 || emprole == 6805 || emprole == 6806) {
                    $(".div_head_1").hide();
                }
                else {

                    $(".div_head_1").show();
                }
                $(".div_head_2").hide();
                $("#selectedemp").html($('#chkempall:checked').length);
                $("#okrassigntbl #chkempall").each(function () {
                    $('.assign_okr').prop('disabled', true);
                });
            } else {
                $(".div_head_2").show();
                $(".div_head_1").hide();
            }
        });
        // on clicking remove fileds.
        $("body").on('click', "a[title='Remove fields']", function () {
            var id = $(this).closest('[id^="okr_acc_"]').attr('id').replace('okr_acc_', ''); // Get the closest parent element with an ID starting with "okr_acc_"
            if (id) {
                var objWeightageField = $("#obj_weightage_" + id);
                var weightageValue = parseFloat(objWeightageField.val()) || 0;
                $("#acc_box_" + id).hide(); // Remove the element with the dynamic ID accordation box
                $("#obj_select_" + id).prop('checked', false);
                var totalWeightage = parseFloat($("#ttlweightage").text()) || 0;
                totalWeightage -= weightageValue;
                $("#ttlweightage").text(totalWeightage === 0 ? "00" : totalWeightage);
                // Clear the value of the input field
                objWeightageField.val('');
            }
            else {
                $("#acc_box_" + id).show();
                $("#obj_select_" + id).prop('checked', true);
            }
            var numChecked = $(".objselect:checked").length;

            if (numChecked === 0) {
                // No checkboxes are checked, so show the image with class "img_obj"
                $("#obj_img_data").css('display', 'flex');
                $("#lstcon").css('display', 'none');
                $("#div_total_weightage").css('display', 'none');
                $("#ttlweightage").text("00");
                $("[id^='obj_weightage_']").val("");
            } else {
                // At least one checkbox is checked, so hide the image with class "img_obj"
                $("#obj_img_data").css('display', 'none');
                $("#lstcon").css('display', 'block');
                $("#div_total_weightage").css('display', 'flex');
            }
        });

        //weightage numeric key input.
        $(document).on("keypress", "[id^='obj_weightage_']", function (e) {
            var keyCode = e.which;
            // Allow only numeric keys (0-9) and some special keys (e.g., backspace, delete, left, right, etc.)
            if (keyCode < 48 || keyCode > 57) {
                // Prevent the input if it's not a numeric key
                e.preventDefault();
            }
        });
        //$("body").on('change', "[id^='obj_weightage_']", function () {
        //    calculateTotalWeightage();
        //});

        //backbtn click
        $("#Btnback").click(function () {
            $("#assignedokr_Modal").modal('hide');
        });
        // btnsave preview click function
        $("#btnsavepreview").click(function () {
            savemultiplepreview();
        });
        // weightage 0 to 100.
        $(document).on("input", "[id^='obj_weightage_']", function (e) {
            var value = $(this).val();

            // Remove any non-numeric characters and convert to a number
            var floatValue = parseFloat(value);

            // Constrain the value to be between 0 and 100
            if (isNaN(floatValue) || floatValue <= 0 || floatValue > 100) {
                $(this).val(''); // Set the input field to blank
            } else {
                // Update the input field with the constrained value
                $(this).val(floatValue);
            }
        });
        // Btnreset click

        $("#btnReset").on('click', function () {
            $("#lstcon").css('display', 'none');
            $("#div_total_weightage").css('display', 'none');
            frmclearOKRassign();
        });
        // company id change event
        $('#CompanyID').change(function () {
            var s = $('#CompanyID').val();
            $('#CompanyName').val($("#CompanyID option:selected").text());
            fillBranchbycompnyid(s, "");
            $("#DeptIds").empty();
            $Departmentselect.multiselect('rebuild');
            var branid = $('#CompanyID option:selected');
            var CompanyArray = [];
            $(branid).each(function (index, branid) {
                CompanyArray.push([$(this).val()]);
            });
            if (CompanyArray == "") {
                $("#txt5").val(0);
            }
            else {
                $("#txt5").val(CompanyArray);
            }
            var Arrbranch = $("#txt5").val();
            CompIdlst = Arrbranch;

            $('#CompanyID option:selected').each(function () {
                selectedcompNames.push($(this).text()); // Add selected names to the array
            });
        });
        $('#BranchIds').change(function () {
            $("#spvalidation").hide();
            var s = $('#BranchIds').val();
