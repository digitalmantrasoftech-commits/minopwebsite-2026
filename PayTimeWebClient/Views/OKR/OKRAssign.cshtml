            dataType: "json",
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                $(".loading").hide();
                accordionContainer.empty();
                if (response != null && response.length > 0) {
                    response.forEach(function (data, index) {
                        var empPhotoIdpreview = "emp_photo_" + index;
                        var itemphoto = data.EmpPhoto ? "/UploadEmpPhoto/" + data.EmpPhoto.trim() : "/assets/images/avtar.png";
                        var review_box = $('<div class="p_databox">' +
                            '<div class="p_list">' + data.Empcode + '</div>' +
                            '<div class="p_list serch_datatable ">' +
