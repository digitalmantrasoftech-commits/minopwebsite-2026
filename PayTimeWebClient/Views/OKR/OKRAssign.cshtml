                            '<div class="p_list">' + data.Title + '</div>' +
                            '</div>');
                        accordionContainer.append(review_box);
                        $("#" + empPhotoIdpreview).attr('src', itemphoto);
                    });
                    $("#assignedokr_Modal").modal('show');

                    callback(1); // Call the callback function with the value 1
                }
                else {
                    callback(0); // Call the callback function with the value 0
                }
            },
            error: function () {
                $(".loading").hide();
                $("#assignedokr_Modal").modal('show');
                callback(1); // Call the callback function with the value 1 in case of an error
            },
            complete: function () {
                $(".loading").hide();
            }
        });
    }

    // Dropdown function fill objectives.
    function Fillobjectivedrp() {
        $.ajax({
            type: "GET",
            url: '@_webapiurlokr' + 'Objectve/GetOKRAssigndrpdetails/' + '@_userid' + '/' + '@_RoleId' + '/' + '@_companyid' + '/' + '@_branchid',
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response && response.length > 0) {
                    var selectElement = $('#fltrSearchdrpObjective');
                    selectElement.empty(); // Clear existing options
                    selectElement.append("<option value='0' selected>All</option>");
                    var uniqueObjectives = {}; // Object to store unique Assignobjectives
                    for (var i = 0; i < response.length; i++) {
                        if (response[i].Assignobjective !== 0 && !uniqueObjectives[response[i].Assignobjective] && response[i].Assignobjective != null) {
                            // Add options to the select element if it's not already present
                            uniqueObjectives[response[i].Assignobjective] = true;
                            selectElement.append("<option value='" + response[i].Assignobjective + "'>" + response[i].Assignobjective + "</option>");
                        }
                    }
                    selectElement.append("<option value = 'NIL' >NIL</option>")
                }
            },
            error: function () {
                $(".loading").hide();
            },
            complete: function () {
                $(".loading").hide();
            }
        });
    }
    function bindSearchInputs() {
        $("#okrassigntbl thead tr:eq(1) th").each(function (index) {
            if (index == 0) {
                $(this).html('<input type="checkbox" class="chkall ClsChkEmp" value="" id="selectall" >');
            }
            else if (index == 1) {
                $(this).html('<select class="search-dropdown" id="fltrSearchdrpEmpID"></select>');
            }
            else if (index == 3) {
                $(this).html('<select class="search-dropdown" id="fltrSearchdrpDesg"></select>');
            }
            else if (index == 4) {
                $(this).html('<select class="search-dropdown" id="fltrSearchdrpObjective"></select>');
            }
            else {
                var title = $(this).text();
                $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search"></i>');
            }
        });
    }
