        //if (totalWeightage > 100) {
        //    // Show a validation message or perform necessary actions
        //    toastr.remove("");
        //    toastr.error("Total weightage cannot exceed 100.");
        //    return false; // Exit function if validation fails
        //}
        if (objectiveIds == "") {
            toastr.remove("");
            toastr.error("Please select at least one objectives.");
            return false;
        }

        // Initialize arrays to store data
        var obj = [];

        // Check if multiple employees are selected
        if (flag == 1) {
            if ($("#okrassigntbl #chkempall:checked").length > 1) {
                var _assignkrlst = 0;
                var _Assigncntlst = 0; // Default value
                $("#okrassigntbl #chkempall:checked").each(function () {
                    var row = $(this).closest('tr');
                    var EmpID = $(this).val();
                    if (_assignkrlst == 0) {
                        _assignkrlst = EmpID;
                    }
                    else {
                        _assignkrlst += "," + EmpID;
                    }
                });

                var objIds = [];
                var weightageStrings = [];
                // Iterate over weightage inputs and objective IDs
                $(".accordian-header input[name='obj_weightage']").each(function () {
                    var weightageValue = $(this).val();
                    if (weightageValue) {
                        weightageStrings.push(weightageValue);
                        // Extract the associated objective ID from the same accordion
                        var $parentAccordion = $(this).closest(".accordion_box_main");
                        if ($parentAccordion.css("display") === "block") {
                            var objectiveId = $parentAccordion.find("span[id^='obj_id_']").text().trim();
                            objIds.push(objectiveId);
                        }
                    }
                });
                GetAssignObjectiveEmpwiseModal(_assignkrlst, objIds, function (result) {
                    _Assigncntlst = result;
                    // Handle _Assigncntlst value here or call other functions based on it
                    if (_Assigncntlst === 0) {
                        saveOKRassigndata();
                    }
                });
            }
        }
        else if (flag == 0) {
            // Only one employee is selected
            var objIds = [];
            var weightageStrings = [];

            // Retrieve objective IDs and their weightages
            $(".accordian-header input[name='obj_weightage']").each(function () {
                var weightageValue = $(this).val();
                if (weightageValue) {
                    weightageStrings.push(weightageValue);

                    // Extract the associated objective ID from the same accordion
                    var $parentAccordion = $(this).closest(".accordion_box_main");
                    if ($parentAccordion.css("display") === "block") {
                        var objectiveId = $parentAccordion.find("span[id^='obj_id_']").text().trim();
                        objIds.push(objectiveId);
                    }
                }
            });

            // Create data objects for each combination of objective ID and weightage
            for (var i = 0; i < objIds.length; i++) {
                var designationIdValue = $("#Designationid").val();
                var parsedDesignationId = !isNaN(parseInt(designationIdValue)) && designationIdValue !== undefined ? parseInt(designationIdValue) : 0;
                var data = {
                    "EmpID": $("#EmpID").val(),
                    "EmpName": $("#Empname").val(),
                    "Designationid": parsedDesignationId,
                    "Assignobjective": weightageStrings[i],
                    "ObjectiveId": objIds[i],
                    "AssignCreatedate": $("#Effectedfrom").val(),
                    "IsActive": true
                };
                // Add the data object to the obj array
                obj.push(data);
            }
            // Send the data as an array of objects
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlokr' + 'Objectve/SaveOKRAssign',
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (response) {
                    //if (response.success == true) {
                    //
                    //    toastr.remove();
                    //    toastr.success("Successfully assigned objectives.");
                    //    $('#assign_okrModal').modal('toggle');
                    //    $('#okrassigntbl').DataTable().ajax.reload();
                    //    Fillobjectivedrp();
                    //    $(".div_head_1").css('display', 'none'); // Hide the element with ID 'div_head_1'
                    //    $(".div_head_2").css('display', 'block'); // Show the element with ID 'div_head_2'
                    //}
                    //else if (response.success == false) {
                    //    toastr.remove();
                    //    toastr.error(response.message);
                    //    $('#assign_okrModal').modal('toggle');
                    //    $('#okrassigntbl').DataTable().ajax.reload();
                    //}
                    var successCount = 0;
                    var failCount = 0;
                    var successMessages = [];
                    var failMessages = [];

                    for (var i = 0; i < response.length; i++) {
                        var currentResponse = response[i];
                        if (currentResponse.responseCode === 201) {
                            successCount++;
                            successMessages.push(currentResponse.message);
                        } else if (currentResponse.responseCode === 210) {
                            failCount++;
                            failMessages.push("OKR Assign already exists.");
                        } else if (currentResponse.responseCode === 212) {
                            failCount++;
                            failMessages.push("Total weightage shouldn't exceed 100.");
                        }
                        else if (currentResponse.responseCode === 213) {
                            failCount++;
                            failMessages.push("You can assign objectives to a maximum of 10 employees. No further assignments are allowed.");
                        }
                        else {
                            failCount++;
                            failMessages.push("Error occurred while creating OKR assign.");
                        }
                    }

                    toastr.remove();

                    if (successCount > 0 && failCount === 0) {
                        // All successful uploads
                        toastr.success(" Successfully assigned " + successCount + " objectives.");
                    } else if (failCount > 0 && successCount === 0 && currentResponse.responseCode === 210) {
                        // All failed uploads
                        toastr.error("OKR Assign already exists.");
                    }
                    else if (failCount > 0 && successCount === 0 && currentResponse.responseCode === 212) {
                        // All failed uploads
                        toastr.error("Total weightage shouldn't exceed 100.");
                    }
                    else if (failCount > 0 && successCount === 0 && currentResponse.responseCode === 213) {
                        // All failed uploads
                        toastr.error("You can assign objectives to a maximum of 10 employees. No further assignments are allowed.");
                    }
                    else if (successCount >= 1 && failCount >= 1) {
                        toastr.success(" Successfully assigned " + successCount + " objectives." + "    "  + failCount + " Error occurred while creating OKR assign.");
                    } else {
                        // Mixed results or single upload
                        if (successCount > 0) {
                            toastr.success("Successfully assigned " + successCount + " objectives.");
                        }
                        if (failCount > 0) {
                            toastr.error(failCount + " Error occurred while creating OKR assign.");
                        }
                    }
                    $('#assign_okrModal').modal('hide');
                    $('#assignedokr_Modal').modal('hide');
                    $('#okrassigntbl').DataTable().ajax.reload();
                    Fillobjectivedrp();
                    $(".div_head_1").css('display', 'none'); // Hide the element with ID 'div_head_1'
                    $(".div_head_2").css('display', 'block'); // Show the element with ID 'div_head_2'
                    $("#selectall").prop('checked', false);
                },
                error: function () {
                    $(".loading").hide();
                },
                complete: function () {
                    $(".loading").hide();
                }
            });
        }

    }
