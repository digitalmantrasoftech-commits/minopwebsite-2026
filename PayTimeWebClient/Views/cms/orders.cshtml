    function renderBudgetBar(data) {
        if (!data) return;

        var percentage = data.usagePercentage || 0;
        var barClass = 'progress-bar-success';
        if (data.isLimitReached) {
            barClass = 'progress-bar-danger';
        } else if (data.isWarning) {
            barClass = 'progress-bar-warning';
        }

        var limitText = data.isUnlimited ? 'Unlimited' : formatCurrency(data.monthlyLimit);
        var html = '';

        if (data.isLimitReached && !data.isUnlimited) {
            html += '<div class="alert alert-danger" style="margin-bottom:15px;">';
            html += '<strong>Monthly Credit Limit Reached!</strong><br>';
            html += 'Your monthly credit limit of ' + formatCurrency(data.monthlyLimit) + ' has been reached.<br>';
            html += 'Current Spend: ' + formatCurrency(data.currentSpend) + ' | Remaining: ' + formatCurrency(data.remainingBudget) + '<br>';
            html += '<small>Ordering will resume on the 1st of next month. Contact HR for limit adjustment.</small>';
            html += '</div>';
        }

        html += '<div class="portlet" style="margin-bottom:16px;">';
        html += '<div class="portlet-body">';
        html += '<div class="row">';
        html += '<div class="col-sm-6"><strong>Monthly Budget</strong> (' + (data.monthName || '') + ' ' + (data.year || '') + ') <a href="javascript:;" onclick="viewMyPolicy()" class="btn margin-left-15 trans_btnnew"><i class="fa-regular fa-shield-check"></i> View Policy</a></div>';
        html += '<div class="col-sm-6 text-right"><strong>' + formatCurrency(data.currentSpend) + '</strong> / ' + limitText + '</div>';
        html += '</div>';

        if (!data.isUnlimited) {
            html += '<div class="progress" style="margin:8px 0; height:16px;">';
            html += '<div class="progress-bar ' + barClass + '" role="progressbar" style="width:' + Math.min(percentage, 100) + '%; line-height:16px;">';
            html += percentage.toFixed(1) + '%';
            html += '</div></div>';
            html += '<div class="row text-muted" style="font-size:12px;">';
            html += '<div class="col-xs-4">Remaining: <strong>' + formatCurrency(data.remainingBudget) + '</strong></div>';
            html += '<div class="col-xs-4 text-center">Orders: <strong>' + (data.orderCount || 0) + '</strong></div>';
            html += '<div class="col-xs-4 text-right">Subsidy: <strong>' + formatCurrency(data.subsidyReceived) + '</strong></div>';
            html += '</div>';
        } else {
            html += '<div class="text-muted" style="font-size:12px;">No spending limit | Orders: <strong>' + (data.orderCount || 0) + '</strong> | Subsidy: <strong>' + formatCurrency(data.subsidyReceived) + '</strong></div>';
        }

        html += '</div></div>';
        $('#budgetBarSection').html(html);
    }

    // ==================== Employee: View Policy ====================

    function viewMyPolicy() {
        checkSession();
        $('#policyDetailBody').html('<div style="text-align:center;padding:30px;"><i class="fa-thin fa-spinner fa-spin fa-2x"></i></div>');
        $('#policyDetailModal').modal('show');

        $.ajax({
            url: _webapiurl + 'allocations/employee/' + EmpId,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (data) {
                renderPolicyDetail(data);
            },
            error: function (xhr) {
                var msg = "Unable to load policy details";
                if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;
                $('#policyDetailBody').html('<div class="alert alert-warning">' + msg + '</div>');
            }
        });
    }

    function renderPolicyDetail(data) {
        if (!data || !data.policyId) {
            $('#policyDetailBody').html(
                '<div class="policy-empty-state">' +
                '<div class="policy-empty-icon"><i class="fa-light fa-shield-xmark"></i></div>' +
                '<h5>No Policy Assigned</h5>' +
                '<p class="text-muted">No canteen policy has been assigned to you yet.<br>Please contact your HR department for assistance.</p>' +
                '</div>'
            );
            return;
        }

        var html = '';

        // Policy Info Card
        html += '<div class="policy-info-card">';
        html += '<div class="policy-info-row">';
        html += '<div class="policy-info-item">';
        html += '<span class="policy-info-label"><i class="fa-light fa-tag"></i> Policy Name</span>';
        html += '<span class="policy-info-value">' + (data.policyName || '-') + '</span>';
        html += '</div>';
        html += '<div class="policy-info-item">';
        html += '<span class="policy-info-label"><i class="fa-light fa-wallet"></i> Monthly Limit</span>';
        html += '<span class="policy-info-value policy-limit-badge">' + (data.monthlyLimit || '<span class="policy-unlimited-tag">Unlimited</span>') + '</span>';
        html += '</div>';
        html += '<div class="policy-info-item">';
        html += '<span class="policy-info-label"><i class="fa-light fa-calendar-check"></i> Allocated On</span>';
        html += '<span class="policy-info-value">' + (data.allocatedDate ? formatDateDisplay(data.allocatedDate) : '-') + '</span>';
        html += '</div>';
        html += '</div>';
        html += '</div>';

        // Subsidy per Slot Category
        html += '<div class="policy-section">';
        html += '<div class="policy-section-header">';
        html += '<h5 class="policy-section-title"><i class="fa-light fa-utensils"></i> Subsidy Per Meal Slot</h5>';
        html += '</div>';
        html += '<div class="row">';

        var slotCategories = [
            { key: 'breakfast', label: 'Breakfast', icon: 'fa-light fa-sunrise', color: '#f59e0b' },
            { key: 'lunch', label: 'Lunch', icon: 'fa-light fa-plate-utensils', color: '#10b981' },
            { key: 'snacks', label: 'Snacks', icon: 'fa-light fa-cookie', color: '#8b5cf6' },
            { key: 'dinner', label: 'Dinner', icon: 'fa-light fa-moon', color: '#3b82f6' }
        ];

        for (var i = 0; i < slotCategories.length; i++) {
            var slot = slotCategories[i];
            var subsidyValue = data[slot.key] || '-';
            var hasSubsidy = subsidyValue !== '-';
            html += '<div class="col-md-3 col-sm-6 col-xs-6">';
            html += '<div class="policy-slot-card' + (hasSubsidy ? ' policy-slot-active' : '') + '">';
            html += '<div class="policy-slot-icon" style="color:' + slot.color + ';background:' + slot.color + '15;">';
            html += '<i class="' + slot.icon + '"></i>';
            html += '</div>';
            html += '<div class="policy-slot-value ' + (hasSubsidy ? 'green_font' : 'darkgrey_font') + '">' + subsidyValue + '</div>';
            html += '<div class="policy-slot-label">' + slot.label + '</div>';
            html += '</div></div>';
        }

        html += '</div>';
        html += '</div>';

        // Assigned Canteens
        if (data.canteens && data.canteens.length > 0) {
            html += '<div class="policy-section">';
            html += '<div class="policy-section-header">';
            html += '<h5 class="policy-section-title"><i class="fa-light fa-store"></i> Assigned Canteens</h5>';
            html += '<span class="policy-canteen-count">' + data.canteens.length + ' canteen' + (data.canteens.length > 1 ? 's' : '') + '</span>';
            html += '</div>';
            html += '<div class="row">';
            for (var i = 0; i < data.canteens.length; i++) {
                html += '<div class="col-md-6 col-sm-6" style="margin-bottom:8px;">';
                html += '<div class="policy-canteen-card">';
                html += '<div class="policy-canteen-icon"><i class="fa-light fa-store"></i></div>';
                html += '<span class="policy-canteen-name">' + data.canteens[i].canteenName + '</span>';
                html += '</div></div>';
            }
            html += '</div>';
            html += '</div>';
        }

        $('#policyDetailBody').html(html);
    }

    // ==================== Employee: Load Menu Items ====================

    function loadMenuItems() {
        var canteenId = $('#OrderCanteenId').val();
        var orderDate = $('#OrderDate').val();
        var slotId = $('#OrderSlotId').val();

        if (!canteenId || !orderDate || !slotId) {
            $('#menuItemsTitle').hide();
            $('#menuItemsSection').html('<div class="menu-placeholder">Please select canteen, date and meal slot to see available items.</div>');
            return;
        }

        $('#menuItemsSection').html('<div style="text-align:center;padding:30px;"><i class="fa-thin fa-spinner fa-spin fa-2x"></i><p>Loading menu...</p></div>');

        $.ajax({
            url: _webapiurl + 'daily-menu/employee-view',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: { canteenId: canteenId, date: orderDate, mealSlotId: slotId },
            success: function (data) {
                renderMenuItems(data);
            },
            error: function (xhr) {
                var msg = "Failed to load menu";
                if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;
                $('#menuItemsSection').html('<div class="alert alert-warning">' + msg + '</div>');
            }
        });
    }

    function renderMenuItems(data) {
        $('#menuItemsTitle').show();
        currentMenuItems = data.meals || [];
        var slot = data.mealSlot || {};

        var html = '';

        // Slot info bar
        var slotCategory = '';
        if (slot.mealSlotId && canteenMealSlotsMap[slot.mealSlotId]) {
            slotCategory = canteenMealSlotsMap[slot.mealSlotId].slotCategoryName || '';
        }
        var selectedDate = $('#OrderDate').val();
        var today = formatDateApi(new Date());
        var dateLabel = selectedDate === today ? 'Today' : formatDateDisplay(selectedDate);

        html += '<div class="portlet" style="margin-bottom:10px;">';
        html += '<div class="portlet-body">';
        html += '<strong>' + (slot.slotName || '') + '</strong>';
        if (slotCategory) {
            html += ' <span class="text-muted" style="font-size:12px;">(' + slotCategory + ')</span>';
        }
        html += ' | <i class="fa-light fa-calendar"></i> ' + dateLabel;
        html += ' | Serving: ' + (slot.servingTime || '-');
        var cutoffDay = '';
        if (slot.mealSlotId && canteenMealSlotsMap[slot.mealSlotId]) {
            cutoffDay = canteenMealSlotsMap[slot.mealSlotId].cutoffDaysBefore === 1 ? ' (previous day)' : ' (same day)';
        }
        html += ' | Cutoff: ' + (slot.orderCutoffTime || '-') + cutoffDay;
        if (!slot.isOrderingOpen) {
            html += ' | <span class="text-danger">Ordering Closed</span>';
        } else {
            html += ' | <span class="text-success">Ordering Open</span>';
        }
        html += '</div></div>';

        if (!slot.isOrderingOpen) {
            html += '<div class="alert alert-danger">Order cutoff time has passed for this slot. You cannot place orders.</div>';
            $('#menuItemsSection').html(html);
            return;
        }

        if (currentMenuItems.length === 0) {
            html += '<div class="alert alert-info">No items available for this slot today.</div>';
            $('#menuItemsSection').html(html);
            return;
        }

        // Menu items as cards
        html += '<div class="row">';
        for (var i = 0; i < currentMenuItems.length; i++) {
            var item = currentMenuItems[i];
            var availText = '';
            if (item.remainingQty !== null && item.remainingQty !== undefined) {
                availText = '<small class="text-muted">' + item.remainingQty + ' left</small>';
            }
            var disabled = !item.isAvailable || (item.remainingQty !== null && item.remainingQty <= 0);
            var specialBadge = item.isSpecial ? ' <span class="badge badge-warning">Special</span>' : '';

            var mealImgSrc = item.imageUrl || '/assets/images/icon_food.svg';
            html += '<div class="col-md-6 col-lg-4 menu-card">';
            html += '<div class="menu-card-wrapper' + (disabled ? ' menu-card-disabled' : '') + '">';
            html += '<img src="' + mealImgSrc + '" alt="" class="menu-card-img" onerror="this.onerror=null; this.src=\'/assets/images/icon_food.svg\';">';
            html += '<div class="menu-card-content">';
            html += '<div class="menu-card-name">';
            html += '<span class="menu-card-name-text">' + getDietaryIcon(item.dietaryType, item.isJainFriendly) + ' ' + item.mealName + '</span>';
            if (item.isSpecial) { html += ' <span class="badge badge-warning">Special</span>'; }
            if (item.mealDescription) { html += ' <i class="fa-regular fa-circle-info text-muted" data-toggle="tooltip" data-placement="top" title="' + item.mealDescription.replace(/"/g, '&quot;') + '" style="cursor:pointer;font-size:13px;"></i>'; }
            html += '</div>';
            html += '<div class="menu-card-bottom">';
            html += '<div class="menu-card-price">' + formatCurrency(item.price) + (availText ? ' &nbsp;<small class="orange_font">(' + item.remainingQty + ' left)</small>' : '') + '</div>';
            if (!disabled) {
                html += '<div class="menu-card-right">';
                html += '<span class="menu-card-qty-label">Quantity</span>';
                html += '<input type="number" class="form-control input-sm text-center menu-card-qty" id="qty_' + item.dailyMenuId + '" value="1" min="1" max="' + (item.remainingQty || 100) + '">';
                html += '<button class="btn btn-sm save_btn menu-card-add-btn" onclick="addToCart(' + item.dailyMenuId + ')"><i class="fa-solid fa-plus"></i></button>';
                html += '</div>';
            } else {
                html += '<div class="menu-card-right"><span class="text-danger"><small>Unavailable</small></span></div>';
            }
            html += '</div>';
            html += '</div>';
            html += '</div></div>';
        }
        html += '</div>';

        $('#menuItemsSection').html(html);
        $('#menuItemsSection img').on('error', function () { this.src = '/assets/images/icon_food.svg'; });
        $('#menuItemsSection [data-toggle="tooltip"]').tooltip();
    }

    // ==================== Employee: Cart ====================

    function addToCart(dailyMenuId) {
        var item = null;
        for (var i = 0; i < currentMenuItems.length; i++) {
            if (currentMenuItems[i].dailyMenuId === dailyMenuId) {
                item = currentMenuItems[i];
                break;
            }
        }
        if (!item) return;

        var qty = parseInt($('#qty_' + dailyMenuId).val()) || 1;
        var maxQty = item.remainingQty;

        // Check if already in cart
        var existingIdx = -1;
        for (var i = 0; i < orderCart.length; i++) {
            if (orderCart[i].dailyMenuId === dailyMenuId) {
                existingIdx = i;
                break;
            }
        }

        // Validate against remaining quantity
        if (maxQty !== null && maxQty !== undefined) {
            var alreadyInCart = existingIdx >= 0 ? orderCart[existingIdx].quantity : 0;
            if (alreadyInCart + qty > maxQty) {
                var allowed = maxQty - alreadyInCart;
                if (allowed <= 0) {
                    toastr.warning("Only " + maxQty + " available for '" + item.mealName + "'. Already " + alreadyInCart + " in cart.");
                    return;
                }
                qty = allowed;
                toastr.info("Only " + allowed + " more available. Adjusted quantity.");
            }
        }

        if (existingIdx >= 0) {
            orderCart[existingIdx].quantity += qty;
        } else {
            orderCart.push({
                dailyMenuId: item.dailyMenuId,
                mealId: item.mealId,
                mealName: item.mealName,
                dietaryType: item.dietaryType,
                isJainFriendly: item.isJainFriendly || false,
                imageUrl: item.imageUrl || '',
                unitPrice: item.price,
                quantity: qty,
                remainingQty: maxQty
            });
        }

        updateCartBadge();
        shakeCartButton();
        toastr.success(item.mealName + ' added to order');
    }

    function shakeCartButton() {
        var $btn = $('#btnOpenCart');
        $btn.removeClass('cart-nudge');
        void $btn[0].offsetWidth;
        $btn.addClass('cart-nudge');
        $btn.one('animationend', function () {
            $btn.removeClass('cart-nudge');
        });
    }

    function updateCartBadge() {
        var count = orderCart.length;
        $('#cartCount').text(count);
        $('#btnOpenCart').prop('disabled', count === 0);
    }

    function removeFromCart(index) {
        orderCart.splice(index, 1);
        updateCartBadge();
        renderCart();
    }

    function updateCartQty(index, newQty) {
        if (newQty <= 0) {
            removeFromCart(index);
            return;
        }
        var maxQty = orderCart[index].remainingQty;
        if (maxQty !== null && maxQty !== undefined && newQty > maxQty) {
            toastr.warning("Only " + maxQty + " available for '" + orderCart[index].mealName + "'.");
            newQty = maxQty;
        }
        orderCart[index].quantity = newQty;
        renderCart();
    }

    function renderCart() {
        var countLabel = orderCart.length + ' item' + (orderCart.length !== 1 ? 's' : '');

        if (orderCart.length === 0) {
            $('#cartSection').html(
                '<div class="ct-empty-state">' +
                '<div class="ct-empty-icon"><i class="fa-light fa-cart-xmark"></i></div>' +
                '<p>No items in order. Add items from the menu.</p>' +
                '</div>'
            );
            $('#btnPlaceOrder').prop('disabled', true);
            $('#cartModalTitle').text('Order Cart');
            $('#cartItemCountLabel').text('0 items');
            return;
        }

        var html = '';
        html += '<div class="ct-items-section">';
        html += '<div class="ct-section-title"><i class="fa-light fa-utensils"></i> Cart Items</div>';

        var grossTotal = 0;
        for (var i = 0; i < orderCart.length; i++) {
            var c = orderCart[i];
            var itemTotal = c.unitPrice * c.quantity;
            grossTotal += itemTotal;
	    var cartImgSrc = c.imageUrl || '/assets/images/icon_food.svg';
            html += '<div class="ct-item-row">';
            html += '<div class="ct-item-left">';
            html += '<img src="' + cartImgSrc + '" alt="" style="width:30px; height:30px; border-radius:6px !important; object-fit:cover; border:1px solid #e7ecf1; flex-shrink:0;" onerror="this.onerror=null; this.src=\'/assets/images/icon_food.svg\';">';
            html += '<div>';
            html += '<div class="ct-item-name">' + getDietaryIcon(c.dietaryType, c.isJainFriendly) + ' ' + c.mealName + '</div>';
            html += '<div class="ct-item-unit-price">' + formatCurrency(c.unitPrice) + '</div>';
            html += '</div>';
            html += '</div>';
            html += '<div class="ct-item-right">';
            html += '<div class="ct-qty-control">';
            html += '<button type="button" class="ct-qty-btn" onclick="updateCartQty(' + i + ', ' + (c.quantity - 1) + ')"><i class="fa-solid fa-minus"></i></button>';
            html += '<span class="ct-qty-value">' + c.quantity + '</span>';
            html += '<button type="button" class="ct-qty-btn" onclick="updateCartQty(' + i + ', ' + (c.quantity + 1) + ')"><i class="fa-solid fa-plus"></i></button>';
            html += '</div>';
            html += '<div class="ct-item-total">' + formatCurrency(itemTotal) + '</div>';
            html += '<button type="button" class="ct-remove-btn tooltips" data-placement="top" data-original-title="Remove" onclick="removeFromCart(' + i + ')"><i class="fa-regular fa-trash-can"></i></button>';
            html += '</div>';
            html += '</div>';
        }

        html += '</div>';

        // Financial Summary
        html += '<div class="ct-summary-section">';
        html += '<div class="ct-summary-row"><span>Gross Total</span><span class="ct-summary-value">' + formatCurrency(grossTotal) + '</span></div>';
        html += '<div class="ct-summary-row ct-summary-note"><span><i class="fa-light fa-badge-percent"></i> Subsidy</span><span class="text-muted" style="font-size:12px;">Applied on placement</span></div>';
        html += '<div class="ct-summary-row ct-summary-net"><span>Estimated Total</span><span class="ct-summary-value">' + formatCurrency(grossTotal) + '</span></div>';
        html += '</div>';

        $('#cartSection').html(html);
        $('#btnPlaceOrder').prop('disabled', false);
        $('#cartModalTitle').text('Order Cart');
        $('#cartItemCountLabel').text(countLabel);
        $('.tooltips').tooltip();
    }

    // ==================== Employee: Place Order ====================

    function placeOrder() {
        checkSession();

        if (orderCart.length === 0) {
            toastr.warning("Please add at least one item to your order");
            return;
        }

        var canteenId = parseInt($('#OrderCanteenId').val());
        var slotId = parseInt($('#OrderSlotId').val());
        var orderDate = $('#OrderDate').val();
        var remarks = $('#OrderRemarks').val().trim() || null;

        if (!canteenId) { toastr.warning("Please select a canteen"); return; }
        if (!slotId) { toastr.warning("Please select a meal slot"); return; }
        if (!orderDate) { toastr.warning("Please select a date"); return; }

        // Check monthly limit
        if (employeeBalance && employeeBalance.isLimitReached && !employeeBalance.isUnlimited) {
            $('#cartModal').modal('hide');
            Swal.fire({
                html: '<div class="swal_subtitle"><b>Your monthly credit limit of ' + formatCurrency(employeeBalance.monthlyLimit) + ' has been reached. You cannot place new orders.</b></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Monthly Limit Reached",
                showCloseButton: true,
                confirmButtonText: 'OK',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class'
                }
            });
            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
            return;
        }

        var items = [];
        for (var i = 0; i < orderCart.length; i++) {
            items.push({
                dailyMenuId: orderCart[i].dailyMenuId,
                quantity: orderCart[i].quantity
            });
        }

        var payload = {
            canteenId: canteenId,
            mealSlotId: slotId,
            orderDate: orderDate,
            items: items,
            remarks: remarks
        };

        // Hide cart modal and show loading
        $('#cartModal').modal('hide');
        Swal.fire({
            html: '<div class="swal_subtitle"><i class="fa-thin fa-spinner fa-spin"></i> Calculating subsidy...</div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Confirm Order",
            showConfirmButton: false,
            allowOutsideClick: false,
            allowEscapeKey: false
        });

        // Call preview API to get subsidy breakdown, then show confirmation
        $.ajax({
            url: _webapiurl + 'orders/preview',
            type: 'POST',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (preview) {
                // Check monthly limit from preview
                if (preview.isWithinMonthlyLimit === false) {
                    Swal.fire({
                        html: '<div class="swal_subtitle"><b>This order exceeds your monthly credit limit. You cannot place this order.</b></div>',
                        title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Monthly Limit Exceeded",
                        showCloseButton: true,
                        confirmButtonText: 'OK',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        customClass: {
                            confirmButton: 'swal-confirm-button-class'
                        }
                    });
                    $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                    return;
                }

                showOrderConfirmation(preview, payload);
            },
            error: function (xhr) {
                var msg = "Could not fetch order preview";
                if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;

                // If it's a validation error (400/422), show error and re-open cart to fix
                if (xhr.status === 400 || xhr.status === 422) {
                    Swal.close();
                    toastr.error(msg);
                    $('#cartModal').modal('show');
                    return;
                }

                // If it's a conflict (409) - duplicate order, limit exceeded, stock exceeded
                if (xhr.status === 409) {
                    Swal.fire({
                        html: '<div class="swal_subtitle"><b>' + msg + '</b></div>',
                        title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Cannot Place Order",
                        showCloseButton: true,
                        confirmButtonText: 'OK',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        customClass: {
                            confirmButton: 'swal-confirm-button-class'
                        }
                    });
                    $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                    return;
                }

                // Fallback for non-validation errors (e.g. network/500): show confirmation without subsidy details
                toastr.error(msg);
                showOrderConfirmation(null, payload);
            }
        });
    }

    function showOrderConfirmation(preview, payload) {
        var totalQty = 0;
        for (var i = 0; i < orderCart.length; i++) { totalQty += orderCart[i].quantity; }
        var confirmHtml = '<div class="swal_subtitle"><b>Place this order with ' + totalQty + ' item(s)?</b>';
        if (preview) {
            confirmHtml += '<br><br>';
            confirmHtml += '<div style="text-align:left; font-size:14px; line-height:1.8;">';
            confirmHtml += 'Gross: ' + formatCurrency(preview.grossAmount) + '<br>';
            confirmHtml += 'Subsidy: <span style="color:#27ae60;">' + formatCurrency(preview.subsidyAmount) + '</span>';
            if (preview.policyName) confirmHtml += ' <small>(' + preview.policyName + ')</small>';
            confirmHtml += '<br>';
            confirmHtml += '<b style="font-size:15px;">You Pay: ' + formatCurrency(preview.netAmount) + '</b>';
            confirmHtml += '</div>';
            if (preview.projectedMonthlySpend && preview.projectedMonthlySpend.isWarning) {
                confirmHtml += '<div class="alert alert-warning" style="margin:8px 0 0; padding:6px 10px; font-size:12px; text-align:left;"><i class="fa-light fa-triangle-exclamation"></i> Approaching monthly limit. Remaining after this order: ' + formatCurrency(preview.projectedMonthlySpend.remainingBudget) + '</div>';
            }
        }
        confirmHtml += '</div>';

        Swal.fire({
            html: confirmHtml,
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Confirm Order",
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            confirmButtonText: 'Place Order',
            cancelButtonText: 'Cancel',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                submitOrder(payload);
            } else {
                // Re-open cart modal if user cancels
                $('#cartModal').modal('show');
            }
        });
        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
    }

    function submitOrder(payload) {
        $.ajax({
            url: _webapiurl + 'orders',
            type: 'POST',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            contentType: 'application/json',
            data: JSON.stringify(payload),
            beforeSend: function () {
                $('#btnPlaceOrder').prop('disabled', true).html('<i class="fa-thin fa-spinner fa-spin"></i> Placing Order...');
            },
            success: function (data) {
                // Show order confirmation
                var msg = 'Order placed successfully!';
                msg += '\nGross: ' + formatCurrency(data.grossAmount);
                msg += '\nSubsidy: ' + formatCurrency(data.subsidyAmount);
                msg += '\nYou Pay: ' + formatCurrency(data.netAmount);

                Swal.fire({
                    html: '<div class="swal_subtitle"><b>' + msg.replace(/\n/g, '<br>') + '</b></div>',
                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Order Placed!",
                    showCloseButton: true,
                    confirmButtonText: 'OK',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    customClass: {
                        confirmButton: 'swal-confirm-button-class'
                    }
                });
                $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');

                // Close cart modal and clear
                $('#cartModal').modal('hide');
                orderCart = [];
                updateCartBadge();
                $('#OrderRemarks').val('');

                // Refresh balance and menu
                loadEmployeeBalance();
                loadMenuItems();

                // Show warning from monthly spend
                if (data.monthlySpend && data.monthlySpend.isWarning) {
                    setTimeout(function () {
                        toastr.warning("You are approaching your monthly credit limit. Remaining: " + formatCurrency(data.monthlySpend.remainingBudget));
                    }, 1500);
                }
            },
            error: function (xhr) {
                var msg = "Failed to place order";
                if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;

                // Show swal for conflict errors (duplicate order, limit exceeded, stock exceeded)
                if (xhr.status === 409) {
                    Swal.fire({
                        html: '<div class="swal_subtitle"><b>' + msg + '</b></div>',
                        title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Cannot Place Order",
                        showCloseButton: true,
                        confirmButtonText: 'OK',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        customClass: {
                            confirmButton: 'swal-confirm-button-class'
                        }
                    });
                    $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                } else {
                    toastr.error(msg);
                }
            },
            complete: function () {
                $('#btnPlaceOrder').prop('disabled', false).html('<i class="fa-light fa-cart-shopping"></i> Place Order');
            }
        });
    }

    // ==================== Employee: My Orders ====================

    var myOrdersTable = null;

    function loadMyOrders() {
        if (myOrdersTable) {
            myOrdersTable.ajax.reload();
            return;
        }

        $("#ajax_loader").show();
        myOrdersTable = $('#tblMyOrders').DataTable({
            dom: _domCommon,
            language: _languageCommon,
            serverSide: true,
            searching: false,
            ordering: true,
            order: [[0, 'desc']],
            pageLength: 10,
            ajax: {
                url: _webapiurl + 'orders/my',
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + _tokan },
                data: function (d) {
                    var params = {
                        pageNumber: Math.floor(d.start / d.length) + 1,
                        pageSize: d.length,
                        month: $('#MyOrdersMonth').val() || (new Date().getMonth() + 1),
                        year: $('#MyOrdersYear').val() || new Date().getFullYear()
                    };

                    var status = $('#MyOrdersStatus').val();
                    if (status !== '') params.status = status;

                    return params;
                },
                dataFilter: function (rawData) {
                    var json = JSON.parse(rawData);
                    var dtResponse = {
                        recordsTotal: json.totalCount || 0,
                        recordsFiltered: json.totalCount || 0,
                        data: json.orders || []
                    };
                    return JSON.stringify(dtResponse);
                },
                dataSrc: function (response) {
                    var orders = response.data || [];
                    if (response.recordsTotal === 0) {
                        $('#tblMyOrdersBlock').hide();
                        $('#MyOrders-empty').show();
                    } else {
                        $('#tblMyOrdersBlock').show();
                        $('#MyOrders-empty').hide();
                    }
                    return orders;
                },
                error: function (xhr) {
                    $("#ajax_loader").hide();
                    var msg = "Failed to load orders";
                    if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;
                    toastr.error(msg);
                }
            },
            initComplete: function () {
                if ($('#buttons').length) {
                    $("#buttons").empty();
                    $("#buttons").append(
                        '<div id="export-button-myorders" class="export-button tooltips" data-placement="bottom" data-original-title="Download">' +
                        '<img src="../Newlayout/images/download_icon.svg" alt="Download icon">' +
                        '</div>'
                    );
                }
            },
            columns: [
                {
                    data: 'orderDate',
                    title: 'Date',
                    render: function (data) {
                        return formatDateDisplay(data);
                    }
                },
                {
                    data: 'canteenName',
                    title: 'Canteen',
                    render: function (data) {
                        return data || '-';
                    }
                },
                {
                    data: 'slotName',
                    title: 'Slot',
                    render: function (data) {
                        return data || '-';
                    }
                },
                {
                    data: null,
                    title: 'Items',
                    orderable: false,
                    render: function (data, type, row) {
                        return '<span title="' + (row.itemSummary || '') + '">' + (row.itemCount || 0) + ' item(s)</span>';
                    }
                },
                {
                    data: 'netAmount',
                    title: 'Net Amount',
                    render: function (data) {
                        return formatCurrency(data);
                    }
                },
                {
                    data: null,
                    title: 'Status',
                    render: function (data, type, row) {
                        return getStatusBadge(row.orderStatus, row.orderStatusDisplay);
                    }
                },
                {
                    data: null,
                    title: 'Action',
                    orderable: false,
                    render: function (data, type, row) {
                        var html = '<a class="btn btn-xs seagreen_btnnew tooltips" data-placement="top" data-original-title="View" onclick="viewOrderDetail(' + row.orderId + ')"><i class="fa-regular fa-eye"></i></a> ';
                        if (row.orderStatus === 0) {
                            html += '<a class="btn btn-xs red_btnnew tooltips" data-placement="top" data-original-title="Cancel" onclick="cancelOrder(' + row.orderId + ')"><i class="fa-regular fa-ban"></i></a>';
                        }
                        return html;
                    }
                }
            ],
            drawCallback: function () {
                $("#ajax_loader").hide();
                $('.tooltips').tooltip();
            }
        });
        $(document).off('click', '#export-button-myorders').on('click', '#export-button-myorders', function () {
            exportMyOrders();
        });
    }

    function exportMyOrders() {
        checkSession();
        var month = parseInt($('#MyOrdersMonth').val()) || (new Date().getMonth() + 1);
        var year = parseInt($('#MyOrdersYear').val()) || new Date().getFullYear();
        var status = $('#MyOrdersStatus').val();

        // Build date range from selected month/year
        var fromDate = year + '-' + ('0' + month).slice(-2) + '-01';
        var lastDay = new Date(year, month, 0).getDate();
        var toDate = year + '-' + ('0' + month).slice(-2) + '-' + ('0' + lastDay).slice(-2);

        var mainObj = {
            fromDate: fromDate,
            toDate: toDate
        };
        if (status !== '') mainObj.status = status;

        $.ajax({
            url: '/cms/ExportMyOrdersExcel',
            type: 'POST',
            data: JSON.stringify(mainObj),
            contentType: 'application/json',
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                if (response.success && response.filePath) {
                    window.location.href = response.filePath;
                } else {
                    toastr.error(response.message || "Failed to generate export file.");
                }
            },
            error: function () {
                toastr.error("An error occurred while exporting data.");
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }

    function cancelOrder(orderId) {
        checkSession();
        Swal.fire({
            html: '<div class="swal_subtitle"><b>Are you sure you want to cancel this order?</b></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Cancel Order",
            input: 'text',
            inputPlaceholder: 'Reason (optional)',
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            confirmButtonText: 'Cancel Order',
            cancelButtonText: 'Keep Order',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: _webapiurl + 'orders/' + orderId + '/cancel',
                    type: 'PUT',
                    headers: { 'Authorization': 'Bearer ' + _tokan },
                    contentType: 'application/json',
                    data: JSON.stringify({ reason: result.value || '' }),
                    success: function (data) {
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>Order cancelled successfully.</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Cancelled!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
                        loadMyOrders();
                        loadEmployeeBalance();
                    },
                    error: function (xhr) {
                        var msg = "Failed to cancel order";
                        if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;
                        toastr.error(msg);
                    }
                });
            }
        });
        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
    }

    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
</script>

