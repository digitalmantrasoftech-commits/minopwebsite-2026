@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    int _cmpid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapicms"].ToString();
    string _webapiurlMain = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _ChunkSize = HttpContext.Current.Session["DataDropDownThreShold"] != null
        ? HttpContext.Current.Session["DataDropDownThreShold"].ToString()
        : "500";

    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    string _companyid = "0";
    string _empid = "0";
    bool isEmployee = (_RoleId != 1 && _RoleId != 6805 && _RoleId != 6806 && _RoleId != 6811);

    if (isEmployee)
    {
        _empid = HttpContext.Current.Session["EmpId"] != null
            ? HttpContext.Current.Session["EmpId"].ToString()
            : "0";
    }
    if (_RoleId == 6805 || _RoleId == 6811)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    if (_RoleId == 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
        ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
        : "false";
}

<script src="~/Pages_JS/VirtuallScroll/NormalDropDownVirtualClientServer.js"></script>

<script>
    var _webapiurl = '@_webapiurl';
    var _tokan = '@_tokan';

    let RoleId = '@_RoleId';
    let UserId = '@_UserId';
    let CompanyId = '@_companyid';
    let EmpId = '@_empid';
    let isedit = '@obj.CanEdit';
    let isdelete = '@obj.CanDelete';
    let canadd = '@obj.CanAdd';
    let isEmployee = @(isEmployee ? "true" : "false");

    let ordersTable = null;
    let mealSlots = [];
    let orderCart = [];
    let currentMenuItems = [];
    let employeeBalance = null;
    let CompanyDropdown = null;
    let autoRefreshInterval = null;
    let autoRefreshEnabled = false;
    let autoRefreshSeconds = 30;

    // ==================== Utility Functions ====================

    function formatCurrency(amount) {
        if (amount == null) return '-';
        return '\u20B9' + parseFloat(amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function getStatusBadge(status, statusDisplay) {
        var colors = {
            0: 'orange_font',
            1: 'green_font',
            2: 'red_font',
            3: 'green_font',
            4: 'red_font'
        };
        var cls = colors[status] || 'badge-default';
        return '<span class="' + cls + '">' + (statusDisplay || 'Unknown') + '</span>';
    }

    function getStatusLabel(status) {
        var labels = { 0: 'Pending', 1: 'Accepted', 2: 'Rejected', 3: 'Served', 4: 'Cancelled' };
        return labels[status] || 'Unknown';
    }

    function formatDateApi(dt) {
        var y = dt.getFullYear();
        var m = ('0' + (dt.getMonth() + 1)).slice(-2);
        var d = ('0' + dt.getDate()).slice(-2);
        return y + '-' + m + '-' + d;
    }

    function formatDateDisplay(dateStr) {
        if (!dateStr) return '-';
        var d = new Date(dateStr);
        var day = ('0' + d.getDate()).slice(-2);
        var mon = ('0' + (d.getMonth() + 1)).slice(-2);
        return day + '-' + mon + '-' + d.getFullYear();
    }

    function formatTime(timeStr) {
        if (!timeStr) return '-';
        return timeStr.substring(0, 5);
    }

    function getDietaryIcon(dietaryType, isJainFriendly) {
        var icon = '';
        switch (dietaryType) {
            case 1:
                icon = '<span class="dietary-badge dietary-veg" title="Vegetarian"><span class="dietary-badge-dot"></span></span>';
                break;
            case 2:
                icon = '<span class="dietary-badge dietary-nonveg" title="Non-Vegetarian"><span class="dietary-badge-dot"></span></span>';
                break;
            case 3:
                icon = '<span class="dietary-badge dietary-vegan" title="Vegan"><span class="dietary-badge-dot"></span></span>';
                break;
            default:
                return '';
        }
        if (isJainFriendly) {
            icon += '<span class="dietary-badge dietary-jain" title="Jain Friendly"><i class="fa-light fa-leaf"></i></span>';
        }
        return icon;
    }

    // ==================== Page Initialization ====================

    $(document).ready(function () {
        if (isEmployee) {
            initEmployeePage();
        } else {
            initAdminPage();
        }
    });

    // ============================================================
    // ADMIN VIEW
    // ============================================================

    function initAdminPage() {
        initDateFilter();
        $('#FilterSlotId').html('<option value="">All Slots</option>');

        // Load canteens directly for all roles (no company cascade)
        loadCanteenDropdown();

        if (RoleId == '1') {
            setTimeout(function () {
                initializeCompanyDropdown();
            }, 100);
        }

        FillOrdersTable();
        bindAdminEvents();

        // Auto-refresh for Canteen Manager
        if (RoleId == '6811') {
            startAutoRefresh();
        }
    }

    // ==================== Auto-Refresh (Canteen Manager) ====================

    function startAutoRefresh() {
        if (autoRefreshInterval) return;
        autoRefreshEnabled = true;
        updateAutoRefreshUI();
        autoRefreshInterval = setInterval(function () {
            // Skip if any modal is open
            if ($('.modal.in, .modal.show').length > 0) return;
            if (!ordersTable) return;
            ordersTable.ajax.reload(null, false);
            updateLastRefreshTime();
        }, autoRefreshSeconds * 1000);
        updateLastRefreshTime();
    }

    function stopAutoRefresh() {
        if (autoRefreshInterval) {
            clearInterval(autoRefreshInterval);
            autoRefreshInterval = null;
        }
        autoRefreshEnabled = false;
        updateAutoRefreshUI();
    }

    function toggleAutoRefresh() {
        if (autoRefreshEnabled) {
            stopAutoRefresh();
        } else {
            startAutoRefresh();
        }
    }

    function updateAutoRefreshUI() {
        var $btn = $('#btnAutoRefresh');
        var $label = $('#autoRefreshLabel');
        if (autoRefreshEnabled) {
            $btn.addClass('active-refresh').attr('data-original-title', 'Auto-refresh ON (' + autoRefreshSeconds + 's) Click to pause');
            $label.html('<i class="fa-solid fa-circle text-success" style="font-size:6px;vertical-align:middle;"></i> <span class="text-muted" style="font-size:11px;">Live</span>');
        } else {
            $btn.removeClass('active-refresh').attr('data-original-title', 'Auto-refresh OFF — Click to resume');
            $label.html('<i class="fa-solid fa-circle text-muted" style="font-size:6px;vertical-align:middle;"></i> <span class="text-muted" style="font-size:11px;">Paused</span>');
        }
        $btn.tooltip('fixTitle');
    }

    function updateLastRefreshTime() {
        var now = new Date();
        var h = ('0' + now.getHours()).slice(-2);
        var m = ('0' + now.getMinutes()).slice(-2);
        var s = ('0' + now.getSeconds()).slice(-2);
        $('#lastRefreshTime').text(h + ':' + m + ':' + s);
    }

    function initializeCompanyDropdown() {
        CompanyDropdown = new Select2Dropdown({
            dropdownId: "FilterCompanyId",
            apiUrl: '@_webapiurlMain' + "DataDropDownOptimize/GetCompanyDropDownPaginated",
            dataKey: "Id",
            labelKey: "Name",
            chunkSize: '@_ChunkSize',
            token: '@_tokan',
            extraParams: { RoleId: '@_RoleId', CompanyID: '@_cmpid' }
        });

        $('#FilterCompanyId').change(function () {
            FillOrdersTable();
        });
    }

    function getSelectedCompanyId() {
        if (RoleId == '1') {
            return $('#FilterCompanyId').val() || '';
        }
        return CompanyId;
    }

    function bindAdminEvents() {
        // Filter panel toggle
        $("#Filter_search").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        $(".filterclose_btn").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        $("#Search_OPration").click(function () {
            FillOrdersTable();
        });

        $("#Clear_OPration").click(function () {
            if (CompanyDropdown) CompanyDropdown.clearDropdown();
            $('#FilterCanteenId').val('');
            $('#FilterDate').val(formatDateApi(new Date()));
            $('#FilterSlotId').html('<option value="">All Slots</option>');
            $('#FilterStatus').val('');
            $('#FilterOrderType').val('');
            FillOrdersTable();
        });

        $('#FilterCanteenId').change(function () {
            var canteenId = $(this).val();
            loadFilterMealSlots(canteenId);
        });

        $('#FilterOrderType').change(function () {
            var newType = parseInt($(this).val()) || 1;

            if (newType === 2) {
                $('#guestFilterNote').show();
            } else {
                $('#guestFilterNote').hide();
            }
        });
    }

    function initDateFilter() {
        $('#FilterDate').val(formatDateApi(new Date()));
    }

    function loadCanteenDropdown() {
        $.ajax({
            url: _webapiurl + 'canteens?pageSize=100&isActive=true',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (response) {
                var canteens = response.canteens || [];
                var opts = '<option value="">All Canteens</option>';
                for (var i = 0; i < canteens.length; i++) {
                    opts += '<option value="' + canteens[i].canteenId + '">' + canteens[i].canteenName + '</option>';
                }
                $('#FilterCanteenId').html(opts);
                // Employee ordering canteen dropdown
                var empOpts = '<option value="">-- Select Canteen --</option>';
                for (var i = 0; i < canteens.length; i++) {
                    empOpts += '<option value="' + canteens[i].canteenId + '">' + canteens[i].canteenName + '</option>';
                }
                $('#OrderCanteenId').html(empOpts);
            },
            error: function () {
                toastr.error("Failed to load canteens");
            }
        });
    }

    function loadFilterMealSlots(canteenId) {
        if (!canteenId) {
            $('#FilterSlotId').html('<option value="">All Slots</option>');
            return;
        }
        $.ajax({
            url: _webapiurl + 'mealslots?canteenId=' + canteenId,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (data) {
                var slots = data.mealSlots || [];
                var opts = '<option value="">All Slots</option>';
                for (var i = 0; i < slots.length; i++) {
                    if (slots[i].isActive) {
                        opts += '<option value="' + slots[i].mealSlotId + '">' + slots[i].slotName + '</option>';
                    }
                }
                $('#FilterSlotId').html(opts);
            },
            error: function () {
                toastr.error("Failed to load meal slots");
            }
        });
    }

    // ==================== Admin DataTable ====================

    var sortColumnMap = {
        1: 'orderDate',
        2: 'orderTime',
        3: 'empName',
        4: 'canteenName',
        5: 'slotName',
        8: 'netAmount',
        9: 'orderStatus'
    };

    function FillOrdersTable() {
        checkSession();

        if (ordersTable) {
            ordersTable.ajax.reload();
            return;
        }
        $("#ajax_loader").show();
        ordersTable = $('#tblOrders').DataTable({
            dom: _domCommon,
            language: _languageCommon,
            serverSide: true,
            searching: true,
            searchDelay: 500,
            ordering: true,
            order: [[1, 'desc']],
            pageLength: 25,
            ajax: {
                url: _webapiurl + 'orders',
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + _tokan },
                data: function (d) {
                    var sortBy = 'orderDate';
                    if (d.order && d.order.length > 0) {
                        var colIdx = d.order[0].column;
                        if (sortColumnMap[colIdx]) {
                            sortBy = sortColumnMap[colIdx];
                        }
                    }

                    var params = {
                        pageNumber: Math.floor(d.start / d.length) + 1,
                        pageSize: d.length,
                        sortBy: sortBy,
                        sortDirection: (d.order && d.order.length > 0) ? d.order[0].dir : 'desc'
                    };

                    if (d.search && d.search.value) {
                        params.search = d.search.value;
                    }

                    var canteenId = $('#FilterCanteenId').val();
                    if (canteenId) params.canteenId = canteenId;

                    var filterDate = $('#FilterDate').val();
                    if (filterDate) params.date = filterDate;

                    var slotId = $('#FilterSlotId').val();
                    if (slotId) params.mealSlotId = slotId;

                    var status = $('#FilterStatus').val();
                    if (status !== '') params.status = status;

                    var orderType = $('#FilterOrderType').val();
                    if (orderType !== '') params.orderType = orderType;

                    var companyId = getSelectedCompanyId();
                    if (companyId && companyId != '0') params.companyId = companyId;

                    return params;
                },
                dataFilter: function (rawData) {
                    var json = JSON.parse(rawData);
                    // Update summary cards
                    updateSummaryCards(json.summary);

                    var dtResponse = {
                        recordsTotal: json.totalCount || 0,
                        recordsFiltered: json.totalCount || 0,
                        data: json.orders || []
                    };
                    return JSON.stringify(dtResponse);
                },
                dataSrc: function (response) {
                    var orders = response.data || [];
                    var hasSearch = ordersTable && ordersTable.search();
                    if (response.recordsTotal === 0 && !hasSearch) {
                        $('#tblOrdersBlock').hide();
                        $('#NotificationGrid-empty').show();
                    } else {
                        $('#tblOrdersBlock').show();
                        $('#NotificationGrid-empty').hide();
                    }
                    return orders;
                },
                complete: function () {
                    $('#ajax_loader').hide();
                },
                error: function (xhr) {
                    var errorMsg = "Error fetching orders";
                    if (xhr.responseJSON && xhr.responseJSON.detail) {
                        errorMsg = xhr.responseJSON.detail;
                    }
                    toastr.error(errorMsg);
                    $('#tblOrdersBlock').hide();
                    $('#NotificationGrid-empty').show();
                }
            },
            initComplete: function () {
                if ($('#buttons').length) {
                    309 + $("#buttons").empty();
                    310
                }

                // Custom debounce: unbind default search and add 500ms delay
                var searchTimer = null;
                var $searchInput = $('#tblOrders_wrapper .dataTables_filter input');
                $searchInput.unbind();
                $searchInput.on('keyup search input paste cut', function () {
                    var value = this.value;
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function () {
                        ordersTable.search(value).draw();
                    }, 500);
                });
                $searchInput.on('keypress', function (e) {
                    if (e.keyCode === 13) return false;
                });
            },
            columns: [
                {
                    title: "Sr No",
                    data: null,
                    visible: false,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },
                {
                    title: "Order Date",
                    createdCell: function (td) { $(td).css("min-width", "70px"); },
                    data: "orderDate",
                    render: function (data) {
                        return formatDateDisplay(data);
                    }
                },
                {
                    title: "Order Code",
                    data: null,
                    render: function (data, type, row) {
                        if (!row.orderCode) return '-';
                        var cls = row.orderType === 2 ? 'orange_font' : 'green_font';
                        return '<span class="' + cls + '">' + row.orderCode + '</span>';
                    }
                },
                {
                    title: "Time",
                    data: "orderTime",
                    render: function (data) {
                        return formatTime(data);
                    }
                },
                {
                    title: "Name",
                    data: null,
                    createdCell: function (td) { $(td).css("min-width", "100px"); },
                    render: function (data, type, row) {
                        if (row.orderType === 2) {
                            var guestDisplay = row.guestName || 'Guest';
                            return '<span class="orange_font">' + guestDisplay + '</span>';
                        }
                        var name = row.empName || '-';
                        var code = row.empCode ? '<br><small class="text-muted">' + row.empCode + '</small>' : '';
                        return name + code;
                    }
                },
                {
                    title: "Canteen",
                    data: "canteenName",
                    orderable: false,
                    createdCell: function (td) { $(td).css("min-width", "120px"); },
                    render: function (data) { return data || '-'; }
                },
                {
                    title: "Slot",
                    data: "slotName"
                },
                {
                    title: "Type",
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        if (row.orderType === 2) {
                            return '<span class="orange_font">' + (row.orderTypeDisplay || 'Guest') + '</span>';
                        }
                        return '<span class="green_font">' + (row.orderTypeDisplay || 'Employee') + '</span>';
                    }
                },
                {
                    title: "Items",
                    data: null,
                    orderable: false,
                    createdCell: function (td) { $(td).css("min-width", "180px"); },
                    render: function (data, type, row) {
                        var summary = row.itemSummary || '';
                        var count = row.itemCount || 0;
                        if (summary.length > 30) {
                            summary = summary.substring(0, 30) + '...';
                        }
                        return '<span title="' + (row.itemSummary || '') + '">' + summary + ' (' + count + ')</span>';
                    }
                },
                {
                    title: "Net Amount",
                    data: "netAmount",
                    render: function (data) { return formatCurrency(data); }
                },
                {
                    title: "Status",
                    data: null,
                    render: function (data, type, row) {
                        return getStatusBadge(row.orderStatus, row.orderStatusDisplay);
                    }
                },
                {
                    title: "Action",
                    data: null,
                    orderable: false,
                    createdCell: function (td) { $(td).css("min-width", "128px"); },
                    render: function (data, type, row) {
                        var str = '<a class="btn seagreen_btnnew tooltips" data-placement="top" data-original-title="View Detail" onclick="viewOrderDetail(' + row.orderId + ')"><i class="fa-regular fa-eye"></i></a> ';

                        if (isedit === 'True') {
                            if (row.orderStatus === 0) {
                                str += '<a class="btn green_btnnew tooltips" data-placement="top" data-original-title="Accept" onclick="updateOrderStatus(' + row.orderId + ', 1)"><i class="fa-solid fa-check"></i></a> ';
                                str += '<a class="btn red_btnnew tooltips" data-placement="top" data-original-title="Reject" onclick="rejectOrder(' + row.orderId + ')"><i class="fa-solid fa-xmark"></i></a> ';
                            }
                            if (row.orderStatus === 1) {
                                str += '<a class="btn green_btnnew tooltips" data-placement="top" data-original-title="Mark Served" onclick="updateOrderStatus(' + row.orderId + ', 3)"><i class="fa-solid fa-utensils"></i></a> ';
                            }
                        }
                        return str;
                    }
                }
            ],
            drawCallback: function () {
                $('.tooltips').tooltip();
                setTimeout(function () {
                    $("#tblOrders_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                }, 100);
            }
        });
    }

    function updateSummaryCards(summary) {
        if (!summary) return;
        $('#summaryTotal').text(summary.totalOrders || 0);
        $('#summaryPending').text(summary.pendingCount || 0);
        $('#summaryAccepted').text(summary.acceptedCount || 0);
        $('#summaryServed').text(summary.servedCount || 0);
        $('#summaryRejected').text(summary.rejectedCount || 0);
        $('#summaryCancelled').text(summary.cancelledCount || 0);
        $('#summaryGross').text(formatCurrency(summary.totalGross));
        $('#summarySubsidy').text(formatCurrency(summary.totalSubsidy));
        $('#summaryNet').text(formatCurrency(summary.totalNet));
    }

    // ==================== Admin: Order Detail Modal ====================

    function viewOrderDetail(orderId) {
        checkSession();
        $('#orderDetailBody').html('<div style="text-align:center;padding:30px;"><i class="fa-thin fa-spinner fa-spin fa-2x"></i></div>');
        $('#orderDetailModal').modal('show');

        $.ajax({
            url: _webapiurl + 'orders/' + orderId,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (data) {
                renderOrderDetail(data);
            },
            error: function (xhr) {
                var msg = "Failed to load order detail";
                if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;
                $('#orderDetailBody').html('<div class="alert alert-danger">' + msg + '</div>');
            }
        });
    }

    function renderOrderDetail(data) {
        var empLabel = data.orderType === 2 ? 'Host Employee' : 'Employee';
        var empName = data.orderType === 2 ? (data.hostEmpName || data.empName || '-') : (data.empName || '-');
        var empCode = data.orderType === 2 ? (data.hostEmpCode || data.empCode || '') : (data.empCode || '');

        var orderTypeBadge = data.orderType === 2
            ? '<span class="od-badge od-badge-guest">' + (data.orderTypeDisplay || 'Guest') + '</span>'
            : '<span class="od-badge od-badge-employee">' + (data.orderTypeDisplay || 'Employee') + '</span>';

        var html = '';

        // Order Code & Status Header Strip
        html += '<div class="od-header-strip">';
        html += '<div class="od-header-left">';
        html += '<span class="od-order-code">#' + data.orderId + '</span>';
        html += orderTypeBadge;
        html += '</div>';
        html += '<div class="od-header-right">';
        html += getStatusBadge(data.orderStatus, data.orderStatusDisplay);
        html += '</div>';
        html += '</div>';

        // Info Grid
        html += '<div class="od-info-grid">';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-user"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">' + empLabel + '</span><span class="od-info-value">' + empName + (empCode ? ' <small class="text-muted">(' + empCode + ')</small>' : '') + '</span></div>';
        html += '</div>';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-store"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">Canteen</span><span class="od-info-value">' + (data.canteenName || '-') + '</span></div>';
        html += '</div>';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-building"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">Department</span><span class="od-info-value">' + (data.departmentName || '-') + '</span></div>';
        html += '</div>';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-calendar"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">Date</span><span class="od-info-value">' + formatDateDisplay(data.orderDate) + '</span></div>';
        html += '</div>';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-clock"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">Slot</span><span class="od-info-value">' + (data.slotName || '-') + '</span></div>';
        html += '</div>';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-shield-check"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">Policy</span><span class="od-info-value">' + (data.policyName || '-') + '</span></div>';
        html += '</div>';

        if (data.orderType === 2 && data.guestName) {
            html += '<div class="od-info-item">';
            html += '<div class="od-info-icon" style="color:#d97706;background:#fef3c7;"><i class="fa-light fa-user-group"></i></div>';
            html += '<div class="od-info-content"><span class="od-info-label">Guest Name</span><span class="od-info-value">' + data.guestName + '</span></div>';
            html += '</div>';
        }

        html += '</div>';

        // Remarks
        if (data.remarks) {
            html += '<div class="od-remarks"><i class="fa-light fa-message-lines"></i> ' + data.remarks + '</div>';
        }

        // Items Section
        html += '<div class="od-items-section">';
        html += '<div class="od-section-title"><i class="fa-light fa-utensils"></i> Order Items</div>';
        var items = data.items || [];
        for (var i = 0; i < items.length; i++) {
            var item = items[i];
            html += '<div class="od-item-row">';
	    var detailImgSrc = item.imageUrl || '/assets/images/icon_food.svg';
            html += '<div class="od-item-name"><img src="' + detailImgSrc + '" alt="" style="width:30px; height:30px; border-radius:6px !important; object-fit:cover; border:1px solid #e7ecf1;" onerror="this.onerror=null; this.src=\'/assets/images/icon_food.svg\';">' + getDietaryIcon(item.dietaryType, item.isJainFriendly) + ' ' + item.mealName + '</div>';
            html += '<div class="od-item-meta">';
            html += '<span class="od-item-qty">x' + item.quantity + '</span>';
            html += '<span class="od-item-price">' + formatCurrency(item.unitPrice) + '</span>';
            html += '<span class="od-item-total">' + formatCurrency(item.itemTotal) + '</span>';
            html += '</div>';
            html += '</div>';
        }
        html += '</div>';

        // Financial Summary
        html += '<div class="od-summary-section">';
        html += '<div class="od-summary-row"><span>Gross Total</span><span class="od-summary-value">' + formatCurrency(data.grossAmount) + '</span></div>';
        html += '<div class="od-summary-row od-summary-subsidy"><span><i class="fa-light fa-badge-percent"></i> Subsidy</span><span class="od-summary-value green_font">' + formatCurrency(data.subsidyAmount) + '</span></div>';
        html += '<div class="od-summary-row od-summary-net"><span>Net (You Pay)</span><span class="od-summary-value">' + formatCurrency(data.netAmount) + '</span></div>';
        html += '</div>';

        $('#orderDetailBody').html(html);

        // Action buttons in modal footer (admin only, not employees)
        var footerHtml = '';
        if (isedit === 'True' && !isEmployee) {
            if (data.orderStatus === 0) {
                footerHtml += '<button class="btn clear_btn" onclick="rejectOrder(' + data.orderId + '); $(\'#orderDetailModal\').modal(\'hide\');"><i class="fa-solid fa-xmark"></i> Reject</button> ';
                footerHtml += '<button class="btn save_btn" onclick="updateOrderStatus(' + data.orderId + ', 1); $(\'#orderDetailModal\').modal(\'hide\');"><i class="fa-solid fa-check"></i> Accept</button> ';
            }
            if (data.orderStatus === 1) {
                footerHtml += '<button class="btn save_btn" onclick="updateOrderStatus(' + data.orderId + ', 3); $(\'#orderDetailModal\').modal(\'hide\');"><i class="fa-solid fa-utensils"></i> Mark Served</button> ';
            }
        }
        $('#orderDetailModalFooter').html(footerHtml);
    }

    // ==================== Admin: Status Update ====================

    function updateOrderStatus(orderId, newStatus) {
        checkSession();
        var statusName = getStatusLabel(newStatus);

        Swal.fire({
            html: '<div class="swal_subtitle"><b>Are you sure you want to mark this order as ' + statusName + '?</b></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Confirm",
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            confirmButtonText: 'Yes, ' + statusName,
            cancelButtonText: 'Cancel',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                doStatusUpdate(orderId, newStatus, null);
            }
        });
        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
    }

    function rejectOrder(orderId) {
        checkSession();
        Swal.fire({
            html: '<div class="swal_subtitle"><b>Please provide a reason for rejection:</b></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Reject Order",
            input: 'text',
            inputPlaceholder: 'Reason for rejection',
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            confirmButtonText: 'Reject',
            cancelButtonText: 'Cancel',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                doStatusUpdate(orderId, 2, result.value || '');
            }
        });
        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
    }

    function doStatusUpdate(orderId, newStatus, remarks) {
        var payload = { status: newStatus };
        if (remarks !== null && remarks !== undefined) {
            payload.remarks = remarks;
        }

        $.ajax({
            url: _webapiurl + 'orders/' + orderId + '/status',
            type: 'PUT',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (data) {
                Swal.fire({
                    html: '<div class="swal_subtitle"><b>' + (data.message || 'Order status updated successfully') + '</b></div>',
                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Success!",
                    showCloseButton: true,
                    confirmButtonText: 'OK',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    customClass: {
                        confirmButton: 'swal-confirm-button-class'
                    }
                });
                $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
                if (ordersTable) ordersTable.ajax.reload(null, false);
            },
            error: function (xhr) {
                var msg = "Failed to update order status";
                if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;
                Swal.fire({
                    html: '<div class="swal_subtitle"><b>' + msg + '</b></div>',
                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error!",
                    showCloseButton: true,
                    confirmButtonText: 'OK',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    customClass: {
                        confirmButton: 'swal-confirm-button-class'
                    }
                });
                $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
            }
        });
    }

    // ============================================================
    // EMPLOYEE VIEW
    // ============================================================

    function initEmployeePage() {
        // Set default date to today with min=today
        var today = formatDateApi(new Date());
        $('#OrderDate').val(today).attr('min', today);

        // Set My Orders defaults to current month/year
        $('#MyOrdersMonth').val(new Date().getMonth() + 1);
        $('#MyOrdersYear').val(new Date().getFullYear());

        loadEmployeeCanteens();
        loadEmployeeBalance();
        bindEmployeeEvents();
        loadMyOrders();
    }

    function loadEmployeeCanteens() {
        $.ajax({
            url: _webapiurl + 'allocations/canteens/dropdown',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (data) {
                var $sel = $('#OrderCanteenId');
                $sel.empty();

                if (!data || data.length === 0) {
                    $sel.append('<option value="">No canteen allocated</option>');
                    $('#noActiveCanteenMsg').show();
                } else if (data.length === 1) {
                    $sel.append('<option value="' + data[0].canteenId + '">' + data[0].canteenName + '</option>');
                    $sel.val(data[0].canteenId);
                    // Auto-load meal slots for single canteen
                    loadCanteenMealSlots(data[0].canteenId);
                } else {
                    $sel.append('<option value="">-- Select Canteen --</option>');
                    for (var i = 0; i < data.length; i++) {
                        $sel.append('<option value="' + data[i].canteenId + '">' + data[i].canteenName + '</option>');
                    }
                }
            },
            error: function (xhr) {
                var msg = xhr.responseJSON && xhr.responseJSON.detail ? xhr.responseJSON.detail : "Failed to load allocated canteens";
                toastr.error(msg);
            }
        });
    }

    var canteenMealSlotsMap = {};

    function loadCanteenMealSlots(canteenId) {
        if (!canteenId) {
            $('#OrderSlotId').html('<option value="">-- Select Slot --</option>');
            canteenMealSlotsMap = {};
            return;
        }
        $.ajax({
            url: _webapiurl + 'mealslots?canteenId=' + canteenId,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (data) {
                var slots = data.mealSlots || [];
                canteenMealSlotsMap = {};
                var opts = '<option value="">-- Select Slot --</option>';
                for (var i = 0; i < slots.length; i++) {
                    if (slots[i].isActive) {
                        canteenMealSlotsMap[slots[i].mealSlotId] = slots[i];
                        opts += '<option value="' + slots[i].mealSlotId + '">' + slots[i].slotName + ' (' + (slots[i].slotCategoryName || '') + ')</option>';
                    }
                }
                $('#OrderSlotId').html(opts);
            },
            error: function () {
                toastr.error("Failed to load meal slots");
            }
        });
    }

    function bindEmployeeEvents() {
        // Keypress validation for text fields
        $(document).on('keypress', '#OrderRemarks', function (e) {
            return validateAddress(e.which);
        });

        // Tab switching
        $('#tabPlaceOrder').click(function () {
            $(this).addClass('active');
            $('#tabMyOrders').removeClass('active');
            $('#placeOrderSection').show();
            $('#myOrdersSection').hide();
        });

        $('#tabMyOrders').click(function () {
            $(this).addClass('active');
            $('#tabPlaceOrder').removeClass('active');
            $('#myOrdersSection').show();
            $('#placeOrderSection').hide();
            loadMyOrders();
        });

        // Canteen change: reload meal slots for selected canteen + clear menu
        $('#OrderCanteenId').change(function () {
            var canteenId = $(this).val();
            loadCanteenMealSlots(canteenId);
            orderCart = [];
            updateCartBadge();
            $('#menuItemsSection').html('<div class="menu-placeholder">Please select canteen, date and meal slot to see available items.</div>');
        });

        // Slot/date change: clear cart and load menu items
        $('#OrderSlotId').change(function () {
            orderCart = [];
            updateCartBadge();
            loadMenuItems();
        });

        $('#OrderDate').change(function () {
            orderCart = [];
            updateCartBadge();
            loadMenuItems();
        });

        // My orders filters
        $('#MyOrdersMonth, #MyOrdersYear, #MyOrdersStatus').change(function () {
            loadMyOrders();
        });

        // Open cart modal
        $('#btnOpenCart').click(function () {
            checkSession();
            renderCart();
            $('#cartModalTitle').text('Order Cart (' + orderCart.length + ' item' + (orderCart.length !== 1 ? 's' : '') + ')');
            $('#cartModal').modal('show');
        });

        // Place order button
        $('#btnPlaceOrder').click(function () {
            placeOrder();
        });

    }

    // ==================== Employee: Balance ====================

    function loadEmployeeBalance() {
        $.ajax({
            url: _webapiurl + 'orders/my/balance',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (data) {
                employeeBalance = data;
                renderBudgetBar(data);
            },
            error: function (xhr) {
                // May fail if employee has no allocation
                $('#budgetBarSection').html('<div class="alert alert-warning">Unable to load budget information. You may not be allocated to a canteen.</div>');
            }
        });
