    .progress {
        border-radius: 4px !important;
        overflow: hidden;
    }

    .progress-bar {
        font-size: 10px;
        text-align: center;
    }

    /* Auto-refresh indicator */

    .order_summary {
        background: #fff;
        padding: 2px;
        border-radius: 6px !important;
        text-align: center;
        border: 1px solid #e3e3e3;
        margin: 8px 0;
    }

    .order_summary_modal {
        background: #fff;
        padding: 6px;
        border-radius: 6px !important;
        text-align: center;
        border: 1px solid #e3e3e3;
