@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Meal Master";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    int _cmpid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapicms"].ToString();
    string _webapiurlMain = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _ChunkSize = HttpContext.Current.Session["DataDropDownThreShold"] != null
        ? HttpContext.Current.Session["DataDropDownThreShold"].ToString()
        : "500";

    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
        ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
        : "false";
}

<script src="~/Pages_JS/VirtuallScroll/NormalDropDownVirtualClientServer.js"></script>

<script>
    let RoleId = '@_RoleId';
    let UserId = '@_UserId';
    let isedit = '@obj.CanEdit';
    let isdelete = '@obj.CanDelete';
    let canadd = '@obj.CanAdd';
    let MealData = [];
    let mealTable = null;
    let selectedCanteenId = null;
    let formDataCategories = [];

    $(document).ready(function () {
        $('#tblMealBlock').hide();
        $('#NotificationGrid-empty').show();
        $('#emptyMessage').text('Please select a canteen to view meals.');

            initializeCanteenDropdown();
            initMealImageUpload();

        // Form field validation
        $('#MealName').blur(function () {
            validateField('MealName');
        });

        // Keypress validation for text fields
        $('#MealName').on('keypress', function (e) {
            return validateKeyPress(e.which);
        });
        $('#MealDescription').on('keypress', function (e) {
            return validateAddress(e.which);
        });

        // DisplayOrder - only allow numbers
        $('#DisplayOrder').on('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        // Add button
        $('#AddMeal').click(function () {
            checkSession();
            if (!selectedCanteenId) {
                toastr.warning("Please select a Canteen first");
                $(".filter_portlet_wrapper").removeClass("full-width");
                return;
            }
            frmClear();
            removeFieldErrors();
            $('#modalTitle').text('Add Meal');
            $('#mealModal').modal('toggle');
        });

        // Submit button
        $('#btnMealSubmit').click(saveMeal);

        // Price auto-calculate
        $(document).on('input', '#Price, #TaxPercentage', function () {
            updateFinalPrice();
        });

        // Filter canteen change - reload table
        $("#FilterCanteenId").change(function () {
            var canteenId = $(this).val();
            if (canteenId) {
                selectedCanteenId = canteenId;
                loadFormData(canteenId);
                if (mealTable) {
                    mealTable.ajax.reload();
                } else {
                    FillTable();
                }
            } else {
                selectedCanteenId = null;
                if (mealTable) {
                    mealTable.destroy();
                    mealTable = null;
                    $("#dataTables_tbl_header").remove();
                }
                $('#tblMealBlock').hide();
                $('#NotificationGrid-empty').show();
                $('#emptyMessage').text('Please select a canteen to view meals.');
                $('#mealSummary').hide();
                formDataCategories = [];
                populateCategoryDropdown();
            }
        });

        // Search button
        $("#Search_OPration").click(function () {
            if (!selectedCanteenId) {
                toastr.warning("Please select a canteen first");
                return;
            }
            if (mealTable) {
                mealTable.ajax.reload();
            } else {
                FillTable();
            }
        });

        // Clear button
        $("#Clear_OPration").click(function () {
            $('#FilterCategoryId').val('');
            $('#FilterDietaryType').val('');
            $('#FilterStatusId').val('');
            $('#FilterCanteenId').val('');
            selectedCanteenId = null;
            if (mealTable) {
                mealTable.destroy();
                mealTable = null;
                $("#dataTables_tbl_header").remove();
            }
            $('#tblMealBlock').hide();
            $('#NotificationGrid-empty').show();
            $('#emptyMessage').text('Please select a canteen to view meals.');
            $('#mealSummary').hide();
            formDataCategories = [];
            populateCategoryDropdown();
            initializeCanteenDropdown();
        });

        // Filter panel toggle
        $("#Filter_search").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Filter panel close
        $(".filterclose_btn").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });
    });

    function initializeCanteenDropdown() {
        $.ajax({
            type: "GET",
            url: '@_webapiurl' + 'canteens?pageSize=100&isActive=true',
            headers: { 'Authorization': 'Bearer ' + '@_tokan' },
            dataType: "json",
            success: function (response) {
                var canteens = response.canteens || [];
                var $dd = $('#FilterCanteenId');
                $dd.empty().append('<option value="">Select Canteen</option>');
                for (var i = 0; i < canteens.length; i++) {
                    $dd.append('<option value="' + canteens[i].canteenId + '">' + escapeHtml(canteens[i].canteenName) + '</option>');
                }
                // Auto-select if only one canteen
                if (canteens.length === 1) {
                    $dd.val(canteens[0].canteenId).trigger('change');
                } else if (canteens.length > 1) {
                    // Auto-open filter panel so user can select canteen immediately
                    $(".filter_portlet_wrapper").removeClass("full-width");
                }
            },
            error: function (xhr) {
                var errorMsg = "Failed to load canteens";
                if (xhr.responseJSON && xhr.responseJSON.detail) errorMsg = xhr.responseJSON.detail;
                toastr.error(errorMsg);
            }
        });
    }

    // Map DataTable column index to API sortBy values
    var sortColumnMap = {
        2: 'mealName',
        3: 'categoryName',
        4: 'dietaryType'
    };

    function FillTable() {
        checkSession();
        $("#ajax_loader").show();
        if (mealTable) {
            mealTable.ajax.reload();
            return;
        }

        $("#dataTables_tbl_header").remove();
        $('#tblMealBlock').show();
        $('#NotificationGrid-empty').hide();

        mealTable = $('#tblMeal').DataTable({
            dom: _domCommon,
            language: _languageCommon,
            serverSide: true,
            searching: true,
            searchDelay: 500,
            ordering: true,
            order: [[2, 'asc']],
            ajax: {
                url: '@_webapiurl' + "meals",
                type: "GET",
                headers: { 'Authorization': 'Bearer ' + '@_tokan' },
                data: function (d) {
                    var sortBy = 'mealName';
                    if (d.order && d.order.length > 0) {
                        var colIdx = d.order[0].column;
                        if (sortColumnMap[colIdx]) {
                            sortBy = sortColumnMap[colIdx];
                        }
                    }

                    var params = {
                        pageNumber: Math.floor(d.start / d.length) + 1,
                        pageSize: d.length,
                        sortBy: sortBy,
                        sortDirection: (d.order && d.order.length > 0) ? d.order[0].dir : 'asc'
                    };

                    if (d.search && d.search.value) {
                        params.searchTerm = d.search.value;
                    }

                    // Canteen filter
                    if (selectedCanteenId) {
                        params.canteenId = selectedCanteenId;
                    }

                    // Category filter
                    var categoryId = $('#FilterCategoryId').val();
                    if (categoryId) params.categoryId = categoryId;

                    // Dietary type filter
                    var dietaryType = $('#FilterDietaryType').val();
                    if (dietaryType) params.dietaryType = dietaryType;

                    // Status filter
                    var filterStatus = $('#FilterStatusId').val();
                    if (filterStatus !== '') {
                        params.isActive = (filterStatus === 'true');
                    }

                    return params;
                },
                dataFilter: function (rawData) {
                    var json = JSON.parse(rawData);
                    var dtResponse = {
                        recordsTotal: json.totalCount || 0,
                        recordsFiltered: json.totalCount || 0,
                        data: json.meals || []
                    };

                    // Update summary
                    if (json.summary) {
                        updateSummary(json.summary);
                    }

                    return JSON.stringify(dtResponse);
                },
                dataSrc: function (response) {
                    var meals = response.data || [];
                    MealData = meals;
                    var hasSearch = mealTable && mealTable.search();
                    if (response.recordsTotal === 0 && !hasSearch) {
                        $('#tblMealBlock').hide();
                        $('#NotificationGrid-empty').show();
                        $('#emptyMessage').text('No meals have been configured yet.');
                    } else {
                        $('#tblMealBlock').show();
                        $('#NotificationGrid-empty').hide();
                    }

                    return meals;
                },
                complete: function () {
                    $('#ajax_loader').hide();
                },
                error: function (xhr) {
                    var errorMsg = "Error during fetch data";
                    if (xhr.responseJSON && xhr.responseJSON.detail) {
                        errorMsg = xhr.responseJSON.detail;
                    }
                    toastr.error(errorMsg);
                    $('#tblMealBlock').hide();
                    $('#NotificationGrid-empty').show();
                    $('#emptyMessage').text('No meals have been configured yet.');
                    $('#mealSummary').hide();
                }
            },
            initComplete: function () {
                var visibleTable = 'tblMeal';
                if ($('#buttons').length && visibleTable) {
                    if ($('#buttons').children().length != 0) {
                        $("#buttons").empty();
                    }
                    $("#buttons").append(
                        '<div id="export-button1" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="' + visibleTable + '">' +
                        '<img src="../Newlayout/images/download_icon.svg" alt="Download icon">' +
                        '</div>'
                    );
                }

                // Custom debounce: unbind default search and add 500ms delay
                var searchTimer = null;
                var $searchInput = $('#tblMeal_wrapper .dataTables_filter input');
                $searchInput.unbind();
                $searchInput.on('keyup search input paste cut', function () {
                    var value = this.value;
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function () {
                        mealTable.search(value).draw();
                    }, 500);
                });
                $searchInput.on('keypress', function (e) {
                    if (e.keyCode === 13) return false;
                });
            },
            columns: [
                {
                    title: "MealId",
                    data: "mealId",
                    visible: false,
                    orderable: false
                },
                {
                    title: "Sr No",
                    data: null,
                    orderable: false,
                    width: "50px",
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                {
                    title: "Meal Name",
                    data: "mealName",
                    render: function (data, type, row) {
                        var imgSrc = row.imageUrl || '/assets/images/icon_food.svg';
                        var html = '<div style="display:flex; align-items:center; gap:8px;">';
                        html += '<img src="' + imgSrc + '" alt="" style="width:40px; height:40px; border-radius:50% !important; object-fit:cover; border:1px solid #e7ecf1;" onerror="this.onerror=null; this.src=\'/assets/images/icon_food.svg\';">';
                        html += '<div>' + escapeHtml(data);
                        if (row.mealDescription) {
                            var desc = row.mealDescription.length > 60
                                ? row.mealDescription.substring(0, 60) + '...'
                                : row.mealDescription;
                            html += '<br><small class="text-muted">' + escapeHtml(desc) + '</small>';
                        }
                        html += '</div></div>';
                        return html;
                    }
                },
                {
                    title: "Category",
                    data: "categoryName",
                    render: function (data) {
                        return data ? escapeHtml(data) : '-';
                    }
                },
                {
                    title: "Dietary Type",
                    data: "dietaryType",
                    render: function (data, type, row) {
                        return getDietaryDisplay(data, row.isJainFriendly);
                    }
                },
                {
                    title: "Price",
                    data: "finalPrice",
                    orderable: false,
                    width: "100px",
                    render: function (data, type, row) {
                        if (!data && data !== 0) return '-';
                        return '<span class="tooltips" data-placement="top" data-original-title="Base: \u20B9' + (row.price || 0).toFixed(2) + ' + Tax: ' + (row.taxPercentage || 0) + '%">\u20B9' + parseFloat(data).toFixed(2) + '</span>';
                    }
                },
                {
                    title: "Status",
                    data: "isActive",
                    orderable: false,
                    render: function (data) {
                        if (data) {
                            return '<span class="green_font">Active</span>';
                        } else {
                            return '<span class="red_font">Inactive</span>';
                        }
                    }
                },
                {
                    title: "Action",
                    data: null,
                    orderable: false,
                    createdCell: function (td) { $(td).css("min-width", "128px"); },
                    render: function (data, type, row) {
                        var str = "";
                        if (isedit == "True") {
                            str = '<a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit" onclick="updateMeal(' + row.mealId + ')"> <i class="fa-regular fa-pen-to-square"></i> </a> ';

                            if (row.isActive) {
                                str += '<a class="Inactiveclass btn red_btnnew tooltips" data-placement="top" data-original-title="Inactive" onclick="statusChange(' + row.mealId + ')"><i class="fa-solid fa-xmark"></i></a>';
                            } else {
                                str += '<a class="Activeclass btn green_btnnew tooltips" data-placement="top" data-original-title="Active" onclick="statusChange(' + row.mealId + ')"><i class="fa-solid fa-check"></i></a>';
                            }
                        }
                        if (isdelete == "True") {
                            str += ' <a class="Deleteclass btn red_btnnew tooltips" data-placement="top" data-original-title="Delete" onclick="deleteMeal(' + row.mealId + ')"><i class="fa-regular fa-trash-can"></i></a>';
                        }
                        return str;
                    }
                }
            ],
            drawCallback: function () {
                $('.tooltips').tooltip();
                setTimeout(function () {
                    $("#tblMeal_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                }, 100);
            }
        });

        $(document).off('click', '#export-button1').on('click', '#export-button1', function () {
            exportMeals();
        });
    }

    function loadFormData(canteenId, callback) {
        var url = '@_webapiurl' + 'meals/form-data';
        if (canteenId) {
            url += '?canteenId=' + canteenId;
        }

        $.ajax({
            type: "GET",
            url: url,
            headers: { 'Authorization': 'Bearer ' + '@_tokan' },
            dataType: "json",
            success: function (data) {
                formDataCategories = data.categories || [];
                populateCategoryDropdown();
                if (callback) callback();
            },
            error: function (xhr) {
                formDataCategories = [];
                populateCategoryDropdown();
                if (callback) callback();
            }
        });
    }

    function populateCategoryDropdown() {
        // Modal dropdown
        var $modal = $('#CategoryId');
        $modal.empty().append('<option value="">Select Category</option>');
        for (var i = 0; i < formDataCategories.length; i++) {
            $modal.append('<option value="' + formDataCategories[i].categoryId + '">' +
                escapeHtml(formDataCategories[i].categoryName) + '</option>');
        }

        // Filter dropdown
        var $filter = $('#FilterCategoryId');
        $filter.empty().append('<option value="">All Categories</option>');
        for (var i = 0; i < formDataCategories.length; i++) {
            $filter.append('<option value="' + formDataCategories[i].categoryId + '">' +
                escapeHtml(formDataCategories[i].categoryName) + '</option>');
        }
    }

    function saveMeal(e) {
        checkSession();
        e.preventDefault();

        var mealId = $('#MealId').val();
        var isUpdate = mealId && mealId !== "" && mealId !== "0";

        // Validate required fields
        if (!validateField('MealName')) return;

        // Dietary type validation
        var dietaryType = $('input[name="DietaryType"]:checked').val();
        if (!dietaryType) {
            toastr.warning("Please select a dietary type");
            return;
        }

        var mealObj;
        var url;
        var method;

        if (isUpdate) {
            mealObj = {
                mealName: $('#MealName').val().trim(),
                mealDescription: $('#MealDescription').val().trim() || null,
                categoryId: $('#CategoryId').val() ? parseInt($('#CategoryId').val()) : null,
                dietaryType: parseInt(dietaryType),
                isJainFriendly: $('#IsJainFriendly').is(':checked'),
                imageUrl: $('#ImageUrl').val().trim() || "",
                price: parseFloat($('#Price').val()) || 0,
                taxPercentage: parseFloat($('#TaxPercentage').val()) || 0,
                displayOrder: parseInt($('#DisplayOrder').val()) || 0
            };
            url = '@_webapiurl' + "meals/" + mealId;
            method = "PUT";
        } else {
            mealObj = {
                canteenId: parseInt(selectedCanteenId),
                mealName: $('#MealName').val().trim(),
                mealDescription: $('#MealDescription').val().trim() || null,
                categoryId: $('#CategoryId').val() ? parseInt($('#CategoryId').val()) : null,
                dietaryType: parseInt(dietaryType),
                isJainFriendly: $('#IsJainFriendly').is(':checked'),
                imageUrl: $('#ImageUrl').val().trim() || null,
                price: parseFloat($('#Price').val()) || 0,
                taxPercentage: parseFloat($('#TaxPercentage').val()) || 0,
                displayOrder: parseInt($('#DisplayOrder').val()) || 0,
                isActive: true
            };
            url = '@_webapiurl' + "meals";
            method = "POST";
        }

        $.ajax({
            type: method,
            url: url,
            headers: { 'Authorization': 'Bearer ' + '@_tokan' },
            data: JSON.stringify(mealObj),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (isUpdate) {
                    toastr.success("Meal updated successfully");
                    FillTable();
                } else {
                    toastr.success("Meal created successfully");
                
                        FillTable();
                    
                }
                $('#mealModal').modal('hide');                                          
            },
            error: function (xhr) {
                var errorMsg = "Error during save";
                if (xhr.responseJSON) {
                    if (xhr.responseJSON.detail) {
                        errorMsg = xhr.responseJSON.detail;
                    }
                    if (xhr.responseJSON.errors) {
                        for (var field in xhr.responseJSON.errors) {
                            errorMsg = xhr.responseJSON.errors[field].join(", ");
                            break;
                        }
                    }
                }
                toastr.error(errorMsg);
            }
        });
    }

    function updateMeal(mealId) {
        checkSession();
        frmClear();
        removeFieldErrors();

        var meal = MealData.find(function (value) { return value.mealId == mealId; });
        if (!meal) {
            toastr.error("Meal not found");
            return;
        }

        // Load form data for the meal's canteen, then populate fields
        loadFormData(selectedCanteenId, function () {
            $('#MealId').val(meal.mealId);
            $('#MealName').val(meal.mealName);
            $('#MealDescription').val(meal.mealDescription || '');
            $('#CategoryId').val(meal.categoryId || '');
            $('input[name="DietaryType"][value="' + meal.dietaryType + '"]').prop('checked', true);
            $('#IsJainFriendly').prop('checked', meal.isJainFriendly);
            $('#ImageUrl').val(meal.imageUrl || '');
            if (meal.imageUrl) {
                showMealImagePreview(meal.imageUrl);
            } else {
                hideMealImagePreview();
            }
            $('#Price').val(meal.price || 0);
            $('#TaxPercentage').val(meal.taxPercentage || 0);
            updateFinalPrice();
            $('#DisplayOrder').val(meal.displayOrder || 0);

            $('#modalTitle').text('Edit Meal');
            $('#mealModal').modal('toggle');
        });
    }

    function deleteMeal(mealId) {
        checkSession();

        Swal.fire({
            html: '<div class="swal_subtitle"><b>You want to delete this meal?</b></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Are you sure?",
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            cancelButtonText: 'Cancel',
            confirmButtonText: 'Yes, delete it!',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    type: "DELETE",
                    url: '@_webapiurl' + "meals/" + mealId,
                    headers: { 'Authorization': 'Bearer ' + '@_tokan' },
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>Meal has been deleted.</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Deleted!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
                        FillTable();
                    },
                    error: function (xhr) {
                        var errorMsg = "Error during delete";
                        if (xhr.responseJSON && xhr.responseJSON.detail) {
                            errorMsg = xhr.responseJSON.detail;
                        }
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>' + errorMsg + '</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                    }
                });
            }
        });
        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
    }

    function statusChange(mealId) {
        checkSession();

        var meal = MealData.find(function (value) { return value.mealId == mealId; });
        if (!meal) {
            toastr.error("Meal not found");
            return;
        }

        var newStatus = !meal.isActive;
        var actionText = newStatus ? "active" : "inactive";
        var confirmIcon = newStatus ? 'icon_success.svg' : 'icon_error.svg';
        var confirmClass = newStatus ? 'swal_success' : 'swal_error';
        var impactText = newStatus ? '' : '<br><small class="text-danger">This meal will be removed from future daily menus and ordering.</small>';

        Swal.fire({
            html: '<div class="swal_subtitle"><b>You want to ' + actionText + ' this meal?</b>' + impactText + '</div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/" + confirmIcon + "' alt=''>Are you sure?",
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            cancelButtonText: 'Cancel',
            confirmButtonText: 'Yes, ' + actionText + ' it!',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    type: "PATCH",
                    url: '@_webapiurl' + "meals/" + mealId + "/status",
                    headers: { 'Authorization': 'Bearer ' + '@_tokan' },
                    data: JSON.stringify({ isActive: newStatus }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function () {
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>Meal has been ' + (newStatus ? "active" : "inactive") + '.</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Success!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
                        FillTable();
                    },
                    error: function (xhr) {
                        var errorMsg = "Error during status change";
                        if (xhr.responseJSON && xhr.responseJSON.detail) {
                            errorMsg = xhr.responseJSON.detail;
                        }
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>' + errorMsg + '</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                    }
                });
            }
        });
        $('img[src="/assets/images/icons/swal_icon/' + confirmIcon + '"]').parent().parent().parent().addClass(confirmClass);
    }

    function exportMeals() {
        checkSession();
        if (!mealTable) return;

        var searchTerm = mealTable.search() || "";
        var canteenId = selectedCanteenId || "";
        var categoryId = $('#FilterCategoryId').val() || "";
        var dietaryType = $('#FilterDietaryType').val() || "";
        var isActive = $('#FilterStatusId').val() || "";

        var mainObj = {
            canteenId: canteenId,
            categoryId: categoryId,
            dietaryType: dietaryType,
            isActive: isActive,
            searchTerm: searchTerm
        };

        $.ajax({
            url: '/cms/ExportMealsExcel',
            type: 'POST',
            data: JSON.stringify(mainObj),
            contentType: 'application/json',
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                if (response.success && response.filePath) {
                    window.location.href = response.filePath;
                } else {
                    toastr.error(response.message || "Failed to generate export file.");
                }
            },
            error: function () {
                toastr.error("An error occurred while exporting data.");
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }

    function updateSummary(summary) {
        if (!summary) {
            $('#mealSummary').hide();
            return;
        }
        $('#summaryTotal').text(summary.totalMeals || 0);
        $('#summaryVeg').text(summary.vegCount || 0);
        $('#summaryNonVeg').text(summary.nonVegCount || 0);
        $('#summaryVegan').text(summary.veganCount || 0);
        $('#summaryActive').text(summary.activeCount || 0);
        $('#summaryInactive').text(summary.inactiveCount || 0);
        $('#mealSummary').show();
    }

    function getDietaryDisplay(dietaryType, isJainFriendly) {
        var html = '';
        switch (dietaryType) {
            case 1:
                html = '<i class="fa-solid fa-circle" style="color:#22C55E;font-size:8px;vertical-align:middle;"></i> <span>Vegetarian</span>';
                break;
            case 2:
                html = '<i class="fa-solid fa-circle" style="color:#EF4444;font-size:8px;vertical-align:middle;"></i> <span>Non-Vegetarian</span>';
                break;
            case 3:
                html = '<i class="fa-solid fa-circle" style="color:#10B981;font-size:8px;vertical-align:middle;"></i> <span>Vegan</span>';
                break;
            default:
                html = '-';
        }
        if (isJainFriendly) {
            html += '<br><small class="text-muted">Jain Friendly</small>';
        }
        return html;
    }

    function escapeHtml(text) {
        if (!text) return '';
        var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, function (m) { return map[m]; });
    }

    function validateField(fieldId) {
        var value = $('#' + fieldId).val();
        if (!value || value.trim() === "") {
            $("#" + fieldId).addClass('field_error');
            $("#" + fieldId).focus();
            return false;
        }
        $("#" + fieldId).removeClass('field_error');
        return true;
    }

    function removeFieldErrors() {
        $("#MealName").removeClass('field_error');
    }

    function frmClear() {
        $('#MealId').val("");
        $('#MealName').val("");
        $('#MealDescription').val("");
        $('#CategoryId').val("");
        $('input[name="DietaryType"]').prop('checked', false);
        $('input[name="DietaryType"][value="1"]').prop('checked', true);
        $('#IsJainFriendly').prop('checked', false);
        $('#ImageUrl').val("");
        $('#MealImageFile').val("");
        hideMealImagePreview();
        $('#DisplayOrder').val("0");

        $('#Price').val('0');
        $('#TaxPercentage').val('0');
        $('#FinalPriceDisplay').text('\u20B90.00');
    }

    function updateFinalPrice() {
        var price = parseFloat($('#Price').val()) || 0;
        var tax = parseFloat($('#TaxPercentage').val()) || 0;
        var finalPrice = price + (price * tax / 100);
        $('#FinalPriceDisplay').text('\u20B9' + finalPrice.toFixed(2));
    }

    // ==================== Meal Image Upload ====================

    function initMealImageUpload() {
        $('#MealImageFile').off('change').on('change', function () {
            var file = this.files[0];
            if (!file) return;

            // Validate size
            if (file.size > 1024 * 1024) {
                toastr.warning("File size must be less than 1 MB.");
                $(this).val('');
                return;
            }

            // Validate extension
            var allowedExts = ['.jpg', '.jpeg', '.png', '.bmp'];
            var ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
            if (allowedExts.indexOf(ext) === -1) {
                toastr.warning("Only .jpg, .jpeg, .png, .bmp files are allowed.");
                $(this).val('');
                return;
            }

            // Upload via AJAX
            var formData = new FormData();
            formData.append('MealImageFile', file);

            $.ajax({
                url: '/cms/UploadMealImage',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        $('#ImageUrl').val(response.imagePath);
                        showMealImagePreview(response.imagePath);
                        toastr.success("Image uploaded successfully");
                    } else {
                        toastr.error(response.message || "Upload failed");
                    }
                },
                error: function () {
                    toastr.error("Error uploading image");
                }
            });

            $(this).val('');
        });

        $('#btnRemoveMealImage').off('click').on('click', function () {
            $('#ImageUrl').val('');
            $('#MealImageFile').val('');
            hideMealImagePreview();
        });
    }

    function showMealImagePreview(imagePath) {
        if (imagePath) {
            $('#mealPreviewImg').attr('src', imagePath);
            $('#btnRemoveMealImage').show();
        }
    }

    function hideMealImagePreview() {
        $('#mealPreviewImg').attr('src', '/assets/images/icon_food.svg');
        $('#btnRemoveMealImage').hide();
    }

    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
</script>

