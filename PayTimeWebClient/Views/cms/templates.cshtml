@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Weekly Templates";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapicms"].ToString();

    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
        ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
        : "false";
}

<script src="~/Pages_JS/VirtuallScroll/NormalDropDownVirtualClientServer.js"></script>

<style>
    .field_error {
        border-color: #dc3545 !important;
    }

    .active-template-panel {
        padding: 6px 10px;
        background: #f8f9fa;
        border: 1px solid #e7ecf1;
        border-radius: 6px !important;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Schedule grid styles */
    .schedule-grid-table {
        margin-bottom: 0;
    }

        .schedule-grid-table th {
            background: #f5f6fa;
        }

    .day-name-cell {
        vertical-align: middle !important;
        background: #fafbfc;
    }

    .schedule-cell {
        cursor: pointer;
        min-width: 120px;
        vertical-align: top !important;
        padding: 6px 8px !important;
        transition: background 0.15s;
    }

        .schedule-cell:hover {
            background: #e8f4fd !important;
        }

    .schedule-meal-item {
        padding: 2px 0;
        line-height: 1.4;
    }

    /* Day-slot meal list */
    .day-slot-meal-item {
        display: flex;
        padding: 8px 12px;
        margin: 0;
        border-bottom: 1px solid #f0f0f0;
        cursor: pointer;
        font-weight: normal;
        align-items: center;
        gap: 8px;
    }

        .day-slot-meal-item:hover {
            background-color: #f8f9fa;
        }

        .day-slot-meal-item input[type="checkbox"] {
            margin-top: 0;
        }

    #daySlotMealList {
        max-height: 350px;
        overflow-y: auto;
        border: 1px solid #e7ecf1;
        border-radius: 4px !important;
    }

    /* Editor view */
    .portlet.editor-header {
        padding: 6px 10px;
        margin-bottom: 8px
    }

    .editor-header h4 {
        font-size: 13px;
        font-weight: 500;
    }

    .editor-back-btn {
        cursor: pointer;
        color: #337ab7;
        margin-right: 10px;
    }

        .editor-back-btn:hover {
            text-decoration: underline;
        }

    .label {
        font-size: 13px;
    }

    .label-info {
        background-color: #5bc0de;
        border-radius: 3px !important;
    }

    .label-warning {
        background-color: #f0ad4e;
        border-radius: 3px !important;
    }

    /* ── Copy Day Modal Body ── */
    .copy-day-subtitle {
        font-weight: 500;
        margin: 0 0 14px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .copy-day-subtitle i {
        color: #295097;
        font-size: 14px;
    }

    .copy-day-list {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 3px !important;
        overflow: hidden;
    }

    .copy-day-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        margin: 0;
        font-weight: normal;
        color: #334155;
        cursor: pointer;
        border-bottom: 1px solid #f1f5f9;
        transition: background 0.15s;
    }

    .copy-day-item:last-child {
        border-bottom: none;
    }

    .copy-day-item:hover {
        background: #f0f5ff;
    }

    .copy-day-item input[type="checkbox"] {
        accent-color: #295097;
        width: 16px;
        height: 16px;
        margin: 0;
        cursor: pointer;
        flex-shrink: 0;
    }

    .copy-day-item .day-label {
        flex: 1;
    }

        .copy-day-item .day-badge {
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 10px !important;
            font-weight: 500;
        }

    .day-badge-weekday {
        background: #e0f2fe;
        color: #0369a1;
    }

    .day-badge-weekend {
        background: #fef3c7;
        color: #b45309;
    }

    .copy-day-quick-actions {
        display: flex;
        gap: 8px;
        margin-top: 14px;
    }

    .copy-day-quick-actions .btn-quick {
        border: 1px solid #d1d9e6;
        border-radius: 3px !important;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 500;
        color: #475569;
        background: #ffffff;
        cursor: pointer;
        transition: all 0.15s;
    }

    .copy-day-quick-actions .btn-quick:hover {
        background: #f0f5ff;
        border-color: #295097;
        color: #295097;
    }

    .copy-day-quick-actions .btn-quick i {
        margin-right: 4px;
    }
</style>

<script>
    var _webapiurl = '@_webapiurl';
    var _tokan = '@_tokan';

    let RoleId = '@_RoleId';
    let UserId = '@_UserId';
    let isedit = '@obj.CanEdit';
    let isdelete = '@obj.CanDelete';
    let canadd = '@obj.CanAdd';

    let selectedCanteenId = null;
    let templateTable = null;
    let templatesData = [];
    let currentTemplateData = null;
    let currentEditTemplateId = null;
    let allMeals = [];
    let editingDayOfWeek = null;
    let editingSlotId = null;

    var DAY_NAMES = ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
    var DAY_KEYS = ['', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];

    // ========================================
    // DOCUMENT READY
    // ========================================
    $(document).ready(function () {
        $('#tblTemplatesBlock').hide();
        $('#NotificationGrid-empty').show();
        // Load canteen dropdown directly for all roles
        loadCanteenDropdown();

        // Canteen selector change
        $('#CanteenSelector').change(function () {
            selectedCanteenId = $(this).val();

            if (selectedCanteenId) {
                if (templateTable) {
                    templateTable.ajax.reload();
                } else {
                    FillTable();
                }
                loadActiveTemplate();
            } else {
                if (templateTable) {
                    templateTable.destroy();
                    templateTable = null;
                    $("#dataTables_tbl_header").remove();
                }
                selectedCanteenId = null;
                templatesData = [];
                $('#tblTemplatesBlock').hide();
                $('#NotificationGrid-empty').show();
                $('#emptyMessage').text('Please select a canteen to view templates.');
                $('#activeTemplatePanel').hide();
            }
        });

        // Create template button
        $('#CreateTemplate').click(function () {
            if (!selectedCanteenId) {
                toastr.warning("Please select a canteen first");
                $(".filter_portlet_wrapper").removeClass("full-width");
                return;
            }
            checkSession();
            openCreateModal();
        });

        // Assign template button
        $('#AssignTemplate, #btnChangeTemplate').click(function () {
            if (!selectedCanteenId) {
                toastr.warning("Please select a canteen first");
                $(".filter_portlet_wrapper").removeClass("full-width");
                return;
            }
            checkSession();
            openAssignModal();
        });

        // Modal save buttons
        $('#btnCreateTemplate').click(executeCreate);
        $('#btnUpdateHeader').click(executeUpdateHeader);
        $('#btnDuplicateTemplate').click(executeDuplicate);
        $('#btnSaveDaySlot').click(saveDaySlot);
        $('#btnCopyDay').click(executeCopyDay);
        $('#btnAssignTemplate').click(executeAssign);

        // Keypress validation for text fields
        $('#CreateTemplateName, #EditHeaderName, #DuplicateNewName').on('keypress', function (e) {
            return validateKeyPress(e.which);
        });
        $('#CreateTemplateDesc, #EditHeaderDesc').on('keypress', function (e) {
            return validateAddress(e.which);
        });

        // Search in day-slot modal
        $('#daySlotMealSearch').on('input', function () {
            var search = $(this).val().toLowerCase();
            $('.day-slot-meal-item').each(function () {
                var name = $(this).data('name').toLowerCase();
                $(this).toggle(name.indexOf(search) >= 0);
            });
        });

        // Filter handlers
        $("#Search_OPration").click(function () {
            if (!selectedCanteenId) {
                toastr.warning("Please select a canteen first");
                return;
            }
            if (templateTable) {
                templateTable.ajax.reload();
            } else {
                FillTable();
            }
        });

        $("#Clear_OPration").click(function () {
            $('#FilterTemplateType').val('');
            if (selectedCanteenId) {
                if (templateTable) {
                    templateTable.ajax.reload();
                } else {
                    FillTable();
                }
            }
        });

        $("#Filter_search").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        $(".filterclose_btn").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });
    });

    // ========================================
    // DROPDOWN INITIALIZATION
    // ========================================
    function loadCanteenDropdown() {
        $.ajax({
            type: "GET",
            url: _webapiurl + 'canteens?pageSize=100&isActive=true',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            dataType: "json",
            success: function (response) {
                var $sel = $('#CanteenSelector');
                $sel.empty().append('<option value="">-- Select Canteen --</option>');
                var canteens = response.canteens || [];
                if (canteens.length > 0) {
                    for (var i = 0; i < canteens.length; i++) {
                        $sel.append('<option value="' + canteens[i].canteenId + '">' +
                            escapeHtml(canteens[i].canteenName) + '</option>');
                    }
                    if (canteens.length === 1) {
                        $sel.val(canteens[0].canteenId).trigger('change');
                    } else {
                        // Auto-open filter panel so user can select canteen immediately
                        $(".filter_portlet_wrapper").removeClass("full-width");
                    }
                }
            },
            error: function () {
                toastr.error("Failed to load canteens");
            }
        });
    }

    // ========================================
    // TEMPLATE LIST DATATABLE
    // ========================================
    function FillTable() {
        if (!selectedCanteenId) return;

        $('#NotificationGrid-empty').hide();
        $('#tblTemplatesBlock').show();

        if (templateTable) {
            templateTable.destroy();
            templateTable = null;
            $("#dataTables_tbl_header").remove();
        }

        templateTable = $('#tblTemplates').DataTable({
            dom: _domCommon,
            language: _languageCommon,
            processing: true,
            serverSide: true,
            searching: true,
            searchDelay: 500,
            ordering: false,
            ajax: {
                url: _webapiurl + "menu-templates/list",
                type: "POST",
                contentType: "application/json",
                headers: { 'Authorization': 'Bearer ' + _tokan },
                data: function (d) {
                    return JSON.stringify({
                        canteenId: parseInt(selectedCanteenId),
                        includeCompanyTemplates: true,
                        searchText: d.search.value || "",
                        pageNumber: Math.floor(d.start / d.length) + 1,
                        pageSize: d.length
                    });
                },
                dataSrc: function (json) {
                    json.recordsTotal = json.totalRecords || 0;
                    json.recordsFiltered = json.totalRecords || 0;
                    templatesData = json.templates || [];

                    if (json.recordsTotal === 0) {
                        $('#tblTemplatesBlock').hide();
                        $('#NotificationGrid-empty').show();
                        $('#emptyMessage').text('No templates found.');
                    } else {
                        $('#tblTemplatesBlock').show();
                        $('#NotificationGrid-empty').hide();
                    }

                    return templatesData;
                },
                error: function (xhr) {
                    var errorMsg = "Failed to load templates";
                    if (xhr.responseJSON && xhr.responseJSON.detail) {
                        errorMsg = xhr.responseJSON.detail;
                    }
                    toastr.error(errorMsg);
                    $('#tblTemplatesBlock').hide();
                    $('#NotificationGrid-empty').show();
                    $('#emptyMessage').text('Failed to load templates.');
                }
            },
            pageLength: 20,
            lengthMenu: [[10, 20, 50], [10, 20, 50]],
            columns: [
                {
                    title: "Sr no",
                    data: null,
                    width: "40px",
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                {
                    title: "Template",
                    data: "templateName",
                    render: function (data, type, row) {
                        var html = escapeHtml(data);
                        if (row.templateDescription) {
                            html += '<br><small class="text-muted">' + escapeHtml(row.templateDescription) + '</small>';
                        }
                        return html;
                    }
                },
                //{
                //    title: "Type",
                //    data: "templateType",
                //    width: "100px",
                //    render: function (data, type, row) {
                //        if (data === 'Company') {
                //            return '<span class="label label-info">Company</span>';
                //        } else {
                //            return '<span class="label label-warning">Canteen</span>';
                //        }
                //    }
                //},
                //{
                //    title: "Used By",
                //    data: "usedByCanteens",
                //    render: function (data, type, row) {
                //        if (!data || data.length === 0) {
                //            return '<span class="text-muted">Not assigned</span>';
                //        }
                //        var html = escapeHtml(data[0].canteenName);
                //        if (data.length > 1) {
                //            html += ' <span class="text-muted">(+' + (data.length - 1) + ' more)</span>';
                //        }
                //        return html;
                //    }
                //},
                {
                    title: "Action",
                    data: null,
                    width: "160px",
                    orderable: false,
                    render: function (data, type, row) {
                        var str = "";
                        if (isedit == "True") {
                            str += '<a class="btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit Schedule" onclick="openEditor(' + row.templateId + ')"><i class="fa-light fa-calendar"></i></a> ';
                            str += '<a class="btn blue_btnnew tooltips" data-placement="top" data-original-title="Edit Details" onclick="openEditHeaderModal(' + row.templateId + ')"><i class="fa-regular fa-pen-to-square"></i></a> ';
                        }
                        if (canadd == "True") {
                            str += '<a class="btn blue_btnnew tooltips" data-placement="top" data-original-title="Duplicate" onclick="openDuplicateModal(' + row.templateId + ')"><i class="fa-regular fa-copy"></i></a> ';
                        }
                        if (isdelete == "True") {
                            str += '<a class="btn red_btnnew tooltips" data-placement="top" data-original-title="Delete" onclick="deleteTemplate(' + row.templateId + ')"><i class="fa-regular fa-trash-can"></i></a>';
                        }
                        return str;
                    }
                }
            ],
            initComplete: function () {
                if ($('#buttons').length) {
                    $("#buttons").empty();
                }

                // Custom debounce: unbind default search and add 500ms delay
                var searchTimer = null;
                var $searchInput = $('#tblTemplates_wrapper .dataTables_filter input');
                $searchInput.unbind();
                $searchInput.on('keyup search input paste cut', function () {
                    var value = this.value;
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function () {
                        templateTable.search(value).draw();
                    }, 500);
                });
                $searchInput.on('keypress', function (e) {
                    if (e.keyCode === 13) return false;
                });
            },
            drawCallback: function () {
                $('.tooltips').tooltip();
                setTimeout(function () {
                    $("#tblTemplates_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                }, 100);
            }
        });
    }

    // ========================================
    // ACTIVE TEMPLATE
    // ========================================
    function loadActiveTemplate() {
        if (!selectedCanteenId) {
            $('#activeTemplatePanel').hide();
            return;
        }

        $.ajax({
            type: "GET",
            url: _webapiurl + "menu-templates/active?canteenId=" + selectedCanteenId,
            headers: { 'Authorization': 'Bearer ' + _tokan },
            dataType: "json",
            success: function (data) {
                $('#activeTemplatePanel').show();
                if (data.hasActiveTemplate && data.activeTemplate) {
                    var t = data.activeTemplate;
                    //var typeLabel = t.templateType === 'Company'
                    //    ? '<span class="label label-info">Company</span>'
                    //    : '<span class="label label-warning">Canteen</span>';
                    $('#activeTemplateInfo').html(
                        '<i class="fa-solid fa-check-circle" style="color:#22C55E;"></i> ' +
                        '<b class="margin-right-5">' + escapeHtml(t.templateName) + '</b> '
                    );
                    $('#btnChangeTemplate').show();
                } else {
                    $('#activeTemplateInfo').html(
                        '<i class="fa-solid fa-circle-xmark" style="color:#999;"></i> ' +
                        '<span class="text-muted">No template assigned to this canteen</span>'
                    );
                    $('#btnChangeTemplate').show();
                }
            },
            error: function (xhr) {
                $('#activeTemplatePanel').hide();
            }
        });
    }

    // ========================================
    // CREATE TEMPLATE
    // ========================================
    function openCreateModal() {
        $('#CreateTemplateName').val('');
        $('#CreateTemplateDesc').val('');
        // CM role can only create canteen templates
        //if (RoleId == '6811') {
        //    $('input[name="CreateTemplateScope"][value="canteen"]').prop('checked', true);
        //    $('input[name="CreateTemplateScope"][value="company"]').prop('disabled', true);
        //} else {
        //    $('input[name="CreateTemplateScope"][value="company"]').prop('checked', true).prop('disabled', false);
        //}
        var canteenName = $('#CanteenSelector option:selected').text();
        $('#createCanteenLabel').text(canteenName);
        $('#createTemplateModal').modal('show');
    }

    function executeCreate() {
        checkSession();

        var name = $.trim($('#CreateTemplateName').val());
        if (!name) {
            toastr.warning("Please enter a template name");
            $('#CreateTemplateName').focus();
            return;
        }

        //var scope = $('input[name="CreateTemplateScope"]:checked').val();
        var canteenId = parseInt(selectedCanteenId);

        var request = {
            canteenId: canteenId,
            templateName: name,
            templateDescription: $.trim($('#CreateTemplateDesc').val()) || null
        };

        $.ajax({
            type: "POST",
            url: _webapiurl + "menu-templates",
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: JSON.stringify(request),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                toastr.success("Template created successfully");
                $('#createTemplateModal').modal('hide');
                if (templateTable) {
                    templateTable.ajax.reload();
                } else {
                    FillTable();
                }
            },
            error: function (xhr) {
                handleApiError(xhr, "Error creating template");
            }
        });
    }

    // ========================================
    // EDIT TEMPLATE HEADER
    // ========================================
    function openEditHeaderModal(templateId) {
        checkSession();

        var tmpl = templatesData.find(function (t) { return t.templateId == templateId; });
        if (!tmpl) {
            toastr.error("Template not found");
            return;
        }

        $('#EditHeaderTemplateId').val(tmpl.templateId);
        $('#EditHeaderName').val(tmpl.templateName);
        $('#EditHeaderDesc').val(tmpl.templateDescription || '');
        $('#editHeaderModal').modal('show');
    }

    function executeUpdateHeader() {
        checkSession();

        var templateId = parseInt($('#EditHeaderTemplateId').val());
        var name = $.trim($('#EditHeaderName').val());
        if (!name) {
            toastr.warning("Please enter a template name");
            $('#EditHeaderName').focus();
            return;
        }

        var payload = {
            templateId: templateId,
            templateName: name,
            templateDescription: $.trim($('#EditHeaderDesc').val()) || null
        };

        $.ajax({
            type: "PUT",
            url: _webapiurl + "menu-templates",
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: JSON.stringify(payload),
            contentType: "application/json; charset=utf-8",
            success: function () {
                toastr.success("Template updated successfully");
                $('#editHeaderModal').modal('hide');
                if (templateTable) {
                    templateTable.ajax.reload();
                }
            },
            error: function (xhr) {
                handleApiError(xhr, "Error updating template");
            }
        });
    }

    // ========================================
    // DUPLICATE TEMPLATE
    // ========================================
    function openDuplicateModal(templateId) {
        checkSession();

        var tmpl = templatesData.find(function (t) { return t.templateId == templateId; });
        if (!tmpl) {
            toastr.error("Template not found");
            return;
        }

        $('#DuplicateSourceTemplateId').val(tmpl.templateId);
        $('#DuplicateNewName').val(tmpl.templateName + ' (Copy)');
        // Same scope as source by default
        //if (tmpl.canteenId) {
        //    $('input[name="DuplicateScope"][value="canteen"]').prop('checked', true);
        //} else {
        //    $('input[name="DuplicateScope"][value="company"]').prop('checked', true);
        //}
        //if (RoleId == '6811') {
        //    $('input[name="DuplicateScope"][value="company"]').prop('disabled', true);
        //} else {
        //    $('input[name="DuplicateScope"][value="company"]').prop('disabled', false);
        //}
        var canteenName = $('#CanteenSelector option:selected').text();
        $('#duplicateCanteenLabel').text(canteenName);
        $('#duplicateTemplateModal').modal('show');
    }

    function executeDuplicate() {
        checkSession();

        var templateId = parseInt($('#DuplicateSourceTemplateId').val());
        var newName = $.trim($('#DuplicateNewName').val());
        if (!newName) {
            toastr.warning("Please enter a name for the new template");
            $('#DuplicateNewName').focus();
            return;
        }

        /*var scope = $('input[name="DuplicateScope"]:checked').val();*/
        var targetCanteenId = parseInt(selectedCanteenId);

        var payload = {
            newTemplateName: newName,
            targetCanteenId: targetCanteenId
        };

        $.ajax({
            type: "POST",
            url: _webapiurl + "menu-templates/" + templateId + "/duplicate",
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: JSON.stringify(payload),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                toastr.success("Template duplicated successfully");
                $('#duplicateTemplateModal').modal('hide');
                if (templateTable) {
                    templateTable.ajax.reload();
                }
            },
            error: function (xhr) {
                handleApiError(xhr, "Error duplicating template");
            }
        });
    }

    // ========================================
    // DELETE TEMPLATE
    // ========================================
    function deleteTemplate(templateId) {
        checkSession();

        Swal.fire({
            html: '<div class="swal_subtitle"><b>You want to delete this template?</b></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Are you sure?",
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            cancelButtonText: 'Cancel',
            confirmButtonText: 'Yes, delete it!',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    type: "DELETE",
                    url: _webapiurl + "menu-templates/" + templateId,
                    headers: { 'Authorization': 'Bearer ' + _tokan },
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>Template has been deleted.</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Deleted!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
                        if (templateTable) {
                            templateTable.ajax.reload();
                        }
                        loadActiveTemplate();
                    },
                    error: function (xhr) {
                        var errorMsg = "Error deleting template";
                        if (xhr.responseJSON && xhr.responseJSON.detail) {
                            errorMsg = xhr.responseJSON.detail;
                        }
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>' + errorMsg + '</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                    }
                });
            }
        });
        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
    }

    // ========================================
    // ASSIGN TEMPLATE
    // ========================================
    function openAssignModal() {
        $('#assignTemplateDropdown').empty().append('<option value="">-- Select Template --</option>');
        $('#assignLoader').show();
        $('#assignTemplateModal').modal('show');

        $.ajax({
            type: "GET",
            url: _webapiurl + "menu-templates/dropdown?canteenId=" + selectedCanteenId,
            headers: { 'Authorization': 'Bearer ' + _tokan },
            dataType: "json",
            success: function (data) {
                $('#assignLoader').hide();
                var $dd = $('#assignTemplateDropdown');
                //var companyTemplates = data.companyTemplates || [];
                //var canteenTemplates = data.canteenTemplates || [];

                if (data.templates.length > 0) {
                   
                    for (var i = 0; i < data.templates.length; i++) {
                        $dd.append('<option value="' + data.templates[i].templateId + '">' +
                            escapeHtml(data.templates[i].templateName) + '</option>');
                    }
                   
                }

                //if (canteenTemplates.length > 0) {
                //    var $grp2 = $('<optgroup label="Canteen Templates"></optgroup>');
                //    for (var j = 0; j < canteenTemplates.length; j++) {
                //        $grp2.append('<option value="' + canteenTemplates[j].templateId + '">' +
                //            escapeHtml(canteenTemplates[j].templateName) + '</option>');
                //    }
                //    $dd.append($grp2);
                //}

                if (data.templates.length === 0) {
                    $dd.append('<option value="" disabled>No templates available</option>');
                }
            },
            error: function () {
                $('#assignLoader').hide();
                toastr.error("Failed to load templates");
                $('#assignTemplateModal').modal('hide');
            }
        });
    }

    function executeAssign() {
        checkSession();

        var templateId = $('#assignTemplateDropdown').val();
        if (!templateId) {
            toastr.warning("Please select a template");
            return;
        }

        var payload = {
            canteenId: parseInt(selectedCanteenId),
            templateId: parseInt(templateId)
        };

        $.ajax({
            type: "POST",
            url: _webapiurl + "menu-templates/assign",
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: JSON.stringify(payload),
            contentType: "application/json; charset=utf-8",
            success: function () {
                toastr.success("Template assigned successfully");
                $('#assignTemplateModal').modal('hide');
                loadActiveTemplate();
            },
            error: function (xhr) {
                handleApiError(xhr, "Error assigning template");
            }
        });
    }

    // ========================================
    // TEMPLATE EDITOR
    // ========================================
    function openEditor(templateId) {
        checkSession();
        currentEditTemplateId = templateId;
        $('#listView').hide();
        $('#editorView').show();
        $('html, body').scrollTop(0);
        $('#scheduleGrid').html('<div style="text-align:center;padding:40px;"><img src="/LandingAssets/images/loading.gif" style="width:60px;" alt="loading" /></div>');

        // Load meals for the dropdown then load template
        loadMeals(function () {
            loadTemplateData(templateId);
        });
    }

    function closeEditor() {
        currentEditTemplateId = null;
        currentTemplateData = null;
        $('#editorView').hide();
        $('#listView').show();
        // Refresh list in case template was modified
        if (templateTable) {
            templateTable.ajax.reload();
        }
    }

    function loadMeals(callback) {
        var url = _webapiurl + "meals/dropdown";
        if (selectedCanteenId) {
            url += "?canteenId=" + selectedCanteenId;
        }

        $.ajax({
            type: "GET",
            url: url,
            headers: { 'Authorization': 'Bearer ' + _tokan },
            dataType: "json",
            success: function (data) {
                allMeals = data || [];
                if (callback) callback();
            },
            error: function () {
                toastr.error("Failed to load meals");
                allMeals = [];
                if (callback) callback();
            }
        });
    }

    function loadTemplateData(templateId) {
        $.ajax({
            type: "GET",
            url: _webapiurl + "menu-templates/" + templateId,
            headers: { 'Authorization': 'Bearer ' + _tokan },
            dataType: "json",
            success: function (data) {
                currentTemplateData = data;
                // Update editor header
                var typeLabel = data.templateType === 'Company'
                    ? '<span class="label label-info">Company</span>'
                    : '<span class="label label-warning">Canteen</span>';
                $('#editorTemplateName').html(escapeHtml(data.templateName) + ' ' + typeLabel);
                $('#editorTemplateDesc').text(data.templateDescription || '');
                renderScheduleGrid(data);
            },
            error: function (xhr) {
                var errorMsg = "Failed to load template";
                if (xhr.responseJSON && xhr.responseJSON.detail) {
                    errorMsg = xhr.responseJSON.detail;
                }
                toastr.error(errorMsg);
                closeEditor();
            }
        });
    }

    function renderScheduleGrid(data) {
        var mealSlots = data.mealSlots || [];
        var schedule = data.schedule || {};

        if (mealSlots.length === 0) {
            $('#scheduleGrid').html('<div class="alert alert-info">No meal slots configured. Please set up meal slots first.</div>');
            return;
        }

        var html = '<div class="table-responsive"><table class="table table-bordered schedule-grid-table">';

        // Header row
        html += '<thead><tr>';
        html += '<th style="width:130px;min-width:130px;">Day</th>';
        for (var s = 0; s < mealSlots.length; s++) {
            html += '<th>' + escapeHtml(mealSlots[s].slotName) + '</th>';
        }
        html += '<th style="width:80px;">Actions</th>';
        html += '</tr></thead>';

        // Body rows (1=Monday through 7=Sunday)
        html += '<tbody>';
        for (var d = 1; d <= 7; d++) {
            var dayKey = DAY_KEYS[d];
            var dayData = schedule[dayKey];
            html += '<tr>';
            html += '<td class="day-name-cell"><b>' + DAY_NAMES[d] + '</b></td>';

            for (var si = 0; si < mealSlots.length; si++) {
                var slotId = mealSlots[si].mealSlotId;
                var meals = getMealsForDaySlot(dayData, slotId);

                html += '<td class="schedule-cell" onclick="openDaySlotModal(' + d + ',' + slotId + ')">';
                if (meals.length > 0) {
                    for (var mi = 0; mi < meals.length; mi++) {
                        var schImgSrc = meals[mi].imageUrl || '/assets/images/icon_food.svg';
                        html += '<div class="schedule-meal-item" style="display:flex; align-items:center; gap:4px;">';
                        html += '<img src="' + schImgSrc + '" alt="" style="width:24px; height:24px; border-radius:50% !important; object-fit:cover; border:1px solid #e7ecf1;" onerror="this.onerror=null; this.src=\'/assets/images/icon_food.svg\';">';
                        html += getDietaryIcon(meals[mi].dietaryType || getDietaryTypeFromIcon(meals[mi].dietaryIcon));
                        html += escapeHtml(meals[mi].mealName);
                        html += '</div>';
                    }
                } else {
                    html += '<span>No meals</span>';
                }
                html += '</td>';
            }

            // Actions column
            html += '<td class="text-center">';
            html += '<a class="btn blue_btnnew tooltips" data-placement="top" data-original-title="Copy this day" onclick="event.stopPropagation();openCopyDayModal(' + d + ')"><i class="fa-regular fa-copy"></i></a>';
            html += '</td>';
            html += '</tr>';
        }
        html += '</tbody></table></div>';

        $('#scheduleGrid').html(html);
        $('.tooltips').tooltip();
    }

    function getMealsForDaySlot(dayData, slotId) {
        if (!dayData || !dayData.slots) return [];
        for (var i = 0; i < dayData.slots.length; i++) {
            if (dayData.slots[i].mealSlotId === slotId) {
                return dayData.slots[i].meals || [];
            }
        }
        return [];
    }

    function getDietaryTypeFromIcon(icon) {
        if (!icon) return 0;
        if (icon.indexOf('🟢') >= 0) return 1;
        if (icon.indexOf('🔴') >= 0) return 2;
        return 0;
    }

    // ========================================
    // DAY-SLOT EDITOR
    // ========================================
    function openDaySlotModal(dayOfWeek, mealSlotId) {
        if (isedit != 'True') return;
        checkSession();

        editingDayOfWeek = dayOfWeek;
        editingSlotId = mealSlotId;

        // Get slot name
        var slotName = '';
        var mealSlots = currentTemplateData.mealSlots || [];
        for (var i = 0; i < mealSlots.length; i++) {
            if (mealSlots[i].mealSlotId === mealSlotId) {
                slotName = mealSlots[i].slotName;
                break;
            }
        }

        $('#daySlotModalTitle').text(DAY_NAMES[dayOfWeek] + ' - ' + slotName);
        $('#daySlotMealSearch').val('');

        // Get currently selected meal IDs for this day+slot
        var dayKey = DAY_KEYS[dayOfWeek];
        var dayData = currentTemplateData.schedule ? currentTemplateData.schedule[dayKey] : null;
        var currentMeals = getMealsForDaySlot(dayData, mealSlotId);
        var currentMealIds = currentMeals.map(function (m) { return m.mealId; });

        // Build checkbox list of all meals
        var html = '';
        if (allMeals.length === 0) {
            html = '<div style="text-align:center;padding:15px;" class="text-muted">No meals available. Please add meals first.</div>';
        } else {
            for (var j = 0; j < allMeals.length; j++) {
                var m = allMeals[j];
                var checked = currentMealIds.indexOf(m.mealId) >= 0 ? 'checked' : '';
                var slotImgSrc = m.imageUrl || '/assets/images/icon_food.svg';
                html += '<label class="day-slot-meal-item" data-name="' + escapeHtml(m.mealName) + '">';
                html += '<input type="checkbox" name="DaySlotMealCheck" value="' + m.mealId + '" ' + checked + '> ';
                html += '<img src="' + slotImgSrc + '" alt="" style="width:28px; height:28px; border-radius:4px !important; object-fit:cover; border:1px solid #e7ecf1;" onerror="this.onerror=null; this.src=\'/assets/images/icon_food.svg\';">';
                html += getDietaryIcon(m.dietaryType) + ' ';
                html += escapeHtml(m.mealName);
                html += '</label>';
            }
        }
        $('#daySlotMealList').html(html);
        $('#editDaySlotModal').modal('show');
    }

    function saveDaySlot() {
        checkSession();

        // Collect selected meals for the edited slot
        var newMealIds = [];
        $('input[name="DaySlotMealCheck"]:checked').each(function () {
            newMealIds.push(parseInt($(this).val()));
        });

        // Build complete day schedule (all slots)
        var mealSlots = currentTemplateData.mealSlots || [];
        var dayKey = DAY_KEYS[editingDayOfWeek];
        var dayData = currentTemplateData.schedule ? currentTemplateData.schedule[dayKey] : null;

        var slots = [];
        for (var i = 0; i < mealSlots.length; i++) {
            var slotId = mealSlots[i].mealSlotId;
            if (slotId === editingSlotId) {
                // Use new selection
                slots.push({ mealSlotId: slotId, mealIds: newMealIds });
            } else {
                // Keep existing meals
                var existingMeals = getMealsForDaySlot(dayData, slotId);
                var existingIds = existingMeals.map(function (m) { return m.mealId; });
                slots.push({ mealSlotId: slotId, mealIds: existingIds });
            }
        }

        var payload = {
            templateId: currentEditTemplateId,
            dayOfWeek: editingDayOfWeek,
            slots: slots
        };

        $.ajax({
            type: "PUT",
            url: _webapiurl + "menu-templates/save-day",
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: JSON.stringify(payload),
            contentType: "application/json; charset=utf-8",
            success: function () {
                toastr.success(DAY_NAMES[editingDayOfWeek] + " schedule saved");
                $('#editDaySlotModal').modal('hide');
                // Reload template to refresh grid
                loadTemplateData(currentEditTemplateId);
            },
            error: function (xhr) {
                handleApiError(xhr, "Error saving schedule");
            }
        });
    }

    // ========================================
    // COPY DAY
    // ========================================
    function openCopyDayModal(sourceDayOfWeek) {
        checkSession();

        $('#copyDaySource').val(sourceDayOfWeek);
        $('#copyDaySourceLabel').text(DAY_NAMES[sourceDayOfWeek]);

        // Build target day checkboxes (exclude source)
        var html = '';
        for (var d = 1; d <= 7; d++) {
            if (d === sourceDayOfWeek) continue;
            var isWeekend = (d === 6 || d === 7);
            var badgeClass = isWeekend ? 'day-badge-weekend' : 'day-badge-weekday';
            var badgeText = isWeekend ? 'Weekend' : 'Weekday';
            html += '<label class="copy-day-item">';
            html += '<input type="checkbox" name="CopyDayTarget" value="' + d + '">';
            html += '<span class="day-label">' + DAY_NAMES[d] + '</span>';
            html += '<span class="day-badge ' + badgeClass + '">' + badgeText + '</span>';
            html += '</label>';
        }
        $('#copyDayTargets').html(html);

        $('#copyDayModal').modal('show');
    }

    function selectCopyWeekdays() {
        var source = parseInt($('#copyDaySource').val());
        $('input[name="CopyDayTarget"]').each(function () {
            var d = parseInt($(this).val());
            $(this).prop('checked', d >= 1 && d <= 5 && d !== source);
        });
    }

    function selectCopyAll() {
        $('input[name="CopyDayTarget"]').prop('checked', true);
    }

    function executeCopyDay() {
        checkSession();

        var sourceDayOfWeek = parseInt($('#copyDaySource').val());
        var targetDays = [];
        $('input[name="CopyDayTarget"]:checked').each(function () {
            targetDays.push(parseInt($(this).val()));
        });

        if (targetDays.length === 0) {
            toastr.warning("Please select at least one target day");
            return;
        }

        var payload = {
            templateId: currentEditTemplateId,
            sourceDayOfWeek: sourceDayOfWeek,
            targetDaysOfWeek: targetDays
        };

        $.ajax({
            type: "POST",
            url: _webapiurl + "menu-templates/copy-day",
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: JSON.stringify(payload),
            contentType: "application/json; charset=utf-8",
            success: function () {
                toastr.success(DAY_NAMES[sourceDayOfWeek] + " copied to " + targetDays.length + " day(s)");
                $('#copyDayModal').modal('hide');
                loadTemplateData(currentEditTemplateId);
            },
            error: function (xhr) {
                handleApiError(xhr, "Error copying day");
            }
        });
    }

    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    function getDietaryIcon(dietaryType) {
        switch (dietaryType) {
            case 1:
                return '<i class="fa-solid fa-circle" style="color:#22C55E;font-size:8px;vertical-align:middle;"></i>';
            case 2:
                return '<i class="fa-solid fa-circle" style="color:#EF4444;font-size:8px;vertical-align:middle;"></i>';
            case 3:
                return '<i class="fa-solid fa-circle" style="color:#10B981;font-size:8px;vertical-align:middle;"></i>';
            default:
                return '';
        }
    }

    function escapeHtml(text) {
        if (!text) return '';
        var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, function (m) { return map[m]; });
    }

    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }

    function handleApiError(xhr, defaultMsg) {
        var errorMsg = defaultMsg;
        if (xhr.responseJSON) {
            if (xhr.responseJSON.detail) {
                errorMsg = xhr.responseJSON.detail;
            }
            if (xhr.responseJSON.errors) {
                for (var field in xhr.responseJSON.errors) {
                    errorMsg = xhr.responseJSON.errors[field].join(", ");
                    break;
                }
            }
        }
        toastr.error(errorMsg);
    }
</script>

