@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Guest Booking";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    int _cmpid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapicms"].ToString();
    string _webapiurlMain = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _ChunkSize = HttpContext.Current.Session["DataDropDownThreShold"] != null
        ? HttpContext.Current.Session["DataDropDownThreShold"].ToString()
        : "500";

    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    string _companyid = "0";
    if (_RoleId == 6805 || _RoleId == 6806 || _RoleId == 6811)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
        ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
        : "false";
}

<script src="~/Pages_JS/VirtuallScroll/NormalDropDownVirtualClientServer.js"></script>

<script>
    var _webapiurl = '@_webapiurl';
    var _tokan = '@_tokan';

    let RoleId = '@_RoleId';
    let UserId = '@_UserId';
    let CompanyId = '@_companyid';
    let isedit = '@obj.CanEdit';
    let isdelete = '@obj.CanDelete';
    let canadd = '@obj.CanAdd';

    let guestOrdersTable = null;
    let mealSlots = [];
    let guestCart = [];
    let currentMenuItems = [];
    let CompanyDropdown = null;
    let HostEmpDropdown = null;
    let ModalCompanyDropdown = null;

    // ==================== Utility Functions ====================

    function formatCurrency(amount) {
        if (amount == null) return '-';
        return '\u20B9' + parseFloat(amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function getStatusBadge(status, statusDisplay) {
        var colors = {
            0: 'orange_font',
            1: 'green_font',
            2: 'red_font',
            3: 'green_font',
            4: 'red_font'
        };
        var cls = colors[status] || 'badge-default';
        return '<span class="' + cls + '">' + (statusDisplay || 'Unknown') + '</span>';
    }

    function getStatusLabel(status) {
        var labels = { 0: 'Pending', 1: 'Accepted', 2: 'Rejected', 3: 'Served', 4: 'Cancelled' };
        return labels[status] || 'Unknown';
    }

    function formatDateApi(dt) {
        var y = dt.getFullYear();
        var m = ('0' + (dt.getMonth() + 1)).slice(-2);
        var d = ('0' + dt.getDate()).slice(-2);
        return y + '-' + m + '-' + d;
    }

    function formatDateDisplay(dateStr) {
        if (!dateStr) return '-';
        var d = new Date(dateStr);
        var day = ('0' + d.getDate()).slice(-2);
        var mon = ('0' + (d.getMonth() + 1)).slice(-2);
        return day + '-' + mon + '-' + d.getFullYear();
    }

    function formatTime(timeStr) {
        if (!timeStr) return '-';
        return timeStr.substring(0, 5);
    }

    function getDietaryIcon(dietaryType, isJainFriendly) {
        var icon = '';
        switch (dietaryType) {
            case 1:
                icon = '<span class="dietary-badge dietary-veg" title="Vegetarian"><span class="dietary-badge-dot"></span></span>';
                break;
            case 2:
                icon = '<span class="dietary-badge dietary-nonveg" title="Non-Vegetarian"><span class="dietary-badge-dot"></span></span>';
                break;
            case 3:
                icon = '<span class="dietary-badge dietary-vegan" title="Vegan"><span class="dietary-badge-dot"></span></span>';
                break;
            default:
                return '';
        }
        if (isJainFriendly) {
            icon += '<span class="dietary-badge dietary-jain" title="Jain Friendly"><i class="fa-light fa-leaf"></i></span>';
        }
        return icon;
    }

    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }

    // ==================== Page Initialization ====================

    $(document).ready(function () {
        initDateFilter();
        $('#FilterSlotId').html('<option value="">All Slots</option>');
        loadCanteenDropdown();

        if (RoleId == '1') {
            setTimeout(function () {
                initializeCompanyDropdown();
            }, 100);
        }

        FillGuestOrdersTable();
        bindEvents();
    });

    // ==================== Company Dropdown (SA Only) ====================

    function initializeCompanyDropdown() {
        CompanyDropdown = new Select2Dropdown({
            dropdownId: "FilterCompanyId",
            apiUrl: '@_webapiurlMain' + "DataDropDownOptimize/GetCompanyDropDownPaginated",
            dataKey: "Id",
            labelKey: "Name",
            chunkSize: '@_ChunkSize',
            token: '@_tokan',
            extraParams: { RoleId: '@_RoleId', CompanyID: '@_cmpid' }
        });

        $('#FilterCompanyId').change(function () {
            FillGuestOrdersTable();
        });
    }

    function getSelectedCompanyId() {
        if (RoleId == '1') {
            return $('#FilterCompanyId').val() || '';
        }
        return CompanyId;
    }

    // ==================== Event Bindings ====================

    function bindEvents() {
        // Filter panel toggle
        $("#Filter_search").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        $(".filterclose_btn").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        $('#FilterCanteenId').change(function () {
            var canteenId = $(this).val();
            loadFilterMealSlots(canteenId);
        });

        $("#Search_OPration").click(function () {
            FillGuestOrdersTable();
        });

        $("#Clear_OPration").click(function () {
            if (CompanyDropdown) CompanyDropdown.clearDropdown();
            $('#FilterCanteenId').val('');
            $('#FilterDate').val(formatDateApi(new Date()));
            $('#FilterSlotId').html('<option value="">All Slots</option>');
            $('#FilterStatus').val('');
            FillGuestOrdersTable();
        });

        // Add Guest Order button
        $('#AddGuestOrder').click(function () {
            checkSession();
            openAddGuestOrderModal();
        });
    }

    // ==================== Dropdown Loaders ====================

    function initDateFilter() {
        $('#FilterDate').val(formatDateApi(new Date()));
    }

    function loadCanteenDropdown() {
        $.ajax({
            url: _webapiurl + 'canteens?pageSize=100&isActive=true',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (response) {
                var canteens = response.canteens || [];

                if (canteens.length === 0) {
                    $('#FilterCanteenId').html('<option value="">No active canteens available</option>');
                    $('#GuestCanteenId').html('<option value="">No active canteens available</option>');
                    $('#noActiveCanteenMsg').show();
                    return;
                }

                var opts = '<option value="">All Canteens</option>';
                for (var i = 0; i < canteens.length; i++) {
                    opts += '<option value="' + canteens[i].canteenId + '">' + canteens[i].canteenName + '</option>';
                }
                $('#FilterCanteenId').html(opts);

                // Modal canteen dropdown
                var modalOpts = '<option value="">-- Select Canteen --</option>';
                for (var i = 0; i < canteens.length; i++) {
                    modalOpts += '<option value="' + canteens[i].canteenId + '">' + canteens[i].canteenName + '</option>';
                }
                $('#GuestCanteenId').html(modalOpts);
                $('#noActiveCanteenMsg').hide();
            },
            error: function () {
                toastr.error("Failed to load canteens");
            }
        });
    }

    function loadFilterMealSlots(canteenId) {
        if (!canteenId) {
            $('#FilterSlotId').html('<option value="">All Slots</option>');
            return;
        }
        $.ajax({
            url: _webapiurl + 'mealslots?canteenId=' + canteenId,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (data) {
                var slots = data.mealSlots || [];
                var opts = '<option value="">All Slots</option>';
                for (var i = 0; i < slots.length; i++) {
                    if (slots[i].isActive) {
                        opts += '<option value="' + slots[i].mealSlotId + '">' + slots[i].slotName + '</option>';
                    }
                }
                $('#FilterSlotId').html(opts);
            },
            error: function () {
                toastr.error("Failed to load meal slots");
            }
        });
    }

    function loadCanteenMealSlots(canteenId) {
        if (!canteenId) {
            $('#GuestSlotId').html('<option value="">-- Select Slot --</option>');
            return;
        }
        $.ajax({
            url: _webapiurl + 'mealslots?canteenId=' + canteenId,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (data) {
                var slots = data.mealSlots || [];
                var opts = '<option value="">-- Select Slot --</option>';
                for (var i = 0; i < slots.length; i++) {
                    if (slots[i].isActive) {
                        opts += '<option value="' + slots[i].mealSlotId + '">' + slots[i].slotName + '</option>';
                    }
                }
                $('#GuestSlotId').html(opts);
            },
            error: function () {
                toastr.error("Failed to load meal slots");
            }
        });
    }

    // ==================== DataTable ====================

    var sortColumnMap = {
        1: 'orderDate',
        2: 'orderTime',
        3: 'empName',
        4: 'canteenName',
        5: 'slotName',
        8: 'netAmount',
        9: 'orderStatus'
    };

    function FillGuestOrdersTable() {
        checkSession();

        if (guestOrdersTable) {
            guestOrdersTable.ajax.reload();
            return;
        }
        $("#ajax_loader").show();
        guestOrdersTable = $('#tblGuestOrders').DataTable({
            dom: _domCommon,
            language: _languageCommon,
            serverSide: true,
            searching: true,
            searchDelay: 500,
            ordering: true,
            order: [[1, 'desc']],
            ajax: {
                url: _webapiurl + 'orders',
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + _tokan },
                data: function (d) {
                    var sortBy = 'orderDate';
                    var dir = 'desc';
                    if (d.order && d.order.length > 0) {
                        var colIdx = d.order[0].column;
                        if (sortColumnMap[colIdx]) {
                            sortBy = sortColumnMap[colIdx];
                        }
                        dir = d.order[0].dir;
                    }

                    var params = {
                        pageNumber: Math.floor(d.start / d.length) + 1,
                        pageSize: d.length,
                        sortBy: sortBy,
                        sortDirection: dir,
                        orderType: 2
                    };

                    if (d.search && d.search.value) {
                        params.search = d.search.value;
                    }

                    var canteenId = $('#FilterCanteenId').val();
                    if (canteenId) params.canteenId = canteenId;

                    var filterDate = $('#FilterDate').val();
                    if (filterDate) params.date = filterDate;

                    var slotId = $('#FilterSlotId').val();
                    if (slotId) params.mealSlotId = slotId;

                    var status = $('#FilterStatus').val();
                    if (status !== '') params.status = status;

                    var companyId = getSelectedCompanyId();
                    if (companyId && companyId != '0') params.companyId = companyId;

                    return params;
                },
                dataFilter: function (rawData) {
                    var json = JSON.parse(rawData);
                    updateSummaryCards(json.summary);

                    var dtResponse = {
                        recordsTotal: json.totalCount || 0,
                        recordsFiltered: json.totalCount || 0,
                        data: json.orders || []
                    };
                    return JSON.stringify(dtResponse);
                },
                dataSrc: function (response) {
                    var orders = response.data || [];
                    var hasSearch = guestOrdersTable && guestOrdersTable.search();
                    if (response.recordsTotal === 0 && !hasSearch) {
                        $('#tblGuestOrdersBlock').hide();
                        $('#NotificationGrid-empty').show();
                    } else {
                        $('#tblGuestOrdersBlock').show();
                        $('#NotificationGrid-empty').hide();
                    }
                    return orders;
                },
                complete: function () {
                    $('#ajax_loader').hide();
                },
                error: function (xhr) {
                    var errorMsg = "Error fetching guest orders";
                    if (xhr.responseJSON && xhr.responseJSON.detail) {
                        errorMsg = xhr.responseJSON.detail;
                    }
                    toastr.error(errorMsg);
                    $('#tblGuestOrdersBlock').hide();
                    $('#NotificationGrid-empty').show();
                }
            },
            initComplete: function () {
                if ($('#buttons').length) {
                    $("#buttons").empty();
                }

                // Custom debounce: unbind default search and add 500ms delay
                var searchTimer = null;
                var $searchInput = $('#tblGuestOrders_wrapper .dataTables_filter input');
                $searchInput.unbind();
                $searchInput.on('keyup search input paste cut', function () {
                    var value = this.value;
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function () {
                        guestOrdersTable.search(value).draw();
                    }, 500);
                });
                $searchInput.on('keypress', function (e) {
                    if (e.keyCode === 13) return false;
                });
            },
            columns: [
                {
                    title: "Sr No",
                    data: null,
                    visible: false,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },
                {
                    title: "Order Date",
                    data: "orderDate",
                    createdCell: function (td) { $(td).css("min-width", "90px"); },
                    render: function (data) {
                        return formatDateDisplay(data);
                    }
                },
                {
                    title: "Order Code",
                    data: "orderCode",
                    render: function (data) {
                        if (!data) return '-';
                        return '<span class="orange_font">' + data + '</span>';
                    }
                },
                {
                    title: "Time",
                    data: "orderTime",
                    render: function (data) {
                        return formatTime(data);
                    }
                },
                {
                    title: "Guest Name",
                    data: null,
                    createdCell: function (td) { $(td).css("min-width", "140px"); },
                    render: function (data, type, row) {
                        return row.guestName || '-';
                    }
                },
                {
                    title: "Host Employee",
                    data: null,
                    createdCell: function (td) { $(td).css("min-width", "140px"); },
                    render: function (data, type, row) {
                        var name = row.hostEmpName || '-';
                        var code = row.hostEmpCode ? '<br><small class="text-muted">' + row.hostEmpCode + '</small>' : '';
                        return name + code;
                    }
                },
                {
                    title: "Canteen",
                    data: "canteenName",
                    orderable: false,
                    createdCell: function (td) { $(td).css("min-width", "120px"); },
                    render: function (data) { return data || '-'; }
                },
                {
                    title: "Slot",
                    data: "slotName"
                },
                {
                    title: "Items",
                    data: null,
                    orderable: false,
                    createdCell: function (td) { $(td).css("min-width", "120px"); },
                    render: function (data, type, row) {
                        var summary = row.itemSummary || '';
                        var count = row.itemCount || 0;
                        if (summary.length > 30) {
                            summary = summary.substring(0, 30) + '...';
                        }
                        return '<span title="' + (row.itemSummary || '') + '">' + summary + ' (' + count + ')</span>';
                    }
                },
                {
                    title: "Net Amount",
                    data: "netAmount",
                    render: function (data) { return formatCurrency(data); }
                },
                {
                    title: "Status",
                    data: null,
                    render: function (data, type, row) {
                        return getStatusBadge(row.orderStatus, row.orderStatusDisplay);
                    }
                },
                {
                    title: "Action",
                    data: null,
                    orderable: false,
                    createdCell: function (td) { $(td).css("min-width", "128px"); },
                    render: function (data, type, row) {
                        var str = '<a class="btn seagreen_btnnew tooltips" data-placement="top" data-original-title="View Detail" onclick="viewOrderDetail(' + row.orderId + ')"><i class="fa-regular fa-eye"></i></a> ';

                        if (isedit === 'True' && row.orderStatus === 0) {
                            str += '<a class="btn red_btnnew tooltips" data-placement="top" data-original-title="Cancel" onclick="cancelGuestOrder(' + row.orderId + ')"><i class="fa-regular fa-ban"></i></a> ';
                        }
                        return str;
                    }
                }
            ],
            drawCallback: function () {
                $('.tooltips').tooltip();
                setTimeout(function () {
                    $("#tblGuestOrders_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                }, 100);
            }
        });
    }

    // ==================== Summary Cards ====================

    function updateSummaryCards(summary) {
        if (!summary) return;
        $('#summaryTotal').text(summary.totalOrders || 0);
        $('#summaryPending').text(summary.pendingCount || 0);
        $('#summaryAccepted').text(summary.acceptedCount || 0);
        $('#summaryServed').text(summary.servedCount || 0);
        $('#summaryRejected').text(summary.rejectedCount || 0);
        $('#summaryCancelled').text(summary.cancelledCount || 0);
        $('#summaryGross').text(formatCurrency(summary.totalGross));
        $('#summaryNet').text(formatCurrency(summary.totalNet));
    }

    // ==================== Order Detail Modal ====================

    function viewOrderDetail(orderId) {
        checkSession();
        $('#orderDetailBody').html('<div style="text-align:center;padding:30px;"><i class="fa-thin fa-spinner fa-spin fa-2x"></i></div>');
        $('#orderDetailModal').modal('show');

        $.ajax({
            url: _webapiurl + 'orders/' + orderId,
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            success: function (data) {
                renderOrderDetail(data);
            },
            error: function (xhr) {
                var msg = "Failed to load order detail";
                if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;
                $('#orderDetailBody').html('<div class="alert alert-danger">' + msg + '</div>');
            }
        });
    }

    function renderOrderDetail(data) {
        var empLabel = 'Host Employee';
        var empName = data.hostEmpName || data.empName || '-';
        var empCode = data.hostEmpCode || data.empCode || '';

        var orderTypeBadge = '<span class="od-badge od-badge-guest">' + (data.orderTypeDisplay || 'Guest') + '</span>';

        var html = '';

        // Order Code & Status Header Strip
        html += '<div class="od-header-strip">';
        html += '<div class="od-header-left">';
        html += '<span class="od-order-code">#' + data.orderId + '</span>';
        html += orderTypeBadge;
        html += '</div>';
        html += '<div class="od-header-right">';
        html += getStatusBadge(data.orderStatus, data.orderStatusDisplay);
        html += '</div>';
        html += '</div>';

        // Info Grid
        html += '<div class="od-info-grid">';

        if (data.guestName) {
            html += '<div class="od-info-item">';
            html += '<div class="od-info-icon"><i class="fa-light fa-user-group"></i></div>';
            html += '<div class="od-info-content"><span class="od-info-label">Guest Name</span><span class="od-info-value">' + data.guestName + '</span></div>';
            html += '</div>';
        }

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-user"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">' + empLabel + '</span><span class="od-info-value">' + empName + (empCode ? ' <small class="text-muted">(' + empCode + ')</small>' : '') + '</span></div>';
        html += '</div>';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-store"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">Canteen</span><span class="od-info-value">' + (data.canteenName || '-') + '</span></div>';
        html += '</div>';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-building"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">Department</span><span class="od-info-value">' + (data.departmentName || '-') + '</span></div>';
        html += '</div>';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-calendar"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">Date</span><span class="od-info-value">' + formatDateDisplay(data.orderDate) + '</span></div>';
        html += '</div>';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-clock"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">Slot</span><span class="od-info-value">' + (data.slotName || '-') + '</span></div>';
        html += '</div>';

        html += '<div class="od-info-item">';
        html += '<div class="od-info-icon"><i class="fa-light fa-shield-check"></i></div>';
        html += '<div class="od-info-content"><span class="od-info-label">Policy</span><span class="od-info-value">' + (data.policyName || '-') + '</span></div>';
        html += '</div>';

        html += '</div>';

        // Remarks
        if (data.remarks) {
            html += '<div class="od-remarks"><i class="fa-light fa-message-lines"></i> ' + data.remarks + '</div>';
        }

        // Items Section
        html += '<div class="od-items-section">';
        html += '<div class="od-section-title"><i class="fa-light fa-utensils"></i> Order Items</div>';
        var items = data.items || [];
        for (var i = 0; i < items.length; i++) {
            var item = items[i];
            html += '<div class="od-item-row">';
            var detailImgSrc = item.imageUrl || '/assets/images/icon_food.svg';
            html += '<div class="od-item-name"><img src="' + detailImgSrc + '" alt="" style="width:30px; height:30px; border-radius:6px !important; object-fit:cover; border:1px solid #e7ecf1;" onerror="this.onerror=null; this.src=\'/assets/images/icon_food.svg\';">' + getDietaryIcon(item.dietaryType, item.isJainFriendly) + ' ' + item.mealName + '</div>';
            html += '<div class="od-item-meta">';
            html += '<span class="od-item-qty">x' + item.quantity + '</span>';
            html += '<span class="od-item-price">' + formatCurrency(item.unitPrice) + '</span>';
            html += '<span class="od-item-total">' + formatCurrency(item.itemTotal) + '</span>';
            html += '</div>';
            html += '</div>';
        }
        html += '</div>';

        // Financial Summary
        html += '<div class="od-summary-section">';
        html += '<div class="od-summary-row"><span>Gross Total</span><span class="od-summary-value">' + formatCurrency(data.grossAmount) + '</span></div>';
        html += '<div class="od-summary-row od-summary-subsidy"><span><i class="fa-light fa-badge-percent"></i> Subsidy</span><span class="od-summary-value green_font">' + formatCurrency(data.subsidyAmount) + '</span></div>';
        html += '<div class="od-summary-row od-summary-net"><span>Net (You Pay)</span><span class="od-summary-value">' + formatCurrency(data.netAmount) + '</span></div>';
        html += '</div>';

        $('#orderDetailBody').html(html);

        // Action buttons in modal footer
        var footerHtml = '';
        if (isedit === 'True' && data.orderStatus === 0 && RoleId !== '6811') {
            footerHtml += '<button class="btn clear_btn" onclick="cancelGuestOrder(' + data.orderId + '); $(\'#orderDetailModal\').modal(\'hide\');"><i class="fa-regular fa-ban"></i> Cancel Order</button>';
        }
    }

    // ==================== Cancel Order ====================

    function cancelGuestOrder(orderId) {
        checkSession();
        Swal.fire({
            html: '<div class="swal_subtitle"><b>Are you sure you want to cancel this order?</b></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Cancel Order",
            input: 'text',
            inputPlaceholder: 'Reason (optional)',
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            confirmButtonText: 'Cancel Order',
            cancelButtonText: 'Keep Order',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: _webapiurl + 'orders/' + orderId + '/cancel',
                    type: 'PUT',
                    headers: { 'Authorization': 'Bearer ' + _tokan },
                    contentType: 'application/json',
                    data: JSON.stringify({ reason: result.value || '' }),
                    success: function (data) {
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>Order cancelled successfully.</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Cancelled!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
                        if (guestOrdersTable) guestOrdersTable.ajax.reload(null, false);
                    },
                    error: function (xhr) {
                        var msg = "Failed to cancel order";
                        if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>' + msg + '</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                    }
                });
            }
        });
        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
    }

    // ==================== Add Guest Order Modal ====================

    function openAddGuestOrderModal() {
        // Reset form
        $('#GuestName').val('');
        $('#GuestCanteenId').val('');
        $('#GuestSlotId').html('<option value="">-- Select Slot --</option>');
        var today = formatDateApi(new Date());
        $('#GuestOrderDate').val(today).attr('min', today);
        $('#GuestRemarks').val('');
        guestCart = [];
        currentMenuItems = [];
        removeFieldErrors();

        // Reset steps
        $('#guestStep1').show();
        $('#guestStep2').hide();
        $('#btnLoadMenu').show();
        $('#btnPlaceGuestOrder').hide();
        $('#btnBackToSetup').hide();

        // Hide company dropdown for all roles - not needed for guest order
        $('#modalCompanyGroup').hide();
        @if (_RoleId == 1)
        {
            <text>
            // SA: load all employees across companies
            initHostEmpDropdown('@_cmpid');
            </text>
        }
        else
        {
            <text>
            initHostEmpDropdown(CompanyId);
            </text>
        }

        $('#addGuestOrderModal').modal('show');
    }

    function initHostEmpDropdown(companyId) {
        if (!companyId) {
            return;
        }

        if (HostEmpDropdown) {
            HostEmpDropdown.clearDropdown();
            HostEmpDropdown = null;
        }

        HostEmpDropdown = new Select2Dropdown({
            dropdownId: "HostEmpId",
            apiUrl: '@_webapiurlMain' + "DataDropDownOptimize/GetEmployeeCmpBranchPaginatDropDown",
            dataKey: "Id",
            labelKey: "Name",
            chunkSize: '@_ChunkSize',
            token: '@_tokan',
            extraParams: { CompanyID: companyId, BranchID: '', DepartID: '', IsActive: 1 }
        });
    }

    // Canteen change in modal: load meal slots
    $(document).on('change', '#GuestCanteenId', function () {
        var canteenId = $(this).val();
        loadCanteenMealSlots(canteenId);
        // Reset step 2
        $('#guestStep2').hide();
        $('#btnLoadMenu').show();
        $('#btnPlaceGuestOrder').hide();
        $('#btnBackToSetup').hide();
    });

    // Keypress validation for text fields
    $(document).on('keypress', '#GuestName', function (e) {
        return validateKeyPress(e.which);
    });
    $(document).on('keypress', '#GuestRemarks', function (e) {
        return validateAddress(e.which);
    });

    // Load Menu button
    $(document).on('click', '#btnLoadMenu', function () {
        var isValid = true;
        removeFieldErrors();

        var guestName = $('#GuestName').val().trim();
        var hostEmpId = $('#HostEmpId').val();
        var canteenId = $('#GuestCanteenId').val();
        var orderDate = $('#GuestOrderDate').val();
        var slotId = $('#GuestSlotId').val();

        if (!guestName) { addFieldError('GuestName'); isValid = false; }
        if (!hostEmpId) { addFieldError('HostEmpId'); isValid = false; }
        if (!canteenId) { addFieldError('GuestCanteenId'); isValid = false; }
        if (!orderDate) { addFieldError('GuestOrderDate'); isValid = false; }
        if (!slotId) { addFieldError('GuestSlotId'); isValid = false; }

        if (!isValid) {
            toastr.warning("Please fill all required fields");
            return;
        }

        // Load menu items
        loadGuestMenuItems(canteenId, orderDate, slotId);
    });

    function loadGuestMenuItems(canteenId, orderDate, slotId) {
        $('#guestMenuItemsSection').html('<div style="text-align:center;padding:30px;"><i class="fa-thin fa-spinner fa-spin fa-2x"></i><p>Loading menu...</p></div>');
        $('#guestStep1').hide();
        $('#guestStep2').show();
        $('#btnLoadMenu').hide();
        $('#btnPlaceGuestOrder').show();
        $('#btnBackToSetup').show();

        $.ajax({
            url: _webapiurl + 'daily-menu/employee-view',
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: { canteenId: canteenId, date: orderDate, mealSlotId: slotId },
            success: function (data) {
                renderGuestMenuItems(data);
            },
            error: function (xhr) {
                var msg = "Failed to load menu";
                if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;
                $('#guestMenuItemsSection').html('<div class="alert alert-warning">' + msg + '</div>');
            }
        });
    }

    function renderGuestMenuItems(data) {
        currentMenuItems = data.meals || [];
        var slot = data.mealSlot || {};

        var html = '';

        // Slot info bar
        html += '<div class="portlet" style="margin-bottom:10px;">';
        html += '<div class="d-flex justify-content-between flex-wrap">';
        html += '<div>';
        html += '<strong>' + (slot.slotName || '') + '</strong>';
        html += ' | Serving: ' + (slot.servingTime || '-');
        html += ' | Cutoff: ' + (slot.orderCutoffTime || '-');
        html += '</div>';
        if (!slot.isOrderingOpen) {
            html += '<span class="text-danger"><span>Ordering Closed</span></span>';
        } else {
            html += '<span class="text-success"><span>Ordering Open</span></span>';
        }
        html += '</div></div>';

        if (!slot.isOrderingOpen) {
            html += '<div class="alert alert-danger">Order cutoff time has passed for this slot. You cannot place guest orders.</div>';
            $('#guestMenuItemsSection').html(html);
            $('#btnPlaceGuestOrder').prop('disabled', true);
            return;
        }

        if (currentMenuItems.length === 0) {
            html += '<div class="alert alert-info">No items available for this slot today.</div>';
            $('#guestMenuItemsSection').html(html);
            $('#btnPlaceGuestOrder').prop('disabled', true);
            return;
        }

        // Menu items as cards
        html += '<div class="row">';
        for (var i = 0; i < currentMenuItems.length; i++) {
            var item = currentMenuItems[i];
            var availText = '';
            if (item.remainingQty !== null && item.remainingQty !== undefined) {
                availText = '<small class="text-muted">' + item.remainingQty + ' left</small>';
            }
            var disabled = !item.isAvailable || (item.remainingQty !== null && item.remainingQty <= 0);
            var specialBadge = item.isSpecial ? ' <span class="badge badge-warning">Special</span>' : '';

            var mealImgSrc = item.imageUrl || '/assets/images/icon_food.svg';
            html += '<div class="col-md-12" style="margin-bottom:10px;">';
            html += '<div class="portlet" style="margin:0; ' + (disabled ? 'opacity:0.6;' : '') + '">';
            html += '<div class="portlet-body" style="padding:10px;">';
            html += '<div style="display:flex; gap:10px; align-items:flex-start;">';
            html += '<img src="' + mealImgSrc + '" alt="" style="width:60px; height:60px; border-radius:6px !important; object-fit:cover; border:2px solid #e7ecf1; flex-shrink:0;" onerror="this.onerror=null; this.src=\'/assets/images/icon_food.svg\';">';
            html += '<div style="flex:1;">';
            html += '<div>' + getDietaryIcon(item.dietaryType, item.isJainFriendly) + ' ' + item.mealName + '</div>' + specialBadge;
            html += '<span style="font-size:16px; color:#333;"><strong>' + formatCurrency(item.price) + '</strong></span> ' + (item.remainingQty !== null && item.remainingQty !== undefined ? '<small class="orange_font">(' + item.remainingQty + ' left)</small>' : '');
            if (item.mealDescription) {
                html += '<br><small class="text-muted">' + item.mealDescription + '</small>';
            }
            html += '</div>';
            html += '<div class="text-right" style="flex-shrink:0;">';
            if (!disabled) {
                html += '<div class="input-group input-group-sm" style="width:80px; display:inline-flex;">';
                html += '<input type="number" class="form-control text-center guest-menu-item-qty" id="gqty_' + item.dailyMenuId + '" value="1" min="1" max="' + (item.remainingQty || 100) + '" style="width:45px;">';
                html += '</div>';
                html += '<button class="btn btn-sm save_btn" onclick="addToGuestCart(' + item.dailyMenuId + ')"><i class="fa-solid fa-plus"></i> Add</button>';
            } else {
                html += '<span class="text-danger"><small>Unavailable</small></span>';
            }
            html += '</div>';
            html += '</div>';
            html += '</div></div></div>';
        }
        html += '</div>';


        // Cart section
        html += '<hr style="margin:10px 0;">';
        html += '<h5 style="font-weight: 500;">Cart Itmes</h5>';
        html += '<div id="guestCartSection">';
        html += '<div class="portlet">';
        html += '<div class="text-muted text-center" style="padding:10px;"><div><i class="fa-light fa-cart-circle-xmark" style="font-size: 32px; line-height: 32px; margin-bottom: 8px;"></i></div>No items added yet.</div>';
        html += '</div></div>';

        // Gross total display and remarks
        html += '<div class="row" style="margin-top:10px;">';
        html += '<div class="col-md-6">';
        html += '<div class="form-group">';
        html += '<label class="control-label">Remarks</label>';
        html += '<input type="text" class="form-control input-sm" id="GuestRemarks" placeholder="Any special instructions (optional)" maxlength="500">';
        html += '</div>';
        html += '</div>';
        html += '<div class="col-md-6 text-right" style="padding-top:30px;">';
        html += '<strong>Gross Total: <span id="guestGrossTotal">0</span></strong>';
        html += '</div>';
        html += '</div>';

        $('#guestMenuItemsSection').html(html);
        $('#btnPlaceGuestOrder').prop('disabled', false);
    }

    // ==================== Guest Cart ====================

    function addToGuestCart(dailyMenuId) {
        var item = null;
        for (var i = 0; i < currentMenuItems.length; i++) {
            if (currentMenuItems[i].dailyMenuId === dailyMenuId) {
                item = currentMenuItems[i];
                break;
            }
        }
        if (!item) return;

        var qty = parseInt($('#gqty_' + dailyMenuId).val()) || 1;
        var maxQty = item.remainingQty;

        // Check if already in cart
        var existingIdx = -1;
        for (var i = 0; i < guestCart.length; i++) {
            if (guestCart[i].dailyMenuId === dailyMenuId) {
                existingIdx = i;
                break;
            }
        }

        // Validate against remaining quantity
        if (maxQty !== null && maxQty !== undefined) {
            var alreadyInCart = existingIdx >= 0 ? guestCart[existingIdx].quantity : 0;
            if (alreadyInCart + qty > maxQty) {
                var allowed = maxQty - alreadyInCart;
                if (allowed <= 0) {
                    toastr.warning("Only " + maxQty + " available for '" + item.mealName + "'. Already " + alreadyInCart + " in cart.");
                    return;
                }
                qty = allowed;
                toastr.info("Only " + allowed + " more available. Adjusted quantity.");
            }
        }

        if (existingIdx >= 0) {
            guestCart[existingIdx].quantity += qty;
        } else {
            guestCart.push({
                dailyMenuId: item.dailyMenuId,
                mealId: item.mealId,
                mealName: item.mealName,
                dietaryType: item.dietaryType,
                isJainFriendly: item.isJainFriendly || false,
                imageUrl: item.imageUrl || '',
                unitPrice: item.price,
                quantity: qty,
                remainingQty: maxQty
            });
        }

        renderGuestCart();
        toastr.success(item.mealName + ' added to cart');
    }

    function removeFromGuestCart(index) {
        guestCart.splice(index, 1);
        renderGuestCart();
    }

    function updateGuestCartQty(index, newQty) {
        if (newQty <= 0) {
            removeFromGuestCart(index);
            return;
        }
        var maxQty = guestCart[index].remainingQty;
        if (maxQty !== null && maxQty !== undefined && newQty > maxQty) {
            toastr.warning("Only " + maxQty + " available for '" + guestCart[index].mealName + "'.");
            newQty = maxQty;
        }
        guestCart[index].quantity = newQty;
        renderGuestCart();
    }

    function renderGuestCart() {
        if (guestCart.length === 0) {
            $('#guestCartSection').html('<div class="portlet"><div class="text-muted text-center" style="padding:10px;"><div><i class="fa-light fa-cart-circle-xmark" style="font-size: 32px; line-height: 32px; margin-bottom: 8px;"></i></div>No items added yet.</div></div>');
            $('#guestGrossTotal').text('-');
            return;
        }

        var html = '<div class="portlet">';
        html += '<div class="table-responsive" style="height:auto;">';
        html += '<table class="table table-condensed table-bordered" style="margin-bottom:5px;">';
        html += '<thead><tr><th>Item</th><th style="width:80px;">Qty</th><th style="width:100px;">Price</th><th style="width:100px;">Total</th><th style="width:45px;">Action</th></tr></thead>';
        html += '<tbody>';
        html += '</div>';

        var grossTotal = 0;
        for (var i = 0; i < guestCart.length; i++) {
            var c = guestCart[i];
            var itemTotal = c.unitPrice * c.quantity;
            grossTotal += itemTotal;

            html += '<tr>';
            var cartImgSrc = c.imageUrl || '/assets/images/icon_food.svg';
            html += '<td><div style="display:flex; align-items:center; gap:6px;"><img src="' + cartImgSrc + '" alt="" style="width:30px; height:30px; border-radius:6px !important; object-fit:cover; border:1px solid #e7ecf1;" onerror="this.onerror=null; this.src=\'/assets/images/icon_food.svg\';">' + getDietaryIcon(c.dietaryType, c.isJainFriendly) + ' ' + c.mealName + '</div></td>';
            html += '<td><input type="number" class="form-control input-sm text-center" value="' + c.quantity + '" min="1" max="' + (c.remainingQty || 100) + '" onchange="updateGuestCartQty(' + i + ', parseInt(this.value))" style="width:60px;"></td>';
            html += '<td>' + formatCurrency(c.unitPrice) + '</td>';
            html += '<td>' + formatCurrency(itemTotal) + '</td>';
            html += '<td><a class="btn red_btnnew tooltips" data-placement="top" data-original-title="Remove" onclick="removeFromGuestCart(' + i + ')"><i class="fa-solid fa-xmark"></i></a></td>';
            html += '</tr>';
        }

        html += '</tbody>';
        html += '</table>';
        html += '</div>';

        $('#guestCartSection').html(html);
        $('#guestGrossTotal').text(formatCurrency(grossTotal));
        $('.tooltips').tooltip();
    }

    // ==================== Place Guest Order ====================

    $(document).on('click', '#btnPlaceGuestOrder', function () {
        placeGuestOrder();
    });

    function placeGuestOrder() {
        checkSession();

        if (guestCart.length === 0) {
            toastr.warning("Please add at least one item to the order");
            return;
        }

        var canteenId = parseInt($('#GuestCanteenId').val());
        var slotId = parseInt($('#GuestSlotId').val());
        var orderDate = $('#GuestOrderDate').val();
        var guestName = $('#GuestName').val().trim();
        var hostEmpId = parseInt($('#HostEmpId').val());
        var remarks = $('#GuestRemarks').val() ? $('#GuestRemarks').val().trim() : null;

        if (!canteenId || !slotId || !orderDate || !guestName || !hostEmpId) {
            toastr.warning("Please fill all required fields");
            return;
        }

        var items = [];
        for (var i = 0; i < guestCart.length; i++) {
            items.push({
                dailyMenuId: guestCart[i].dailyMenuId,
                quantity: guestCart[i].quantity
            });
        }

        var payload = {
            canteenId: canteenId,
            mealSlotId: slotId,
            orderDate: orderDate,
            guestName: guestName,
            hostEmpId: hostEmpId,
            items: items,
            remarks: remarks
        };

        // Hide modal first so Swal is not behind it
        $('#addGuestOrderModal').modal('hide');

        $('#addGuestOrderModal').one('hidden.bs.modal', function () {
            Swal.fire({
                html: '<div class="swal_subtitle"><b>Place guest order for ' + guestName + '?</b></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Confirm Order",
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                confirmButtonText: 'Place Order',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    submitGuestOrder(payload);
                } else {
                    // Re-open modal if user cancels
                    $('#addGuestOrderModal').modal('show');
                }
            });
            $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
        });
    }

    function submitGuestOrder(payload) {
        $('#btnPlaceGuestOrder').prop('disabled', true).html('<i class="fa-thin fa-spinner fa-spin"></i> Placing Order...');

        $.ajax({
            url: _webapiurl + 'orders/guest',
            type: 'POST',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (data) {
                $('#addGuestOrderModal').modal('hide');

                Swal.fire({
                    html: '<div class="swal_subtitle"><b>' + (data.message || 'Guest order placed successfully!') + '</b></div>',
                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Success!",
                    showCloseButton: true,
                    confirmButtonText: 'OK',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    customClass: {
                        confirmButton: 'swal-confirm-button-class'
                    }
                }).then((result) => {
                    // Show order detail if orderId returned
                    if (data.orderId) {
                        viewOrderDetail(data.orderId);
                    }
                });
                $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');

                // Reset cart and reload table
                guestCart = [];
                currentMenuItems = [];
                if (guestOrdersTable) guestOrdersTable.ajax.reload(null, false);
            },
            error: function (xhr) {
                var msg = "Failed to place guest order";
                if (xhr.responseJSON && xhr.responseJSON.detail) msg = xhr.responseJSON.detail;

                // 409: duplicate order, stock exceeded, limit exceeded
                var swalTitle = xhr.status === 409
                    ? "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Cannot Place Order"
                    : "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error!";

                Swal.fire({
                    html: '<div class="swal_subtitle"><b>' + msg + '</b></div>',
                    title: swalTitle,
                    showCloseButton: true,
                    confirmButtonText: 'OK',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    customClass: {
                        confirmButton: 'swal-confirm-button-class'
                    }
                }).then(function () {
                    // Re-open modal so user can adjust cart
                    $('#addGuestOrderModal').modal('show');
                });
                $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
            },
            complete: function () {
                $('#btnPlaceGuestOrder').prop('disabled', false).html('<i class="fa-light fa-cart-shopping"></i> Place Guest Order');
            }
        });
    }

    // Back to step 1
    $(document).on('click', '#btnBackToSetup', function () {
        guestCart = [];
        currentMenuItems = [];
        $('#guestStep2').hide();
        $('#guestStep1').show();
        $('#btnLoadMenu').show();
        $('#btnPlaceGuestOrder').hide();
        $('#btnBackToSetup').hide();
    });

    // ==================== Field Validation Helpers ====================

    function addFieldError(fieldId) {
        $('#' + fieldId).addClass('field_error');
    }

    function removeFieldErrors() {
        $('.field_error').removeClass('field_error');
    }
</script>

