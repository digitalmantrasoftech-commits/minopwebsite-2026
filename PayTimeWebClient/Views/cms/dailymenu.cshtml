    // ========================================
    // COPY MENU
    // ========================================
    function openCopyModal() {
        $('#CopySourceDate').val('');
        $('#CopyIncludeManual').prop('checked', true);
        $('#CopyIncludeRemovals').prop('checked', false);
        $('#CopyOverwrite').prop('checked', false);
        $('#copyModal').modal('show');
    }

    function executeCopy() {
        checkSession();

        var sourceDate = $('#CopySourceDate').val();
        if (!sourceDate) {
            toastr.warning("Please select a source date");
            return;
        }

        var payload = {
            canteenId: parseInt(selectedCanteenId),
            sourceDate: sourceDate,
            targetDate: formatDateApi(currentDate),
            includeManualItems: $('#CopyIncludeManual').is(':checked'),
            includeRemovals: $('#CopyIncludeRemovals').is(':checked'),
            overwriteExisting: $('#CopyOverwrite').is(':checked')
        };

        $('#copyModal').modal('hide');

        Swal.fire({
            html: '<div class="swal_subtitle"><b>Copy menu from ' + sourceDate + ' to ' + formatDateApi(currentDate) + '?</b></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Are you sure?",
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            cancelButtonText: 'Cancel',
            confirmButtonText: 'Yes, copy!',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: _webapiurl + "daily-menu/copy",
                    headers: { 'Authorization': 'Bearer ' + _tokan },
                    data: JSON.stringify(payload),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        var data = response.data || response;
                        var msg = response.message || 'Menu copied successfully';
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>' + msg + '</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Success!",
                            showCloseButton: true, confirmButtonText: 'OK',
                            allowOutsideClick: false, allowEscapeKey: false,
                            customClass: { confirmButton: 'swal-confirm-button-class' }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
                        loadDailyMenu();
                    },
                    error: function (xhr) {
                        var errorMsg = getApiErrorMessage(xhr, "Error copying menu");
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>' + errorMsg + '</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error!",
                            showCloseButton: true, confirmButtonText: 'OK',
                            allowOutsideClick: false, allowEscapeKey: false,
                            customClass: { confirmButton: 'swal-confirm-button-class' }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                    }
                });
