                        <input type="hidden" id="AddMealSlotId">

                        <!-- Select Meal Section -->
                        <div class="add-section-card">
                            <div class="add-section-label">Select Meal</div>
                            <div id="addItemMealLoader" style="text-align:center;padding:30px;display:none;">
                                <img src="~/LandingAssets/images/loading.gif" style="width:40px;" alt="loading" />
                            </div>
                            <div id="addItemMealEmpty" style="display:none;">
                                <div class="add-empty-state">
                                    <i class="fa-light fa-plate-utensils"></i>
                                    <p>All meals are already added to this slot.</p>
                                </div>
                            </div>
                            <div class="add-meal-list-card" id="addItemMealList" style="display:none;"></div>
                        </div>

                        <!-- Quantity Section -->
                        <div class="add-section-card" style="margin-bottom:0;">
                            <div class="add-section-label">Quantity Limit</div>
                            <div class="add-radio-group">
                                <label class="add-radio-option">
                                    <input type="radio" name="AddQtyType" value="unlimited" checked>
                                    <div class="add-radio-card"><i class="fa-regular fa-infinity"></i> Unlimited</div>
                                </label>
                                <label class="add-radio-option">
                                    <input type="radio" name="AddQtyType" value="limited">
                                    <div class="add-radio-card"><i class="fa-regular fa-hashtag"></i> Limited</div>
                                </label>
                            </div>
                            <div id="AddQtyInput" style="display:none;">
                                <input type="number" class="form-control" id="AddQtyValue" placeholder="Enter available quantity" min="1" style="width:180px;">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-lg-12 text-right">
                            <button type="button" class="btn clear_btn" data-dismiss="modal"><i class="fa-light fa-xmark"></i> Cancel</button>
                            <button type="button" id="btnExecuteAddItem" class="btn save_btn"><i class="fa-solid fa-plus"></i> Add to Menu</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Remove Item Modal -->
    <div id="removeModal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog w-500">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Remove Item for Today</h4>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="RemoveDailyMenuId">

                    <div class="modal-card">
                        <!-- Meal Info Card (reuses edit-meal-card) -->
                        <div id="removeMealInfo"></div>

                        <!-- Warning Banner -->
                        <div class="remove-warning-banner">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span>This will hide the item from today's menu only. The template will not be affected.</span>
                        </div>

                        <!-- Reason Section (reuses edit-section-card) -->
                        <div class="edit-section-card" style="margin-bottom:0;">
                            <div class="edit-section-label">Removal Reason</div>
                            <input type="text" class="form-control" id="RemoveReason" placeholder="e.g., Ingredient not available" maxlength="255">
                            <small class="text-muted" style="margin-top:4px;display:block;">Optional - helps staff understand why the item was removed.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-lg-12 text-right">
                            <button type="button" class="btn clear_btn" data-dismiss="modal"><i class="fa-light fa-xmark"></i> Cancel</button>
                            <button type="button" id="btnExecuteRemove" class="btn save_btn" style="background:#dc3545;border-color:#dc3545;"><i class="fa-solid fa-eye-slash"></i> Remove Item</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Item Modal -->
    <div id="editItemModal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog w-500">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Edit Item</h4>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="EditDailyMenuId">
                    <div class="modal-card">

                        <!-- Meal Info Card -->
                        <div id="editMealInfo"></div>

                        <!-- Sold Info Badge -->
                        <div id="editSoldInfo" style="display:none;"></div>

                        <!-- Quantity Section -->
                        <div class="edit-section-card">
                            <div class="edit-section-label">Available Quantity</div>
                            <div class="edit-radio-group">
                                <label class="edit-radio-option">
                                    <input type="radio" name="EditQtyType" value="unlimited">
                                    <div class="radio-card"><i class="fa-regular fa-infinity"></i> Unlimited</div>
                                </label>
                                <label class="edit-radio-option">
                                    <input type="radio" name="EditQtyType" value="limited">
                                    <div class="radio-card"><i class="fa-regular fa-hashtag"></i> Limited</div>
                                </label>
                            </div>
                            <div id="EditQtyInput" style="display:none;">
                                <input type="number" class="form-control" id="EditQtyValue" placeholder="Enter available quantity" min="1" style="width:180px;">
                            </div>
                        </div>

                        <!-- Availability Section -->
                        <div class="edit-section-card" style="margin-bottom:0;">
                            <div class="edit-section-label">Ordering Status</div>
                            <div class="edit-radio-group">
                                <label class="edit-radio-option">
                                    <input type="radio" name="EditAvailability" value="true" checked>
                                    <div class="radio-card"><i class="fa-regular fa-circle-check"></i> Available</div>
                                </label>
                                <label class="edit-radio-option">
                                    <input type="radio" name="EditAvailability" value="false">
                                    <div class="radio-card"><i class="fa-regular fa-circle-pause"></i> Not Available</div>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-lg-12 text-right">
                            <button type="button" class="btn clear_btn" data-dismiss="modal"><i class="fa-light fa-xmark"></i> Cancel</button>
                            <button type="button" class="btn save_btn" id="btnExecuteEditItem"><i class="fa-light fa-floppy-disk"></i> Update</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Copy Menu Modal -->
    <div id="copyModal" class="modal fade copyModal" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog w-500">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Copy Menu From Another Day</h4>
                </div>
                <div class="modal-body">
                    <div class="modal-card">
                        <!-- Source Date Section -->
                        <div class="copy-section-card">
                            <div class="copy-section-label">Source Date</div>
                            <input type="date" class="form-control" id="CopySourceDate">
                            <span class="copy-date-hint">Copy menu items from this date to the current date.</span>
                        </div>

                        <!-- Copy Options Section -->
                        <div class="copy-section-card" style="margin-bottom:0;">
                            <div class="copy-section-label">Copy Options</div>
                            <label class="copy-option-item">
                                <input type="checkbox" id="CopyIncludeManual" checked>
                                <span class="option-text">
                                    <span class="option-label">Include special (manual) items</span>
                                    <span class="option-hint">Copy today-only items added manually</span>
                                </span>
                            </label>
                            <label class="copy-option-item">
                                <input type="checkbox" id="CopyIncludeRemovals">
                                <span class="option-text">
                                    <span class="option-label">Include removals</span>
                                    <span class="option-hint">Copy hidden/removed item status</span>
                                </span>
                            </label>
                            <label class="copy-option-item">
                                <input type="checkbox" id="CopyOverwrite">
                                <span class="option-text">
                                    <span class="option-label">Overwrite existing menu</span>
                                    <span class="option-hint">Replace target date menu entirely</span>
                                </span>
                            </label>
                            <div class="copy-warning-hint">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <span>Overwrite will replace any existing menu for the target date.</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-lg-12 text-right">
                            <button type="button" class="btn clear_btn" data-dismiss="modal"><i class="fa-light fa-xmark"></i> Cancel</button>
                            <button type="button" id="btnExecuteCopy" class="btn save_btn"><i class="fa-regular fa-copy"></i> Copy Menu</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Calendar Modal -->
    <div id="calendarModal" class="modal fade calendarModal" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Menu Calendar</h4>
                </div>
                <div class="modal-body">
                    <div class="modal-card">
                        <div class="cal-nav-bar">
                            <button type="button" class="cal-nav-btn" onclick="navigateCalendarMonth(-1)"><i class="fa-solid fa-chevron-left"></i></button>
                            <div class="cal-nav-center">
                                <span class="cal-month-year" id="calendarMonthYear"></span>
                                <span class="cal-template-name" id="calendarTemplateName"></span>
                            </div>
                            <button type="button" class="cal-nav-btn" onclick="navigateCalendarMonth(1)"><i class="fa-solid fa-chevron-right"></i></button>
                        </div>
                        <div class="cal-grid-card">
                            <div id="calendarGrid"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn clear_btn" data-dismiss="modal"><i class="fa-light fa-xmark"></i> Close</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        <strong>Unauthorized Access.</strong> You do not have permission to view this page.
    </div>
}
