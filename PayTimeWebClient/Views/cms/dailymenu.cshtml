    // ========================================
    // EDIT ITEM
    // ========================================
    function editItem(dailyMenuId) {
        checkSession();

        var meal = findMealById(dailyMenuId);
        if (!meal) { toastr.error("Item not found"); return; }

        $('#EditDailyMenuId').val(dailyMenuId);
        var priceDisplay = (meal.price != null) ? '&#8377;' + parseFloat(meal.price).toFixed(2) : '-';
        $('#editMealInfo').html(
            '<div class="edit-meal-card">' +
            '<div class="meal-icon-wrap"><i class="fa-regular fa-utensils"></i></div>' +
            '<div class="meal-details">' +
            '<div class="meal-name">' + getDietaryIcon(meal.dietaryType) + ' ' + escapeHtml(meal.mealName) + '</div>' +
            '<div class="meal-meta">Source: ' + (meal.sourceDisplay || getSourceDisplay(meal.source)) + '</div>' +
            '</div>' +
            '<div class="meal-price-tag">' + priceDisplay + '</div>' +
            '</div>'
        );

        // Set quantity
        if (meal.availableQty == null) {
            $('input[name="EditQtyType"][value="unlimited"]').prop('checked', true);
            $('#EditQtyInput').hide();
            $('#EditQtyValue').val('');
        } else {
            $('input[name="EditQtyType"][value="limited"]').prop('checked', true);
            $('#EditQtyInput').show();
            $('#EditQtyValue').val(meal.availableQty);
        }

        // Sold info
        if (meal.soldQty > 0) {
            $('#editSoldInfo').html('<div class="edit-sold-badge"><i class="fa-regular fa-receipt"></i> ' + meal.soldQty + ' servings sold</div>').show();
        } else {
            $('#editSoldInfo').hide();
        }

        // Availability
        $('input[name="EditAvailability"][value="' + meal.isAvailable + '"]').prop('checked', true);

        $('#editItemModal').modal('show');
    }

    function executeEditItem() {
        checkSession();

        var dailyMenuId = $('#EditDailyMenuId').val();
        var availableQty = 0;

        if ($('input[name="EditQtyType"]:checked').val() === 'limited') {
            availableQty = parseInt($('#EditQtyValue').val());
            if (!availableQty || availableQty <= 0) {
                toastr.warning("Please enter a valid quantity");
                $('#EditQtyValue').addClass('field_error');
                return;
            }
            $('#EditQtyValue').removeClass('field_error');
        }

        var isAvailable = $('input[name="EditAvailability"]:checked').val() === 'true';

        var payload = {
            availableQty: availableQty,
            isAvailable: isAvailable
        };

        $.ajax({
            type: "PATCH",
            url: _webapiurl + "daily-menu/update-item/" + dailyMenuId,
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: JSON.stringify(payload),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                toastr.success(response.message || "Item updated");
                $('#editItemModal').modal('hide');
                loadDailyMenu();
            },
            error: function (xhr) {
                toastr.error(getApiErrorMessage(xhr, "Error updating item"));
            }
        });
    }

