    let calendarMonth = null;
    let calendarYear = null;

    // Extract the most specific error message from RFC 7807 responses
    function getApiErrorMessage(xhr, fallback) {
        if (xhr.responseJSON) {
            // Check field-level validation errors first (most specific)
            if (xhr.responseJSON.errors) {
                for (var field in xhr.responseJSON.errors) {
                    var msgs = xhr.responseJSON.errors[field];
                    if (Array.isArray(msgs) && msgs.length > 0) {
                        return msgs.join(", ");
                    }
                }
            }
            // Then check detail (but skip generic validation wrapper)
            if (xhr.responseJSON.detail && xhr.responseJSON.detail !== "One or more validation errors occurred.") {
                return xhr.responseJSON.detail;
            }
            if (xhr.responseJSON.message) return xhr.responseJSON.message;
        }
        return fallback;
    }

    // Format date as YYYY-MM-DD
    function formatDateApi(dt) {
        var y = dt.getFullYear();
        var m = ('0' + (dt.getMonth() + 1)).slice(-2);
        var d = ('0' + dt.getDate()).slice(-2);
        return y + '-' + m + '-' + d;
    }

    // Format date for display
    function formatDateDisplay(dt) {
        var days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        var months = ['January', 'February', 'March', 'April', 'May', 'June',
            'July', 'August', 'September', 'October', 'November', 'December'];
        return days[dt.getDay()] + ', ' + dt.getDate() + ' ' + months[dt.getMonth()] + ' ' + dt.getFullYear();
    }

    // ========================================
    // DOCUMENT READY
    // ========================================
    $(document).ready(function () {
        currentDate = new Date();
        updateDateDisplay();

        // Load canteen dropdown directly for all roles
        loadCanteenDropdown();

        // Canteen selector change
        $('#CanteenSelector').change(function () {
            selectedCanteenId = $(this).val();
            if (selectedCanteenId) {
                loadDailyMenu();
            } else {
                selectedCanteenId = null;
                menuData = null;
                $('#menuInfoBar').hide();
                $('#slotContainer').empty();
                $('#emptyState').show();
                $('#emptyMessage').text('Please select a canteen to view the daily menu.');
            }
        });

        // Date navigation
        $('#btnPrevDate').click(function () { navigateDate(-1); });
        $('#btnNextDate').click(function () { navigateDate(1); });
        $('#btnToday').click(function () {
            currentDate = new Date();
            updateDateDisplay();
            if (selectedCanteenId) loadDailyMenu();
        });

        // Date picker
        $('#datePickerInput').datepicker({
            format: 'yyyy-mm-dd',
            autoclose: true,
            todayHighlight: true
        }).on('changeDate', function (e) {
            currentDate = e.date;
            updateDateDisplay();
            if (selectedCanteenId) loadDailyMenu();
        });

        // Generate button
        $('#btnGenerate').click(function () {
            if (!selectedCanteenId) { toastr.warning("Please select a canteen first"); return; }
            checkSession();
            openGenerateModal();
        });

        // Execute generate
        $('#btnExecuteGenerate').click(executeGenerate);

        // Copy button
        $('#btnCopy').click(function () {
            if (!selectedCanteenId) { toastr.warning("Please select a canteen first"); return; }
            checkSession();
            openCopyModal();
        });

        // Execute copy
        $('#btnExecuteCopy').click(executeCopy);

        // Calendar button
        $('#btnCalendar').click(function () {
            if (!selectedCanteenId) { toastr.warning("Please select a canteen first"); return; }
            checkSession();
            openCalendarModal();
        });

        // Execute add item
        $('#btnExecuteAddItem').click(executeAddItem);

        // Execute remove item
        $('#btnExecuteRemove').click(executeRemoveItem);

        // Execute edit item
        $('#btnExecuteEditItem').click(executeEditItem);

        // Keypress validation for text fields
        $('#RemoveReason').on('keypress', function (e) {
            return validateAddress(e.which);
        });

        // Quantity radio toggle in add item modal
        $('input[name="AddQtyType"]').change(function () {
            if ($(this).val() === 'limited') {
                $('#AddQtyInput').show();
            } else {
                $('#AddQtyInput').hide();
            }
        });

        // Quantity radio toggle in edit modal
        $('input[name="EditQtyType"]').change(function () {
            if ($(this).val() === 'limited') {
                $('#EditQtyInput').show();
            } else {
                $('#EditQtyInput').hide();
            }
        });

        // Number-only input for quantity fields
        $(document).on('input', '#AddQtyValue, #EditQtyValue', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        // Filter panel toggle
        $("#Filter_search").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        $(".filterclose_btn").click(function () {
            $(".filter_portlet_wrapper").addClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });
    });

    // ========================================
    // DROPDOWN INITIALIZATION
    // ========================================
    function loadCanteenDropdown() {
        $.ajax({
            type: "GET",
            url: _webapiurl + 'canteens?pageSize=100&isActive=true',
            headers: { 'Authorization': 'Bearer ' + _tokan },
            dataType: "json",
            success: function (response) {
                var $sel = $('#CanteenSelector');
                $sel.empty().append('<option value="">-- Select Canteen --</option>');
                var canteens = response.canteens || [];
                if (canteens.length > 0) {
                    for (var i = 0; i < canteens.length; i++) {
                        $sel.append('<option value="' + canteens[i].canteenId + '">' +
                            escapeHtml(canteens[i].canteenName) + '</option>');
                    }
                    if (canteens.length === 1) {
                        $sel.val(canteens[0].canteenId).trigger('change');
                    } else {
                        // Auto-open filter panel so user can select canteen immediately
                        $(".filter_portlet_wrapper").removeClass("full-width");
                    }
                }
            },
            error: function (xhr) {
                toastr.error(getApiErrorMessage(xhr, "Failed to load canteens"));
            }
        });
    }

    // ========================================
    // DATE NAVIGATION
    // ========================================
    function updateDateDisplay() {
        $('#currentDateDisplay').text(formatDateDisplay(currentDate));
        $('#datePickerInput').val(formatDateApi(currentDate));
    }

    function navigateDate(offset) {
        currentDate.setDate(currentDate.getDate() + offset);
        updateDateDisplay();
        if (selectedCanteenId) loadDailyMenu();
    }

    // ========================================
    // LOAD DAILY MENU
    // ========================================
    function loadDailyMenu() {
        if (!selectedCanteenId) return;

        var dateStr = formatDateApi(currentDate);
        var url = _webapiurl + 'daily-menu?canteenId=' + selectedCanteenId + '&date=' + dateStr;

        $('#slotContainer').empty();
        $('#emptyState').hide();
        $('#menuInfoBar').hide();
        $("#ajax_loader").show();

        $.ajax({
            type: "GET",
            url: url,
            headers: { 'Authorization': 'Bearer ' + _tokan },
            dataType: "json",
            success: function (response) {
                $("#ajax_loader").hide();
                var data = response.data || response;
                menuData = data;
                updateMenuInfo(data);
                renderSlotSections(data);
            },
            error: function (xhr) {
                $("#ajax_loader").hide();
                if (xhr.status === 404) {
                    // No menu generated for this date
                    menuData = null;
                    $('#menuInfoBar').show();
                    $('#menuTemplateName').text('-');
                    $('#menuStatus').html('<span class="text-warning"><i class="fa-solid fa-clock"></i> Not Generated</span>');
                    $('#menuSummaryInfo').text('');
                    $('#slotContainer').empty();
                    $('#emptyState').show();
                    $('#emptyMessage').text('No menu has been generated for this date. Click "Generate" to create the menu.');
                } else {
                    toastr.error(getApiErrorMessage(xhr, "Failed to load daily menu"));
                    $('#emptyState').show();
                    $('#emptyMessage').text('Error loading daily menu.');
                }
            }
        });
    }

    function updateMenuInfo(data) {
        $('#menuInfoBar').show();

        // Template info
        var templateName = null;
        if (data.activeTemplate && data.activeTemplate.templateName) {
            templateName = data.activeTemplate.templateName;
        } else if (data.templateName) {
            templateName = data.templateName;
        }
        $('#menuTemplateName').text(templateName || '-');

        // Generation status
        if (data.isGenerated) {
            var summary = data.summary || {};
            var totalItems = summary.totalItems || 0;
            $('#menuStatus').html('<span class="green_font"><i class="fa-solid fa-check-circle"></i> Generated (' + totalItems + ' items)</span>');

            var summaryParts = [];
            if (summary.fromTemplate > 0) summaryParts.push('Template: ' + summary.fromTemplate);
            if (summary.fromAlways > 0) summaryParts.push('Always: ' + summary.fromAlways);
            if (summary.fromManual > 0) summaryParts.push('Special: ' + summary.fromManual);
            if (summary.removedCount > 0) summaryParts.push('Removed: ' + summary.removedCount);
            $('#menuSummaryInfo').text(summaryParts.join(' | '));
        } else {
            $('#menuStatus').html('<span class="text-warning"><i class="fa-solid fa-clock"></i> Not Generated</span>');
            $('#menuSummaryInfo').text('');
        }
    }

    function renderSlotSections(data) {
        var $container = $('#slotContainer');
        $container.empty();

        var slots = data.slots || [];
        if (slots.length === 0) {
            $('#emptyState').show();
            if (data.isGenerated) {
                $('#emptyMessage').text('No meals found in the menu for this date.');
            } else {
                $('#emptyMessage').text('No menu has been generated for this date. Click "Generate" to create the menu.');
            }
            return;
        }

        $('#emptyState').hide();

        for (var s = 0; s < slots.length; s++) {
            var slot = slots[s];
            var meals = slot.meals || [];

            // Group meals by source
            var templateMeals = meals.filter(function (m) { return m.source === 1; });
            var alwaysMeals = meals.filter(function (m) { return m.source === 2; });
            var manualMeals = meals.filter(function (m) { return m.source === 3; });

            var html = '<div class="panel panel-default slot-panel">';
            html += '<div class="panel-heading slot-heading">';
            html += '<h4 class="panel-title">';
            html += '<i class="fa-regular fa-utensils"></i> ' + escapeHtml(slot.slotName);
            if (slot.servingTime) {
                html += ' <small class="text-muted">(' + escapeHtml(slot.servingTime) + ')</small>';
            }
            html += ' <span class="badge badge-default slot-count">' + meals.length + ' items</span>';
            html += '</h4>';
            html += '</div>';
            html += '<div class="panel-body">';

            // Template meals
            if (templateMeals.length > 0) {
                html += '<div class="source-group">';
                html += '<h5 class="source-title"><i class="fa-regular fa-calendar-week"></i> From Template</h5>';
                html += buildMealTable(templateMeals);
                html += '</div>';
            }

            // Always available meals
            if (alwaysMeals.length > 0) {
                html += '<div class="source-group">';
                html += '<h5 class="source-title"><i class="fa-regular fa-infinity"></i> Always Available</h5>';
                html += buildMealTable(alwaysMeals);
                html += '</div>';
            }

            // Manual/Special meals
            if (manualMeals.length > 0) {
                html += '<div class="source-group">';
                html += '<h5 class="source-title"><i class="fa-solid fa-star" style="color:#f59e0b;"></i> Special (Today Only)</h5>';
                html += buildMealTable(manualMeals);
                html += '</div>';
            }

            if (meals.length === 0) {
                html += '<p class="text-muted text-center" style="padding:8px; font-weight: 500; margin-bottom: 0px;">No meals in this slot.</p>';
            }

            // Add Item button
            if (canadd == "True") {
                html += '<div class="addnew_fields">';
                html += '<a href="javascript:;" class="btn icon_addbtn" onclick="openAddItemModal(' + slot.mealSlotId + ', \'' + escapeHtml(slot.slotName) + '\')">';
                html += '<i class="fa-solid fa-plus"></i> Add Item for Today</a>';
                html += '</div>';
            }

            html += '</div></div>';
            $container.append(html);
        }

        $('.tooltips').tooltip();
    }

    function buildMealTable(meals) {
        var html = '<table class="table table-condensed meal-table">';
        html += '<thead><tr><th style="width:40%;">Meal</th><th style="width:15%;">Price</th><th style="width:15%;">Qty</th><th style="width:30%;">Action</th></tr></thead>';
        html += '<tbody>';

        for (var i = 0; i < meals.length; i++) {
            var m = meals[i];
            var rowClass = m.isRemoved ? 'removed-row' : '';

            html += '<tr class="' + rowClass + '">';

            // Meal name + dietary icon + image
            html += '<td>';
            var mealImgSrc = m.imageUrl || '/assets/images/icon_food.svg';
            html += '<div style="display:flex; align-items:center; gap:8px;">';
            html += '<img src="' + mealImgSrc + '" alt="" style="width:36px; height:36px; border-radius:6px !important; object-fit:cover; border:1px solid #e7ecf1;" onerror="this.onerror=null; this.src=\'/assets/images/icon_food.svg\';">';
            html += '<div>';
            html += getDietaryIcon(m.dietaryType) + ' ';
            if (m.isRemoved) {
                html += '<s>' + escapeHtml(m.mealName) + '</s>';
            } else {
                html += escapeHtml(m.mealName);
            }
            if (m.isJainFriendly) {
                html += ' <small class="text-muted">(Jain)</small>';
            }
            html += '</div></div>';
            html += '</td>';

            // Price
            html += '<td>';
            if (m.price != null) {
                html += parseFloat(m.price).toFixed(2);
            } else {
                html += '-';
            }
            html += '</td>';

            // Quantity
            html += '<td>';
            if (m.isRemoved) {
                html += '<span class="red_font"><i class="fa-solid fa-ban"></i> Removed</span>';
            } else if (m.availableQty == null) {
                html += '<i class="fa-regular fa-infinity"></i>';
            } else {
                var remaining = m.remainingQty != null ? m.remainingQty : m.availableQty;
                html += remaining + '/' + m.availableQty;
                if (remaining === 0) {
                    html += ' <span class="red_font">(Sold Out)</span>';
                }
            }
            html += '</td>';

            // Actions
            html += '<td>';
            if (m.isRemoved) {
                // Show remove reason
                if (m.removeReason) {
                    html += '<small class="text-muted">' + escapeHtml(m.removeReason) + '</small> ';
                }
                if (isedit == "True") {
                    html += '<a href="javascript:;" class="btn btn-xs green_btnnew tooltips" data-placement="top" data-original-title="Restore" onclick="restoreItem(' + m.dailyMenuId + ')">';
                    html += '<i class="fa-solid fa-rotate-left"></i></a>';
                }
            } else {
                if (isedit == "True") {
                    // Edit quantity/availability (for all sources)
                    html += '<a href="javascript:;" class="btn btn-xs seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit Qty" onclick="editItem(' + m.dailyMenuId + ')">';
                    html += '<i class="fa-regular fa-pen-to-square"></i></a> ';

                    // Remove (for template and always items)
                    if (m.source === 1 || m.source === 2) {
                        html += '<a href="javascript:;" class="btn btn-xs red_btnnew tooltips" data-placement="top" data-original-title="Remove Today" onclick="removeItem(' + m.dailyMenuId + ')">';
                        html += '<i class="fa-regular fa-eye-slash"></i></a> ';
                    }
                }
                // Delete (only for manual items, source=3)
                if (isdelete == "True" && m.source === 3) {
                    html += '<a href="javascript:;" class="btn btn-xs red_btnnew tooltips" data-placement="top" data-original-title="Delete" onclick="deleteManualItem(' + m.dailyMenuId + ')">';
                    html += '<i class="fa-regular fa-trash-can"></i></a>';
                }
            }
            html += '</td>';

            html += '</tr>';
        }

        html += '</tbody></table>';
        return html;
    }

    // ========================================
    // GENERATE MENU
    // ========================================
    function openGenerateModal() {
        var today = formatDateApi(new Date());
        $('#GenerateStartDate').val(today);
        $('#GenerateEndDate').val(today);
        $('#GenerateOverwrite').prop('checked', false);
        $('#generateResult').hide();
        $('#generateModal').modal('show');
    }

    function executeGenerate() {
        checkSession();

        var startDate = $('#GenerateStartDate').val();
        var endDate = $('#GenerateEndDate').val();

        if (!startDate || !endDate) {
            toastr.warning("Please select both start and end dates");
            return;
        }

        if (endDate < startDate) {
            toastr.warning("End date must be after start date");
            return;
        }

        var payload = {
            canteenId: parseInt(selectedCanteenId),
            startDate: startDate,
            endDate: endDate,
            overwriteExisting: $('#GenerateOverwrite').is(':checked')
        };

        $('#btnExecuteGenerate').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Generating...');

        $.ajax({
            type: "POST",
            url: _webapiurl + "daily-menu/generate",
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: JSON.stringify(payload),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $('#btnExecuteGenerate').prop('disabled', false).html('<i class="fa-regular fa-bolt"></i> Generate');
                var data = response.data || response;
                var msg = (response.message || 'Menu generated successfully');
                toastr.success(msg);

                // Show result details
                if (data.generated && data.generated.length > 0) {
                    var resultHtml = '<div class="alert alert-success"><b>Generated:</b><ul>';
                    for (var i = 0; i < data.generated.length; i++) {
                        resultHtml += '<li>' + data.generated[i].dayName + ' (' + data.generated[i].date + ') - ' + data.generated[i].itemCount + ' items</li>';
                    }
                    resultHtml += '</ul></div>';
                    if (data.skipped && data.skipped.length > 0) {
                        resultHtml += '<div class="alert alert-warning"><b>Skipped:</b><ul>';
                        for (var j = 0; j < data.skipped.length; j++) {
                            resultHtml += '<li>' + data.skipped[j].date + ' - ' + data.skipped[j].reason + '</li>';
                        }
                        resultHtml += '</ul></div>';
                    }
                    $('#generateResult').html(resultHtml).show();
                }

                loadDailyMenu();
            },
            error: function (xhr) {
                $('#btnExecuteGenerate').prop('disabled', false).html('<i class="fa-regular fa-bolt"></i> Generate');
                toastr.error(getApiErrorMessage(xhr, "Error during menu generation"));
            }
        });
    }

    // ========================================
    // ADD ITEM
    // ========================================
    function openAddItemModal(mealSlotId, slotName) {
        checkSession();

        $('#AddMealSlotId').val(mealSlotId);
        $('#addItemSlotName').text(slotName);
        $('#AddMealId').val('');
        $('input[name="AddQtyType"][value="unlimited"]').prop('checked', true);
        $('#AddQtyInput').hide();
        $('#AddQtyValue').val('');
        $('#addItemMealList').empty();
        $('#addItemMealLoader').show();
        $('#addItemMealEmpty').hide();

        $('#addItemModal').modal('show');

        // Load available items (allocated to canteen but not yet on this date/slot)
        $.ajax({
            type: "GET",
            url: _webapiurl + "daily-menu/available-items?canteenId=" + selectedCanteenId + "&date=" + formatDateApi(currentDate) + "&mealSlotId=" + mealSlotId,
            headers: { 'Authorization': 'Bearer ' + _tokan },
            dataType: "json",
            success: function (data) {
                $('#addItemMealLoader').hide();
                var meals = data.items || data || [];
                if (meals.length === 0) {
                    $('#addItemMealEmpty').show();
                } else {
                    var html = '';
                    for (var i = 0; i < meals.length; i++) {
                        var m = meals[i];
                        html += '<label class="add-meal-item">';
                        html += '<input type="radio" name="AddMealSelection" value="' + m.mealId + '">';
                        html += '<span class="add-meal-info">';
                        html += '<span class="add-meal-name">' + getDietaryIcon(m.dietaryType) + ' ' + escapeHtml(m.mealName) + '</span>';
                        if (m.categoryName) html += '<span class="add-meal-category">(' + escapeHtml(m.categoryName) + ')</span>';
                        html += '</span>';
                        if (m.price != null) html += '<span class="add-meal-price">&#8377;' + parseFloat(m.price).toFixed(2) + '</span>';
                        html += '</label>';
                    }
                    $('#addItemMealList').html(html).show();
                }
            },
            error: function (xhr) {
                $('#addItemMealLoader').hide();
                toastr.error("Failed to load available meals");
                $('#addItemModal').modal('hide');
            }
        });
    }

    function executeAddItem() {
        checkSession();

        var mealSlotId = $('#AddMealSlotId').val();
        var mealId = $('input[name="AddMealSelection"]:checked').val();

        if (!mealId) {
            toastr.warning("Please select a meal");
            return;
        }

        var availableQty = null;
        if ($('input[name="AddQtyType"]:checked').val() === 'limited') {
            availableQty = parseInt($('#AddQtyValue').val());
            if (!availableQty || availableQty <= 0) {
                toastr.warning("Please enter a valid quantity");
                $('#AddQtyValue').addClass('field_error');
                return;
            }
            $('#AddQtyValue').removeClass('field_error');
        }

        var payload = {
            canteenId: parseInt(selectedCanteenId),
            menuDate: formatDateApi(currentDate),
            mealSlotId: parseInt(mealSlotId),
            mealId: parseInt(mealId),
            availableQty: availableQty
        };

        $.ajax({
            type: "POST",
            url: _webapiurl + "daily-menu/add-item",
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: JSON.stringify(payload),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var msg = (response.message || 'Item added to menu');
                toastr.success(msg);
                $('#addItemModal').modal('hide');
                loadDailyMenu();
            },
            error: function (xhr) {
                toastr.error(getApiErrorMessage(xhr, "Error adding item"));
            }
        });
    }

    // ========================================
    // REMOVE ITEM
    // ========================================
    function removeItem(dailyMenuId) {
        checkSession();

        var meal = findMealById(dailyMenuId);
        if (!meal) { toastr.error("Item not found"); return; }

        $('#RemoveDailyMenuId').val(dailyMenuId);
        var priceDisplay = (meal.price != null) ? '&#8377;' + parseFloat(meal.price).toFixed(2) : '-';
        $('#removeMealInfo').html(
            '<div class="edit-meal-card">' +
            '<div class="meal-icon-wrap"><i class="fa-regular fa-utensils"></i></div>' +
            '<div class="meal-details">' +
            '<div class="meal-name">' + getDietaryIcon(meal.dietaryType) + ' ' + escapeHtml(meal.mealName) + '</div>' +
            '<div class="meal-meta">' + formatDateDisplay(currentDate) + '</div>' +
            '</div>' +
            '<div class="meal-price-tag">' + priceDisplay + '</div>' +
            '</div>'
        );
        $('#RemoveReason').val('');

        $('#removeModal').modal('show');
    }

    function executeRemoveItem() {
        checkSession();

        var dailyMenuId = $('#RemoveDailyMenuId').val();
        var reason = $('#RemoveReason').val();

        $.ajax({
            type: "PATCH",
            url: _webapiurl + "daily-menu/remove-item/" + dailyMenuId,
            headers: { 'Authorization': 'Bearer ' + _tokan },
            data: JSON.stringify({
                removeReason: reason || null
            }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                toastr.success(response.message || "Item removed from today's menu");
                $('#removeModal').modal('hide');
                loadDailyMenu();
            },
            error: function (xhr) {
                toastr.error(getApiErrorMessage(xhr, "Error removing item"));
            }
        });
    }

    // ========================================
    // RESTORE ITEM
    // ========================================
    function restoreItem(dailyMenuId) {
        checkSession();

        Swal.fire({
            html: '<div class="swal_subtitle"><b>Restore this item to today\'s menu?</b></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Are you sure?",
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            cancelButtonText: 'Cancel',
            confirmButtonText: 'Yes, restore it!',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    type: "PATCH",
                    url: _webapiurl + "daily-menu/restore-item/" + dailyMenuId,
                    headers: { 'Authorization': 'Bearer ' + _tokan },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>Item restored to menu.</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Restored!",
