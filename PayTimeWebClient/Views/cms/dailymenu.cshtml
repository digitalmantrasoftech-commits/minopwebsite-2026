                $('#copyModal').modal('show');
            }
        });
        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
    }

    // ========================================
    // CALENDAR
    // ========================================
    function openCalendarModal() {
        var today = new Date();
        calendarMonth = currentDate.getMonth() + 1;
        calendarYear = currentDate.getFullYear();
        loadCalendar();
        $('#calendarModal').modal('show');
    }

    function navigateCalendarMonth(offset) {
        calendarMonth += offset;
        if (calendarMonth > 12) { calendarMonth = 1; calendarYear++; }
        if (calendarMonth < 1) { calendarMonth = 12; calendarYear--; }
        loadCalendar();
    }

    function loadCalendar() {
        var url = _webapiurl + 'daily-menu/calendar?canteenId=' + selectedCanteenId +
            '&month=' + calendarMonth + '&year=' + calendarYear;

        $('#calendarGrid').html('<div style="text-align:center;padding:40px;"><i class="fa-thin fa-spinner fa-spin fa-3x"></i></div>');

        $.ajax({
            type: "GET",
            url: url,
            headers: { 'Authorization': 'Bearer ' + _tokan },
            dataType: "json",
            success: function (response) {
                var data = response.data || response;
                renderCalendar(data);
            },
            error: function (xhr) {
                var errorMsg = getApiErrorMessage(xhr, "Failed to load calendar");
                $('#calendarGrid').html('<div class="alert alert-danger">' + errorMsg + '</div>');
            }
        });
    }

    function renderCalendar(data) {
        var months = ['January', 'February', 'March', 'April', 'May', 'June',
            'July', 'August', 'September', 'October', 'November', 'December'];

        $('#calendarMonthYear').text(months[calendarMonth - 1] + ' ' + calendarYear);

        //var templateName = null;
        //if (data.activeTemplate && data.activeTemplate.templateName) {
        //    templateName = data.activeTemplate.templateName;
        //} else if (data.templateName) {
        //    templateName = data.templateName;
        //}
        //$('#calendarTemplateName').text(templateName ? 'Template: ' + templateName : 'No active template');

        var days = data.days || [];
        var dayMap = {};
        for (var i = 0; i < days.length; i++) {
            // Normalize date key to YYYY-MM-DD (strip time part if present)
            var key = (days[i].date || '').substring(0, 10);
            dayMap[key] = days[i];
        }

        // Build calendar grid
        var firstDay = new Date(calendarYear, calendarMonth - 1, 1);
        var lastDay = new Date(calendarYear, calendarMonth, 0);
        var startDow = firstDay.getDay(); // 0=Sun
        // Convert to Mon=0
        startDow = startDow === 0 ? 6 : startDow - 1;

        var html = '<table class="table table-bordered calendar-table">';
        html += '<thead><tr><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th><th>Sun</th></tr></thead>';
        html += '<tbody>';

        var dayNum = 1;
        var totalDays = lastDay.getDate();

        for (var row = 0; row < 6; row++) {
            if (dayNum > totalDays) break;
            html += '<tr>';
            for (var col = 0; col < 7; col++) {
                if ((row === 0 && col < startDow) || dayNum > totalDays) {
                    html += '<td class="calendar-empty"></td>';
                } else {
                    var dateStr = calendarYear + '-' + ('0' + calendarMonth).slice(-2) + '-' + ('0' + dayNum).slice(-2);
                    var dayData = dayMap[dateStr];
                    var cellClass = 'calendar-day';

                    html += '<td class="' + cellClass + '" onclick="calendarDayClick(\'' + dateStr + '\')" style="cursor:pointer;">';
                    html += '<div class="calendar-day-num">' + dayNum + '</div>';

                    if (dayData) {
                        if (dayData.isGenerated) {
                            html += '<div class="calendar-status green_font"><i class="fa-regular fa-check"></i> ' + dayData.itemCount + '</div>';
                            if (dayData.hasOverride && dayData.overrideCount > 0) {
                                html += '<div class="calendar-override text-warning"><i class="fa-regular fa-exclamation-triangle"></i> ' + dayData.overrideCount + '</div>';
                            }
                        } else {
                            html += '<div class="calendar-status text-muted"><i class="fa-light fa-clock"></i></div>';
                        }
                    }

                    html += '</td>';
                    dayNum++;
                }
            }
            html += '</tr>';
        }

        html += '</tbody></table>';

        // Summary
        if (data.summary) {
            var s = data.summary;
            html += '<div class="cal-summary-bar">';
            html += '<span class="cal-stat stat-generated"><i class="fa-regular fa-check"></i> Generated: <b>' + s.generatedDays + '</b></span>';
            html += '<span class="cal-stat stat-pending"><i class="fa-regular fa-clock"></i> Not Generated: <b>' + s.notGeneratedDays + '</b></span>';
            html += '<span class="cal-stat stat-override"><i class="fa-regular fa-triangle-exclamation"></i> With Overrides: <b>' + s.daysWithOverride + '</b></span>';
            html += '</div>';
        }

        $('#calendarGrid').html(html);
    }

    function calendarDayClick(dateStr) {
        var parts = dateStr.split('-');
        currentDate = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
        updateDateDisplay();
        $('#calendarModal').modal('hide');
        if (selectedCanteenId) loadDailyMenu();
    }

    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    function findMealById(dailyMenuId) {
        if (!menuData || !menuData.slots) return null;
        for (var s = 0; s < menuData.slots.length; s++) {
            var meals = menuData.slots[s].meals || [];
            for (var m = 0; m < meals.length; m++) {
                if (meals[m].dailyMenuId == dailyMenuId) return meals[m];
            }
        }
        return null;
    }

    function getSourceDisplay(source) {
        switch (source) {
            case 1: return 'Template';
            case 2: return 'Always';
            case 3: return 'Special';
            default: return '-';
        }
    }

    function getDietaryIcon(dietaryType) {
        switch (dietaryType) {
            case 1:
                return '<i class="fa-solid fa-circle" style="color:#22C55E;font-size:8px;vertical-align:middle;"></i>';
            case 2:
                return '<i class="fa-solid fa-circle" style="color:#EF4444;font-size:8px;vertical-align:middle;"></i>';
            case 3:
                return '<i class="fa-solid fa-circle" style="color:#10B981;font-size:8px;vertical-align:middle;"></i>';
            default:
                return '';
        }
    }

    function escapeHtml(text) {
        if (!text) return '';
        var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, function (m) { return map[m]; });
    }

    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
</script>

