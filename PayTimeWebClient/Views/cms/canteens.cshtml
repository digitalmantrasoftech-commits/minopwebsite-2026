
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Canteen Setup";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    int _cmpid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"]);
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapicms"].ToString();
    string _webapiurlMain = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _ChunkSize = HttpContext.Current.Session["DataDropDownThreShold"] != null
        ? HttpContext.Current.Session["DataDropDownThreShold"].ToString()
        : "500";

    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    string _companyid = "0";
    string _empid = "0";

    if (_RoleId != 1 && _RoleId != 6805 && _RoleId != 6806 && _RoleId != 6811)
    {
        _empid = HttpContext.Current.Session["EmpId"].ToString();
    }
    if (_RoleId == 6805 || _RoleId == 6806 || _RoleId == 6811)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
        ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
        : "false";
}

<script src="~/Pages_JS/VirtuallScroll/NormalDropDownVirtualClientServer.js"></script>

<script>
    let EmpId = '@_empid';
    let RoleId = '@_RoleId';
    let CompanyId = '@_companyid';
    let isedit = '@obj.CanEdit';
    let isdelete = '@obj.CanDelete';
    let CanteenData = [];
    let CompanyDropdown = null;
    let CanteenHeadDropdown = null;
    let currentCanteenHeadUserId = null;
    let canteenTable = null;

    $(document).ready(function () {
        FillTable();

        $(window).on("load", function () {
            initializeDropdowns();
        });

        // Form field validation
        $('#CanteenName').blur(function () {
            validateField('CanteenName');
        });
        $('#CanteenHeadEmail').blur(function () {
            var email = $(this).val().trim();
            if (email) {
                var result = ValidateEmailid(email);
                if (result !== 'success') {
                    $(this).addClass('field_error');
                    toastr.error(result);
                } else {
                    $(this).removeClass('field_error');
                }
            }
        });
        $('#OpeningTime').blur(function () {
            validateField('OpeningTime');
        });
        $('#ClosingTime').blur(function () {
            validateField('ClosingTime');
            validateTimeRange();
        });

        // Keypress validation for text fields
        $('#CanteenName, #PlantName').on('keypress', function (e) {
            return validateKeyPress(e.which);
        });
        $('#Description').on('keypress', function (e) {
            return validateAddress(e.which);
        });

        // Capacity - only allow numbers
        $('#Capacity').on('input', function (e) {
            this.value = this.value.replace(/[^0-9]/g, '');
            let max = parseInt(this.max, 10);
            let value = parseInt(this.value, 10);
            if (value > max) {
                this.value = max;
            }
        });

        $('#btnCanteenSubmit').click(AddCanteen);
        $('#AddCanteen').click(function () {
            checkSession();
            frmClear();
            removeFieldErrors();
            $('#modalTitle').text('Add Canteen');
            $('#myModal').modal('toggle');
        });

        // Search button - reload table with current filter values
        $("#Search_OPration").click(function () {
            FillTable();
        });

        // Clear button - reset filters and reload table
        $("#Clear_OPration").click(function () {
            $("#FilterStatusId").val("");
            FillTable();
        });

        // Filter panel toggle
        $("#Filter_search").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Filter panel close
        $(".filterclose_btn").click(function () {
            var wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });
    });

    function initializeDropdowns() {
        // Company dropdown — only for SA canteen creation (canteen head user needs CompanyId in tblusermaster)
        if (RoleId == '1') {
            CompanyDropdown = new Select2Dropdown({
                dropdownId: "CompanyId",
                apiUrl: '@_webapiurlMain' + "DataDropDownOptimize/GetCompanyDropDownPaginated",
                dataKey: "Id",
                labelKey: "Name",
                chunkSize: '@_ChunkSize',
                token: '@_tokan',
                extraParams: { RoleId: '@_RoleId', CompanyID: '@_cmpid' }
            });
        }
    }

    // Map DataTable column index to API sortBy values
    var sortColumnMap = {
        1: 'canteenName',
        2: 'openingTime',
        7: 'isActive'
    };

    function FillTable() {
        checkSession();
        $("#ajax_loader").show();
        // If table already exists, just reload data (no destroy/recreate = no blink)
        if (canteenTable) {
            canteenTable.destroy();
            canteenTable = null;
            $("#dataTables_tbl_header").remove();           
        }

        $('#tblCanteenBlock').show();
        $('#NotificationGrid-empty').hide();

        canteenTable = $('#tblCanteen').DataTable({
            dom: _domCommon,
            language: _languageCommon,
            serverSide: true,
            searching: true,
            searchDelay: 500,
            ordering: true,
            order: [[1, 'asc']],
            ajax: {
                url: '@_webapiurl' + "canteens",
                type: "GET",
                headers: { 'Authorization': 'Bearer ' + '@_tokan' },
                data: function (d) {
                    var sortBy = 'canteenName';
                    if (d.order && d.order.length > 0) {
                        var colIdx = d.order[0].column;
                        if (sortColumnMap[colIdx]) {
                            sortBy = sortColumnMap[colIdx];
                        }
                    }

                    var params = {
                        pageNumber: Math.floor(d.start / d.length) + 1,
                        pageSize: d.length,
                        sortBy: sortBy,
                        sortDirection: (d.order && d.order.length > 0) ? d.order[0].dir : 'asc'
                    };

                    if (d.search && d.search.value) {
                        params.searchTerm = d.search.value;
                    }

                    var filterStatus = $('#FilterStatusId').val();
                    if (filterStatus !== '') {
                        params.isActive = (filterStatus === 'true');
                    }

                    return params;
                },
                dataFilter: function (rawData) {
                    var json = JSON.parse(rawData);
                    var dtResponse = {
                        recordsTotal: json.totalCount || 0,
                        recordsFiltered: json.totalCount || 0,
                        data: json.canteens || []
                    };
                    return JSON.stringify(dtResponse);
                },
                dataSrc: function (response) {
                    var canteens = response.data || [];
                    CanteenData = canteens;
                    var hasSearch = canteenTable && canteenTable.search();

                    if (response.recordsTotal === 0 && !hasSearch) {
                        $('#tblCanteenBlock').hide();
                        $('#NotificationGrid-empty').show();
                    } else {
                        $('#tblCanteenBlock').show();
                        $('#NotificationGrid-empty').hide();
                    }

                    return canteens;
                },
                complete: function () {
                    $('#ajax_loader').hide();
                },
                error: function (xhr) {
                    var errorMsg = "Error during fetch data";
                    if (xhr.responseJSON && xhr.responseJSON.detail) {
                        errorMsg = xhr.responseJSON.detail;
                    }
                    toastr.error(errorMsg);
                    $('#tblCanteenBlock').hide();
                    $('#NotificationGrid-empty').show();
                }
            },
            initComplete: function () {

                const visibleTable = 'tblCanteen';

                // Safety check: only append if buttons container exists and is empty
                if ($('#buttons').length && visibleTable) {
                    if ($('#buttons').children().length != 0) {
                        $("#buttons").empty();
                    }
                    $("#buttons").append(`
                                        <div id="export-button1" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                                            <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                                        </div>
                                    `);
                }

                // Custom debounce: unbind default search and add 500ms delay
                var searchTimer = null;
                var $searchInput = $('#tblCanteen_wrapper .dataTables_filter input');
                $searchInput.unbind();

                $searchInput.on('keyup search input paste cut', function () {
                    var value = this.value;
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function () {
                        canteenTable.search(value).draw();
                    }, 500);
                });
                $searchInput.on('keypress', function (e) {
                    if (e.keyCode === 13) return false;
                });
            },
            columns: [
                {
                    title: "Sr No",
                    data: null,
                    visible: false,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },
                { title: "Canteen Name", data: "canteenName",createdCell: function (td) { $(td).css("min-width", "120px"); } },
                {
                    title: "Timing",
                    data: null,
                    render: function (data, type, row) {
                        var open = row.openingTime ? row.openingTime.substring(0, 5) : '';
                        var close = row.closingTime ? row.closingTime.substring(0, 5) : '';
                        return open + ' - ' + close;
                    }
                },
                {
                    title: "Head Email",
                    data: "canteenHeadEmail",
                    orderable: false,
                    render: function (data) {
                        return data || '-';
                    }
                },
                { title: "CanteenId", data: "canteenId", visible: false, orderable: false },
                { title: "CanteenHeadUserId", data: "canteenHeadUserId", visible: false, orderable: false },
                { title: "Description", data: "description", visible: false, orderable: false },
                {
                    title: "Status",
                    data: "isActive",
                    render: function (data, type, row) {
                        if (data) {
                            return '<span class="green_font">Active</span>';
                        } else {
                            return '<span class="red_font">Inactive</span>';
                        }
                    }
                },
                {
                    title: "Action",
                    data: null,
                    orderable: false,
                    createdCell: function (td) { $(td).css("min-width", "128px"); },
                    render: function (data, type, row) {
                        let str = "";
                        if (isedit == "True") {
                            str = '<a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit" onclick="updateCanteen(' + row.canteenId + ')"> <i class="fa-regular fa-pen-to-square"></i> </a> ';

                            if (row.isActive) {
                                str += '<a class="Inactiveclass btn red_btnnew tooltips" data-placement="top" data-original-title="Inactive" onclick="statusChange(' + row.canteenId + ')"><i class="fa-solid fa-xmark"></i></a>';
                            } else {
                                str += '<a class="Activeclass btn green_btnnew tooltips" data-placement="top" data-original-title="Active" onclick="statusChange(' + row.canteenId + ')"><i class="fa-solid fa-check"></i></a>';
                            }
                        }
                        // Canteen Manager (6811) cannot delete canteens
                        if (isdelete == "True" && RoleId != '6811') {
                            str += ' <a class="Deleteclass btn red_btnnew tooltips" data-placement="top" data-original-title="Delete" onclick="deleteCanteen(' + row.canteenId + ')"><i class="fa-regular fa-trash-can"></i></a>';
                        }
                        return str;
                    }
                }
            ],
            drawCallback: function () {
                $('.tooltips').tooltip();
                setTimeout(function () {
                    $("#tblCanteen_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                }, 100);
            }
        });

        $(document).off('click', '#export-button1').on('click', '#export-button1', function () {
            GenerateCanteenExcelFile();
        });
    }

    function AddCanteen(e) {
        checkSession();
        e.preventDefault();

        let canteenId = $('#CanteenId').val();
        let isUpdate = canteenId && canteenId !== "" && canteenId !== "0";

        // Validate required fields
        if (!validateField('CanteenName')) return;
        if (!isUpdate && RoleId == '1' && !$('#CompanyId').val()) {
            toastr.warning("Please select a Company");
            return;
        }
        if (!isUpdate) {
            if (!$('#CanteenHeadEmail').val() || !$('#CanteenHeadEmail').val().trim()) {
                toastr.warning("Please enter Canteen Head Email");
                $('#CanteenHeadEmail').addClass('field_error');
                $('#CanteenHeadEmail').focus();
                return;
            }
            var emailResult = ValidateEmailid($('#CanteenHeadEmail').val().trim());
            if (emailResult !== 'success') {
                toastr.warning(emailResult);
                $('#CanteenHeadEmail').addClass('field_error');
                $('#CanteenHeadEmail').focus();
                return;
            }
            if (!$('#CanteenHeadPassword').val() || $('#CanteenHeadPassword').val().length < 6) {
                toastr.warning("Password must be at least 6 characters");
                $('#CanteenHeadPassword').addClass('field_error');
                $('#CanteenHeadPassword').focus();
                return;
            }
        }
        if (!validateField('OpeningTime')) return;
        if (!validateField('ClosingTime')) return;
        if (!validateTimeRange()) return;

        let obj;
        let url;
        let method;

        if (isUpdate) {
            // PUT - update existing canteen (no companyId/branchId — canteen is independent)
            obj = {
                canteenName: $('#CanteenName').val().trim(),
                description: $('#Description').val().trim() || null,
                openingTime: $('#OpeningTime').val() + ':00',
                closingTime: $('#ClosingTime').val() + ':00'
            };
            if (currentCanteenHeadUserId) {
                obj.canteenHeadUserId = currentCanteenHeadUserId;
            }
            url = '@_webapiurl' + "canteens/" + canteenId;
            method = "PUT";
        } else {
            // POST - create new canteen (companyId only for SA — needed for canteen head user creation)
            obj = {
                canteenHeadEmail: $('#CanteenHeadEmail').val().trim(),
                canteenHeadPassword: $('#CanteenHeadPassword').val(),
                canteenName: $('#CanteenName').val().trim(),
                description: $('#Description').val().trim() || null,
                openingTime: $('#OpeningTime').val() + ':00',
                closingTime: $('#ClosingTime').val() + ':00'
            };
            if (RoleId == '1' && $('#CompanyId').val()) {
                obj.companyId = parseInt($('#CompanyId').val());
            }
            url = '@_webapiurl' + "canteens";
            method = "POST";
        }

        $.ajax({
            type: method,
            url: url,
            headers: { 'Authorization': 'Bearer ' + '@_tokan' },
            data: JSON.stringify(obj),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (isUpdate) {
                    toastr.success("Canteen updated successfully");
                } else {
                    toastr.success("Canteen created successfully");
                }
                $('#myModal').modal('hide');
                FillTable();
            },
            error: function (xhr, status, error) {
                var errorMsg = "Error during save";
                if (xhr.responseJSON) {
                    if (xhr.responseJSON.detail) {
                        errorMsg = xhr.responseJSON.detail;
                    }
                    if (xhr.responseJSON.errors) {
                        // Handle validation errors
                        for (var field in xhr.responseJSON.errors) {
                            errorMsg = xhr.responseJSON.errors[field].join(", ");
                            break;
                        }
                    }
                }
                toastr.error(errorMsg);
            }
        });
    }

    function updateCanteen(canteenId) {
        checkSession();
        frmClear();
        removeFieldErrors();

        let canteen = CanteenData.find((value) => value.canteenId == canteenId);
        if (!canteen) {
            toastr.error("Canteen not found");
            return;
        }

        $('#CanteenId').val(canteen.canteenId);
        $('#CanteenName').val(canteen.canteenName);
        $('#Description').val(canteen.description || '');
        $('#OpeningTime').val(canteen.openingTime ? canteen.openingTime.substring(0, 5) : '');
        $('#ClosingTime').val(canteen.closingTime ? canteen.closingTime.substring(0, 5) : '');

        // Store canteenHeadUserId for PUT request
        currentCanteenHeadUserId = canteen.canteenHeadUserId || null;

        // Set email as read-only display and hide password for edit mode
        $('#CanteenHeadEmail').val(canteen.canteenHeadEmail || '');
        $('#CanteenHeadEmail').prop('readonly', true);
        $('#CanteenHeadPassword').closest('.col-lg-6').hide();

        // Hide Company dropdown in edit mode (canteen is independent — no companyId in PUT)
        $('#CompanyId').closest('.col-lg-6').hide();

        $('#modalTitle').text('Edit Canteen');
        $('#myModal').modal('toggle');
    }

    function deleteCanteen(canteenId) {
        checkSession();

        Swal.fire({
            html: '<div class="swal_subtitle"><b>You want to delete this canteen?</b></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Are you sure?",
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            cancelButtonText: 'Cancel',
            confirmButtonText: 'Yes, delete it!',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "DELETE",
                    url: '@_webapiurl' + "canteens/" + canteenId,
                    headers: { 'Authorization': 'Bearer ' + '@_tokan' },
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>Canteen has been deleted.</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Deleted!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
                        FillTable();
                    },
                    error: function (xhr, status, error) {
                        var errorMsg = "Error during delete";
                        if (xhr.responseJSON && xhr.responseJSON.detail) {
                            errorMsg = xhr.responseJSON.detail;
                        }
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>' + errorMsg + '</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                    }
                });
            }
        });
        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
    }

    function statusChange(canteenId) {
        checkSession();

        let canteen = CanteenData.find((value) => value.canteenId == canteenId);
        if (!canteen) {
            toastr.error("Canteen not found");
            return;
        }

        let newStatus = !canteen.isActive;
        let actionText = newStatus ? "active" : "Inactive";
        let confirmIcon = newStatus ? 'icon_success.svg' : 'icon_error.svg';
        let confirmClass = newStatus ? 'swal_success' : 'swal_error';
        let impactText = newStatus ? '' : '<br><small class="text-danger">Employees assigned to this canteen will not be able to place orders from it.</small>';

        Swal.fire({
            html: '<div class="swal_subtitle"><b>You want to ' + actionText + ' this canteen?</b>' + impactText + '</div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/" + confirmIcon + "' alt=''>Are you sure?",
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            cancelButtonText: 'Cancel',
            confirmButtonText: 'Yes, ' + actionText + ' it!',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "PATCH",
                    url: '@_webapiurl' + "canteens/" + canteenId + "/status",
                    headers: { 'Authorization': 'Bearer ' + '@_tokan' },
                    data: JSON.stringify({ isActive: newStatus }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>Canteen has been ' + (newStatus ? "Active" : "Inactive") + '.</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Success!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');
                        FillTable();
                    },
                    error: function (xhr, status, error) {
                        var errorMsg = "Error during status change";
                        if (xhr.responseJSON && xhr.responseJSON.detail) {
                            errorMsg = xhr.responseJSON.detail;
                        }
                        Swal.fire({
                            html: '<div class="swal_subtitle"><b>' + errorMsg + '</b></div>',
                            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error!",
                            showCloseButton: true,
                            confirmButtonText: 'OK',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            customClass: {
                                confirmButton: 'swal-confirm-button-class'
                            }
                        });
                        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                    }
                });
            }
        });
        $('img[src="/assets/images/icons/swal_icon/' + confirmIcon + '"]').parent().parent().parent().addClass(confirmClass);
    }

    function GenerateCanteenExcelFile() {
        checkSession();
        if (!canteenTable) return;

        var searchTerm = canteenTable.search() || "";
        var filterStatus = $('#FilterStatusId').val() || "";

        var mainObj = {
            searchTerm: searchTerm,
            isActive: filterStatus
        };

        $.ajax({
            url: '/cms/ExportCanteensExcel',
            type: 'POST',
            data: JSON.stringify(mainObj),
            contentType: 'application/json',
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                if (response.success && response.filePath) {
                    window.location.href = response.filePath;
                } else {
                    toastr.error(response.message || "Failed to generate export file.");
                }
            },
            error: function () {
                toastr.error("An error occurred while exporting data.");
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }

    function validateField(fieldId) {
        let value = $('#' + fieldId).val();
        if (!value || value.trim() === "") {
            $("#" + fieldId).addClass('field_error');
            $("#" + fieldId).focus();
            return false;
        }
        $("#" + fieldId).removeClass('field_error');
        return true;
    }

    function validateTimeRange() {
        let openTime = $('#OpeningTime').val();
        let closeTime = $('#ClosingTime').val();

        if (openTime && closeTime && closeTime <= openTime) {
            toastr.warning("Closing time must be after opening time");
            $("#ClosingTime").addClass('field_error');
            return false;
        }
        $("#ClosingTime").removeClass('field_error');
        return true;
    }

    function removeFieldErrors() {
        $("#CanteenName").removeClass('field_error');
        $("#OpeningTime").removeClass('field_error');
        $("#ClosingTime").removeClass('field_error');
        $("#CanteenHeadEmail").removeClass('field_error');
        $("#CanteenHeadPassword").removeClass('field_error');
    }

    function frmClear() {
        $('#CanteenId').val("");
        $('#CanteenName').val("");
        $('#Description').val("");
        $('#OpeningTime').val("");
        $('#ClosingTime').val("");
        $('#CanteenHeadEmail').val("");
        $('#CanteenHeadPassword').val("");

        // Reset email/password field states for create mode
        $('#CanteenHeadEmail').prop('readonly', false);
        $('#CanteenHeadPassword').closest('.col-lg-6').show();

        // Reset stored userId
        currentCanteenHeadUserId = null;

        // Reset dropdowns
        if (CompanyDropdown) {
            CompanyDropdown.clearDropdown();
        }

        // Show Company dropdown for SA in create mode
        $('#CompanyId').closest('.col-lg-6').toggle(RoleId == '1');

        // Reinitialize dropdowns
        initializeDropdowns();
    }

    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
</script>

