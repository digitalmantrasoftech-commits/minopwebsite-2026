        $.ajax(
         {
             type: "GET",
             url: "/MasterData/GetBranchbycomapnyid?CompanyID=" + companyid,
             contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
                 $("#ajax_loader").show();
             },
             success: function (data) {
                 $("#ajax_loader").hide();
                 var markup = '';
                 for (var x = 0; x < data.length; x++) {
                     $('#ddlBranchID').append('<option value="' + data[x].BranchId + '">' + data[x].BranchName + '</option>');
                 }
                 $Branchselect.multiselect('rebuild');
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 $('.loading').hide();

                 if (jqXHR.status == 500) {
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             },
         });
    }
    function fillDeptTable(BranchId, selectedDept) {
        $("#ddlDepartmentID").empty();
        $.ajax({
            type: "GET",
            url: "/MasterData/GetDeptbyBranchstr?BranchId=" + BranchId,
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            success: function (response) {
                if (response != null) {
                    for (var i = 0; i < response.length; i++) {
                        $('#ddlDepartmentID').append('<option value="' + response[i].Value + '">' + response[i].Text + '</option>');
                    }
                    $selectDepart.multiselect('rebuild');
                    $(document.body).on('change', '#DeptIds', function () {
                        $("#spvalidation").hide();
                        var deptid = $('#ddlDepartmentID option:selected');
                        var DeptArray = [];
                        $(deptid).each(function (index, deptid) {
                            DeptArray.push([$(this).val()]);
                        });
                        if (DeptArray == "") {
                            $("#txt2").val(0);
                        }
                        else {
                            $("#txt2").val(DeptArray);
                            $("#spValidation").hide();
                        }
                        var ArrDept = $("#txt2").val();
                        DeptIdlst = ArrDept;
                        $("#ddlDepartmentID").val(DeptIdlst);
                    });
                }
                $(".loading").hide();
            },
            beforeSend: function () {
                $(".loading").show();
            },
            error: function () {
                $(".loading").hide();
            }
        });
    }

    function DesignationGetAllFilter() {
        $('#ddlDesignationID').empty();
        var DId = 0;
        $.ajax({
            type: "GET",
            url: '@_webapiurl' + 'Master/DesignationGetAll',
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response != null) {
                    $("#ddlDesignationID").append("<option value='0' selected>Select Designation</option>");
                    for (var i = 0; i < response.length; i++) {
                        $("#ddlDesignationID").append("<option value='" + response[i].DesignationId + "'>" + response[i].DesignationName + "</option>");
                    }
                }
            },
            error: function () {
                $(".loading").hide();
            }
        });
    }
    //home page filter : end//

    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }

</script>

