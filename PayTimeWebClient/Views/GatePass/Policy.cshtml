                var PolicyName = currentRow.find('.PolicyName').text();
                var GatePassAppliedDay = currentRow.find('.GatePassAppliedDay').text();
                var Gatepassapprovedmeans = parseFloat(currentRow.find('.Gatepassapprovedmeans').text());
                var status = currentRow.find('.status').text();





                $("#Policy_Name").val(PolicyName);
                $("#Day_In_Month").val(GatePassAppliedDay);
                if (Gatepassapprovedmeans == 0) {
                    $("#FDPresent").prop("checked", true);
                    $("#HDPresent").prop("checked", false);
                } else {
                    $("#HDPresent").prop("checked", true);
                    $("#FDPresent").prop("checked", false);
                }

                //G_status
                if (status == "Active") {
                    G_status = 1;
                } else {
                    G_status = 0;
                }

                var _RequiredPunch = currentRow.find('.GatepassRequrePunch').text();
                if (_RequiredPunch == 'Out Punch') {
                    $("#OutPunchRequired").prop("checked", true);
                }
                else
                {
                    $("#OutPunchRequired").prop("checked", false);
                }
            });

            $("body").on("click", ".reject", function () {
