            $("#btnSubmit").click(function () {
                checkSession();
                var IsFlag = 0;

                // Check if Policy Name is filled
                if ($("#Policy_Name").val() == null || $("#Policy_Name").val() == "") {
                    IsFlag = 1;
                    $("#Policy_Name").addClass('field_error');
                    toastr.remove();
                    toastr.error("Enter policy name");
                    return false;
                } else {
                    $("#Policy_Name").removeClass('field_error');
                }

                // Check if Day In Month is filled and valid
                if ($("#Day_In_Month").val() == "" || $("#Day_In_Month").val() == null) {
                    IsFlag = 1;
                    $("#Day_In_Month").addClass('field_error');
                    toastr.remove();
                    toastr.error("Please Enter Day In Month");
                    return false;
                } else {
                    var dayNumber = parseInt($("#Day_In_Month").val(), 10);
                    if (dayNumber > 31) {
                        IsFlag = 1;
                        $("#Day_In_Month").addClass('field_error');
                        toastr.remove();
                        toastr.error("The value for Day In Month must not exceed 31.");
                        return false;
                    } else {
                        $("#Day_In_Month").removeClass('field_error');
                    }
                }
                //OutPunchRequired
                var isChecked = $("#OutPunchRequired").is(":checked");
                var _isCheckedvalue = "";
                if (isChecked == true) {
                    _isCheckedvalue = 1;
                }
                else {
                    _isCheckedvalue = 0;
                }
                // Check if "Gatepassapproved" is selected
                var selectedValue;
                var _isValid = $("input[name='Gatepassapproved']:checked").val();
                if (!_isValid) {
                    toastr.remove();
                    toastr.error("Select Gate pass approved means");
                    IsFlag = 1;
                    return false;
                } else {
                    selectedValue = _isValid;
                }

                // If no validation errors
                if (IsFlag == 0) {
                    // AJAX call to check for Policy Name duplication
                    $.ajax({
                        type: "POST",
                        headers: { 'Authorization': '@_tokan' },
                        url: '@_webapiurl' + 'GatePassPolicy/GatepassPolicyDuplication?id=' + GatepasspolicyId + '&PolicyName=' + $("#Policy_Name").val(),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        beforeSend: function () {
                            $("#ajax_loader").show();
                        },
                        success: function (response) {
                            if (response.MegSts == "ok") {
                                // Proceed to submit the form if no duplication found
                                var _IsActive;
                                if ('@_RoleId' == 1 || '@_RoleId' == 6805 || '@_RoleId' == 6806) {
                                    _IsActive = (GatepasspolicyId == 0) ? 1 : G_status;
                                }
                                else {
                                    _IsActive = 2;
                                }
                                var obj = {
                                    "GatepasspolicyId": GatepasspolicyId,
                                    "PolicyName": $("#Policy_Name").val(),
                                    "GatePassAppliedDay": $("#Day_In_Month").val(),
                                    "RequiredPunch": parseInt(_isCheckedvalue),
                                    "Gatepassapprovedmeans": parseInt(selectedValue),
                                    "IsActive": _IsActive
                                };
                                $.ajax({
                                    type: "POST",
                                    headers: { 'Authorization': '@_tokan' },
                                    url: '@_webapiurl' + 'GatePassPolicy/CreateUpdateGatePasspolicy',
                                    contentType: "application/json; charset=utf-8",
                                    data: JSON.stringify(obj),
                                    dataType: "json",
                                    success: function (response) {
                                        if (response.MegSts == "ok") {
                                            toastr.remove();
                                            toastr.success(response.Meg);
                                            $('#AddPolicy_modal').modal('toggle'); // Toggle the modal
                                            GetGatePassPolicytable(); // Refresh the table
                                        } else {
                                            toastr.remove();
                                            toastr.error(response.Meg);
                                        }
                                    },
                                    complete: function () {
                                        $("#ajax_loader").hide();
                                    }
                                });
                            }
                            else {
                                toastr.remove();
                                toastr.error(response.Meg);
                                $("#Policy_Name").val("");
                            }
                        },
                        complete: function () {
                            $("#ajax_loader").hide();
                        }
                    });
                }
            });

