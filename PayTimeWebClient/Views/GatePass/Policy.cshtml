                    closeOnConfirm: true,
                    showCloseButton: true,
                    showCancelButton: true,
                    focusConfirm: false,
                    cancelButtonText: 'No',
                    confirmButtonText: 'Yes',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    customClass: {
                        confirmButton: 'swal-confirm-button-class',
                        cancelButton: 'swal-cancel-button-class'
                    },
                    preConfirm: function () {
                        return new Promise(function (resolve) {
                            _Reason = $('#txt_reason').val();
                            _Reason = _Reason.replace(/[^a-zA-Z0-9 ]/g, '');
                            $('#txt_reason').val(_Reason);
                            if (_Reason === "") {
                                $('#txt_reason').addClass('field_error');
                                toastr.remove();
                                toastr.error("Please enter a valid Reason.");
                                resolve(false);
                                return false;
                            }
                            else {
                                $('#txt_reason').removeClass('field_error');
                                resolve(true);
                            }
                        });
                    },
                    //customClass: {
                    //    confirmButton: 'swal-confirm-button-class',
                    //    cancelButton: 'swal-cancel-button-class bg-grey-silver'
                    //}
                }).then(function (result) {
                    if (result.isConfirmed) {

                        var txt_reason = $("#txt_reason").val();
                        if (txt_reason == "") {
                            $("#txt_reason").addClass('field_error');
                            return false;
                        }
                        else {
                            $.ajax({
                                type: "POST",
                                headers: { 'Authorization': '@_tokan' },
                                url: '@_webapiurl' + 'GatePassPolicy/GatepasspolicyActiveInactive?status=0&id=' + GatepasspolicyId + "&RejectReason=" + txt_reason,
                                contentType: "application/json; charset=utf-8",
                                dataType: "json",
                                beforeSend: function () {
                                    $("#ajax_loader").show();
                                },
                                success: function (response) {
                                    if (response.MegSts == "ok") {
                                        toastr.remove();
                                        toastr.success(response.Meg);
                                        GetGatePassPolicytable();
                                    }
                                    else {
                                        toastr.remove();
                                        toastr.error(response.Meg);
                                    }
                                },
                                complete: function () {
                                    $("#ajax_loader").hide();
                                }
                            });
                        }
                    }
                });
                $('img[src="/assets/images/icons/swal_icon/icon_info.svg"]').parent().parent().parent().addClass('swal_info');
            });


            $("body").on("click", ".active", function () {
                var currentRow = $(this).closest('tr');
