                $("#Policy_Name").removeClass('field_error');
                // Allow alphabetic (A-Z, a-z), numeric (0-9), space, dot (.), hyphen (-), and backspace
                if (((e.which >= 65 && e.which <= 90) ||    // A-Z
                     (e.which >= 97 && e.which <= 122) ||   // a-z
                     (e.which >= 48 && e.which <= 57) ||    // 0-9
                     e.which == 32 ||  // Space
                     e.which == 46 ||  // Dot (.)
                     e.which == 45 ||  // Hyphen (-)
                     e.which == 8)) {  // Backspace
                    return true;
                } else {
                    return false;
                }
            });
            $("#Policy_Name").on('paste', function (event) {
                event.preventDefault();
            });
            $("#Policy_Name").blur(function () {
                var Policy_Name = removeTags($("#Policy_Name").val());
