                            ],
                            initComplete: function (settings, json) {
                                var footer = '<tr><th hidden>GatepasspolicyId</th>  <th>Policy Name</th> <th>Gate Pass Applied Day In Month</th><th>Required Punch</th> <th class="fixed-column-1">Reason</th> <th class="fixed-column">Action</th> <th hidden></th> </tr>';
                                $("#tblpolicy thead").append(footer);
                            }
                        });
                        // Apply the column Search
                        $("#tblpolicy thead").on("keyup", "input", function ()
                        {
                            tblpolicy.column($(this).parent().index())
                            .search(this.value)
                            .draw();
                        });
                    }
                    $("#tblpolicy thead tr:eq(1) th").each(function (index) {
                        var title = $(this).text();
                        if (index == 0 || index == 1 || index == 2) {
                            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
                        } else {
                            $(this).html('');
                        }
                    });
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }

        function clear() {
            $("#Policy_Name").val("");
            $("#Day_In_Month").val("");
            $("#FDPresent").prop("checked", false);
            $("#HDPresent").prop("checked", false);
        }

        $(document).on('input', '#txt_reason', function () {
            this.value = this.value.replace(/[^a-zA-Z0-9 ]/g, '');
        });

        // Prevent non-alphanumeric paste
        $(document).on('paste', '#txt_reason', function (e) {
            e.preventDefault();
            let paste = (e.originalEvent || e).clipboardData.getData('text');
            paste = paste.replace(/[^a-zA-Z0-9 ]/g, '');
            document.execCommand('insertText', false, paste);
        });
    </script>

