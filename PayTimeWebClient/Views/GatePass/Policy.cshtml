                                    tbl = tbl + "</td>";
                                }
                            }
                            else {
                                tbl = tbl + "<td class='fixed-column'>";
                                tbl = tbl + "</td>";
                            }
                            tbl = tbl + "<td hidden class='Gatepassapprovedmeans'>" + response[i].Gatepassapprovedmeans
                            tbl = tbl + "</td>";

                            tbl = tbl + "</tr>";
                            table += tbl;
                        }
