            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">GatePass Request</h4>
                </div>
                <div class="modal-body">
                    <div class="modal-card">
                        <fieldset>
                            <div class="row">
                                <div class="col-sm-6 col-xs-12">
                                    <div class="form-group data_picker_box">
                                        <label>Applied Date <span class="required" aria-required="true"> * </span></label>
                                        <div class="input-group input-group-sm  date date-picker" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-start-date="0d" data-date-end-date="0d" data-date-viewmode="years" id="joindate">
                                            <span class="input-group-btn">
                                                <button class="btn default" type="button">
                                                    <i class="fa-light fa-calendar-days"></i>
                                                </button>
                                            </span>
                                            <input type="text" placeholder="@_isdateformat" class="form-control" id="AppliedDate" name="EmpJoiningDate" autocomplete="off">
                                        </div>
                                        <span class="help-block error_help_block" hidden id="spEmpJoiningDate"></span>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-xs-12">
