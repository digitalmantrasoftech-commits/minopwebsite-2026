                            <tr>
                                @*<th style="min-width: 40px">Sr No</th>*@
                                <th style="min-width: 40px" hidden>GatePassIssueID</th>
                                <th style="min-width: 120px">Employee Name</th>
                                <th style="min-width: 120px">Shift Name</th>
                                <th style="min-width: 120px">In Time (Today)</th>
                                <th style="min-width: 120px">Applied Date</th>
                                <th style="min-width: 120px">Applied Time</th>
                                <th style="min-width: 120px">Reason</th>
                                <th style="min-width: 120px">Remark</th>
                                <th style="min-width: 80px" class="fixed-column-1">Status</th>
                                <th style="min-width: 80px" class="fixed-column">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
