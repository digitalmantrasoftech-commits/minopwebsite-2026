                    </div>
                </div>
                <div class="col-lg-3" style="margin-top: 23px;">
                    <button type="button" id="SearchFilter" class="btn icon_btn tooltips" data-placement="top" data-original-title="Search Filter"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>

            <div class="table-responsive" id="tableResponsive_tblgpapproval">
                <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
                    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
                </div>
                <div class="Directory_details_table">
                    <table id="tblgpapproval" class="table new_datatbl table-striped table-bordered tbl_middle table-hover tbl_newdatatbl serch_datatable table-checkable order-column">
