        function formatDate(date) {
            var newdate = new Date(date);
            var year = newdate.getFullYear();
            var month = (newdate.getMonth() + 1).toString().padStart(2, '0');
            var day = newdate.getDate().toString().padStart(2, '0');
            var formattedDate = year + '-' + month + '-' + day;
            return formattedDate;
        }
        function formatWiseDate(datenew) {
            var date = datenew.split('-');
            if ("@_isdateformat" == "dd-mm-yyyy") {
                var firstValue = date[2] + "-" + date[1] + "-" + date[0] //dd-mm-yyyy
            }
            else if ("@_isdateformat" == "yyyy-mm-dd") {
                var firstValue = date[0] + "-" + date[1] + "-" + date[2] //yyyy-mm-dd
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                var firstValue = date[1] + "-" + date[2] + "-" + date[0] //mm-dd-yyyy
            }
            else if ("@_isdateformat" == "yyyy-M-dd") {
                var _date = new Date(datenew);
                var locale = "en-us";
                var month = _date.toLocaleString(locale, { month: "short" });
                var firstValue = date[0] + "-" + month + "-" + date[2] //yyyy-M-dd
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {
                var _date = new Date(datenew);
                var locale = "en-us";
                var month = _date.toLocaleString(locale, { month: "short" });
                var firstValue = month + "-" + date[2] + "-" + date[0] //M-dd-yyyy
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {
                var _date = new Date(datenew);
                var locale = "en-us";
                var month = _date.toLocaleString(locale, { month: "short" });
                var firstValue = date[2] + "-" + month + "-" + date[0] //dd-M-yyyy
            }
            return firstValue;
        }
        function FilterFromDate() {
            var days = 31;
            var selectedStatus = $("#selectstatus").val();
            if (selectedStatus == 0) {
                days = 185;
            }
            if ($('#FilterFromDate').val() != "") {
                var start = $('#FilterFromDate').val();
                var end = $('#FilterToDate').val();
                if (end != "") {
                    var diff = Date.parse(end) - Date.parse(start);
                    days = diff / 1000 / 60 / 60 / 24;
                    if (selectedStatus == 0) {
                        if (days > 185) {
                            days = 185;
                        }
                    }
                    else {
                        if (days > 31) {
                            days = 31;
                        }
                    }
                }
                else {
                    end = 31;
                }

                var date = new Date($("#FilterFromDate").val()), daynew, daynew = days
                if (!isNaN(date.getTime())) {
                    date.setDate(date.getDate() + daynew);
                    $("#FilterToDate").val(date.toInputFormat());
                }

            }
        };
        function FilterToDate() {
            var days = 31;
            var selectedStatus = $("#selectstatus").val();
            if (selectedStatus == 0) {
                days = 185;
            }
            if ($('#FilterToDate').val() != "") {
                var start = $('#FilterFromDate').val();
                var end = $('#FilterToDate').val();
                if (start != "") {
                    var diff = Date.parse(end) - Date.parse(start);
                    days = diff / 1000 / 60 / 60 / 24;
                    if (selectedStatus == 0) {
                        if (days > 185) {
                            days = 185;
                        }
                    }
                    else {
                        if (days > 31) {
                            days = 31;
                        }
                    }
                }
                else {
                    days = 31;
                }
                var date = new Date($("#FilterToDate").val()), daynew, daynew = days

                if (!isNaN(date.getTime())) {
                    date.setDate(date.getDate() - daynew);
                    $("#FilterFromDate").val(date.toInputFormat());
                }
            }
        };

        function Search_filter() {
            var selectedStatus = $("#selectstatus").val();
            if ($("#selectstatus").val() == 0) {
                selectedStatus = 0;
            }
            else {

            }
            var filterFromDate = $("#FilterFromDate").val();
            var filterToDate = $("#FilterToDate").val();
            gattable(filterFromDate, filterToDate, selectedStatus)
        };

        function formatDateForPassingDate(date) {
            // Get the current date
            var today = new Date();

            // Extract year, month, and day
            var year = today.getFullYear();
            var month = (today.getMonth() + 1).toString().padStart(2, '0'); // Months are zero-based, so add 1
            var day = today.getDate().toString().padStart(2, '0');

            // Return the date in yyyy-MM-dd format
            return year + '-' + month + '-' + day;
        }

