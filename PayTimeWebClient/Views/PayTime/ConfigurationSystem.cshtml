@model PayTimeWebClient.Models.ConfigurationSystemMaster
@{

    string _Message = string.Empty;
    string _error = string.Empty;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    if (_RoleId == 15)
    {
        ViewBag.Title = "ConfigurationSystem";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
        _Message = ViewBag.msg;
        _error = ViewBag.error;
    }
}

<script type="text/javascript">
    $(document).ready(function () {
        $(".alert").hide();
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }
        $('#tblsysConfig').DataTable({
            dom: _domCommon,
            language: _languageCommon,
        });
        setTimeout(function () {
            $("#" + "tblsysConfig" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        var navListItems1 = $('#frmpopup div.setup-panel div a'),
                allWells1 = $('#frmpopup .setup-content'),
                allNextBtn1 = $('#frmpopup .nextBtn'),
                allPrevBtn1 = $('#frmpopup .prevbtn');
        allWells1.hide();
        navListItems1.click(function (e) {
            e.preventDefault();
            var $target1 = $($(this).attr('href')),
                    $item1 = $(this);

            if (!$item1.hasClass('disabled')) {
                navListItems1.removeClass('btn-primary').addClass('btn-default');
                $item1.addClass('btn-primary');
                allWells1.hide();
                $target1.show();
            }
        });
        allPrevBtn1.click(function () {
            var curStep1 = $(this).closest("#frmpopup .setup-content"),
                curStepBtn1 = curStep1.attr("id"),
                nextStepWizard1 = $('#frmpopup div.setup-panel div a[href="#' + curStepBtn1 + '"]').parent().prev().children("a"),
                curInputs1 = curStep1.find("input[type='text'],input[type='url']"),
                isValid1 = true;

            $(".form-group").removeClass("has-error");
            if (isValid1)
                nextStepWizard1.removeAttr('disabled').trigger('click');
        });

        $('#frmpopup div.setup-panel div a.btn-primary').trigger('click');
        $("#AddConfiguration").on('click', function () {
            ConfigurationClear();
            $("#AddConfiguration").attr("data-toggle", "modal");
            $("#AddConfiguration").attr("data-target", "#frmpopup");
        });

        $("#frstNext").click(function () {
            var nextStepWizard1 = $('#frmpopup div.setup-panel div a[href="#s-2"]').parent().children("a");
            nextStepWizard1.removeAttr('disabled').trigger('click');
        });
        $("#SecondNext").click(function () {
            var nextStepWizard1 = $('#frmpopup div.setup-panel div a[href="#s-3"]').parent().children("a");
            nextStepWizard1.removeAttr('disabled').trigger('click');
        });

        $("#tblsysConfig").on('click', '.editclass', function () {
            ConfigurationClear();
            $("#ConfigId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
            $("#Mastsqlconstr").val($(this).parent('td').parent('tr').children(1)[2].innerText);
            $("#Mastmysqlconstr").val($(this).parent('td').parent('tr').children(1)[3].innerText);
            $("#Mastoracconstr").val($(this).parent('td').parent('tr').children(1)[4].innerText);
            $("#Dbtype").val($(this).parent('td').parent('tr').children(1)[5].innerText);
            $("#DbLocation").val($(this).parent('td').parent('tr').children(1)[6].innerText);
            $("#JWTKey").val($(this).parent('td').parent('tr').children(1)[7].innerText);
            $("#ClientServer").val($(this).parent('td').parent('tr').children(1)[8].innerText);
            $("#ClientDbUser").val($(this).parent('td').parent('tr').children(1)[9].innerText);
            $("#ClientDbPass").val($(this).parent('td').parent('tr').children(1)[10].innerText);
            $("#ClientDbType").val($(this).parent('td').parent('tr').children(1)[11].innerText);
            $("#SmtpHost").val($(this).parent('td').parent('tr').children(1)[12].innerText);
            $("#FromEmail").val($(this).parent('td').parent('tr').children(1)[13].innerText);
            $("#FromPassword").val($(this).parent('td').parent('tr').children(1)[14].innerText);
            $("#SmtpPort").val($(this).parent('td').parent('tr').children(1)[15].innerText);
            $("#ActiveUserURL").val($(this).parent('td').parent('tr').children(1)[16].innerText);

            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");
        });

        $("#tblsysConfig").on('click', '.deleteclass', function () {
            var flg = 0;
            if (confirm("Are you sure for Delete this Entry?")) {
                $("#ConfigId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
                $.post("/PayTime/DeleteSystemConfiguration?id=" + $("#ConfigId").val(), function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var _response = $.parseJSON(response);
                    if (_response == "OK") {
                        var strid = "Col_" + $("#ConfigId").val().trim();
                        $("#" + strid + "").closest('tr').remove();
                        $('#tblsysConfig').DataTable();
                    }
                    else {
                        alert("something wrong occures.");
                    }
                });
            }
        });
    });
    function ConfigurationClear() {
        $("#ConfigId").val(0);
        $("#Mastsqlconstr").val("");
        $("#Mastmysqlconstr").val("");
        $("#Mastoracconstr").val("");
        $("#Dbtype").val("");
        $("#DbLocation").val("");
        $("#JWTKey").val("");
        $("#ClientServer").val("");
        $("#ClientDbUser").val("");
        $("#ClientDbPass").val("");
        $("#ClientDbType").val("");
        $("#SmtpHost").val("");
        $("#FromEmail").val("");
        $("#FromPassword").val("");
        $("#SmtpPort").val("");
        $("#ActiveUserURL").val("");
    }

</script>

@if (_RoleId == 15)
{
    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> System Configuration</span>
            </li>
        </ul>
        <div>
            <div class="report_title">
                <p>System Configuration</p>
            </div>
            <div class="page-toolbar">
                <a href="javascript:void(0)" style="display:none;" id="AddConfiguration" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Add Configuration"><i class="fa-solid fa-plus"></i></a>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="portlet">
                <div class="portlet-body">
                    <div class="table-responsive" id="tableResponsive">
                        <table id="tblsysConfig" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    <th style="display:none;">Sr. No</th>
                                    <th hidden>ConfigId</th>
                                    <th>Mastsqlconstr</th>
                                    <th>Mastmysqlconstr</th>
                                    <th>Mastoracconstr</th>
                                    <th>Dbtype</th>
                                    <th hidden>DbLocation</th>
                                    <th hidden>JWTKey</th>
                                    <th>ClientServer</th>
                                    <th hidden>ClientDbUser</th>
                                    <th hidden>ClientDbPass</th>
                                    <th hidden>ClientDbType</th>
                                    <th>SmtpHost</th>
                                    <th hidden>FromEmail</th>
                                    <th hidden>FromPassword</th>
                                    <th hidden>SmtpPort</th>
                                    <th hidden>ActiveUserURL</th>
                                    <th style="min-width: 70px;">Action</th>
                                </tr>
                            </thead>
                            @{int n = 1;}
                            <tbody>
                                @if (Model.ConfigSysList != null)
                                {
                                    foreach (var item in Model.ConfigSysList)
                                    {
                                        <tr>
                                            <td hidden>@n</td>
                                            <td hidden>@item.ConfigId</td>
                                            <td>@item.Mastsqlconstr</td>
                                            <td>@item.Mastmysqlconstr</td>
                                            <td>@item.Mastoracconstr</td>
                                            <td>@item.Dbtype</td>
                                            <td hidden>@item.DbLocation</td>
                                            <td hidden>@item.JWTKey</td>
                                            <td>@item.ClientServer</td>
                                            <td hidden>@item.ClientDbUser</td>
                                            <td hidden>@item.ClientDbPass</td>
                                            <td hidden>@item.ClientDbType</td>
                                            <td>@item.SmtpHost</td>
                                            <td hidden>@item.FromEmail</td>
                                            <td hidden>@item.FromPassword</td>
                                            <td hidden>@item.SmtpPort</td>
                                            <td hidden>@item.ActiveUserURL</td>
                                            <td id="Col_@item.ConfigId">
                                                <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>
                                                <a class="deleteclass btn red_btnnew tooltips" data-placement="top" title="Delete"><i class="fa-regular fa-trash"></i></a>
                                            </td>
                                        </tr>
                                        n++;
                                    }
                                }

                            </tbody>
                        </table>
                    </div>


                    <div id="frmpopup" class="modal fade bs-modal-lg" role="dialog" data-keyboard="false" data-backdrop="static">
                        <div class="modal-dialog modal-lg">
                            <!-- Modal content-->
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Configuration Setup</h4>
                                </div>
                                <div class="modal-body">
                                    @using (Html.BeginForm("ConfigurationSystem", "PayTime", FormMethod.Post))
                                    {
                                        <div class="stepwizard">
                                            <div class="stepwizard-row setup-panel">
                                                <div class="stepwizard-step">
                                                    <a href="#s-1" id="s1" type="button" class="btn btn-primary btn-circle">System Configuration</a>
                                                </div>
                                                <div class="stepwizard-step">
                                                    <a href="#s-2" id="s2" type="button" class="btn btn-default btn-circle">Client Configuration</a>
                                                </div>
                                                <div class="stepwizard-step">
                                                    <a href="#s-3" id="s3" type="button" class="btn btn-default btn-circle">Mail Configuration</a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class=" setup-content form" id="s-1">
                                            <fieldset>
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <div class="form-group" hidden>
                                                                    <input type="text" id="ConfigId" name="ConfigId" value="0" class="form-control input-sm">
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>SQL Connection String</label>
                                                                    <input type="text" id="Mastsqlconstr" name="Mastsqlconstr" required="" class="form-control input-sm" placeholder="Enter SQL Connection String">
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>MYSQL Connection String</label>
                                                                    <input type="text" id="Mastmysqlconstr" name="Mastmysqlconstr" required="" class="form-control input-sm" placeholder="Enter MYSQL Connection String">
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>ORACLE Connection String</label>
                                                                    <input type="text" id="Mastoracconstr" name="Mastoracconstr" required="" class="form-control input-sm" placeholder="Enter ORACLE Connection String">
                                                                </div>

                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-group">
                                                                    <label>Database Type</label>
                                                                    <input type="text" id="Dbtype" name="Dbtype" required="" class="form-control input-sm" placeholder="Enter Database Type">
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>Database Location</label>
                                                                    <input type="text" id="DbLocation" name="DbLocation" required="" class="form-control input-sm" placeholder="Enter Database Location">
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>JWT Key</label>
                                                                    <input type="text" id="JWTKey" name="JWTKey" required="" class="form-control input-sm" placeholder="Enter JWT Key">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="editor-field form-group col-md-12 control-label text-right">
                                                        <button class="btn blue btn-sm nextBtn pull-right" type="button" id="frstNext"> Next <i class="fa-light fa-angle-right"></i></button>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                        <div class=" setup-content form" id="s-2">
                                            <fieldset>
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <div class="form-group">
                                                                    <label>Client Server</label>
                                                                    <input type="text" id="ClientServer" name="ClientServer" required="" class="form-control input-sm" placeholder="Enter Client Server Name">
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>Client Database Type</label>
                                                                    <input type="text" id="ClientDbType" name="ClientDbType" required="" class="form-control input-sm" placeholder="Enter Client Database Type">
                                                                </div>


                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-group">
                                                                    <label>Client Database Username</label>
                                                                    <input type="text" id="ClientDbUser" name="ClientDbUser" required="" class="form-control input-sm" placeholder="Enter Client Database Username">
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>Client Database Password</label>
                                                                    <input type="text" id="ClientDbPass" name="ClientDbPass" required="" class="form-control input-sm" placeholder="Enter Client Database Password">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="editor-field form-group  col-md-12 control-label text-right">
                                                        <button class="btn prevbtn prev_btn" type="button"><i class="fa-regular fa-angle-left"></i> Prev</button>
                                                        <button class="btn nextBtn next_btn" type="button" id="SecondNext"> Next <i class="fa-light fa-angle-right"></i></button>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                        <div class="setup-content form" id="s-3">
                                            <fieldset>
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <div class="form-group">
                                                                    <label>SMTP Host</label>
                                                                    <input type="text" id="SmtpHost" name="SmtpHost" required="" class="form-control input-sm" placeholder="Enter SMTP Host">
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>SMTP Port</label>
                                                                    <input type="text" id="SmtpPort" name="SmtpPort" required="" class="form-control input-sm" placeholder="Enter SMTP Port">
                                                                </div>

                                                                <div class="form-group">
                                                                    <label>URL Of active User</label>
                                                                    <input type="text" id="ActiveUserURL" name="ActiveUserURL" required="" class="form-control input-sm" placeholder="Enter Active user URL">
                                                                </div>

                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-group">
                                                                    <label>From Email</label>
                                                                    <input type="text" id="FromEmail" name="FromEmail" required="" class="form-control input-sm" placeholder="Enter From EmailID">
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>From Password</label>
                                                                    <input type="password" id="FromPassword" name="FromPassword" required="" class="form-control input-sm" placeholder="Enter From Password">
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="form-group form-group col-md-12 text-right">
                                                        <button class="btn prevbtn prev_btn" type="button"><i class="fa-regular fa-angle-left"></i> Prev</button>
                                                        <button type="submit" class="btn save_btn" id="btnsubmit"><i class="fa-light fa-floppy-disk"></i> Save</button>
                                                    </div>
                                                </div>
                                            </fieldset>

                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>