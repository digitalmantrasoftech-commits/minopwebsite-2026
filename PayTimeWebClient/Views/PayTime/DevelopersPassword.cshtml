@model PayTimeWebClient.Models.ResetPassword
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Forgot Password | Mantra</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">
    <script src="~/Scripts/jquery-1.12.4.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <link href="~/Content/toastr.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/fonts/stylesheet.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/style.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/font-awesome.min.css" />
</head>
<body class="login">
    @using (Html.BeginForm())
    {
        <div class="col-md-12 margin-top-40 margin-bottom-40 text-center"><img alt="Porto" width="200" src="~/LandingAssets/images/mini-logo.png"> </div>
        <div class="content">
            <div class="row ">

                <div id="divforget" hidden>
                    <p class="title">@ViewBag.Meg</p>
                    <div class="col-md-12 ">
                        <h3 class="font-blue">Forgot Password ?</h3>
                        <p> Enter your e-mail address below to reset your password. </p>
                        <div class="login-input-box">
                            <div class="form-group">
                                @Html.TextBoxFor(model => model.Email, new { @class = "login-input form-control" })
                            </div>
                            <div class="form-group">
                                @Html.ValidationMessageFor(model => model.Email)
                            </div>
                        </div>
                        <div class="login-btn">
                            <input type="submit" class="btn blue btn-block " value="Submit" id="submit1" />
                        </div>
                        <div style="clear: both;"></div>
                    </div>
                </div>
                <div id="divresetpass" hidden>
                    <div class="col-md-12 ">
                        <h3 class="font-green spanlogin"> Reset Password </h3>
                        <p class="title">@ViewBag.Meg</p>
                        <div class="form-group">
                            @Html.DisplayFor(model => model.Email, new { @class = "login-input form-control", @readonly = "readonly" })
                        </div>
                        <div class="form-group">
                            @Html.TextBoxFor(model => model.OTP, new { Value = "", @class = "login-input form-control" })
                        </div>
                        <div class="form-group">
                            @Html.PasswordFor(model => model.UserPass, new { @class = "password-input form-control" })
                        </div>
                        <div class="form-group">
                            @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "password-input form-control" })
                        </div>
                        <div class="login-btn">
                            <input type="submit" class="btn blue btn-block " value="Submit" id="btnSubmit" />
                        </div>
                    </div>
                </div>
                <div id="divlogin">
                    @*<p class="title">@ViewBag.Meg</p>*@
                    <div class="col-md-12 ">
                        <p id="lblsuccess" hidden> Password updated successfully !</p>
                        <p> <a href="/Paytime/DevelopersAccount">Click here To Login!</a> </p>
                        <div style="clear: both;"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</body>
</html>
<script>

    $(document).ready(function () {
        $(document).keypress(function (e) {
            if (e.which == 13) {
                if ($("#ConfirmPassword").val() != $("#UserPass").val() && $("#ConfirmPassword").val() != '') {
                    toastr.remove();
                    toastr.error("Password and confirm password does not match.")
                    return false;
                }
            }
        });
        $("#btnSubmit").click(function () {
            $(".usergenterror").remove();
            if ($("#OTP").val() == '') {
                $("#OTP").addClass('field_error');
                toastr.remove();
                toastr.error("OTP is required.")
                return false;
            }
            else {
                $("#OTP").removeClass('field_error');
            }
            if ($("#Email").val() == '') {
                $("#Email").addClass('field_error');
                toastr.remove();
                toastr.error("Email is required.");
                return false;
            }
            else {
                $("#Email").removeClass('field_error');
            }
            if ($("#UserPass").val() == '') {
                $("#UserPass").addClass('field_error');
                toastr.remove();
                toastr.error("Password is required.");
                return false;
            }
            else {
                $("#UserPass").removeClass('field_error');
            }
            var regexpNewPwd = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;
            if (!regexpNewPwd.test($("#UserPass").val())) {
                $("#UserPass").val('');
                toastr.remove();
                toastr.error("Password must contain eight characters, at least one uppercase letter and one lowercase letter, one number and one special character(@@,$,!,%,*,?,&).")
                return false;
            }
            if ($("#ConfirmPassword").val() == '') {
                $("#ConfirmPassword").addClass('filed-error');
                toastr.remove();
                toastr.error("Confirm password is required.")
                return false;
            }
            else {
                $("#ConfirmPassword").removeClass('filed-error');
            }
            var regexpConfPwd = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;
            if (!regexpNewPwd.test($("#ConfirmPassword").val())) {
                $("#ConfirmPassword").val('');
                toastr.remove();
                toastr.error("Confirm password  must contain eight characters, at least one uppercase letter and one lowercase letter, one number and one special character(@@,$,!,%,*,?,&).")
                return false;
            }
            if ($("#ConfirmPassword").val() != $("#UserPass").val() && $("#Confirm Password").val() != '') {
                toastr.remove();
                toastr.error("Password and confirm password does not match.")
                return false;
            }
        });

        if ('@ViewBag.Meg' == "Password Updated Successfully!.") {
            $("#lblsuccess").show();
            $("#divlogin").show();
        }

        else if (('@ViewBag.Otp' != "" && '@ViewBag.Otp' != null)) {

            $("#divresetpass").show();
            $("#UserPass").attr("placeholder", "Enter New Password");
            $("#ConfirmPassword").attr("placeholder", "Enter Confirm  Password");
            $("#OTP").attr("placeholder", "Enter OTP");

        }
       else if ('@ViewBag.Meg' == "Entered OTP not match.") {
            $("#divresetpass").show();
            $("#divlogin").show();
            $("#divforget").hide();
            $("#UserPass").attr("placeholder", "Enter New Password");
            $("#ConfirmPassword").attr("placeholder", "Enter Confirm  Password");
            $("#OTP").attr("placeholder", "Enter OTP");

        }
        else {

           $("#divforget").show();
            $("#Email").attr("placeholder", "Enter Email");

            $("#submit1").click(function () {
                $(".usergenterror").remove();
                var is_valid_submit = false;
                if ($("#Email").val() == '') {
                    $("#Email").after('<span for="Email" generated="true" class="usergenterror" style="color:red;">Email is required</span>');
                    $("#Email").focus();
                    is_valid_submit = true;
                }

                if (is_valid_submit) return false;
            });
        }

    });
</script>
