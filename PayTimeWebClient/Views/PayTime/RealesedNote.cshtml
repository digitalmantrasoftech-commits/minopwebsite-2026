@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Release Note";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _dbName = HttpContext.Current.Session["DbName"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
     ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
     : "false"; // Default to "false" if the session is null

}
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<style type="text/css">
    .mysubscription .nav-tabs {
        margin: 0;
        padding: 0;
        border: none;
        display: block;
        margin-bottom: 10px;
    }

        .mysubscription .nav-tabs > li {
            margin: 0;
            float: none;
            display: inline-block;
        }

            .mysubscription .nav-tabs > li > a {
                margin: 0;
                padding: 2px 10px;
                font-size: 14px;
                background-color: transparent;
                border: 1px solid transparent;
                color: #666666;
                margin-right: 10px;
            }

                .mysubscription .nav-tabs > li > a:hover {
                    color: #000000;
                    border-bottom: 2px solid #a9a9a9 !important;
                }

            .mysubscription .nav-tabs > li.active > a {
                background-color: transparent;
                color: #000000;
                border-bottom: 2px solid #a9a9a9 !important;
                border-color: transparent;
            }

                .mysubscription .nav-tabs > li.active > a > i {
                    color: #000000 !important;
                }

    .tab_content_box {
        color: #333;
        margin: 0;
        padding: 0;
    }

        .tab_content_box .tab-pane {
            margin: 0;
            padding: 0;
            border: 0;
        }
</style>
<script type="text/javascript">
    $(document).ready(function () {
        var count = 0;
        var form = "Released Note";
        var operation = "";
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Release note";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })
    });

</script>


<div class="page-bar" style="display: none">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Release Notes</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Realese Notes</span>
            </li>
        </ul>
    }
</div>

<script type="text/javascript">
    // 1 type for minop and 2 type for payroll.
    var type = 1;
    var t = "";
    var tpay = "";
    $(document).ready(function () {
        getRealeseNoteDataMinop(1);
        getRealeseNoteDataPay(2);
        function getRealeseNoteDataMinop(type) {
            var _urltblpay = '@_webapiurl' + 'Master/RealesedNoteGetAll?type=' + type;
            // If DataTable instance already exists, destroy it before re-initializing
            if (t) {
                t.destroy();
                $('#tblRealesenotelstMinop').empty(); // Clear the table body to prevent lingering tooltips or data
            }
            $("#dataTables_tbl_header").remove();
       
            t = $('#tblRealesenotelstMinop').DataTable(
                {
                    "destroy": true,
                    "processing": false,
                    "ajax": {
                        url: _urltblpay,
                        type: "GET",
                        headers: { 'Authorization': '@_tokan' },
                        dataSrc: '',
                        async: false,
                    },
                    responsive: 'true',
                    //dom: 'lBfrtip',
                    dom: _domCommon,
                    language: _languageCommon,
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: 'Excel',
                            titleAttr: 'Excel',
                            exportOptions: {
                                columns: [2, 3, 4, 5, 6, 7]
                            }

                        }
                    ],
                    
                    "pageLength": 10,
                    "columns": [
                          { "title": "a" },
                          { "title": "Name" },
                          { "title": "Department" },

                    ],
                    "columns": [
                        { "title": "Serial No", "data": null, visible: false }, // Add titles for columns
                         { "title": "RID", "data": "RID", "visible": false },
                         {
                             "title": "Release Date", "data": "Realesedate", "render": function (data) {
                                 if ("@_isdateformat" == "dd-mm-yyyy") {
                                     return moment(data).format("DD-MM-YYYY");
                                 }
                                 else if ("@_isdateformat" == "mm-dd-yyyy") {
                                     return moment(data).format("MM-DD-YYYY");
                                 }
                                 else if ("@_isdateformat" == "yyyy-mm-dd") {
                                     return moment(data).format("YYYY-MM-DD");
                                 }
                                 else if ("@_isdateformat" == "yyyy-M-dd") {
                                     return moment(data).format("YYYY-MMM-DD");
                                 }
                                 else if ("@_isdateformat" == "M-dd-yyyy") {
                                     return moment(data).format("MMM-DD-YYYY");
                                 }
                                 else if ("@_isdateformat" == "dd-M-yyyy") {
                                     return moment(data).format("DD-MMM-YYYY");
                                 }
                             }
                         },
                         { "title": "Excel"},
                    ],
                    "columnDefs": [
                        {
                            "targets": [1],
                            "visible": false
                        },
                        {
                            "targets": 3,
                            "data": "Realesenote",
                            "render": function (data, type, full, meta) {
                                return '<a href="../RealeseList/' + data.replace(".", "_") + '.pdf" target="_blank" class="previewclass btn blue_btnnew tooltips" data-placement="top" Title="Click to open ' + data.replace(".", "_") + '""><i class="fa-regular fa-eye"></i></a><a href="../RealeseList/' + data.replace(".", "_") + '.pdf" target="_blank" class="downloaduserclass btn green_btnnew tooltips" data-placement="top" download="" Title="Click to download ' + data.replace(".", "_") + '"><i class="fa-regular fa-download"></i></a>';

                            },
                        },
                        {
                            "searchable": false,
                            "orderable": false,
                            "targets": 0
                        }
                    ],
                    "order": [[1, 'asc']], // Add default order, if needed
                }
            );
            setTimeout(function () {
                $("#" + "tblRealesenotelstMinop" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive1"));
                $('.tooltips').tooltip();
                $("#export-button").remove();
            }, 100);
            t.on('order.dt search.dt', function () {
                t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                    cell.innerHTML = i + 1;
                });
            }).draw();
            $('.tooltips').tooltip();
        }
        function getRealeseNoteDataPay(type) {
            var _urltblpay = '@_webapiurl' + 'Master/RealesedNoteGetAll?type=' + type;
            // If DataTable instance already exists, destroy it before re-initializing
            if (tpay) {
                tpay.destroy();
                $('#tblRealesenotelstPayroll').empty(); // Clear the table body to prevent lingering tooltips or data
            }
            //$("#dataTables_tbl_header").remove();
            tpay = $('#tblRealesenotelstPayroll').DataTable(
                {
                    "destroy": true,
                    "processing": false,
                    "ajax": {
                        url: _urltblpay,
                        type: "GET",
                        headers: { 'Authorization': '@_tokan' },
                        dataSrc: '',
                        async: false,
                    },
                    responsive: 'true',
                    //dom: 'lBfrtip',
                    dom: _domCommon,
                    language: _languageCommon,
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: 'Excel',
                            titleAttr: 'Excel',
                            exportOptions: {
                                columns: [2, 3, 4, 5, 6, 7]
                            }

                        }
                    ],
                    "pageLength": 10,
                    "columns": [
                        { "title": "Serial No", "data": null, "visible": false }, // Add titles for columns
                         { "title": "RID", "data": "RID", "visible": false },
                         {
                             "title": "Release Date", "data": "Realesedate", "render": function (data) {
                                 if ("@_isdateformat" == "dd-mm-yyyy") {
                                     return moment(data).format("DD-MM-YYYY");
                                 }
                                 else if ("@_isdateformat" == "mm-dd-yyyy") {
                                     return moment(data).format("MM-DD-YYYY");
                                 }
                                 else if ("@_isdateformat" == "yyyy-mm-dd") {
                                     return moment(data).format("YYYY-MM-DD");
                                 }
                                 else if ("@_isdateformat" == "yyyy-M-dd") {
                                     return moment(data).format("YYYY-MMM-DD");
                                 }
                                 else if ("@_isdateformat" == "M-dd-yyyy") {
                                     return moment(data).format("MMM-DD-YYYY");
                                 }
                                 else if ("@_isdateformat" == "dd-M-yyyy") {
                                     return moment(data).format("DD-MMM-YYYY");
                                 }
                             }
                         },
                         { "title": "Excel" },
                    ],
                    "columnDefs": [
                        {
                            "targets": [1],
                            "visible": false
                        },
                        {
                            "targets": 3,
                            "data": "Realesenote",
                            "render": function (data, type, full, meta) {
                                return '<a href="../RealeseList/' + data.replace(".", "_") + '.pdf" target="_blank" class="previewclass btn blue_btnnew tooltips" data-placement="top" Title="Click to open ' + data.replace(".", "_") + '""><i class="fa-regular fa-eye"></i></a><a href="../RealeseList/' + data.replace(".", "_") + '.pdf" target="_blank" class="downloaduserclass btn green_btnnew tooltips" data-placement="top" download="" Title="Click to download ' + data.replace(".", "_") + '"><i class="fa-regular fa-download"></i></a>';

                            },
                        },
                        {
                            "searchable": false,
                            "orderable": false,
                            "targets": 0
                        }
                    ],
                    "order": [[1, 'asc']], // Add default order, if needed
                }
            );
            setTimeout(function () {
                $("#" + "tblRealesenotelstPayroll" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive2"));
                $('.tooltips').tooltip();
            }, 100);
            tpay.on('order.dt search.dt', function () {
                tpay.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                    cell.innerHTML = i + 1;
                });
            }).draw();
        }
        $('.tooltips').tooltip();
    });

</script>
