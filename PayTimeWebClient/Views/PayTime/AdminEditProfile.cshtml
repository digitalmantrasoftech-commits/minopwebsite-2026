        $('#PhoneNo').on('keydown', function (event) {
            const key = event.keyCode;

            // Allow: backspace, delete, tab, arrows (left/right), home, end
            const allowedKeys = [8, 9, 46, 37, 39, 35, 36];

            // Allow: numbers from top row (48–57) without shift, and numpad (96–105)
            const isNumber = (key >= 48 && key <= 57 && !event.shiftKey) || (key >= 96 && key <= 105);

            if (allowedKeys.includes(key) || isNumber) {
                return; // Allow key
            }

            // Block everything else
            event.preventDefault();
        });
