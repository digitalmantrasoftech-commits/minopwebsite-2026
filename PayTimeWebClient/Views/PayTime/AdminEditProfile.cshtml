                $(this).val("");
                return false;
            }
            var allowedFiles = [".bmp", ".png", ".jpg", ".jpeg"];
            var fileUpload = $("#EmpPhotoFile");
            var regex = new RegExp("([a-zA-Z0-9\s_\\.\-:])+(" + allowedFiles.join('|') + ")$");
