        $("#DateOfBirth").on('change', function () {
            if ($("#DateOfBirth").val() != "") {
                // Get the selected date
                var selectedDate = new Date($("#DateOfBirth").val());

                // Get today's date and calculate the date 18 years ago
                var todayDate = new Date();
                var year = todayDate.getFullYear();
                var month = todayDate.getMonth(); // Month is zero-based
                var day = todayDate.getDate();
                var newyear = year - 18;
                var eighteenYearsAgo = new Date(newyear, month, day);

                // Compare the dates
                if (selectedDate > eighteenYearsAgo) {
                    $("#DateOfBirth").val("");
                    $("#DateOfBirth").addClass('field_error');
                    toastr.remove();
                    toastr.error("Age should not be less than 18 years.");
                    return false;
                } else {
                    $("#DateOfBirth").removeClass('field_error');
                }
            } else {
                $("#DateOfBirth").removeClass('field_error');
            }
