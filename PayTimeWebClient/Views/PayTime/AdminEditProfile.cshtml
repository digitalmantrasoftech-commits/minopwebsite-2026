                var smsmsg = "";
                smsmsg = ValidatePhone($("#PhoneNo").val());
                if (smsmsg != "success") {
                    toastr.remove();
                    toastr.error(smsmsg);
                    $("#PhoneNo").focus();
                    $("#PhoneNo").val("");
                    $("#PhoneNo").addClass('field_error');
                    return false;
                }
                else {
                    $("#PhoneNo").removeClass('field_error');
                    $("#spPhono").hide();
                    return true;
                }
            });

            $("#MobileNo").keypress(function (e) {
                $("#MobileNo").removeClass('field_error');
                if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {

                    return false;
                }
            });
            //$("#MobileNo").change(function () {
            //    if ($("#MobileNo").val().length >= 10) {
            //        $("#spEmpMNo").hide();
            //        $("#MobileNo").removeClass('field_error');
            //        return false;
            //    }
            //});

            $("#Name").keypress(function (e) {
                $("#Name").removeClass('field_error');
            });
            $("#DateOfBirth").change(function () {
                $("#DateOfBirth").removeClass('field_error');
            });
            $("#DealerCode").change(function () {
                $("#spdealercode").hide;
            });



            $("#Password").keypress(function (e) {
                $("#Password").removeClass('field_error');
            });
            $("#NewPassword").keypress(function (e) {
                if (e.which == 32) {
                    return false;
                }
                $("#NewPassword").removeClass('field_error');
            });
            $("#RePassword").keypress(function (e) {
                if (e.which == 32) {
                    return false;
                }
                $("#RePassword").removeClass('field_error');
            });

            $("#btnok").on('click', function () {
                $("#btnok").attr("data-toggle", "modal");
                $("#btnok").attr("data-target", "#frmpopup");
            });
            $("#btncancelpopup").on('click', function () {
                $("#btncancelpopup").attr("data-toggle", "modal");
                $("#btncancelpopup").attr("data-target", "#frmpopup");
                $("#DealerCode").val('');
                $("#DealerId").val(0);
            });
        });
        function togglePopUp() {

            if (document.getElementById('pop').style.display == "block") {
                document.getElementById('pop').style.display = "none";
            } else {
                document.getElementById('pop').style.display = "block";
            }
        }
        function CheckDealerCode() {
            var dearlCode = $("#DealerCode").val();
            if (dearlCode != "") {
                var url = '@_partnerapiurl' + 'Dealers/CheckDealer';
                $.get(url, { DearlerCode: dearlCode }, function (data) {
                    if (data != null && data.length > 0) {
                        $("#DealerId").val(data[0].DealerId);
                        $("#DealerCode").val(data[0].DealerCode);
                        $("#lblpartnername").html(data[0].PartnerName);
                        $("#lblmobile").html(data[0].MobileNo);
                        $("#ManagerId").val(data[0].Rsmid);
                        $("#ActManagerId").val(data[0].ActManagerId);
                        //togglePopUp();
                        $("#frmpopup").modal('show');
                        $("#spdealercode").html('');
                        $("#spdealercode").hide;

                    } else {
                        //document.getElementById('pop').style.display = "none";
                        $("#frmpopup").modal('hide');
                        $("#DealerCode").val('');
                        $("#DealerId").val(0);
                        $("#ManagerId").val(0);
                        $("#ActManagerId").val(0);
                        $("#spdealercode").html('Partner code not exists');
                        $("#spdealercode").show;
                    }
                });
            }
            else {
                $("#DealerId").val(0);
                $("#ManagerId").val(0);
                $("#ActManagerId").val(0);
                $("#spdealercode").html('');
                $("#spdealercode").hide;
            }

        }
        $("#Add").on('click', function () {
            $("#Add").attr("data-toggle", "modal");
            $("#Add").attr("data-target", "#frmpopupchangepassword");
        });

        $("#editinfo").on('click', function () {
            $("#editinfo").attr("data-toggle", "modal");
            $("#editinfo").attr("data-target", "#editinfo_modal");
        });
    });

    function formatAndReturnDate(dateString, format) {
        if (format === "dd-mm-yyyy") {
            return moment(dateString, "YYYY-MM-DDhh:mm:ss").format("DD-MM-YYYY");
        } else if (format === "mm-dd-yyyy") {
            return moment(dateString, "YYYY-MM-DDhh:mm:ss").format("MM-DD-YYYY");
        } else if (format === "yyyy-mm-dd") {
            return moment(dateString, "YYYY-MM-DDhh:mm:ss").format("YYYY-MM-DD");
        } else if (format === "yyyy-M-dd") {
            return moment(dateString, "YYYY-MM-DDhh:mm:ss").format("YYYY-MMM-DD");
        } else if (format === "M-dd-yyyy") {
            return moment(dateString, "YYYY-MM-DDhh:mm:ss").format("MMM-DD-YYYY");
        } else if (format === "dd-M-yyyy") {
            return moment(dateString, "YYYY-MM-DDhh:mm:ss").format("DD-MMM-YYYY");
        } else {
            console.error("Invalid format provided");
            return null;
        }
    }

    //webcamera icon click event - photo upload
    function ShowPopUp() {
        var webcam = "";
        var video = document.querySelector("#videoElement");
        if (navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia({ video: true })
                .then(function (stream) {
                    video.srcObject = stream;
                    $("#camarascreen").show();
                    myTimeOut = setTimeout(function () {
                        $("#camarascreen").hide('blind', {}, 500);
                        toastr.remove("");
                        toastr.error("Capture time out.");
                        //alert("Capture time out.");
                    }, 60000);
                })
                .catch(function (err0r) {
                    console.log("Something went wrong!");
                    //alert("No webcam found to take photo,please attach webcam.");
                    webcam = "No webcam found to take photo,please attach webcam.";
                    //alert(webcam);
                    toastr.remove();
                    toastr.error(webcam);
                });
        }
    }

</script>

