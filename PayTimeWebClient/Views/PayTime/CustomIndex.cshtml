    <script type="text/javascript">
        var webapiuri = '@_webapiurl';
        $(document).ready(function () {
            $(document).bind("contextmenu", function (e) {
                e.preventDefault();
            });
            $(document).keydown(function (e) {
                if (e.which === 123) {
                    return false;
                }
                if (e.ctrlKey && e.shiftKey && e.keyCode == 'I'.charCodeAt(0)) {
                    return false;
                }
                if (e.ctrlKey && e.shiftKey && e.keyCode == 'J'.charCodeAt(0)) {
                    return false;
                }
                if (e.ctrlKey && e.keyCode == 'U'.charCodeAt(0)) {
                    return false;
                }
            });
            $("#spvalidation").val("");
            $("#spvalidation").hide();
            $("#forgotpass").click(function () {
                location.href = '/PayTime/ForgotPassword/';
            });


            $("#btnlogin").click(function (event) {
                if ($('#UserEmail').val() == "") {
                    $("#spvalidation").html('Please Enter Email.').show();
                    $("#UserEmail").addClass('field_error');
                    //$("#sp1").hide();
                    $("#UserEmail").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#UserEmail").removeClass('field_error');
                    $("#spvalidation").hide();
                }

                //var filter = new RegExp(/^[_A-Za-z0-9-]+(\.[_A-Za-z0-9-]+)*@@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*(\.[A-Za-z]{2,4})$/);
                //if (!filter.test($("#UserEmail").val())) {
                //    $("#spvalidation").html('Enter valid email.').show();
                //    $("#UserEmail").addClass('field_error');
                //    //$("#sp2").hide();
                //    $("#UserEmail").focus();
                //    event.preventDefault();
                //    return false;
                //}
                //else {
                //    $("#UserEmail").removeClass('field_error');
                //    $("#spvalidation").hide();
                //}

                if ($('#Password').val() == "") {
                    $("#spvalidation").html('Please Enter Password.').show();
                    $("#Password").addClass('field_error');
                    //$("#sp1").hide();
                    $("#Password").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#Password").removeClass('field_error');
                    $("#spvalidation").hide();
                }


            });


            $("#UserEmail").keypress(function (e) {
                $("#UserEmail").removeClass('field_error');
                $("#spvalidation").hide();
            });
            $("#Password").keypress(function (e) {
                $("#Password").removeClass('field_error');
                $("#spvalidation").hide();
            });
        });

        function login() {
            var Email = $('#UserEmail').val();
            var Password = $('#Password').val();
            var CompanyCode = '@ViewBag.CompanyCode'
            $.ajax({
                contentType: 'application/json',
                dataType: 'json',
                type: 'post',
                data: '{"CompanyCode":"' + CompanyCode + '", "UserEmail":"' + Email + '","Password:"' + Password + '"}',
                url: webapiuri + '/Registration/LoginSubDomain',
                success: function (result) {
                    //alert('Login success ' + result.dbUser.Email + "  " + result.token);
                    location.href = '/Dashboard/AdminDashboard/';
                },
                error: function (result) {
                    alert(result);
                    alert('error ' + result.MegSts + "  " + result.Meg)
                },

            });

        }
    </script>
    @Scripts.Render("~/bundles/landingjs")
</head>
<body class="login_bg " data-spy="scroll" data-target="sidebar" data-offset="120">

    <section id="login" class="login">
        <div class="container  wow slideInLeft   animated" data-wow-duration="1s">
            <div class="row">
                <div class=" col-md-6  col-sm-8 col-ls-4">
                    <img class="img-responsive" src="~/LandingAssets/images/login-a.svg">
                </div>
                <div class="col-md-4 col-md-offset-1 col-sm-4 col-sm-offset-1 col-ls-4">
                    <div class="logo">
                        <h3 style="color:white">
                            @*<img src="~/LandingAssets/images/c-mini-logo-white.png" width="150">*@
                            Welcome to <span>@ViewBag.CompanyName</span>
                        </h3>
                    </div>
                    <div class="box ">
                        @*<div class="icon">
                                <i class="fa fa-user"></i>
                            </div>*@
                        <h1><b>Login to your account</b></h1>
                        @if (strmsg != "" && strmegsts != "")
                        {
                            <div class="col-md-12 text-center red">
                                @if (strmegsts == "error")
                                {
                                    <strong id="strstg" style="color:red">Error !</strong>
                                    <span style="color:red">@strmsg</span>
                                }
                                else
                                {
                                    <strong id="strstg" style="color:blue">Info !</strong>
                                    <span style="color: blue">@strmsg</span>

                                }
                            </div>
                        }
                        <form class="form" action="/PayTime/SubDomainLogin" method="post">
                            <div class="from_body">
                                <input type="hidden" id="CompanyCode" value="@ViewBag.CompanyCode" name="CompanyCode" />
                                <div class="form_group">
                                    <input type="text" name="UserEmail" autofocus="" id="UserEmail">
                                    <span class="highlight"></span>
                                    <span class="bar"></span>
                                    <label>Email / Punch ID / Employee Code</label>
                                </div>
                                <div class="form_group">
                                    <input type="password" autofocus="" id="Password" name="Password">
                                    <span class="highlight"></span>
                                    <span class="bar"></span>
                                    <label>Password</label>
                                </div>
                                <div>
                                    <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                                </div>
                                <div class="text-center">
                                    <button type="submit" class="" id="btnlogin">Login</button>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="checkbox">
                                            <label><input type="checkbox" value="">Remember me</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6 forgot">
                                        <a href="/PayTime/ForgotPassword/" id="forgotpass">Forgot Password?</a>
                                    </div>
                                </div>
                            </div>
                        </form>


                    </div>
                    <p>Powered By</p>

                    <div class="text-center"> <a href="#"><img src="~/LandingAssets/images/c-mini-logo.png"> </a></div>
                </div>
            </div>
        </div>
    </section>


