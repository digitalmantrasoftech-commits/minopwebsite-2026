@model PayTimeWebClient.Models.SuperAdminDetails
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{

    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    if (_RoleId == 15)
    {
        ViewBag.Title = "SuperAdminCompanyDetails";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
    }
}
<script type="text/javascript">
    $(document).ready(function () {
        $('#tblsuperAdmin').DataTable({
            responsive: 'true',
            pagination: false,
            dom: _domCommon,
            language: _languageCommon,
        });

        setTimeout(function () {
            $("#" + "tblsuperAdmin" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
     
    });
</script>

@if (_RoleId == 15)
{
    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Company Details</span>
            </li>
        </ul>
        <div>
            <div class="report_title">
                <p>Registered Companies</p>
            </div>
        </div>
    </div>

    <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="portlet">
                <div class="portlet-body">
                    <div class="table-responsive" id="tableResponsive">
                        <table id="tblsuperAdmin" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th hidden>UserId</th>
                                    <th>Email</th>
                                    <th hidden>CompanyId</th>
                                    <th hidden>CompanyCode</th>
                                    <th>CompanyName</th>
                                    <th>DomainName </th>
                                    <th hidden>DbType</th>
                                    <th>CompanyDbName</th>
                                    <th hidden>IsActiveRegCom</th>
                                    <th hidden>IsActiveUser</th>
                                    <th hidden>CompanyPlanId</th>
                                    <th>PlanStartDate</th>
                                    <th>PlanEndDate</th>
                                    <th hidden>IsActivePlan</th>
                                    <th hidden>PlanName</th>
                                    <th hidden>PlanDuration</th>
                                    <th>PlanPrice</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int n = 1;
                                }
                                @if (Model.SuperAdminDetailslist != null)
                                {
                                    foreach (var i in Model.SuperAdminDetailslist)
                                    {
                                        <tr>
                                            <td id="sr">@n</td>
                                            <td hidden> @i.UserId </td>
                                            <td>@i.Email</td>
                                            <td hidden>@i.CompanyId</td>
                                            <td hidden>@i.CompanyCode</td>
                                            <td>@i.CompanyName</td>
                                            <td>@i.DomainName</td>
                                            <td hidden>@i.DbType</td>
                                            <td>@i.CompanyDbName</td>
                                            <td hidden>@i.IsActiveRegCom</td>
                                            <td hidden>@i.IsActiveUser</td>
                                            <td hidden>@i.CompanyPlanId</td>
                                            <td>@i.PlanStartDate</td>
                                            <td>@i.PlanEndDate</td>
                                            <td hidden>@i.IsActivePlan</td>
                                            <td hidden>@i.PlanName</td>
                                            <td hidden>@i.PlanDuration</td>
                                            <td>@i.PlanPrice</td>
                                        </tr>
                                        n++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}
