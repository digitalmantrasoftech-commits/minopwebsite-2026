@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ModuleSelection</title>
    <link href="~/assets/layouts/layout/css/custom.css" rel="stylesheet" />
    <link href="~/assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/assets/plugins/bootstrap/js/bootstrap.min.js"></script>
</head>
<body>
    <div class="module1">
        <div class="top_head"><h1>Module Selection</h1> </div>
        <div class="container">
            <h2 class="text-center">All in One Cloud attendance System </h2>
            <p class="text-center">
                All your attendance data is stored in your Minop Cloud attendance system
            </p>

            @if (Session["IsSetting"].ToString() == "True")
            {
                <div class="col-md-6">
                    <div class="m_box">
                        <a href="@Url.Action("AdminDashboard", "PayTime")"><img alt="Office Management" class="img-responsive" src="~/assets/layouts/layout/img/officemanagement.png"></a>

                    </div>

                </div>                <div class="col-md-6">
                    <div class="m_box">
                        <a href="@Url.Action("AdminDashboard", "School")"><img alt="School Management" class="img-responsive" src="~/assets/layouts/layout/img/SchoolManagement.png"></a>

                    </div>
                </div>


            }
            else
            {
                <div class="col-md-6">
                    <div class="m_box">
                        <a href="@Url.Action("SystemSettingWizard", "PayTime")"><img alt="Office Management" class="img-responsive" src="~/assets/layouts/layout/img/officemanagement.png"></a>

                    </div>

                </div>                <div class="col-md-6">
                    <div class="m_box">
                        <a href="@Url.Action("AdminDashboard", "School")"><img alt="School Management" class="img-responsive" src="~/assets/layouts/layout/img/SchoolManagement.png"></a>

                    </div>
                </div>
            }
            <div class="col-md-12">
                <h4 class="text-center">Kindly select the Module</h4>

            </div>
        </div>
    </div>

</body>
</html>
