@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@using System.Data
@using System
@model DataTable
@{
    string _Message = string.Empty;
    string _error = string.Empty;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    if (_RoleId == 15)
    {
        ViewBag.Title = "Analytics Reports";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
        _Message = ViewBag.msg;
        _error = ViewBag.error;
    }
}
<script src="~/Scripts/toastr.min.js"></script>
<link href="~/Content/toastr.min.css" rel="stylesheet" />
<script type="text/javascript">
    $(document).ready(function () {
        FillReports();
        $("#btnsearch").on('click', function () {
            if ($("#seldreport").val() == 0) {
                toastr.remove();
                toastr.error("Please select report type.");
                return false;
            } else if ($("#frmdate").val() == "") {
                toastr.remove();
                toastr.error("Please select from date.");
                return false;
            } else {
                @*var obj = {
                    rptid: $("#seldreport").val(),
                    fdate: $("#frmdate").val()
                }
                $.ajax({
                    type: 'POST',
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurl' + '/DashBoard/SuperAdminReportsGrid',
                    data: JSON.stringify(obj),
                    contentType: "application/json",
                    dataType: 'json',
                    async: false,
                    cache: false,
                    timeout: 30000,
                    success: function (data) {

                    },
                    error: function (data) {
                        //alert("Already Exists");
                        //window.location.href = "SchoolSmsTemplate";
                    },
                });*@
                $('#frmrpt').submit();
            }
        });
    });
    function FillReports() {
        $.ajax({
            type: 'GET',
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'DashBoard/GetsuperAdminReportsType',
            contentType: "application/json",
            timeout: 30000,
            success: function (response) {
                if (response != null) {
                    $("#seldreport").empty();
                    $("#seldreport").append("<option value='0' selected>Select Reports</option>");
                    for (var i = 0; i < response.length; i++) {
                        $("#seldreport").append("<option value='" + response[i].rptid + "'>" + response[i].ReportName + "</option>");
                    }
                }
            }
        });
    }

    $(document).ready(function () {
        var table = $('#crpttbl').DataTable({
            "responsive": true,
            "processing": true,
            dom: _domCommon,
            language: _languageCommon,
            //"dom": 'lBfrtip',
            "ordering": true,
            "buttons": [{
                extend: 'excelHtml5',
                text: 'Excel',
                titleAttr: 'Export to excel'
            },
            {
                extend: 'csvHtml5',
                text: 'CSV',
                titleAttr: 'Export to csv'
            }],
        });
        setTimeout(function () {
            $("#" + "crpttbl" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        //new $.fn.dataTable.ColReorder(table, {
        //});

        $("#Filter_search").click(function () {
            $("#filter_open_div").toggle();
        });
    });
</script>

@if (_RoleId == 15)
{
    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Analytics Reports</span>
            </li>
        </ul>
        <div>
            <div class="report_title">
                <p>Analytics Reports</p>
            </div>
            <div class="page-toolbar poll-right">
                <button type="button" id="Filter_search" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Filter"><i class="fa-light fa-filter"></i></button>
            </div>
        </div>
    </div>

    <div class="row" id="filter_open_div">
        <div class="col-lg-12 margin-bottom-15">
            <form method="post" action="AnalyticsReports" id="frmrpt" name="frmrpt">
                <div class="portlet">
                    <div class="portlet-body">
                        <div class="portlet-title">
                            <div class="row">
                                <div class="col-md-4 col-sm-4">
                                    <div class="form-group">
                                        <label> Report Type : <span class="required" aria-required="true"> * </span> </label>
                                        <div class="form-group ">
                                            <select class="form-control input-sm select2" id="seldreport" name="rptid">
                                                <option value="0" selected>Select Reports</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4">
                                    <div class="form-group">
                                        <label> From Date : <span class="required" aria-required="true" style="color: #e02222"> * </span> </label>
                                        <div class="input-group input-group-sm date date-picker" data-date="@DateTime.Now" data-date-format="yyyy-mm-dd" data-date-end-date="0d" data-date-viewmode="years" id="srchfromdt">
                                            <span class="input-group-btn">
                                                <button class="btn default" type="button" disabled>
                                                    <i class="fa-light fa-calendar-days"></i>
                                                </button>
                                            </span>
                                            <input type="text" placeholder="yyyy-mm-dd" class="form-control" id="frmdate" name="fdate" autocomplete="off">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-2" style="margin-top: 24px;">
                                    <button type="submit" class="btn icon_btn tooltips" id="btnsearch" data-placement="top" data-original-title="Search by Filters">
                                        <i class="fa-solid fa-magnifying-glass" style="font-size:13px;"></i>
                                        <span class="ladda-spinner"></span><div class="ladda-progress" style="width: 0px;"></div>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id='ajax_loader' class="modal_bg loading" aria-hidden="true" hidden>
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>

    <div class="header-full-width" style="text-align:center"><span id="customcaption" class="h2"></span></div>

    <div class="portlet">
        <div class="portlet-body">
            <div class="table-scrollable">
                @if (Model != null && Model.Rows.Count != 0)
                {
                    <div class="table-responsive" id="tableResponsive">
                        <table id="crpttbl" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    @foreach (DataColumn col in Model.Columns)
                                    {
                                        <th>
                                            @if (col.ColumnName.Contains("file-"))
                                            {
                                                @col.ColumnName.Replace("file-", "")
                                            }
                                            @if (col.ColumnName.Contains("date-"))
                                            {
                                                @col.ColumnName.Replace("date-", "")
                                            }
                                            else
                                            {
                                                @col.ColumnName
                                            }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{ int i = 1; }
                                @foreach (DataRow row in Model.Rows)
                                {
                                    <tr>
                                        @foreach (DataColumn col in Model.Columns)
                                        {
                                            <td>@row[col.ColumnName]</td>
                                        }
                                        <span style="display:none;">@i++</span>
                                    </tr>
                                }
                                @if (Model.Rows.Count == i)
                                {

                                }
                            </tbody>
                        </table>
                        </div>
                        //}
                        }
                        else
                        {
                        @*<table class="display" style="width:100%">
                    <tr>
                        <td colspan="8" style="text-align:center; font-size:18px;"> <b>No matching records found</b></td>
                    </tr>
                </table>*@
                        }
                    </div>
                </div>
    </div>
}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}

