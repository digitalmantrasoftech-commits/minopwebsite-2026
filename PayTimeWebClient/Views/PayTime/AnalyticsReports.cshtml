        background: #fff none repeat scroll 0 0;
        margin-bottom: 30px;
        border-radius: 4px;
        box-shadow: 0 2px 18px 1px rgba(49, 53, 72, 0.1);
        padding: 5px 15px;
        margin: -260px 0 0;
    }

    .quick-search-visible {
        margin: 0 0 16px;
    }

    .form-group {
        position: relative;
    }

    .page-content-white .page-content .page-bar {
        border-bottom: none;
    }
</style>