        "use strict";
        var video, $output;
        var scale = 0.25;

        var initialize = function () {
            $output = $("#output");
            video = $("#videoElement").get(0);
            $("#capture").click(captureImage);
        };
        var captureImage = function () {
            clearTimeout(myTimeOut);
            $("#ajax_loader").show();
            var canvas = document.createElement("canvas");
            canvas.width = video.videoWidth * scale;
            canvas.height = video.videoHeight * scale;
            canvas.getContext('2d')
                .drawImage(video, 0, 0, canvas.width, canvas.height);

            var img = document.createElement("img");
            img.src = canvas.toDataURL();

            //resize an image
            const resizedImage = new Image();
            resizedImage.src = img.src;

            resizedImage.onload = function () {
                const maxWidth = 1920; // Max width for the resized image
                const maxHeight = 1080; // Max height for the resized image

                let width = resizedImage.width;
                let height = resizedImage.height;

                // Maintain aspect ratio
                if (width > maxWidth) {
                    height *= maxWidth / width;
                    width = maxWidth;
                }
                if (height > maxHeight) {
                    width *= maxHeight / height;
                    height = maxHeight;
                }

                const resizedCanvas = document.createElement('canvas');
                resizedCanvas.width = width;
                resizedCanvas.height = height;

                const ctx = resizedCanvas.getContext('2d');
                ctx.drawImage(resizedImage, 0, 0, width, height);

                var base64result = resizedCanvas.toDataURL().split(',')[1];

                if (base64result != "") {
                    $.ajax({
                        type: "POST",
                        url: '@_webapiurl' + 'dvc/GetFaceQuality',
                        data: {
                            image: base64result,
                            qualityThreshold: '@_facequalitythreshold'
                        },
                        success: function (response) {
                            
                            $("#ajax_loader").hide();
                            if (response.isRedirect) {
                                window.location.href = response.redirectUrl;
                            }
                            if (response.highQualityface) {
                                $("#empimg").attr("src", img.src);
                                $("#camarascreen").hide();
                                $("#EmpPhotoData").val(base64result);
                               
                                clearTimeout(myTimeOut);
                            } else {

                                if (response.message != null) {
                                    if (response.message == "Invalid image. Please pass base-64 string of any .jpg .jpeg .png .bmp.") {
                                        toastr.remove();
                                        toastr.error("Please upload files having extensions of .jpg .jpeg .png .bmp.");
                                    }
                                    else if (response.message == "image quality is low, Please select image with proper quality.") {
                                        toastr.remove();
                                        toastr.error("Please upload a higher-quality image.");
                                    }
                                    else if (response.message == "No face is detected in the image.") {
                                        toastr.remove();
                                        toastr.error("There was no face identified, so please upload the new image.");
                                    }
                                    else if (response.message == "Something went wrong on face detect") {
                                        toastr.remove();
                                        toastr.error("Face not detected ,please upload image with proper face.");
                                    }
                                    else {
                                        toastr.remove();
                                        toastr.error(response.message);
                                    }
                                } else {
                                    toastr.remove();
                                    toastr.error("Photo quality is not proper, Please capture photo again.");
                                }
                            }
                        },
                        error: function (response) {
                            
                            $("#ajax_loader").hide();
                            if (!response.highQualityface) {
                                toastr.remove();
                                toastr.success(response.message);
                            } else {
                                toastr.remove();
                                toastr.error("Please upload the high quality photo.");
                            }

                        }
                    });
                } else {
                    $("#ajax_loader").hide();
                    toastr.remove("");
                    toastr.error("File not in proper format.");
                }

            }
        };
