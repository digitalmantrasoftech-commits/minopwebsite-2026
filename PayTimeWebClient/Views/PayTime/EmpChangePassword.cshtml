<div id="editinfo_modal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Personal Information</h4>
            </div>

            <div class="modal-body">
                <div class="modal-card">
                    <div class="row">
                        <div class="col-sm-6 col-xs-12">
                            <div class="form-group">
                                <div class="form-group" hidden>
                                    <input type="text" class="form-control" id="EmpId" name="EmpId" value="@Session["EmpId"]" />
                                </div>
                                <label class="control-label">Name <span class="required" aria-required="true"> * </span></label>
                                <input class="form-control" id="Name" maxlength="50" name="Name" type="text" value="" placeholder="Enter Name" required="required" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')">
                            </div>
                        </div>
                        <div class="col-sm-6 col-xs-12">
                            <div class="form-group data_picker_box">
                                <label>Date of Birth <span class="required" aria-required="true"> * </span></label>
                                <div class="input-group date date-picker" data-date-format="@_isdateformat" data-date-end-date="0d" data-date-viewmode="years" id="joindate">
                                    <span class="input-group-btn">
                                        <button class="btn default" type="button">
                                            <i class="fa-light fa-calendar-days"></i>
                                        </button>
                                    </span>
                                    @if (_isdateformat == "dd-M-yyyy" || _isdateformat == "M-dd-yyyy" || _isdateformat == "yyyy-M-dd")
                                    {
                                        <input type="text" class="form-control" id="DateOfBirth" data-date-format="@_isdateformat" name="DateOfBirth" placeholder="@_isdateformat.Replace("M", "MMM")" autocomplete="off">
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control" id="DateOfBirth" data-date-format="@_isdateformat" name="DateOfBirth" placeholder="@_isdateformat" autocomplete="off">
                                    }
                                </div>
                                <span class="help-block error_help_block" hidden id="spEmpDOBDate"></span>
                            </div>
                        </div>
                        <div class="col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label>Mobile No <span class="required" aria-required="true"> * </span> </label>
                                <input type="hidden" id="code" name="code">
                                <input type="tel" class="form-control" id="MobileNo" name="MobileNo" placeholder="Enter Mobile No" maxlength="15" />
                                <input id="CountryCode" type="hidden" name="CountryCode">
                                <span class="help-block error_help_block" hidden id="spEmpMNo"></span>
                            </div>
                        </div>
                        <div class="col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label class="control-label">Address</label>
                                <textarea id="Address" name="Address" rows="2" class="form-control" placeholder="Enter Address" maxlength="150"></textarea>
                            </div>
                        </div>
                        <div class="col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label class="control-label">Gender </label><br />
                                <label class="mt-radio mt-radio-outline">
                                    Male
                                    <input value="false" name="Gender" id="GenderM" type="radio">
                                    <span></span>
                                </label>
                                <label class="mt-radio mt-radio-outline">
                                    Female
                                    <input value="true" name="Gender" id="GenderF" type="radio">
                                    <span></span>
                                </label>
                            </div>
                        </div>
                        <div class="col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label class="control-label">Marital Status </label><br />
                                <label class="mt-radio mt-radio-outline">
                                    Single
                                    <input value="False" name="EmpMarried" id="Empsingle" type="radio">
                                    <span></span>
                                </label>
                                <label class="mt-radio mt-radio-outline">
                                    Married
                                    <input value="True" name="EmpMarried" id="EmpMarried" type="radio">
                                    <span></span>
                                </label>
                            </div>
                        </div>
                        <div class="col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label>Employee Photo</label>
                                <div class="upload-box">
                                    <div class="fileinput fileinput-new" data-provides="fileinput">
                                        <div class="fileinput-new profile_img" >
                                            <img src="~/assets/images/avtar.png" alt="user image" id="editempimg" onerror="this.onerror=null; this.src='/assets/images/avtar.png';"/>
                                        </div>
                                        <div class="profile_img fileinput-preview fileinput-exists profile_img" id="Sub_Photo"></div>
                                        <div class="upload-overlay">
                                            <div style="display: flex;">
                                                <span class="btn blueupload_btn btn-file">
                                                    <span class="fileinput-new btn-block"><i class="fa-regular fa-arrow-up-from-bracket"></i></span>
                                                    <span class="fileinput-exists" id="Upload_Sign"><i class="fa-regular fa-pen-to-square"></i></span>
                                                    <input type="file" name="EmpPhotoFile" id="EmpPhotoFile" value="">
                                                    <input type="hidden" id="Photo" name="Photo">
                                                </span>
                                                <a href="javascript:ShowPopUp()" class="btn blueupload_btn Take_Photo_btn filecamera"><i class="fa-regular fa-camera"></i></a>
                                                <a href="javascript:;" class="btn redupload_btn fileinput-exists"id="TrashImage" data-dismiss="fileinput"><i class="fa-light fa-trash-can"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                        <button type="button" class=" btn icon_addbtn" id="btncancelperinfo"><i class="fa-solid fa-xmark"></i> Cancel</button>
                        <button type="button" class="btn save_btn" id="btnsubmit"><i class="fa-light fa-floppy-disk"></i> Save</button>
                    </div>
                </div>
            </div>

        </div>
    </div>


</div>
<!-- Edit Information Modal : End -->

