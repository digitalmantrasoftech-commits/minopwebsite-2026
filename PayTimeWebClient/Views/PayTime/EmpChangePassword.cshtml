    function formatDate(date, format) {
                var dateParts = date.split('-');
        var year = dateParts[0];
        var month = dateParts[1];
        var day = dateParts[2];

        if (format === "dd-mm-yyyy") {
            return day + '-' + month + '-' + year;
        } else if (format === "mm-dd-yyyy") {
            return month + '-' + day + '-' + year;
        } else if (format === "yyyy-mm-dd") {
            return year + '-' + month + '-' + day;
        } else if (format === "dd-M-yyyy") {
            var getMonth = GetMonthNumber(month); // Convert month to number
            return day + '-' + (getMonth.toString().length > 1 ? getMonth : '0' + getMonth) + '-' + year;
        } else if (format === "M-dd-yyyy") {
            var getMonth = GetMonthNumber(month);
            return (getMonth.toString().length > 1 ? getMonth : '0' + getMonth) + '-' + day + '-' + year;
        } else if (format === "yyyy-M-dd") {
            var getMonth = GetMonthNumber(month);
            return year + '-' + (getMonth.toString().length > 1 ? getMonth : '0' + getMonth) + '-' + day;
        }
        return date; // Return the default format if no match
    }

