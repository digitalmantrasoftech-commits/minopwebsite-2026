    function formatAndReturnDate(dateString, targetFormat) {
        

        let parsedDate;

        if (targetFormat === "mm-dd-yyyy") {
           
            parsedDate = moment(dateString, "MM-DD-YYYY", true);
        } else {
          
            const possibleInputFormats = [
                "DD-MM-YYYY",
                "MM-DD-YYYY",
                "YYYY-MM-DD",
                "DD-MMM-YYYY",
                "MMM-DD-YYYY",
                "YYYY-MMM-DD"
            ];
            parsedDate = moment(dateString, possibleInputFormats, true);
        }

        if (!parsedDate.isValid()) {
            console.error("Invalid date:", dateString);
            return null;
        }

        // Format the output based on target
        switch (targetFormat) {
            case "dd-mm-yyyy":
                return parsedDate.format("DD-MM-YYYY");
            case "mm-dd-yyyy":
                return parsedDate.format("MM-DD-YYYY");
            case "yyyy-mm-dd":
                return parsedDate.format("YYYY-MM-DD");
            case "yyyy-M-dd":
                return parsedDate.format("YYYY-MMM-DD");
            case "M-dd-yyyy":
                return parsedDate.format("MMM-DD-YYYY");
            case "dd-M-yyyy":
                return parsedDate.format("DD-MMM-YYYY");
            default:
                console.error("Invalid target format provided");
                return null;
        }
    }


