@model PayTimeWebClient.Models.HRPolicy
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>HR Policy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <link href="~/PDFContent/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/PDFContent/css/responsive.css" rel="stylesheet" type="text/css" />
    <link href="~/Newlayout/css/samplepolicy.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif !important;
            font-weight: 400;
            letter-spacing: 0.2px;
        }
    </style>
</head>


<body id="myPage" data-spy="scroll" data-target=".navbar" data-offset="60">
    <div class="header_section">
        <a class="logo_mivanta" href="javascript:void(0)">
            <img src="~/PDFContent/img/logo.png">
        </a>
        <div class="header_img_box">
            <img src="~/Newlayout/images/hrpolicy.png" class="img-fluid">
        </div>
    </div>

    @foreach (var i in ViewBag.policydata as IEnumerable<HRPolicy>)
    {

        <section class="back_blue">
            <h1 class="pname"><b>Policy :</b><span> @i.PolicyName</span></h1>
            <div class="container">
                <div class="row">
                    <div class="col-md-6 col-sm-12">
                        <div class="panel panel-primary">
                            <div class="panel-heading"><img src="/Newlayout/images/employee.svg"> Employeement Rules </div>
                            <div class="panel-body">
                                <ul>
                                    <li>
                                        First Week Off :
                                        @if (i.EmpWeekOff == 0)
                                        {
                                            <span>None</span>
                                        }
                                        else if (i.EmpWeekOff == 1)
                                        {
                                            <span>Sunday</span>
                                        }
                                        else if (i.EmpWeekOff == 2)
                                        {
                                            <span>Monday</span>
                                        }
                                        else if (i.EmpWeekOff == 3)
                                        {
                                            <span>Tuesday</span>
                                        }
                                        else if (i.EmpWeekOff == 4)
                                        {
                                            <span>Wednesday</span>
                                        }
                                        else if (i.EmpWeekOff == 5)
                                        {
                                            <span>Thursday</span>
                                        }
                                        else if (i.EmpWeekOff == 6)
                                        {
                                            <span>Friday</span>
                                        }
                                        else if (i.EmpWeekOff == 7)
                                        {
                                            <span>Saturday</span>
                                        }
                                    </li>
                                    <li>
                                        Second Week off :
                                        @if (i.EmpSecondWeekOff == 0)
                                        {
                                            <span>None</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 1)
                                        {
                                            <span>Sunday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 2)
                                        {
                                            <span>Monday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 3)
                                        {
                                            <span>Tuesday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 4)
                                        {
                                            <span>Wednesday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 5)
                                        {
                                            <span>Thursday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 6)
                                        {
                                            <span>Friday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 7)
                                        {
                                            <span>Saturday</span>
                                        }
                                    </li>
                                    <li>
                                        Half Day Off :
                                        @if (i.EmpHalfDay == 0)
                                        {
                                            <span>None</span>
                                        }
                                        else if (i.EmpHalfDay == 1)
                                        {
                                            <span>Sunday</span>
                                        }
                                        else if (i.EmpHalfDay == 2)
                                        {
                                            <span>Monday</span>
                                        }
                                        else if (i.EmpHalfDay == 3)
                                        {
                                            <span>Tuesday</span>
                                        }
                                        else if (i.EmpHalfDay == 4)
                                        {
                                            <span>Wednesday</span>
                                        }
                                        else if (i.EmpHalfDay == 5)
                                        {
                                            <span>Thursday</span>
                                        }
                                        else if (i.EmpHalfDay == 6)
                                        {
                                            <span>Friday</span>
                                        }
                                        else if (i.EmpHalfDay == 7)
                                        {
                                            <span>Saturday</span>
                                        }
                                    </li>
                                    <li>
                                        Allow OverTime :
                                        @if (i.EmpAllowOT == 0)
                                        {
                                            <span>No</span>
                                        }
                                        else if (i.EmpAllowOT == 1)
                                        {
                                            <span>Yes</span>
                                        }
                                    </li>

                                    <li>
                                        Second Week Off Rule :

                                        @{
        if (i.EmpSecondWeekOffRule == "0" || i.EmpSecondWeekOffRule == null)
        {
            <span>None</span>
        }
        else
        {
            string str = i.EmpSecondWeekOffRule;
            var lat = str.Split(',');

            for (var j = 0; j < lat.Length; j++)
            {
                if (lat[j] == "1")
                {
                    <span>First</span>
                }
                if (lat[j] == "2")
                {
                    <span>Second</span>
                }
                if (lat[j] == "3")
                {
                    <span>Third</span>
                }
                if (lat[j] == "4")
                {

                    <span>Fourth</span>
                }
                if (lat[j] == "5")
                {
                    <span>Fifth</span>
                }
            }
        }


                                        }
                                    </li>
                                    <li>
                                        HalfDay Rule :
                                        @{
        if (i.EmpHalfDayRule == "0" || i.EmpHalfDayRule == null)
        {
            <span>None</span>
        }
        else
        {
            string strHalf = i.EmpHalfDayRule;
            var latHalf = strHalf.Split(',');

            for (var j = 0; j < latHalf.Length; j++)
            {
                if (latHalf[j] == "1")
                {
                    <span>First</span>
                }
                if (latHalf[j] == "2")
                {
                    <span>Second</span>
                }
                if (latHalf[j] == "3")
                {
                    <span>Third</span>
                }
                if (latHalf[j] == "4")
                {

                    <span>Fourth</span>
                }
                if (latHalf[j] == "5")
                {
                    <span>Fifth</span>
                }
            }
        }
                                        }

                                    </li>
                                </ul>
                            </div>

                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="panel panel-primary">
                            <div class="panel-heading"><img src="/Newlayout/images/calculator.svg"> Formula of Shift Calculation</div>
                            <div class="panel-body">
                                <ul>
                                    <li>OUT Punch accepted within :<span>@i.MaxOutDur</span>Hrs.</li>
                                    <li>Grace Time For Late IN  :<span>@i.GraceLateIN</span> Minutes</li>
                                    <li>Application Mode :<span>@i.ApplicationMode</span></li>
                                    <li>Time Duration between two punches :<span> @i.TimeBetPunch</span> Minutes</li>
                                    <li>Grace Time For Early OUT  :<span> @i.GraceEarlyOUT</span> Minutes</li>
                                    <li>Start Day of the Monthly Report :<span>  @i.MonthlyRptStaDay</span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="overtime_formula">
                <div class="container">
                    <div class="row">
                        <div class="col-md-12 ">
                            <div class="panel panel-primary">
                                <div class="title">Overtime Calculation Formula</div>
                                <div class="">
                                    @if (i.OTFormula == 1)
                                    {
                                        <center><h4><label><b><u> Working Hrs - Shift Hrs</u></b></label></h4></center>
                                    }
                                    @if (i.OTFormula == 2)
                                    {
                                        <center><h4><label><b><u> Working Hrs - Present Hrs</u></b></label></h4></center>
                                    }
                                    @if (i.OTFormula == 3)
                                    {
                                        <center><h4><label><b><u>After Shift - End Time</u></b></label></h4></center>
                                    }
                                    @if (i.OTFormula == 4)
                                    {
                                        <center><h4 class="shift_title"><label><b><u>Before Shift - Start Time</u></b></label></h4></center>
                                    }

                                    <ul class="no_style ">
                                        <li><label><label for="checkbox-1-1"></label>  Minimum Hour for OverTime Start  :   <span>  @i.OTMinHour  </span>  Minutes </label></li>

                                        <li><label> <label for="checkbox-1-1"></label> Weekly off hour Calculated as OverTime Hour :  <span>    @i.WeekOffOTHour  </span>  Minutes </label></li>

                                        <li><label> <label for="checkbox-1-1"></label> Holiday off hour Calculated as OverTime Hour :  <span>   @i.HolidayOffOTHour  </span>  Minutes </label></li>

                                        <li><label> <label for="checkbox-1-1"></label> Calculated As absent for Weekly Off & Holiday Off if Employee not Present for Whole Month</label></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="Sandwhichrule">
                <div class="container">
                    <div class="row">
                        <div class="col-md-12 ">
                            <div class="panel panel-primary">
                                <div class="title">Sandwhichrule</div>
                                <div class="">
                                    <ul class="no_style">
                                        @if (i.Issedwrule == 1)
                                        {
                                            <li><label> <label for="checkbox-1-1"></label> Sandwich rule applied </label> </li>
                                        }
                                    </ul>
                                    <ul class="no_style">
                                        @if (i.IssedwruleType == 1)
                                        {
                                            <li><label><label for="checkbox-1-1"></label> Week off or Holiday absent if prefix And suffix day absent</label> </li>
                                        }
                                        @if (i.IssedwruleType == 2)
                                        {
                                            <li><label><label for="checkbox-1-1"></label>  Week off or Holiday absent if prefix Or suffix day absent</label> </li>
                                        }
                                        @if (i.IssedwruleType == 3)
                                        {
                                            <li><label><label for="checkbox-1-1"></label>  Week off or Holiday absent if prefix day absent</label> </li>
                                        }
                                        @if (i.IssedwruleType == 4)
                                        {
                                            <li><label><label for="checkbox-1-1"></label> Week off or Holiday absent if suffix day absent</label> </li>
                                        }
                                    </ul>   
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-md-12 col-sm-12">
                        <div class="panel-primary">
                            <div class="title">Attendance Rule</div>
                            <ul class="no_style">
                                @if (i.AllErrorCase == 1)
                                {
                                    <li><label> <label for="checkbox-1-1"></label>Calculate present in Any Error Case </label> </li>
                                }
                                else
                                {
                                    <li><label> <label for="checkbox-1-1"></label> Calculate Half Day when Error case</label> </li>
                                }
                            </ul>
                          
                            <ul class="no_style">
                                @if (i.HdLate != 0)
                                {
                                    <li><label><label for="checkbox-1-1"></label> Calculate Half Day if Late Count Greater or equal @i.HdLate</label> </li>
                                }
                                @if (i.HdEd != 0)
                                {
                                    <li><label><label for="checkbox-1-1"></label> Calculate Half Day if Early Departure Count Greater or equal @i.HdEd</label> </li>
                                }
                                @if (i.HdLateorEd != 0)
                                {
                                    <li><label><label for="checkbox-1-1"></label> Calculate Half Day if Late or Early Departure Count Greater or equal  @i.HdLateorEd</label> </li>
                                }
                                @if (i.ALate != 0)
                                {
                                    <li><label><label for="checkbox-1-1"></label> Calculate Absent if Late Count Greater or equal @i.ALate</label> </li>
                                }
                                @if (i.AED != 0)
                                {
                                    <li><label> <label for="checkbox-1-1"></label> Calculate Absent if Early Departure Count Greater or equal @i.AED</label> </li>
                                }
                                @if (i.ALateorED != 0)
                                {
                                    <li><label><label for="checkbox-1-1"></label> Calculate Absent if Late or Early Departure Count Greater or equal  @i.ALateorED</label> </li>
                                }
                            </ul>

                           
                            <ul class="no_style">
                                @if (i.TotalHrafterStatus == 1)
                                {
                                    <li><label> <label for="checkbox-1-1"></label> Total hour calculated when After Shift Start </label> </li>
                                }
                                @if (i.TotalHrbeforeStatus == 1)
                                {
                                    <li><label> <label for="checkbox-1-1"></label> Total hour calculated when Before Shift End </label> </li>
                                }


                            </ul>
                        </div>
                    </div>

                </div>
            </div>

        </section>

    }
    <div class="footer">
        <a>www.mantratec.com</a>
    </div>

</body>
</html>
