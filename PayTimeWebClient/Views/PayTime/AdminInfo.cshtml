@model PayTimeWebClient.Models.ReqUpdateAdminInfo
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "AdminInfo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}

<link href="~/LandingAssets/css/smart_wizard.css" rel="stylesheet" type="text/css" />
<script type="text/javascript">
    $(document).ready(function () {
        $(".alert").hide();
        if ("@_Message" != "") {
            toastr.remove();
            toastr.success("@_Message");
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
        }
        $("#btncancelperinfo").click(function () {
            location.reload();
        });


        var id = @Session["UserId"]
        $.ajax({
            type: 'GET',
            async: false,
            url: "/PayTime/AdminInfoByID",
            data: { id: id },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (result) {
                if (result.isRedirect) {
                    window.location.href = result.redirectUrl;
                }
                var obj = JSON.parse(result);
                $("#Name").val(obj[0].Name);
                $("#Address").val(obj[0].Address);
                if (obj[0].MobileNo == 0) {
                    $("#MobileNo").val("");
                }
                else {
                    $("#MobileNo").val(obj[0].MobileNo);
                }
                if (obj[0].PhoneNo == 0) {
                    $("#PhoneNo").val("");
                }
                else {
                    $("#PhoneNo").val(obj[0].PhoneNo);
                }
               


                var empdob = moment(obj[0].DateOfBirth, "YYYY-MM-DDhh:mm:ss").format("YYYY-MM-DD");
                $("#DateOfBirth").val(empdob);
                $("#DateOfBirth").datepicker('setDate', new Date(empdob));

                $("#EmpAddress").text(obj[0].EmpAddress);
                var gender = obj[0].Gender;

                if (gender == 1) {
                    $("#GenderM").prop('checked', true);
                }
                if (gender == 0) {
                    $("#GenderF").prop('checked', true);
                }
                var married = obj[0].IsMarried;
                if (married == false) {
                    $("#Empsingle").prop('checked', true);
                }
                if (married == true) {
                    $("#EmpMarried").prop('checked', true);
                }
                $("#Photo").val(obj[0].Photo);
                $("#empimg").attr("src", "/AdminProfile/" + obj[0].Photo);

            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert("Something wrong. Please try again.");

            }
        });
        $("#PhoneNo").keypress(function (e) {
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
        });
        $("#PhoneNo").change(function () {
            if ($("#PhoneNo").val() != null) {
                if ($("#EmpPhNo").val().length > 10) {
                    return false;
                }
            }
        });

        $("#MobileNo").keypress(function (e) {
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
        });
        $("#MobileNo").change(function () {
            if ($("#EmpMNo").val().length > 10) {
                return false;
            }
        });


        $("#EmpPhotoFile").change(function () {

            var GetfileName = document.getElementById('EmpPhotoFile');
            var selectedfile = GetfileName.files[0].size;
            var filename = GetfileName.files[0].name;
            $("#EmpPhoto").val(filename);
            var validFileSize = 1000 * 1024;
            if (selectedfile > validFileSize) {
                alert('Select File Between 0 to 1 MB.');
                $(this).val("");
                return false;
            }
            var allowedFiles = [".bmp", ".png", ".jpg", ".jpeg"];
            var fileUpload = $("#EmpPhotoFile");
            var regex = new RegExp("([a-zA-Z0-9\s_\\.\-:])+(" + allowedFiles.join('|') + ")$");
            if (!regex.test(fileUpload.val().toLowerCase())) {
                alert("Please upload files having extensions:" + allowedFiles.join(', ') + " only.");
                $(this).val("");
                return false;
            }
        });


        $("#btnsubmit").click(function (event) {
            if ($("#Name").val() == "") {
                $("#Name").attr('required', true);
                $("#Name").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#Name").removeClass('field_error');
            }
            if ($("#DateOfBirth").val() == "") {
                $("#DateOfBirth").attr('required', true);
                $("#DateOfBirth").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#DateOfBirth").removeClass('field_error');
            }
            if ($("#MobileNo").val() == "") {
                $("#MobileNo").attr('required', true);
                $("#MobileNo").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#MobileNo").removeClass('field_error');
            }
            if ($("#MobileNo").val().length != 10) {
                $("#MobileNo").addClass('field_error');
                $("#spEmpMNo").html("required 10 digits, match requested format!").show();
                event.preventDefault();
                return false;

            }
            else {
                $("#MobileNo").removeClass('field_error');
                $("#spEmpMNo").hide();

            }
        });


    });
</script>

<!-- BEGIN PAGE BAR -->
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
        </li>
        <li>
            <span><i class="fa-light fa-angle-right"></i> Wizard</span>
        </li>
    </ul>
</div>
<!-- END PAGE BAR -->
<!-- END PAGE HEADER-->
<div>


    <div class="row">
        <div class="col-md-12">
            <div class="portlet box blue ">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="fa-light fa-gear"></i>Administrator Profile Setup
                    </div>
                    <div class="tools">
                    </div>
                </div>
                <div class="portlet-body form">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                        <div id="step-1" class="">
                                            <div class="col-md-12 ">
                                                @using (Html.BeginForm("AdminInfo", "PayTime", FormMethod.Post, new { @enctype = "multipart/form-data", @id = "form1" }))
                                                {
                                                    <div class="form-body">
                                                        <div class="row">
                                                            <div class="col-md-1">

                                                            </div>
                                                            <div class="col-md-5">
                                                                <div class="form-group" hidden>
                                                                    <input type="text" class="form-control" id="UserId" name="UserId" value="@Session["UserId"] " />
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="control-label">Name <span class="required" aria-required="true"> * </span> </label>
                                                                    <input type="text" id="Name" name="Name" class="form-control" />
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>Date of Birth <span class="required" aria-required="true"> * </span> </label>
                                                                    <div class="input-group  date date-picker" data-date-format="yyyy-mm-dd" data-date-viewmode="years" id="joindate">
                                                                        <span class="input-group-btn">
                                                                            <button class="btn default" type="button">
                                                                                <i class="fa-light fa-calendar-days"></i>
                                                                            </button>
                                                                        </span>
                                                                        <input type="text" class="form-control" id="DateOfBirth" data-date-format="yyyy-mm-dd" name="DateOfBirth" placeholder="yyyy-MM-dd">
                                                                    </div>
                                                                    <span class="help-block" style="color:red;" hidden id="spEmpDOBDate"></span>
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="control-label">Address</label>
                                                                    <textarea id="Address" name="Address" rows="4" class="form-control"></textarea>
                                                                </div>
                                                            


                                                            </div>
                                                            <div class="col-md-5">
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-12 row margin-bottom-10">Gender </label>
                                                                    <label class="mt-radio mt-radio-outline">
                                                                        Male
                                                                        <input value="1" name="Gender" id="GenderM" type="radio">
                                                                        <span></span>
                                                                    </label>
                                                                    <label class="mt-radio mt-radio-outline">
                                                                        Female
                                                                        <input value="0" name="Gender" id="GenderF" type="radio">
                                                                        <span></span>
                                                                    </label>
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-12 row margin-bottom-10">Marital Status </label>
                                                                    <label class="mt-radio mt-radio-outline">
                                                                        Single
                                                                        <input value="False" name="IsMarried" id="Empsingle" type="radio">
                                                                        <span></span>
                                                                    </label>
                                                                    <label class="mt-radio mt-radio-outline">
                                                                        Married
                                                                        <input value="True" name="IsMarried" id="EmpMarried" type="radio">
                                                                        <span></span>
                                                                    </label>
                                                                </div>
                                                                
                                                                <div class="form-group">
                                                                    <label>Mobile No <span class="required" aria-required="true"> * </span>  </label>
                                                                    <input type="text" multiple class="form-control" name="MobileNo" id="MobileNo" placeholder="Mobile No" maxlength="10">
                                                                    <span class="help-block" style="color:red;" hidden id="spPhono"></span>
                                                                </div>
                                                                <div class="form-group">
                                                                    <label>Phone No</label>
                                                                    <input type="text" multiple class="form-control" name="PhoneNo" id="PhoneNo" placeholder="Phone No" maxlength="10">
                                                                    <span class="help-block" style="color:red;" hidden id="spEmpMNo"></span>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-1" >
                                                                <div class="form-group" hidden>
                                                                    <div class="fileinput fileinput-new text-center" data-provides="fileinput">
                                                                        <div class="fileinput-new thumbnail  ">
                                                                            <img src="~/assets/images/avtar.png" alt="" id="empimg" />
                                                                        </div>
                                                                        <div class="fileinput-preview fileinput-exists thumbnail"> </div>
                                                                        <div>
                                                                            <span class="btn blue  btn btn-file">
                                                                                <span class="fileinput-new btn-block"> Select image </span>
                                                                                <span class="fileinput-exists"> Change </span>
                                                                                <input type="file" name="EmpPhotoFile" id="EmpPhotoFile" value="">
                                                                                <input type="hidden" id="Photo" name="Photo">
                                                                            </span>
                                                                            <a href="javascript:;" class="btn default fileinput-exists" data-dismiss="fileinput"> Remove </a>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-12">
                                                                <div class="text-right">
                                                                    <button type="button" class=" btn default" id="btncancelperinfo"> <i class="fa-solid fa-xmark"></i> Cancel</button>
                                                                    <button type="submit" class=" btn blue" id="btnsubmit"> <i class="fa-light fa-floppy-disk"></i> Save</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                }

                                            </div>
                                        </div>

                                    
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
