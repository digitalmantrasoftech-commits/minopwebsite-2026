@using PayTimeWebClient.Models;
@model CompanySetting
@{
    ViewBag.Title = "CompanySettingWizard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/LandingAssets/css/smart_wizard.css" rel="stylesheet" type="text/css" />
<script>
    $(document).ready(function () {

        // Step show event
        $("#smartwizard").on("showStep", function (e, anchorObject, stepNumber, stepDirection, stepPosition) {
            //alert("You are on step "+stepNumber+" now");
            if (stepPosition === 'first') {
                $("#prev-btn").addClass('disabled');
                $("#btnfin").hide();
            } else if (stepPosition === 'final') {
                $("#next-btn").addClass('disabled');
                $("#btnfin").show();
            } else {
                $("#btnfin").hide();
                $("#prev-btn").removeClass('disabled');
                $("#next-btn").removeClass('disabled');
            }
        });

        // Toolbar extra buttons
        var btnFinish = $('<button id="btnfin" style="display:none"></button>').text('Finish')
            .addClass('btn btn-info')
            .on('click', function () { alert('Finish Clicked'); });



        // Smart Wizard
        $('#smartwizard').smartWizard({
            selected: 0,
            theme: 'default',
            transitionEffect: 'fade',
            showStepURLhash: false,
            useURLhash: false,
            toolbarSettings: {
                toolbarPosition: 'bottom',
                toolbarExtraButtons: [btnFinish]
            }
        });



    });

</script>


<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="index.html"><i class="fa-regular fa-house"></i></a>
        </li>
        <li><span><i class="fa-light fa-angle-right"></i> Configuration Wizard</span></li>
    </ul>

</div>
<!-- END PAGE BAR -->
<!-- END PAGE HEADER-->
