@model PayTimeWebClient.Models.Templates
@{

    string _Message = string.Empty;
    string _error = string.Empty;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);

    if (_RoleId == 15)
    {
        ViewBag.Title = "TemplateAdd";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
        _Message = ViewBag.msg;
        _error = ViewBag.error;
    }
}
<script type="text/javascript">
    $(document).ready(function () {
        frmClear();
        $(".alert").hide();
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }
        $('#tbltemplates').DataTable({
            dom: _domCommon,
            language: _languageCommon,
        });
        setTimeout(function () {
            $("#" + "tbltemplates" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        $("#AddTemplates").on('click', function () {
            frmClear();
            $("#frmpopup").dialog("open");
        });
        $("#frmpopup").dialog({
            autoOpen: false,
            modal: true,
            resizable: false,
            title: 'PayTime Templates',
            width: "450px",
            show: {
                duration: "1000"
            },
            hide: {
                duration: "1000"
            }
        });
        $(".editclass").click(function () {
            $("#TemplateId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
            $("#TemplateName").val($(this).parent('td').parent('tr').children(1)[2].innerText);
            $("#TemplateDesc").val($(this).parent('td').parent('tr').children(1)[3].innerText);
            $("#frmpopup").dialog("open");
        });
        $("#tbltemplates").on('click', '.deleteclass', function () {
            var flg = 0;
            if (confirm("Are you sure for Delete this Entry?")) {
                $("#TemplateId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
                $.post("/PayTime/DeleteTemplate?id=" + $("#TemplateId").val(), function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var _response = $.parseJSON(response);
                    if (_response == "OK") {
                        var strid = "Col_" + $("#TemplateId").val().trim();
                        $("#" + strid + "").closest('tr').remove();
                        $('#tbltemplates').DataTable();
                    }
                    else {
                        alert("something wrong occures.");
                    }
                });
            }
        });
        $("#btnsubmit").click(function (event) {
            if ($("#TemplateName").val() == "") {
                $("#TemplateName").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#TemplateName").removeClass('field_error');
            }
            if ($("#TemplateDesc").val() == "") {
                $("#TemplateDesc").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#TemplateDesc").removeClass('field_error');
            }

        });

        function frmClear() {
            $("#TemplateId").val(0);
            $("#TemplateName").val("");
            $("#TemplateDesc").val("");
            $("#TemplateName").removeClass('field_error');
            $("#TemplateDesc").removeClass('field_error');
        }
    });
</script>

@if (_RoleId == 1 || _RoleId == 15)
{
    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> DashBoard</span>
            </li>
        </ul>
        <div>
            <div class="report_title">
                <p>Templates</p>
            </div>
            <div class="page-toolbar">
                <a href="javascript:void(0)" id="AddTemplates" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Add Template"><i class="fa-solid fa-plus"></i></a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="portlet">
                <div class="portlet-body">
                    <div class="table-responsive" id="tableResponsive">
                        <table id="tbltemplates" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column ">
                            <thead>
                                <tr>
                                    <th style="display:none;">Sr. No</th>
                                    <th hidden>Template ID</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th style="min-width: 65px;">Action</th>
                                </tr>
                            </thead>
                            @{int n = 1;}
                            <tbody>
                                @if (Model.TemplateList != null)
                                {
                                    foreach (var item in Model.TemplateList)
                                    {
                                        <tr>
                                            <td hidden>@n</td>
                                            <td hidden>@item.TemplateId</td>
                                            <td>@item.TemplateName</td>
                                            <td>@item.TemplateDesc</td>
                                            <td id="Col_@item.TemplateId">
                                                <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>
                                                <a class="deleteclass btn red_btnnew tooltips" data-placement="top" data-original-title="Delete"><i class="fa-regular fa-trash"></i></a>
                                            </td>
                                        </tr>
                                        n++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="frmpopup">
                        @using (Html.BeginForm("TemplateAdd", "PayTime"))
                        {
                            <fieldset>
                                <div class="col-md-8">
                                    <div class="form-group" hidden>
                                        <label>Template ID</label>
                                        <input type="text" class="form-control input-sm" name="CreatedBy" id="CreatedBy" value="@_UserId">
                                        <input type="text" class="form-control input-sm" name="ModifyBy" id="ModifyBy" value="@_UserId">
                                        <input type="text" class="form-control input-sm" name="TemplateId" id="TemplateId">
                                    </div>
                                    <div class="form-group">
                                        <label>Template Name <span class="required" aria-required="true"> * </span></label>
                                        <input type="text" class="form-control input-sm" name="TemplateName" id="TemplateName" placeholder="Enter Template Name" required="">
                                    </div>
                                    <div class="form-group">
                                        <label>Template Description <span class="required" aria-required="true"> * </span></label>
                                        @*<input type="text" class="form-control input-sm" name="TemplateDesc" id="TemplateDesc" placeholder="Enter Template Description" required="">*@
                                        <textarea class="form-control" rows="4" name="TemplateDesc" id="TemplateDesc" placeholder="Description"></textarea>
                                    </div>

                                </div>
                                <div class="form-group form-group col-md-10 text-right">
                                    <button type="submit" class=" btn btn-sm blue" id="btnsubmit"> <i class="fa-light fa-floppy-disk"></i> Save</button>
                                    <i style="padding:20px;"></i>
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>

        </div>

    </div>
}


else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}

