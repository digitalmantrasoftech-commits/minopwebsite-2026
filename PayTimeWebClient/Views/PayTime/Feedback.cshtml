@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
}

@section metatags{
    <title>Feedback</title>
    <meta name="keywords" content="Cloud based real time time and Attendance management">
    <meta name="description" content="Minop specialise in the design and developing of cloud-based time and attendance software systems which give you real-time access to your employees’ attendance records.">
    <link id="canonical" rel="canonical" href="https://www.minopcloud.com/Feedback" />
}

@section individual_css{

}

@section individual_header_js{
    <script>
        $(function () {
            $('.mn_company').addClass('current');
            $('.mn_about_us').addClass('current');
        });
    </script>
}

<!--Page Title-->
<section class="page-title" style="background-image: url(../images/background/8.jpg); ">
    <div class="auto-container">
        <div class="inner-container clearfix">
            <h1 style="display:none;">Feedback</h1>
            <ul class="bread-crumb clearfix">
                <li><a href="@Url.Content("/")">Home</a></li>
                <li>Feedback</li>
            </ul>
        </div>
    </div>
</section>
<!--End Page Title-->
<!-- Services Section Two -->
<section class="services-section-two style-two">
    <div class="auto-container">
        <div class="form-column col-lg-6 col-md-12 col-sm-12">
            <div class="contact-form-two">
                <div class="title">
                    <h3>Send a Message</h3>
                    <div class="text">If you want to ask anything just fill in the form below and send us.</div>
                </div>
                <form method="POST" action="@Url.Content("/paytime/Inquiry")" class="form panel-body" role="form" id="inqform">
                    <div class="row clearfix">
                        <div class="col-lg-6 col-md-6 col-sm-12 form-group">
                            <input type="text" name="name" placeholder="Full Name" required="" maxlength="50">
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12 form-group">
                            <input type="email" name="email" placeholder="Email" required="" maxlength="100">
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12 form-group">
                            <input type="text" name="MobileNo" id="MobileNo" placeholder="Phone" required="" maxlength="10">
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12 form-group">
                            <input type="text" name="subject" placeholder="Subject" required="" maxlength="100">
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                            <textarea class="mess_text_contect" name="message" placeholder="Your Message..." maxlength="150"></textarea>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                            @Html.Captcha("Refresh", "<label>Please enter Captcha<span>*</span></label>", 4, "The Captcha is required", true)
                            <p style="color: red;">  @ViewBag.ErrMessage </p>
                            <p style="color: red;" id="CaptchReq">Captcha is required.</p>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12">
                            <span class="help-block" style="color:green;" id="Inquiryspvalidation"></span>
                            <span class="help-block" style="color:red;" id="InquiryspvalidationErr"></span>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                            <button class="btn_contact_submit" type="submit" value="send message" name="submit-form">Submit</button>
                        </div>
                    </div>
                </form>
                <!-- Form Column -->
            </div>
        </div>
    </div>
</section>
<!--End Services Section Two -->
<!-- Call To Action -->
<section class="call-to-action-two">
    <div class="icon-layer wow zoomIn" data-wow-delay="400ms"></div>
    <div class="auto-container clearfix">
        <div class="title-column">
            <div class="inner">
                <span class="icon pe-7s-global"></span>
                <h3>Helping clients to unlock & unleash the power within their large scale Business</h3>
            </div>
        </div>
        <div class="btn-column">
            <div class="btn-box">
                <a href="@Url.Content("/Contact-Us")" class=" theme-btn inquiry_now_btn"><i class="fa fa-chart-line"></i>Inquiry Now</a>
            </div>
        </div>
    </div>
</section>
<!--End Call To Action -->
@section individual_footer_js{

}
