@{

    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    if (_RoleId == 15)
    {
        ViewBag.Title = "ActiveCompany";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
    }
}
<script type="text/javascript">
    $(document).ready(function () {
        $('#tblsuperAdmin').DataTable();
    });
</script>

@if (_RoleId == 15)
{

    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa fa-home"></i></a>
            </li>
            <li>
                <span><i class="fa fa-angle-right"></i> DashBoard</span>
            </li>
        </ul>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="portlet light portlet-fit bordered">
                <div class="portlet-title">
                    <div class="caption">
                        <i class=" icon-layers font-dark"></i>Currently Active Companies
                    </div>

                </div>
                <div class="portlet-body">
                    <div style="width:100%;margin-left:auto;margin-right:auto;">


                        <table id="tblsuperAdmin" class="table table-striped table-bordered table-hover table-checkable order-column ">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th hidden>UserId</th>
                                    <th>Email</th>
                                    <th hidden>CompanyId</th>
                                    <th hidden>CompanyCode</th>
                                    <th>CompanyName</th>
                                    <th hidden>DbType</th>
                                    <th>CompanyDbName</th>
                                    <th hidden>IsActiveRegCom</th>
                                    <th hidden>IsActiveUser</th>
                                    <th hidden>CompanyPlanId</th>
                                    <th>PlanStartDate</th>
                                    <th>PlanEndDate</th>
                                    <th hidden>IsActivePlan</th>
                                    <th hidden>PlanName</th>
                                    <th hidden>PlanDuration</th>
                                    <th>PlanPrice</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
    int n = 1;
                                }
                                @if (Model.SuperAdminDetailslist != null)
                                {
                                    foreach (var i in Model.SuperAdminDetailslist)
                                    {
                                        <tr>
                                            <td id="sr">@n</td>
                                            <td hidden> @i.UserId </td>
                                            <td>@i.Email</td>
                                            <td hidden>@i.CompanyId</td>
                                            <td hidden>@i.CompanyCode</td>
                                            <td>@i.CompanyName</td>
                                            <td hidden>@i.DbType</td>
                                            <td>@i.CompanyDbName</td>
                                            <td hidden>@i.IsActiveRegCom</td>
                                            <td hidden>@i.IsActiveUser</td>
                                            <td hidden>@i.CompanyPlanId</td>
                                            <td>@i.PlanStartDate</td>
                                            <td>@i.PlanEndDate</td>
                                            <td hidden>@i.IsActivePlan</td>
                                            <td hidden>@i.PlanName</td>
                                            <td hidden>@i.PlanDuration</td>
                                            <td>@i.PlanPrice</td>
                                        </tr>
                                        n++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}

