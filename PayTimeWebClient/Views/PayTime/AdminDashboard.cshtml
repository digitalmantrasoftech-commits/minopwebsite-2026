        function SaveKycdetails() {
            $("#spKycvalidation").text('');
            if ($("#KycMobileno").val() == "") {
                $("#spKycvalidation").text("enter mobile no");
                return false;
            }
            //if ($("#KycMobileno").val().length != 10) {
            //    $("#spKycvalidation").text("enter mobile 10 digits");
            //    return false;
            //}
            if ($("#KycAddress").val() == "") {
                $("#spKycvalidation").text("enter Kyc Address");
                return false;
            }
            if ($("#Pincode").val() == "") {
                $("#spKycvalidation").text("Enter pincode");
                return false;
            }
            //if ($("#KycAddress").val().length < 10) {
            //    $("#spKycvalidation").text("enter Kyc Address minimum 10 digits");
            //    return false;
            //}

            var obj = {
                CmpID: '@_companyid',
                CompanyID: $('#KycCompanyID').text(),
                KycMobileno: $("#KycMobileno").val(),
                Kycaddress: $("#KycAddress").val(),
                CountryCode: $("#CountryCode").val(),
                Pincode: $("#Pincode").val()
            }
            $.ajax({
                type: "GET",
                url: "@_webapiurl" + "DashBoard/UpdateKycDetails",
                data: obj,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function (xhr) {
                    loadingAjax('ajax_loaderallemp');
                },
                success: function (data) {
                    if (data = "Ok") {
                        $("#spKycvalidation").text('Updated kycdetails successfully.');
