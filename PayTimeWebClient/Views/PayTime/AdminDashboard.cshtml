                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    $('#ajax_loaderAtwork').hide();
                    $("#atworkcounter").html(data[0].Rescnt);

                    var vatwrk = data[0].Rescnt;
                    var series = new Array();
                    series.push(vatwrk, vallemp);
                    if (series[1] > 0) {
                        $("#empemptydata").hide();
                        $("#EmpAtworkChart").show();
