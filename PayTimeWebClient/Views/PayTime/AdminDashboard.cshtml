        function FillEmployeeLeaveChart(cmpId, branchId) {
            var d = new Date();
            var day = d.getDate();
            var month = d.getMonth() + 1;
            var year = d.getFullYear();
            if (day < 10) {
                day = "0" + day;
            }
            if (month < 10) {
                month = "0" + month;
            }
            var leavedate = year + "-" + month + "-" + day;
            $.ajax({
                type: "GET",
                url: "/PayTime/FillLeaveChart",
                data: { leavedate: leavedate, cmpId: cmpId, branchId: branchId },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    var objser = JSON.parse(data);
                    var serie = new Array();
                    serie.push(['Today', objser[0].Today_LCount]);
                    serie.push(['Tomorrow', objser[0].Tomorrow_LCount]);
                    serie.push(['Next 7 Days', objser[0].SevenDay_LCount]);
                    //serie.push(['Today', 3.0]);
                    //serie.push(['Tomorrow', 1.0]);
                    //serie.push(['Next 7 Days', 1.0]);
                    if (objser[0].Today_LCount == 0 && objser[0].Tomorrow_LCount == 0 && objser[0].SevenDay_LCount == 0) {
                        $("#emptyleavedata").show();
                        $("#containerleave").hide();

                    }
                    else {
                        $("#emptyleavedata").hide();
                        $("#containerleave").show();
                        EmployeeOnLeave(serie);
                    }
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                  

                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                },
            });
        }

        function requestData() {

            $.ajax({
                url: '@_webapiurl' + 'DashBoard/AdminLiveAttendance?cmpId=@_companyid&brid=0&roleid=@_RoleId',
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                success: function (point) {
                    if (point[0].attendance != "0") {
                        $("#liveemptydata").hide();
                        $("#containerLivePunch").show();
                        var series = chart.series[0],
                            shift = series.data.length > 20; // shift if the series is longer than 20
                        // add the point
                        chart.series[0].addPoint([(new Date()).getTime(), parseInt(point[0].attendance)], true, shift);
                        // call it again after one second
                        setTimeout(requestData, 1000);

                        if (LivePunchValue !== parseInt(point[0].attendance)) {
                            //alert("Refresh dashboard");
                            TimePieChartAjax();
                            FillAttendanceChart();
                            //Fillallcnt();
                            LivePunchValue = parseInt(point[0].attendance)
                        }
                    } else {
                        $("#containerLivePunch").hide();
                        $("#liveemptydata").show();
                    }
                },
                cache: false
            });
        }
        function TimePieChartAjax() {
            $.ajax({
                url: '@_webapiurl' + 'DashBoard/AdminTimePieChartPunch?cmpId=@_companyid',
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                success: function (data) {

                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    var Isdata = false;
                    var series = new Array();
                    for (var i = 0; i < data.length; i++) {
                        if (data[i].PunchCount > 0) {
                            Isdata = true;
                        }
                        series.push([data[i].TimeRange, data[i].PunchCount]);
                    }

                    if (Isdata) {
                        $("#TimePieemptydata").hide();
                        $("#containerTimePie").show();
                        TimePieChart(series);
                    }
                    else {
                        $("#containerTimePie").show();
                        $("#TimePieemptydata").hide();
                    }
                },
                cache: false
            });
        };
        function TimePieChart(series) {
            Highcharts.chart('containerTimePie', {
                chart: {
                    type: 'pie',
                    options3d: {
                        enabled: true,
                        alpha: 45
                    }
                },
                title: {
                    text: "Today's Punch time wise"
                },
                plotOptions: {
                    pie: {
                        innerSize: 100,
                        depth: 45
                    }
                },
                series: [{
                    name: 'Punches',
                    data: series
                }]
            });
        }

