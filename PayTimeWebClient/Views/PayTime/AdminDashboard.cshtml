        function FillAttendanceChart() {
            $.ajax({
                type: "GET",
                url: "/PayTime/FillChartAdminDashboard",
                data: { fromdate: FirstDayWithSlashes, todate: lastDayWithSlashes, statusflg: 1, finalStatus: "", cmpId: cmpId, branchId: branchId },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    var objser = JSON.parse(data);
                    var series = new Array();
                    for (var i in objser) {
                        var serie = new Array(objser[i].FinalStatus, objser[i].CountStatus);
                        series.push(serie);
                    }
                    if (series.length > 0) {
                        $("#emptydata").hide();
                        $("#containerAdmin").show();
                        var ss = FirstDayWithSlashes.toString('@_isdateformat');
                        var _FirstDayWithSlashes = FirstDayWithSlashes;
                        var date = new Date(FirstDayWithSlashes);
                        if ("@_isdateformat" == "yyyy-mm-dd") {
                            var month = date.getMonth() + 1;
                            var day = date.getDate();
                            _FirstDayWithSlashes = date.getFullYear() + "-" + (month.toString().length > 1 ? month : "0" + month) + "-" + (day.toString().length > 1 ? day : "0" + day);
                        }
                        else if ("@_isdateformat" == "dd-mm-yyyy") {

                            var month = date.getMonth() + 1;
                            var day = date.getDate();
                            _FirstDayWithSlashes = (day.toString().length > 1 ? day : "0" + day) + "-" + (month.toString().length > 1 ? month : "0" + month) + "-" + date.getFullYear();
                        }
                        else if ("@_isdateformat" == "mm-dd-yyyy") {

                            var month = date.getMonth() + 1;
                            var day = date.getDate();
                            _FirstDayWithSlashes = (month.toString().length > 1 ? month : "0" + month) + "-" + (day.toString().length > 1 ? day : "0" + day) + "-" + date.getFullYear();
                        }
                        else if ("@_isdateformat" == "dd-M-yyyy") {

                            var locale = "en-us";
                            month = date.toLocaleString(locale, { month: "short" });
                            var day = date.getDate();
                            _FirstDayWithSlashes = (day.toString().length > 1 ? day : "0" + day) + "-" + (month.toString().length > 1 ? month : "0" + month) + "-" + date.getFullYear();
                        }
                        else if ("@_isdateformat" == "M-dd-yyyy") {

                            var locale = "en-us";
                            month = date.toLocaleString(locale, { month: "short" });
                            var day = date.getDate();
                            _FirstDayWithSlashes = (month.toString().length > 1 ? month : "0" + month) + "-" + (day.toString().length > 1 ? day : "0" + day) + "-" + date.getFullYear();
                        }
                        else if ("@_isdateformat" == "yyyy-M-dd") {
                            var locale = "en-us";
                            month = date.toLocaleString(locale, { month: "short" });
                            var day = date.getDate();
                            _FirstDayWithSlashes = date.getFullYear() + "-" + (month.toString().length > 1 ? month : "0" + month) + "-" + (day.toString().length > 1 ? day : "0" + day);
                        }

                        AdminPiachart(series, FirstDayWithSlashes, lastDayWithSlashes, cmpId, branchId, _FirstDayWithSlashes);
                        //AdminPiachart(series, FirstDayWithSlashes, lastDayWithSlashes, cmpId, branchId);
                    }
                    else {
                        $("#containerAdmin").hide();
                        $("#emptydata").show();
                    }
                    //Filltopten();
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    

                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                },
            });
        }

