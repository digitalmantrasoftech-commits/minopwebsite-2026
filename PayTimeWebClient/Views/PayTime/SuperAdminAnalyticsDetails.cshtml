@model PayTimeWebClient.Models.AnalyticsDashboardDetails
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "SuperAdminAnalyticsDetails";
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    if (_RoleId == 15)
    {
        ViewBag.Title = "SuperAdminAnalyticsDetails";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
    }
}
<script src="~/Scripts/toastr.min.js"></script>
<link href="~/Content/toastr.min.css" rel="stylesheet" />
<script type="text/javascript">
    $(document).ready(function () {
        $("#quick-search-switcher").show();
        $('#tblsuperAdminAnalyticsdata').DataTable({
            //dom: 'lBfrtip',
            dom: _domCommon,
            language: _languageCommon,
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: 'Excel',
                    titleAttr: 'Excel',
                    title: 'Super Admin AnalyticsDetails',
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6]
                    }
                }
            ]
        });
        setTimeout(function () {
            $("#" + "tblsuperAdminAnalyticsdata" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        var url = window.location.href;
        var urlsplit = url.split("=");
        var urlspl = urlsplit[1];
        if (urlspl != null && urlspl != "" && urlspl != undefined)
        {
            const Titles = urlspl.replace(/%20/g, " ");
            $("#Titles").val(Titles);
        }
        else {
            $("#quick-search-switcher").hide();
        }
        $("#quick-search-switcher").click(function () {
            $("#quick-search").toggleClass("quick-search-visible");
            var today = new Date();
            $('#frmdate').datepicker({
                format: 'yyyy-mm-dd',
                autoclose: true,
                endDate: "today",
                maxDate: today
            }).on('changeDate', function (ev) {
                $(this).datepicker('hide');
            });
            $('#todate').datepicker({
                format: 'yyyy-mm-dd',
                autoclose: true,
                endDate: "today",
                maxDate: today
            }).on('changeDate', function (ev) {
                $(this).datepicker('hide');
            });
        });
        $("#btnsearch").click(function (event) {
            search(event)
        });
        function search(event) {
            var datefrom = $("#frmdate").val();
            var todate = $("#todate").val();
            if (datefrom > todate) {
                toastr.remove();
                toastr.error("To date should be greater than from date.");
                event.preventDefault();
                return false;
            }
        }
    });
</script>
@if (_RoleId == 15)
{

    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa fa-home"></i></a>
            </li>
            <li>
                <span><i class="fa fa-angle-right"></i> Analytics Details</span>
            </li>
        </ul>
        <div class="poll-right quick_search">
            <button id="quick-search-switcher" data-placement="bottom" class="tooltips" type="button"><i class="fa fa-search"></i></button>
        </div>
    </div>
    <div class="row">
        <div class="loader" id="myLoader" style="display:none">Loading...</div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            @using (Html.BeginForm("SuperAdminAnalyticsDetails", "PayTime", FormMethod.Post, new { @class = "quick-search admin_search", id = "quick-search" }))
            {
                <fieldset>
                    <div class="row">
                        <input type="hidden" id="Titles" name="Titles" />

                        <div class="col-lg-3 col-md-3 col-sm-6  margin-top-20">
                            <label> From Date:</label>
                            <div class="input-group  input-group-sm  date date-picker" data-date="@DateTime.Now" data-date-format="yyyy-mm-dd" data-date-viewmode="years" id="srchfromdt">
                                <span class="input-group-btn">
                                    <button class="btn default" type="button" disabled>
                                        <i class="fa fa-calendar"></i>
                                    </button>
                                </span>
                                <input type="text" placeholder="yyyy-mm-dd" class="form-control" id="frmdate" name="frmdate" autocomplete="off">

                            </div>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-6  margin-top-20">
                            <label> To Date:</label>
                            <div class="input-group  input-group-sm  date date-picker" data-date="@DateTime.Now" data-date-format="yyyy-mm-dd" data-date-viewmode="years" id="srchtodt">
                                <span class="input-group-btn">
                                    <button class="btn default" type="button" disabled>
                                        <i class="fa fa-calendar"></i>
                                    </button>
                                </span>
                                <input type="text" placeholder="yyyy-mm-dd" class="form-control" id="todate" name="todate" autocomplete="off">
                            </div>

                        </div>

                        <div class="col-lg-1 col-md-2 col-sm-6">
                            <button type="submit" class="btn-block" id="btnsearch" title="Search by filters">
                                <i class="fa fa-fw fa-search"></i>
                                <span class="ladda-spinner"></span><div class="ladda-progress" style="width: 0px;"></div>
                            </button>
                        </div>
                    </div>
                </fieldset>
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="portlet light portlet-fit bordered">
                <div class="portlet-title">
                    <div class="caption">
                        <i class=" icon-layers font-dark"></i>Analytics Details
                    </div>

                </div>
                <div class="portlet-body">
                    <div style="width:100%;margin-left:auto;margin-right:auto;">
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tblsuperAdminAnalyticsdata" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column ">
                                <thead>
                                    <tr>
                                        <th>No</th>
                                        <th>Title</th>
                                        <th>Clicks</th>
                                        <th>Time Duration</th>
                                        <th>User</th>
                                        <th>Operation</th>
                                        <th>Created Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int n = 1;
                                    }
                                    @if (Model.AnalyticsDashboardDetailslist != null)
                                    {
                                        foreach (var i in Model.AnalyticsDashboardDetailslist)
                                        {
                                            <tr>
                                                <td id="sr">@n</td>
                                                <td>@i.Titles</td>
                                                <td>@i.NoOfClick</td>
                                                <td>@i.TimeSpent</td>
                                                <td>@i.Usr</td>
                                                <td>@i.SubOperation</td>
                                                <td>@i.Createddate</td>
                                            </tr>
                                            n++;
                                        }
                                    }

                                </tbody>

                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}
<style>
    .poll-right.quick_search button {
        background: #2196f3;
        border: #2196f3;
        height: 30px;
        width: 35px;
        color: #fff;
        border-radius: 4px !important;
        margin-top: 6px;
        float: right;
    }

    .quick-search {
        background: #fff none repeat scroll 0 0;
        margin-bottom: 30px;
        border-radius: 10px;
        box-shadow: 0 2px 18px 1px rgb(49 53 72 / 10%);
        padding: 5px 15px;
        margin: -190px 0 0;
    }

    .quick-search {
        position: relative;
        z-index: 100;
    }

    .quick-search-visible {
        margin: 0 0 30px;
    }

    .form-group {
        position: relative;
    }

    .page-content-white .page-content .page-bar {
        border-bottom: none;
    }

    button#btnsearch {
        background: #2196f3 !important;
    }

    button#btnsearch {
        border: none !important;
    }

    button#btnsearch {
        position: relative;
        display: inline-block;
        font-size: 16px;
        line-height: 10px;
        color: #fff;
        padding: 10px 30px;
        font-weight: 600;
        overflow: hidden;
        border-radius: 7px !important;
    }

    #quick-search.admin_search button#btnsearch[type=button], #quick-search.admin_search button#btnsearch[type=submit] {
        width: auto;
        margin-top: 41px;
    }
</style>

