@model PayTimeWebClient.Models.HrpolicyAudit
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>HR Policy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <link href="~/PDFContent/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/PDFContent/css/responsive.css" rel="stylesheet" type="text/css" />
    <link href="~/Newlayout/css/samplepolicy.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif !important;
            font-weight: 400;
            letter-spacing: 0.2px;
        }
    </style>
</head>


<body id="myPage" data-spy="scroll" data-target=".navbar" data-offset="60">
    <div class="header_section">
        <a class="logo_mivanta" href="javascript:void(0)">
            <img src="~/PDFContent/img/logo.png">
        </a>
        <div class="header_img_box">
            <img src="~/Newlayout/images/hrpolicy.png" class="img-fluid">
        </div>
    </div>
    @foreach (var i in ViewBag.policydata as IEnumerable<HrpolicyAudit>)
    {

        <section class="back_blue">
            <h1 class="pname"><b>Policy :</b><span> @i.LPolicyName</span></h1>
            <div class="container">
                <div class="row">
                    <div class="col-md-6 col-sm-12">
                        <div class="panel panel-primary">
                            <div class="panel-heading"><img src="/Newlayout/images/employee.svg"> Employeement Rules </div>
                            <div class="panel-body">
                                <ul>
                                    <li>
                                        First Week Off :
                                        @if (i.LEmpWeekOff == 0)
                                        {
                                            <span>None</span>
                                        }
                                        else if (i.LEmpWeekOff == 1)
                                        {
                                            <span>Sunday</span>
                                        }
                                        else if (i.LEmpWeekOff == 2)
                                        {
                                            <span>Monday</span>
                                        }
                                        else if (i.LEmpWeekOff == 3)
                                        {
                                            <span>Tuesday</span>
                                        }
                                        else if (i.LEmpWeekOff == 4)
                                        {
                                            <span>Wednesday</span>
                                        }
                                        else if (i.LEmpWeekOff == 5)
                                        {
                                            <span>Thursday</span>
                                        }
                                        else if (i.LEmpWeekOff == 6)
                                        {
                                            <span>Friday</span>
                                        }
                                        else if (i.LEmpWeekOff == 7)
                                        {
                                            <span>Saturday</span>
                                        }
                                    </li>
                                    <li>
                                        Second Week off :
                                        @if (i.LEmpSecondWeekOff == 0)
                                        {
                                            <span>None</span>
                                        }
                                        else if (i.LEmpSecondWeekOff == 1)
                                        {
                                            <span>Sunday</span>
                                        }
                                        else if (i.LEmpSecondWeekOff == 2)
                                        {
                                            <span>Monday</span>
                                        }
                                        else if (i.LEmpSecondWeekOff == 3)
                                        {
                                            <span>Tuesday</span>
                                        }
                                        else if (i.LEmpSecondWeekOff == 4)
                                        {
                                            <span>Wednesday</span>
                                        }
                                        else if (i.LEmpSecondWeekOff == 5)
                                        {
                                            <span>Thursday</span>
                                        }
                                        else if (i.LEmpSecondWeekOff == 6)
                                        {
                                            <span>Friday</span>
                                        }
                                        else if (i.LEmpSecondWeekOff == 7)
                                        {
                                            <span>Saturday</span>
                                        }
                                    </li>
                                    <li>
                                        Half Day Off :
                                        @if (i.LEmpHalfDay == 0)
                                        {
                                            <span>None</span>
                                        }
                                        else if (i.LEmpHalfDay == 1)
                                        {
                                            <span>Sunday</span>
                                        }
                                        else if (i.LEmpHalfDay == 2)
                                        {
                                            <span>Monday</span>
                                        }
                                        else if (i.LEmpHalfDay == 3)
                                        {
                                            <span>Tuesday</span>
                                        }
                                        else if (i.LEmpHalfDay == 4)
                                        {
                                            <span>Wednesday</span>
                                        }
                                        else if (i.LEmpHalfDay == 5)
                                        {
                                            <span>Thursday</span>
                                        }
                                        else if (i.LEmpHalfDay == 6)
                                        {
                                            <span>Friday</span>
                                        }
                                        else if (i.LEmpHalfDay == 7)
                                        {
                                            <span>Saturday</span>
                                        }
                                    </li>
                                    <li>
                                        Allow OverTime :
                                        @if (i.LEmpAllowOT == 0)
                                        {
                                            <span>No</span>
                                        }
                                        else if (i.LEmpAllowOT == 1)
                                        {
                                            <span>Yes</span>
                                        }
                                    </li>

                                    <li>
                                        Second Week Off Rule :

                                        @{
        if (i.LEmpSecondWeekOffRule == "0" || i.LEmpSecondWeekOffRule == null)
        {
            <span>None</span>
        }
        else
        {
            string str = i.LEmpSecondWeekOffRule;
            var lat = str.Split(',');

            for (var j = 0; j < lat.Length; j++)
            {
                if (lat[j] == "1")
                {
                    <span>First</span>
                }
                if (lat[j] == "2")
                {
                    <span>Second</span>
                }
                if (lat[j] == "3")
                {
                    <span>Third</span>
                }
                if (lat[j] == "4")
                {

                    <span>Fourth</span>
                }
                if (lat[j] == "5")
                {
                    <span>Fifth</span>
                }
            }
        }


                                        }
                                    </li>
                                    <li>
                                        HalfDay Rule :
                                        @{
        if (i.LEmpHalfDayRule == "0" || i.LEmpHalfDayRule == null)
        {
            <span>None</span>
        }
        else
        {
            string strHalf = i.LEmpHalfDayRule;
            var latHalf = strHalf.Split(',');

            for (var j = 0; j < latHalf.Length; j++)
            {
                if (latHalf[j] == "1")
                {
                    <span>First</span>
                }
                if (latHalf[j] == "2")
                {
                    <span>Second</span>
                }
                if (latHalf[j] == "3")
                {
                    <span>Third</span>
                }
                if (latHalf[j] == "4")
                {

                    <span>Fourth</span>
                }
                if (latHalf[j] == "5")
                {
                    <span>Fifth</span>
                }
            }
        }
                                        }

                                    </li>
                                </ul>
                            </div>

                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="panel panel-primary">
                            <div class="panel-heading"><img src="/Newlayout/images/calculator.svg"> Formula of Shift Calculation</div>
                            <div class="panel-body">
                                <ul>
                                    <li>OUT Punch accepted within :<span>@i.LMaxOutDur</span>Hrs.</li>
                                    <li>Grace Time For Late IN  :<span>@i.LGraceLateIN</span> Minutes</li>
                                    <li>Application Mode :<span>Auto</span></li>
                                    <li>Time Duration between two punches :<span> @i.LTimeBetPunch</span> Minutes</li>
                                    <li>Grace Time For Early OUT  :<span> @i.LGraceEarlyOUT</span> Minutes</li>
                                    <li>Start Day of the Monthly Report :<span>  @i.LMonthlyRptStaDay</span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="overtime_formula">
                <div class="container">
                    <div class="row">
                        <div class="col-md-12 ">
                            <div class="panel panel-primary">
                                <div class="title">Overtime Calculation Formula</div>
                                <div class="">
                                    @if (i.LOTFormula == 1)
                                    {
                                        <center><h4><label><b><u> Working Hrs - Shift Hrs</u></b></label></h4></center>
                                    }
                                    @if (i.LOTFormula == 2)
                                    {
                                        <center><h4><label><b><u> Working Hrs - Present Hrs</u></b></label></h4></center>
                                    }
                                    @if (i.LOTFormula == 3)
                                    {
                                        <center><h4><label><b><u>After Shift - End Time</u></b></label></h4></center>
                                    }
                                    @if (i.LOTFormula == 4)
                                    {
                                        <center><h4 class="shift_title"><label><b><u>Before Shift - Start Time</u></b></label></h4></center>
                                    }

                                    <ul class="no_style ">
                                        <li><label><label for="checkbox-1-1"></label>  Minimum Hour for OverTime Start  :   <span>  @i.LOTMinHour  </span>  Minutes </label></li>

                                        <li><label> <label for="checkbox-1-1"></label> Weekly off hour Calculated as OverTime Hour :  <span>    @i.LWeekOffOTHour  </span>  Minutes </label></li>

                                        <li><label> <label for="checkbox-1-1"></label> Holiday off hour Calculated as OverTime Hour :  <span>   @i.LHolidayOffOTHour  </span>  Minutes </label></li>

                                        <li><label> <label for="checkbox-1-1"></label> Calculated As absent for Weekly Off & Holiday Off if Employee not Present for Whole Month</label></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="Sandwhichrule">
                <div class="container">
                    <div class="row">
                        <div class="col-md-12 ">
                            <div class="panel panel-primary">
                                <div class="title">Sandwhichrule</div>
                                <div class="">
                                    <ul class="no_style">
                                        @if (i.LIssedwrule == 1)
                                        {
                                            <li><label> <label for="checkbox-1-1"></label> Sandwich rule applied </label> </li>
                                        }
                                    </ul>
                                    <ul class="no_style">
                                        @if (i.LIssedwruleType == 1)
                                        {
                                            <li><label><label for="checkbox-1-1"></label> Week off or Holiday absent if prefix And suffix day absent</label> </li>
                                        }
                                        @if (i.LIssedwruleType == 2)
                                        {
                                            <li><label><label for="checkbox-1-1"></label>  Week off or Holiday absent if prefix Or suffix day absent</label> </li>
                                        }
                                        @if (i.LIssedwruleType == 3)
                                        {
                                            <li><label><label for="checkbox-1-1"></label>  Week off or Holiday absent if prefix day absent</label> </li>
                                        }
                                        @if (i.LIssedwruleType == 4)
                                        {
                                            <li><label><label for="checkbox-1-1"></label> Week off or Holiday absent if suffix day absent</label> </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-md-12 col-sm-12">
                        <div class="panel-primary">
                            <div class="title">Attendance Rule</div>
                            <ul class="no_style">
                                @if (i.LAllErrorCase == 1)
                                {
                                    <li><label> <label for="checkbox-1-1"></label>Calculate present in Any Error Case </label> </li>
                                }
                                else
                                {
                                    <li><label> <label for="checkbox-1-1"></label> Calculate Half Day when Error case</label> </li>
                                }
                            </ul>

                            <ul class="no_style">
                                @if (i.LHdLate != 0)
                                {
                                    <li><label><label for="checkbox-1-1"></label> Calculate Half Day if Late Count Greater or equal @i.LHdLate</label> </li>
                                }
                                @if (i.LHdEd != 0)
                                {
                                    <li><label><label for="checkbox-1-1"></label> Calculate Half Day if Early Departure Count Greater or equal @i.LHdEd</label> </li>
                                }
                                @if (i.LHdLateorEd != 0)
                                {
                                    <li><label><label for="checkbox-1-1"></label> Calculate Half Day if Late or Early Departure Count Greater or equal  @i.LHdLateorEd</label> </li>
                                }
                                @if (i.LALate != 0)
                                {
                                    <li><label><label for="checkbox-1-1"></label> Calculate Absent if Late Count Greater or equal @i.LALate</label> </li>
                                }
                                @if (i.LAED != 0)
                                {
                                    <li><label> <label for="checkbox-1-1"></label> Calculate Absent if Early Departure Count Greater or equal @i.LAED</label> </li>
                                }
                                @if (i.LALateorED != 0)
                                {
                                    <li><label><label for="checkbox-1-1"></label> Calculate Absent if Late or Early Departure Count Greater or equal  @i.LALateorED</label> </li>
                                }
                            </ul>


                            <ul class="no_style">
                                @if (i.LTotalHrafterStatus == 1)
                                {
                                    <li><label> <label for="checkbox-1-1"></label> Total hour calculated when After Shift Start </label> </li>
                                }
                                @if (i.LTotalHrbeforeStatus == 1)
                                {
                                    <li><label> <label for="checkbox-1-1"></label> Total hour calculated when Before Shift End </label> </li>
                                }


                            </ul>
                        </div>
                    </div>

                </div>
            </div>

        </section>

    }
    <div class="footer">
        <a href="https://www.mantratec.com" target="_blank">www.mantratec.com</a>
    </div>

</body>
</html>
