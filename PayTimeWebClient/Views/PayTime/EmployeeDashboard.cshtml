    <script src="https://cdnjs.cloudflare.com/ajax/libs/intro.js/6.0.0/intro.min.js"></script>
    <script>


        var uniqueid = '@empid';
        var Tourflag = '@hasTourCompletes';
        var UserId = '@UserId';
        var hasTourCompletedLocally = sessionStorage.getItem('hasTourCompleted_' + uniqueid + '_' + UserId);



        function startTour() {
            Tourflag == 0;
            introJs().setOptions({

                steps: [
                    {
                        title: "<img class='margin-bottom-5' src='/AssetsNew/images/logo.png' height='20' width='100' > 🎉 What’s New!",
                        intro: "<div class='wel_icon text-center'><img src='/assets/images/icon_startup.png' height='249' width='268'></div>"
                        //intro: "<div class='wel_icon text-center'><p class='startup'><span>Moments :</span> Celebrate key milestones! 🎂 🎉</P><p class='startup'><span>Attendance Wizard :</span> Streamlined attendance management. 🗓️ ✏ ✈️ 👁</P><p class='startup'><span>Attendance Clearance :</span> Manage leave and corrections easily. 🏖️ 💻 ✅ ❌</P></div>Explore these updates! 👉"
                    },
                    {
                        title: "Moments",
                        element: document.querySelector('#EventBtn'),
                        intro: "<div class='wel_icon text-center'><img src='/assets/images/icon_moments.png' height='153' width='268' ><p class='header'>Engage. Celebrate. Repeat.</P></div>Celebrate your team's Birthdays, Work Anniversaries, and New Joinees-all in one place. 👆"
                    },
                    {
                        title: "Attendance Wizard",
                        element: document.querySelector('.more-options'),
                        intro: "<div class='wel_icon text-center'><img src='/assets/images/icon_wizard.png' height='153' width='268' ><p class='header'>Introducing Attendance Wizard!</P></div>Attendance Insights, Regularization and Plan Your Leave-All in one spot! 👉"
                    },
                    {
                        title: "Attendance Wizard Listview",
                        element: document.querySelector('#listview_btn'),
                        intro: "<div class='wel_icon text-center'><img src='/assets/images/icon_wizard.png' height='153' width='268' ><p class='header'>Introducing Attendance Wizard!</P></div>Attendance Insights, Regularization and Plan Your Leave-All in one spot! 👉"
                    },
                    {
                        title: "Attendance Clearance",
                        element: document.querySelector('.pendingcount'),
                        intro: "<div class='wel_icon text-center'><img src='/assets/images/icon_clearance.png' height='153' width='268' ><p class='header'>Effortless Attendance Clearance!</P></div>Manage leave, Attendance Corrections and Web Punches effortlessly-All in one spot! 👇"
                    },
                ],
                //showStepNumbers: true,
                //showStepNumbers: true, // Enable step numbers

            }).oncomplete(function () {
                updateTourFlag()
            }).start();
        }

        window.addEventListener('load', (event) => {
            if (Tourflag !== 'False') {
                if (hasTourCompletedLocally !== 'False') {

                    startTour();

                }
            }
        });

        function updateTourFlag() {

            $.ajax({
                url: '@_webapiurl' + 'Master/UpdateTourFlag',
                headers: { 'Authorization': '@_tokan' },
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    EmpId: '@empid',
                    UserId: '@UserId',
                    RoleId:'@_RoleId',
                    HasTourCompletes: false
                }),
                success: function (response) {

                    if (response.MegSts == null) {
                        console.log("Tour flag updated successfully.");
                        sessionStorage.setItem('hasTourCompleted_' + uniqueid + '_' + UserId, 'False');
                    } else {
                        console.error("Error updating tour flag.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error during API call:', error);
                }
            });
        }

    </script>

}
else
{
    <span style="color:red">Unauthorized Access.</span>
}

