@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
	string _Message = ViewBag.msg;
	string _error = ViewBag.error;
	string _tokan = HttpContext.Current.Session["tokan"].ToString();
	string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
	int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
	ViewBag.Title = "ActiveCompanyPunch";
	Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
}
<script type="text/javascript">
	$(document).ready(function () {
		var t = $('#tblActivePunchDetails').DataTable(
			{
				"processing": true,
				"ajax": {
					url: '@_webapiurl' + 'DashBoard/ActiveCompanyPunchDetails',
					type: "GET",
					headers: { 'Authorization': '@_tokan' },
					dataSrc: '',
				},
				"columns": [
					{ "data": null },
					{ "data": "CompanyName" },
					{ "data": "PunchCount" }
				],
				"order": [[1, 'asc']],
			}
			);
		t.on('order.dt search.dt', function () {
			t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
				cell.innerHTML = i + 1;
			});
		}).draw();
	});
</script>
@if (_RoleId == 15)
{
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/PayTime/SuperAdminDashboard"><i class="fa fa-home"></i></a>
        </li>
        <li>
            <span><i class="fa fa-angle-right"></i> Active Company Punch</span>
        </li>
    </ul>
</div>
<div class="row">
	<div class="col-md-12">
		<div class="portlet ">
			<div class="portlet-body">
				<div>
					<table id="tblActivePunchDetails" class="table table-striped table-bordered table-hover table-checkable order-column">
						<thead>
							<tr>
								<th>Sr. No</th>
								<th>Company Name</th>
								<th>Punch Count</th>
							</tr>
						</thead>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
}
else
{
	<span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}

