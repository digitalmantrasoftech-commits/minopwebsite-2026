        $("#IScurrencycode").val('@_IScurrencycode');
        $('input[type=number]').keypress(function(evt){
            if (evt.which != 8 && evt.which != 0 && evt.which < 48 || evt.which > 57)
            {
                evt.preventDefault();
            }
        });
        // set the maxlength for 5 the input type number
        $('input[type=number][max]:not([max=""])').on('input', function(ev) {
            var $this = $(this);
            var maxlength = $this.attr('max').length;
            var value = $this.val();
            if (value && value.length >= maxlength) {
                $this.val(value.substr(0, maxlength));
            }
        });

        function disablePrev() { window.history.forward() }
        window.onload = disablePrev();
        window.onpageshow = function(evt) { if (evt.persisted) disableBack() }

        planId=  parseInt($("input[name=planmaster]").val());

        var Addonddl = $("#ddladdonmaster").multiselect({
            selectallvalue: 'multiselect-all',
            enablecaseinsensitivefiltering: true,
            //includeSelectAllOption: true,
            allselectedtext: 'all select',
            enablefiltering: true,
            buttonwidth: '100%',
            enableclickableoptgroups: true,
            numberDisplayed: 10,
            maxHeight: 150,
            onChange: function (option, checked) {

                var selcount = $("#ddladdonmaster :selected").length;

                var addrow = selcount + 1;
                if (checked) {
                    addOnIdCalculator = option[0].value;
                    var strrow = '<tr id="row_' + option[0].value + '" > <td>' + option[0].label + '</td><td><select data-attr="dropdown"  id="ddlpackage_' + option[0].value + '"  onchange="fillvalue(' + option[0].value + ')"  ></select></td><td nowrap> Rate(Per Unit) : <span id="spnpackagerate_' + option[0].value + '"></span></td> <td nowrap><div class="form-inline">Quantity : <input type="number" min="0" class="ptyNumber form-control input-sm"   id="packqty_' + option[0].value + '" value="0"  onchange="calculateaddonrate(' + option[0].value + ');"   onblur="calculateaddonrate(' + option[0].value + ');Setmax(' + option[0].value + ')" onkeyup="calculateaddonrate(' + option[0].value + ');" /></div> </td> <td></td> <td></td> <td id="lblsgst" style="font-weight: bold; text-align: left"  ></td> <td id="lblamt_' + option[0].value + '" style="font-weight: bold;" class="clspackamt">0</td> <td></td> <td></td> <td></td> </tr>';
                    $('#tbllicence > tfoot > tr').eq(2).after(strrow);
                    Filladdonpackage(option[0].value);
                }
                else {
                    $('#row_' + option[0].value).remove();
                    Showtotalprice()
                }
            },
        });


        document.getElementById("isAdduser").value = 0;
        if (isaddu > 0) {
            cmpuser = 0;
            document.getElementById("isAdduser").value = 1;
        }


        document.getElementById("Duration").value = 30;
        $(".qnum").bind('keyup mouseup', function () {
            var _price = $(this).parent('td').parent('tr')[0].cells[5].innerText;
            var _qty = $(this).parent('td').parent('tr')[0].cells[6].firstChild.value;
            var _total = (_price * _qty).toFixed(2);
            $(this).parent('td').parent('tr')[0].cells[7].innerText = _total;
            var _discper = $(this).parent('td').parent('tr')[0].cells[10].innerText;
            var disctxt = "Commission : ";//+_disc+" %";
            var discamt = parseFloat(_total * _discper / 100);
            document.getElementById("lbldisc").innerText = disctxt + _discper + "%";
            document.getElementById("lbldiscamt").innerText = discamt;
            var _pid = $(this).parent('td').parent('tr')[0].cells[8].innerText;
            document.getElementById("PlanId").value = _pid;
            document.getElementById("Disccount").value = discamt.toFixed(2);
            document.getElementById("DisccountPer").value = _discper;

            Showtotalprice();
        });
        $("#GSTNo").change(function () {
            var inputvalues = $(this).val();
            gstinVal = $(this).val();
            var reggst = /^([0-9]){2}([a-zA-Z]){5}([0-9]){4}([a-zA-Z]){1}([0-9]){1}([a-zA-Z]){1}([a-zA-Z]|[0-9]){1}?$/;
            if (!reggst.test(gstinVal) && gstinVal != '') {
                toastr.remove();
                toastr.error("Please enter valid gstin number.");
                $('#GSTNo').css("border", "1px solid #dc3545");
                $('#GSTNo').val('');
                return false;
            }
        });
        $(".qnum").on('change blur', function (event) {
            var inputval = parseInt($(this).val());
            //var maxvalue = parseInt($(this).attr('max'));
            var minvalue = parseInt($(this).attr('min'));
            //if (inputval > maxvalue) {
            //    $(this).val(maxvalue);
            //}
            if (inputval < minvalue) {
                $(this).val(minvalue);
            }
            $(this).keyup();
        });

        $("input[name=planmaster][value="+planId+"]").attr('checked', 'checked');
        Resetall(planId);

        Bindaddonlist();

        $('title').replaceWith('<title>Plan Pricing | Minop</title>');
        //$('#canonical').attr("href", 'http://minopcloud.com/pricing');
        $('meta[name=keywords]').replaceWith('<meta name="keywords" content="Cloud-based time and attendance software systems">');
        $('meta[name=description]').replaceWith('<meta name="description" content="Whether you are just starting out or ready to take you’re your attendance system to next level, we have got pricing plans that fit any budget. Upgrade your plan at anytime as per your need.">');
    });


