    function setMaxminValue(id){


        var pmax = 0;
        var pmin = 0;
        var inputValue = 0;

        inputValue = parseInt($("#packqty_"+id+"").val());
        pmax  =  parseInt($("#ddlpackage_"+id+" option:selected").attr("pmax"));
        pmin = parseInt($("#ddlpackage_"+id+" option:selected").attr("pmin"));

        //  var minvalue = parseInt($(this).attr('min'));
        if (inputValue > pmax) {
            $("#packqty_"+id+"").val(pmax);
            // $(this).val(pmax);
        }else
            if (inputValue > pmin) {
                //$(this).val(pmin);

                if (inputValue > pmin  || inputValue < pmax) {
                    //$(this).val(pmin);
                    $("#packqty_"+id+"").val(inputValue);
                }else
                {
                    $("#packqty_"+id+"").val(pmin);
                }

            }else
                if(inputValue < pmin){
                    $("#packqty_"+id+"").val(pmin);

                }


        //  $("#packqty_"+id+"").keyup();
        //$(this).keyup();



    }

    function Setmax(addonid) {

        var status = true;
        var lblrate = "#spnpackagerate_" + addonid + "";
        var pkqty = "#packqty_" + addonid + "";
        var lblamt = "#lblamt_" + addonid + "";


        var pmax  =  parseInt($("#ddlpackage_"+addonid+" option:selected").attr("pmax"));
        var pmin = parseInt($("#ddlpackage_"+addonid+" option:selected").attr("pmin"));

        $(pkqty).attr("max", pmax);
        $(pkqty).attr("min", pmin);

        var packrate = parseFloat($(lblrate).text());
        var packqty = parseInt($(pkqty).val());


        if(packqty < pmin )
        {
            toastr.remove();
            toastr.info("Mininum value of quanitity should be "+pmin+".");

            $(pkqty).focus();

            status = false;
            // $(pkqty).val(pmin);
        }

        if(packqty > pmax )
        {
            toastr.remove();
            toastr.info("Maximum value of quanitity should be "+pmax+".");
            $(pkqty).focus();
            status = false;
            //$(pkqty).val(pmax);
        }




        var packamt = packrate * packqty;
        $(lblamt).text(packamt.toFixed(2));


        return status;

        /// setMaxminValue(addonid);



    }

    function calculateaddonrate(addonid) {


        addOnIdCalculator = addonid;

        var lblrate = "#spnpackagerate_" + addonid + "";
        var pkqty = "#packqty_" + addonid + "";
        var lblamt = "#lblamt_" + addonid + "";
