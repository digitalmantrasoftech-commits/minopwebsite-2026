@using System.Configuration;
@model PayTimeWebClient.Models.Plan
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    //string strform = string.Empty;
    //strform = TempData["strfomr"]!=null?TempData["strfomr"].ToString():"";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _clientcompany = HttpContext.Current.Session["ClientCompanyId"].ToString();
    int _cmpuser = Convert.ToInt32(HttpContext.Current.Session["Noofemp"].ToString());
    int _cmpNOuser = Convert.ToInt32(HttpContext.Current.Session["UseCount"].ToString());
    int _rmDay = Convert.ToInt32(HttpContext.Current.Session["rmDay"].ToString());
    int _pdur = Convert.ToInt32(HttpContext.Current.Session["Pdrsn"].ToString());
    int _isAdduser = ViewBag.isAdduser;
    string _username = HttpContext.Current.Session["cmpname"].ToString();
    string _useremail = HttpContext.Current.Session["UserEmail"].ToString();
    string _emsg = TempData["rerrormsg"] != null ? TempData["rerrormsg"].ToString() : "";
    int _isRec = Convert.ToInt32(HttpContext.Current.Session["isRecurring"].ToString());
    int UserEmpid = Convert.ToInt32(HttpContext.Current.Session["EmpId"].ToString());
    int _IScurrencycode = Convert.ToInt32(HttpContext.Current.Session["IScurrencycode"].ToString());

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<link href="~/Content/toastr.min.css" rel="stylesheet" />


<style>
    .pymtns-type-accordian {
        list-style-type: none;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background-color: #2a85ce;
    }

    .licls {
        float: bottom;
    }

        .licls a {
            display: block;
            color: white;
            text-align: center;
            padding: 16px;
            text-decoration: none;
        }

            .licls a:hover {
                background-color: #ff22;
            }

    .bootstrap-switch.bootstrap-switch-small .bootstrap-switch-handle-off {
        font-size: 11px;
    }

    .bootstrap-switch .bootstrap-switch-handle-off.bootstrap-switch-primary,
    .bootstrap-switch .bootstrap-switch-handle-on.bootstrap-switch-primary,
    .bootstrap-switch .bootstrap-switch-handle-off.bootstrap-switch-default,
    .bootstrap-switch .bootstrap-switch-handle-on.bootstrap-switch-default {
        background: var(--navyblue_color);
        color: #fff;
