@model PayTimeWebClient.Models.ReqUpdateAdminInfo
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Customer Support";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _flag = ViewBag.flag;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
}

<script type="text/javascript">
    $(document).ready(function () {
        $(".alert").hide();
        if ("@_Message" != "") {
            $("#viewbagerrdiv").hide();
            $("#viewbagdiv").show();
        }
        if ('@_error' != "") {
            $("#viewbagerrdiv").show();
            $("#viewbagdiv").hide();
        }
        $('input[type="file"]').on('change', function () {

            _fileupload = event.target.files[0].name;
            $("#hdnuploadfile").val(event.target.files[0]);
            var container = $(this).attr('name');
            var file_size = $('#' + container + '')[0].files[0].size;
            if (file_size > 4097152) {
                toastr.remove();
                toastr.error("File size is greater than 4MB.");
                $('#' + container + '').val('');
                return false;
            }
        });
        
    });
</script>

<div class="col-md-12">
    <div class="portlet light bordered portlet-fit ">
        <div class="portlet-title tabbable-line">
            <div class="caption caption-md">
                <span class="caption-subject font-blue-madison bold uppercase">Customer Support</span>
            </div>
        </div>
        <div class="portlet-body">
            <div class="profile-content">
                <div class="row">
                    <div class="profile-account">
                        <div class="col-md-3">
                            <ul class="ver-inline-menu tabbable margin-bottom-10">
                                <li class="active" id="li1">
                                    <a data-toggle="tab" href="#tab_1-1">
                                        <i class="fa-light fa-gear"></i>Create Ticket
                                    </a>
                                    <span class="after"> </span>
                                </li>
                                <li id="li2" >
                                    <a href="https://desk.zoho.com/portal/mantratec/" target="_blank" aria-expanded="false">
                                        <i class="fa-light fa-lock-keyhole"></i> View My Tickets
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-9">
                            <div class="tab-content">
                                @using (Html.BeginForm("CustomerSupport", "PayTime", FormMethod.Post, new { @enctype = "multipart/form-data", @id = "form1" }))
                                {
                                    <div id="tab_1-1" class="tab-pane active">
                                        <div class="col-md-6">
                                            <div class="form-group" hidden>
                                                <input type="text" class="form-control" id="UserId" name="UserId" value="@Session["UserId"] " />
                                            </div>
                                            <div class="form-group" hidden>
                                                <input type="text" class="form-control" id="DealerId" name="DealerId" value="" />
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label">Ticket Subject <span class="required" aria-required="true"> * </span></label>
                                                <input class="form-control" id="subject" maxlength="150"
                                                       name="subject" type="text" value="" placeholder="Enter ticket subject" required="required" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')">
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label">Description <span class="required" aria-required="true"> * </span></label>
                                                <textarea id="description" name="description" placeholder="Enter ticket Description" rows="15" class="form-control" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')"></textarea>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label">Attachment(s)</label>
                                                <input type="file" id="attechmentfiles" name="attechmentfiles" >
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div>
                                                <button type="button" class=" btn btn-sm  default" id="btncancelperinfo"> <i class="fa-solid fa-xmark"></i> Cancel</button>
                                                <button type="submit" class=" btn btn-sm  blue" id="btnsubmit"> <i class="fa-light fa-floppy-disk"></i> Save</button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <!--end col-md-9-->
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div id="frmpopup" class="modal fade modal_payment_status">
    <div class="status-box">
        <div class="status_body payment_Status_data">
            <fieldset>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <div class='successpay'><p class='psuccess'>Partner Details</p><p style="text-align:left">Partner Name: <span id="lblpartnername"></span></p> <p style="text-align:left">Partner Mobile: <span id="lblmobile"></span></p></div>
                        </div>
                        <div class="text-right">
                            <button type="button" id="btncancelpopup" style="float: right; margin-left: 10px;"> <i class="fa-light fa-crosshairs"></i> Cancel</button>
                            <button type="button" class="btn_ok_payment" id="btnok" style="float:right"> <i class="fa-solid fa-check"></i> Confirm</button>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
</div>
<script src="~/assets/global/plugins/bootstrap-pwstrength/pwstrength-bootstrap.min.js"></script>
<script src="~/assets/global/plugins/bootstrap-maxlength/bootstrap-maxlength.min.js"></script>
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>