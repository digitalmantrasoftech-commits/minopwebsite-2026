@using System.Configuration;
@model PayTimeWebClient.Models.OTPCheck
@{
    Layout = null;
    string _companyCode = string.Empty;
    string _roleid = string.Empty;
    string _Email = string.Empty;
    string _Domain = string.Empty;
    string UserId = string.Empty;
    int IsMobileOTP = 0;
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    if (HttpContext.Current.Session["cmpcode"].ToString() != null)
    {
        _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    }
    if (HttpContext.Current.Session["RoleId"].ToString() != null)
    {
        _roleid = HttpContext.Current.Session["RoleId"].ToString();
    }
    if (HttpContext.Current.Session["UserEmail"].ToString() != null)
    {
        _Email = HttpContext.Current.Session["UserEmail"].ToString();
    }

    if (HttpContext.Current.Session["IsMobileOTP"].ToString() != null)
    {
        IsMobileOTP = Convert.ToInt32(HttpContext.Current.Session["IsMobileOTP"]);
    }

    if (HttpContext.Current.Session["UserId"].ToString() != null)
    {
        UserId = HttpContext.Current.Session["UserId"].ToString();
    }

}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title> OTP | Mantra</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <link rel="shortcut icon" href="assets/images/favicon.ico">
    <script src="~/Scripts/jquery-1.12.4.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <link href="~/Content/toastr.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/fonts/stylesheet.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/style.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/LandingAssets/css/responsive.css" rel="stylesheet" />
    <link href="~/Newlayout/css/forgotpassword.css" rel="stylesheet" />
    <script src="~/AssetsNew/js/CommonValidation.js"></script>
</head>
<body class="login">

    @using (Html.BeginForm("OTPCheck", "PayTime", FormMethod.Post, new { @class = "form" }))
    {
        <div class="row">
            <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
                <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
            </div>
        </div>
        <div class="forgot_pwd_copy">
            <div class="col-md-12 text-center"><img alt="Porto" width="200" src="/app_assets/images/logo-white.png"> </div>
            <div class="content">
                <div class="row">
                    <div id="divOTP">
                        <div class="col-md-12 ">
                            <p class="title red">@ViewBag.Meg</p>
                            <h3 class="font-blue">Enter OTP</h3>
                            @if (IsMobileOTP == 1)
                            {
                                <p>Please Enter OTP Sent on your Mobile</p>
                            }
                            else
                            {
                                <p>Please Enter OTP Sent on your email</p>
                            }

                            <div class="login-input-box">
                                <div class="form-group">
                                    <label>OTP <span class="required" aria-required="true" style="color:red;">*</span></label>
                                    <input class="form-control" type="hidden" name="CompanyCode" id="CompanyCode" value="@Model.CompanyCode" required="" />
                                    <input class="form-control" type="hidden" name="RoleId" id="RoleId" value="@Model.RoleId" required="" />
                                    <input class="form-control" type="hidden" name="Email" id="Email" value="@Model.Email" required="" />
                                    <input class="form-control" type="text" name="OTP" id="OTP" required="" maxlength=4 />
                                </div>
                            </div>
                            <div class="login-btn">
                                <input type="submit" class="btn blue btn-block btn-submit" value="Submit" id="submitOTP" />
                                <input type="button" value="Resend OTP" id="otpresend" name="RESEND OTP" class="btn blue btn-block btn-submit" style="display:none" />
                            </div>
                            <div class="form-group input-field label-float">
                                <label class="active" id="TimerCounter" hidden style="margin-top: 10px; font-size: 14px;"></label>
                            </div>
                            <div id="divlogin">
                                @*<p class="title">@ViewBag.Meg</p>*@
                                <div class="form-group input-field label-float ">
                                    <p> <a href="/Paytime/LoginPage">Click here To Login!</a> </p>
                                    <div style="clear: both;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <p>
                Copyright ©
                <script>document.write(new Date().getFullYear())</script> Mantra Softech. All Rights Reserved
            </p>
        </div>
    }
</body>
</html>

<script type="text/javascript">

    var _MobileOTP = '@IsMobileOTP';
   // var _UserId = '@UserId';

    $(document).ready(function () {
        window.history.pushState(null, '', window.location.href);
        window.onpopstate = function () {
            window.history.pushState(null, '', window.location.href);
        };
    });
    $("#ajax_loader").hide();
    $(function () {
        $("#OTP").focus();
    });
    var comCode = '@_companyCode';
    var RoleId = '@_roleid';
    var Email = '@_Email';
    var message = '@ViewBag.Meg';
    if (message == '' || message == 'ok') {
        startTimer();
    }
    $(".form").keypress(function (e) {
        if(e.which == 13)
        {
            $('.form').submit();
        }
    })
    $("#OTP").blur(function () {
        var OTP = removeTags($("#OTP").val());
        $("#OTP").val(OTP);
    });
    $("#OTP").keypress(function (e) {
        var keyCode = e.which;
        var Responce = validateKeyPress(keyCode);
        if (Responce == true) {
        }
        else { e.preventDefault(); }
    });
    $("#OTP").keypress(function (e) {
        var charCode = (e.which) ? e.which : e.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
    });
    $("#submitOTP").click(function () {
        $("#ajax_loader").show();
        if ($("#OTP").val() == '') {
            $("#OTP").addClass('field_error');
            toastr.remove();
            toastr.error("OTP is required.")
            $("#ajax_loader").hide();
            return false;

        }
        else {
            $("#OTP").removeClass('field_error');
        }
        $("#form").submit();
    });
    var count = 0;
    $("#otpresend").click(function () {
        count++;
        if(count > 5)
        {
            $("#otpresend").prop('disabled', true);
            $("#TimerCounter").hide();
        }
    });
    var clickcount;
    function startTimer() {
        var countdown = 20 * 60 * 30;
        var timerId = setInterval(function () {
            countdown -= 1000;
            var min = Math.floor(countdown / (60 * 1000));
            var sec = Math.floor((countdown - (min * 60 * 1000)) / 1000);
            $("#TimerCounter").show();
            if (countdown <= 0) {
                clearInterval(timerId);
                $("#TimerCounter").hide();
                $("#otpresend").show();
            }
            else {
                if (sec < 10) {
                    $("#TimerCounter").html("Didn't Receive OTP ? Resend OTP in 0" + min + ":0" + sec + " Sec ");
                }
                else {
                    $("#TimerCounter").html("Didn't Receive OTP ? Resend OTP in 0" + min + ":" + sec + " Sec ");
                }
            }

        }, 1000);
    }
    if ('@ViewBag.Meg' == "Enter OTP does not match.") {
        $("#ajax_loader").hide();
        $("#otpresend").show();
    }
    if ('@ViewBag.Meg' == "Your OTP has expired.") {
        $("#ajax_loader").hide();
        $("#otpresend").show();
    }
    $('#otpresend').on('click', function () {
        $.ajax({
            type: "POST",
            url: '@_webapiurl' + 'Registration/SendOTP?CompanyCode=' + comCode + "&RoleId=" + RoleId + "&Email=" + Email + "&IsMobileOTP=" +_MobileOTP,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                $("#ajax_loader").hide();
                if (response != null) {
                    toastr.remove();
                    toastr.success(response.Meg);
                    startTimer();
                    $('#otpresend').hide();
                }
                else {
                    toastr.remove();
                    toastr.success(response.Meg);
                }
            },
            error: function (response) {
                $("#ajax_loader").hide();
                if (response != null) {
                    var obj = JSON.parse(response.responseText);
                    if (obj.MegSts == 'error') {
                        toastr.remove();
                        toastr.error(obj.Meg);
                    }
                }
            }
        });
    });
</script>


