@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Templates";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    int j = 0;

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
      ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
      : "false"; // Default to "false" if the session is null
}
<script type="text/javascript">
    $(document).ready(function () {

        $(".submitclass").click(function () {
            var TemplateId = $(this).siblings().val();
            $.ajax({
                type: 'POST',
                url: "/PayTime/ApplyTemplate?TemplateId=" + TemplateId,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result.isRedirect) {
                        window.location.href = result.redirectUrl;
                    }
                    if (result == "Template Added Successfully") {
                        toastr.remove();
                        toastr.success("Template added successfully.");
                    }
                    else if (result == "Template Already Applied") {
                        toastr.warning("Template already applied.");
                    }
                    else {
                        toastr.remove();
                        toastr.error(result);
                    }

                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    $('.loading').hide();

                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                },
            });

        });

    });
</script>

<div class="page-bar">
    @if (_RoleId == 1)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i>Paytime Template</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Paytime Template</span>
            </li>
        </ul>
    }
</div>
<h1 class="page-title">
    <small></small>
</h1>
<div class="portlet-title">
    <div class="caption">


    </div>
</div>
<div class="portlet light portlet-fit bordered">
    <div class="portlet-body">
        <div class="note note-info">
            <h3><b>Clocking & Policy Templates.</b></h3>
            <p>
                Select Clocking & Policy template(s) that best suited your organization and proceed with your Minop schedule configurations.
                These templates serve as a guideline only.
            </p>
        </div>
        <div class="mt-element-list">
            <div class="mt-list-head list-news font-white">
                <div class="list-head-title-container badge_top">
                    <h3 class="list-title">Clocking & Policy Templates.<span class="badge badge-primary pull-right template_badge">2</span></h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-list-container list-news" id="">
    <div class="row">
        @foreach (var i in ViewBag.templateGetall)
        {
            j = j + 1;
            var _tab1 = "tab_" + j + "_1";
            var _tab2 = "tab_" + j + "_2";
            if (i.TemplateId == 6 || i.TemplateId == 4)
            {
                <div class="col-lg-6 col-md-12 col-sm-12">
