                        <div class="portlet-body">
                            <li class="mt-list-item">
                                <div class="list-item-content">
                                    <h3 class="">
                                        <span id="templateId" hidden>@i.TemplateId</span>
                                        <span class="template_title">@Html.Raw(i.TemplateName)</span>
                                    </h3>
                                    <p>@i.TemplateDesc</p>
                                    <div class="list-icon-container">
                                        <input type="text" id="tempid" value="@i.TemplateId" hidden />
