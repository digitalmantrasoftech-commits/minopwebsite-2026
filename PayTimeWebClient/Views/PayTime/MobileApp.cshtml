@{
    Layout = "~/Views/Shared/_LayoutLandingPage.cshtml";
}

<div class="app-header-bg page-head">

  <div class="container">
      <div class="row">
          <div class="col-xs-12">
                <h2>Mobile App</h2>
                <ol class="breadcrumb">
                  <li><a href="~/">Home</a>&nbsp;/&nbsp;</li>
                  <li class="active">Mobile App</li>
                </ol>
             </div>
         </div>     
    </div>
</div>


<section id="app_bg"  >
	<div class="container wow bounceInLeft"  data-wow-offset="300" >
    	<div class="row mb5">
        	 <h1 class="welcome-title"> Mobile<span> App </span></h1>
            <div class="col-md-5 mt5"><img class="img-responsive" src="~/LandingAssets/images/Mobile.png"></div>
            <div class="col-md-7 mt5 ">
              
               <div class="desc text-center">Our mobile app is designed for employees to easily clock in and out without a computer, and offers multiple features for employees</div>
                <h1 class="text-center">Employees: Download the app here!</h1>
<div class="site-download-icons mt5">
    <a href="https://play.google.com/store/apps/details?id=com.mantra.minop">
        <!-- FIGURE -->
        <figure><img src="~/LandingAssets/images/store-google-icon.png" alt="store icon"></figure>
        <!-- h6 heading -->
        <h6>Available on the</h6>
        <!-- h5 -->
        <h5>Google Store</h5>
    </a>
            </div>
</div>

        </div>
    </div>
</section>
<script src="~/Scripts/jquery-1.12.4.js"></script>
<script type='text/javascript'>
    $(document).ready(function () {
        $('title').replaceWith('<title>Download our mobile application | Minop</title>');
        $('#canonical').attr("href", 'http://minopcloud.com/Mobile-App');
        $('meta[name=keywords]').replaceWith('<meta name="keywords" content="Cloud-based time and attendance software systems, School management software, Employee Self Service Software, Visitor management software, Time management software system">');
        $('meta[name=description]').replaceWith('<meta name="description" content="Our mobile app is designed for employees to easily clock in and out without a computer, and offers multiple features for employees.">');
    });
</script>
 