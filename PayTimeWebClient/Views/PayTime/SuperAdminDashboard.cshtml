@model PayTimeWebClient.Models.SuperAdminDetails
@using PayTimeWebClient.Models;
@using System.Configuration;
@{

    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    if (_RoleId == 15)
    {
        ViewBag.Title = "SuperAdminDashboard";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
    }
}
<script src="~/assets/layouts/layout/scripts/CountUp.js"></script>
<script type="text/javascript">
    var chart; // global
    var options = {
        useEasing: true,
        useGrouping: true,
        separator: ',',
        decimal: '.',
    };
    $(document).ready(function () {
        requestDatatotalPunch();
        Highcharts.setOptions({
            global: {
                useUTC: false
            },
            lang: {
                thousandsSep: ','
            }
        });
        //Live Punch Chart - Start
        chart = Highcharts.chart('containerLivePunch', {
            chart: {
                type: 'spline',
                events: {
                    load: requestData
                }
            },
            title: {
                text: "Today's Live Attendance"
            },
            xAxis: {
                type: 'datetime',
                tickPixelInterval: 150
            },
            yAxis: {
                title: {
                    text: 'Employee present in office',
                    //margin: 15
                },
                allowDecimals: false,
                minRange: 1
                //min: 0
            },
            tooltip: {
                formatter: function () {
                    return '<b>' + this.series.name + '</b><br/>' +
                        Highcharts.dateFormat('Time : %H:%M:%S', this.x) + '<br/>' +
                        'No:' + this.y;
                }
            },
            series: [{
                name: 'Attendance',
                data: []
            }]
        });
        //Live Punch Chart - End
        //Weekly Punch Chart - Start
        $.ajax({
            url: '@_webapiurl' + 'DashBoard/SuperAdminWeeklyPunch',
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                var series = new Array();
                for (var i = 0; i < data.length; i++) {
                    var d = new Date(data[i].PunchDate);
                    var year = d.getFullYear();
                    var month = d.getMonth();
                    var date = d.getDate();
                    series.push([Date.UTC(year,month,date), data[i].PunchCount]);
                }
                weeklypunchChart(series)
            },
            cache: false
        });

        //Weekly Punch Chart - End

        //Monthy Punch Chart - Start
        $.ajax({
            url: '@_webapiurl' + 'DashBoard/SuperAdminMonthlyPunch',
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                var series = new Array();
                for (var i = 0; i < data.length; i++) {
                    series.push([data[i].PunchMonth, data[i].PunchCount]);
                }
                MonthlyPunchChart(series);
            },
            cache: false
        });
        //MonthlyPunchChart();
        //Monthy Punch Chart - End

        //Time Pie Chart - Start
        $.ajax({
            url: '@_webapiurl' + 'DashBoard/SuperAdminTimePieChartPunch',
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                var series = new Array();
                for (var i = 0; i < data.length; i++) {
                    series.push([data[i].TimeRange, data[i].PunchCount]);
                }
                TimePieChart(series);
            },
            cache: false
        });
        //Time Pie Chart - End

        //Company Wise Punch - start
        $.ajax({
            url: '@_webapiurl' + 'DashBoard/SuperAdminCompanyWisePunch',
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                var series = new Array();
                for (var i = 0; i < data.length; i++) {
                    series.push([data[i].CompanyName, data[i].PunchCount]);
                }
                CompanyWisePunch(series);
            },
            cache: false
        });

        //Company Wise Punch - End
        //Punch Mode - Start
        $.ajax({
            url: '@_webapiurl' + 'DashBoard/SuperAdminPunchMode',
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                var series = new Array();
                for (var i = 0; i < data.length; i++) {
                    series.push([data[i].EntryMode, data[i].PunchCount]);
                }
                PunchMode(series);
            },
            cache: false
        });
        //Punch Mode - End

        //Punch Per Time - Start
        $.ajax({
            url: '@_webapiurl' + 'DashBoard/SuperAdminPunchPerTime',
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                var series = new Array();
                for (var i = 0; i < data.length; i++) {
                    series.push([data[i].Time, data[i].PunchCount]);
                }
                PunchPerTime(series);
            },
            cache: false
        });

        //Punch per Time - End
    });

    function requestData() {
        $.ajax({
            url: '@_webapiurl' + 'DashBoard/SuperAdminLiveAttendance',
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            success: function (point) {
                var series = chart.series[0],
                    shift = series.data.length > 20; // shift if the series is longer than 20
                // add the point
                chart.series[0].addPoint([(new Date()).getTime(), parseInt(point[0].attendance)], true, shift);
                // call it again after one second
                setTimeout(requestData, 1000);
            },
            cache: false
        });
    }

    function requestDatatotalPunch() {
        var oldvalue = $('#punchno').text();
        var oldvalueInt = parseInt(oldvalue.replace(/,/g, ''));
        $.ajax({
            url: '@_webapiurl' + 'DashBoard/SuperAdminTotalPunch',
            type: "GET",
            async: false,
            headers: { 'Authorization': '@_tokan' },
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                var demo = new CountUp('punchno', oldvalueInt, data[0].PunchCount, 0, 2.5, options);
                if (!demo.error) {
                    demo.start();
                } else {
                    console.error(demo.error);
                }
                setTimeout(requestDatatotalPunch, 1000);
            },
            cache: false
        })
    }
    function weeklypunchChart(series) {
        Highcharts.chart('containerWeeklyPunch', {
            chart: {
                type: 'area'
            },
            title: {
                text: 'Last 7 days punch'
            },
            xAxis: {
                type: 'datetime',
            },
            yAxis: {
                title: {
                    text: 'Total number of punch',
                    //margin: 15
                },
                allowDecimals: false,
            },
            tooltip: {
                xDateFormat: '%b %e,%Y'
            },
            plotOptions: {
                bar: {
                    dataLabels: {
                        enabled: true
                    }
                }
            },
            series: [{
                name: 'Punches',
                data: series
            }]
        });
    }

    function MonthlyPunchChart(series)
    {
        Highcharts.chart('containerMonthly', {
            chart: {
                type: 'column'
            },
            title: {
                text: 'Monthly Punches'
            },
            xAxis: {
                type: 'category',
            },
            yAxis: {
                min: 0,
                title: {
                    text: 'Total number of punch'
                }
            },
            tooltip: {
                xDateFormat: '%b'
            },
            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0
}
            },
            series: [{
                name: 'Punches',
                data: series
            }]
        });
    }

    function TimePieChart(series)
    {
        Highcharts.chart('containerTimePie', {
            chart: {
                type: 'pie',
                options3d: {
                    enabled: true,
                    alpha: 45
                }
            },
            title: {
                text: "Today's Punch time wise"
            },
            plotOptions: {
                pie: {
                    innerSize: 100,
                    depth: 45
                }
            },
            series: [{
                name: 'Punches',
                data: series
            }]
        });
    }

    function CompanyWisePunch(series)
    {
        Highcharts.chart('containerCompanyWise', {
            chart: {
                type: 'column'
            },
            title: {
                text: "Top 10 company's punch"
            },
            xAxis: {
                type: 'category',
            },
            yAxis: {
                min: 0,
                title: {
                    text: 'Total number of Punch'
                }
            },
            legend: {
                enabled: false
            },
            tooltip: {
                pointFormat: 'Punches: <b>{point.y}</b>'
            },
            series: [{
                name: 'Punches',
                data : series,
            }]
        });
    }

    function PunchMode(series)
    {
        Highcharts.chart('containerPunchMode', {
            chart: {
                type: 'bar'
            },
            title: {
                text: "Punch  by different mode"
            },
            xAxis: {
                type: 'category',
            },
            yAxis: {
                min: 0,
                title: {
                    text: 'Total number of Punch'
                }
            },
            legend: {
                enabled: false
            },
            tooltip: {
                pointFormat: 'Punches: <b>{point.y}</b>'
            },
            series: [{
                name: 'Punches',
                data: series,
            }]
        });
    }

    function PunchPerTime(series)
    {
        Highcharts.chart('containerPunchPerTime', {
            chart: {
                type: 'area'
            },
            title: {
                text: "Today's punch per time"
            },
            xAxis: {
                type: 'category',
            },
            yAxis: {
                title: {
                    text: 'Total number of punch',
                    //margin: 15
                },
                allowDecimals: false,
            },
            tooltip: {
                xDateFormat: '%b %e,%Y'
            },
            plotOptions: {
                bar: {
                    dataLabels: {
                        enabled: true
                    }
                }
            },
            series: [{
                name: 'Punches',
                data: series
            }]
        });
    }
</script>
