@model PayTimeWebClient.Models.Plan
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    string _Message = string.Empty;
    string _error = string.Empty;

    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    if (_RoleId == 15)
    {
        ViewBag.Title = "Plans";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
        _Message = ViewBag.msg;
        _error = ViewBag.error;
    }
}

<script type="text/javascript">
    $(document).ready(function () {
        frmClear();
        $(".alert").hide();
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }
        $('#tblPlan').DataTable({
            dom: _domCommon,
            language: _languageCommon,
        });
        setTimeout(function () {
            $("#" + "tblPlan" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        $("#AddPlan").on('click', function () {
            frmClear();
            $("#AddPlan").attr("data-toggle", "modal");
            $("#AddPlan").attr("data-target", "#frmpopup");
        });
        $(".editclass").click(function () {
            $("#PlanId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
            $("#Name").val($(this).parent('td').parent('tr').children(1)[2].innerText);
            $("#Name").prop("readonly", true);
            $("#Duration").val($(this).parent('td').parent('tr').children(1)[3].innerText);
            $("#Price").val($(this).parent('td').parent('tr').children(1)[4].innerText);
            $("#NoOfAdminUsers").val($(this).parent('td').parent('tr').children(1)[5].innerText);
            $("#NoOfEmployee").val($(this).parent('td').parent('tr').children(1)[6].innerText);
            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");
        });
        $("#tblPlan").on('click', '.deleteclass', function () {
            var flg = 0;
            if (confirm("Are you sure for Delete this Entry?")) {
                $("#PlanId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
                $.post("/PayTime/DeletePlan?id=" + $("#PlanId").val(), function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var _response = $.parseJSON(response);
                    if (_response == "OK") {
                        var strid = "Col_" + $("#PlanId").val().trim();
                        $("#" + strid + "").closest('tr').remove();
                        $('#tblPlan').DataTable();
                    }
                    else {
                        alert("something wrong occures.");
                    }
                });
            }
        });
        function frmClear()
        {
            $("#PlanId").val(0);
            $("#Name").val("");
            $("#Name").attr("placeholder", "Enter Plan Name");
            $("#Name").attr('required', true);
            $("#Duration").val("");
            $("#Duration").attr("placeholder", "Enter Plan Duration");
            $("#Duration").attr('required', true);
            $("#Price").val("");
            $("#Price").attr("placeholder", "Enter Price");
            $("#Price").attr('required', true);
            $("#NoOfAdminUsers").val("");
            $("#NoOfAdminUsers").attr("placeholder", "Enter Admin Users Size");
            $("#NoOfAdminUsers").attr('required', true);
            $("#NoOfEmployee").val("");
            $("#NoOfEmployee").attr("placeholder", "Enter Employee Size");
            $("#NoOfEmployee").attr('required', true);
        }
    });
</script>

@if (_RoleId == 15)
{
    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Plan</span>
            </li>
        </ul>
        <div class="page-toolbar">
            <a href="javascript:void(0)" style="display:none;" id="AddPlan" class="btn icon_transparent_btn  tooltips" data-placement="left" data-original-title="Add Plan"><i class="fa-solid fa-plus"></i></a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="portlet">
                <div class="portlet-body">
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tblPlan" class="table new_datatbl  table-striped table-bordered table-hover table-checkable order-column ">
                                <thead>
                                    <tr>
                                        <th style="display:none;">Sr. No</th>
                                        <th hidden>Plan ID</th>
                                        <th>Name</th>
                                        <th>Duration</th>
                                        <th>Price</th>
                                        <th>No of Admin</th>
                                        <th>No of Employee</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                @{int n = 1;}
                                <tbody>
                                    @foreach (var item in Model.PlanList)
                                    {
                                        <tr>
                                            <td hidden>@n</td>
                                            <td hidden>
                                                @Html.DisplayFor(modelItem => item.PlanId)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelitem => item.Name)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelitem => item.Duration)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelitem => item.Price)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelitem => item.NoOfAdminUsers)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelitem => item.NoOfEmployee)
                                            </td>
                                            <td id="Col_@item.PlanId">
                                                <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>
                                                <a class="deleteclass btn red_btnnew tooltips" data-placement="top" title="Delete"><i class="fa-regular fa-trash"></i></a>
                                            </td>
                                        </tr>
                                        n++;
                                    }
                                </tbody>

                            </table>

                        </div>
                        <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                                        <h4 class="modal-title">Plans</h4>
                                    </div>
                                    <div class="modal-body">
                                        @using (Html.BeginForm("Plans", "PayTime"))
                                        {
                                            @Html.ValidationSummary(false)
                                            <div class="modal-card">
                                                <fieldset>
                                                    <div class="row">
                                                        <div class="col-md-12">
                                                            <div class="form-group">
                                                                <div class="row">
                                                                    <div class="editor-label control-label col-md-5">
                                                                        @Html.HiddenFor(model => model.PlanId)
                                                                        Name <span class="required" aria-required="true"> * </span>
                                                                    </div>
                                                                    <div class="editor-field form-group has-error col-md-7">
                                                                        @Html.EditorFor(model => model.Name)
                                                                        <span class="help-block" hidden id="spPlanName"></span>
                                                                    </div>

                                                                    <div class="editor-label control-label col-md-5">
                                                                        Duration (In Days)<span class="required" aria-required="true"> * </span>
                                                                    </div>
                                                                    <div class="editor-field form-group has-error col-md-7">
                                                                        @Html.EditorFor(model => model.Duration)
                                                                        <span class="help-block" hidden id="spDuration"></span>
                                                                    </div>

                                                                    <div class="editor-label control-label col-md-5">
                                                                        Price <span class="required" aria-required="true"> * </span>
                                                                    </div>
                                                                    <div class="editor-field form-group has-error col-md-7">
                                                                        @Html.EditorFor(model => model.Price)
                                                                        <span class="help-block" hidden id="spPrice"></span>
                                                                    </div>

                                                                    <div class="editor-label control-label col-md-5">
                                                                        No of Admins<span class="required" aria-required="true"> * </span>
                                                                    </div>
                                                                    <div class="editor-field form-group has-error col-md-7">
                                                                        @Html.EditorFor(model => model.NoOfAdminUsers)
                                                                        <span class="help-block" hidden id="spNoOfAdmin"></span>
                                                                    </div>

                                                                    <div class="editor-label control-label col-md-5">
                                                                        No of Employees <span class="required" aria-required="true"> * </span>
                                                                    </div>
                                                                    <div class="editor-field form-group has-error col-md-7">
                                                                        @Html.EditorFor(model => model.NoOfEmployee)
                                                                        <span class="help-block" hidden id="spNoofEmp"></span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                </fieldset>
                                            </div>
                                        }
                                    </div>
                                    <div class="modal-footer">
                                        <div class="editor-field text-right">
                                            @*<input type="submit" class="btn blue " value="Save" />*@
                                            <button type="submit" class="btn save_btn" style="float:right"><i class="fa-light fa-floppy-disk"></i> Save</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>

        </div>

    </div>
}
else

{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>