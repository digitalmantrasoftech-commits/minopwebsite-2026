@{
    Layout = "~/Views/Shared/_LayoutLandingCloud.cshtml";
}
@section metatags{
<title>On time support</title><meta name="keywords" content="Cloud-based time and attendance software systems, School management software, Employee Self Service Software, Visitor management software, Time management software system"><meta name="description" content="Minop is here to help you. Our specialized professionals are here when you require any technical support or product information, they are prepared to provide you with timely and precise responses to your concern."><link id="canonical" rel="canonical" href="https://app.minopcloud.com/Support-Request" />
}
@section individual_css{
<style>@@import url(@Url.Content("/AssetsNew/css/pages/support-request.css"));</style>
}
@section individual_header_js{
<script>$(function () {$('.mn_support').addClass('current');});</script>
}
<!--Page Title-->

<section class="page_title_section">
    <div class="auto-container">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <h1>Place a Technical <strong>Support Request</strong></h1>
                <p>Customers can send technical support requests to our team right from the contact information.</p>
                <ul class="bread-crumb clearfix">
                    <li><a href="@Url.Content("/Attendance")">Home</a></li>
                    <li><span>/</span></li>
                    <li>Support Request</li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!--End Page Title-->
<!-- Sidebar Page Container -->
<div class="support_section">
    <div class="auto-container">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <p class="title_text">The people of mantra are here to help you. Our specialized professionals are here when you require any technical support or product information, they are prepared to provide you with timely and precise responses to your concern. Beyond our online resources, our profoundly trained technical and product specialists are available to discuss your problem, helping you to get the foremost from your security systems and maximize your ROI.</p>
            </div>
        </div>
        <div class="row align-items-center two_section_support">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="technical_support_box">
                    <img class="lazyload" loading="lazy" src="@Url.Content("/AssetsNew/images/Technical-Support.png")" alt="Technical Support" title="Technical Support" />
                    <h2>Technical Support</h2>
                    <p>Our technical support specialists are always ready to assist you with system installation or questions related to billing and plan upgrade. We provide service around the clock from our Customer Care Centers.</p>
                    <div class="support_details_box">
                        <p>
                            <b>Phone :- </b>
                            <a href="tel:07949068000">079-49068000 - EXT : 1</a>
                        </p>
                        <p>
                            <b>Email Id :- </b>
                            <a href="mailto:servico@mantratec.com">servico@mantratec.com</a>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="product_manuals_box">
                    <img class="lazyload" loading="lazy" src="@Url.Content("/AssetsNew/images/Product-Manuals.png")" alt="Product Manuals" title="Product Manuals" />
                    <h2>Product Manuals</h2>
                    <p>Our online supports provides convenient access to product user manuals for system installation. You may also contact us for further assistance.</p>
                    <a class="product_manuals_btn" href="@Url.Content("/Downloads/Minop_User_Manual.pdf")" download="">Product Guide</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!--End Sidebar Page Container -->
<!-- Call To Action -->
<section class="call-to-action-two"> <div class="icon-layer wow zoomIn" data-wow-delay="400ms"></div><div class="auto-container clearfix"> <div class="title-column"> <div class="inner"> <span class="icon pe-7s-global"></span> <h3>Helping clients to unlock & unleash the power within their large scale Business</h3> </div></div><div class="btn-column"> <div class="btn-box"> <a href="@Url.Content("/Contact-Us")" class="theme-btn inquiry_now_btn"> <i class="fa fa-chart-line"></i>Inquiry Now </a> </div></div></div></section>
<!--End Call To Action -->
@section individual_footer_js{
<script src="/AssetsNew/js/script.js"></script>
}
