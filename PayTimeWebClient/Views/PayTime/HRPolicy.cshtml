        });
        $("#tblHrpolicy").on('click', '#exceldownload', function () {
            $.post("/PayTime/DownloadPolicy", { PolicyId: plcid, DownloadType: "Excel" }, function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                if (data != "/PayTime/ErrorPage") {
                    window.location = '/Downloads/' + data;
                }
                else {
                    window.location = data;
                }

            });
        });
        $("#tblHrpolicy").on('click', '#csvdownload', function () {
            $.post("/PayTime/DownloadPolicy", { PolicyId: plcid, DownloadType: "CSV" }, function (data) {
                if (data != "/PayTime/ErrorPage") {
                    window.location = '/Downloads/' + data;
