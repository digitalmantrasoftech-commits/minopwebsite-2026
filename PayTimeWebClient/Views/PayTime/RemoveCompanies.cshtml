@{

    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    if (_RoleId == 15)
    {
        ViewBag.Title = "RemoveCompanies";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
    }
}

<script type="text/javascript">
    $(document).ready(function () {
        $('#tbldropCompanies').DataTable({
            dom: _domCommon,
            language: _languageCommon,
        });
        setTimeout(function () {
            $("#" + "tbldropCompanies" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        $("#tbldropCompanies").on('click', '.dropclass', function () {
            var DbName = $(this).parent('td').parent('tr').children(1)[7].innerText.split();
            var CompanyId = $(this).parent('td').parent('tr').children(1)[4].innerText.split();
            $.post("/PayTime/RemoveCompanies?DbName= '" + DbName + "'&CompanyId='" + CompanyId + "'  ", function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                alert("Company Removed");
                //var _response = $.parseJSON(response);
                //if (_response == "OK") {
                //    alert("Record Deleted Successfully.");
                //    window.location.href = "/MasterData/DepartmentMaster/";
                //}
                //else {
                //    alert("something wrong occures.");
                //}
            });
        });
    });
    function AllCheckedDrpcmp(ths) {
        if ($(ths).prop('checked') == true) {
            $(".ClsChkDropcmp").prop('checked', true);
        }
        else {
            $(".ClsChkDropcmp").prop('checked', false);
        }
    }


</script>
@if (_RoleId == 15)
{
    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Plan</span>
            </li>
        </ul>
        <div class="report_title">
            <p>Drop Companies</p>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="portlet">
                <div class="portlet-body">
                    <div class="table-responsive" id="tableResponsive">
                        <table id="tbldropCompanies" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    <th><input type='checkbox' class='ClsChkDropcmpAll' onchange="AllCheckedDrpcmp(this)" /></th>
                                    <th>No</th>
                                    <th hidden>UserId</th>
                                    <th>Email</th>
                                    <th hidden>Company ID</th>
                                    <th>CompanyName</th>
                                    <th>DbType</th>
                                    <th>CompanyDbName</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int n = 1;
                                }
                                @if (Model.SuperAdminDetailslist != null)
                                {
                                    foreach (var i in Model.SuperAdminDetailslist)
                                    {
                                        <tr>
                                            <td><input type='checkbox' class='ClsChkDropcmp' id="@i.UserId" /></td>
                                            <td id="sr">@n</td>
                                            <td hidden> @i.UserId </td>
                                            <td>@i.Email</td>
                                            <td hidden>@i.CompanyId</td>
                                            <td>@i.CompanyName</td>
                                            <td>@i.DbType</td>
                                            <td>@i.CompanyDbName</td>
                                            <td><a class="dropclass btn red_btnnew tooltips" title="Drop"><i class="fa-regular fa-trash"></i></a></td>
                                        </tr>
                                        n++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}
