@model PayTimeWebClient.Models.ResetPassword
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    @*<title>Forgot Password | Mantra</title>*@
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    
    <title>Employee Password Reset – Attendance System | Forgot Your Login?</title>
    <meta name="keywords" content="employee forgot password, attendance system login reset, recover employee account, reset attendance password, employee login help, attendance software password recovery">
    <meta name="description" content="Forgot your employee password for the attendance system? Reset your login credentials quickly and securely to access your attendance records and reports. Simple and safe password recovery for employees.">
    <link id="canonical" rel="canonical" href="https://app.minopcloud.com/PayTime/ForgotPasswordForEmployee" />

    <link rel="shortcut icon" href="assets/images/favicon.ico">
    <script src="~/Scripts/jquery-1.12.4.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <link rel="stylesheet" type="text/css" href="~/Content/toastr.min.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/fonts/stylesheet.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/style.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/font-awesome.min.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/responsive.css" />
    <link rel="stylesheet" type="text/css" href="~/Newlayout/css/forgotpassword.css" />
    <style>
        .form-group span.field-validation-error {
            font-size: 12px;
            color: #da1414;
        }

        #divforget h1 {
            font-size: 22px;
        }
    </style>
</head>

<body>
    @using (Html.BeginForm())
    {
        <div class="row">
            <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
                <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
            </div>
        </div>

        <div class="forgot_block">
            <div class="col-md-6 col-sm-6 left-block-50">
                <img class="img-fluid" src="/Assets/images/forgotpass_img.png" alt="Forgot Password Image">
            </div>
            <div class="col-md-6 col-sm-6">
                <div class="right-block-50">
                    <div class="forgot_pwd_right">
                        <div class="content">
                            <a href="/Paytime/LoginPage">
                                <img src="/AssetsNew/images/logo.png" width="200" alt="Logo">
                            </a>
                            <div class="row">

                                <div id="divforget" hidden>
                                    <div class="col-md-12">
                                        <h2 class="font-blue">Forgot Password ?</h2>
                                        <p class="margin-bottom-20">Enter your detail to receive an OTP for password reset.</p>
                                        <p class="title red">@ViewBag.Meg</p>
                                        <div class="login-input-box">
                                            <div class="form-group">
                                                <label>Account code / Domain name<span class="required" aria-required="true" style="color:red;"> * </span></label>
                                                @Html.TextBoxFor(model => model.CompanyCode, new { @class = "login-input form-control" })
                                            </div>
                                            <div class="form-group">
                                                @Html.ValidationMessageFor(model => model.CompanyCode)
                                            </div>
                                            <div class="form-group">
                                                <label>Email<span class="required" aria-required="true" style="color:red;"> * </span></label>
                                                @Html.TextBoxFor(model => model.Email, new { @class = "login-input form-control" })
                                            </div>
                                            <div class="form-group">
                                                @Html.ValidationMessageFor(model => model.Email)
                                            </div>
                                        </div>
                                        <div class="login-btn margin-bottom-10">
                                            <input type="submit" class="btn btn-block btn-submit" value="Submit" id="submit1" />
                                        </div>
                                        <div style="clear: both;"></div>
                                    </div>
                                </div>

                                <div id="divresetpass" hidden>
                                    <div class="col-md-12">
                                        <h3 class="font-green spanlogin">Forgot Password ?</h3>
                                        <p class="title red">@ViewBag.Meg</p>
                                        @*<div class="form-group">
                                                @Html.DisplayFor(model => model.Email, new { @class = "login-input form-control", @readonly = "readonly" })
                                            </div>*@
                                        <div class="form-group">
                                            <label>OTP<span class="required" aria-required="true" style="color:red;"> * </span></label>
                                            @Html.TextBoxFor(model => model.OTP, new { Value = "", @class = "login-input form-control" })
                                        </div>
                                        <div class="form-group">
                                            <label>New Password<span class="required" aria-required="true" style="color:red;"> * </span></label>
                                            @Html.PasswordFor(model => model.UserPass, new { @class = "password-input form-control", @id = "UserPass" })
                                            <span class="eye-icon" id="togglePassword" style="cursor: pointer; position: absolute; right: 10px; bottom: 8px; font-size: 12px;">
                                                <i class="fa fa-eye"></i>
                                            </span>
                                        </div>
                                        <div class="form-group">
                                            <label>Confirm Password<span class="required" aria-required="true" style="color:red;"> * </span></label>
                                            @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "password-input form-control", @id = "ConfirmPassword" })
                                            <span class="eye-icon" id="togglePassword1" style="cursor: pointer; position: absolute; right: 10px; bottom: 8px; font-size: 12px;">
                                                <i class="fa fa-eye"></i>
                                            </span>
                                        </div>
                                        <div class="login-btn margin-bottom-10">
                                            <input type="submit" class="btn blue btn-block " value="Submit" id="btnSubmit" />
                                        </div>
                                    </div>
                                </div>

                                <div id="divlogin" class="thanks_block">
                                    <div class="col-md-12">
                                        <div id="lblsuccess" class="margin-top-25" hidden>
                                            <div class="t_box">
                                                <img src="/assets/images/icons/icon_checkin.svg" alt="" /> <span>Thank You</span>
                                            </div>
                                            <div class="margin-bottom-20">
                                                <p class="t_msg">Your password update successfully!</p>
                                                <p>You can now login with your new password.</p>
                                            </div>
                                        </div>
                                        <p><a href="/Paytime/LoginPage">Click here To Login!</a></p>
                                        <div style="clear: both;"></div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <p class="footer_forgot">
                            Copyright ©
                            <script>document.write(new Date().getFullYear())</script> Minopcloud All Rights Reserved.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</body>

</html>
<script>
    $(document).ready(function () {
        $("#ajax_loader").hide();
        $(document).keypress(function (e) {
            if (e.which == 13) {
                if ($("#ConfirmPassword").val() != $("#UserPass").val() && $("#ConfirmPassword").val() != '') {
                    toastr.remove();
                    toastr.error("Password and confirm password does not match.")
                    return false;
                }
            }
        });

        $("#btnSubmit").click(function () {
            $(".usergenterror").remove();
            if ($("#OTP").val() == '') {
                $("#OTP").addClass('field_error');
                toastr.remove();
                toastr.error("OTP is required.")
                $("#ajax_loader").hide();
                return false;
            }
            else {
                $("#OTP").removeClass('field_error');
            }
            if ($("#Email").val() == '') {
                $("#Email").addClass('field_error');
                toastr.remove();
                toastr.error("Email is required.");
                $("#ajax_loader").hide();
                return false;
            }
            else {
                $("#Email").removeClass('field_error');
            }
            if ($("#UserPass").val() == '') {
                $("#UserPass").addClass('field_error');
                toastr.remove();
                toastr.error("Password is required.");
                $("#ajax_loader").hide();
                return false;
            }
            else {
                $("#UserPass").removeClass('field_error');
            }
            var regexpNewPwd = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;
            if (!regexpNewPwd.test($("#UserPass").val())) {
                $("#UserPass").val('');
                toastr.remove();
                toastr.error("Password must contain eight characters, at least one uppercase letter and one lowercase letter, one number and one special character(@@,$,!,%,*,?,&).")
                $("#ajax_loader").hide();
                return false;
            }
            //if ($('#UserPass').val().length < 6 || $('#UserPass').val().length > 15) {
            //    //$("#UserPass").after('<span for="UserPass" generated="true" class="usergenterror" style="color:red;">The password length must be greater than 6 & less than 15 characters.</span>');
            //    //is_valid_submit = true;
            //}
            if ($("#ConfirmPassword").val() == '') {
                $("#ConfirmPassword").addClass('filed-error');
                toastr.remove();
                toastr.error("Confirm password is required.")
                $("#ajax_loader").hide();
                return false;
            }
            else {
                $("#ConfirmPassword").removeClass('filed-error');
            }
            var regexpConfPwd = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;
            if (!regexpConfPwd.test($("#ConfirmPassword").val())) {
                $("#ConfirmPassword").val('')
                toastr.remove();
                toastr.error("Confirm password must contain eight characters, at least one uppercase letter and one lowercase letter, one number and one special character(@@,$,!,%,*,?,&).")
                $("#ajax_loader").hide();
                e.preventDefault();
                return false;
            }
            if ($("#ConfirmPassword").val() != $("#UserPass").val() && $("#Confirm Password").val() != '') {
                toastr.remove();
                toastr.error("Password and confirm password does not match.")
                $("#ajax_loader").hide();
                return false;
            }
        });

        if ('@ViewBag.Meg' == "Password Updated Successfully!.") {
            $("#lblsuccess").show();
            $("#divlogin").show();
        }

        else if (('@ViewBag.Otp' != "" && '@ViewBag.Otp' != null)) {
            $("#ajax_loader").hide();
            $("#divresetpass").show();
            $("#UserPass").attr("placeholder", "Enter New Password");
            $("#ConfirmPassword").attr("placeholder", "Enter Confirm Password");
            $("#OTP").attr("placeholder", "Enter OTP");
        }

        else if ('@ViewBag.Meg' == "Entered OTP not match.") {
            $("#ajax_loader").hide();
            $("#divresetpass").show();
            $("#divlogin").show();
            $("#divforget").hide();
            $("#UserPass").attr("placeholder", "Enter New Password");
            $("#ConfirmPassword").attr("placeholder", "Enter Confirm Password");
            $("#OTP").attr("placeholder", "Enter OTP");
        }

        else {
            $("#divforget").show();
            $("#submit1").click(function () {
                $("#ajax_loader").show();
                $(".usergenterror").remove();
                var is_valid_submit = false;
                if ($("#CompanyCode").val() == '') {
                    $("#CompanyCode").after('<span for="CompanyCode" generated="true" class="usergenterror">Domain name and Company Code is required</span>');
                    $("#CompanyCode").focus();
                    is_valid_submit = true;
                }
                if ($("#Email").val() == '') {
                    $("#Email").after('<span for="Email" generated="true" class="usergenterror">Email is required</span>');
                    $("#Email").focus();
                    $("#ajax_loader").hide();
                    is_valid_submit = true;
                }
                if (is_valid_submit) {
                    $("#ajax_loader").hide();
                    return false;
                };
            });
        }

        $('#togglePassword').click(function () {
            var passwordInput = $('#UserPass');
            var inputType = passwordInput.attr('type');
            if (inputType === 'Password' || inputType === 'password') {
                passwordInput.attr('type', 'text');
                $('#togglePassword i').removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                passwordInput.attr('type', 'password');
                $('#togglePassword i').removeClass('fa-eye-slash').addClass('fa-eye');
            }
        });

        $('#togglePassword1').click(function () {
            var passwordInput = $('#ConfirmPassword');
            var inputType = passwordInput.attr('type');
            if (inputType === 'Password' || inputType === 'password') {
                passwordInput.attr('type', 'text');
                $('#togglePassword1 i').removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                passwordInput.attr('type', 'password');
                $('#togglePassword1 i').removeClass('fa-eye-slash').addClass('fa-eye');
            }
        });

    });
</script>
