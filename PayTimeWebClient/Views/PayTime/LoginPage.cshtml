@{
    Layout = null;
    var strmsg = "";
    var strmegsts = "";
    var strEmp = "";
    var LoginType = "";

    if (TempData["meg"] != null)
    {
        strmsg = TempData["meg"].ToString();
    }
    if (TempData["MegSts"] != null)
    {
        strmegsts = TempData["MegSts"].ToString();
    }
    if (TempData["IsEmp"] != null)
    {
        strEmp = TempData["IsEmp"].ToString();
    }

    if (TempData["LoginType"] != null)
    {
        LoginType = TempData["LoginType"].ToString();
    }

    bool showLoginOTP = TempData["ShowLoginOTP"] != null && (bool)TempData["ShowLoginOTP"];
    string _loginOtpCmpCode = string.Empty;
    string _loginOtpRoleId = string.Empty;
    string _loginOtpEmail = string.Empty;
    int _loginOtpIsMobileOTP = 0;

    if (showLoginOTP)
    {
        if (HttpContext.Current.Session["cmpcode"] != null)
        {
            _loginOtpCmpCode = HttpContext.Current.Session["cmpcode"].ToString();
        }
        if (HttpContext.Current.Session["RoleId"] != null)
        {
            _loginOtpRoleId = HttpContext.Current.Session["RoleId"].ToString();
        }
        if (HttpContext.Current.Session["UserEmail"] != null)
        {
            _loginOtpEmail = HttpContext.Current.Session["UserEmail"].ToString();
        }
        if (HttpContext.Current.Session["IsMobileOTP"] != null)
        {
            _loginOtpIsMobileOTP = Convert.ToInt32(HttpContext.Current.Session["IsMobileOTP"]);
        }
    }

    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _partnerapiurl = System.Configuration.ConfigurationManager.AppSettings["partnerapi"].ToString();
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _custEmail = string.Empty;

}
