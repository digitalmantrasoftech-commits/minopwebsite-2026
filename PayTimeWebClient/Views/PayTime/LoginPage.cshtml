        function startTimer() {
            var countdown = 20 * 60 * 30;

            var timerId = setInterval(function () {
                countdown -= 1000;
                var min = Math.floor(countdown / (60 * 1000));
                var sec = Math.floor((countdown - (min * 60 * 1000)) / 1000);
                $("#dvTimer").show();

                if (countdown <= 0) {
                    clearInterval(timerId);
                    $("#dvTimer").hide();
                    $("#dvOTPResend").show();
                }
                else {

                    if (sec < 10) {
                        $("#TimerCounter").text("Didn't Receive OTP ? Resend OTP in 0" + min + ":0" + sec + " Sec ");
                    }
                    else {
                        $("#TimerCounter").text("Didn't Receive OTP ? Resend OTP in 0" + min + ":" + sec + " Sec ");
                    }
                }

            }, 1000);
        }

