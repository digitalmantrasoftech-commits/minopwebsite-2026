                    $(".loading").hide();
                    if (response.MegSts === "Ok") {
                        $("#spLoginOtpSuccess").html("OTP verified successfully!").show();
                        $("#spLoginOtpError").hide();
                        window.location.href = response.RedirectUrl;
                    } else {
                        $("#spLoginOtpError").html(response.Meg || "Invalid OTP. Please try again.").show();
                        $("#spLoginOtpSuccess").hide();
                        $("#dvLoginOTPResend").show();
                    }
                },
                error: function () {
                    $(".loading").hide();
                    $("#spLoginOtpError").html("Something went wrong. Please try again.").show();
                    $("#dvLoginOTPResend").show();
                }
            });
        });

        // Enter key submits login OTP
        $("#txtLoginOTP").keypress(function (e) {
            if (e.which === 13) {
                $("#btnLoginOtpVerify").click();
                return false;
            }
        });

        // Resend Login OTP
        $("#btnLoginOtpResend").click(function (e) {
            e.preventDefault();
            loginOtpResendCount++;
            if (loginOtpResendCount > 5) {
                $("#btnLoginOtpResend").hide();
                $("#spLoginOtpError").html("Maximum resend attempts reached. Please login again.").show();
                return;
            }
            $(".loading").show();
            $.ajax({
                type: "POST",
                url: webapiuri + 'Registration/SendOTP?CompanyCode=' + loginOtpCmpCode + '&RoleId=' + loginOtpRoleId + '&Email=' + loginOtpEmail + '&IsMobileOTP=' + loginOtpIsMobileOTP,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    $(".loading").hide();
                    if (response != null) {
                        $("#spLoginOtpSuccess").html(response.Meg || "OTP sent successfully!").show();
                        $("#spLoginOtpError").hide();
                        $("#dvLoginOTPResend").hide();
                        startLoginOTPTimer();
                    }
                },
                error: function (response) {
                    $(".loading").hide();
                    if (response != null && response.responseText) {
                        var obj = JSON.parse(response.responseText);
                        if (obj.Meg) {
                            $("#spLoginOtpError").html(obj.Meg).show();
                        }
                    } else {
                        $("#spLoginOtpError").html("Failed to resend OTP. Please try again.").show();
                    }
                }
            });
        });

        function startLoginOTPTimer() {
            var countdown = 20 * 60 * 30; // 10 minutes in ms (same as OTPCheck page)
            $("#dvLoginOTPResend").hide();
            var timerId = setInterval(function () {
                countdown -= 1000;
                var min = Math.floor(countdown / (60 * 1000));
                var sec = Math.floor((countdown - (min * 60 * 1000)) / 1000);
                $("#dvLoginOTPTimer").show();

                if (countdown <= 0) {
                    clearInterval(timerId);
                    $("#dvLoginOTPTimer").hide();
                    $("#dvLoginOTPResend").show();
                } else {
                    if (sec < 10) {
                        $("#LoginOTPTimerCounter").text("Didn't Receive OTP ? Resend OTP in 0" + min + ":0" + sec + " Sec ");
                    } else {
                        $("#LoginOTPTimerCounter").text("Didn't Receive OTP ? Resend OTP in 0" + min + ":" + sec + " Sec ");
                    }
                }
            }, 1000);
        }
        // ========== End Login OTP Section ==========
    </script>

</body>
</html>
