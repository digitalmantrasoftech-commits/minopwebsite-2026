<body class="dev_login">

    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PCTFFT3" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="page-wrapper">

        <!-- ---------------------------------Header start -------------------------------- -->
        @Html.Partial("_HeaderAPIPartial")
        <!-- ---------------------------------Header end -------------------------------- -->

        <div id="myModal" class="login_section">
            <div class="container">
                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12 mt-4">
                        <div class="login_details_contain">
                            <h1>Attendance API</h1>
                            <p>Facilitates the integration of biometric attendance system with web application.</p>
                            @*<img src="@Url.Content("~/app_assets/images/signin.png")" class="img-fluid" alt="cloud based attendance service" title="cloud based attendance service" />*@
                            <div class="text-center mt-3">
                                <img src="/assets/images/icon_signin.svg" class="img-fluid" alt="cloud based attendance service" title="cloud based attendance service">
                            </div>
                        </div>
                        <div class="text-center mt-2">
                            Copyright ©
                            <script>document.write(new Date().getFullYear())</script> Minopcloud All Rights Reserved.
                        </div>
                    </div>
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div id="login" class="sign_in_box mt-5">
                            <div class="logo text-center">
                                <a href="https://www.minopcloud.com/">
                                    <img class="main_logo_img" src="/AssetsNew/images/logo.svg" alt="Minop" title="Minop">
                                </a>
                            </div>
                            <h3>@PayTimeWebClient.Resource.Resource.LoginToYourAccount</h3>

                            @if (strmsg != "" && strmegsts != "")
                            {
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12 red">
                                    @if (strmegsts == "error")
                                    {
                                        <strong id="strstg" style="color:red">Error !</strong>
                                        <span style="color:red">@strmsg</span>
                                    }
                                    else
                                    {
                                        <strong id="strstg" style="color:blue">Info !</strong>
                                        <span style="color: blue">@strmsg</span>

                                    }
                                </div>
                            }
                            @using (Html.BeginForm("DeveloperLogin", "PayTime", FormMethod.Post, new { @class = "form" }))
                            {

                                <div class="form_group">
                                    <label class="form-label">@PayTimeWebClient.Resource.Resource.Email</label>
                                    @if (ViewBag.UserEmail != null)
                                    {
                                        <input class="form-control" type="text" name="UserEmail" id="UserEmail" value="@ViewBag.UserEmail" required="">
                                    }
                                    else
                                    {
                                        <input class="form-control" type="text" name="UserEmail" id="UserEmail" required="">
                                    }
                                    <span class="highlight"></span>
                                    <span class="bar"></span>
                                </div>
                                <div class="form_group">
                                    <label class="form-label">@PayTimeWebClient.Resource.Resource.Password</label>
                                    @if (ViewBag.Password != null)
                                    {
                                        <input class="form-control" type="password" name="Password" id="UserPassword" value="@ViewBag.Password" required="">
                                    }
                                    else
                                    {
                                        <input class="form-control" type="password" name="Password" id="UserPassword" required="">
                                    }
                                    <span class="highlight"></span>
                                    <span class="bar"></span>
                                </div>
                                <div class="form_group">
                                    <span class="help-block" style="color:red;" hidden id="spvalidation1"></span>
                                </div>
                                <div class="row align-items-center">
                                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-xs-6">
                                        <div class="form-check">
                                            @if (ViewBag.rememberme != null)
                                            {
                                                if (ViewBag.rememberme == "true")
                                                {
                                                    <input class="form-check-input" type="checkbox" value="true" id="rememberme" name="rememberme" checked>
                                                    <label class="form-check-label" for="rememberme">@PayTimeWebClient.Resource.Resource.rememberme</label>
                                                }
                                            }
                                            else
                                            {
                                                <input class="form-check-input" type="checkbox" value="" id="rememberme" name="rememberme">
                                                <label class="form-check-label" for="rememberme">@PayTimeWebClient.Resource.Resource.rememberme</label>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-xs-6">
                                        <a href="javascript:void(0)" class="forgot_password_btn" id="forgotpass">@PayTimeWebClient.Resource.Resource.ForgotPassword?</a>
                                    </div>
                                </div>
                                <div class="text-center mt-3">
                                    <button type="submit" class="register_btn" id="btnsubmit">@PayTimeWebClient.Resource.Resource.mnuLogin</button>
                                </div>
                                <div class="row align-items-center mt-3">
                                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <p class="need_an_sign_up">
                                            <span>Don't have an account? </span><a href="@Url.Content("/paytime/DevelopersAccount#Sign_Up")" class="btn_Sign_Up"> Sign Up</a>

                                        </p>
                                    </div>
                                </div>
                            }

                        </div>

                        <div id="register" class="sign_up_box mt-5" style="display:none;">
                            <div class="logo text-center">
                                <a href="https://www.minopcloud.com/">
                                    <img class="main_logo_img" src="/AssetsNew/images/logo.svg" alt="Minop" title="Minop">
                                </a>
                            </div>
                            <h3>@PayTimeWebClient.Resource.Resource.CreateAnAccount</h3>
                            <div class="text-center">
                                <span class="help-block" style="color:red;" id="sperror"></span>
                            </div>
                            <div class="form_group">
                                <label class="form-label">Company Name</label>
                                <input class="form-control" type="text" name="txtCompanyName" id="txtCompanyName" required="" maxlength="50" onkeypress="return blockSpecialCharAllowSpace(event)" />
                                <span class="highlight"></span>
                                <span class="bar" id="sp1"></span>
                            </div>
                            <div class="form_group">
                                <label class="form-label">@PayTimeWebClient.Resource.Resource.Email</label>
                                <input class="form-control" type="text" name="txtEmail" id="txtEmail" required />
                                <span class="highlight"></span>
                                <span class="bar" id="sp2"></span>
                            </div>
                            <div class="form_group">
                                <label class="form-label">@PayTimeWebClient.Resource.Resource.Password</label>
                                <input class="form-control" type="password" name="password" id="password" required />
                                <span class="bar" id="sp4"></span>
                                <span class="strength"></span>
                                @*<a class="show-password" href="">Show password</a>*@
                            </div>
                            <div class="form_group">
                                <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                            </div>
                            <div class="text-center mt-3">
                                <button type="button" class="register_btn" id="btnregistersubmit">@PayTimeWebClient.Resource.Resource.Register</button>
                            </div>
                            <div class="row align-items-center mt-3">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <p class="need_an_sign_up">
                                        <span>Do you have an account? </span>
                                        <a href="@Url.Content("/paytime/DevelopersAccount#Sign_In")" class="btn_Sign_In">Sign In</a>
                                    </p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ---------------------------------footer start -------------------------------- -->
        <footer class="sign_footer" style="display: none">
            <div class="auto-container">
                <div class="row">
                    <div class="col-xl-7 col-lg-7 col-md-7 col-sm-12 col-xs-12">
                        <p>
                            Copyright ©
                            <script>document.write(new Date().getFullYear())</script> Mantra Softech (India) Pvt. Ltd. All Rights Reserved.
                        </p>
                    </div>
                    <div class="col-xl-5 col-lg-5 col-md-5 col-sm-12 col-xs-12">
                        <div class="social_link">
                            <a href="https://www.facebook.com/Mantra.Biometrics/">
                                <i class="mereposicon_facebook"></i>
                            </a>
                            <a href="https://twitter.com/mantratec">
                                <i class="mereposicon_twitter"></i>
                            </a>
                            <a href="https://in.linkedin.com/company/mantra-softech">
                                <i class="mereposicon_linkedin"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- ---------------------------------footer end -------------------------------- -->
        @*<div class="modal_bg loading" aria-hidden="true">
                <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" />
            </div>*@

    </div>



    <script type="text/javascript">
        document.createElement('header');
        document.createElement('nav');
        document.createElement('section');
        document.createElement('article');
        document.createElement('aside');
        document.createElement('footer');
    </script>
    <script>
        $(document).ready(function () {
            $(document).bind("contextmenu", function (e) {
                e.preventDefault();
            });
            $(document).keydown(function (e) {
                if (e.which === 123) {
                    return false;
                }
                if (e.ctrlKey && e.shiftKey && e.keyCode == 'I'.charCodeAt(0)) {
                    return false;
                }
                if (e.ctrlKey && e.shiftKey && e.keyCode == 'J'.charCodeAt(0)) {
                    return false;
                }
                if (e.ctrlKey && e.keyCode == 'U'.charCodeAt(0)) {
                    return false;
                }
            });
            @*if ('@strmsg' != null && '@strmsg' != "") {
                $("#myModal").attr("style", "display:block");
                $("#myModal").removeClass();
                $("#myModal").addClass("modal fade in");
            }*@


            var LoginType = '@LoginType';
            if (LoginType != 'SignUP') {
                var pathname = window.location.href;
                if (pathname.indexOf("#Sign_Up") != -1) {
                    $(".sign_in_box").css("display", "none");
                    $(".sign_up_box").css("display", "block");
                }
                else if (pathname.indexOf("#Sign_In") != -1) {
                    $(".sign_in_box").css("display", "block");
                    $(".sign_up_box").css("display", "none");
                }
                else {
                    $(".sign_in_box").css("display", "block");
                    $(".sign_up_box").css("display", "none");
                }
            }
            else {
                $(".sign_in_box").css("display", "block");
                $(".sign_up_box").css("display", "none");
            }


            $(".btn_Sign_Up").click(function () {

                $(".sign_in_box").css("display", "none");
                $(".sign_up_box").css("display", "block");

                //$("#login").hide();
                //$("#register").show();
            });
            $(".btn_Sign_In").click(function () {

                $(".sign_in_box").css("display", "block");
                $(".sign_up_box").css("display", "none");

                //$("#login").show();
                //$("#register").hide();
            });

            $("#loginclick").click(function () {
                clearallstuff();
                //$("#loginclick").attr("data-target", "#myModal");
            });
            $(".romana_slider_btn1").click(function () {
                clearallstuff();
                $("#login").hide();
                $("#register").show();
            });

            $("#btnsubmit").click(function () {
                if ($('#UserEmail').val() == "") {
                    $("#spvalidation1").html('Please Enter Email ID').show();
                    $("#UserEmail").addClass('field_error');
                    $("#sp2").hide();
                    $("#UserEmail").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#UserEmail").removeClass('field_error');
                    $("#spvalidation1").hide();
                }
                var filter = new RegExp(/^[_A-Za-z0-9-]+(\.[_A-Za-z0-9-]+)*@@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*(\.[A-Za-z]{2,4})$/);
                if (!filter.test($("#UserEmail").val())) {
                    $("#spvalidation1").html('@PayTimeWebClient.Resource.Resource.EmailValidation').show();
                    $("#UserEmail").addClass('field_error');
                    $("#sp2").hide();
                    $("#UserEmail").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#UserEmail").removeClass('field_error');
                    $("#spvalidation1").hide();
                }
                if ($('#UserPassword').val() == "") {
                    $("#spvalidation1").html('@PayTimeWebClient.Resource.Resource.PasswordValidation').show();
                    $("#UserPassword").addClass('field_error');
                    $("#sp4").hide();
                    $("#UserPassword").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#UserPassword").removeClass('field_error');
                    $("#spvalidation1").hide();
                }
            });
            $("#btnregistersubmit").click(function (event) {
                if ($('#txtCompanyName').val() == "") {
                    $("#spvalidation").html('@PayTimeWebClient.Resource.Resource.CompanyNameValidation').show();
                    $("#txtCompanyName").addClass('field_error');
                    $("#sp1").hide();
                    $("#txtCompanyName").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#txtCompanyName").removeClass('field_error');
                    $("#spvalidation").hide();
                }
                if ($("#txtCompanyName").val().length < 3) {
                    $("#spvalidation").html('@PayTimeWebClient.Resource.Resource.CompanyNameLengthValidation').show();
                    $("#txtCompanyName").addClass('field_error');
                    $("#sp1").hide();
                    $("#txtCompanyName").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#txtCompanyName").removeClass('field_error');
                    $("#spvalidation").hide();
                }

                if ($('#txtEmail').val() == "") {
                    $("#spvalidation").html('@PayTimeWebClient.Resource.Resource.CompanyEmailValidation').show();
                    $("#txtEmail").addClass('field_error');
                    $("#sp2").hide();
                    $("#txtEmail").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#txtEmail").removeClass('field_error');
                    $("#spvalidation").hide();
                }
                var filter = new RegExp(/^[_A-Za-z0-9-]+(\.[_A-Za-z0-9-]+)*@@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*(\.[A-Za-z]{2,4})$/);
                if (!filter.test($("#txtEmail").val())) {
                    $("#spvalidation").html('@PayTimeWebClient.Resource.Resource.EmailValidation').show();
                    $("#txtEmail").addClass('field_error');
                    $("#sp2").hide();
                    $("#txtEmail").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#txtEmail").removeClass('field_error');
                    $("#spvalidation").hide();
                }
                if ($('#password').val() == "") {
                    $("#spvalidation").html('@PayTimeWebClient.Resource.Resource.PasswordValidation').show();
                    $("#password").addClass('field_error');
                    $("#sp4").hide();
                    $("#password").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#password").removeClass('field_error');
                    $("#spvalidation").hide();
                }

                //if ($('#password').val().length < 6) {
                //    $("#spvalidation").html('The password length must be greater than 6.').show();
                //    $("#password").addClass('field_error');
                //    $("#sp4").hide();
                //    $("#password").focus();
                //    event.preventDefault();
                //    return false;
                //}
                //else {
                //    $("#password").removeClass('field_error');
                //    $("#spvalidation").hide();
                //}
                var regexpPwd = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;
                if (!regexpPwd.test($("#password").val())) {
                    $("#spvalidation").html('Password must contain eight characters, at least one uppercase letter and one lowercase letter, one number and one special character(@@,$,!,%,*,?,&).').show();
                    $("#password").addClass('field_error');
                    $("#sp4").hide();
                    $("#password").focus();
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#password").removeClass('field_error');
                    $("#spvalidation").hide();
                }

                register();
            });
            $("#forgotpass").click(function () {
                location.href = '/PayTime/DevelopersPassword/';
            });
        });
        function blockSpecialCharAllowSpace(e) {
            var k = e.keyCode;
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
        }
        function clearallstuff() {
            //Register
            $("#txtCompanyName").val("");
            $("#txtEmail").val("");
            $("#password").val("");
            $("#spvalidation").val("");
            $("#spvalidation").hide();
            $(".strength").text('');
            $(".password-background").removeAttr('style');
            $(".password-background").attr('style', 'height:10px;');
            $("#login").show();
            $("#register").hide();
        }

        function register() {
            var webapiuri = '@_webapiurl';
            var CompanyName = $('#txtCompanyName').val();
            var Email = $('#txtEmail').val();
            var Password = $('#password').val();
            var PlanId = 3;
            $.ajax({
                contentType: 'application/json',
                dataType: 'json',
                type: 'post',
                data: '{"CompanyName": "' + CompanyName + '", "Email":"' + Email + '", "Password":"' + Password + '","PlanId":"' + PlanId + '"}',
                url: webapiuri + 'Registration/RegisterDeveloper',
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (result) {
                    $(".loading").hide();
                    alert('@PayTimeWebClient.Resource.Resource.RegistrationSucessfull');
                    location.href = '/PayTime/DevelopersAccount/';
                },
                error: function (result) {
                    $(".loading").hide();
                    $("#sperror").html("Oops! " + result.responseJSON.Meg).show();
                    $("#txtCompanyName").removeClass('field_error');
                    $("#txtEmail").removeClass('field_error');
                    $("#password").removeClass('field_error');
                },

            });

        }
    </script>
</body>
</html>
