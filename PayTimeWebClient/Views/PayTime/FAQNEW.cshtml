                                        <i class="fa fa-angle-down" aria-hidden="true"></i>
                                    </div>
                                </div>
                                <div class="accordion-body">
                                    <p><b>How to Export Data:</b></p>
                                    <ul>
                                        <li>
                                            Go to Analytics dashboard - Reports

                                        </li>
                                        <li>
                                            Choose the report (e.g., Daily InOut,  Leave Balance Summary).

                                        </li>
                                        <li>
                                            Select the date range.

                                        </li>
                                        <li>
                                            Click Export to download the data in PDF or Excel format.


                                        </li>

                                    </ul>
                                    <div class="slider-container" id="Report">
                                        <div class="slide-wrapper">
                                            <div class="slide-block" id="slide-block-4">
                                                <img src="~/assets/images/faq_img/Report.jpg" alt="Report" />
                                                <div class="hover-buttons">
