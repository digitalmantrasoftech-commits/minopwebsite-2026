@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Employee Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
}
<script type="text/javascript">
    GetEmployee();
    $("document").ready(function () {
        $("#ChangePassword").click(function () {
            if ($("#ddlEmployee").val() == 0)
            {
                toastr.remove();
                toastr.error("Please select employee.");
                return false;
            }
            var empId = $("#ddlEmployee").val();
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + 'Dashboard/EmployeeChangePassword?empId=' + empId,
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    $("#ajax_loader").hide();
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    if(response != null)
                    {
                        if (response.MegSts == 'ok') {
                            $("#ddlEmployee").val('0').trigger('change');
                            toastr.remove();
                            toastr.success(response.Meg);
                        }
                        else {
                            toastr.remove();
                            toastr.success(response.Meg);
                           
                        }
                    }
                },
                error: function (response) {
                    $("#ajax_loader").hide();
                    if (response != null) {
                        var obj = JSON.parse(response.responseText);
                        if (obj.MegSts == 'error') {
                            toastr.remove();
                            toastr.error(obj.Meg);
                        }
                    }
                }

            });
            

        });
    });
    function GetEmployee() {
        $("#ddlEmployee").empty();
        $.ajax({
            type: "GET",
            url: '@_webapiurl' + 'Master/GetallEmployee?companyid=0&branchid=0&empid=0',
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                response.sort(function (a, b) {
                    return a.EmpName.localeCompare(b.EmpName);
                });
                if (response != null) {
                    for (var i = 0; i < response.length; i++) {
                        $("#ddlEmployee").append("<option value='" + response[i].EmpId + "'>" + response[i].EmpName +"(" + response[i].Empcode + ")"+ "</option>");
                    }
                }
            }
        });
    };
        
</script>
<div class="page-bar">
    @if (_RoleId == 1)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/EmployeeChangePassword"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Employee Change Password</span>
            </li>
        </ul>
    }
</div>
@if (_RoleId == 1)
{
    <div class="portlet">
        <div class="portlet-body">
            <div class="row">
                <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
                    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <div class="form-group">
                        <label class="control-label">Employee <span class="required" aria-required="true"> * </span></label>
                        <select class="form-control input-sm select2" id="ddlEmployee" name="ddlEmployee">
                            <option value="0" selected>Select Employee</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12  padding-top-20" id="Search_OPtion">
                    <button type="button" id="ChangePassword" class="search_btn" title="Change Password"><i class="fa-light fa-key" aria-hidden="true"></i></button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess.</span>
}
<style>
    .search_operation_btn {
        border: 1px solid #2291c8;
        background-color: #2291c8;
        color: white;
        border-radius: 3px;
        display: inline-block;
        font-weight: 400;
        text-align: center;
        vertical-align: middle;
        padding: 5px;
        margin: 20px 0px 0px 0px;
    }
</style>