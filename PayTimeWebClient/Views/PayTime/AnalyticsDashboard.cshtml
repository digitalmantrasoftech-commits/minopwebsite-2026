@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    string _Message = string.Empty;
    string _error = string.Empty;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    if (_RoleId == 15)
    {
        ViewBag.Title = "Analytics Dashboard";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
        _Message = ViewBag.msg;
        _error = ViewBag.error;
    }
}
<script src="~/Scripts/toastr.min.js"></script>
<link href="~/Content/toastr.min.css" rel="stylesheet" />
<script type="text/javascript">
    $(document).ready(function () {
        $("#quick-search-switcher").click(function () {
            $("#quick-search").toggleClass("quick-search-visible");
            var today = new Date();
            $('#frmdate').datepicker({
                format: 'yyyy-mm-dd',
                autoclose: true,
                endDate: "today",
                maxDate: today
            }).on('changeDate', function (ev) {
                $(this).datepicker('hide');
            });
            $('#todate').datepicker({
                format: 'yyyy-mm-dd',
                autoclose: true,
                endDate: "today",
                maxDate: today
            }).on('changeDate', function (ev) {
                $(this).datepicker('hide');
            });
        });
        $("#btnsearch").click(function (event) {
            search(event)
        });
        function search(event) {
            var datefrom = $("#frmdate").val();
            var todate = $("#todate").val();
            if (datefrom > todate) {
                toastr.remove();
                toastr.error("To date should be greater than from date.");
                event.preventDefault();
                return false;
            }
        }
    });
</script>
@if (_RoleId == 15)
{
    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Analytics DashBoard</span>
            </li>
        </ul>

        <div>
            <div class="report_title">
                <p>Analytics Dashboard</p>
            </div>
            <div class="page-toolbar poll-right">
                <button type="button" id="quick-search-switcher" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Filter"><i class="fa-light fa-filter"></i></button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="loader" id="myLoader" style="display:none">Loading...</div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            @using (Html.BeginForm("AnalyticsDashboard", "PayTime", FormMethod.Post, new { @class = "quick-search admin_search", id = "quick-search" }))
            {
                <fieldset>
                    <div class="row">
                        <div class="col-md-4 col-sm-4">
                            <div class="form-group">
                                <label> From Date:</label>
                                <div class="input-group  input-group-sm  date date-picker" data-date="@DateTime.Now" data-date-format="yyyy-mm-dd" data-date-viewmode="years" id="srchfromdt">
                                    <span class="input-group-btn">
                                        <button class="btn default" type="button" disabled>
                                            <i class="fa-light fa-calendar-days"></i>
                                        </button>
                                    </span>
                                    <input type="text" placeholder="yyyy-mm-dd" class="form-control" id="frmdate" name="frmdate" autocomplete="off">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-4">
                            <div class="form-group">
                                <label> To Date:</label>
                                <div class="input-group  input-group-sm  date date-picker" data-date="@DateTime.Now" data-date-format="yyyy-mm-dd" data-date-viewmode="years" id="srchtodt">
                                    <span class="input-group-btn">
                                        <button class="btn default" type="button" disabled>
                                            <i class="fa-light fa-calendar-days"></i>
                                        </button>
                                    </span>
                                    <input type="text" placeholder="yyyy-mm-dd" class="form-control" id="todate" name="todate" autocomplete="off">
                                    <input type="hidden" id="Type" name="Type" value="1" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2" style="margin-top: 24px;">
                            <button type="submit" class="btn icon_btn tooltips" id="btnsearch" data-placement="top" data-original-title="Search by Filters">
                                <i class="fa-solid fa-magnifying-glass" style="font-size:13px;"></i>
                                <span class="ladda-spinner"></span><div class="ladda-progress" style="width: 0px;"></div>
                            </button>
                        </div>
                    </div>
                </fieldset>
            }
        </div>
    </div>

    <div class="clearfix"></div>
    <div class="row widget-row">
        @foreach (var item in ViewBag.Analyticsdata)
        {
            <div class="col-md-3">
                <div class="admin-widget_bg">
                    <a class="title" href="/PayTime/SuperAdminAnalyticsDetails?fname=@item.colname" id="btnregistercmp">
                        <div class="admin-widget_title"><i class="fa-regular fa-file-lines"></i><span>@item.colname</span></div>
                    </a>
                    <div class="dashboard-block">
                        <div class="dashboard-count db-count-text">
                            <div class="db-subblock">
                                <div class="db-subblock-title">No of Clicks</div>
                                <div class="db-subblock-title db-subblock-value" id="noofclick">@item.Noofclick</div>
                            </div>
                            <div class="db-subblock">
                                <div class="db-subblock-title">No of Visits</div>
                                <div class="db-subblock-title db-subblock-value" id="noofvisits">@item.Noofvisits</div>
                            </div>
                            <div class="db-subblock">
                                <div class="db-subblock-title">Time Duration</div>
                                <div class="db-subblock-title db-subblock-value" id="timeduration">@item.timeduration</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>

<style>
    .quick-search {
        background: #fff none repeat scroll 0 0;
        margin-bottom: 30px;
        border-radius: 4px;
        box-shadow: 0 2px 18px 1px rgba(49, 53, 72, 0.1);
        padding: 5px 15px;
        margin: -260px 0 0;
    }

    .quick-search-visible {
        margin: 0 0 16px;
    }

    .form-group {
        position: relative;
    }

    .page-content-white .page-content .page-bar {
        border-bottom: none;
    }
</style>