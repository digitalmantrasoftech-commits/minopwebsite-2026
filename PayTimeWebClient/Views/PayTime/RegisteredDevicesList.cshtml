@model PayTimeWebClient.Models.ActiveDevicesDetails
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{

    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    if (_RoleId == 15)
    {
        ViewBag.Title = "RegisteredDevicesDetails";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
    }

}
<script type="text/javascript">
    $(document).ready(function () {
        $('#tblactivedevices').DataTable({
            dom: _domCommon,
            language: _languageCommon,
        });
        setTimeout(function () {
            $("#" + "tblactivedevices" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
    });
</script>

@if (_RoleId == 15)
{

    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> DashBoard</span>
            </li>
        </ul>
        <div class="report_title">
            <p>Registered Devices</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="portlet">
                <div class="portlet-body">
                    <div style="width:100%;margin-left:auto;margin-right:auto;">
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tblactivedevices" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column ">
                                <thead>
                                    <tr>
                                        <th>No</th>
                                        <th hidden>CompanyId</th>
                                        <th>Company Name</th>
                                        <th>Company Code</th>
                                        <th>Device Name</th>
                                        <th>Device SrNo</th>
                                        <th>Device Code</th>
                                        <th>Device IP</th>
                                        <th hidden>BranchId</th>
                                        <th>Device Status</th>
                                        <th>Registered With</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int n = 1;
                                    }
                                    @if (Model.ActiveDevicesDetailslist != null)
                                    {
                                        foreach (var i in Model.ActiveDevicesDetailslist)
                                        {
                                            <tr>
                                                <td id="sr">@n</td>
                                                <td hidden> @i.CompanyId </td>
                                                <td>@i.CompanyName</td>
                                                <td>@i.CompanyCode</td>
                                                <td>@i.DeviceName</td>
                                                <td>@i.DeviceSrNo</td>
                                                <td>@i.DeviceCode</td>
                                                <td>@i.DeviceIP</td>
                                                <td hidden>@i.BranchId</td>

                                                @if (i.DeviceStatus.ToLower() == "offline")
                                                {
                                                    <td style="color:red;"><b>@i.DeviceStatus</b></td>
                                                }
                                                else if (i.DeviceStatus.ToLower() == "online")
                                                {
                                                    <td style="color:green;"><b>@i.DeviceStatus</b></td>
                                                }
                                                else
                                                {
                                                    <td style="color:blue;"><b> @i.DeviceStatus</b></td>
                                                }
                                                <td>@i.DeviceRegisteredWith</td>

                                            </tr>
                                            n++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}