        function formatedate(data) {
            var date = new Date(data),
                locale = "en-us",
            //month = date.toLocaleString(locale, { month: "short" });
            month = date.getMonth() + 1;
            if (month < 10) {
                month = '0' + month;
            }
            var day = date.getDate();
            if ("@_isdateformat" == "dd-mm-yyyy") {
                return (day > 9 ? day : "0" + day) + "-" + month + "-" + date.getFullYear();
            }
            else if ("@_isdateformat" == "yyyy-mm-dd") {
                return date.getFullYear() + "-" + month + "-" + (day > 9 ? day : "0" + day);
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                //return date.getFullYear() + "-" + month + "-" + (day > 9 ? day : "0" + day);
                return month + "-" + (day > 9 ? day : "0" + day) + "-" + date.getFullYear();
            }
            // to get the dateformat of dd-M-yyyy,M-dd-yyyy,yyyy-M-dd.
            var Responce = getDateformatSelected("@_isdateformat", data);
            return Responce;
            //return (day > 9 ? day : "0" + day) + "-" + month + "-" + date.getFullYear();
        }


