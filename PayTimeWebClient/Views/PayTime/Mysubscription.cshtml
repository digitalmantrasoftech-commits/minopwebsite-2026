                        else if ("@_isdateformat" == "yyyy-mm-dd") {
                            var _orderDate = data[index].Orderdate.split("-");
                            var orderDate = _orderDate[0] + "-" + _orderDate[1] + "-" + _orderDate[2]
                            _Productcart += "<p><b>Order Placed on:</b><span>" + orderDate + "</span></p></div>";
                        }
                        else if ("@_isdateformat" == "yyyy-M-dd") {
                            var _orderDate = data[index].Orderdate.split("-");
                            var dateMM = _orderDate[1];
                            var orderDate = _orderDate[0] + "-" + GetMonthName(dateMM) + "-" + _orderDate[2]
                            _Productcart += "<p><b>Order Placed on:</b><span>" + orderDate + "</span></p></div>";
                        }
                        else if ("@_isdateformat" == "M-dd-yyyy") {
                            var _orderDate = data[index].Orderdate.split("-");
                            var dateMM = _orderDate[1];
                            var orderDate = GetMonthName(dateMM) + "-" + _orderDate[2] + "-" + _orderDate[0]
                            _Productcart += "<p><b>Order Placed on:</b><span>" + orderDate + "</span></p></div>";
                        }
                        else if ("@_isdateformat" == "dd-M-yyyy") {
                            var _orderDate = data[index].Orderdate.split("-");
                            var dateMM = _orderDate[1];
                            var orderDate = _orderDate[2] + "-" + GetMonthName(dateMM) + "-" + _orderDate[0]
                            _Productcart += "<p><b>Order Placed on:</b><span>" + orderDate + "</span></p></div>";
                        }
                        //_Productcart += "<p><b>Order Placed on:</b><span>" + data[index].Orderdate + "</span></p></div>";
                        _Productcart += "<div class='col-lg-6 col-md-6 col-sm-6 col-xs-12'>";
                        _Productcart += "<p><b>Order ID:</b><span>" + data[index].OrderID + "</span></p>";
                        _Productcart += "</div></div></div>";
                    }
                    _Productcart += "<ul class='order_history_body'>";
                    _Productcart += "<li>";
                    _Productcart += "<img id='device_img_PR000' src='" + _img + "' alt='" + _imgname + "' />";
                    _Productcart += "<p class='name'><b>Name:</b><span id='device_name_PR000" + index + "'>" + data[index].Product_name + "</span></p>";
                    _Productcart += "<p class='quantity'><b>Quantity:</b><span id='device_quantity_PR000" + index + "'>" + data[index].Quantity + "</span></p>";
                    _Productcart += "<p class='extended_warranty'><b>Extended Warranty:</b><span id='extended_warranty_PR000" + index + "'>" + data[index].ExtendedWarranty + "</span></p>";
                    _Productcart += "<p class='price'><b>Pincode:</b><span id='device_price_PR000" + index + "'>" + data[index].IntallationServicePincode + "</span></p>";
                    _Productcart += "<p class='intallation_service'><b>Installation Service:</b><span id='intallation_service_PR000" + index + "'>" + data[index].IntallationService + "</span></p>";
                    _Productcart += "<p class='total'><b>Total:</b><span id='device_total_PR000" + index + "'>₹" + data[index].Total + "/- (Without Tax price)</span></p>";
                    _Productcart += "</li>";
                    _Productcart += "</ul>";

                });
                $("#dvorderdetails").append(_Productcart);
            },
            error: function (req, status, errorObj) {
            }
        });

    }

</script>




