        function Placeservice(latlng, geocoder) {
            var _placename = '';
            geocoder.geocode({ 'location': latlng }, function (results, status) {
                if (status === 'OK') {
                    if (results[0]) {
                        _placename = results[0].formatted_address;
                        $("#SchoolAddress").val(_placename);
                    } else {
                        window.alert('No results found');

                    }
                } else {
                    window.alert('Geocoder failed due to: ' + status);
                }
            });
        }
        function Getposlatlng(strlocation) {
            var input = strlocation.replace('(', '').replace(')', '');
            var latlngStr = input.split(',', 2)
            var latlng = new google.maps.LatLng(parseFloat(latlngStr[0]), parseFloat(latlngStr[1]));
            return latlng;
        }
