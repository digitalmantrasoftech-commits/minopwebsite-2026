@using PayTimeWebClient.ViewModels;
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@model CompanyViewModel
@{
    ViewBag.Title = "System Setting Wizard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string IsSettingFlag = HttpContext.Current.Session["IsSetting"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string IsSchool = HttpContext.Current.Session["IsSchool"].ToString();
    string IsOffice = HttpContext.Current.Session["IsOffice"].ToString();
    string _isPlanEss = "";
    string _isPlanFace = "";
    if (HttpContext.Current.Session["isPlanEss"].ToString() != null)
    {
        _isPlanEss = HttpContext.Current.Session["isPlanEss"].ToString();
    }
    if (HttpContext.Current.Session["isPlanFace"].ToString() != null)
    {
        _isPlanFace = HttpContext.Current.Session["isPlanFace"].ToString();
    }
    string _isDateFormatNew = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _CountryCode = HttpContext.Current.Session["CountryCode"].ToString();
    string _AreaCode = HttpContext.Current.Session["AreaCode"].ToString();
    int _isStandard = ViewBag.isStandard;
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _PlanId = HttpContext.Current.Session["planId"].ToString();
    string _lockAttendanceDay = HttpContext.Current.Session["lockAttendanceDay"].ToString();
    bool isMatch = ViewBag.IsMatch;

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBZKLtQG-hhnOXL3OFg7uJzlusQj38k0VU&libraries=places" async defer></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/build_c/js/intlTelInput-jquery.js"></script>
<script src="~/build_c/js/intlTelInput-jquery.min.js"></script>
<script src="~/build_c/js/intlTelInput.min.js"></script>
<link href="~/build_c/css/intlTelInput.css" rel="stylesheet" />
<script src="~/build_c/js/utils.js"></script>
<script src="~/Scripts/timeme.js"></script>
<style>
    .lead {
        color: red;
    }

    .iti {
        width: 100%;
    }

    .well {
        height: 100% !important;
    }

    .sw-theme-default > ul.step-anchor > li.active > a {
        color: #000000;
        border-bottom: 2px solid #a9a9a9 !important;
    }

    .sw-theme-default > ul.step-anchor > li.done > a:hover {
        border-bottom: 2px solid #a9a9a9 !important;
        color: #000000 !important;
    }

    .tabs-left.nav-tabs > li, .tabs-right.nav-tabs > li {
        float: left !important;
    }

    #smartwizard .well {
        border-radius: 6px !important;
    }

    .event_block .nav-tabs > li > a:hover, .event_block .nav-tabs > li > a:focus {
        color: #bbb;
        border: transparent !important;
    }
</style>

<!-- BEGIN PAGE BAR -->
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> System Setting Wizard</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> System Setting Wizard</span>
            </li>
        </ul>
    }
</div>
<!-- END PAGE BAR -->
<!-- END PAGE HEADER-->

