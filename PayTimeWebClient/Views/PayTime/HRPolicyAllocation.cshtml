@model PayTimeWebClient.Models.reqPolicydata
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "HRPolicyAllocation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = "";
    string _error = "";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _dbName = HttpContext.Current.Session["DbName"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
@*<style>
    #export-button{
        display:none;
    }*@
<!--</style>-->
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<script type="text/javascript">
    var $empselect = "";
    var empidlst = 0;
    var comidlst = 0;
    var branchidlst = 0;
    var desigidlst = 0;
    var deptidlst = 0;
    var roleidlst = 0;
    var count = 0;
    var form = "HRPolicy Allocation";
    var operation = "";
    $(document).ready(function () {
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        $(".alert").hide();
        if ("@_Message" != "") {
            toastr.remove();
            toastr.success("@_Message");
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
        }
        //for branch
        var $select = $("#BranchId").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Branch',
        });
        $select.multiselect('disable'); //disable it initially


        //foremployee
        $empselect = $("#EmpId").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Employee',
        });
        $empselect.multiselect('disable'); //disable it initially

        $("#companyID").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Company',
        });
        $(document.body).on('change', '#companyID', function () {
            $("#spvalidation").hide();
            var comid = $('#companyID option:selected');
            var comarray = [];
            $(comid).each(function (index, comid) {
                comarray.push([$(this).val()]);
            });
            if (comarray == "") {
                $("#txt1").val(0);
            }
            else {
                $("#txt1").val(comarray);
            }
            if ($("#txt1").val() != 0) {
                comidlst = $("#txt1").val();
                AllDatafromChangeFire(comidlst, branchidlst, deptidlst, desigidlst, roleidlst, empidlst);
                $("#BranchId").empty();
                $.ajax({
                    type: "GET",
                    url: "/MasterData/FillBranchesbyCompanyChange",
                    data: { comidlst: comidlst },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $(".loading").show();
                    },
                    success: function (response) {

                        if (response != "") {
                            var obj = JSON.stringify(response);
                            $select.multiselect('enable');
                            $("#DepartmentID").multiselect('enable');
                            $empselect.multiselect('enable');
                            $("#DesignationId").multiselect('enable');
                            $("#RoleId").multiselect('enable');
                            $("#BranchId").empty();
                            response.sort(function (a, b) {
                                return a.BranchName.localeCompare(b.BranchName);
                            });
                            for (var i = 0; i < response.length; i++) {
                                $('#BranchId').append('<option value=" ' + response[i].BranchId + ' ">' + response[i].BranchName + '</option>');
                            }
                            $select.multiselect('rebuild');
                            $(".loading").hide();
                            $(document.body).on('change', '#BranchId', function () {
                                var brid = $('#BranchId option:selected');
                                var Brancharray = [];
                                $(brid).each(function (index, brid) {
                                    Brancharray.push([$(this).val()]);
                                });
                                if (Brancharray == "") {
                                    $("#txt2").val(0);
                                }
                                else {
                                    $("#txt2").val(Brancharray);
                                }
                                var ArrBranch = $("#txt2").val();
                                branchidlst = ArrBranch;
                                AllDatafromChangeFire(comidlst, branchidlst, deptidlst, desigidlst, roleidlst, empidlst);
                            });
                        }
                        else {
                            $(".loading").hide();
                            $select.multiselect('disable'); //disable it initially
                            $("#DepartmentID").multiselect('disable');
                            $empselect.multiselect('disable');
                            $("#DesignationId").multiselect('disable');
                            $("#RoleId").multiselect('disable');
                        }
                    },
                    error: function () {
                        $(".loading").hide();
                        alert('No Data');
                    }
                });
            }
            else {
                ClearAllControls();
                return false;
            }

        });

        $("#DepartmentID").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            disable: 'disable',
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Department',
        });
        $("#DepartmentID").multiselect('disable');
        $(document.body).on('change', '#DepartmentID', function () {
            var deptid = $('#DepartmentID option:selected');
            var DeptArray = [];
            $(deptid).each(function (index, deptid) {
                DeptArray.push([$(this).val()]);
            });
            if (DeptArray == "") {
                $("#txt3").val(0);
            }
            else {
                $("#txt3").val(DeptArray);
            }
            var deptarry = $("#txt3").val();
            deptidlst = deptarry;
            AllDatafromChangeFire(comidlst, branchidlst, deptidlst, desigidlst, roleidlst, empidlst);
        });


        $("#DesignationId").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            disable: 'disable',
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Designation',
        });
        $("#DesignationId").multiselect('disable');
        $(document.body).on('change', '#DesignationId', function () {
            var designationId = $('#DesignationId option:selected');
            var Desgarray = [];
            $(designationId).each(function (index, designationId) {
                Desgarray.push([$(this).val()]);
            });

            if (Desgarray == "") {
                $("#txt4").val(0);
            }
            else {
                $("#txt4").val(Desgarray);
            }
            var desarray = $("#txt4").val();
            desigidlst = desarray;
            AllDatafromChangeFire(comidlst, branchidlst, deptidlst, desigidlst, roleidlst, empidlst);
        });


        $("#RoleId").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Role',
        });
        $("#RoleId").multiselect('disable');
        $(document.body).on('change', '#RoleId', function () {
            var roleid = $('#RoleId option:selected');
            var rolearray = [];
            $(roleid).each(function (index, roleid) {
                rolearray.push([$(this).val()]);
            });
            if (rolearray == "") {
                $("#txt5").val(0);
            }
            else {
                $("#txt5").val(rolearray);
            }
            var rolarry = $("#txt5").val();
            roleidlst = rolarry;

            AllDatafromChangeFire(comidlst, branchidlst, deptidlst, desigidlst, roleidlst, empidlst);
        });

        $("#dataTables_tbl_header").remove();
        $("#tblHrpolicyAllocation").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            "deferRender":true
        });
        setTimeout(function () {
            $("#" + "tblHrpolicyAllocation" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        $('#Btnclear').click(function () {

            $("#PolicyId").val(null);
            $("#select2-PolicyId-container").html("Select Policy");
            $("#select2-PolicyId-container").attr("title", "Select Policy");
            ClearAllControls();
        });

        $("#BtnApply").click(function () {
            count++;
            operation = "Allocation Policy";
            var policyid = $('#PolicyId option:selected').val();
            if (policyid == "") {
                toastr.remove();
                toastr.error("Please select policy.");
                return false;
            }
            else {
                $("#spvalidation").hide();
            }
            var com = $("#txt1").val();
            if (com == 0) {
                toastr.remove();
                toastr.error("Please select company.");
                return false;
            }
            else {
                $("#spvalidation").hide();
            }
            var emp = $("#txt6").val();
            if (emp == 0) {
                toastr.remove();
                toastr.error("Please select employee.");
                return false;
            }
            else {
                $("#spvalidation").hide();
            }
            var emlist = $("#txt6").val();
            $.post("/PayTime/ApplyPolicyToEmployee", { comidlst: comidlst, branchidlst: branchidlst, deptidlst: deptidlst, desigidlst: desigidlst, roleidlst: roleidlst, empidlst: emlist, policyid: policyid }, function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                var _response = $.parseJSON(response);
                if (_response == true) {
                    toastr.remove();
                    toastr.success("HR Policy allocation saved successfully.");
                    window.location.href = "/PayTime/HRPolicyAllocation";
                }
                else {
                    toastr.remove();
                    toastr.error("Something wrong occured. Please try again.");
                }
            });
        });
        $("#BtnView").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");            
            count++;
            operation = "View Policy";
            //var policyval = $('#PolicyId option:selected').val();
            //if (policyval == "") {
            //    $("#spvalidation").html("Please Select Policy").show();
            //    return false;
            //}
            //else {
            //    $("#spvalidation").hide();
            //}

            var policyid = $('#PolicyId option:selected').val();
            if (policyid == "") {
                policyid = 0;
            }
            var cmlist = $("#txt1").val();
            if (cmlist == 0) {
                toastr.remove();
                toastr.error("Please select  company.");
                return false;
            }
            else {
                $("#spvalidation").hide();
            }
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").show();
            }
            var brlist = $("#txt2").val();
            var deslist = $("#txt3").val();
            var deplst = $("#txt4").val();
            var rolelst = $("#txt5").val();
            var emlist = $("#txt6").val();
            $.post("/PayTime/ApplyPolicyView", { policyid: policyid, comidlst: cmlist, branchidlst: brlist, desigidlst: deslist, deptidlst: deptidlst, roleidlst: rolelst, empidlst: emlist }, function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                var obj = JSON.stringify(response);
                if (response.length == 0) {
                    const wrapper = $(".filter_portlet_wrapper");
                    wrapper.removeClass("full-width");
                }
                if (response != null) {
                    const detail = response;
                    handleGridVisibility("tblempty", "NotificationGrid-empty", detail, {
                        imageUrl: "emptyscreen_3.png",
                        subText: "No matching records found for the selected filters."
                    });
                }
                if (obj != "") {
                    var table = "";
                    for (var i = 0; i < response.length; i++) {
                        var tbl = "<tr class='odd gradeX'>";
                        tbl = tbl + "<td id='srn'>" + (i + 1);
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='enm'>" + response[i].EmpName;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='pnm'>" + response[i].PolicyName;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='cnm'>" + response[i].CompanyName;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='bnm'>" + response[i].BranchName;
                        tbl = tbl + "</td>";

                        tbl = tbl + "</tr>";
                        table += tbl;
                    }
                }
                if ($.fn.DataTable.isDataTable('#tblHrpolicyAllocation')) {
                    $('#tblHrpolicyAllocation').DataTable().clear().destroy();
                }
                $('#tblHrpolicyAllocation').empty();
                $('#tblHrpolicyAllocation').append(table);
                $("#dataTables_tbl_header").remove();
                $('#tblHrpolicyAllocation').dataTable({
                    dom: _domCommon,
                    language: _languageCommon,
                    "destroy": true,
                    "bInfo": true,
                    "bPaginate": true,
                    deferRender: true,
                    destroy: true,
                    bInfo: true,
                    paging: true,
                    "columns": [
                          { "title": "Sr No" ,visible:false},
                           { "title": "Employees" },
                        { "title": "Policy" },
                        { "title": "Company" },
                        { "title": "Branch" }
                    ],
                    initComplete: function () {
                        const visibleTable = $('table:visible').attr('id');
                        $("#buttons").append(`
                        <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                            <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                        </div>
                     `);

                    },
                });
                setTimeout(function () {
                    $("#" + "tblHrpolicyAllocation" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                    $('.tooltips').tooltip();
                }, 100);
            });
        });

        $("#PolicyId").change(function () {
            $("#spvalidation").hide();
        });
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View  HRPolicy Allocation";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

    });

    function ClearAllControls() {
        $("#companyID option:selected").prop("selected", false);
        $("#companyID").multiselect('refresh');
        $("#BranchId option:selected").prop("selected", false);
        $("#BranchId").multiselect('refresh');
        $("#BranchId").empty();
        $("#BranchId").multiselect('disable');
        $("#DepartmentID option:selected").prop("selected", false);
        $("#DepartmentID").multiselect('refresh');
        $("#DepartmentID").multiselect('disable');
        $("#DesignationId option:selected").prop("selected", false);
        $("#DesignationId").multiselect('refresh');
        $("#DesignationId").multiselect('disable');
        $("#RoleId option:selected").prop("selected", false);
        $("#RoleId").multiselect('refresh');
        $("#RoleId").multiselect('disable');
        $("#EmpId option:selected").prop("selected", false);
        $("#EmpId").multiselect('refresh');
        $("#EmpId").multiselect('disable');
        $("#txt1").val(0);
        $("#txt2").val(0);
        $("#txt3").val(0);
        $("#txt4").val(0);
        $("#txt5").val(0);
        $("#txt6").val(0);
        comidlst = 0;
        branchidlst = 0;
        desigidlst = 0;
        deptidlst = 0;
        roleidlst = 0;
        empidlst = 0;
    }

    function AllDatafromChangeFire(comidlst, branchidlst, deptidlst, desigidlst, roleidlst, empidlst) {
        $.ajax({
            type: "GET",
            url: "/MasterData/FillEmployeebyChange",
            data: { comidlst: comidlst, branchidlst: branchidlst, desigidlst: desigidlst, deptidlst: deptidlst, roleidlst: roleidlst, empidlst: empidlst },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loaderCompany").show();
            },
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                $("#ajax_loaderCompany").hide();
                if (response != "") {
                    var obj = JSON.stringify(response);
                    $empselect.multiselect('enable');
                    $("#EmpId").empty();
                    response.sort(function (a, b) {
                        return a.EmpName.localeCompare(b.EmpName);
                    });
                    for (var i = 0; i < response.length; i++) {
                        $('#EmpId').append('<option value=" ' + response[i].EmpId + ' ">' + response[i].EmpName + '</option>');
                    }
                    $empselect.multiselect('rebuild');
                    $(document.body).on('change', '#EmpId', function () {
                        var empid = $('#EmpId option:selected');
                        var emparray = [];
                        $(empid).each(function (index, empid) {
                            emparray.push([$(this).val()]);
                        });
                        if (emparray == "") {
                            $("#txt6").val(0);
                        }
                        else {
                            $("#txt6").val(emparray);
                        }

                        var ArrEmp = $("#txt6").val();
                        empidlst = ArrEmp;
                    });
                }
                else {
                    $empselect.multiselect('disable');
                }
            },
            error: function (jqXHR, ajaxOptions, thrownError) {
                $('.loading').hide();

                if (jqXHR.status == 500) { //InternalServerError = 500,
                    toastr.error("InternalServerError");
                } else if (jqXHR.status == 400) { //BadRequest = 400,
                    toastr.error("BadRequest");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            },
        });
    }


</script>
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> HR Policy Allocation</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> HR Policy Allocation</span>
            </li>
        </ul>
