    @if (obj.CanView)
    {
        <div class="page-toolbar">
            <a href="javascript:;" class="btn icon_transparent_btn tooltips" id="Filter_search" data-original-title="Assign policy to employee" data-placement="bottom"><i class="fa-solid fa-check" aria-hidden="true"></i></a>
        </div>
    }

</div>
@if (obj.CanView)
{
    <div class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>

    <div class="filter_portlet_wrapper full-width">
        <!-- Datatable Block : Begin -->
        <div class="portlet filter_portlet_tbl">
            <div class="portlet-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div id="tblempty">
                            @if (ViewBag.PolicyGetAll.Count != 0)
                            {
                                <div class="table-responsive" id="tableResponsive">
                                    <table id="tblHrpolicyAllocation" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column ">
                                        <thead>
                                            <tr>
                                                <th style="display:none;">Sr. No</th>
                                                <th>Employees</th>
                                                <th>Policy</th>
                                                <th>Company</th>
                                                <th>Branch</th>
                                            </tr>
                                        </thead>
                                        @{int n = 1;}
                                        <tbody>
                                            @if (ViewBag.PolicyGetAll != null)
                                            {
                                                foreach (var item in ViewBag.PolicyGetAll)
                                                {
                                                    <tr>
                                                        <td style="display:none;">@n</td>
                                                        <td>@item.EmpName</td>
                                                        <td>@item.PolicyName</td>
                                                        <td>@item.CompanyName</td>
                                                        <td>@item.BranchName</td>
                                                    </tr>
                                                    n++;
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="4">No Data Available.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div id="NotificationGrid-empty">
                                    <div class="datanotfound">
                                        <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="Nodata Found Icon">
                                        <p class="datanotfound_title">No data found</p> <!-- titleText -->
                                        <p class="">No matching records found for the selected filters.</p><!-- subText -->
                                    </div>
                                </div>
                            }
                            </div>
                            <div id="NotificationGrid-empty" style="display:none">
                                <div class="datanotfound">
                                    <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="Nodata Found Icon">
                                    <p class="datanotfound_title">No data found</p> <!-- titleText -->
                                    <p class="">No matching records found for the selected filters.</p><!-- subText -->
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
        <!-- Datatable Block : End -->
        <!-- Filter Block : Begin -->
        <div class="portlet filter_boxModal">
            <div class="filterbox_header">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="filter-title">Filters</h4>
                    <button type="button" class="filterclose_btn"><i class="fa-light fa-xmark"></i></button>
                </div>
            </div>
            <div class="filterbox_body">
                @using (Html.BeginForm("HRPolicyAllocation", "PayTime", FormMethod.Post, new { @id = "frmrpt" }))
                {
                    <div class="col-lg-12">
                        <div class="alert alert-danger popMsg" hidden>
                            <a href="#" class="close" data-dismiss="alert">&times;</a>
                            <strong id="strstg"></strong>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                    </div>
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label class="control-label">HR Policy<span class="required" aria-required="true"> * </span></label>
                            @if (ViewBag.PolicyName != null)
                            {
                                @Html.DropDownList("PolicyId", new SelectList(ViewBag.PolicyName, "PolicyId", "PolicyName"), "Select Policy", new { @class = "form-control select2" })
                            }
                            else
                            {
                                @Html.DropDownList("PolicyId", new SelectList(new[] { "" }), "Select Policy", new { @class = "form-control select2" })
                            }
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label class="control-label">Companies<span class="required" aria-required="true"> * </span></label>
                            <input type="text" id="txt1" value="0" hidden />
                            @if (ViewBag.Companyslist != null)
                            {
                                <select class="mt-multiselect btn blue btn-outline" multiple="multiple" id="companyID" data-width="100%">
                                    @foreach (var i in ViewBag.Companyslist)
                                    {
                                        <option value="@i.CompanyID">@i.CompanyName</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label class="control-label">Branches</label>
                            <input type="text" id="txt2" value="0" hidden />
                            <select id="BranchId" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%">
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label class="control-label">Departments</label>
                            <input type="text" id="txt3" value="0" hidden />
                            @if (ViewBag.DepartmentList != null)
                            {
                                <select class="mt-multiselect btn blue btn-outline" multiple="multiple" id="DepartmentID" data-width="100%">
                                    @foreach (var i in ViewBag.DepartmentList)
                                    {
                                        <option value="@i.DepartmentId">@i.DepartmentName</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label class="control-label">Designation</label>
                            <input type="text" id="txt4" value="0" hidden />
                            @if (ViewBag.DesignationList != null)
                            {
                                <select class="mt-multiselect btn blue btn-outline" multiple="multiple" id="DesignationId" data-width="100%">
                                    @foreach (var i in ViewBag.DesignationList)
                                    {
                                        <option value="@i.DesignationId">@i.DesignationName</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label class="control-label">Role</label>
                            <input type="text" id="txt5" value="0" hidden />
                            @if (ViewBag.RoleList != null)
                            {
                                <select class="mt-multiselect btn blue btn-outline " multiple="multiple" id="RoleId" data-width="100%">
                                    @foreach (var i in ViewBag.RoleList)
                                    {
                                        <option value="@i.RoleId">@i.RoleName</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label class="control-label">Employees<span class="required" aria-required="true"> * </span></label>
                            <input type="text" id="txt6" value="0" hidden />
                            <select class="mt-multiselect btn blue btn-outline" multiple="multiple" id="EmpId" data-width="100%"></select>
                        </div>
                    </div>
                }
            </div>
            <div class="filterbox_footer">
                <div class="text-right">
                    <button type="button" id="Btnclear" class="btn clear_btn tooltips" data-placement="top" data-original-title="Clear"><i class="fa-regular fa-eraser"></i></button>
                    <button type="button" id="BtnView" class="btn icon_btn margin-left-5 tooltips" data-placement="top" data-original-title="View"><i class="fa-regular fa-eye"></i></button>
                    @if (obj.CanEdit)
                    {
                        <button type="button" id="BtnApply" class="btn icon_btn margin-left-5 tooltips" data-placement="top" data-original-title="Allocation"><i class="fa-solid fa-check"></i></button>
                    }
                </div>
            </div>
        </div>
        <!-- Filter Block : End -->
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>