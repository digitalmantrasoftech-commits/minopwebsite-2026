@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{

    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    if (_RoleId == 15)
    {
        ViewBag.Title = "DeviceNotification";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
    }

}
<script type="text/javascript">
    var webapiurl = '@_webapiurl';
    $(document).ready(function () {

        var t = $('#tbldevicenotificationmail').DataTable(
       {
            dom: _domCommon,
            language: _languageCommon,
            "processing": true,
            "ajax": {
                url: '@_webapiurl' + 'DashBoard/DevicenotificationmailGetAll',
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                dataSrc: '',
            },
                "columns": [
                    { "data": null, visible:false },
                    { "data": "devicenotificationmailid" },
                    { "data": "Email" },
                    { "data": "IsMailSent" }
                ],
            "columnDefs": [
                {
                    "targets": [1],
                    "visible": false
                },
                 {
                     "searchable": false,
                     "orderable": false,
                     "targets": 0
                 }
            ],
            "order": [[1, 'asc']],
        }
        );
        setTimeout(function () {
            $("#" + "tbldevicenotificationmail" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        t.on('order.dt search.dt', function () {
            t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();


        $("#SendNotification").on('click', function () {
            $.ajax({
                type: 'POST',
                url: webapiurl + "/DashBoard/SendNotification",
                contentType: "application/json",
                dataType: 'json',
                async: false,
                cache: false,
                timeout: 300000,
                success: function (data) {
                    alert(data.Msg);
                    //window.location.href = "SmsTemplate";
                },
                error: function (data) {
                    alert(data.responseJSON.Msg);
                },
            });
        });
    });
</script>

@if (_RoleId == 15)
{<div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Device Notification</span>
            </li>
        </ul>
        <div class="page-toolbar">
            <a href="javascript:void(0)" id="SendNotification" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Send Device Notification"><i class="fa-regular fa-paper-plane"></i></a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="portlet">
                <div class="portlet-body">
                    <div style="width:100%;margin-left:auto;margin-right:auto;">
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tbldevicenotificationmail" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column">
                                <thead>
                                    <tr>
                                        <th style="display:none;">Sr. No</th>
                                        <th hidden>devicenotificationmailid</th>
                                        <th>Email</th>
                                        <th>Is Mail Sent</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}


