@{
    Layout = "~/Views/Shared/_LayoutLandingCloud.cshtml";
}
@section metatags{
<title>User Guide | Minop</title><meta name="keywords" content="Minop User Guide"><meta name="description" content="Everything you need to know to troubleshoot errors and to get the most out of Minop."><link id="canonical" rel="canonical" href="https://app.minopcloud.com/User-Guide" />
}
@section individual_css{
<style>@@import url(@Url.Content("/AssetsNew/css/pages/user-guide.css"));</style>
}
@section individual_header_js{
}
<!--Page Title-->

<section class="page_title_section">
    <div class="auto-container">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <h1><strong>User Guide</strong> - Minop Attendance system</h1>
                <p>Download or read user guide & manage attendance smartly and efficently.</p>
                <ul class="bread-crumb clearfix">
                    <li><a href="@Url.Content("/Attendance")">Home</a></li>
                    <li><span>/</span></li>
                    <li>User Guide</li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!--End Page Title-->
<!-- Contact Page Section -->
<section class="user_guide_section">
    <div class="auto-container">
        <div class="row clearfix align-items-center justify-content-between">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="installation_set_up_box">
                    <p>
                        <strong>Installation & Set up</strong>
                    </p>
                    <p>
                        You can easily install Minop app on your android device by searching it on the Google Play Store, or you can simply
                        <a href="https://play.google.com/store/apps/details?id=com.mantra.minop">click here</a> to visit google play Store or for app store
                        <a href="https://play.google.com/store/apps/details?id=com.mantra.minop">click here</a>
                    </p>
                    <p>After you've completed the installation, sign in using your credentials. You then will be redirected to the Home page, where you can Check - in using your selected method.</p>
                    <p>
                        For doing first time account setup kindly
                        <a href="@Url.Content("/TroubleshootingVideo")">click here</a> to watch video tutorial.
                    </p>
                    <a class="user_guide_box" href="/Downloads/Minop_User_Manual.PDF" download="">
                        <i class="fa fa-download"></i> Minop Time
                    </a>
                    <a class="user_guide_box" href="/Downloads/Minop_pay_User_manual.PDF" download="">
                        <i class="fa fa-download"></i> Minop Pay
                    </a>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <img class="lazyload" loading="lazy" src="@Url.Content("~/AssetsNew/images/user-guide.png")" alt="User Guide" title="User Guide" />
            </div>
        </div>
    </div>
</section>
<!--End Page Container -->
<!-- Call To Action -->
<section class="call-to-action-two"> <div class="icon-layer wow zoomIn" data-wow-delay="400ms"></div><div class="auto-container clearfix"> <div class="title-column"> <div class="inner"> <span class="icon pe-7s-global"></span> <h3>Helping clients to unlock & unleash the power within their large scale Business</h3> </div></div><div class="btn-column"> <div class="btn-box"> <a href="@Url.Content("/Contact-Us")" class="theme-btn inquiry_now_btn"> <i class="fa fa-chart-line"></i>Inquiry Now </a> </div></div></div></section>
<!--End Call To Action -->
@section individual_footer_js{
<script src="/AssetsNew/js/script.js"></script>
}