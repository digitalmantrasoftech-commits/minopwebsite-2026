@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "DevicesList";
    Layout = "~/Views/Shared/_LayoutDeviceAdmin.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
}

<script type="text/javascript">
    $(document).ready(function () {
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }
        var t = $('#tblDeviceDetails').DataTable(
    {
        "processing": true,
        "ajax": {
            url: '@_webapiurl' + 'DashBoard/DevicesDetails',
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            dataSrc: '',
        },
        "columns": [
            { "data": null },
            { "data": "CompanyId" },
            { "data": "CompanyName" },
            { "data": "CompanyCode" },
            { "data": "DeviceSrNo" },
            { "data": "DeviceName" },
            { "data": "DeviceCode" },
            { "data": "DeviceIP" },
            { "data": "BranchId" },
            { "data": "DeviceStatus" },
            { "data": "IsActive" },
        ],
        "columnDefs": [
            {
                "targets": [1, 8, 10],
                "visible": false
            },
            {
                "targets": 11,
                "data": null,
                "render": function (data, type, full, meta) {
                    data = "<a class='editclass btn btn-xs blue tooltips' title='Edit'><i class='fa fa-edit'></i></a> <a class='Activeclass btn btn-xs blue tooltips' title='Active'><i class='fa fa-check'></i></a> <a class='Inactiveclass btn btn-xs blue tooltips' title='Inactive'><i class='fa fa-times'></i></a> <a class='Command btn btn-xs blue tooltips' title='Upload'><i class='fa fa-upload'></i></a>";
                    return data;
                }

            },
             {
                 "searchable": false,
                 "orderable": false,
                 "targets": 0
             }],
        "order": [[1, 'asc']],
        'rowCallback': function (row, data, index) {
            if (data["DeviceStatus"] == "Offline") {
                $(row).find('td:eq(7)').css('color', 'red').css('font-weight', 'bold');
            }
            else if (data["DeviceStatus"] == "Online") {
                $(row).find('td:eq(7)').css('color', 'green').css('font-weight', 'bold');
            }
            else {
                $(row).find('td:eq(7)').css('color', 'blue').css('font-weight', 'bold');
            }
            if (data["IsActive"] == 1) {
                $(row).find('.Activeclass').css('display', 'none')
            }
            else {
                $(row).find('.Inactiveclass').css('display', 'none')
            }
        }
    }
    );
        t.on('order.dt search.dt', function () {
            t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();

        $("#tblDeviceDetails").on('click', '.editclass', function () {
            $("#CompanyName").removeClass('field_error');
            $("#spvalidation").hide();
            $("#spvalidation").val("");
            $("#CompanyID").val(t.row($(this).parent('td').parent('tr')).data()["CompanyID"]);
            $("#CompanyCode").val(t.row($(this).parent('td').parent('tr')).data()["CompanyCode"]);
            $("#CompanyName").val(t.row($(this).parent('td').parent('tr')).data()["CompanyName"]);
            $('#DeviceSrNo').val(t.row($(this).parent('td').parent('tr')).data()["DeviceSrNo"]);
            $("#DeviceCode").val(t.row($(this).parent('td').parent('tr')).data()["DeviceCode"]);
            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopdeviceList");
        });

        $("#tblDeviceDetails").on('click', '.Activeclass', function () {
            var devicesrno = t.row($(this).parent('td').parent('tr')).data()["DeviceSrNo"];
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "DeviceDemo/DeactivateDevice?deviceSrno=" + devicesrno + "&type=1",
                //data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response != null) {
                        $("<div class='alert alert-success overlay'><label>" + response.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                        $('#tblDeviceDetails').DataTable().ajax.reload();
                        //$('#frmpopdeviceList').modal('toggle');
                    } else {
                        $("<div class='alert alert-danger overlay'><label>" + response.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                        $('#tblDeviceDetails').DataTable().ajax.reload();
                        //$('#frmpopdeviceList').modal('toggle');
                    }
                },
                error: function (response) {
                    if (response != null) {
                        var obj = JSON.parse(response.responseText);
                        if (obj.MegSts == 'error') {
                            $("<div class='alert alert-danger overlay'><label>" + obj.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblDeviceDetails').DataTable().ajax.reload();
                    //        $('#frmpopdeviceList').modal('toggle');
                        }
                    }
                }
            });
        });

        $("#tblDeviceDetails").on('click', '.Inactiveclass', function () {
            var devicesrno = t.row($(this).parent('td').parent('tr')).data()["DeviceSrNo"];
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "DeviceDemo/DeactivateDevice?deviceSrno="+ devicesrno +"&type=0",
                //data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response != null) {
                        $("<div class='alert alert-success overlay'><label>" + response.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                        $('#tblDeviceDetails').DataTable().ajax.reload();
                    //    $('#frmpopdeviceList').modal('toggle');
                    } else {
                        $("<div class='alert alert-danger overlay'><label>" + response.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                        $('#tblDeviceDetails').DataTable().ajax.reload();
                    //    $('#frmpopdeviceList').modal('toggle');
                    }
                },
                error: function (response) {
                    if (response != null) {
                        var obj = JSON.parse(response.responseText);
                        if (obj.MegSts == 'error') {
                            $("<div class='alert alert-danger overlay'><label>" + obj.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblDeviceDetails').DataTable().ajax.reload();
                    //        $('#frmpopdeviceList').modal('toggle');
                        }
                    }
                }
            });
        });

        $("#tblDeviceDetails").on('click', '.Command', function () {
            var devicesrno = t.row($(this).parent('td').parent('tr')).data()["DeviceSrNo"];
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "DeviceDemo/UploadLicenceCommand?deviceSrno=" + devicesrno + "",
                //data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response != null) {
                        $("<div class='alert alert-success overlay'><label>" + response.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                        $('#tblDeviceDetails').DataTable().ajax.reload();
                        //    $('#frmpopdeviceList').modal('toggle');
                    } else {
                        $("<div class='alert alert-danger overlay'><label>" + response.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                        $('#tblDeviceDetails').DataTable().ajax.reload();
                        //    $('#frmpopdeviceList').modal('toggle');
                    }
                },
                error: function (response) {
                    if (response != null) {
                        var obj = JSON.parse(response.responseText);
                        if (obj.MegSts == 'error') {
                            $("<div class='alert alert-danger overlay'><label>" + obj.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblDeviceDetails').DataTable().ajax.reload();
                            //        $('#frmpopdeviceList').modal('toggle');
                        }
                    }
                }
            });
        });

        $("#btnUpload").click(function () {
            if (document.getElementById("FileUpload").files.size <= 0) {
                alert("File Size is zero bytes.");
                event.preventDefault();
                return false;
            }
            else if (document.getElementById("FileUpload").files.size > 1073741824) {
                alert("Max file size allowed is 1gb , please contact administrator for the file bigger than 1gb.");
                event.preventDefault();
                return false;
            }
            else if (document.getElementById("FileUpload").files.length == 0) {
                alert("Please Upload File.");
                event.preventDefault();
                return false;
            }
            else {
                event.preventDefault();
                swal({
                    title: "Important Notice",
                    text: "Are you sure you want to upload Licence file?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonClass: "blue",
                    confirmButtonText: "Yes, upload it!",
                    closeOnConfirm: true
                },
           function (isConfirm) {
               if (isConfirm) {
                   $('#FrmDeviceList').submit();
                   return true;
               }
               else {
                   event.preventDefault();
                   return false;
               }
           });

            }

        });

        $("#FileUpload").change(function () {
            if ($("#FileUpload").val() != null) {
                var validExts = new Array(".lic");
                var fileExt = $("#FileUpload").val();
                if (fileExt != "") {
                    fileExt = fileExt.substring(fileExt.lastIndexOf('.'));
                    if (validExts.indexOf(fileExt) < 0) {
                        alert("Invalid file selected, valid file type is " +
                                 validExts.toString());
                        $("#FileUpload").val("");
                        return false;
                    }
                }
            }

        });

    });
</script>

<div class="page-bar">
    @if (_RoleId == 1)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="#"><i class="fa fa-home"></i></a>
            </li>
            <li>
                <span><i class="fa fa-angle-right"></i> Device</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="#"><i class="fa fa-home"></i></a>
            </li>
            <li>
                <span><i class="fa fa-angle-right"></i> Device</span>
            </li>
        </ul>
    }
</div>
@if (_RoleId == 16)
{
    <div class="row">
        <div class="col-md-12">
            <div class="portlet">
                <div class="portlet-body">
                    <div>                        
                        <table id="tblDeviceDetails" class="table table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    <th>Srno</th>
                                    <th hidden>CompanyID</th>
                                    <th>CompanyName</th>
                                    <th>CompanyCode</th>
                                    <th>DeviceName</th>
                                    <th>DeviceSrNo</th>
                                    <th>DeviceCode</th>
                                    <th>DeviceIP</th>
                                    <th hidden>BranchId</th>
                                    <th>DeviceStatus</th>
                                    <th hidden>IsActive</th>
                                    <th width="100px">Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>

                    <div id="frmpopdeviceList" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                        @using (Html.BeginForm("DevicesList", "Paytime", FormMethod.Post, new { id = "FrmDeviceList", enctype = "multipart/form-data" }))
                        {
                        <div class="modal-dialog">
                            <!-- Modal content-->
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Device</h4>
                                </div>
                                <div class="modal-body">
                                    <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <fieldset>
                                                <div class="form-group">
                                                    <label>
                                                        @Html.Hidden("CompanyID")
                                                        @PayTimeWebClient.Resource.Resource.CompanyCode
                                                    </label>
                                                    <div class="row">
                                                        <div class="col-md-12">
                                                            @Html.Editor("CompanyCode", new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "readonly" } })
                                                            <span class="help-block" hidden id="spComcode"></span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <label>
                                                        DeviceSrno <span class="required" aria-required="true"> * </span>
                                                    </label>
                                                    <div class="row">
                                                        <div class="col-md-12">
                                                            @Html.Editor("DeviceSrNo", new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "readonly", @maxlength = 50 } })
                                                            <span class="help-block" hidden id="spComName"></span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <div class="fileinput fileinput-new" data-provides="fileinput">
                                                        <div class="input-group">
                                                            <div class="form-control uneditable-input input-fixed input" data-trigger="fileinput">
                                                                <i class="fa fa-file fileinput-exists"></i>&nbsp;
                                                                <span class="fileinput-filename"> </span>
                                                            </div>
                                                            <span class="input-group-addon btn blue btn-file">
                                                                <span class="fileinput-new"> Select file </span>
                                                                <span class="fileinput-exists"> Change </span>
                                                                <input type="file" name="FileUpload" id="FileUpload">
                                                            </span>
                                                            <a href="javascript:;" class="input-group-addon btn red fileinput-exists" data-dismiss="fileinput"> Remove </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>
                                                    @PayTimeWebClient.Resource.Resource.CompanyName <span class="required" aria-required="true"> * </span>
                                                </label>
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        @Html.Editor("CompanyName", new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "readonly", @maxlength = 50 } })
                                                        <span class="help-block" hidden id="spComName"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label>
                                                    DeviceCode <span class="required" aria-required="true"> * </span>
                                                </label>
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        @Html.Editor("DeviceCode", new { htmlAttributes = new { @class = "form-control input-sm", @readonly = "readonly", @maxlength = 50 } })
                                                        <span class="help-block" hidden id="spComName"></span>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                                                <div class="form-group">
                                                    <button type="submit" id="btnUpload" class="btn blue"><i class="fa fa-upload"></i> Upload</button>
                                                </div>
                                                @*<label><b>Important Note :</b>your all previous data would be deleted, do you want to proceed ?</label>*@
                                            </div>
                                        </div>

                                </div>
                            </div>
                        </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess.</span>
}
<script>
    $('.overlay').fadeIn('fast').delay(1000).fadeOut('slow');
</script>