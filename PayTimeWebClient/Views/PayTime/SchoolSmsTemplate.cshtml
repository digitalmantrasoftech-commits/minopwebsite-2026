				{
					"searchable": false,
					"orderable": false,
					"targets": 0
				}],

			});
		t.on('order.dt search.dt', function () {
			t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
				cell.innerHTML = i + 1;
			});
		}).draw();*@

		$("#AddTemplate").on('click', function () {
			frmclear();
			Bindregisterschool();
			$("#AddTemplate").attr("data-toggle", "modal");
			$("#AddTemplate").attr("data-target", "#frmpopup");

		});
		$("#fddlCompany").change(function () {
			if ($("#fddlCompany").val() != "0") {
				GetSmsTemplate();
			}
		});
		$("#btnsubmit").click(function (event) {
			if ($("#ddlCompany").val() == "0") {
				$("#ddlCompany").addClass('field_error');
				event.preventDefault();
				return false;
			}
			if ($("#ddleventtype").val() == 0) {
				$("#ddleventtype").addClass('field_error');
				event.preventDefault();
				return false;
			}
			if ($("#Template").val() == "") {
				$("#Template").addClass('field_error');
				event.preventDefault();
				return false;
			}
			var obj = { "CompanyId": $("#ddlCompany").val(), "Smseventtypeid": $("#ddleventtype").val(), "Template": $("#Template").val(), "templateid": $("#templateid").val() }

			$.ajax({
				type: 'POST',
				headers: { 'Authorization': '@_tokan' },
				url: webapiurl + "/SchoolSystemSetting/InsertSchoolSMSTemplate",
				data: JSON.stringify(obj),
				contentType: "application/json",
				dataType: 'json',
				async: false,
				cache: false,
				timeout: 30000,
				success: function (data) {
					alert(data.Msg);
					window.location.href = "SchoolSmsTemplate";
				},
				error: function (data) {
				    alert("Already Exists");
				    window.location.href = "SchoolSmsTemplate";
				},
			});


		});
		//$("#tblsmstemplate").on('click', '.editclass', function () {
		//	//alert(t.row($(this).parent('td').parent('tr')).data()["Smseventtypeid"]);
		//	//$("#ddlCompany").val(t.row($(this).parent('td').parent('tr')).data()["CompanyId"]);
		//	$("#ddleventtype").val(t.row($(this).parent('td').parent('tr')).data()["Smseventtypeid"]);
		//	$("#Template").val(t.row($(this).parent('td').parent('tr')).data()["Template"]);
		//	//$("#templateid").val($(this).parent('td').parent('tr').children(1)[2].innerText);
		//	$(".editclass").attr("data-toggle", "modal");
		//	$(".editclass").attr("data-target", "#frmpopup");
		//});




	});
	function GetSmsTemplate() {
		var CID = $("#fddlCompany").val();
		$('#tblsmstemplate').DataTable({
			"ajax": ({
				"headers": { 'Authorization': '@_tokan' },
				"url": webapiurl + "/SchoolSystemSetting/GetSchoolSmsTemplate?companyid=" + CID,
				"method": "GET",
				"type": "application/json",
				"dataSrc": ""
			}),
			//"language": {
			//	"search": "Search",
			//	"searchplaceholder": "Search..."
			//},
            dom: _domCommon,
            language: _languageCommon,
			searching: true,
			searchDelay: 500,
			"bDestroy": true,
			"columns": [
				{ "data": "templateid" },
				{ "data": "smseventtypeid" },
				{ "data": "smseventtypename" },
				{ "data": "template" },
			],
			"columnDefs": [
					{
						"targets": [0, 1],
						"visible": false
					}
			],

		});
        setTimeout(function () {
            $("#" + "tblsmstemplate" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

	}

	function Bindfregisterschool() {
		$.ajax({
			type: 'GET',
			headers: { 'Authorization': '@_tokan' },
			url: '@_webapiurl' + 'SchoolSystemSetting/Fillactiveregisterschool',
			contentType: "application/json",
			timeout: 30000,
			success: function (response) {
				if (response != null) {
					$("#fddlCompany").empty();
					$("#fddlCompany").append("<option value='0' selected>Select School</option>");
					for (var i = 0; i < response.length; i++) {
						$("#fddlCompany").append("<option value='" + response[i].CompanyId + "'>" + response[i].CompanyName + "</option>");
					}
				}
			}
		});
	}
	function Bindregisterschool() {
		$.ajax({
			type: 'GET',
			headers: { 'Authorization': '@_tokan' },
			url: '@_webapiurl' + 'SchoolSystemSetting/Fillactiveregisterschool',
			contentType: "application/json",
			timeout: 30000,
			success: function (response) {
				if (response != null) {
					$("#ddlCompany").empty();
					$("#ddlCompany").append("<option value='0' selected>Select School</option>");
					for (var i = 0; i < response.length; i++) {
						$("#ddlCompany").append("<option value='" + response[i].CompanyId + "'>" + response[i].CompanyName + "</option>");
					}
				}
			}
		});
	}
	function frmclear() {
		$("#ddlCompany").removeClass('field_error');
		$("#ddleventtype").removeClass('field_error');
		$("#Template").removeClass('field_error');
		$("#ddlCompany").val(0);
		$("#ddleventtype").val(0);
		$("#Template").val("");
	}
</script>
@if (_RoleId == 15)
{
    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/SuperAdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> School SMS Template</span>
            </li>
        </ul>
        <div>
            <div class="report_title">
                <div class="form-group" style="min-width: 160px; margin-bottom: 0">
                    <select class="form-control input-sm select2" id="fddlCompany" name="fddlCompany">
                        <option value="0" selected>Select School</option>
                    </select>
                </div>
            </div>
            <div class="page-toolbar">
                <a href="javascript:void(0)" id="AddTemplate" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Add Template"><i class="fa-solid fa-plus"></i></a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="portlet">
                <div class="portlet-body">
                    <div style="width:100%;margin-left:auto;margin-right:auto;">
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tblsmstemplate" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column ">
                                <thead>
                                    <tr>
                                        <th>Sr no</th>
                                        <th hidden>Tempid</th>
                                        <th hidden>SmsEventTypeId</th>
                                        <th>Event Type</th>
                                        <th>Template</th>
                                        <th hidden>Action</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
					</div>
                        <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                                        <h4 class="modal-title">School SMS Template</h4>
                                    </div>
                                    <div class="modal-body">
                                        <fieldset>
                                            <div class="modal-card">
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        <div class="form-group">
                                                            <div class="row">
                                                                <div class="editor-label control-label col-md-5">
                                                                    <input type="hidden" id="templateid" name="templateid" />
                                                                    school name <span class="required" aria-required="true"> * </span>
                                                                </div>
                                                                <div class="editor-field form-group  col-md-7">
                                                                    <select class="form-control input-sm select2" id="ddlCompany" name="ddlCompany">
                                                                        <option value="0" selected>Select School</option>
                                                                    </select>
                                                                    <span class="help-block" hidden id="spcompanyname"></span>
                                                                </div>

                                                                <div class="editor-label control-label col-md-5">
                                                                    Event Type<span class="required" aria-required="true"> * </span>
                                                                </div>
                                                                <div class="editor-field form-group col-md-7">
                                                                    <select class="form-control input-sm select2" id="ddleventtype" name="ddleventtype">
                                                                        <option value="0" selected>Select Event</option>
                                                                        @*<option value="1" hidden>BirthDay</option>*@
                                                                        @*<option value="2">OnEveryPunch</option>*@
                                                                        <option value="3">FirstIn-FirstOut</option>
                                                                    </select>
                                                                    <span class="help-block" hidden id="speventtype"></span>
                                                                </div>
                                                                <div class="editor-label control-label col-md-5">
                                                                    SMS Template <span class="required" aria-required="true"> * </span>
                                                                </div>
                                                                <div class="editor-field form-group col-md-7">
                                                                    <textarea class="form-control" rows="5" id="Template" name="Template" style="resize:none"></textarea>
                                                                    <span class="help-block" hidden id="spTemplate"></span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                    <div class="modal-footer">
                                        <div class="editor-field text-right">
                                            <button type="button" id="btnsubmit" class="btn save_btn"><i class="fa-light fa-floppy-disk"></i> Save</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>

        </div>

    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>
