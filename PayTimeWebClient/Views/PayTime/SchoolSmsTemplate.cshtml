@using System.Configuration;
@{
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    if (_RoleId == 15)
    {
        ViewBag.Title = "School SMS Template";
        Layout = "~/Views/Shared/_LayoutSuperAdmin.cshtml";
    }
}
<style>
    .form-group .select2-selection {
        padding-right: 25px;
    }
</style>
<script type="text/javascript">
	var webapiurl = '@_webapiurl';
	Bindfregisterschool();
	$(document).ready(function () {
		$("#templateid").val(0);

		@*var t = $('#tblsmstemplate').DataTable(
			{
				"processing": true,
				"ajax": {
					headers: { 'Authorization': '@_tokan' },
					url: webapiurl + "/SchoolSystemSetting/GetSchoolSmsTemplate?companyid=0",
					type: "GET",
					dataSrc: '',
