    function findRoomEvent(e) {
        checkSession();
        $('#roomcard').hide();
        $('#noRoom').hide();

        const container = $("#roomcard .row");
        container.empty();

        let start = $("#StartDate").val();
        let end = $("#EndDate").val();
        let startTime = $("#StartTime").val();
        let endTime = $("#EndTime").val();
        let capacity = $("#Capacity").val();

        start = moment(start, dateFormat.toUpperCase());
        end = moment(end, dateFormat.toUpperCase());

        if (start > end) {
            $("#EndDate").addClass('field_error');
            $("#EndDate").focus();
            e.preventDefault();
            return;
        }

        else {
            $("#EndDate").removeClass('field_error');
        }


        let dayStart = start.clone();
        const dayEnd = end.clone();
        const dayNames = new Set();

        while (dayStart <= dayEnd) {
            dayNames.add(dayStart.format("dddd")); // Get the day name
            dayStart = dayStart.add(1, 'days'); // Move to the next day
        }
        const currentTime = moment().format("HH:mm");
        if (start.isSame(moment(), 'day')) {
            if (moment(startTime, "HH:mm").isBefore(moment(currentTime, "HH:mm"))) {
                toastr.error("Looks like you picked a past time.")
                $("#StartTime").focus();
                e.preventDefault();
                return;
            }
        }

        start = start.format("YYYY-MM-DD");
        end = end.format("YYYY-MM-DD");
        startTime = moment(startTime, "HH:mm")
        endTime = moment(endTime, "HH:mm")
        if (startTime >= endTime) {
            $("#EndTime").addClass('field_error');
            $("#EndTime").focus();
            e.preventDefault();
            return;
        }
        else {
            $("#EndTime").removeClass('field_error');
        }


        let startDate = $("#StartDate").val();
        startDate = moment(startDate, dateFormat.toUpperCase()); // Assuming StartDate format is YYYY-MM-DD

        if (startDate.isSame(moment(), 'day')) {
            if (moment(startTime, "HH:mm").isBefore(moment(currentTime, "HH:mm"))) {
                $("#StartTime").addClass("field_error"); // Add error class
            } else {
                $("#StartTime").removeClass("field_error");
            }
        }

        startTime = startTime.format("HH:mm:ss");
        endTime = endTime.format("HH:mm:ss");

        // custom or all days Logic
        let arrayofDay = [...dayNames];
        if ($('input[name = "frequency"]:checked').val() == "customdays") {
            var Days = [];
            // Check each day and add it to the array if checked
            if ($('#sunday').prop('checked')) {
                if (arrayofDay.includes("Sunday")) Days.push("Sunday");
            }
            if ($('#monday').prop('checked')) {
                if (arrayofDay.includes("Monday"))Days.push("Monday");
            }
            if ($('#tuesday').prop('checked')) {
                if (arrayofDay.includes("Tuesday"))Days.push("Tuesday");
            }
            if ($('#wednesday').prop('checked')) {
                if (arrayofDay.includes("Wednesday"))Days.push("Wednesday");
            }
            if ($('#thursday').prop('checked')) {
                if (arrayofDay.includes("Thursday"))Days.push("Thursday");
            }
            if ($('#friday').prop('checked')) {
                if (arrayofDay.includes("Friday"))Days.push("Friday");
            }
            if ($('#saturday').prop('checked')) {
                if (arrayofDay.includes("Saturday"))Days.push("Saturday");
            }
            Days = Days.join(",");
            selectedDays = Days;
        }
        else {

            var Days = arrayofDay.join(",");
            selectedDays = Days;
        }

        if (Days == "") {
            toastr.error("selected days not match with Date");
            e.preventDefault();
            return;
        }

        let obj = {
            MeetingId:selectedMeeting,
            StartDate: start,
            EndDate: end,
            StartTime: startTime,
            EndTime: endTime,
            Capacity: capacity,
            Days: Days,
        }

        $.ajax({
            type: "POST",
            url: '@_webapiurl' + "RoomBook/GetAvailableRoom",
            headers: { 'Authorization': '@_tokan' },
            data: JSON.stringify(obj),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (data) {
                $("#ajax_loader").hide();
                if (data.length == 0) {
                    const container = $("#roomcard .row");
                    container.empty();
                    $('#noRoom').show();
                }
                else if (data.length > 0) {
                    $('#roomcard').show();
                    container.empty(); // Clear existing content if needed
                    var cardColor = ['pink', 'blue', 'yellow', 'green', 'purple', 'violet'];
                    var i = 0;
                    // Loop through the response data
                    data.forEach(room => {
                        if (room.AmenityNames != null) {
                            room.AmenityNames = room.AmenityNames.split(",");
                        }
                        else {
                            room.AmenityNames = [];
                        }
                    const roomHTML = `
            <div class="col-md-6 col-sm-12" onclick="goToSecondStep(${room.RoomId})">
                <div class="metting-card ${cardColor[i]}">
                    <div class="d-flex border_bottom">

                        <div class="room_details">
                            <h3>${room.RoomName}</h3>
                            <p>${room.RoomLocation}</p>
                            <div class="d-flex align-items-center justify-content-between margin-top-5 margin-bottom-5">
                                <div class="green_font">Available  ${FindSelectedRoom == room.RoomId ? "| Selected" : ""}</div>
                                <div class="d-flex align-items-center">
                                    <img src="/assets/images/icons/icon_user-tie.svg" alt="" width="14" height="14">
                                    <span>1-${room.Capacity}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="room_addon">
                        ${room.AmenityNames.map(addon => {
                            if (addon != "") {
                                addon = addon.split(" ").join("");
                                return `<img class="tooltips" src="/assets/images/ConferenceRoom/icon_${addon}.svg" alt="" width="26" height="26" data-placement="top" data-original-title="${addon}">`
                            }
                }).join('')}
                        </div>
                    </div>

                </div>
            `;
        container.append(roomHTML);
        i < cardColor.length - 1 ? i++ : i=0;
        // Append each room's HTML
    });
    $('.tooltips').tooltip();
    }

    },
    error: function (errormsg) {
        toastr.error("Error during find room");
        $("#ajax_loader").hide();
    }

    });

    }
