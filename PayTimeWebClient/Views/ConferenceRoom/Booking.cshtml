    function requestMeeting(meetingId, meetingTitle, timeRange) {

        Swal.fire({
            html: '<div class="swal_subtitle"><b>Request Conference Room</b>' +
                  '<p>Would you like to request the conference room for the time ' + timeRange + '?</p>' +
                  '<div style="margin-top: 15px;">' +
                  '<label style="display: block; text-align: left; margin-bottom: 5px; font-weight: bold;">Optional Message:</label>' +
                  '<textarea id="requestMessage" class="swal2-input" placeholder="Add a message for the meeting organizer (optional)" ' +
                  'style="width: 100%; height: 80px; resize: vertical; font-size: 14px;" maxlength="100"></textarea>' +
                  '</div></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_question.svg' alt=''>Request Meeting",
            closeOnConfirm: true,
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            cancelButtonText: 'No, Cancel',
            confirmButtonText: 'Yes, Send Request',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            },
            preConfirm: () => {

                const message = document.getElementById('requestMessage').value.trim();
                const specialCharPattern = /[!#$%^&*()_+\-=\[\]{};':"\\|,<>\/]/;
              
                if (message && specialCharPattern.test(message)) {
                    Swal.showValidationMessage('Message cannot contain special characters (!#$%^&*()_+-=[]{};"\\|,<>/). Only letters, numbers and spaces are allowed.');
                    return false;
                }

                return true;
            }
        }).then((result) => {
            if (result.isConfirmed) {
                const message = document.getElementById('requestMessage').value.trim();

               
                $.ajax({
                    type: "POST",
                    url: '@_webapiurl' + "RoomBook/RequestMeeting",
                    headers: { 'Authorization': '@_tokan' },
                    contentType: "application/json; charset=utf-8",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    data: JSON.stringify({
                        MeetingId: meetingId,
                        RequestMessage: message,
                        RequesterMeetingTitle: "",
                        RequesterUserId: 0,
                        RequesterEmail: "",
                        RequesterName: ""
                    }),
                    success: function (data) {
                      
                        $("#ajax_loader").hide();
                        if (data.MegSts === "ok") {
                            toastr.success('Conference room request sent successfully for particular slot!');
                        }
                        else if (data.MegSts == "fail") {
                            toastr.error('Failed to send request: ' + data.Meg);
                        }
                        else {
                            toastr.error('Failed to send request: ' + data.Meg);
                        }
                    },
                    error: function (xhr, status, error) {
                        $("#ajax_loader").hide();
                        console.error("Error sending request:", error);
                        toastr.error('Failed to send request. Please try again.');
                    }
                });
            }
        });

       
        $('img[src="/assets/images/icons/swal_icon/icon_question.svg"]').parent().parent().parent().addClass('swal_question');
    }

