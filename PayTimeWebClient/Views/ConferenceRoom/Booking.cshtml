    // Function to format time string (remove date, keep time only)
    function formatMeetingTime(startDateTime, endDateTime) {
        try {
            var startTime = '';
            var endTime = '';

          
            if (startDateTime && startDateTime.includes('T')) {
                startTime = startDateTime.split('T')[1]; 
              
                if (startTime.includes('Z')) {
                    startTime = startTime.split('Z')[0];
                } else if (startTime.includes('+')) {
                    startTime = startTime.split('+')[0];
                } else if (startTime.includes('-') && startTime.lastIndexOf('-') > 2) {
                    startTime = startTime.substring(0, startTime.lastIndexOf('-'));
                }
            } else if (startDateTime && startDateTime.includes(' ')) {
               
                startTime = startDateTime.split(' ').slice(1).join(' ');
            } else if (startDateTime) {
                startTime = startDateTime;
            }

            if (endDateTime && endDateTime.includes('T')) {
                endTime = endDateTime.split('T')[1]; 
                if (endTime.includes('Z')) {
                    endTime = endTime.split('Z')[0];
                } else if (endTime.includes('+')) {
                    endTime = endTime.split('+')[0];
                } else if (endTime.includes('-') && endTime.lastIndexOf('-') > 2) {
                    endTime = endTime.substring(0, endTime.lastIndexOf('-'));
                }
            } else if (endDateTime && endDateTime.includes(' ')) {
                endTime = endDateTime.split(' ').slice(1).join(' ');
            } else if (endDateTime) {
                endTime = endDateTime;
            }

           
            if (startTime && endTime) {
                return startTime + ' - ' + endTime;
            } else {
                return (startDateTime || '') + ' - ' + (endDateTime || '');
            }

        } catch (e) {
            console.error('Error formatting meeting time:', e);
            return (startDateTime || '') + ' - ' + (endDateTime || '');
        }
    }

    // Helper function to convert time string to minutes since midnight
    function timeToMinutes(timeStr) {
        try {
            var time = timeStr;
            if (timeStr.includes('T')) {
                time = timeStr.split('T')[1].split('Z')[0].split('+')[0].split('-')[0];
            } else if (timeStr.includes(' ')) {
                time = timeStr.split(' ')[1];
            }
            var parts = time.split(':');
            return parseInt(parts[0]) * 60 + parseInt(parts[1]);
        } catch (e) {
            return 0;
        }
    }

    // Helper function to convert minutes to time string
    function minutesToTime(minutes) {
        var hours = Math.floor(minutes / 60);
        var mins = minutes % 60;
        var secs = '00';
        return String(hours).padStart(2, '0') + ':' + String(mins).padStart(2, '0') + ':' + secs;
    }

    // Function to find available time slots in the day
    function findAvailableSlots(meetings) {
        var slots = [];
        var dayStart = 0; // 00:00:00
        var dayEnd = 1439; // 23:59:00 (we'll show as 23:59:59)

        // Sort meetings by start time
        var sortedMeetings = meetings.slice().sort(function(a, b) {
            return timeToMinutes(a.start) - timeToMinutes(b.start);
        });

        var currentTime = dayStart;

        sortedMeetings.forEach(function(meeting) {
            var meetingStart = timeToMinutes(meeting.start);
            var meetingEnd = timeToMinutes(meeting.end);

           
            if (currentTime < meetingStart) {
                slots.push({
                    type: 'available',
                    start: minutesToTime(currentTime),
                    end: minutesToTime(meetingStart)
                });
            }

          
            slots.push({
                type: 'meeting',
                id: meeting.id, 
                start: meeting.start,
                end: meeting.end,
                title: meeting.title,
                EmpName: meeting.EmpName,
                UserId: meeting.UserId,
                IsRequest: meeting.IsRequest
            });

            currentTime = meetingEnd;
        });

      
        if (currentTime < dayEnd) {
            slots.push({
                type: 'available',
                start: minutesToTime(currentTime),
                end: '23:59:59'
            });
        }

        return slots;
    }

    // Function to populate meetings table with real data and available slots
    function populateMeetingsTable(roomId, meetings) {
       
        var tableHtml = '';

        if (meetings && meetings.length > 0) {
            var allSlots = findAvailableSlots(meetings);

            $.each(allSlots, function(index, slot) {
                if (slot.type === 'meeting') {
                    var personName = slot.EmpName || 'Unknown';
                    var meetingTitle = slot.title || 'No Title';
                    var timeRange = formatMeetingTime(slot.start, slot.end);

                    tableHtml += '<tr>';
                    tableHtml += '    <td>' + timeRange + '</td>';
                    tableHtml += '    <td>' + meetingTitle + '</td>';
                    tableHtml += '    <td>' + personName + '</td>';
                    var meetingStart = new Date(slot.start);
                    var now = new Date();
                    var nowPlus30 = new Date(now.getTime() + 30 * 60000);
                    if ('@UserId' != slot.UserId && meetingStart > nowPlus30 && slot.IsRequest == 0) {
                        tableHtml += '<td><a class="btn btn-xs meeting-request-btn seagreen_btnnew tooltips" data-placement="top" title="Send Request" onclick="requestMeeting(' + slot.id + ', \'' + meetingTitle.replace(/'/g, '&apos;') + '\', \'' + timeRange + '\')" style="margin-left: 0 !important;"><i class="fa-regular fa-envelope-circle-check" style="font-size: 15px;"></i></a></td>';
                    }
                    else if (slot.IsRequest !=  0)
                    {
                        tableHtml += '    <td>Already Requested</td>';
                    }
                    else {
                        tableHtml += '    <td></td>';
                    }
                    tableHtml += '</tr>';
                } else {
                    // Available slot
                    var availableTime = slot.start + ' - ' + slot.end;

                    tableHtml += '<tr class="available-slot">';
                    tableHtml += '    <td>' + availableTime + '</td>';
                    tableHtml += '    <td>-</td>';
                    tableHtml += '    <td>-</td>';
                    tableHtml += '    <td></td>';
                    tableHtml += '</tr>';
                }
            });
        } else {
           
            tableHtml = '<tr class="available-slot">';
            tableHtml += '    <td>00:00:00 - 23:59:59</td>';
            tableHtml += '    <td>-</td>';
            tableHtml += '    <td>-</td>';
            tableHtml += '    <td>-</td>';
            tableHtml += '</tr>';
        }

        $("#meetings-table-" + roomId).html(tableHtml);
    }

