    // Function to load rooms from database
    function loadRooms() {
        $.ajax({
            type: "GET",
            url: '@_webapiurl' + "RoomBook/GetAllRoomsList/0",
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $("#room_Id").empty();
            },
            success: function (data) {
                $("#room_Id").empty();
                if (data && data.length > 0) {
                    $.each(data, function (index, room) {
                        $("#room_Id").append('<option value="' + room.RoomId + '">' + room.RoomName + '</option>');
                    });
                    generateRoomAccordion(data,0)
                } else {
                    toastr.error("No rooms available");
                }

                $("#room_Id").multiselect('rebuild');
                
            },
            error: function (xhr, status, error) {
                console.error("Error loading rooms:", error);
                $("#room_Id").multiselect('rebuild');
                toastr.error("Failed to load rooms.");
            }
        });
    }

