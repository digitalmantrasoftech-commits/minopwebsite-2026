    function RequestForConferenceRoom() {
     
    $.ajax({
        type: "GET",
        url: '@_webapiurl' + "RoomBook/ActionOnMeetingRequest",
        headers: { 'Authorization': '@_tokan' },
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (data) {
          
            if (data && data.Data && data.Data.length > 0) {
                var meeting = data.Data[0];
                var meetingId = data.Data[0].MeetingId;
                var title = data.Data[0].MeetingTitle;
                var room = data.Data[0].RoomName;
                var requester = data.Data[0].EmpName;
                var title = meeting.MeetingTitle;
                var room = meeting.RoomName;
                var requester = meeting.EmpName;
                var startDate = new Date(meeting.Start);
                var endDate = new Date(meeting.End);
                var date = startDate.toISOString().split("T")[0];
                var startTime = startDate.toTimeString().split(" ")[0];
                var endTime = endDate.toTimeString().split(" ")[0];
                var displayTime = `${date} (${startTime} - ${endTime})`;

                Swal.fire({
                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_info.svg' alt=''>Info",
                    html: `<div class="swal_subtitle">
                              For meeting <b>${title}</b> in <b>${room}</b>
                              from <b>${displayTime}</b>,
                              <b>${requester}</b> has requested this room for above time slot.<br><br>
                              If you agree voluntarily, please update or delete your meeting.<br>
                              Otherwise, click <b>Cancel Request</b>.
                           </div>`,
                    closeOnConfirm: true,
                    showCloseButton: true,
                    showCancelButton: true,
                    focusConfirm: false,
                    cancelButtonText: 'Cancel Request',
                    confirmButtonText: 'OK',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    customClass: {
                        confirmButton: 'swal-confirm-button-class',
                        cancelButton: 'swal-cancel-button-class'
                    }
                }).then((result) => {
                   
                    let status = null;

                    if (result.isConfirmed) {
                        // OK clicked
                        status = 5;
                    } else if (result.dismiss === Swal.DismissReason.cancel) {
                        // Cancel clicked
                        status = 4;
                    }

                    if (status !== null) {
                        $.ajax({
                            type: "POST",
                            url: '@_webapiurl' + "RoomBook/CancelMeetingRequest?meetingId=" + meetingId + "&status=" + status,
                            headers: { 'Authorization': '@_tokan' },
                            contentType: "application/json; charset=utf-8",
                            beforeSend: function () {
                                $("#ajax_loader").show();
                            },
                            success: function () {
                                $("#ajax_loader").hide();
                                let msg = status === 5 ? "You accepted the request now kindly update or delete the particular meeting slot."
                                    : "Conference room request denied successfully.";
                                toastr.success(msg);
                                RequestForConferenceRoom();
                            },
                            error: function (xhr, status, error) {
                                $("#ajax_loader").hide();
                                console.error("Error updating request", error);
                                toastr.error("Error updating request");
                            }
                        });
                    }
                });

                $('img[src="/assets/images/icons/swal_icon/icon_info.svg"]')
                    .parent().parent().parent()
                    .addClass('swal_info');
            }
            else {
                console.log("No request found");
            }
        },
        error: function (xhr, status, error) {
            console.error("Error while fetching Meeting Request for today", error);
            toastr.error("Error while fetching Meeting Request for today");
        }
    });
}

