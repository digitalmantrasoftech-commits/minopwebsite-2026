@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Amenity Master";
    Layout = "~/Views/Shared/_Layout.cshtml";

    //string _flgempover = ViewBag.flgempover;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    int _cmpid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _companyid = "0";
    string _empid = "0";

    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    if (_RoleId != 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _empid = HttpContext.Current.Session["EmpId"].ToString();
    }
    string _branchid = "0";
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    if (_RoleId == 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null

}


<script>

    let EmpId = '@_empid';
    let RoleId = '@_RoleId';
    let isedit = '@obj.CanEdit';
    let isdelete = '@obj.CanDelete';
    let AmenityData = "";
    $(document).ready(function () {


        FillTable();
        $('#AmenityName').blur(function () {
            if ($('#AmenityName').val().trim() == "") {
                $("#AmenityName").addClass('field_error');
            }
            else {
                $("#AmenityName").removeClass('field_error');
            }
        });

        $('#btnAmntSubmit').click(AddAmenity);
        $('#AddAmenity').click(function () {
            frmClear();
            $("#AmenityName").removeClass('field_error');
            $('#myModal').modal('toggle');

        })

    });

    function FillTable() {
    checkSession();
    $.ajax({
        type: "GET",
        url: '@_webapiurl' +"RoomBook/GetAllAmenitiesList?id=0",
        headers: { 'Authorization': '@_tokan' },
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        beforeSend: function () {
            $("#ajax_loader").show();
        },
        success: function (data) {
            if (data.length == 0) {
                $('#tblempty').hide();  // Hide the empty message
                $('#NotificationGrid-empty').show();
            }
            else if (data.length > 0) {
                $('#tblempty').show();  // Hide the empty message
                $('#NotificationGrid-empty').hide();
                AmenityData = data;
                $("#dataTables_tbl_header").remove();
                $('#tblAmenity').DataTable({
                    dom: _domCommon,
                    language: _languageCommon,
                    deferRender: true,
                    data: data,
                    order: [],
                    destroy: true,
                    initComplete: function () {
                        const visibleTable = $('table:visible').attr('id');
                        $("#buttons").append(`
                            <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                                <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                            </div>
                        `);

                    },
                    columns: [
                        {
                            title: "Sr No",
                            data: null,
                            visible:false,
                            render: function (data, type, row, meta) {
                                // Generate the serial number based on the row index
                                return meta.row + 1;
                            }
                        },
                        { title: "AmenityId", data: "AmenityId", visible: false },
                        { title: "Amenity Name", data: "AmenityName" },
                        {
                            title: "Action",
                            data: null,
                            orderable: false,
                            render: function (data, type, row) {
                                let str = "";
                                let visible = false;
                                if (isedit == "True") {
                                    row.IsActive
                                        ? str = '<a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit" onclick="updateAmenity(' + row.AmenityId + ')"> <i class="fa-regular fa-pen-to-square"> </i> </a> <span></span><a class="Inactiveclass btn red_btnnew tooltips" data-placement="top" data-original-title="Inactive" onclick="statusChange(' + row.AmenityId + ')"><i class="fa-solid fa-xmark"></i></a>'
                                        : str = '<a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit" onclick="updateAmenity(' + row.AmenityId + ')"> <i class="fa-regular fa-pen-to-square"> </i> </a> <span> </span><a class="Activeclass btn green_btnnew tooltips" data-placement="top" data-original-title="Active" onclick="statusChange(' + row.AmenityId + ')"><i class="fa-solid fa-check"></i></a>';
                            }
                                if (isdelete == "True" && visible) {
                                str += '<a class="Inactiveclass btn red_btnnew tooltips" data-placement="top" data-original-title="Delete" onclick="deleteAmenity(' + row.AmenityId + ')"><i class="fa-regular fa-trash-can"></i></a>'
                            }
                                return str;
                            }
                        }
                    ],
                    "preDrawCallback": function (settings) {
                        $("#ajax_loader").hide();
                    },
                    drawCallback: function () {
                        $('.tooltips').tooltip();
                    }
                });
                setTimeout(function () {
                    $("#" + "tblAmenity" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                    $('.tooltips').tooltip();
                }, 100);
            }
        },
        error: function (errormsg) {
            toastr.error("Error during fetch Data");
            $('#tblempty').hide();  // Hide the empty message
            $('#NotificationGrid-empty').show();
        }
    });
    }
    function AddAmenity(e) {
        checkSession();
        e.preventDefault();
        if ($('#AmenityName').val().trim() == "") {
            $("#AmenityName").addClass('field_error');
            $("#AmenityName").focus();
            e.preventDefault();//or return false
            return ;
        }

        let obj = {
            AmenityId: $('#AmenityId').val() || 0,
            AmenityName: $('#AmenityName').val().trim(),
        }

     $.ajax({
        type: "POST",
        url: '@_webapiurl' +"RoomBook/AddAmenity",
        headers: { 'Authorization': '@_tokan' },
        data: JSON.stringify(obj),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
         success: function (data) {
             if (data.MegSts == 'ok') {
                 toastr.success(data.Meg);
             }
             else if (data.MegSts == 'error') {
                 toastr.error(data.Meg);
             }
             else {
                 toastr.error("Error during insert and update");
             }

             $('#myModal').modal('toggle');
             FillTable();

         },
         error: function (errormsg) {
             toastr.error("Error during insert and update");
             $('#myModal').modal('toggle');
             FillTable();
         }
    });
    }
    function updateAmenity(AmenityId) {
        checkSession();
        frmClear();
    let Amenity = AmenityData.find((value) => value.AmenityId == AmenityId);

        $('#AmenityId').val(Amenity.AmenityId);
        $('#AmenityName').val(Amenity.AmenityName);

        $('#myModal').modal('toggle');
    }



    function deleteAmenity(AmenityId) {
        checkSession();
        $.ajax({
        type: "GET",
        url: '@_webapiurl' + "RoomBook/deleteAmenity?id=" + AmenityId,
        headers: { 'Authorization': '@_tokan' },
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (data) {
             if (data.MegSts == 'ok') {
                 toastr.success(data.Meg);
             }
             else if (data.MegSts == 'error') {
                 toastr.error(data.Meg);
             }
             else {
                 toastr.error("Error during delete");
             }

             FillTable();

         },
         error: function (errormsg) {
             toastr.error("Error during delete");
             FillTable();
         }
    });

    }
    function statusChange(AmenityId) {
        checkSession();
        let Amenity = AmenityData.find((value) => value.AmenityId == AmenityId);

        let obj = {
            AmenityId : Amenity.AmenityId,
            IsActive : !Amenity.IsActive,
        }

        $.ajax({
        type: "POST",
        url: '@_webapiurl' +"RoomBook/AmenityStatusChange",
        headers: { 'Authorization': '@_tokan' },
        data: JSON.stringify(obj),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
         success: function (data) {
             if (data.MegSts == 'ok') {
                 toastr.success(data.Meg);
             }
             else if (data.MegSts == 'error') {
                 toastr.error(data.Meg);
             }
             else {
                 toastr.error("Error during status change");
             }

             FillTable();

         },
         error: function (errormsg) {
             toastr.error("Error during status change");
             FillTable();
         }
    });
    }

    function frmClear() {
        $('#AmenityId').val("");
        $('#AmenityName').val("");
    }


    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
</script>
@if (obj.CanView)
{
    <div class="page-bar">

        @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
        {

            <ul class="page-breadcrumb">
                <li>
                    @if (isClientDBMatchFlag == "True")
                    {
                        <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                    }
                    else
                    {
                        <a href="/Dashboard/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                    }
                </li>
                <li>
                    <span><i class="fa-light fa-angle-right"></i> Amenity</span>
                </li>
            </ul>
        }
        else
        {
            <ul class="page-breadcrumb">
                <li>
                    @if (isClientDBMatchFlag == "true")
                    {
                        <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                    }
                    else
                    {
                        <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
                    }
                </li>
                <li>
                    <span><i class="fa-light fa-angle-right"></i> Amenity</span>
                </li>
            </ul>
        }
        @if (obj.CanAdd)
        {
            <div class="page-toolbar">

                <div class="text-right">
                    <a id="AddAmenity" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Add Amenity"><i class="fa-solid fa-plus"></i></a>
                </div>

            </div>
        }
    </div>
    <h1 class="page-title">
        <small></small>
    </h1>
    <div class="portlet">
        <div class="portlet-body">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    @*<input type="button" id="btnExport" value="Export All" class="btn btn-primary" />*@
                    <div id="divtblAmenity" class="table-scrollable">
                        <div id="tblempty">
                            <div class="table-responsive" id="tableResponsive">
                                <table id="tblAmenity" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column"></table>
                            </div>
                        </div>
                        <div id="NotificationGrid-empty" style="display: none">
                            <div class="datanotfound">
                                <img src="~/assets/images/emptyscreen_1.png" height="148" width="280" alt="Nodata Found Icon">
                                <p class="datanotfound_title">No data found</p> <!-- titleText -->
                                <p class="">No entries found. Please add a record to get started.</p><!-- subText -->
                            </div>
                        </div>
                    </div>
                    @*<div class="nodata_block no_recoed" style="display: none; text-align: center;" id="no_data">
                            <img src="/assets/images/Data_not_found.jpg" height="200" width="200" alt="No Data Icon">
                        </div>*@
                </div>
            </div>
        </div>
    </div>


    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div id='ajax_loader' class="modal_bg loading">
            <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
        </div>
    </div>
    <div id="myModal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog w-500">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Amenity</h4>
                </div>
                <div class="modal-body">
                    <div class="modal-card">
                        <fieldset>
                            <div class="row">
                                <div class="col-lg-12">
                                    <span class="help-block" hidden id="spvalidation"></span>
                                </div>
                                <div class="col-lg-12" hidden>
                                    <div class="form-group">
                                        <label>Amenity ID</label>
                                        <input type="text" class="form-control" name="AmenityId" id="AmenityId">
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>Amenity Name <span class="required" style="color:red;" aria-required="true"> * </span></label>
                                        <input type="text" class="form-control input-sm" name="AmenityName" id="AmenityName" placeholder="Enter Amenity Name" required="" maxlength="50" onpaste="return false;" oncopy="return false;" oncut="return false;" oncontextmenu="return false;">
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-lg-12 text-right">
                            <button type="button" id="btnAmntSubmit" class=" btn save_btn"> <i class="fa-light fa-floppy-disk"></i> Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}