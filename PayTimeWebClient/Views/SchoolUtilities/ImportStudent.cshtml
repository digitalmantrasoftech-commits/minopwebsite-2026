@model PayTimeWebClient.Models.ImportedFailLog
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models
@{
    ViewBag.Title = "ImportMaster";
    Layout = "~/Views/Shared/_LayoutSchool.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = string.Empty;
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
}

<script type="text/javascript">
    var schoolid = '@_companyid';
    var emprole = '@_RoleId';




    $(document).ready(function () {
        $(".alert").hide();
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }
        var t = $('#tblImportError').DataTable();
        fillSchooldll(0);
        fillClassdll(0);
        fillDivisiondll(0);
        $("#FileUpload").change(function () {
            if ($("#FileUpload").val() != null) {
                var validExts = new Array(".xlsx", ".xls", ".csv");
                var fileExt = $("#FileUpload").val();
                if (fileExt != "") {
                    fileExt = fileExt.substring(fileExt.lastIndexOf('.'));
                    if (validExts.indexOf(fileExt) < 0) {
                        alert("Invalid file selected, valid files are of " +
                            validExts.toString() + " types.");
                        $("#FileUpload").val("");
                        return false;
                    }
                }
            }

        });
        $("#btnValidate").click(function () {
            var selectedval = $('#MasterName').children("option:selected").val();
            if (selectedval == 0) {
                alert("Please Select Master to import.");
                event.preventDefault();
                return false;
            }
            if (selectedval == 5) {
                if ($("#SchoolId").val() == "0") {
                    alert("Please Select School");
                    event.preventDefault();
                    return false;
                }

                if ($("#ClassId").val() == "0") {
                    alert("Please Select Class");
                    event.preventDefault();
                    return false;
                }
                if ($("#DivisionId").val() == "0") {
                    alert("Please Select Division");
                    event.preventDefault();
                    return false;
                }
            }

            if (document.getElementById("FileUpload").files.length == 0) {
                alert("Please Select File");
                event.preventDefault();
                return false;
            }
            $("#ajax_loader").show();
        });
        $("#MasterName").change(function () {
            var selectedval = $('option:selected', this).val();
            if (selectedval == 1) {
                $("#dwnclasssmplesheet").show();
            } else {
                $("#dwnclasssmplesheet").hide();
            }
            if (selectedval == 2) {
                $("#dwncDivisionsmplesheet").show();
            } else {
                $("#dwncDivisionsmplesheet").hide();
            }
            if (selectedval == 3) {
                $("#dwnshiftsmplesheet").show();
            } else {
                $("#dwnshiftsmplesheet").hide();
            }
            if (selectedval == 5) {
                $("#divSchoolId").show();
                $("#divClassId").show();
                $("#divDivisionId").show();
                $("#dwnstusmplesheet").show();
            }
            else {
                $("#divSchoolId").hide();
                $("#divClassId").hide();
                $("#divDivisionId").hide();
                $("#dwnstusmplesheet").hide();
            }
            if (selectedval == 6) {
                $("#dwnsfftypesmplesheet").show();
            } else {
                $("#dwnsfftypesmplesheet").hide();
            }
            if (selectedval == 7) {
                $("#dwnsffsmplesheet").show();
            } else {
                $("#dwnsffsmplesheet").hide();
            }
            if (selectedval == 8) {
                $("#dwndevicesmplesheet").show();
            } else {
                $("#dwndevicesmplesheet").hide();
            }
            if (selectedval == 9) {
                $("#dwngatesmplesheet").show();
            } else {
                $("#dwngatesmplesheet").hide();
            }
            if (selectedval == 10) {
                $("#dwndrvsmplesheet").show();
            } else {
                $("#dwndrvsmplesheet").hide();
            }
            if (selectedval == 11) {
                $("#dwnvhesmplesheet").show();
            } else {
                $("#dwnvhesmplesheet").hide();
            }
            $("#Mastervalue").val(selectedval);
        });

    });

    function fillSchooldll(selectedStudentId) {
        var _url = '@_webapiurl' + 'Master/CompanyGetAll'
        if (emprole == '6805') {
            _url = '@_webapiurl' + 'Master/CompanyGetById?id=' + schoolid;
        }
        $('#SchoolId').empty();
        $.ajax(
            {
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: _url,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                },
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    $("#SchoolId").append("<option value='0'>Select School</option>");
                    for (var x = 0; x < data.length; x++) {
                        $("#SchoolId").append("<option value=" + data[x].CompanyID + ">" + data[x].CompanyName + "</option>");
                    }
                    $("#SchoolId option[value = '" + selectedStudentId + "' ]").prop('selected', true);
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
    }

    function fillClassdll(selectedClass) {
        var _urlbr = '@_webapiurl' + 'Master/BranchGetAll'
        if (emprole == '6805') {
            _urlbr = '@_webapiurl' + 'Master/BranchGetAllbycmp?id=' + schoolid;
        }
        $('#ClassId').empty();
        $.ajax(
            {
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: _urlbr,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                },
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    $("#ClassId").append("<option value='0'>Select class</option>");
                    for (var x = 0; x < data.length; x++) {
                        $("#ClassId").append("<option value=" + data[x].BranchId + ">" + data[x].branchname + "</option>");
                    }
                    $("#ClassId option[value = '" + selectedClass + "' ]").prop('selected', true);
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
    }
    function fillDivisiondll(selectedDivision) {
        $('#DivisionId').empty();
        var _urldiv = '@_webapiurl' + 'Master/DepartmentGetAll'
        if (emprole == '6805') {
            _urldiv = '@_webapiurl' + 'Master/DepartmentGetAllbycmp?id=' + schoolid;
        }
        $.ajax(
            {
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: _urldiv,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                },
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    $("#DivisionId").append("<option value='0'>Select Division</option>");
                    for (var x = 0; x < data.length; x++) {
                        $("#DivisionId").append("<option value=" + data[x].DepartmentId + ">" + data[x].DepartmentName + "</option>");
                    }
                    $("#DivisionId option[value = '" + selectedDivision + "' ]").prop('selected', true);
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
    }
</script>
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/School/AdminDashboard">Home</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>Import Master</span>
        </li>
    </ul>
</div>
<h1 class="page-title">
    <small></small>
</h1>
@if (obj.CanView && Convert.ToInt32(Session["IsSchool"]) == 1)
{
    <div class="col-md-12">        
        <div id='ajax_loader' class="modal_bg loading" aria-hidden="true" hidden>
            <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
        </div>
        @using (Html.BeginForm("ImportStudent", "SchoolUtilities", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="row">
                <div class="col-md-4 col-md-offset-4">
                    <div class="editor-field form-group">
                        @*@Html.DropDownList("MasterName", new SelectList(new[] { "" }), "Select", new { @class = "form-control input-sm select2" })*@
                        <select class="form-control input-sm select2" id="MasterName">
                            <option value="0" selected>Select Master</option>
                            <option value="1">Class Master</option>
                            <option value="2">Division Master</option>
                            <option value="10">Driver Master</option>
                            <option value="8">Device Master</option>
                            <option value="9">Gate Master</option>
                            <option value="3">Shift Master</option>
                            @*<option value="4">Policy Master</option>*@
                            <option value="5">Student Master</option>
                            <option value="6">Staff type Master</option>
                            <option value="7">Staff Master</option>
                            <option value="11">Vehicle Master</option>
                        </select>
                        <input type="text" name="Mastervalue" id="Mastervalue" style="display:none"/>
                    </div>
                    <div class="editor-field form-group" style="display:none" id="divSchoolId">
                        @Html.DropDownList("SchoolId", new SelectList(new[] { "" }), "Select School", new { @class = "form-control input-sm select2" })
                    </div>

                    <div class="editor-field form-group" style="display:none" id="divClassId">
                        @Html.DropDownList("ClassId", new SelectList(new[] { "" }), "Select Class", new { @class = "form-control input-sm select2" })
                    </div>

                    <div class="editor-field form-group" style="display:none" id="divDivisionId">
                        @Html.DropDownList("DivisionId", new SelectList(new[] { "" }), "Select Division", new { @class = "form-control input-sm select2" })
                    </div>
                </div>
                <div class="col-md-4 col-md-offset-4">
                    <div class="form-group">


                        <div class="fileinput fileinput-new" data-provides="fileinput">
                            <div class="input-group">
                                <div class="form-control uneditable-input input-fixed input" data-trigger="fileinput">
                                    <i class="fa fa-file fileinput-exists"></i>&nbsp;
                                    <span class="fileinput-filename"> </span>
                                    @*<span>Import Excel File</span>*@
                                </div>
                                <span class="input-group-addon btn blue btn-file">
                                    <span class="fileinput-new"> Select file </span>
                                    <span class="fileinput-exists"> Change </span>
                                    <input type="file" name="FileUpload" id="FileUpload">
                                </span>
                                <a href="javascript:;" class="input-group-addon btn red fileinput-exists" data-dismiss="fileinput"> Remove </a>
                            </div>
                        </div>

                    </div>

                </div>
                <div class="col-md-4 col-md-offset-4 text-center">
                    <div class="form-group">
                        <button type="submit" id="btnValidate" class="btn blue"><i class="fa fa-upload"></i> Import</button>

                        <a class=" btn green-dark" href="~/SampleXlFile/ClassImportSample.xlsx" id="dwnclasssmplesheet" style="display:none"><i class="fa fa-file-excel-o"></i> Class Sample Sheet</a>
                        <a class=" btn green-dark" href="~/SampleXlFile/DivisionImportSample.xlsx" id="dwncDivisionsmplesheet" style="display:none"><i class="fa fa-file-excel-o"></i> Division Sample Sheet</a>
                        <a class=" btn green-dark" href="~/SampleXlFile/ShiftImportSample.xlsx" id="dwnshiftsmplesheet" style="display:none"><i class="fa fa-file-excel-o"></i> Shift Sample Sheet</a>
                        <a class=" btn green-dark" href="~/SampleXlFile/StudentImportSample.xlsx" id="dwnstusmplesheet" style="display:none"><i class="fa fa-file-excel-o"></i> Student Sample Sheet</a>
                        <a class=" btn green-dark" href="~/SampleXlFile/GateImportSample.xlsx" id="dwngatesmplesheet" style="display:none"><i class="fa fa-file-excel-o"></i> Gate Sample Sheet</a>
                        <a class=" btn green-dark" href="~/SampleXlFile/StaffTypeImportSample.xlsx" id="dwnsfftypesmplesheet" style="display:none"><i class="fa fa-file-excel-o"></i> Staff Type Sample Sheet</a>
                        <a class=" btn green-dark" href="~/SampleXlFile/StaffImportSample.xlsx" id="dwnsffsmplesheet" style="display:none"><i class="fa fa-file-excel-o"></i> Staff Sample Sheet</a>
                        <a class=" btn green-dark" href="~/SampleXlFile/DriverImportSample.xlsx" id="dwndrvsmplesheet" style="display:none"><i class="fa fa-file-excel-o"></i> Driver Sample Sheet</a>
                        <a class=" btn green-dark" href="~/SampleXlFile/VehicleImportSample.xlsx" id="dwnvhesmplesheet" style="display:none"><i class="fa fa-file-excel-o"></i> Vehicle Sample Sheet</a>
                        <a class=" btn green-dark" href="~/SampleXlFile/DeviceImportSample.xlsx" id="dwndevicesmplesheet" style="display:none"><i class="fa fa-file-excel-o"></i> Device Sample Sheet</a>

                    </div>
                </div>
                <div class="col-md-12 text-center">
                    <img style="display:inline-block;" class="img-responsive margin-top-20" src="/assets/images/process-school.png">
                </div>
            </div>
        }
        @if (TempData["IsValid"] != null)
        {
            if (Convert.ToBoolean(TempData["IsValid"]) == false)
            {
                <h4>Errors in excel</h4>
                @*<table id="tblImportError" class="table table-striped table-bordered table-hover table-checkable order-column ">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th hidden>error Id</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Date of Birth</th>
                                <th>Gender</th>
                                <th>Punch Id</th>
                                <th>Contact No</th>
                                <th>Emergency Contact No</th>
                                <th>Address</th>
                                <th>Shift</th>
                                <th>Parent Type</th>
                                <th>Parent Name</th>
                                <th>Parent Contact No</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                    int n = 1;
                            }
                            @foreach (var i in Model.ImportedStudentfailloglist)
                            {
                                <tr class="odd gradeX">
                                    <td id="sr">@n</td>
                                    <td id="hdnImportedFailId" hidden>@i.ImportedFailId</td>
                                    <td id="FirstName">@i.FirstName</td>
                                    <td id="Lastname">@i.Lastname</td>
                                    <td id="Dateofbirth">@i.Dateofbirth</td>
                                    <td id="Gender">@i.Gender</td>
                                    <td id="PunchId">@i.PunchId</td>
                                    <td id="ContactNo">@i.ContactNo</td>
                                    <td id="EmgContactNo">@i.EmgContactNo</td>
                                    <td id="Address">@i.Address</td>
                                    <td id="Shift">@i.Shift</td>
                                    <td id="ParentType">@i.ParentType</td>
                                    <td id="ParentName">@i.ParentName</td>
                                    <td id="ParentContactNo">@i.ParentContactNo</td>
                                    <td id="Reason">@i.Reason</td>
                                </tr>
                                n++;
                            }
                        </tbody>
                    </table>*@
                <table id="tblImportError" class="table table-striped table-bordered table-hover table-checkable order-column ">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th hidden>error Id</th>
                            <th>Row No.</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                             int n = 1;
                        }
                        @foreach (var i in Model.ImportedFailLoglist)
                        {
                            <tr class="odd gradeX">
                                <td id="sr">@n</td>
                                <td id="hdnImportedFailId" hidden>@i.ImportedFailId</td>
                                <td id="Rowno">@i.RowNo</td>
                                <td id="Reason">@i.Reason</td>
                            </tr>
                            n++;
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="col-md-12">
                    <div class="form-group">
                        <h1>File is validated and imported successfully.</h1>
                    </div>
                </div>
            }
        }
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
