        function Isvalidfilter() {
            if ($('#CompanyID').val() <= 0) {
                toastr.remove();
                toastr.error("Please select company.");
                $('#SendReportMail').focus();
                return false;
            }
                //else if ($('#BranchId').val() <= 0) {
                //    toastr.remove();
                //    toastr.error("Please select branch.");
                //    $('#SendReportMail').focus();
                //    return false;
                //}
            else if ($("#BranchId").val() == "" || $("#BranchId").val() == null) {
                toastr.remove();
                toastr.error("Please select branch.");
                $('#SendReportMail').focus();
                return false;
            }
            else if ($("#DeptIds").val() == "" || $("#DeptIds").val() == null) {
                toastr.remove();
                toastr.error("Please select department.");
                $('#SendReportMail').focus();
                return false;
            }
            else if ((selectedEmpArray.length + CustomrptNameArray.length) <= 0) {
                toastr.remove();
                toastr.error("Please select employee for report generation.");
                $('#SendReportMail').focus();
                return false;
            }
            else if ($("#hdnCompanyHead").val() == 0 && $("#hdnDepartmentHead").val() == 0 && $("#hdnBranchHead").val() == 0 && $("#hdnEmployee").val() == 0) {
                toastr.remove();
                toastr.error("Please select at least one send report to.");
                return false;
            }
            else if ((selectedrptIdArray.length + CustomrptIdArray.length) <= 0) {
                toastr.remove();
                toastr.error("Please select at least one report.");
                $('#rptIDstr').focus();
                return false;
            }
            else if ($("#hdnEmployee").val() == 1) {
                if ($("#txt2").val() == 0) {
                    toastr.remove();
                    toastr.error("Please select at least one employee to send report.");
                    event.preventDefault();
                    return false;
                }
                return true;
            }
            else {

                return true;
            }
        }
