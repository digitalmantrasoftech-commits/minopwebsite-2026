                                <h4 class="form-section select_repost_space">Select Report</h4>
                            </div>
                            @Html.Hidden("rptIDstr")
                            @Html.Hidden("rptNamestr")
                            @{
                                if (!string.IsNullOrEmpty(_tokan) && _RoleId > 0)
                                {
                                    var selectedUserMenuReport = objusedetails.GetReportDashBoardRoleWise(_RoleId);
                                    var ParentMenu = selectedUserMenuReport.Where(m => m.ParentMenuName == null).Select(m => new { m.OperationName, m.ImgClassName }).Distinct();

                                    foreach (var item in ParentMenu)
                                    {
                                        foreach (PayTimeWebClient.Models.reqDailyInOutReport itemSub in selectedUserMenuReport.Where(m => m.ParentMenuName == item.OperationName))
                                        {
                                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 check-container">
                                                <label class="check mt-checkbox mt-checkbox-outline">
                                                    @Html.CheckBox(itemSub.OperationName, new { @class = "checkboxes", Value = itemSub.OperationName })
                                                    @itemSub.OperationName
                                                    <span></span>
                                                </label>
                                            </div>
                                        }
                                    }
                                }
                            }
                        </div>
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <span class="help-block" hidden id="spvalidationCustrpt"></span>
                            </div>

                            @Html.Hidden("CustrptIDstr")
                            @Html.Hidden("CustrptNamestr")
                            @{
                                if (!string.IsNullOrEmpty(_tokan) && _RoleId != 4)
                                {
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <h4 class="form-section select_repost_space">Select Custom Report</h4>
                                    </div>
                                    var selectedUserMenuReport = objusedetails.GetCustomerReportList(_RoleId);
                                    var ParentMenu = selectedUserMenuReport.Where(m => m.ReportName != null).Select(m => new { m.ReportName, m.CustRptID }).Distinct();
                                    foreach (var item in ParentMenu)
                                    {
                                        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 custom-checkbox">
                                            <label class="check mt-checkbox mt-checkbox-outline">
                                                @Html.CheckBox(item.ReportName, new { @class = "checkboxes cust_checkboxes", Value = item.ReportName, ID = item.CustRptID })
                                                @item.ReportName
                                                <span></span>
                                            </label>
                                        </div>
                                    }
                                }
                            }
                        </div>
