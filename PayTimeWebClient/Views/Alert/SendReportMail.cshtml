        $("#tblEmp1").destroy;
        //$("#BranchName").after('<table class="table table-striped table-bordered table-hover table-checkable order-column ClsChkEmp" id="tblEmp1"></table>');
        $("#lblemp").hide();

        $('#CustrptIDstr').val(''),
        $('#CustrptNamestr').val(''),
        $('#CustrptIDstr').text(''),
        $('#CustrptNamestr').text(''),
        selectedEmpArray = new Array();
        selectedrptIdArray = new Array();
        selectedrptNameArray = new Array();
        CustomrptIdArray = new Array();
        CustomrptNameArray = new Array();
        $("#EmpID").val("0")
        allVals = [];
        $("#Triggerid").val(0);

        $('[name="areaofinterest"]').each(function (i, e) {
            if ($(e).is(':checked')) {
                $('[name="areaofinterest"]').removeAttr('checked');
                $('[name="areaofinterest"]').prop("checked", false);
            }
        });

        $('[name="tssMonthsdatearr"]').each(function (i, e) {
            if ($(e).is(':checked')) {
                $('[name="tssMonthsdatearr"]').removeAttr('checked');
                $('[name="tssMonthsdatearr"]').prop("checked", false);
            }
        });

        $('[name="tssMothdaynoarr"]').each(function (i, e) {
            if ($(e).is(':checked')) {
                $('[name="tssMothdaynoarr"]').removeAttr('checked');
                $('[name="tssMothdaynoarr"]').prop("checked", false);
            }
        });

        $('[name="tssmonthdayarr"]').each(function (i, e) {
            if ($(e).is(':checked')) {
                $('[name="tssmonthdayarr"]').removeAttr('checked');
                $('[name="tssmonthdayarr"]').prop("checked", false);
            }
        });

    }

