    function Viewschedulerlst() {
        $("#Viewschedulerlst").hide();
        $("#Addscheduler").show();
        $("#AddSendReport").show();

        $("#tblSchedulerdetails").show()
        $("#tblSchedulerfields").hide()
        $("#SchedulerSection").hide()
        $("#MonthlyScheduler").hide()

    }
    function Addscheduler() {
        ClearSelectiondata();
        $('.cust_checkboxes input:checkbox').prop("checked", false);
        $('.cust_checkboxes').prop("checked", false);
        $("#dvFromDate").hide();
        $("#dvTodate").hide();


        $("#dvEmployeelst").hide();
        $("#dvEmployee").hide();


        _flagescheduler = 1;

        $.ajax({
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            async: false,
            url: '@_webapiurl' + '/Alert/GetActiveInactivescheduler',
            data: { CompanyID: cmpid },
            contentType: "application/json; charset=utf-8",
            dataType: 'json',
            success: function (data) {
                // if (data[0].cnt >= 2) {
                if (data[0].cnt >= 10) {
                    toastr.remove();
                    toastr.error("Maximum 10 schedular allow.");
                    return false;
                } else {

                    $("#IsFilo").prop("checked", true);
                    $("#IsFilo").attr("value", 1);
                    $("#IsFilo").attr("disabled", "disabled");

                    $("#tblSchedulerdetails").hide()
                    $("#tblSchedulerfields").show()
                    $("#SchedulerSection").show()
                    $("#MonthlyScheduler").hide()
                    $("#BtnSaveSedular").show()
                    $("#BtnSave").hide()
                    $("#Btnclear").hide()
                    $("#Viewschedulerlst").show();
                    $("#Addscheduler").hide();
                    $("#AddSendReport").hide();
                    $('#CustrptIDstr').val('');
                    $('#CustrptNamestr').val('');

                }
            }
        });

    }

    function AddSendReport() {

        _flagescheduler = 0;
        ClearSelectiondata();
        $("#dvFromDate").show();
        $("#dvTodate").show();

        $("#IsFilo").prop("checked", false);
        $("#IsFilo").removeAttr("disabled");

        $("#tblSchedulerdetails").hide()
        $("#tblSchedulerfields").show()
        $("#SchedulerSection").hide()
        $("#MonthlyScheduler").hide()
        $("#BtnSaveSedular").hide()
        $("#BtnSave").show()
        $("#Btnclear").show()
        $("#Viewschedulerlst").show();
        $("#Addscheduler").hide();
        $("#AddSendReport").hide();

        $("#dvEmployeelst").show();
        $("#dvEmployee").show();


    }
    window.onload = function () {
        timeSpentOnPage();
    }
    $(window).on("beforeunload", function () {
        if (operation == "" || operation == null || operation == '') {
            operation = "View Send Report Mail";
        }
        var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
        var timeSpent = timeSpentOnPage();
        analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
    })
