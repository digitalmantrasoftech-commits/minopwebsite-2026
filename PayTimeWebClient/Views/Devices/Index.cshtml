@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutLandingCloud.cshtml";
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = null;
    string _UserEmail = null;
    string _UserImg = null;
    string _RoleId = null;
    string IsSettingFlag = null;
    int empid = 0;
    string _ddomain = "";
    if (HttpContext.Current.Session["tokan"] != null)
    {
        _tokan = HttpContext.Current.Session["tokan"].ToString();
    }
    if (HttpContext.Current.Session["UserEmail"] != null)
    {
        _UserEmail = HttpContext.Current.Session["UserEmail"].ToString();
    }
    if (HttpContext.Current.Session["photo"] != null)
    {
        _UserImg = HttpContext.Current.Session["photo"].ToString();
    }
    if (HttpContext.Current.Session["RoleId"] != null)
    {
        _RoleId = HttpContext.Current.Session["RoleId"].ToString();
    }
    if (HttpContext.Current.Session["IsSetting"] != null)
    {
        IsSettingFlag = HttpContext.Current.Session["IsSetting"].ToString();
    }
    if (Convert.ToInt32(HttpContext.Current.Session["EmpId"]) != 0)
    {
        empid = Convert.ToInt32(HttpContext.Current.Session["EmpId"].ToString());
    }
}
