@section individual_footer_js{
<script src="~/Scripts/toastr.min.js"></script>
<script src="/AssetsNew/js/script.js"></script>
<script type="text/javascript">
    $('.btn-number').click(function (e) {
        e.preventDefault();

        fieldName = $(this).attr('data-field');
        type = $(this).attr('data-type');
        var input = $("input[name='" + fieldName + "']");
        var currentVal = parseInt(input.val());
        if (!isNaN(currentVal)) {
            if (type == 'minus') {

                if (currentVal > input.attr('min')) {
                    input.val(currentVal - 1).change();
                }
                if (parseInt(input.val()) == input.attr('min')) {
                    $(this).attr('disabled', true);
                }

            } else if (type == 'plus') {

                if (currentVal < input.attr('max')) {
                    input.val(currentVal + 1).change();
                }
                if (parseInt(input.val()) == input.attr('max')) {
                    $(this).attr('disabled', true);
                }

            }
        } else {
            input.val(0);
        }

        extended_warranty();
        installation_service();
        device_price();

        var _totalprice = (parseInt($("#selling_price_PR0005").text()) * parseInt($('#quantity_PR0005').val())) + parseInt($('#extender_warrenty_PR0005').text()) + parseInt($('#installation_service_PR0005').text())
        $("#total_PR0005").text(_totalprice);
    });
    $('.input_number').focusin(function () {
        $(this).data('oldValue', $(this).val());
    });
    $('.input_number').change(function () {

        minValue = parseInt($(this).attr('min'));
        maxValue = parseInt($(this).attr('max'));
        valueCurrent = parseInt($(this).val());

        name = $(this).attr('name');
        if (valueCurrent >= minValue) {
            $(".btn-number[data-type='minus'][data-field='" + name + "']").removeAttr('disabled')
        } else {
            alert('Sorry, the minimum value was reached');
            $(this).val($(this).data('oldValue'));
        }
        if (valueCurrent <= maxValue) {
            $(".btn-number[data-type='plus'][data-field='" + name + "']").removeAttr('disabled')
        } else {
            alert('Sorry, the maximum value was reached');
            $(this).val($(this).data('oldValue'));
        }


    });
    $(".input_number").keydown(function (e) {
        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 190]) !== -1 ||
            (e.keyCode == 65 && e.ctrlKey === true) ||
            (e.keyCode >= 35 && e.keyCode <= 39)) {
            return;
        }
        if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
            e.preventDefault();
        }
    });

    function extended_warranty() {

        if ($('#extended_warranty_PR0005').is(":checked")) {
            $("#extender_warrenty_PR0005").text(0);
            if ($('#year_warranty_1_PR0005').is(":checked")) {
                $('#extender_warrenty_PR0005').text($("#hdnyearwarranty1").text() * parseInt($('#quantity_PR0005').val()));
            } else if ($('#year_warranty_2_PR0005').is(":checked")) {
                $('#extender_warrenty_PR0005').text($("#hdnyearwarranty2").text() * parseInt($('#quantity_PR0005').val()));
            }
            else if ($('#year_warranty_3_PR0005').is(":checked")) {
                $('#extender_warrenty_PR0005').text($("#hdnyearwarranty3").text() * parseInt($('#quantity_PR0005').val()));
            } else {
