    function addToCart() {
        var warr_radio = 0;
        var extended_warr = 0;
        var pincode_check = "";
        var Intallation_Service = "No";
        if ($('#extended_warranty_PR0004').is(":checked")) {
            extended_warr = 1;
            if ($('#year_warranty_1_PR0004').is(":checked")) {
                warr_radio = 1;
            }
            if ($('#year_warranty_2_PR0004').is(":checked")) {
                warr_radio = 2;
            }
            if ($('#year_warranty_3_PR0004').is(":checked")) {
                warr_radio = 3;
            }
        }

        if ($('#intallation_service_PR0004').is(":checked")) {
            pincode_check = $("#pincode_check_PR0004").val();
            Intallation_Service = "Yes";
        }


        var Product = "<img src='/AssetsNew/images/products/BioNIC-F5/product-1.jpg' alt='BioNIC-F5' title='BioNIC-F5'>";
        var Name = "BioNIC-F5";
        var Price = $("#selling_price_PR0004").text();
        var peroff = $("#percentage_off_PR0004").text();

        var ExtendedWarranty = extended_warr;
        var ExtendedWarrantyType = warr_radio;
        var IntallationService = Intallation_Service;
        var IntallationServicePincode = $("#pincode_check_PR0004").val();
        var Quantity = $("#quantity_PR0004").val();
        var Total = $("#total_PR0004").text();
        var _ExtWrntAmt = $("#extender_warrenty_PR0004").text() / Quantity;
        var _IntaSerAmt = $("#installation_service_PR0004").text() / Quantity;

        for (var i in cart) {
            if (cart[i].Product == Product && cart[i].ExtendedWarranty == ExtendedWarranty && cart[i].IntallationServicePincode == IntallationServicePincode
                && cart[i].ExtendedWarranty == ExtendedWarranty && cart[i].ExtendedWarrantyType == ExtendedWarrantyType) {

                cart[i].Quantity = parseInt(cart[i].Quantity) + parseInt(Quantity);  // replace existing Qty

                var _totalprice = (parseInt(cart[i].Price) * parseInt(cart[i].Quantity)) + parseInt(cart[i].ExtWrntAmt) + parseInt(cart[i].IntaSerAmt)
                cart[i].Total = _totalprice;  // replace existing price
                saveCart();
                return;
            }
        }
        var ID = 0;
        if (localStorage.cart != "") {
            for (var i in cart) {
                ID = cart[i].ID;
            }
            ID = ID + 1;
        }

        var item = { ID: ID, ProductID: 'PR0004', Productperoff: peroff, Product: Product, name: Name, ExtendedWarranty: ExtendedWarranty, ExtendedWarrantyType: ExtendedWarrantyType, IntallationService: IntallationService, IntallationServicePincode: IntallationServicePincode, Quantity: Quantity, Price: Price, ExtWrntAmt: _ExtWrntAmt, IntaSerAmt: _IntaSerAmt, Total: Total };
        cart.push(item);
        saveCart();
    }

    function saveCart() {

        if (window.localStorage) {
            localStorage.cart = JSON.stringify(cart);
            //toastr.remove();
            toastr.options.onclick = function () {
            }
            toastr.remove();
            toastr.success("Item added successfully");

