                    $("#sppincode").css("color", "#dc3545");
                    $('#pincode_check_PR0004').css("border", "1px solid #dc3545");
                    $('#installation_service_PR0004').text(0);
                    var _totalprice = (parseInt($("#selling_price_PR0004").text()) * parseInt($('#quantity_PR0004').val())) + parseInt($('#extender_warrenty_PR0004').text()) + parseInt($('#installation_service_PR0004').text());
                    $("#total_PR0004").text(_totalprice);
                }
                else {
                    $("#sppincode").text('Installation service are supported in your area.');
                    $("#sppincode").css("color", "#3e98d3");
                    $(".add_to_cart_btn").prop("disabled", false);
                    $(".buy_now_btn").prop("disabled", false);
                    //$('#installation_service_PR0004').text($("#hdninstallation_service_PR0004").text());
                    $('#installation_service_PR0004').text($("#hdninstallation_service_PR0004").text() * parseInt($('#quantity_PR0004').val()));
                    var _totalprice = (parseInt($("#selling_price_PR0004").text()) * parseInt($('#quantity_PR0004').val())) + parseInt($('#extender_warrenty_PR0004').text()) + parseInt($('#installation_service_PR0004').text());
                    $("#total_PR0004").text(_totalprice);
                }
            },
            error: function (req, status, errorObj) {
            }
        });
    }

