    function CheckPincode() {
        $("#sppincode").text('');
        $('#installation_service_PR0004').text(0);
        $('#pincode_check_PR0004').css("border", "1px solid #e9ecef");
        if ($('#pincode_check_PR0004').val() == "") {
            $("#sppincode").text('Enter Pincode.');
            $('#pincode_check_PR0004').css("border", "1px solid #dc3545");
            return false;
        }

        var _chkpincode = $('#pincode_check_PR0004').val();
        if (_chkpincode.length != "6") {
            $("#sppincode").text('Enter Pincode 6 digits.');
            $('#pincode_check_PR0004').css("border", "1px solid #dc3545");
            //$('#pincode_check_PR0004').val('');
            return false;
        }
        var objreq = { 'Pincode': $('#pincode_check_PR0004').val() }
        $.ajax({
            url: '@_webapiurl' + "Devicecart/GetIntallationPincode",
            type: 'GET',
            datatype: "json",
            data: objreq,
            success: function (data) {
                if (data[0].cnt == "0") {
                    $(".add_to_cart_btn").prop("disabled", true);
                    $(".buy_now_btn").prop("disabled", true);
                    //$("#pincode_check_PR0004").val('');
