        $("#total_PR0001").text(_totalprice);
    }


    $('#clear_btn').click(function () {

        $('#pincode_check_PR0001').val('');
        $("#sppincode").text('');
        $('#pincode_check_PR0001').css("border", "1px solid #e9ecef");

        $("#pincode_check_PR0001").prop("disabled", false);
        $(".add_to_cart_btn").prop("disabled", true);
        $(".buy_now_btn").prop("disabled", true);

        $('#installation_service_PR0001').text(0);
        var _totalprice = (parseInt($("#selling_price_PR0001").text()) * parseInt($('#quantity_PR0001').val())) + parseInt($('#extender_warrenty_PR0001').text()) + parseInt($('#installation_service_PR0001').text())
        $("#total_PR0001").text(_totalprice);

    });

    function CheckPincode() {
        $("#sppincode").text('');
        $('#installation_service_PR0001').text(0);
        $('#pincode_check_PR0001').css("border", "1px solid #e9ecef");
        if ($('#pincode_check_PR0001').val() == "") {
            $("#sppincode").text('Enter Pincode.');
            $('#pincode_check_PR0001').css("border", "1px solid #dc3545");
            return false;
        }

        var _chkpincode = $('#pincode_check_PR0001').val();
        if (_chkpincode.length != "6") {
            $("#sppincode").text('Enter Pincode 6 digits.');
            $('#pincode_check_PR0001').css("border", "1px solid #dc3545");
            
            return false;
        }
        var objreq = { 'Pincode': $('#pincode_check_PR0001').val() }
        $.ajax({
            url: '@_webapiurl' + "Devicecart/GetIntallationPincode",
            type: 'GET',
            datatype: "json",
            data: objreq,
            success: function (data) {
                if (data[0].cnt == "0") {
                    $(".add_to_cart_btn").prop("disabled", true);
                    $(".buy_now_btn").prop("disabled", true);
                    
                    $("#sppincode").text('Installation service is not supported in your area.');
                    $("#sppincode").css("color", "#dc3545");
                    $('#pincode_check_PR0001').css("border", "1px solid #dc3545");
                    $('#installation_service_PR0001').text(0);
                    var _totalprice = (parseInt($("#selling_price_PR0001").text()) * parseInt($('#quantity_PR0001').val())) + parseInt($('#extender_warrenty_PR0001').text()) + parseInt($('#installation_service_PR0001').text())
                    $("#total_PR0001").text(_totalprice);
                }
                else {
                    $("#sppincode").text('Installation service is supported in your area.');
                    $("#sppincode").css("color", "#3e98d3");
                    $(".add_to_cart_btn").prop("disabled", false);
                    $(".buy_now_btn").prop("disabled", false);
                    
                    $('#installation_service_PR0001').text($("#hdninstallation_service_PR0001").text() * parseInt($('#quantity_PR0001').val()));
                    var _totalprice = (parseInt($("#selling_price_PR0001").text()) * parseInt($('#quantity_PR0001').val())) + parseInt($('#extender_warrenty_PR0001').text()) + parseInt($('#installation_service_PR0001').text())
                    $("#total_PR0001").text(_totalprice);
                }
            },
            error: function (req, status, errorObj) {
            }
        });
    }

    $('#check_btn').click(function () {
        CheckPincode();
    });

    $("#btnaddtocart").click(function () {
        addToCart();
        toastr.remove();
        toastr.options.onclick = function () {
            toastr.remove();
            toastr.success("Item added successfully.");
        }
        toastr.remove();
        toastr.success("Item added successfully.");
        window.setTimeout(function () {
            window.location.href = "/Devices";
        }, 1000);

    });

    
    var cart = [];
    $(function () {
        if (localStorage.cart) {
            
            cart = JSON.parse(localStorage.cart);
        }
    });


    function addToCart() {

        var warr_radio = 0;
        var extended_warr = 0;
        var pincode_check = "";
        var Intallation_Service = "No";
        if ($('#extended_warranty_PR0001').is(":checked")) {
            extended_warr = 1;
            if ($('#year_warranty_1_PR0001').is(":checked")) {
                warr_radio = 1;
            }
            if ($('#year_warranty_2_PR0001').is(":checked")) {
                warr_radio = 2;
            }
            if ($('#year_warranty_3_PR0001').is(":checked")) {
                warr_radio = 3;
            }
        }

        if ($('#intallation_service_PR0001').is(":checked")) {
            pincode_check = $("#pincode_check_PR0001").val();
            Intallation_Service = "Yes";
        }


        var Product = "<img src='/AssetsNew/images/products/mBio-FM01/mBio-FM01.jpg' alt='mBio-FM01' title='mBio-FM01'>";
        var Name = "mBio FM01";
        var Price = $("#selling_price_PR0001").text();
        var peroff = $("#percentage_off_PR0001").text();

        var ExtendedWarranty = extended_warr;
        var ExtendedWarrantyType = warr_radio;
        var IntallationService = Intallation_Service;
        var IntallationServicePincode = $("#pincode_check_PR0001").val();
        var Quantity = $("#quantity_PR0001").val();
        var Total = $("#total_PR0001").text();
        var _ExtWrntAmt = $("#extender_warrenty_PR0001").text() / Quantity;
        var _IntaSerAmt = $("#installation_service_PR0001").text() / Quantity;

        for (var i in cart) {
            if (cart[i].Product == Product && cart[i].ExtendedWarranty == ExtendedWarranty && cart[i].IntallationServicePincode == IntallationServicePincode
                    && cart[i].ExtendedWarrantyType == ExtendedWarrantyType) {

                cart[i].Quantity = parseInt(cart[i].Quantity) + parseInt(Quantity);  // replace existing Qty

                var _totalprice = (parseInt(cart[i].Price) * parseInt(cart[i].Quantity)) + parseInt(cart[i].ExtWrntAmt) + parseInt(cart[i].IntaSerAmt)
                cart[i].Total = _totalprice;  // replace existing price
                saveCart();
                return;
            }
        }
        var ID = 0;
        if (localStorage.cart != "") {
            for (var i in cart) {
                ID = cart[i].ID;
            }
            ID = ID + 1;
        }


        var item = {
            ID: ID, ProductID: 'PR0001', Productperoff: peroff, Product: Product, name: Name, ExtendedWarranty: ExtendedWarranty,
            ExtendedWarrantyType: ExtendedWarrantyType, IntallationService: IntallationService, IntallationServicePincode: IntallationServicePincode,
            Quantity: Quantity, Price: Price, ExtWrntAmt: _ExtWrntAmt, IntaSerAmt: _IntaSerAmt, Total: Total
        };
        cart.push(item);
        saveCart();
    }

    function saveCart() {
        if (window.localStorage) {
            localStorage.cart = JSON.stringify(cart);
            
            toastr.options.onclick = function () {
            }
            toastr.remove();
            toastr.success("Item added successfully");

        }
        $("#spshoppingcartcount").text(0);
        $("#spshoppingcartcount1").text(0);
        $("#spshoppingcartcount").text(cart.length);
        $("#spshoppingcartcount1").text(cart.length);
    }


    $('.buy_now_btn').click(function () {
        
        addToCart();

        window.setTimeout(function () {
            window.location.href = 'Cart';
        }, 1000);
    })

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode
        if (charCode > 31 && (charCode < 48 || charCode > 57))
            return false;
        return true;
    }


</script>
