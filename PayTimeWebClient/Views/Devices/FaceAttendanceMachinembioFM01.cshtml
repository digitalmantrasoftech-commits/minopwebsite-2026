        $(".add_to_cart_btn").prop("disabled", false);
        $(".buy_now_btn").prop("disabled", false);

    }
    else {

        $("#pincode_check_PR0001").prop("disabled", false);
        $("#check_btn").prop("disabled", false);
        jQuery('.check_intall_box').css('opacity', '1');

        $(".add_to_cart_btn").prop("disabled", true);
        $(".buy_now_btn").prop("disabled", true);
    }

    function check_exte_warr() {
        checkextendedwarranty()
    }

    function checkextendedwarranty() {
        if ($('#extended_warranty_PR0001').is(":checked")) {
            $(".warr_radio").prop("disabled", false);
            jQuery('.warr_radio_box').css('opacity', '1');

            $("#extender_warrenty_PR0001").text(0);
            if ($('#year_warranty_1_PR0001').is(":checked")) {
                $("#extender_warrenty_PR0001").text($("#hdnyearwarranty1").text() * parseInt($('#quantity_PR0001').val()));
            } else if ($('#year_warranty_2_PR0001').is(":checked")) {
                $("#extender_warrenty_PR0001").text($("#hdnyearwarranty2").text() * parseInt($('#quantity_PR0001').val()));
            }
            else if ($('#year_warranty_3_PR0001').is(":checked")) {
                $("#extender_warrenty_PR0001").text($("#hdnyearwarranty3").text() * parseInt($('#quantity_PR0001').val()));
            } else {
                $('#extender_warrenty_PR0001').text(0);
            }
        }
        else {
            $(".warr_radio").prop("disabled", true);
            jQuery('.warr_radio_box').css('opacity', '0.3');
            $('#extender_warrenty_PR0001').text(0);
        }

