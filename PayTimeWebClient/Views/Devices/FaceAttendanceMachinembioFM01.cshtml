    function check_intall_service() {
        if ($('#intallation_service_PR0001').is(":checked")) {
            if ($('#pincode_check_PR0001').val() != "") {
                $("#pincode_check_PR0001").prop("disabled", false);
                $("#check_btn").prop("disabled", false);
                jQuery('.check_intall_box').css('opacity', '1');

                $(".add_to_cart_btn").prop("disabled", false);
                $(".buy_now_btn").prop("disabled", false);

                $('#installation_service_PR0001').text($("#hdninstallation_service_PR0001").text() * parseInt($('#quantity_PR0001').val()));
            }
            else {
                $('#installation_service_PR0001').text(0);
                $('#pincode_check_PR0001').val('');
                $("#pincode_check_PR0001").prop("disabled", false);
                $("#check_btn").prop("disabled", false);
