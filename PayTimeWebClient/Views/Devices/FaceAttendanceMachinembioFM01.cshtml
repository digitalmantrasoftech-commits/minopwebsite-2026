                    $("#retail_price_PR0001").text(data[index].product_price);
                    $("#selling_price_PR0001").text(data[index].product_rtlsprice);
                    $("#you_save_price_PR0001").text(data[index].product_Dicprice);
                    $("#percentage_off_PR0001").text(data[index].product_Dicper);
                    $("#device_price_PR0001").text(parseInt(data[index].product_rtlsprice) * parseInt($('#quantity_PR0001').val()));
                    $("#hdninstallation_service_PR0001").text(data[index].product_InstallationSrc);
                    $("#hdnyearwarranty1").text(data[index].product_ext1ywrt);
                    $("#hdnyearwarranty2").text(data[index].product_ext2ywrt);
                    $("#hdnyearwarranty3").text(data[index].product_ext3ywrt);

                    extended_warranty();
                    installation_service();

                    var _totalprice = (parseInt(data[index].product_rtlsprice)) + parseInt($('#extender_warrenty_PR0001').text()) + parseInt($('#installation_service_PR0001').text())
                    $("#total_PR0001").text(_totalprice);
                });
            },
            error: function (req, status, errorObj) {
