                            ss += "<td class='total_td' id='ProductID_PR000" + i + "' hidden>" + cart[i].ProductID + "</td>";
                            ss += "<td class='total_td' id='Pincode_PR000" + i + "' hidden>" + cart[i].IntallationServicePincode + "</td>";
                            ss += "<td class='remove_td'><button class='delete_btn_td' onclick='removeitem(" + cart[i].ID + ")'><i class='fa fa-trash'></i></button></td>";
                            ss += "</tr>";
                            _total = _total + parseInt(cart[i].Total);
                        }
                        $("#sub_total_cart").text(_total);
                        $("#PR_All_Total").text(_total);
                        $("#list_of_device_table tbody").html(ss);
                        subscriptionprice();

                    }
                    if ($("#spshoppingcartcount").text() == "0") {
                        window.location.href = "/Devices"
                    }
                });
            }
            else {
                var objreq = { 'receipt_no': $("#hdnreceiptno").text() }
                $.ajax({
                    url: '@_webapiurl' + "Devicecart/GetproductInfoDetails",
                    type: 'GET',
                    datatype: "json",
                    data: objreq,
                    success: function (data) {
                        var ss = "";
                        var _total = 0;
                        $("#spshoppingcartcount").text(data.length);
                        $("#spshoppingcartcount1").text(data.length);
                        $.each(data, function (index) {
                            var _img = "";
                            if (data[index].Product_name.replace(" ", "-") == "mBio-FM01") {
                                _img = "/AssetsNew/images/products/mBio-FM01/mBio-FM01.jpg";
                            }
                            if (data[index].Product_name.replace(" ", "-") == "BioNIC-F5") {
                                _img = "/AssetsNew/images/products/BioNIC-F5/BioNIC-F5.jpg";
                            }
                            if (data[index].Product_name.replace(" ", "-") == "BioNIC-F7") {
                                _img = "/AssetsNew/images/products/BioNIC-F7/BioNIC-F7.jpg";
                            }
                            if (data[index].Product_name.replace(" ", "-") == "BioNIC-FX9") {
                                _img = "/AssetsNew/images/products/BioNIC-F7/BioNIC-F7.jpg";
                            }
                            ss += "<tr class='device_box_tr' id='device_" + index + "'> <td class='img_td' id='Product_img_PR000" + index + "'><img src=" + _img + " alt='" + data[index].Product_name + "' title='" + data[index].Product_name + "'></td>";
                            ss += "<td class='details_td' id='Name_PR000" + index + "'><span>" + data[index].Product_name + "</span></td>";
                            ss += "<td class='exten_warran_td' id='extended_warranty_PR000" + index + "'>" + data[index].ExtendedWarranty + "</td>";
                            ss += "<td class='intall_servi_td' id='intallation_service_PR000" + index + "'>" + data[index].IntallationService + "</td>";
                            ss += "<td class='price_td' id='Price_PR000" + index + "'>₹" + data[index].Price + "/-</td>";
                            ss += "<td class='quan_td'><input class='form-control' type='text' value='" + data[index].Quantity + "' min='1' maxlength='3' id='Quantity_PR000" + index + "' onchange='Quantity(" + index + ");' onkeypress='return isNumberKey(event)' onblur='return isNumberKey(event)'></td>";
                            ss += "<td class='total_td' id='Total_PR000" + index + "'>₹" + data[index].Total + "/-</td>";
                            ss += "<td class='total_td' id='ExtWrntAmt_PR000" + index + "' hidden>" + parseInt(data[index].ExtWrntAmt) / parseInt(data[index].Quantity) + "</td>";
                            ss += "<td class='total_td' id='IntaSerAmt_PR000" + index + "' hidden>" + parseInt(data[index].IntaSerAmt) / parseInt(data[index].Quantity) + "</td>";
                            ss += "<td class='total_td' id='Productperoff_PR000" + index + "' hidden>" + data[index].Productperoff + "</td>";
                            ss += "<td class='total_td' id='ProductID_PR000" + index + "' hidden>" + data[index].ProductID + "</td>";
                            ss += "<td class='total_td' id='Pincode_PR000" + index + "' hidden>" + data[index].IntallationServicePincode + "</td>";
                            ss += "<td class='remove_td'><button class='delete_btn_td' onclick='removeitem(" + data[index].ID + ")'><i class='fa fa-trash'></i></button></td>";
                            ss += "</tr>";
                            _total = _total + parseInt(data[index].Total);

                            if (data[index].PlanDuration == "" || data[index].PlanDuration == null || data[index].PlanDuration == "Duration") {
                                $("#Select_Duration").val('Duration');
                                $("#Select_Type").val('Type');
                                $("#subscription_price").text(0);
                                $("#number_of_employee").val(1);
                                $("#subscription_price_total").text(0);
                            }
                            else {
                                if (data[index].PlanDuration == "Duration") {
                                    $("#wont_plan_yes").prop("checked", true);
                                    $("#wont_plan_no").prop("checked", false);
                                }
                                else {
                                    $("#wont_plan_yes").prop("checked", false);
                                    $("#wont_plan_no").prop("checked", true);
                                }
                                $("#Select_Duration").val(data[index].PlanDuration);
                                $("#Select_Type").val(data[index].PlanType);
                                $("#subscription_price").text(data[index].UserPrice);
                                $("#number_of_employee").val(data[index].NoofEmployee);
                                $("#subscription_price_total").text(data[index].NoofEmployee);
                            }
                        });

                        $("#sub_total_cart").text(_total);
                        $("#PR_All_Total").text(_total);
                        $("#list_of_device_table tbody").html(ss);
                        subscriptionprice();
                        if ($("#spshoppingcartcount").text() == "0") {
                            window.location.href = "/Devices"
                        }

                    },
                    error: function (req, status, errorObj) {
                        if ($("#spshoppingcartcount").text() == "0") {
                            window.location.href = "/Devices"
                        }
                        subscriptionprice();
                    }
                });
            }
        }

        function GetSubscrPlanList() {
            if (localStorage.Subscr_Plan) {
                Subscr_Plan = JSON.parse(localStorage.Subscr_Plan);

                var _wontplan = Subscr_Plan[0].wontplan
                var _Duration = Subscr_Plan[0].Duration
                var _Type = Subscr_Plan[0].Type
                var _Price = Subscr_Plan[0].Price
                var _NoofEmployee = Subscr_Plan[0].NoofEmployee
                var _SubTotal = Subscr_Plan[0].SubTotal

                if (_wontplan == 1) {
                    $("#wont_plan_yes").prop("checked", true);
                    $("#wont_plan_no").prop("checked", false);
                }
                else {
                    $("#wont_plan_yes").prop("checked", false);
                    $("#wont_plan_no").prop("checked", true);
                }

                $("#Select_Duration").val(_Duration);
                $("#Select_Type").val(_Type);
                $("#subscription_price").text(_Price);
                $("#number_of_employee").val(_NoofEmployee);

                $("#subscription_price_total").text(_SubTotal);
                $("#ff_subscription_price_total").text(_SubTotal);
                $("#subscriptionplancartamt").text(_SubTotal);

            }
        }
    </script>
}