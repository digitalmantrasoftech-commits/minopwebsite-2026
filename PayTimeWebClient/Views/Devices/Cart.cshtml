        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#strstg3").text('');
            $("#strstg4").text('@_meg');
            $('.subsc_plan > input[type="radio"]').click(function () {
                var inputValue = $(this).attr("value");
                var targetBox = $("." + inputValue);
                $(".month_plan, .year_plan").not(targetBox).hide();
                $(targetBox).show();
            });

            $(".right_side_box").removeClass("open");
            $("body").removeClass("body_right_side_open");
            $(".right_side_box").addClass("close");

            $(".monthly_essential").hide();
            $(".monthly_elite").hide();
            $(".monthly_premium").hide();
            $(".monthly_not").hide();
            $(".yearly_essential").hide();
            $(".yearly_elite").hide();
            $(".yearly_premium").hide();
            $(".yearly_not").hide();
            $(".monthly_yearly_not").hide();


            $(".view_plan_details").prop("disabled", true);
            $("#subscribe_btn").prop("disabled", true);
            $("#number_of_employee").val(1);
            $('#subscription_price').text('0');
            $('#subscription_price_total').text('0');
            $('#ff_subscription_price_total').text('0');

            $("#IsCart").val(1);
            $("#PlanInfo").hide();
            var Subscr_Plan = [];
            $(function () {
                if (localStorage.Subscr_Plan) {
                    GetSubscrPlanList();
                }
            });


            var _msgg = '@_meg'
            if ('@_meg' != '') {
                if ('@_meg' == "Saved") {
                    $("#spUsername").text($("#UserEmail").val());
                    $("#spUsername1").text($("#UserEmail").val());
                    $(".sign_in_up_section").removeClass("open");
                    $("body").removeClass("sign_in_up_open");
                    $(".sign_in_up_section").addClass("close");

                    $(".sign_in_up_section").removeClass("close");
                    $("body").addClass("sign_in_up_open");
                    $(".sign_in_up_section").addClass("open");

                    $(".sign_up_box").hide();
                    $(".sign_in_box").show();
                }
                else {
                    $(".sign_in_up_section").removeClass("close");
                    $("body").addClass("sign_in_up_open");
                    $(".sign_in_up_section").addClass("open");

                    $(".sign_up_box").hide();
                    $(".sign_in_box").show();
                }
            }

            if ('@_UserEmail' != '') {
                $(".sign_in_up_section").removeClass("open");
                $("body").removeClass("sign_in_up_open");
                $(".sign_in_up_section").addClass("close");

                $("#spUsername").text('@_UserEmail');
                $("#spUsername1").text('@_UserEmail');

                $(".sign_up_box").hide();
                $(".sign_in_box").show();
                $(".Check_Out").hide();
                $(".Process_Now").show();

                $(".Login_btn").hide();
                $(".user_box").show();

                if (localStorage.Subscr_Plan == "")
                {
                    $('input:radio[name=wont_plan]').prop("disabled", false);
                    $("#Select_Duration").prop("disabled", false);
                    $("#Select_Type").prop("disabled", false);
                    $("#number_of_employee").prop("disabled", false);
                    $(".view_plan_details").prop("disabled", false);
                    $("#subscribe_btn").prop("disabled", false);
                }
                $('input:radio[name=wont_plan]').prop("disabled", true);
            }
            else {
                $('input:radio[name=wont_plan]').prop("disabled", false);
                $("#Select_Duration").prop("disabled", false);
                $("#Select_Type").prop("disabled", false);
                $("#number_of_employee").prop("disabled", false);
                $(".view_plan_details").prop("disabled", false);
                $("#subscribe_btn").prop("disabled", false);

            }

            if ($('input:radio[name=wont_plan]:checked').val() == "1") {
                $("#Select_Duration").prop("disabled", true);
                $("#Select_Type").prop("disabled", true);
                $("#number_of_employee").prop("disabled", true);
            }
            else {
                $("#Select_Duration").prop("disabled", false);
                $("#Select_Type").prop("disabled", false);
                $("#number_of_employee").prop("disabled", false);

            }

            if ($("#hdnreceiptno").text() == "") {
                $("#hdnreceiptno").text('@_receiptno');
            }

            GetCartList();

            var lookup = {
                'Duration': ['Type'],
                'Monthly': ['Type', 'Premium'],
                'Yearly': ['Type', 'Essential', 'Elite', 'Premium'],
            };
            var lookuptext = {
                'Duration': ['-- select --'],
                'Monthly': ['-- select --', 'Premium'],
                'Yearly': ['-- select --', 'Essential', 'Elite', 'Premium'],
            };
            
            $('#Select_Duration').on('change', function () {
                $("#spmth").hide();
                $("#PlanInfo").hide();
                var selectValue = $(this).val();
                $('#Select_Type').empty();
                for (i = 0; i < lookup[selectValue].length; i++) {
                    $('#Select_Type').append("<option value='" + lookup[selectValue][i] + "'>" + lookuptext[selectValue][i] + "</option>")
                }
                if (selectValue == 'Monthly') {
                    $("#spmth").show();
                    $('#Select_Type').val("Premium");
                    if ($('#Select_Type').val() == "Premium") {
                        $("#number_of_employee").val(1000);
                        $("#number_of_employee").prop("disabled", true);
                        $('#PlanInfo').prop('title', 'This plan free for one month with 1000 users.');
                        $("#PlanInfo").show();
                    }
                }
                GetSubscriptionprice();
            });


            $('#Select_Type').on('change', function () {
                $("#PlanInfo").hide();
                $("#number_of_employee").prop("disabled", false);
                if ($('#Select_Duration').val() != "Duration") {
                    if ($('#Select_Duration').val() == "Monthly") {
                        if ($('#Select_Type').val() == "Premium") {
                            $("#number_of_employee").val(1000);
                            $("#number_of_employee").prop("disabled", true);
                            $('#PlanInfo').prop('title', 'This plan free for one month with 1000 users.');
                            $("#PlanInfo").show();
                        }
                    }
                    else {
                        $("#PlanInfo").show();
                        $('#PlanInfo').prop('title', 'This plan price free for one month.');
                        $("#number_of_employee").val(1);
                    }
                }
                else {
                    $('#Select_Type').val("Type");
                }
                GetSubscriptionprice();
            });
            

            $(".view_plan_details").click(function () {

                var duration = $("#Select_Duration");
                
                if (duration.val() == "Monthly") {

                    var monthly_type = $("#Select_Type");
                    
                    if (monthly_type.val() == "Essential") {
                        $(".monthly_essential").show();

                        $(".monthly_elite").hide();
                        $(".monthly_premium").hide();
                        $(".monthly_not").hide();
                        $(".yearly_essential").hide();
                        $(".yearly_elite").hide();
                        $(".yearly_premium").hide();
                        $(".yearly_not").hide();
                        $(".monthly_yearly_not").hide();

                        $(".right_side_box").addClass("open");
                        $("body").addClass("body_right_side_open");
                        $(".right_side_box").removeClass("close");

                        return false;
                    }
                    
                    else if (monthly_type.val() == "Elite") {
                        $(".monthly_elite").show();

                        $(".monthly_essential").hide();
                        $(".monthly_premium").hide();
                        $(".monthly_not").hide();
                        $(".yearly_essential").hide();
                        $(".yearly_elite").hide();
                        $(".yearly_premium").hide();
                        $(".yearly_not").hide();
                        $(".monthly_yearly_not").hide();

                        $(".right_side_box").addClass("open");
                        $("body").addClass("body_right_side_open");
                        $(".right_side_box").removeClass("close");

                        return false;
                    }
                    
                    else if (monthly_type.val() == "Premium") {
                        $(".monthly_premium").show();

                        $(".monthly_essential").hide();
                        $(".monthly_elite").hide();
                        $(".monthly_not").hide();
                        $(".yearly_essential").hide();
                        $(".yearly_elite").hide();
                        $(".yearly_premium").hide();
                        $(".yearly_not").hide();
                        $(".monthly_yearly_not").hide();

                        $(".right_side_box").addClass("open");
                        $("body").addClass("body_right_side_open");
                        $(".right_side_box").removeClass("close");

                        return false;
                    }
                    
                    else {
                        toastr.remove();
                        toastr.error("Monthly plan type not selected.");
                        return false;
                    }
                }
                    
                else if (duration.val() == "Yearly") {
                    var yearly_type = $("#Select_Type");
                    
                    if (yearly_type.val() == "Essential") {
                        $(".yearly_essential").show();

                        $(".monthly_essential").hide();
                        $(".monthly_elite").hide();
                        $(".monthly_premium").hide();
                        $(".monthly_not").hide();
                        $(".yearly_elite").hide();
                        $(".yearly_premium").hide();
