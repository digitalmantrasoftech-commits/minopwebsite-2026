        function GetSubscriptionprice() {

            var _SelectType = $("#Select_Type").val();
            var _SelectDuration = $("#Select_Duration").val();

            if (_SelectType != "Type") {
                var objreq = { 'PlanType': _SelectType }
                $.ajax({
                    url: '@_webapiurl' + "Devicecart/GetSubscriptionprice",
                    type: 'GET',
                    datatype: "json",
                    data: objreq,
                    success: function (data) {

                        $.each(data, function (index) {
                            var _prc = 0;
                            if (_SelectDuration == "Monthly") {
                            }
                            else {
                                _prc = parseFloat(data[index].ppupy) * parseFloat(365);
                            }

                            $("#subscription_price").text(parseFloat(_prc));
                            subscriptionprice();
                        });
                    },
                    error: function (req, status, errorObj) {
                        subscriptionprice();
                    }
                });
            }
            else {
                $("#subscription_price").text("0");
                $("#subscription_price_total").text("0");
                $("#subscriptionplancartamt").text("0");
                $("#ff_subscription_price_total").text("0");
                $("#number_of_employee").val("1");
                var _GrandTotal = parseFloat($("#sub_total_cart").text().replace("₹", "").replace("/-", "")) + parseFloat($("#subscriptionplancartamt").text());
                $("#Grand_Total").text(_GrandTotal);
            }
        };


        function subscriptionprice() {

            var _value = $('#number_of_employee').val().replace(/[^0-9]/g, '');
            $('#number_of_employee').val(_value);

            if ($("#number_of_employee").val() <= 0) {
                $("#number_of_employee").val(1);
            }

            $("#sub_total_cart").text($("#PR_All_Total").text());
            var subscription_price = $("#subscription_price").text().replace("₹", "").replace("/-", "");
            var numberofemployee = $("#number_of_employee").val();
            var Cntamt = parseFloat(subscription_price) * parseFloat(numberofemployee);

            var _prcmth = parseFloat(Cntamt) / parseFloat(12);

            var _cnt = parseFloat(parseFloat(Cntamt) - parseFloat(_prcmth.toFixed(2)));

            $("#subscription_price_total").text(parseFloat(Math.round(_cnt)));
            $("#subscriptionplancartamt").text(parseFloat(Math.round(_cnt)));
            $("#ff_subscription_price_total").text(parseFloat(Math.round(_cnt)));

            var _GrandTotal = parseFloat($("#sub_total_cart").text().replace("₹", "").replace("/-", "")) + parseFloat($("#subscriptionplancartamt").text());
            $("#Grand_Total").text(Math.round(_GrandTotal));
        }
