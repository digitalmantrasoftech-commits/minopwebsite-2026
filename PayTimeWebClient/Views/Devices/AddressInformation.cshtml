        function CheckPincode(pincode, Type) {

            if (Type == "Bill") {
                $('#zipcode_bd').css("border-bottom", "1px solid #e9ecef");
            }
            else {
                $('#zipcode_sd').css("border-bottom", "1px solid #dc3545");
            }
            var objreq = { 'Pincode': pincode }
            $.ajax({
                url: '@_webapiurl' + "Devicecart/GetIntallationPincode",
                type: 'GET',
                datatype: "json",
                data: objreq,
                success: function (data) {
                    if (data[0].cnt == "0") {
                        toastr.remove();
                        toastr.error("Service are not supported in your area.");
                        if (Type == "Bill") {
                            $('#zipcode_bd').val('');
                            $('#zipcode_bd').css("border-bottom", "1px solid #dc3545");
                        }
                        else {
                            $('#zipcode_sd').val('');
                            $('#zipcode_sd').css("border-bottom", "1px solid #dc3545");
                        }
                    }
                },
                error: function (req, status, errorObj) {
                }
            });
        }

        function isNumberKey(evt) {
            var charCode = (evt.which) ? evt.which : evt.keyCode
            if (charCode > 31 && (charCode < 48 || charCode > 57))
                return false;
            return true;
        }

