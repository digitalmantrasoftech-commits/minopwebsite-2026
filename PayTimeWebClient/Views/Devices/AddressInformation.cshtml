        function save_pay_now()
        {
            var _Isreccuring = 0;
            if ($("#subsc_plan_duration").text() == 'Monthly') {
                //_Isreccuring = 1
                _Isreccuring = 0
            }

            var _camt = $("#device_cart_total").text().replace('₹', '').replace('/-', '');
            var _Totalamt = $("#final_pay_total").text().replace('₹', '').replace('/-', '');
            var _PlanId = $("#hdnplanid").val();
            var _Duration = $("#subsc_plan_duration").text();
            var _Quantity = $("#subsc_no_of_employee").text();
            var _Taxofpyament = "TaxName : GST TaxAmount: " + $("#taxesamt").text() + " TaxPer: 18 TaxVtype :2";

            $("#camt").val(_camt);
            $("#Totalamt").val(_Totalamt);
            $("#PlanId").val(_PlanId);
            $("#Duration").val(_Duration);
            $("#Quantity").val(_Quantity);
            $("#Taxofpyament").val(_Taxofpyament);
            var _Paymentmethod = $("#Paymentmethod").text();
          @*$("#receiptno").val('@_receiptno');*@

          var _receipt_no = "";
            if ($("#receiptno").val() == "") {
                _receipt_no = "Receipt_" + (Math.random() * 1e32).toString(16).substring(0, 6);
                $("#receiptno").val(_receipt_no);
            }

            var Subscr_Plan = [];
            Subscr_Plan = JSON.parse(localStorage.Subscr_Plan);
            var _Isnewregister = 1;
            var _Duration = "";
            var _PlanType = 0;
            var _PlanPrice = 0;
            var _NopfEmployee = 0;
            var _Total = 0;
            for (var i in Subscr_Plan) {
                if (Subscr_Plan[i].wontplan == 2) {
                    _Isnewregister = 2;
                    _Duration = Subscr_Plan[i].Duration;
                    _PlanType = Subscr_Plan[i].Plan;
                    _PlanPrice = Subscr_Plan[i].Price;
                    _NopfEmployee = Subscr_Plan[i].NoofEmployee;
                    _Total = Subscr_Plan[i].SubTotal;
                }
            }

            var list = new Array();
            var cart = [];
            cart = JSON.parse(localStorage.cart);
            for (var i in cart) {
                var _productQuantity = cart[i].Quantity;
                var _productExtWrntAmt = parseFloat(cart[i].ExtWrntAmt) * parseFloat(_productQuantity);
                var _productIntaSerAmt = parseFloat(cart[i].IntaSerAmt) * parseFloat(_productQuantity);

                list.push({
                    productname: cart[i].name,
                    productid: cart[i].ProductID,
                    extendedwarranty: cart[i].ExtendedWarrantyType,
                    intallationservice: cart[i].IntallationService,
                    intallservicepincode: cart[i].IntallationServicePincode,
                    productprice: cart[i].Price,
                    productQuantity: cart[i].Quantity,
                    productdicprice: cart[i].Total,
                    productExtWrntAmt: Math.round(_productExtWrntAmt),
                    productIntaSerAmt: Math.round(_productIntaSerAmt),
                    Productperoff: cart[i].Productperoff,
                    Productqtn: cart[i].Total,
                });
            }
            var obj = {
                lstproduct: list,
                receiptno: $("#receiptno").val(),
                companyid: '@_companyid',
                entryby: '@_companyid',
                CustomerType: _Isnewregister,
                Duration: _Duration,
                PlanType: _PlanType,
                PlanPrice: _PlanPrice,
                NopfEmployee: _NopfEmployee,
                Total: _Total,
                SubTotal: $("#device_subsc_subtotal").text().replace('₹', '').replace('/-', ''),
                SubscriptionPlan: $("#subsc_cart_total").text().replace('₹', '').replace('/-', ''),
                GrandTotal: $("#final_pay_total").text().replace('₹', '').replace('/-', ''),
                saveType: "Insert",
                Isreccuring: _Isreccuring,
                Paymentmethod: _Paymentmethod
            }

            $("#product").val(JSON.stringify(obj));


            //if (_flg == 0) {


                $("#frmadderessinfo").submit();
                localStorage.Subscr_Plan = "";
                localStorage.cart = "";
            //}

            $("#hdnreceiptno").text(_receipt_no);
        }

