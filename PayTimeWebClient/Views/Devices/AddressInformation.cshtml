                            _img = "/AssetsNew/images/products/mBio-FM01/mBio-FM01.jpg";
                        }
                        if (data[index].Product_name.replace(" ", "-") == "BioNIC-F5") {
                            _img = "/AssetsNew/images/products/BioNIC-F5/BioNIC-F5.jpg";
                        }
                        if (data[index].Product_name.replace(" ", "-") == "BioNIC-F7") {
                            _img = "/AssetsNew/images/products/BioNIC-F7/BioNIC-F7.jpg";
                        }
                        _Productcart += "<div class='product_cart_box' id='device_PR000" + index + "'>";
                        _Productcart += "<img src='" + _img + "')' alt='mBio-FM01' title='mBio-FM01' id='device_img_PR000" + index + "' />";
                        _Productcart += "<div class='product_name' id='device_name_PR000" + index + "'>" + data[index].Product_name + "</div>";
                        _Productcart += "<div class='product_details' id='brand_name_PR000" + index + "'>Brand Name:<span>" + data[index].BarndName + "</span></div>";
