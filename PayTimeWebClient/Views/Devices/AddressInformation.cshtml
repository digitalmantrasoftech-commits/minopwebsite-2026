-8 col-md-7 col-sm-12 col-xs-12"> <div class="shipping_delivery_cart"> <div class="shipping_delivery_cart_header"> Shipping & Delivery </div><div class="shipping_delivery_cart_body"> <p>Orders are delivered on business days (Monday-Friday) excluding public holidays.</p></div></div><div class="delivery_details_cart"> <form action="AddressInformation" method="post" id="frmadderessinfo"> <div class="billing_shipping_box"> <div class="billing_cart_box"> <div class="row"> <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12"> <h3>Billing Details</h3> </div></div><div class="row"> <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="company_name_bd">Company Name</label><span class="required" aria-required="true" style="color:red"> * </span> <input type="text" class="form-control" id="company_name_bd" name="company_name_bd" readonly> </div></div><div class="col-lg-4 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="user_name_bd">Email</label><span class="required" aria-required="true" style="color:red"> * </span> <input type="text" class="form-control" id="user_name_bd" name="user_name_bd" readonly> </div></div><div class="col-lg-4 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="mobile_number_bd">Mobile Number</label><span class="required" aria-required="true" style="color:red"> * </span> <input type="text" class="form-control" id="mobile_number_bd" name="mobile_number_bd" onkeypress='return isNumberKey(event)' maxlength="10"> </div></div><div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12"> <hr /> </div></div><div class="row"> <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="address_bd">Address</label><span class="required" aria-required="true" style="color:red"> * </span> <textarea class="form-control" id="address_bd" name="address_bd"></textarea> </div></div><div class="col-lg-6 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="country_bd">Country / Region</label><span class="required" aria-required="true" style="color:red"> * </span> @Html.DropDownList("country_bd", new SelectList(new[] { "" }), "Select Country", new { @class = "form-control input-sm" }) </div></div><div class="col-lg-6 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="state_bd">State / Province / Region</label><span class="required" aria-required="true" style="color:red"> * </span> @Html.DropDownList("state_bd", new SelectList(new[] { "" }), "Select State", new { @class = "form-control input-sm" }) </div></div><div class="col-lg-6 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="city_bd">Town / City</label><span class="required" aria-required="true" style="color:red"> * </span> @Html.DropDownList("city_bd", new SelectList(new[] { "" }), "Select City", new { @class = "form-control input-sm" }) </div></div><div class="col-lg-6 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="zipcode_bd">Zipcode / Pincode</label><span class="required" aria-required="true" style="color:red"> * </span> <input type="Number" class="form-control" id="zipcode_bd" name="zipcode_bd"> </div></div><div class="col-lg-6 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="gstn_bd">Client GSTN (ex: 11xxxxx1111x1x1)</label> <input type="text" class="form-control" id="gstn_bd" placeholder="" name="gstn_bd"> </div></div></div></div><div class="shipping_cart_box"> <div class="row"> <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12"> <h3>Shipping Details</h3> </div></div><div class="row"> <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="">Same as Billing Address</label><br /> <label class="same_as_billing_box" for="same_as_billing_yes"> <input type="radio" name="same_as_billing" id="same_as_billing_yes" value="1"> <span>Yes</span> </label> <label class="same_as_billing_box" for="same_as_billing_no"> <input type="radio" name="same_as_billing" id="same_as_billing_no" value="2" checked> <span>No</span> </label> </div></div></div><div class="row"> <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="address_sd">Address</label><span class="required" aria-required="true" style="color:red"> * </span> <textarea class="form-control" id="address_sd" name="address_sd"></textarea> </div></div><div class="col-lg-6 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="country_sd">Country / Region</label><span class="required" aria-required="true" style="color:red"> * </span> @Html.DropDownList("country_sd", new SelectList(new[] { "" }), "Select Country", new { @class = "form-control input-sm" }) </div></div><div class="col-lg-6 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="state_sd">State / Province / Region</label><span class="required" aria-required="true" style="color:red"> * </span> @Html.DropDownList("state_sd", new SelectList(new[] { "" }), "Select State", new { @class = "form-control input-sm" }) </div></div><div class="col-lg-6 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="city_sd">Town / City</label><span class="required" aria-required="true" style="color:red"> * </span> @Html.DropDownList("city_sd", new SelectList(new[] { "" }), "Select City", new { @class = "form-control input-sm" }) </div></div><div class="col-lg-6 col-md-12 col-sm-12 col-xs-12"> <div class="form-group"> <label for="zipcode_sd">Zipcode / Pincode</label><span class="required" aria-required="true" style="color:red"> * </span> <input type="email" class="form-control" id="zipcode_sd" name="zipcode_sd"> </div></div></div></div></div><div class="privac_cookie_box"> <label class="form-check-label" for="privac_cookie"> <input type="checkbox" class="form-check-input" id="privac_cookie"> <span> I have read and consent to eshopworld processing my information in accordance with the <a class="link_privacy_statement" href="https://app.minopcloud.com/Privacy-Policy" target="_blank">privacy statement</a> and <a class="link_cookie_policy" href="https://app.minopcloud.com/Privacy-Policy" target="_blank">cookie policy</a>. </span> </label> </div><input type="hidden" id="receiptno" name="receiptno" /> <input type="hidden" id="camt" name="camt" /> <input type="hidden" id="Totalamt" name="Totalamt" /> <input type="hidden" id="PlanId" name="PlanId" /> <input type="hidden" id="Duration" name="Duration" /> <input type="hidden" id="Quantity" name="Quantity" /> <input type="hidden" id="Taxofpyament" name="Taxofpyament" /> <input type="hidden" id="product" name="product" /> <input type="hidden" id="Paymentmethod" name="Paymentmethod" /> <div class="text-right"> <button type="button" value="Pay_Now" class="Pay_Now" id="Pay_Now" disabled="true">PAY NOW</button> </div></form> </div></div></div></div></section>
