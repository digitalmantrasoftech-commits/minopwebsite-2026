@section individual_footer_js{
    <script src="/AssetsNew/js/script.js"></script>
    <script>
        $(document).ready(function () {
            var errmsg = '@_errmsg';
            $("#receiptno").text('@_receiptno');
            if (errmsg != '') {
                toastr.remove();
                toastr.error(errmsg);
            }

            $("#privac_cookie").prop('checked', false);

            var id = '@Session["ClientCompanyId"]';
            $.get("/PayTime/GetCompanyInfo?id=" + id, function (response) {
                var obj = $.parseJSON(response);
                $("#company_name_bd").val(obj.CompanyName);
                $("#mobile_number_bd").val(obj.CompanyContact);
                $("#user_name_bd").val(obj.CompanyEmail);
            });

            $("#company_name_bd").val('@_cmpname');
            $('input[type="text"]').on('keydown', function (e) {
                if (e.which === 188 || e.which === 190 || e.which === 16 || e.which === 17 || e.which === 86) {
                    e.preventDefault();
                    return false;
                }
            });

            $('input[type="Number"]').on('keydown', function (e) {
                if (e.which === 188 || e.which === 190 || e.which === 16 || e.which === 17 || e.which === 86) {
                    e.preventDefault();
                    return false;
                }
            });

            $("#address_bd").on("keydown", function (e) {
                if (this.value.length === 0 && e.which === 32) e.preventDefault();
            });

            $("#address_sd").on("keydown", function (e) {
                if (this.value.length === 0 && e.which === 32) e.preventDefault();
            });

            $("#privac_cookie").click(function () {
                if ($(this).is(":checked")) {
                    $("#Pay_Now").prop("disabled", false);
                }
                else {
                    $("#Pay_Now").prop("disabled", true);
                }
            });

            $("#hdnreceiptno").text('@_receiptno');

            Countrylist();
            GetAllTaxes();
            $('input[type=radio][name=same_as_billing]').change(function () {
                if (this.value == 1) {
                    $("#address_sd").val($("#address_bd").val());
                    $("#country_sd").val($("#country_bd").val());
                    if ($("#country_sd").val() != 0) {
                        GetStatelist($("#country_sd").val());
                        if ($("#state_sd").val() != 0) {
                            GetCitylist($("#state_bd").val());
                        }
                    }
                    $("#zipcode_sd").val($("#zipcode_bd").val());

                    $("#address_sd").prop("readonly", true);
                    $("#country_sd").prop("readonly", true);
                    $("#state_sd").prop("readonly", true);
                    $("#city_sd").prop("readonly", true);
                    $("#zipcode_sd").prop("readonly", true);

                }
                else if (this.value == 2) {
                    $("#address_sd").prop("readonly", false);
                    $("#country_sd").prop("readonly", false);
                    $("#state_sd").prop("readonly", false);
                    $("#city_sd").prop("readonly", false);
                    $("#zipcode_sd").prop("readonly", false);
                }
            });

        });
        function Countrylist() {
            $("#country_bd").empty();
            $("#country_sd").empty();
            var _urlcmp = '@_webapiurl' + 'Devicecart/GetCountryAll';
            $.ajax({
                type: "GET",
                url: _urlcmp,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    $("#country_bd").append("<option value='0'>Select Country</option>");
                    $("#country_sd").append("<option value='0'>Select Country</option>");

                    for (var x = 0; x < data.length; x++) {
                        $("#country_bd").append("<option value=" + data[x].CountryId + ">" + data[x].Countryname + "</option>");
                        $("#country_sd").append("<option value=" + data[x].CountryId + ">" + data[x].Countryname + "</option>");
                    }
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
        }

        function GetAllTaxes() {
            var _urlcmp = '@_webapiurl' + 'Devicecart/GetAllTaxes';
            $.ajax({
                type: "GET",
                url: _urlcmp,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {

                    for (var x = 0; x < data.length; x++) {
                        if (data[x].taxpara == 'GST') {
                            $("#taxesper").text(data[x].taxparavalue)
                            GetAddressInfo();
                        }
                    }
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
        }

        function GetAddressInfo() {
            var _Productcart = "";
            var _cart_total = 0;

            var objreq = { 'receipt_no': '@_receiptno' }
            var cart = [];
            var Subscr_Plan = [];
            if (localStorage.cart) {
                cart = JSON.parse(localStorage.cart);
                for (var i in cart) {
                    j = i + 1;
                    var _img = "";

                    if (cart[i].name.replace(" ", "-") == "mBio-FM01") {
                        _img = "/AssetsNew/images/products/mBio-FM01/mBio-FM01.jpg";
                    }
                    if (cart[i].name.replace(" ", "-") == "BioNIC-F5") {
                        _img = "/AssetsNew/images/products/BioNIC-F5/BioNIC-F5.jpg";
                    }
                    if (cart[i].name.replace(" ", "-") == "BioNIC-F7") {
                        _img = "/AssetsNew/images/products/BioNIC-F7/BioNIC-F7.jpg";
                    }
                    _Productcart += "<div class='product_cart_box' id='device_PR000" + j + "'>";
                    _Productcart += "<img src='" + _img + "' alt='mBio-FM01' title='mBio-FM01' id='device_img_PR000" + j + "' />";
                    _Productcart += "<div class='product_name' id='device_name_PR000" + j + "'>" + cart[i].name + "</div>";
                    _Productcart += "<div class='product_details' id='extended_warranty_PR000" + j + "'>Extended Warranty:<span>" + cart[i].ExtendedWarranty + "</span></div>";
                    _Productcart += "<div class='product_details' id='intallation_service_PR000" + j + "'>Intallation Service:<span>" + cart[i].IntallationService + "</span></div>";
                    _Productcart += "<div class='product_details' id='device_price_PR000" + j + "'>Price:<span>₹" + cart[i].Price + "/-</span></div>";
                    _Productcart += "<div class='product_details' id='device_quantity_PR000" + j + "'>Quantity:<span>" + cart[i].Quantity + "</span></div>";
                    _Productcart += "<div class='product_total' id='device_total_PR000" + j + "'>Total:<span>₹" + cart[i].Total + "/-</span></div>";
                    _Productcart += "</div>";
                    _cart_total = (parseFloat(_cart_total) + parseFloat(cart[i].Total));
                    $("#device_cart_total").text("₹" + _cart_total + "/-");
                }

                if (localStorage.Subscr_Plan) {
                    Subscr_Plan = JSON.parse(localStorage.Subscr_Plan);
                    for (var i in Subscr_Plan) {
                        if (Subscr_Plan[i].wontplan == 1) {
                            $("#subsc_cart_lst").hide();
                            $("#subsc_plan_duration").text('-NA-');
                            $("#subsc_plan_type").text('-NA-');
                            $("#subsc_price_per_user").text(0);
                            $("#subsc_no_of_employee").text(1);
                            $("#subsc_total").text(0);
                            $("#subsc_cart_total").text("₹0/-");
                            $("#device_subsc_subtotal").text("₹" + parseFloat(_cart_total) + "/-");
                            $("#shipping_delivery").text("₹0/-");
                            $("#taxesamt").text("₹0/-");
                        }
                        else {
                            $("#subsc_cart_lst").show();
                            $("#subsc_plan_duration").text(Subscr_Plan[i].Duration);
                            $("#subsc_plan_type").text(Subscr_Plan[i].Type);
                            $("#hdnplanid").val(Subscr_Plan[i].Plan);
                            $("#subsc_price_per_user").text(Subscr_Plan[i].Price);
                            $("#subsc_no_of_employee").text(Subscr_Plan[i].NoofEmployee);
                            $("#subsc_total").text(parseFloat(Subscr_Plan[i].SubTotal));
                            $("#subsc_cart_total").text("₹" + parseFloat(Subscr_Plan[i].SubTotal) + "/-");
                            $("#device_subsc_subtotal").text("₹" + (parseFloat(_cart_total) + parseFloat(Subscr_Plan[i].SubTotal)) + "/-");
                            $("#shipping_delivery").text("₹0/-");
                            $("#taxesamt").text("₹0/-");

                        }
                    }
                }
                else {
                    $("#subsc_cart_lst").hide();
                    $("#subsc_plan_duration").text('-NA-');
                    $("#subsc_plan_type").text('-NA-');
                    $("#subsc_price_per_user").text(0);
                    $("#subsc_no_of_employee").text(1);
                    $("#subsc_total").text(0);
                    $("#subsc_cart_total").text("₹0/-");
                    $("#device_subsc_subtotal").text("₹" + parseFloat(_cart_total) + "/-");
                    $("#shipping_delivery").text("₹0/-");
                    $("#taxesamt").text("₹0/-");
                }

                var _finalpaytotal = parseFloat($("#device_subsc_subtotal").text().replace("₹", "").replace("/-", ""));

                var _finaltotal = parseFloat(parseFloat(_finalpaytotal) * parseFloat($("#taxesper").text())) / parseFloat(100);

                $("#taxesamt").text(Math.round(parseFloat(_finaltotal)));

                _finaltotal = parseFloat(_finaltotal) + parseFloat(_finalpaytotal) + parseFloat($("#shipping_delivery").text().replace("₹", "").replace("/-", ""))

                $("#final_pay_total").text("₹" + Math.round(parseFloat(_finaltotal)) + "/-");

                $("#product_cart").append(_Productcart);

                $("#no_of_device_cart").text(cart.length);
            }

        }

        function GetAddressInfo1() {
            var objreq = { 'receipt_no': '@_receiptno' }
            $.ajax({
                url: '@_webapiurl' + "Devicecart/GetproductInfoDetails",
                type: 'GET',
                datatype: "json",
