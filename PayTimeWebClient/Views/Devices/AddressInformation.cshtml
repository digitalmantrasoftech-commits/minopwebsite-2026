                success: function (data) {

                    var _Productcart = "";
                    var _cart_total = 0;
                    $("#no_of_device_cart").text(data.length);
                    $("#spshoppingcartcount").text(data.length);
                    $("#spshoppingcartcount1").text(data.length);

                    $.each(data, function (index) {
                        var _img = "";
