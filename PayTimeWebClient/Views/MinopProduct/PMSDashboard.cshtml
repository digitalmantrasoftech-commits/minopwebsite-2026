@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Data;
@{
    ViewBag.Title = "PMS Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    int _cmpid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _UserImg = HttpContext.Current.Session["photo"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = "0";
    string _empid = "0";
    string _empName = "0";
    int DepartmentId = Convert.ToInt32(HttpContext.Current.Session["DepartmentId"]);
    if (_RoleId != 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _empid = HttpContext.Current.Session["EmpId"].ToString();
        _empName = HttpContext.Current.Session["EmpName"].ToString();
    }
    string _branchid = "0";
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    if (_RoleId == 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _CountryCode = HttpContext.Current.Session["CountryCode"].ToString();
    string _AreaCode = HttpContext.Current.Session["AreaCode"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _isPlanId = HttpContext.Current.Session["planId"].ToString();
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
        ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
        : "false";
}

<style>
    .highcharts-figure,
    .highcharts-data-table table {
        max-width: 100%;
        margin: 10px auto;
    }
</style>

<script>
    $(document).ready(function () {
        var _UID = '@_UserId';
        var _ComID = '@_companyid';
        var _BranchID = '@_branchid';
        var _DepID = '@DepartmentId';
        var _empIdnew = '@_empid';
        var _RoleIDnew = '@_RoleId';
        var _Token = '@_tokan';

        // Load dashboard data
        loadPerformanceMonitor();
        loadPerformanceOverview();
        loadRecentReviews();
        loadPendingAppraisals();

        $("#PerformanceMonitorFilter").change(function () {
            loadPerformanceMonitor();
        });

        $("#pmsMonth").change(function () {
            loadRecentReviews();
        });

        $("#pmsMonths, #pmsDepartment").change(function () {
            loadPendingAppraisals();
        });

        function loadPerformanceMonitor() {
            var filterType = parseInt($("#PerformanceMonitorFilter").val());
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: _DepID,
                filterType: filterType
            };
            $.ajax({
                url: '@_webapiurl' + 'PMS/GetPerformanceMonitor',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    $("#TotalEmployeesCount").text(res.totalEmployees || 0);
                    $("#ReviewsCompletedCount").text(res.reviewsCompleted || 0);
                    $("#PendingReviewsCount").text(res.pendingReviews || 0);
                    $("#AvgRatingCount").text((res.avgRating || 0).toFixed(1));
                    $("#GoalsAchievedCount").text(res.goalsAchieved || 0);
                    $("#FeedbackPendingCount").text(res.feedbackPending || 0);
                },
                error: function (xhr) {
                    console.error("Performance Monitor API Error", xhr.status, xhr.responseText);
                }
            });
        }

        function loadPerformanceOverview() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: _DepID
            };
            $.ajax({
                url: '@_webapiurl' + 'PMS/GetPerformanceOverview',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    if (res && res.performanceItems && res.performanceItems.length > 0) {
                        $("#Performance_Overview").show();
                        $("#Performance_Empty").hide();
                        preparePerformanceOverview(res.performanceItems);
                    } else {
                        $("#Performance_Overview").hide();
                        $("#Performance_Empty").show();
                    }
                },
                error: function () {
                    $("#Performance_Overview").hide();
                    $("#Performance_Empty").show();
                }
            });
        }

        function preparePerformanceOverview(data) {
            var categories = [];
            var ratings = [];
            data.forEach(function (item) {
                categories.push(item.departmentName);
                ratings.push(Number(item.avgRating));
            });
            drawPerformanceChart(categories, ratings);
        }

        function drawPerformanceChart(categories, ratings) {
            Highcharts.chart('PerformanceOverviewChart', {
                chart: {
                    type: 'bar'
                },
                title: {
                    text: ''
                },
                legend: {
                    enabled: false
                },
                xAxis: {
                    categories: categories
                },
                yAxis: {
                    min: 0,
                    max: 5,
                    title: {
                        text: 'Average Rating'
                    }
                },
                tooltip: {
                    useHTML: true,
                    formatter: function () {
                        return `
                            <b>${this.x}</b><br/>
                            Avg Rating: <b>${this.y.toFixed(1)}</b>
                        `;
                    }
                },
                plotOptions: {
                    bar: {
                        pointPadding: 0.2,
                        borderWidth: 0,
                        color: '#8B5CF6'
                    }
                },
                series: [{
                    name: 'Rating',
                    data: ratings
                }],
                credits: { enabled: false }
            });
        }

        function loadRecentReviews() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                month: parseInt($("#pmsMonth").val())
            };
            $.ajax({
                url: '@_webapiurl' + 'PMS/GetRecentReviews',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    $("#RecentReviews_Empty").hide();
                    $("#RecentReviews_List").hide();
                    if (!res || !res.reviews || res.reviews.length === 0) {
                        $("#RecentReviews_Empty").show();
                        return;
                    }
                    $("#RecentReviews_List").show();
                    bindRecentReviews(res.reviews);
                },
                error: function () {
                    $("#RecentReviews_Empty").show();
                    $("#RecentReviews_List").hide();
                }
            });
        }

        function bindRecentReviews(reviews) {
            var container = $("#recentReviewsContainer");
            var html = '';
            $.each(reviews, function (i, item) {
                var ratingStars = getRatingStars(item.rating);
                html += `
                <div class="myrequest_trip_block d-flex justify-content-between margin-bottom-10">
                    <div class="tripdetail_main">
                        <div class="tripdetail_title">
                            <img src="${item.photo || '/assets/images/icons/icon_profile.svg'}" alt="" style="width:35px; height:35px; border-radius:50%; margin-right:10px;">
                            <span>${item.employeeName}</span>
                        </div>
                        <div class="tripdetail">
                            <span class="margin-right-15">${ratingStars}</span>
                            <span class="margin-right-15"><i class="fa fa-calendar"></i> ${formatDate(item.reviewDate)}</span>
                        </div>
                    </div>
                    <div class="tripactionbtn">
                        <a href="javascript:;" class="btn blue_btnnew" onclick="viewReview(${item.reviewId})">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>`;
            });
            container.html(html);
        }

        function getRatingStars(rating) {
            var stars = '';
            var fullStars = Math.floor(rating);
            var halfStar = rating % 1 >= 0.5;
            for (var i = 0; i < fullStars; i++) {
                stars += '<i class="fa fa-star" style="color: #F59E0B;"></i>';
            }
            if (halfStar) {
                stars += '<i class="fa fa-star-half-alt" style="color: #F59E0B;"></i>';
            }
            for (var j = fullStars + (halfStar ? 1 : 0); j < 5; j++) {
                stars += '<i class="fa fa-star" style="color: #E5E7EB;"></i>';
            }
            return stars;
        }

        function loadPendingAppraisals() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: parseInt($("#pmsDepartment").val()),
                month: parseInt($("#pmsMonths").val())
            };
            $("#PendingAppraisals_List").hide();
            $("#PendingAppraisals_Empty").hide();
            $("#pendingAppraisalsContainer").empty();
            $.ajax({
                url: '@_webapiurl' + 'PMS/GetPendingAppraisals',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    if (!res || !Array.isArray(res.appraisals) || res.appraisals.length === 0) {
                        $("#PendingAppraisals_List").hide();
                        $("#PendingAppraisals_Empty").show();
                        return;
                    }
                    $("#PendingAppraisals_Empty").hide();
                    $("#PendingAppraisals_List").show();
                    renderPendingAppraisals(res.appraisals);
                },
                error: function () {
                    $("#PendingAppraisals_List").hide();
                    $("#PendingAppraisals_Empty").show();
                }
            });
        }

        function renderPendingAppraisals(items) {
            var html = '';
            $.each(items, function (i, item) {
                html += `
                <div class="pending_request_block d-flex justify-content-between margin-bottom-10">
                    <div class="tripdetail_main">
                        <div class="reqby">Employee: <span>${item.employeeName}</span></div>
                        <div class="tripdetail">${item.appraisalType}</div>
                        <div class="text-muted small">Due: ${formatDate(item.dueDate)}</div>
                    </div>
                    <div class="tripactionbtn">
                        <a href="javascript:;" class="btn green_btnnew approve"
                           onclick="startReview(${item.appraisalId})"><i class="fa-solid fa-play"></i></a>
                        <a href="javascript:;" class="btn blue_btnnew"
                           onclick="viewAppraisal(${item.appraisalId})"><i class="fa-solid fa-eye"></i></a>
                    </div>
                </div>`;
            });
            $("#pendingAppraisalsContainer").html(html);
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            return date.toLocaleDateString('en-GB');
        }

        window.viewReview = function (reviewId) {
            window.open('/PMS/ViewReview?id=' + reviewId, '_blank');
        };

        window.startReview = function (appraisalId) {
            window.location.href = '/PMS/StartReview?id=' + appraisalId;
        };

        window.viewAppraisal = function (appraisalId) {
            window.open('/PMS/ViewAppraisal?id=' + appraisalId, '_blank');
        };

        // Fill department dropdown
        fillDepartment();
        function fillDepartment() {
            $.ajax({
                url: '@_webapiurl' + "/Master/DepartmentGetAll",
                method: "GET",
                contentType: "application/json; charset=utf-8",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                success: function (data) {
                    var $deptDropdown = $("#pmsDepartment");
                    $deptDropdown.empty();
                    $deptDropdown.append('<option value="0">All Departments</option>');
                    $.each(data, function (i, dept) {
                        $deptDropdown.append('<option value="' + dept.DepartmentId + '">' + dept.DepartmentName + '</option>');
                    });
                },
                error: function (err) {
                    console.error("Error loading departments", err);
                }
            });
        }

        // Custom widget save
        $("#widgetSave").on("click", function () {
            $(".widget-checkbox").each(function () {
                var widgetKey = $(this).data("widget");
                var $dashboardWidget = $(
                    ".row[data-widget='" + widgetKey + "'], " +
                    ".col-lg-6[data-widget='" + widgetKey + "']"
                ).not("#customwidget_modal *");
                if ($(this).is(":checked")) {
                    $dashboardWidget.show();
                } else {
                    $dashboardWidget.hide();
                }
            });
            $("#customwidget_modal").modal("hide");
        });

        // Update product display
        if ($('#currentProductDisplay').length) {
            $('#currentProductDisplay').text('PMS');
        }
    });
</script>

