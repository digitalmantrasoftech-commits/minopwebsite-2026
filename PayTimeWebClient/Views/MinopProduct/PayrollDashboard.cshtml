@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Data;
@{
    ViewBag.Title = "Payroll Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    int _cmpid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytimePayroll"].ToString();
    string _webapiurlBase = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _UserImg = HttpContext.Current.Session["photo"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = "0";
    string _empid = "0";
    string _empName = "0";
    int DepartmentId = Convert.ToInt32(HttpContext.Current.Session["DepartmentId"]);
    if (_RoleId != 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _empid = HttpContext.Current.Session["EmpId"].ToString();
        _empName = HttpContext.Current.Session["EmpName"].ToString();
    }
    string _branchid = "0";
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    if (_RoleId == 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _CountryCode = HttpContext.Current.Session["CountryCode"].ToString();
    string _AreaCode = HttpContext.Current.Session["AreaCode"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _isPlanId = HttpContext.Current.Session["planId"].ToString();
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
        ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
        : "false";
}

<style>
    .highcharts-figure,
    .highcharts-data-table table {
        max-width: 100%;
        margin: 10px auto;
    }
</style>

<script>
    $(document).ready(function () {
        var _UID = '@_UserId';
        var _ComID = '@_companyid';
        var _BranchID = '@_branchid';
        var _DepID = '@DepartmentId';
        var _empIdnew = '@_empid';
        var _RoleIDnew = '@_RoleId';
        var _Token = '@_tokan';

        // Load dashboard data
        loadPayrollMonitor();
        loadPayrollOverview();
        loadRecentPayslips();
        loadPendingApprovals();

        $("#PayrollMonitorFilter").change(function () {
            loadPayrollMonitor();
        });

        $("#payrollMonth").change(function () {
            loadRecentPayslips();
        });

        $("#payrollMonths, #payrollDepartment").change(function () {
            loadPendingApprovals();
        });

        function loadPayrollMonitor() {
            var filterType = parseInt($("#PayrollMonitorFilter").val());
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: _DepID,
                filterType: filterType
            };
            $.ajax({
                url: '@_webapiurl' + 'Payroll/GetPayrollMonitor',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    $("#TotalEmployeesCount").text(res.totalEmployees || 0);
                    $("#ProcessedCount").text(res.processed || 0);
                    $("#PendingCount").text(res.pending || 0);
                    $("#TotalSalaryCount").text(formatCurrency(res.totalSalary || 0));
                    $("#DeductionsCount").text(formatCurrency(res.deductions || 0));
                    $("#NetPayableCount").text(formatCurrency(res.netPayable || 0));
                },
                error: function (xhr) {
                    console.error("Payroll Monitor API Error", xhr.status, xhr.responseText);
                }
            });
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-IN', {
                style: 'currency',
                currency: 'INR',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(amount);
        }

        function loadPayrollOverview() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: _DepID
            };
            $.ajax({
                url: '@_webapiurl' + 'Payroll/GetPayrollOverview',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    if (res && res.payrollItems && res.payrollItems.length > 0) {
                        $("#Payroll_Overview").show();
                        $("#Payroll_Empty").hide();
                        preparePayrollOverview(res.payrollItems);
                    } else {
                        $("#Payroll_Overview").hide();
                        $("#Payroll_Empty").show();
                    }
                },
                error: function () {
                    $("#Payroll_Overview").hide();
                    $("#Payroll_Empty").show();
                }
            });
        }

        function preparePayrollOverview(data) {
            var categories = [];
            var salaries = [];
            var deductions = [];
            data.forEach(function (item) {
                categories.push(item.monthName);
                salaries.push(Number(item.totalSalary));
                deductions.push(Number(item.totalDeductions));
            });
            drawPayrollChart(categories, salaries, deductions);
        }

        function drawPayrollChart(categories, salaries, deductions) {
            Highcharts.chart('PayrollOverviewChart', {
                chart: {
                    type: 'column'
                },
                title: {
                    text: ''
                },
                xAxis: {
                    categories: categories
                },
                yAxis: {
                    min: 0,
                    title: {
                        text: ''
                    },
                    labels: {
                        formatter: function () {
                            return (this.value / 1000) + 'K';
                        }
                    }
                },
                tooltip: {
                    useHTML: true,
                    formatter: function () {
                        return `
                            <b>${this.x}</b><br/>
                            ${this.series.name}: <b>${formatCurrency(this.y)}</b>
                        `;
                    }
                },
                plotOptions: {
                    column: {
                        pointPadding: 0.2,
                        borderWidth: 0
                    }
                },
                series: [{
                    name: 'Gross Salary',
                    data: salaries,
                    color: '#6366F1'
                }, {
                    name: 'Deductions',
                    data: deductions,
                    color: '#EF4444'
                }],
                credits: { enabled: false }
            });
        }

        function loadRecentPayslips() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                month: parseInt($("#payrollMonth").val())
            };
            $.ajax({
                url: '@_webapiurl' + 'Payroll/GetRecentPayslips',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    $("#RecentPayslips_Empty").hide();
                    $("#RecentPayslips_List").hide();
                    if (!res || !res.payslips || res.payslips.length === 0) {
                        $("#RecentPayslips_Empty").show();
                        return;
                    }
                    $("#RecentPayslips_List").show();
                    bindRecentPayslips(res.payslips);
                },
                error: function () {
                    $("#RecentPayslips_Empty").show();
                    $("#RecentPayslips_List").hide();
                }
            });
        }

        function bindRecentPayslips(payslips) {
            var container = $("#recentPayslipsContainer");
            var html = '';
            $.each(payslips, function (i, item) {
                var statusClass = item.status === 'Processed' ? 'badge-success' : 'badge-warning';
                html += `
                <div class="myrequest_trip_block d-flex justify-content-between margin-bottom-10">
                    <div class="tripdetail_main">
                        <div class="tripdetail_title">
                            <img src="${item.photo || '/assets/images/icons/icon_profile.svg'}" alt="" style="width:35px; height:35px; border-radius:50%; margin-right:10px;">
                            <span>${item.employeeName}</span>
                            <span class="badge ${statusClass}">${item.status}</span>
                        </div>
                        <div class="tripdetail">
                            <span class="margin-right-15"><i class="fa fa-calendar"></i> ${item.monthYear}</span>
                            <span class="margin-right-15"><i class="fa fa-rupee-sign"></i> Net: ${formatCurrency(item.netSalary)}</span>
                        </div>
                    </div>
                    <div class="tripactionbtn">
                        <a href="javascript:;" class="btn blue_btnnew" onclick="viewPayslip(${item.payslipId})">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>`;
            });
            container.html(html);
        }

        function loadPendingApprovals() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: parseInt($("#payrollDepartment").val()),
                month: parseInt($("#payrollMonths").val())
            };
            $("#PendingApprovals_List").hide();
            $("#PendingApprovals_Empty").hide();
            $("#pendingApprovalsContainer").empty();
            $.ajax({
                url: '@_webapiurl' + 'Payroll/GetPendingApprovals',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    if (!res || !Array.isArray(res.approvals) || res.approvals.length === 0) {
                        $("#PendingApprovals_List").hide();
                        $("#PendingApprovals_Empty").show();
                        return;
                    }
                    $("#PendingApprovals_Empty").hide();
                    $("#PendingApprovals_List").show();
                    renderPendingApprovals(res.approvals);
                },
                error: function () {
                    $("#PendingApprovals_List").hide();
                    $("#PendingApprovals_Empty").show();
                }
            });
        }

        function renderPendingApprovals(items) {
            var html = '';
            $.each(items, function (i, item) {
                html += `
                <div class="pending_request_block d-flex justify-content-between margin-bottom-10">
                    <div class="tripdetail_main">
                        <div class="reqby">Employee: <span>${item.employeeName}</span></div>
                        <div class="tripdetail">${item.requestType}: ${formatCurrency(item.amount)}</div>
                        <div class="text-muted small">Requested: ${formatDate(item.requestDate)}</div>
                    </div>
                    <div class="tripactionbtn">
                        <a href="javascript:;" class="btn green_btnnew approve"
                           onclick="updatePayrollApproval(${item.requestId}, 'Approve')"><i class="fa-solid fa-check"></i></a>
                        <a href="javascript:;" class="btn red_btnnew reject"
                           onclick="updatePayrollApproval(${item.requestId}, 'Reject')"><i class="fa-solid fa-xmark"></i></a>
                    </div>
                </div>`;
            });
            $("#pendingApprovalsContainer").html(html);
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            return date.toLocaleDateString('en-GB');
        }

        window.updatePayrollApproval = function (requestId, action) {
            var request = {
                RequestId: requestId,
                UserId: parseInt(_empIdnew),
                Action: action
            };
            $.ajax({
                url: '@_webapiurl' + 'Payroll/UpdateApprovalStatus',
                type: "POST",
                contentType: "application/json",
                headers: { "Authorization": "Bearer " + _Token },
                data: JSON.stringify(request),
                success: function (res) {
                    toastr.success(res.message || 'Request ' + action + 'd successfully');
                    loadPendingApprovals();
                    loadPayrollMonitor();
                },
                error: function (xhr) {
                    console.error("Approval API Error", xhr.status, xhr.responseText);
                    alert("Failed to update request.");
                }
            });
        };

        window.viewPayslip = function (payslipId) {
            window.open('/Payroll/ViewPayslip?id=' + payslipId, '_blank');
        };

        // Fill department dropdown
        fillDepartment();
        function fillDepartment() {
            $.ajax({
                url: '@_webapiurlBase' + "/Master/DepartmentGetAll",
                method: "GET",
                contentType: "application/json; charset=utf-8",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                success: function (data) {
                    var $deptDropdown = $("#payrollDepartment");
                    $deptDropdown.empty();
                    $deptDropdown.append('<option value="0">All Departments</option>');
                    $.each(data, function (i, dept) {
                        $deptDropdown.append('<option value="' + dept.DepartmentId + '">' + dept.DepartmentName + '</option>');
                    });
                },
                error: function (err) {
                    console.error("Error loading departments", err);
                }
            });
        }

        // Custom widget save
        $("#widgetSave").on("click", function () {
            $(".widget-checkbox").each(function () {
                var widgetKey = $(this).data("widget");
                var $dashboardWidget = $(
                    ".row[data-widget='" + widgetKey + "'], " +
                    ".col-lg-6[data-widget='" + widgetKey + "']"
                ).not("#customwidget_modal *");
                if ($(this).is(":checked")) {
                    $dashboardWidget.show();
                } else {
                    $dashboardWidget.hide();
                }
            });
            $("#customwidget_modal").modal("hide");
        });

        // Update product display
        if ($('#currentProductDisplay').length) {
            $('#currentProductDisplay').text('Payroll');
        }
    });
</script>

