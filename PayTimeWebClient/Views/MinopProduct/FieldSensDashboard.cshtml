@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Data;
@{
    ViewBag.Title = "FieldSens Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    int _cmpid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapifieldtracking"].ToString();
    string _webapiurlBase = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _UserImg = HttpContext.Current.Session["photo"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = "0";
    string _empid = "0";
    string _empName = "0";
    int DepartmentId = Convert.ToInt32(HttpContext.Current.Session["DepartmentId"]);
    if (_RoleId != 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _empid = HttpContext.Current.Session["EmpId"].ToString();
        _empName = HttpContext.Current.Session["EmpName"].ToString();
    }
    string _branchid = "0";
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    if (_RoleId == 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _CountryCode = HttpContext.Current.Session["CountryCode"].ToString();
    string _AreaCode = HttpContext.Current.Session["AreaCode"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _isPlanId = HttpContext.Current.Session["planId"].ToString();
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
        ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
        : "false";
}

<style>
    .highcharts-figure,
    .highcharts-data-table table {
        max-width: 100%;
        margin: 10px auto;
    }
</style>

<script>
    $(document).ready(function () {
        var _UID = '@_UserId';
        var _ComID = '@_companyid';
        var _BranchID = '@_branchid';
        var _DepID = '@DepartmentId';
        var _empIdnew = '@_empid';
        var _RoleIDnew = '@_RoleId';
        var _Token = '@_tokan';

        // Load dashboard data
        loadFieldMonitor();
        loadFieldOverview();
        loadActiveFieldWorkers();
        loadPendingTasks();

        $("#FieldMonitorFilter").change(function () {
            loadFieldMonitor();
        });

        $("#fieldMonth").change(function () {
            loadActiveFieldWorkers();
        });

        $("#fieldMonths, #fieldDepartment").change(function () {
            loadPendingTasks();
        });

        function loadFieldMonitor() {
            var filterType = parseInt($("#FieldMonitorFilter").val());
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: _DepID,
                filterType: filterType
            };
            $.ajax({
                url: '@_webapiurl' + 'FieldTracking/GetFieldMonitor',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    $("#TotalWorkersCount").text(res.totalWorkers || 0);
                    $("#ActiveWorkersCount").text(res.activeWorkers || 0);
                    $("#OnFieldCount").text(res.onField || 0);
                    $("#TasksCompletedCount").text(res.tasksCompleted || 0);
                    $("#PendingTasksCount").text(res.pendingTasks || 0);
                    $("#DistanceTravelledCount").text((res.distanceTravelled || 0) + ' km');
                },
                error: function (xhr) {
                    console.error("Field Monitor API Error", xhr.status, xhr.responseText);
                }
            });
        }

        function loadFieldOverview() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: _DepID
            };
            $.ajax({
                url: '@_webapiurl' + 'FieldTracking/GetFieldOverview',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    if (res && res.fieldItems && res.fieldItems.length > 0) {
                        $("#Field_Overview").show();
                        $("#Field_Empty").hide();
                        prepareFieldOverview(res.fieldItems);
                    } else {
                        $("#Field_Overview").hide();
                        $("#Field_Empty").show();
                    }
                },
                error: function () {
                    $("#Field_Overview").hide();
                    $("#Field_Empty").show();
                }
            });
        }

        function prepareFieldOverview(data) {
            var groupedData = {};
            data.forEach(function (item) {
                var d = new Date(item.trackDate);
                var day = d.getDate().toString().padStart(2, '0');
                var month = d.toLocaleString('en-US', { month: 'short' });
                var key = day + '-' + month;
                if (!groupedData[key]) {
                    groupedData[key] = 0;
                }
                groupedData[key] += Number(item.taskCount);
            });
            var categories = Object.keys(groupedData);
            var counts = Object.values(groupedData);
            drawFieldChart(categories, counts);
        }

        function drawFieldChart(categories, data) {
            Highcharts.chart('FieldOverviewChart', {
                chart: {
                    type: 'column'
                },
                title: {
                    text: ''
                },
                legend: {
                    enabled: false
                },
                xAxis: {
                    categories: categories
                },
                yAxis: {
                    min: 0,
                    title: {
                        text: ''
                    },
                    labels: {
                        formatter: function () {
                            return this.value;
                        }
                    }
                },
                tooltip: {
                    useHTML: true,
                    formatter: function () {
                        return `
                            <b>${this.x} ${new Date().getFullYear()}</b><br/>
                            Tasks: <b>${this.y}</b>
                        `;
                    }
                },
                plotOptions: {
                    column: {
                        pointPadding: 0.2,
                        borderWidth: 0,
                        color: '#10B981'
                    }
                },
                series: [{
                    name: 'Tasks',
                    data: data
                }],
                credits: { enabled: false }
            });
        }

        function loadActiveFieldWorkers() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                month: parseInt($("#fieldMonth").val())
            };
            $.ajax({
                url: '@_webapiurl' + 'FieldTracking/GetActiveFieldWorkers',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    $("#ActiveWorkers_Empty").hide();
                    $("#ActiveWorkers_List").hide();
                    if (!res || !res.workers || res.workers.length === 0) {
                        $("#ActiveWorkers_Empty").show();
                        return;
                    }
                    $("#ActiveWorkers_List").show();
                    bindActiveWorkers(res.workers);
                },
                error: function () {
                    $("#ActiveWorkers_Empty").show();
                    $("#ActiveWorkers_List").hide();
                }
            });
        }

        function bindActiveWorkers(workers) {
            var container = $("#activeWorkersContainer");
            var html = '';
            $.each(workers, function (i, item) {
                var statusClass = item.status === 'Active' ? 'badge-success' : 'badge-secondary';
                html += `
                <div class="myrequest_trip_block d-flex justify-content-between margin-bottom-10">
                    <div class="tripdetail_main">
                        <div class="tripdetail_title">
                            <img src="${item.photo || '/assets/images/icons/icon_profile.svg'}" alt="" style="width:35px; height:35px; border-radius:50%; margin-right:10px;">
                            <span>${item.workerName}</span>
                            <span class="badge ${statusClass}">${item.status}</span>
                        </div>
                        <div class="tripdetail">
                            <span class="margin-right-15"><i class="fa fa-map-marker"></i> ${item.location || 'N/A'}</span>
                            <span><i class="fa fa-clock"></i> Last update: ${formatDateTime(item.lastUpdate)}</span>
                        </div>
                    </div>
                    <div class="tripactionbtn">
                        <a href="javascript:;" class="btn blue_btnnew" onclick="viewWorkerLocation(${item.workerId})">
                            <i class="fa-solid fa-location-dot"></i>
                        </a>
                    </div>
                </div>`;
            });
            container.html(html);
        }

        function loadPendingTasks() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: parseInt($("#fieldDepartment").val()),
                month: parseInt($("#fieldMonths").val())
            };
            $("#PendingTasks_List").hide();
            $("#PendingTasks_Empty").hide();
            $("#pendingTasksContainer").empty();
            $.ajax({
                url: '@_webapiurl' + 'FieldTracking/GetPendingTasks',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    if (!res || !Array.isArray(res.tasks) || res.tasks.length === 0) {
                        $("#PendingTasks_List").hide();
                        $("#PendingTasks_Empty").show();
                        return;
                    }
                    $("#PendingTasks_Empty").hide();
                    $("#PendingTasks_List").show();
                    renderPendingTasks(res.tasks);
                },
                error: function () {
                    $("#PendingTasks_List").hide();
                    $("#PendingTasks_Empty").show();
                }
            });
        }

        function renderPendingTasks(items) {
            var html = '';
            $.each(items, function (i, item) {
                html += `
                <div class="pending_request_block d-flex justify-content-between margin-bottom-10">
                    <div class="tripdetail_main">
                        <div class="reqby">Assigned to: <span>${item.workerName}</span></div>
                        <div class="tripdetail">${item.taskDescription || ''}</div>
                        <div class="text-muted small">Due: ${formatDate(item.dueDate)}</div>
                    </div>
                    <div class="tripactionbtn">
                        <a href="javascript:;" class="btn green_btnnew approve"
                           onclick="updateTaskStatus(${item.taskId}, 'Complete')"><i class="fa-solid fa-check"></i></a>
                        <a href="javascript:;" class="btn red_btnnew reject"
                           onclick="updateTaskStatus(${item.taskId}, 'Cancel')"><i class="fa-solid fa-xmark"></i></a>
                    </div>
                </div>`;
            });
            $("#pendingTasksContainer").html(html);
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            return date.toLocaleDateString('en-GB');
        }

        function formatDateTime(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            return date.toLocaleString('en-GB');
        }

        window.updateTaskStatus = function (taskId, action) {
            var request = {
                TaskId: taskId,
                UserId: parseInt(_empIdnew),
                Action: action
            };
            $.ajax({
                url: '@_webapiurl' + 'FieldTracking/UpdateTaskStatus',
                type: "POST",
                contentType: "application/json",
                headers: { "Authorization": "Bearer " + _Token },
                data: JSON.stringify(request),
                success: function (res) {
                    toastr.success(res.message || 'Task ' + action + 'd successfully');
                    loadPendingTasks();
                    loadFieldMonitor();
                },
                error: function (xhr) {
                    console.error("Task Status API Error", xhr.status, xhr.responseText);
                    alert("Failed to update task.");
                }
            });
        };

        window.viewWorkerLocation = function (workerId) {
            window.open('/FieldTracking/LiveTracking?workerId=' + workerId, '_blank');
        };

        // Custom widget save
        $("#widgetSave").on("click", function () {
            $(".widget-checkbox").each(function () {
                var widgetKey = $(this).data("widget");
                var $dashboardWidget = $(
                    ".row[data-widget='" + widgetKey + "'], " +
                    ".col-lg-6[data-widget='" + widgetKey + "']"
                ).not("#customwidget_modal *");
                if ($(this).is(":checked")) {
                    $dashboardWidget.show();
                } else {
                    $dashboardWidget.hide();
                }
            });
            $("#customwidget_modal").modal("hide");
        });

        // Update product display
        if ($('#currentProductDisplay').length) {
            $('#currentProductDisplay').text('FieldSens');
        }
    });
</script>

