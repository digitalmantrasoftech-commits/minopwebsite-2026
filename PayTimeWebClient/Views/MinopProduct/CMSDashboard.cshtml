                                    <span class="action-label">Settings</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Custom Widget Modal -->
    <div id="customwidget_modal" class="modal fade" role="dialog" data-backdrop="static">
        <div class="modal-dialog" style="width:450px;">
            <div class="modal-content" style="border-radius:16px;border:none;">
                <div class="modal-header" style="border-bottom:1px solid #f1f5f9;padding:20px 24px;">
                    <button type="button" class="close" data-dismiss="modal" style="opacity:0.5;">&times;</button>
                    <h4 class="modal-title" style="font-weight:600;font-size:18px;">Customize Dashboard</h4>
                </div>
                <div class="modal-body" style="padding:24px;">
                    <p style="color:#64748b;font-size:13px;margin-bottom:20px;">Choose which widgets to display on your dashboard</p>
                    <div class="widget-list">
                        <label class="d-flex align-items-center justify-content-between" style="padding:12px 0;border-bottom:1px solid #f1f5f9;cursor:pointer;">
                            <span style="font-weight:500;">Canteen Monitor</span>
                            <input type="checkbox" class="widget-checkbox" data-widget="canteenMonitor" checked style="width:18px;height:18px;">
                        </label>
                        <label class="d-flex align-items-center justify-content-between" style="padding:12px 0;border-bottom:1px solid #f1f5f9;cursor:pointer;">
                            <span style="font-weight:500;">Order Trend Chart</span>
                            <input type="checkbox" class="widget-checkbox" data-widget="orderOverview" checked style="width:18px;height:18px;">
                        </label>
                        <label class="d-flex align-items-center justify-content-between" style="padding:12px 0;border-bottom:1px solid #f1f5f9;cursor:pointer;">
                            <span style="font-weight:500;">Food Categories</span>
                            <input type="checkbox" class="widget-checkbox" data-widget="foodCategory" checked style="width:18px;height:18px;">
                        </label>
                        <label class="d-flex align-items-center justify-content-between" style="padding:12px 0;border-bottom:1px solid #f1f5f9;cursor:pointer;">
                            <span style="font-weight:500;">Recent Orders</span>
                            <input type="checkbox" class="widget-checkbox" data-widget="recentOrders" checked style="width:18px;height:18px;">
                        </label>
                        <label class="d-flex align-items-center justify-content-between" style="padding:12px 0;border-bottom:1px solid #f1f5f9;cursor:pointer;">
                            <span style="font-weight:500;">Pending Orders</span>
                            <input type="checkbox" class="widget-checkbox" data-widget="pendingOrders" checked style="width:18px;height:18px;">
                        </label>
                        <label class="d-flex align-items-center justify-content-between" style="padding:12px 0;border-bottom:1px solid #f1f5f9;cursor:pointer;">
                            <span style="font-weight:500;">Popular Items</span>
                            <input type="checkbox" class="widget-checkbox" data-widget="popularItems" checked style="width:18px;height:18px;">
                        </label>
                        <label class="d-flex align-items-center justify-content-between" style="padding:12px 0;cursor:pointer;">
                            <span style="font-weight:500;">Quick Actions</span>
                            <input type="checkbox" class="widget-checkbox" data-widget="quickActions" checked style="width:18px;height:18px;">
                        </label>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid #f1f5f9;padding:16px 24px;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius:8px;">Cancel</button>
                    <button type="button" class="btn" id="widgetSave" style="background:var(--cms-gradient);color:#fff;border:none;border-radius:8px;padding:10px 24px;">
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess .</span>
}
