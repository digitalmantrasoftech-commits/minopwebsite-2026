@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Data;
@{
    ViewBag.Title = "CMS Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    int _cmpid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _UserImg = HttpContext.Current.Session["photo"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = "0";
    string _empid = "0";
    string _empName = "0";
    int DepartmentId = Convert.ToInt32(HttpContext.Current.Session["DepartmentId"]);
    if (_RoleId != 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _empid = HttpContext.Current.Session["EmpId"].ToString();
        _empName = HttpContext.Current.Session["EmpName"].ToString();
    }
    string _branchid = "0";
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    if (_RoleId == 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _CountryCode = HttpContext.Current.Session["CountryCode"].ToString();
    string _AreaCode = HttpContext.Current.Session["AreaCode"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _isPlanId = HttpContext.Current.Session["planId"].ToString();
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
        ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
        : "false";
}

<!-- Market-Level CMS Dashboard Styles -->
<style>
    :root {
        --cms-primary: #FF6B35;
        --cms-primary-dark: #E55A2B;
        --cms-gradient: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
        --cms-success-gradient: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
        --cms-warning-gradient: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
        --cms-info-gradient: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
        --cms-danger-gradient: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
        --cms-purple-gradient: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
        --cms-teal-gradient: linear-gradient(135deg, #14B8A6 0%, #0D9488 100%);
        --card-shadow: 0 10px 40px rgba(0,0,0,0.1);
        --card-hover-shadow: 0 20px 60px rgba(0,0,0,0.15);
        --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Loading Skeleton Animation */
    .skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
        border-radius: 4px;
    }
    @@keyframes skeleton-loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
    .skeleton-text { height: 14px; margin-bottom: 8px; }
    .skeleton-title { height: 24px; width: 60%; margin-bottom: 12px; }

    /* Gradient Stat Cards - Food Theme */
    .stat-card {
        position: relative;
        border-radius: 16px;
        padding: 20px;
        color: #fff;
        overflow: hidden;
        transition: var(--transition-smooth);
        cursor: pointer;
        min-height: 140px;
    }
    .stat-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--card-hover-shadow);
    }
    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 130px;
        height: 130px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        transform: translate(30%, -30%);
    }
    .stat-card::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 80px;
        height: 80px;
        background: rgba(255,255,255,0.08);
        border-radius: 50%;
        transform: translate(-30%, 30%);
    }
    .stat-card.gradient-orange { background: var(--cms-gradient); }
    .stat-card.gradient-success { background: var(--cms-success-gradient); }
    .stat-card.gradient-warning { background: var(--cms-warning-gradient); }
    .stat-card.gradient-info { background: var(--cms-info-gradient); }
    .stat-card.gradient-danger { background: var(--cms-danger-gradient); }
    .stat-card.gradient-purple { background: var(--cms-purple-gradient); }
    .stat-card.gradient-teal { background: var(--cms-teal-gradient); }

    .stat-card .stat-icon {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.2);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 15px;
        backdrop-filter: blur(10px);
    }
    .stat-card .stat-value {
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 5px;
        position: relative;
        z-index: 1;
    }
    .stat-card .stat-label {
        font-size: 12px;
        opacity: 0.9;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .stat-card .stat-trend {
        position: absolute;
        top: 15px;
        right: 15px;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 20px;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
    }
    .stat-card .stat-trend.up { color: #4ade80; }
    .stat-card .stat-trend.down { color: #f87171; }

    /* Progress Ring */
    .progress-ring {
        position: relative;
        width: 55px;
        height: 55px;
    }
    .progress-ring svg {
        transform: rotate(-90deg);
    }
    .progress-ring circle {
        fill: none;
        stroke-width: 5;
        stroke-linecap: round;
    }
    .progress-ring .bg { stroke: rgba(255,255,255,0.2); }
    .progress-ring .progress {
        stroke: #fff;
        stroke-dasharray: 138;
        stroke-dashoffset: 138;
        transition: stroke-dashoffset 1s ease-out;
    }
    .progress-ring .percentage {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 12px;
        font-weight: 700;
    }

    /* Enhanced Card Box */
    .card_box_enhanced {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        transition: var(--transition-smooth);
        overflow: hidden;
        border: none;
    }
    .card_box_enhanced:hover {
        box-shadow: var(--card-hover-shadow);
    }
    .card_header_enhanced {
        padding: 20px 24px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .card_header_enhanced .card-title {
        font-size: 16px;
        font-weight: 600;
        color: #1e293b;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .card_header_enhanced .card-title i {
        width: 32px;
        height: 32px;
        background: var(--cms-gradient);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 14px;
    }
    .card_body_enhanced {
        padding: 20px 24px;
    }

    /* Live Badge */
    .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: #FEF3C7;
        color: #D97706;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
    .live-badge::before {
        content: '';
        width: 8px;
        height: 8px;
        background: #F59E0B;
        border-radius: 50%;
        animation: pulse-live 2s infinite;
    }
    @@keyframes pulse-live {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.2); }
    }

    /* Export Button */
    .export-btn {
        padding: 8px 16px;
        background: var(--cms-gradient);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: var(--transition-smooth);
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .export-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.4);
    }

    /* Order Item Enhanced */
    .order-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        border-radius: 12px;
        background: #f8fafc;
        margin-bottom: 12px;
        transition: var(--transition-smooth);
        border-left: 4px solid transparent;
    }
    .order-item:hover {
        background: #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transform: translateX(5px);
    }
    .order-item.status-delivered { border-left-color: #22c55e; }
    .order-item.status-preparing { border-left-color: #f59e0b; }
    .order-item.status-pending { border-left-color: #3b82f6; }
    .order-item.status-cancelled { border-left-color: #ef4444; }

    .order-avatar {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--cms-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 600;
        font-size: 18px;
        margin-right: 15px;
    }
    .order-info h6 {
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
        margin: 0 0 4px 0;
    }
    .order-info p {
        font-size: 12px;
        color: #64748b;
        margin: 0;
    }
    .order-status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .order-status.delivered { background: #dcfce7; color: #16a34a; }
    .order-status.preparing { background: #fef3c7; color: #d97706; }
    .order-status.pending { background: #dbeafe; color: #2563eb; }
    .order-status.cancelled { background: #fee2e2; color: #dc2626; }

    .order-amount {
        font-size: 14px;
        font-weight: 700;
        color: #FF6B35;
    }

    /* Quick Action Cards */
    .quick-action-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
        background: #fff;
        border-radius: 16px;
        border: 2px solid #f1f5f9;
        transition: var(--transition-smooth);
        cursor: pointer;
        text-decoration: none;
        color: #1e293b;
    }
    .quick-action-card:hover {
        border-color: #FF6B35;
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(255, 107, 53, 0.15);
    }
    .quick-action-card:hover .action-icon {
        transform: scale(1.1);
    }
    .quick-action-card .action-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 12px;
        transition: var(--transition-smooth);
    }
    .quick-action-card .action-icon.icon-orange { background: rgba(255, 107, 53, 0.1); color: #FF6B35; }
    .quick-action-card .action-icon.icon-success { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
    .quick-action-card .action-icon.icon-purple { background: rgba(139, 92, 246, 0.1); color: #8b5cf6; }
    .quick-action-card .action-icon.icon-warning { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
    .quick-action-card .action-icon.icon-info { background: rgba(6, 182, 212, 0.1); color: #06b6d4; }
    .quick-action-card .action-icon.icon-danger { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
    .quick-action-card .action-label {
        font-size: 13px;
        font-weight: 600;
        text-align: center;
    }

    /* Notification Badge */
    .notification-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        min-width: 20px;
        height: 20px;
        background: #ef4444;
        color: #fff;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 6px;
        animation: bounce-in 0.5s ease;
    }
    @@keyframes bounce-in {
        0% { transform: scale(0); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }

    /* Refresh Indicator */
    .refresh-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: #64748b;
    }
    .refresh-indicator i {
        animation: spin 2s linear infinite;
        animation-play-state: paused;
    }
    .refresh-indicator.refreshing i {
        animation-play-state: running;
    }
    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }

    /* Empty State Enhanced */
    .empty-state {
        text-align: center;
        padding: 40px 20px;
    }
    .empty-state img {
        max-width: 150px;
        margin-bottom: 20px;
        opacity: 0.8;
    }
    .empty-state h5 {
        font-size: 16px;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 8px;
    }
    .empty-state p {
        font-size: 13px;
        color: #64748b;
        margin: 0;
    }

    /* Approval Card */
    .approval-card {
        background: #fff;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
        border: 1px solid #e2e8f0;
        transition: var(--transition-smooth);
    }
    .approval-card:hover {
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        border-color: #FF6B35;
    }
    .approval-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }
    .approval-actions .btn-approve {
        flex: 1;
        padding: 10px;
        background: var(--cms-success-gradient);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition-smooth);
    }
    .approval-actions .btn-approve:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(34, 197, 94, 0.4);
    }
    .approval-actions .btn-reject {
        flex: 1;
        padding: 10px;
        background: #fff;
        color: #ef4444;
        border: 2px solid #ef4444;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition-smooth);
    }
    .approval-actions .btn-reject:hover {
        background: #ef4444;
        color: #fff;
    }

    /* Filter Pills */
    .filter-pills {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .filter-pill {
        padding: 8px 16px;
        background: #f1f5f9;
        border: none;
        border-radius: 20px;
        font-size: 13px;
        color: #64748b;
        cursor: pointer;
        transition: var(--transition-smooth);
    }
    .filter-pill:hover, .filter-pill.active {
        background: var(--cms-gradient);
        color: #fff;
    }

    /* Live Clock */
    .live-clock {
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .live-clock i { color: #FF6B35; }

    /* Scrollbar Styling */
    .custom-scroll::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 3px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    /* Popular Item */
    .popular-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px;
        border-radius: 8px;
        background: #f8fafc;
        margin-bottom: 8px;
        transition: var(--transition-smooth);
    }
    .popular-item:hover {
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .popular-item .rank {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--cms-gradient);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }
    .popular-item .item-name {
        flex: 1;
        font-size: 13px;
        font-weight: 500;
        color: #1e293b;
    }
    .popular-item .item-count {
        font-size: 12px;
        color: #64748b;
        background: #e2e8f0;
        padding: 4px 10px;
        border-radius: 12px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .stat-card { min-height: 120px; padding: 15px; }
        .stat-card .stat-value { font-size: 22px; }
        .quick-action-card { padding: 16px 12px; }
    }
</style>

<script>
    $(document).ready(function () {
        var _UID = '@_UserId';
        var _ComID = '@_companyid';
        var _BranchID = '@_branchid';
        var _DepID = '@DepartmentId';
        var _empIdnew = '@_empid';
        var _RoleIDnew = '@_RoleId';
        var _Token = '@_tokan';
        var autoRefreshInterval;
        var isRefreshing = false;

        // Initialize dashboard
        initDashboard();

        function initDashboard() {
            showLoadingSkeletons();
            loadAllData();
            startLiveClock();
            startAutoRefresh();
            initFilterPills();
        }

        function showLoadingSkeletons() {
            $(".stat-card .stat-value").html('<div class="skeleton skeleton-title"></div>');
        }

        function loadAllData() {
            setRefreshingState(true);
            Promise.all([
                loadCanteenMonitor(),
                loadOrderOverview(),
                loadFoodCategoryDistribution(),
                loadRecentOrders(),
                loadPendingOrders(),
                loadPopularItems()
            ]).then(function() {
                setRefreshingState(false);
            }).catch(function() {
                setRefreshingState(false);
            });
        }

        function setRefreshingState(state) {
            isRefreshing = state;
            if (state) {
                $(".refresh-indicator").addClass("refreshing");
            } else {
                $(".refresh-indicator").removeClass("refreshing");
                updateLastRefreshTime();
            }
        }

        function updateLastRefreshTime() {
            var now = new Date();
            var time = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
            $("#lastRefreshTime").text(time);
        }

        // Live Clock
        function startLiveClock() {
            updateClock();
            setInterval(updateClock, 1000);
        }

        function updateClock() {
            var now = new Date();
            var time = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            var date = now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
            $("#liveClock").html('<i class="fa-regular fa-clock"></i> ' + date + ' | ' + time);
        }

        // Auto Refresh (every 30 seconds)
        function startAutoRefresh() {
            autoRefreshInterval = setInterval(function() {
                if (!isRefreshing) {
                    loadAllData();
                }
            }, 30000);
        }

        // Filter Pills
        function initFilterPills() {
            $(".filter-pill").on("click", function() {
                $(".filter-pill").removeClass("active");
                $(this).addClass("active");
                loadCanteenMonitor();
            });
        }

        // Animated Counter
        function animateCounter(element, targetValue, prefix, suffix) {
            prefix = prefix || '';
            suffix = suffix || '';
            var $el = $(element);
            var startValue = parseInt($el.text().replace(/[^0-9]/g, '')) || 0;
            var duration = 1000;
            var startTime = null;

            function animate(currentTime) {
                if (!startTime) startTime = currentTime;
                var progress = Math.min((currentTime - startTime) / duration, 1);
                var easeProgress = 1 - Math.pow(1 - progress, 3);
                var currentValue = Math.floor(startValue + (targetValue - startValue) * easeProgress);
                $el.text(prefix + currentValue.toLocaleString() + suffix);

                if (progress < 1) {
                    requestAnimationFrame(animate);
                }
            }
            requestAnimationFrame(animate);
        }

        // Progress Ring Animation
        function updateProgressRing(element, percentage) {
            var circumference = 138; // 2 * PI * 22 (radius)
            var offset = circumference - (percentage / 100) * circumference;
            $(element).find('.progress').css('stroke-dashoffset', offset);
            $(element).find('.percentage').text(percentage + '%');
        }

        // Load Canteen Monitor
        function loadCanteenMonitor() {
            return new Promise(function(resolve, reject) {
                var filterType = parseInt($(".filter-pill.active").data("filter") || 1);
                var request = {
                    empId: parseInt(_empIdnew),
                    roleId: parseInt(_RoleIDnew),
                    companyId: _ComID,
                    branchId: _BranchID,
                    departmentId: _DepID,
                    filterType: filterType
                };
                $.ajax({
                    url: '@_webapiurl' + 'CMS/GetCanteenMonitor',
                    type: "POST",
                    contentType: "application/json",
                    headers: { "Authorization": "Bearer " + _Token },
                    data: JSON.stringify(request),
                    success: function (res) {
                        animateCounter("#TotalOrdersCount", res.totalOrders || 0);
                        animateCounter("#TodayOrdersCount", res.todayOrders || 0);
                        animateCounter("#MenuItemsCount", res.menuItems || 0);
                        animateCounter("#ActiveUsersCount", res.activeUsers || 0);
                        animateCounter("#PendingOrdersCount", res.pendingOrders || 0);
                        animateCounter("#TodayRevenueCount", res.todayRevenue || 0, '₹');

                        // Update pending badge
                        if (res.pendingOrders > 0) {
                            $("#pendingBadge").text(res.pendingOrders).show();
                        } else {
                            $("#pendingBadge").hide();
                        }

                        // Update revenue progress (assuming target is 50000)
                        var revenueTarget = 50000;
                        var revenueProgress = Math.min(Math.round((res.todayRevenue || 0) / revenueTarget * 100), 100);
                        updateProgressRing("#revenueProgress", revenueProgress);

                        resolve();
                    },
                    error: function (xhr) {
                        console.error("Canteen Monitor API Error", xhr.status, xhr.responseText);
                        reject();
                    }
                });
            });
        }

        // Load Order Overview Chart
        function loadOrderOverview() {
            return new Promise(function(resolve, reject) {
                var request = {
                    empId: parseInt(_empIdnew),
                    roleId: parseInt(_RoleIDnew),
                    companyId: _ComID,
                    branchId: _BranchID,
                    departmentId: _DepID
                };
                $.ajax({
                    url: '@_webapiurl' + 'CMS/GetOrderOverview',
                    type: "POST",
                    contentType: "application/json",
                    headers: { "Authorization": "Bearer " + _Token },
                    data: JSON.stringify(request),
                    success: function (res) {
                        if (res && res.orderItems && res.orderItems.length > 0) {
                            $("#Order_Overview").show();
                            $("#Order_Empty").hide();
                            prepareOrderOverview(res.orderItems);
                        } else {
                            $("#Order_Overview").hide();
                            $("#Order_Empty").show();
                        }
                        resolve();
                    },
                    error: function () {
                        $("#Order_Overview").hide();
                        $("#Order_Empty").show();
                        reject();
                    }
                });
            });
        }

        function prepareOrderOverview(data) {
            var groupedData = {};
            data.forEach(function (item) {
                var d = new Date(item.orderDate);
                var day = d.getDate().toString().padStart(2, '0');
                var month = d.toLocaleString('en-US', { month: 'short' });
                var key = day + '-' + month;
                if (!groupedData[key]) {
                    groupedData[key] = { orders: 0, revenue: 0 };
                }
                groupedData[key].orders += Number(item.orderCount || 0);
                groupedData[key].revenue += Number(item.revenue || 0);
            });
            var categories = Object.keys(groupedData);
            var ordersData = categories.map(k => groupedData[k].orders);
            var revenueData = categories.map(k => groupedData[k].revenue);
            drawOrderChart(categories, ordersData, revenueData);
        }

        function drawOrderChart(categories, ordersData, revenueData) {
            Highcharts.chart('OrderOverviewChart', {
                chart: {
                    type: 'areaspline',
                    height: 280,
                    style: { fontFamily: 'inherit' }
                },
                title: { text: '' },
                legend: {
                    align: 'center',
                    verticalAlign: 'bottom',
                    itemStyle: { fontSize: '12px', fontWeight: '500', color: '#64748b' }
                },
                xAxis: {
                    categories: categories,
                    labels: { style: { color: '#64748b', fontSize: '11px' } },
                    lineColor: '#e2e8f0',
                    tickColor: '#e2e8f0'
                },
                yAxis: [{
                    min: 0,
                    title: { text: '' },
                    labels: { style: { color: '#64748b', fontSize: '11px' } },
                    gridLineColor: '#f1f5f9'
                }],
                tooltip: {
                    shared: true,
                    useHTML: true,
                    backgroundColor: '#fff',
                    borderColor: '#e2e8f0',
                    borderRadius: 12,
                    shadow: { color: 'rgba(0,0,0,0.1)', offsetX: 0, offsetY: 4, width: 20 },
                    style: { fontSize: '12px' }
                },
                plotOptions: {
                    areaspline: {
                        fillOpacity: 0.15,
                        lineWidth: 3,
                        marker: {
                            enabled: false,
                            symbol: 'circle',
                            radius: 4,
                            states: { hover: { enabled: true } }
                        }
                    }
                },
                series: [{
                    name: 'Orders',
                    data: ordersData,
                    color: '#FF6B35',
                    fillColor: {
                        linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
                        stops: [[0, 'rgba(255, 107, 53, 0.3)'], [1, 'rgba(255, 107, 53, 0)']]
                    }
                }],
                credits: { enabled: false }
            });
        }

        // Load Food Category Distribution (Donut Chart)
        function loadFoodCategoryDistribution() {
            return new Promise(function(resolve) {
                // Sample data - replace with API call
                var data = [
                    { name: 'Breakfast', y: 30, color: '#FF6B35' },
                    { name: 'Lunch', y: 40, color: '#22C55E' },
                    { name: 'Snacks', y: 15, color: '#F59E0B' },
                    { name: 'Beverages', y: 10, color: '#3B82F6' },
                    { name: 'Dinner', y: 5, color: '#8B5CF6' }
                ];
                drawDonutChart(data);
                resolve();
            });
        }

        function drawDonutChart(data) {
            Highcharts.chart('FoodCategoryChart', {
                chart: {
                    type: 'pie',
                    height: 260,
                    style: { fontFamily: 'inherit' }
                },
                title: { text: '' },
                tooltip: {
                    pointFormat: '<b>{point.percentage:.1f}%</b>',
                    backgroundColor: '#fff',
                    borderColor: '#e2e8f0',
                    borderRadius: 8
                },
                plotOptions: {
                    pie: {
                        innerSize: '65%',
                        dataLabels: { enabled: false },
                        showInLegend: true,
                        borderWidth: 0,
                        states: { hover: { brightness: 0.1 } }
                    }
                },
                legend: {
                    align: 'center',
                    verticalAlign: 'bottom',
                    layout: 'horizontal',
                    itemStyle: { fontSize: '11px', fontWeight: '500', color: '#64748b' }
                },
                series: [{ data: data }],
                credits: { enabled: false }
            });
        }

        // Load Popular Items
        function loadPopularItems() {
            return new Promise(function(resolve) {
                // Sample data - replace with API call
                var items = [
                    { rank: 1, name: 'Chicken Biryani', count: 125 },
                    { rank: 2, name: 'Masala Dosa', count: 98 },
                    { rank: 3, name: 'Paneer Butter Masala', count: 87 },
                    { rank: 4, name: 'Coffee', count: 76 },
                    { rank: 5, name: 'Veg Thali', count: 65 }
                ];
                renderPopularItems(items);
                resolve();
            });
        }

        function renderPopularItems(items) {
            var html = '';
            $.each(items, function(i, item) {
                html += `
                <div class="popular-item">
                    <div class="d-flex align-items-center">
                        <span class="rank">${item.rank}</span>
                        <span class="item-name">${item.name}</span>
                    </div>
                    <span class="item-count">${item.count} orders</span>
                </div>`;
            });
            $("#popularItemsContainer").html(html);
        }

        // Load Recent Orders
        function loadRecentOrders() {
            return new Promise(function(resolve, reject) {
                var request = {
                    empId: parseInt(_empIdnew),
                    roleId: parseInt(_RoleIDnew),
                    companyId: _ComID,
                    branchId: _BranchID,
                    month: parseInt($("#cmsMonth").val() || 0)
                };
                $.ajax({
                    url: '@_webapiurl' + 'CMS/GetRecentOrders',
                    type: "POST",
                    contentType: "application/json",
                    headers: { "Authorization": "Bearer " + _Token },
                    data: JSON.stringify(request),
                    success: function (res) {
                        $("#RecentOrders_Empty").hide();
                        $("#RecentOrders_List").hide();
                        if (!res || !res.orders || res.orders.length === 0) {
                            $("#RecentOrders_Empty").show();
                            resolve();
                            return;
                        }
                        $("#RecentOrders_List").show();
                        bindRecentOrders(res.orders);
                        resolve();
                    },
                    error: function () {
                        $("#RecentOrders_Empty").show();
                        reject();
                    }
                });
            });
        }

        function bindRecentOrders(items) {
            var html = '';
            $.each(items, function (i, item) {
                var initials = getInitials(item.employeeName);
                var statusClass = getStatusClass(item.status);
                var statusText = item.status || 'Unknown';
                html += `
                <div class="order-item ${statusClass}">
                    <div class="d-flex align-items-center">
                        <div class="order-avatar">${initials}</div>
                        <div class="order-info">
                            <h6>${item.employeeName}</h6>
                            <p><i class="fa-solid fa-utensils"></i> ${item.menuItem || '-'} &nbsp;|&nbsp; <i class="fa-regular fa-clock"></i> ${formatTime(item.orderDate)}</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="order-amount">₹${item.amount || 0}</div>
                        <span class="order-status ${statusClass.replace('status-', '')}">${statusText}</span>
                    </div>
                </div>`;
            });
            $("#recentOrdersContainer").html(html);
        }

        function getInitials(name) {
            if (!name) return '?';
            var parts = name.split(' ');
            return (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
        }

        function getStatusClass(status) {
            switch (status) {
                case 'Delivered':
                case 'Completed': return 'status-delivered';
                case 'Preparing':
                case 'Processing': return 'status-preparing';
                case 'Pending': return 'status-pending';
                case 'Cancelled':
                case 'Rejected': return 'status-cancelled';
                default: return '';
            }
        }

        function formatTime(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            return date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
        }

        // Load Pending Orders
        function loadPendingOrders() {
            return new Promise(function(resolve, reject) {
                var request = {
                    empId: parseInt(_empIdnew),
                    roleId: parseInt(_RoleIDnew),
                    companyId: _ComID,
                    branchId: _BranchID,
                    month: 0
                };
                $.ajax({
                    url: '@_webapiurl' + 'CMS/GetPendingOrders',
                    type: "POST",
                    contentType: "application/json",
                    headers: { "Authorization": "Bearer " + _Token },
                    data: JSON.stringify(request),
                    success: function (res) {
                        $("#PendingOrders_Empty").hide();
                        $("#PendingOrders_List").hide();
                        if (!res || !res.pendingItems || res.pendingItems.length === 0) {
                            $("#PendingOrders_Empty").show();
                            resolve();
                            return;
                        }
                        $("#PendingOrders_List").show();
                        renderPendingOrders(res.pendingItems);
                        resolve();
                    },
                    error: function () {
                        $("#PendingOrders_Empty").show();
                        reject();
                    }
                });
            });
        }

        function renderPendingOrders(items) {
            var html = '';
            $.each(items, function (i, item) {
                var initials = getInitials(item.employeeName);
                html += `
                <div class="approval-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="order-avatar">${initials}</div>
                            <div class="order-info">
                                <h6>${item.employeeName}</h6>
                                <p><i class="fa-solid fa-utensils"></i> ${item.menuItem || '-'}</p>
                                <p><i class="fa-solid fa-receipt"></i> Order #${item.orderId}</p>
                            </div>
                        </div>
                        <div class="order-amount">₹${item.amount || 0}</div>
                    </div>
                    <div class="approval-actions">
                        <button class="btn-approve" onclick="updateOrderStatus(${item.orderId}, 'Approve')">
                            <i class="fa-solid fa-check"></i> Approve
                        </button>
                        <button class="btn-reject" onclick="updateOrderStatus(${item.orderId}, 'Reject')">
                            <i class="fa-solid fa-xmark"></i> Reject
                        </button>
                    </div>
                </div>`;
            });
            $("#pendingOrdersContainer").html(html);
        }

        window.updateOrderStatus = function (orderId, action) {
            var request = {
                OrderId: orderId,
                UserId: parseInt(_empIdnew),
                Action: action
            };
            $.ajax({
                url: '@_webapiurl' + 'CMS/UpdateOrderStatus',
                type: "POST",
                contentType: "application/json",
                headers: { "Authorization": "Bearer " + _Token },
                data: JSON.stringify(request),
                success: function (res) {
                    toastr.success(res.message || 'Order ' + action + 'd successfully');
                    loadPendingOrders();
                    loadCanteenMonitor();
                },
                error: function () {
                    toastr.error("Failed to update order.");
                }
            });
        };

        // Export to Excel
        window.exportToExcel = function() {
            toastr.info("Preparing export...");
            setTimeout(function() {
                toastr.success("Export completed!");
            }, 1500);
        };

        // Manual Refresh
        window.manualRefresh = function() {
            if (!isRefreshing) {
                loadAllData();
            }
        };

        // Filter change handlers
        $("#cmsMonth").change(function () {
            loadRecentOrders();
        });

        // Widget customization
        $("#widgetSave").on("click", function () {
            $(".widget-checkbox").each(function () {
                var widgetKey = $(this).data("widget");
                var $widget = $("[data-widget='" + widgetKey + "']").not("#customwidget_modal *");
                if ($(this).is(":checked")) {
                    $widget.slideDown(300);
                } else {
                    $widget.slideUp(300);
                }
            });
            $("#customwidget_modal").modal("hide");
            toastr.success("Dashboard customized successfully!");
        });
    });
</script>

