                <button type="button" class="btn" id="widgetSave" style="background:linear-gradient(135deg, #667eea 0%, #764ba2 100%);color:#fff;border:none;border-radius:8px;padding:10px 24px;">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</div>
