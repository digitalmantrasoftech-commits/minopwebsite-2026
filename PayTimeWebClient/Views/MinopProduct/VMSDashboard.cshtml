                        <input type="checkbox" class="widget-checkbox" data-widget="visitorOverview" checked style="width:18px;height:18px;">
                    </label>
                    <label class="d-flex align-items-center justify-content-between" style="padding:12px 0;border-bottom:1px solid #f1f5f9;cursor:pointer;">
                        <span style="font-weight:500;">Visitor Distribution</span>
                        <input type="checkbox" class="widget-checkbox" data-widget="visitorType" checked style="width:18px;height:18px;">
                    </label>
                    <label class="d-flex align-items-center justify-content-between" style="padding:12px 0;border-bottom:1px solid #f1f5f9;cursor:pointer;">
