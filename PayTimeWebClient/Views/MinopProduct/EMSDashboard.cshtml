    <!-- Drag & Drop Card Reorder for EMS Dashboard -->
    <script>
        (function () {
            var EMS_USER_ID = '@_UserId';
            var EMS_ACCOUNT = '@_accountcd';
            var STORAGE_KEY = 'emsDashboardCardOrder_' + EMS_ACCOUNT + '_' + EMS_USER_ID;

            function addDragHandles() {
                $('#ems-dashboard-sortable-row > div').each(function () {
                    var $header = $(this).find('.card_header').first();
                    if ($header.length && !$header.find('.drag-handle').length) {
                        var $firstChild = $header.children().first();
                        var $handle = $('<span class="drag-handle tooltips" data-placement="top" data-original-title="Drag to reorder"><i class="fa-light fa-grip-dots-vertical"></i></span>');
                        if ($firstChild.hasClass('d-flex')) {
                            $firstChild.prepend($handle);
                        } else {
                            $header.prepend($handle);
                        }
                    }
                });
            }

            function getCardOrder() {
                var order = [];
                $('#ems-dashboard-sortable-row > div').each(function () {
                    var widget = $(this).data('widget');
                    if (widget) {
                        order.push(widget);
                    }
                });
                return order;
            }

            function saveCardOrder() {
                var order = getCardOrder();
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(order));
                } catch (e) { }
            }

            function restoreCardOrder() {
                try {
                    var saved = localStorage.getItem(STORAGE_KEY);
                    if (!saved) return;
                    var order = JSON.parse(saved);
                    if (!Array.isArray(order) || order.length === 0) return;

                    var $container = $('#ems-dashboard-sortable-row');
                    var widgetMap = {};

                    $container.children().each(function () {
                        var widget = $(this).data('widget');
                        if (widget) {
                            widgetMap[widget] = $(this);
                        }
                    });

                    for (var i = 0; i < order.length; i++) {
                        if (widgetMap[order[i]]) {
                            $container.append(widgetMap[order[i]]);
                            delete widgetMap[order[i]];
                        }
                    }
                    for (var key in widgetMap) {
                        $container.append(widgetMap[key]);
                    }
                } catch (e) { }
            }

            // Restore card order IMMEDIATELY to prevent position flash
            restoreCardOrder();

            function initEMSDashboardSortable() {
                var el = document.getElementById('ems-dashboard-sortable-row');
                if (!el) return;

                addDragHandles();
                $('.drag-handle.tooltips').tooltip({ container: 'body', trigger: 'hover' });

                Sortable.create(el, {
                    handle: '.drag-handle',
                    animation: 250,
                    ghostClass: 'sortable-ghost',
                    chosenClass: 'sortable-chosen',
                    dragClass: 'sortable-drag',
                    easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
                    forceFallback: false,
                    onEnd: function () {
                        saveCardOrder();
                    }
                });
            }

            // Only delay Sortable init + drag handles, NOT the order restore
            setTimeout(function () {
                initEMSDashboardSortable();
            }, 1500);
        })();
    </script>
}
