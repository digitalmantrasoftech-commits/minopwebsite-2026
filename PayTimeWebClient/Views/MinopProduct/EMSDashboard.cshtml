<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700;900&display=swap" rel="stylesheet">

<script src="~/Newlayout/js/sortable.min.js"></script>
<style>
    .highcharts-figure,
    .highcharts-data-table table {
        max-width: 100%;
        margin: 10px auto;
    }
</style>

<script>
    var currentRequestType = 1;
    $(document).ready(function () {
        var _UID = '@_UserId';
        var _ComID = '@_companyid';
        var _BranchID = '@_branchid';
        var _DepID = '@DepartmentId';
        var _empIdnew = '@_empid';
        var _NewEmpName = "@_empName";
        var _RoleIDnew = '@_RoleId';
        var _Token = '@_tokan';
        loadExpenseMonitor();
        loadExpenseOverview();
        $("#ExpenseMonitorFilter").change(function () {
            loadExpenseMonitor();
        });
        loadMyRequests(1);
        $("#emsMonth").change(function () {
            var activeTab = $(".nav-tabs .active a").attr("href");
            loadMyRequests(activeTab === "#MyExpense" ? 1 : 2);
        });
        loadWhoIsTraveling();
        fillDepartment();
        loadPendingRequests();
        $("#emsMonths, #emsDepartment").change(function () {
            loadPendingRequests();
        });
        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var target = $(e.target).attr("href");

            switch (target) {

                // MY REQUESTS
                case "#MyExpense":
                    loadMyRequests(1); // Expense
                    break;
                case "#MyTravel":
                    loadMyRequests(2); // Travel
                    break;
                //  PENDING REQUESTS
                case "#PendingExpense":
                    currentRequestType = 1;
                    loadPendingRequests();
                    break;

                case "#PendingMyTravel":
                    currentRequestType = 2;
                    loadPendingRequests();
                    break;
            }
        });

        function loadExpenseMonitor() {
            var filterType = parseInt($("#ExpenseMonitorFilter").val());
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: _DepID,
                filterType: filterType
            };
            $.ajax({
                url: '@_webapiEMSURL' + 'CommanMaster/GetAdminExpenseCountMonitor',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    $("#TotalExpenseCount").text(res.totalExpense || 0);
                    $("#TodayExpenseCount").text(res.todayExpense || 0);
                    $("#TravelExpenseCount").text(res.travelExpense || 0);
                    $("#PendingExpenseCount").text(res.pendingExpense || 0);
                    $("#ApprovedExpenseCount").text(res.approvedExpense || 0);
                    $("#RejectedExpenseCount").text(res.rejectedExpense || 0);
                },
                error: function (xhr) {
                    console.error("Expense Monitor API Error", xhr.status, xhr.responseText);
                }
            });
        }
        function loadExpenseOverview() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: _DepID
            };
            $.ajax({
                url: '@_webapiEMSURL' + 'CommanMaster/GetExpenseOverview',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    // Normalize API response
                    var expenseItems = Array.isArray(res?.expenseItems)
                        ? res.expenseItems
                        : [];
                    //  Empty case
                    if (expenseItems.length === 0) {
                        drawTravelChart([], []);
                        $("#Expense_Overview").hide();
                        $("#Expense_Empty").show();
                        $("#Travel_Overview").hide();
                        $("#Travel_Empty").show();
                        return;
                    }
                    // ===== Expense Overview =====
                    var expenseOnly = expenseItems.filter(item => item.expenseRequestType === 1);
                    if (expenseOnly.length > 0) {
                        prepareExpenseOverview(expenseOnly);
                    } else {
                        $("#Expense_Overview").hide();
                        $("#Expense_Empty").show();
                    }
                    // ===== Travel Overview =====
                    var travelOnly = expenseItems.filter(item => item.expenseRequestType === 2);
                    if (travelOnly.length > 0) {
                        prepareTravelOverview(travelOnly);
                    } else {
                        $("#Travel_Overview").hide();
                        $("#Travel_Empty").show();
                    }
                },
                error: function () {
                    drawTravelChart([], []);
                }
            });
        }
        function prepareExpenseOverview(data) {
            let categories = [...new Set(
                data.map(x => moment(x.expenseDate).format('DD-MMM'))
            )];
            const expenseTypes = [...new Set(data.map(x => x.categoryName))];
            const colors = [
                '#62B2FD', // Conveyance
                '#9BDFC4', // Petrol
                '#DA6F84', // Hardware
                '#A2845E', // Postage
                '#5856D6'  // Other
            ];
            let isSinglePoint = categories.length === 1;
            if (isSinglePoint) {
                categories.push(categories[0]);
            }
            let series = [];
            expenseTypes.forEach((type, i) => {
                let values = [];
                let lastValue = null;
                categories.forEach((date, index) => {
                    let item = data.find(x =>
                        moment(x.expenseDate).format('DD-MMM') === date &&
                        x.categoryName === type
                    );
                    if (item) {
                        lastValue = item.amount;
                        values.push(item.amount);
                    } else if (isSinglePoint && index === 1) {
                        values.push(lastValue);
                    } else {
                        values.push(lastValue);
                    }
                });
                series.push({
                    name: type,
                    data: values,
                    color: colors[i % colors.length]
                });
            });
            drawExpenseOverview(categories, series);
        }
        function drawExpenseOverview(categories, series) {
            Highcharts.chart('ExpenseOverview', {
                chart: {
                    type: 'spline',
                    backgroundColor: '#ffffff',
                    spacingTop: 20,
                    spacingBottom: 15,
                    style: {
                        fontFamily: 'Roboto'
                    }
                },
                title: { text: '' },
                xAxis: {
                    categories: categories,
                    tickLength: 0,
                    lineColor: '#E6E6E6',
                    labels: {
                        style: {
                            color: '#666',
                            fontSize: '12px'
                        }
                    }
                },
                yAxis: {
                    title: { text: '' },
                    gridLineColor: '#F2F2F2',
                    labels: {
                        formatter: function () {
                            return '₹' + (this.value / 1000) + 'k';
                        },
                        style: {
                            color: '#666',
                            fontSize: '12px'
                        }
                    }
                },
                legend: {
                    align: 'center',
                    verticalAlign: 'bottom',
                    symbolRadius: 6,
                    symbolHeight: 8,
                    symbolWidth: 8,
                    itemStyle: {
                        fontSize: '12px',
                        fontWeight: '400',
                        color: '#444'
                    }
                },
                tooltip: {
                    shared: true,
                    useHTML: true,
                    backgroundColor: '#ffffff',
                    borderColor: '#DADADA',
                    borderRadius: 6,
                    shadow: true,
                    formatter: function () {
                        let html = `<b>${this.x}</b><br/>`;
                        this.points.forEach(p => {
                            html += `
                        <span style="color:${p.color}">●</span>
                        ${p.series.name}:
                        <b>₹${Highcharts.numberFormat(p.y, 0)}</b><br/>
                    `;
                        });
                        return `<div style="padding:6px 10px">${html}</div>`;
                    }
                },
                plotOptions: {
                    series: {
                        connectNulls: true,
                        lineWidth: 2,
                        marker: {
                            radius: 4,
                            symbol: 'circle',
                            lineWidth: 2,
                            lineColor: '#ffffff'
                        }
                    }
                },
                series: series,
                credits: { enabled: false }
            });
        }
        function prepareTravelOverview(items) {
            var groupedData = {};
            items.forEach(function (item) {
                var d = new Date(item.expenseDate);
                var day = d.getDate().toString().padStart(2, '0');
                var month = d.toLocaleString('en-US', { month: 'short' });
                var key = day + '-' + month;
                if (!groupedData[key]) {
                    groupedData[key] = 0;
                }
                groupedData[key] += Number(item.amount);
            });
            var categories = Object.keys(groupedData);
            var amounts = Object.values(groupedData);
            drawTravelChart(categories, amounts);
        }

        function drawTravelChart(categories, data) {
            Highcharts.chart('container', {
                chart: {
                    type: 'column'
                },
                title: {
                    text: ''
                },
                legend: {
                    enabled: false
                },
                xAxis: {
                    categories: categories
                },
                yAxis: {
                    min: 0,
                    title: {
                        text: ''
                    },
                    labels: {
                        formatter: function () {
                            return '₹' + this.value;
                        }
                    }
                },
                tooltip: {
                    useHTML: true,
                    formatter: function () {
                        return `
                    <b>${this.x} ${new Date().getFullYear()}</b><br/>
                    ₹${Highcharts.numberFormat(this.y, 0)}
                `;
                    }
                },
                plotOptions: {
                    column: {
                        pointPadding: 0.2,
                        borderWidth: 0,
                        color: '#62B2FD'
                    }
                },
                series: [{
                    name: 'Amount',
                    data: data
                }]
            });
        }

        function loadMyRequests(requestType) {
            var request = {
                empId: parseInt(_empIdnew),
                month: parseInt($("#emsMonth").val()),
                requestType: requestType // 1 = Expense, 2 = Travel
            };
            $.ajax({
                url: '@_webapiEMSURL' + 'CommanMaster/GetMyRequests',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    $("#Myrequest_Expense").hide();
                    $("#Myrequest_Travel").hide();
                    $("#Myrequest_Empty").hide();
                    if (!res || !res.requestItems || res.requestItems.length === 0) {
                        $("#Myrequest_Empty").show();
                        getTargetContainer(requestType).html(
                            '<p class="text-center text-muted">No records found</p>'
                        );
                        return;
                    }
                    if (requestType === 1) {
                        $("#Myrequest_Expense").show();
                    }
                    if (requestType === 2) {
                        $("#Myrequest_Travel").show();
                    }
                    bindMyRequests(res.requestItems, requestType);
                },
                error: function (xhr) {
                    console.error("My Requests API Error", xhr.status, xhr.responseText);
                }
            });
        }
        function bindMyRequests(items, requestType) {
            var html = '';
            $.each(items, function (i, item) {
                var dateObj = new Date(item.requestDate);
                var day = dateObj.getDate();
                var month = dateObj.toLocaleString('default', { month: 'short' });
                var statusClass = getStatusClass(item.statusName);
                html += `
                <div class="myleave_detail">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="h_box">
                                <div class="h_date">${day}</div>
                                <div class="h_day">${month}</div>
                            </div>
                            <div class="margin-left-10">
                                <p class="pr_ttl_new">${item.requestTitle}</p>
                            </div>
                        </div>
                        <div class="${statusClass}">
                            ${item.statusName}
                        </div>
                    </div>
                </div>`;
                    });
                    getTargetContainer(requestType).html(html);
                }
        function getStatusClass(status) {
            switch (status) {
                case 'Approved':
                    return 'green_font';
                case 'Pending':
                case 'Submitted':
                    return 'orange_font';
                case 'Rejected':
                case 'Declined':
                    return 'red_font';
                default:
                    return '';
            }
        }
        function getTargetContainer(requestType) {
            return requestType === 1
                ? $("#MyExpense .expensemyrequest_fullheight_card")
                : $("#MyTravel .expensemyrequest_fullheight_card");
        }
       function loadWhoIsTraveling() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: _DepID
            };
            $.ajax({
                url: '@_webapiEMSURL' + 'CommanMaster/GetWhoIsTraveling',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    $("#whoIsTravelingContainer").empty();
                    if (res && res.travelItems && res.travelItems.length > 0) {
                        $("#whoIsTravelingContainer").show();
                        $("#WhoIsTraveling_Empty").hide();
                        bindWhoIsTraveling(res.travelItems);
                    } else {
                        $("#whoIsTravelingContainer").hide();
                        $("#WhoIsTraveling_Empty").show();
                    }
                },
                error: function (xhr) {
                    console.error("Who Is Traveling API Error",
                        xhr.status, xhr.responseText);
                    $("#whoIsTravelingContainer").hide();
                    $("#WhoIsTraveling_Empty").show();
                }
            });
        }
        function bindWhoIsTraveling(data) {
            var container = $("#whoIsTravelingContainer");
            var html = "";
            if (!data || data.length === 0) {
                container.html('<p class="text-center text-muted">No employees traveling</p>');
                return;
            }
            $.each(data, function (i, item) {
                var startDate = new Date(item.tripStartDate);
                var endDate = new Date(item.tripEndDate);
                var startDay = startDate.getDate();
                var endDay = endDate.getDate();
                var month = startDate.toLocaleString('default', { month: 'short' });
                html += `
                <div class="myleave_detail">
                    <div class="d-flex">
                        <div class="h_box">
                            <div class="h_date">${startDay}-${endDay}</div>
                            <div class="h_day">${month}</div>
                        </div>
                        <div class="tripdetail_main margin-left-10">
                            <div class="reqby">
                                <span>${item.empName || '-'}</span>
                            </div>
                            <div class="tripdetail">
                                ${item.tripPurpose || ''}
                            </div>
                        </div>
                    </div>
                </div>`;
            });
            container.html(html);
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            return date.toLocaleDateString('en-GB');
        }

        //Add Customwidget modal open code
        $("#customwidget_btn").on('click', function () {
            $("#customwidget_btn").attr("data-toggle", "modal");
            $("#customwidget_btn").attr("data-target", "#customwidget_modal");
        });

        $("#TotalExpense").on('click', function () {
            $("#TotalExpense").attr("data-toggle", "modal");
            $("#TotalExpense").attr("data-target", "#TotalExpense_modal");
        });

        //TotalExpense Modal in datatable code ============================
        var table = $("#totalexpense_table").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            ordering: true,
        });
        setTimeout(function () {
            $("#" + "totalexpense_table" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        $("#totalexpense_table thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });

        function fillDepartment() {
            $.ajax({
                url: '@_webapiurl' + "/Master/DepartmentGetAll",
                method: "GET",
                contentType: "application/json; charset=utf-8",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                success: function (data) {
                    var $deptDropdown = $("#emsDepartment");
                    $deptDropdown.empty();

                    $deptDropdown.append('<option value="0">All</option>');

                    $.each(data, function (i, dept) {
                        $deptDropdown.append('<option value="' + dept.DepartmentId + '">' + dept.DepartmentName + '</option>');
                    });
                },
                error: function (err) {
                    console.error("Error loading departments", err);
                }
            });
        }
       function loadPendingRequests() {
            var request = {
                empId: parseInt(_empIdnew),
                roleId: parseInt(_RoleIDnew),
                companyId: _ComID,
                branchId: _BranchID,
                departmentId: parseInt($("#emsDepartment").val()),
                month: parseInt($("#emsMonths").val()),
                requestType: currentRequestType
            };
            $("#Pendingrequest_Expense").hide();
            $("#Pendingrequest_Travel").hide();
            $("#Pendingrequest_Empty").hide();
            $("#pendingExpenseContainer").empty();
            $("#pendingTravelContainer").empty();
            $.ajax({
                url: '@_webapiEMSURL' + 'CommanMaster/GetPendingRequests',
                type: "POST",
                contentType: "application/json",
                headers: {
                    "Authorization": "Bearer " + _Token
                },
                data: JSON.stringify(request),
                success: function (res) {
                    $("#pendingExpenseContainer").empty();
                    $("#pendingTravelContainer").empty();
                    if (!res || !Array.isArray(res.pendingItems) || res.pendingItems.length === 0) {
                        $("#Pendingrequest_Expense").hide();
                        $("#Pendingrequest_Travel").hide();
                        $("#Pendingrequest_Empty").show();
                        return;
                    }
                    var filteredItems = res.pendingItems.filter(
                        x => x.expenseRequestType === currentRequestType
                    );
                    if (filteredItems.length === 0) {
                        $("#Pendingrequest_Expense").hide();
                        $("#Pendingrequest_Travel").hide();
                        $("#Pendingrequest_Empty").show();
                        return;
                    }
                    $("#Pendingrequest_Empty").hide();
                    if (currentRequestType === 1) {
                        $("#Pendingrequest_Expense").show();
                        renderPendingRequests(filteredItems, "#pendingExpenseContainer");
                    } else {
                        $("#Pendingrequest_Travel").show();
                        renderPendingRequests(filteredItems, "#pendingTravelContainer");
                    }
                },
                error: function () {
                    $("#Pendingrequest_Expense").hide();
                    $("#Pendingrequest_Travel").hide();
                    $("#Pendingrequest_Empty").show();
                }
            });
        }
        function renderPendingRequests(items, containerId) {
            var html = '';
            $.each(items, function (i, item) {
                html += `
                <div class="pending_request_block d-flex justify-content-between margin-bottom-10">
                    <div class="tripdetail_main">
                        <div class="reqby">Requested by: <span>${item.empName}</span></div>
                        <div class="tripdetail">${item.description || ''}</div>
                        <div class="text-muted small">Date: ${formatDate(item.expenseDate)}</div>
                    </div>
                    <div class="tripactionbtn">
                        <a href="javascript:;" class="btn green_btnnew approve"
                           onclick="updateApproval(${item.expenseId}, 'Approve')"><i class="fa-solid fa-check"></i></a>
                        <a href="javascript:;" class="btn red_btnnew reject"
                           onclick="updateApproval(${item.expenseId}, 'Reject')"><i class="fa-solid fa-xmark"></i></a>
                    </div>
                </div>`;
            });
            $(containerId).html(html);
        }
        window.updateApproval = function (expenseId, action) {
            var request = {
                ExpenseId: expenseId,
                UserId: parseInt(_empIdnew),
                Action: action
            };
            $.ajax({
                url: '@_webapiEMSURL' + 'CommanMaster/UpdateApprovalStatus',
                type: "POST",
                contentType: "application/json",
                headers: { "Authorization": "Bearer " + _Token },
                data: JSON.stringify(request),
                success: function (res) {
                    toastr.success(res.message);
                    loadPendingRequests();
                },
                error: function (xhr) {
                    console.error("Approval API Error", xhr.status, xhr.responseText);
                    alert("Failed to update request.");
                }
            });
        };
        $("#widgetSave").on("click", function () {
            $(".widget-checkbox").each(function () {
                var widgetKey = $(this).data("widget");
                // Select ONLY dashboard widgets (exclude modal completely)
                var $dashboardWidget = $(
                    ".row[data-widget='" + widgetKey + "'], " +
                    ".col-lg-6[data-widget='" + widgetKey + "']"
                ).not("#customwidget_modal *");
                if ($(this).is(":checked")) {
                    $dashboardWidget.show();
                } else {
                    $dashboardWidget.hide();
                }
            });
            $("#customwidget_modal").modal("hide");
        });
    });

</script>

@if (obj.CanView)
{
    <div class="page-bar">
        <ul class="page-breadcrumb">
            <li>
                <a href="/MinopProduct/EMSDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span> <i class="fa fa-angle-right"> </i> Expense Management Dashboard</span>
            </li>
        </ul>
        <div class="filter_search pull-right">
            <button id="customwidget_btn" class="btn icon_transparent_btn tooltips margin-right-5" type="button" data-placement="left" data-original-title="Custom Widget"><i class="fa-light fa-objects-column"></i></button>
            <button id="Filter_search" class="btn icon_transparent_btn tooltips" type="button" data-placement="bottom" data-original-title="Filter"><i class="fa-light fa-filter"></i></button>
        </div>
    </div>

    <div class="body_section">

        <div class="row" data-widget="expenseMonitor">
            <!-- Expense Monitor Block : Begin -->
            <div class="col-lg-12">
                <div class="card_box margin-bottom-20">
                    <div class="card_header">
                        <div class="d-flex align-items-center">
