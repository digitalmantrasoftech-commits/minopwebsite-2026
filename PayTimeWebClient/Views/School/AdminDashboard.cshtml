    function requestGPSData() {
        $.ajax({
            url: '@_webapiurl' + 'Transaction/GetGPSData',
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            success: function (data)
            {
                deleteMarkers();
                //alert('Markers');
                setMarkers(map, data);
                setTimeout(requestGPSData, 2000);
            },
            cache: false
        });
    }


    function requestData() {
        $.ajax({
            url: '@_webapiurl' + 'DashBoard/AdminLiveAttendanceschool?cmpId=@_companyid&brid=0&roleid=@_RoleId',
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            success: function (point) {
                if (point[0].attendance != "0") {
                    $("#liveemptydata").hide();
                    $("#containerLivePunch").show();
                    var series = chart.series[0],
                        shift = series.data.length > 20; // shift if the series is longer than 20
                    // add the point
                    chart.series[0].addPoint([(new Date()).getTime(), parseInt(point[0].attendance)], true, shift);
                    // call it again after one second
                    setTimeout(requestData, 1000);
                } else {
                    $("#containerLivePunch").hide();
                    $("#liveemptydata").show();
                }
            },
            cache: false
        });
    }
    function TimePieChart(series) {
        Highcharts.chart('containerTimePie', {
            chart: {
                type: 'pie',
                options3d: {
                    enabled: true,
                    alpha: 45
                }
            },
            title: {
                text: "Today's Punch time wise"
            },
            plotOptions: {
                pie: {
                    innerSize: 100,
                    depth: 45
                }
            },
            series: [{
                name: 'Punches',
                data: series
            }]
        });
    }

