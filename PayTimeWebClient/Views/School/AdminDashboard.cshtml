            loc = new google.maps.LatLng(parseFloat(data[i].Latitude), parseFloat(data[i].Longitude));
            bounds.extend(loc);
            var marker = new google.maps.Marker({
                position: { lat: parseFloat(data[i].Latitude), lng: parseFloat(data[i].Longitude) },
                map: map,
                icon: image,
                shape: shape,
                //title: data[i].VehicleNo,
                zIndex: i + 1
            });

            var content = "<h5><b> Bus : " + data[i].VehicleNo + "</b></h5>";
            var infowindow = new google.maps.InfoWindow()

             google.maps.event.addListener(marker, 'click', (function (marker, content, infowindow) {
                 return function () {
                     infowindow.setContent(content);
                     infowindow.open(map, marker);
                 };
             })(marker, content, infowindow));
            //marker.setMap(null);
            //marker.setMap(map);
            //marker.animateTo(loc, { easing: "linear", duration: 1000 });
            //m = 0;
            //deltaLat = (parseFloat(data[i].Latitude) - pos.lat) / numDeltas;
            //deltaLng = (parseFloat(data[i].Longitude) - pos.lng) / numDeltas;
            //moveMarker();
            markers.push(marker);
        }
        marker.addListener('mouseover', function () {
            infowindow.setContent(content);
            infowindow.open(map, this);
        });

        // assuming you also want to hide the infowindow when user mouses-out
        marker.addListener('mouseout', function () {
            infowindow.close();
        });
        map.fitBounds(bounds);
        map.panToBounds(bounds);
    }



