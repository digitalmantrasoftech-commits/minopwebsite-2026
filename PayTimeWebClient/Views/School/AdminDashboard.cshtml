                     $('.loading').show();
                 },
                 success: function (data) {
                     if (data.isRedirect) {
                         window.location.href = data.redirectUrl;
                     }
                     $('.loading').hide();
                     var markup = '';
                     for (var x = 0; x < data.length; x++) {
