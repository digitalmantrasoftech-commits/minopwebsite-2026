            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response != null) {
                    for (var i = 0; i < response.length; i++) {
                        // Create an object with RoleId and RoleName and push it to the roleData array
                        roleData.push({ RoleId: response[i].RoleId, RoleName: response[i].RoleName });
                    }
                }
                $(".loading").hide();
            },
            error: function () {
                $(".loading").hide();
            }
        });
    }
