    function getempname(callback) {
        $.ajax({
            type: "GET",
            url: '/MasterData/EmployeeGetReporting',
            contentType: "application/json; charset=utf-8",
            dataType: 'json',
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (data) {
                var compressedData = atob(data);
                var data = JSON.parse(pako.inflate(compressedData, { to: 'string' }));
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                $("#ajax_loader").hide();
                data.sort(function (a, b) {
                    return a.EmpName.localeCompare(b.EmpName);
                });
                for (var x = 0; x < data.length; x++) {
                    EmpData.push({ EmpID: data[x].EmpId, Empname: data[x].EmpName });
                }
                // Call the callback function if provided
                if (callback && typeof callback === 'function') {
                    callback();
                }
            },
            error: function (jqXHR, ajaxOptions, thrownError) {
                $("#ajax_loader").hide();
                if (jqXHR.status == 500) {
                    toastr.error("InternalServerError");
                } else if (jqXHR.status == 400) {
                    toastr.error("BadRequest");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            }
        });
    }
    function getRoleNameByRoleId(roleId, reviewdby) {
        var roleName = null;
        if (roleId === 1) {
            roleName = "HR/Admin";
        } else if (roleId === 2) {
            // Assuming EmpData is globally accessible
            for (var i = 0; i < EmpData.length; i++) {
                if (EmpData[i].EmpID === reviewdby) {
                    roleName = EmpData[i].Empname;
                    break; // Exit the loop when a match is found
                }
            }
        } else if (roleId === 3) {
            roleName = "Reporting To";
        }
        return roleName;
    }
    function rolegetalldrp() {
        $.ajax({
