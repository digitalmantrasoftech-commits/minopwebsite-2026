    function saveUploadDoc(e) {
        e.preventDefault();
        var file_names = [];
        $(".selectedfile_block .file-name").each(function () {
            var fileName = $(this).text().trim();
            file_names.push(fileName);
        });
        if (file_names.length == 0) {
            toastr.remove();
            toastr.error("Please select atleast one file.");
            return false;
        }
        var obj = [];
        for (var i = 0; i < file_names.length; i++) {
            var data = {
                "employee_id": $("#empid").text(),
                "emp_name": $("#empname").text().trim(),
                "designation_id": $("#designationid").text(),
                "objective_id": objectiveid_emp,
                "kr_id": krid_emp,
                "file_paths_OKR": file_names[i],// Remove semicolon from here,
                "Isactive": 1

            };
            obj.push(data);
        }
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' }, // Assuming '@_tokan' should be replaced by a valid token variable
            url: '@_webapiurlokr' + 'Objectve/SaveOKREmployeeDoc',
            data: JSON.stringify(obj),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                var successCount = 0;
                var failCount = 0;
                var successMessages = [];
                var failMessages = [];

                for (var i = 0; i < response.length; i++) {
                    var currentResponse = response[i];
                    if (currentResponse.responseCode  === 201) {
                        successCount++;
                        successMessages.push(currentResponse.message);
                    } else if (currentResponse.responseCode === 210) {
                        failCount++;
                        failMessages.push("File already exists.");
                    } else if (currentResponse.responseCode === 211) {
                        failCount++;
                        failMessages.push("Maximum limit of 8 files reached.");
                    } else {
                        failCount++;
                        failMessages.push("Failed to upload file.");
                    }
                }

                toastr.remove();

                if (successCount > 0 && failCount === 0) {
                    // All successful uploads
                    toastr.success(successCount + " file(s) uploaded successfully.");
                } else if (failCount > 0 && successCount === 0 && currentResponse.responseCode === 211) {
                    // All failed uploads
                    toastr.error("Maximum limit of 8 files reached.");
                }
                else if (failCount > 0 && successCount === 0 && currentResponse.responseCode === 210) {
                    // All failed uploads
                    toastr.error(failCount + " File already exists.");
                }
                else if(successCount >= 1 && failCount >= 1)
                {
                    toastr.success(successCount + " file(s) uploaded successfully." + failCount + "file(s) failed to upload.");
                }
                else {
                    // Mixed results or single upload
                    if (successCount > 0) {
                        toastr.success(successCount + " file(s) uploaded successfully.");
                    }
                    if (failCount > 0) {
                        toastr.error(failCount + " file(s) failed to upload.");
                    }
                }
                setTimeout(function () {
                    $("#OKRForm").submit();
                }, 1000);
                $('#uploaddocument_modal').modal('toggle');
                getempname(function () {
                    getassignobjectiveKR('@empid', 1);
                });
                var getMonth = new Date().getMonth() + 1;
                if (getMonth.toString().length == 1) {
                    $("#Effectedfrom").val(new Date().getFullYear() + "-0" + getMonth + "-01");
                } else {
                    $("#Effectedfrom").val(new Date().getFullYear() + "-" + getMonth + "-01");
                }
            },
            error: function () {
                $("#ajax_loader").hide();
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }
