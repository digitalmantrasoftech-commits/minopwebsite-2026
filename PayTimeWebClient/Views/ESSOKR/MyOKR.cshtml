    function Gettotalscore(selecteddate) {
        // Show loader before making the AJAX request
        $("#ajax_loader").show();
        $.ajax({
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurlokr' + 'Objectve/GetOKRReviewDetailsEmpwise/' + loginempid + '/' + selecteddate,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response != null && response.length > 0) {
                    var responseObject = response[0]; // First object in the response array
                    var keys = Object.keys(responseObject); // Getting all keys of the object
                    var dynamicColumnName = keys[11]; // Getting the 11th key (0-based index, so 10)
                    var totalScore = responseObject[dynamicColumnName];
                    // Check if totalScore is not null or undefined
                    if (totalScore != null && totalScore !== undefined) {
                        // Bind the totalScore with the percentage symbol
                        $("#ttl_score").text(totalScore);
                    } else {
                        // If totalScore is null or undefined, bind 0 with the percentage symbol
                        $("#ttl_score").text('0');
                    }
                }
            },
            error: function () {
                // Handle the error case
                $("#ajax_loader").hide();
            },
            complete: function () {
                // Hide the loader whether the request is successful or not
                $("#ajax_loader").hide();
            }
        });
    }

