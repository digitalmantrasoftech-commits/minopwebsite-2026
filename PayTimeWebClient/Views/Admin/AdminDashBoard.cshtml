                            var day = date.getDate();
                            _FirstDayWithSlashes = date.getFullYear() + "-" + (month.toString().length > 1 ? month : "0" + month) + "-" + (day.toString().length > 1 ? day : "0" + day);
                        }
                        AdminPiachart(series, FirstDayWithSlashes, lastDayWithSlashes, cmpId, branchId, _FirstDayWithSlashes);
