            if (getDialcode == "91" || getDialcode == "20" || getDialcode == "880" || getDialcode == "1" || getDialcode == "57" || getDialcode == "30" || getDialcode == "44" || getDialcode == "20" || getDialcode == "98" || getDialcode == "964" || getDialcode == "39" || getDialcode == "81" || getDialcode == "7" || getDialcode == "856" || getDialcode == "52" || getDialcode == "977" || getDialcode == "234" || getDialcode == "850" || getDialcode == "92" || getDialcode == "63" || getDialcode == "7" || getDialcode == "82" || getDialcode == "81" || getDialcode == "90" || getDialcode == "58") {
