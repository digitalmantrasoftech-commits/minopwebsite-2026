                            _FirstDayWithSlashes = (day.toString().length > 1 ? day : "0" + day) + "-" + (month.toString().length > 1 ? month : "0" + month) + "-" + date.getFullYear();
                        }
                        else if ("@_isdateformat" == "M-dd-yyyy") {

                            var locale = "en-us";
                            month = date.toLocaleString(locale, { month: "short" });
                            var day = date.getDate();
