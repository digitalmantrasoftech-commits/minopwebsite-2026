        function handleCorrectionClick(empId, attnDate, brId, cmpId, deptId, desgId, shiftId)
        {
            // Encode the employee ID
            var encodedEmpId = encodeURIComponent(empId);
            var encodedBrId = encodeURIComponent(brId);
            var encodedCmpId = encodeURIComponent(cmpId);
            var encodedDeptId = encodeURIComponent(deptId);
            var encodedDesgId = encodeURIComponent(desgId);
            var encodedshiftId = encodeURIComponent(shiftId);

            // Create a form element
            var form = document.createElement("form");
            form.method = "POST";
            form.action = "/Employee/AttendanceCorrection";

            // Create an input element for the employee ID
            var empIdinput = document.createElement("input");
            empIdinput.type = "hidden";
            empIdinput.name = "EmpId";
            empIdinput.value = encodedEmpId;

            // Create an input element for the employee ID
            var cmpIdinput = document.createElement("input");
            cmpIdinput.type = "hidden";
            cmpIdinput.name = "cmpId";
            cmpIdinput.value = encodedCmpId;

            // Create an input element for the branch ID
            var brIdinput = document.createElement("input");
            brIdinput.type = "hidden";
            brIdinput.name = "brId";
            brIdinput.value = encodedBrId;

            // Create an input element for the Department ID
            var deptIdinput = document.createElement("input");
            deptIdinput.type = "hidden";
            deptIdinput.name = "deptId";
            deptIdinput.value = encodedDeptId;

            // Create an input element for the Designation ID
            var desgIdinput = document.createElement("input");
            desgIdinput.type = "hidden";
            desgIdinput.name = "desgId";
            desgIdinput.value = encodedDesgId;

            // Create an input element for the Shift ID
            var shiftIdinput = document.createElement("input");
            shiftIdinput.type = "hidden";
            shiftIdinput.name = "shiftId";
            shiftIdinput.value = encodedshiftId;

            // Create an input element for the attendance date
            var dateInput = document.createElement("input");
            dateInput.type = "hidden";
            dateInput.name = "AttnDate";
            dateInput.value = attnDate;

            // Append the inputs to the form
            form.appendChild(empIdinput);
            form.appendChild(cmpIdinput);
            form.appendChild(brIdinput);
            form.appendChild(deptIdinput);
            form.appendChild(desgIdinput);
            form.appendChild(shiftIdinput);
            form.appendChild(dateInput);

            // Append the form to the body and submit it
            document.body.appendChild(form);
            form.submit();
        }

        function FillMissPunch() {

            $.ajax({
                type: "GET",
