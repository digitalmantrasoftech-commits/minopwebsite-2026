                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function (xhr) {
                    loadingAjax('ajax_loaderAtwork');
                    xhr.setRequestHeader("Authorization", token);
                    setTimeout(delay);
                },
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    $('#ajax_loaderAtwork').hide();
                    $("#_MissPunchCount").html(data[0].Rescnt);
                },
                error: function () {
                    $("#_MissPunchCount").html(0);
                    console.log("FillMissPunch method in admindashboard Get call.", date.toString());
                }
            });
        }

        function FillDesignationwiseChart() {
            let today = new Date();
            let isoDate = today.toISOString().split('T')[0];
            $.ajax({
                type: "GET",
                url: "@_webapiurl" + "DashBoardCustom/GetAdminDashBoardCount_FastTrack",
                data: { cmpId: cmpId, branchId: branchId, fdate: FirstDayWithSlashes, tdate: lastDayWithSlashes, reqid: 20, DepartId: DeptId, DesigId: DesgId, ShiftId: ShiftId },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function (xhr) {
                    loadingAjax('ajax_loaderAtwork');
                    xhr.setRequestHeader("Authorization", token);
                    setTimeout(delay);
                },
                success: function (data) {
                    var _data = [];
                    $("._desChart").html("");
                    //////////// 24-07-2024 Create the chart ////////////
                    const rawData = data;
                    // Process data into series format for Highcharts
                    var seriesData = rawData.reduce(function (acc, item) {
                        var date = new Date(item.Attn_Dt).getTime();
                        var existingSeries = null;

                        // Find existing series by DesignationName
                        for (var i = 0; i < acc.length; i++) {
                            if (acc[i].name === item.DesignationName) {
                                existingSeries = acc[i];
                                break;
                            }
                        }
                        if (existingSeries) {
                            // If the series exists, add the new data point
                            existingSeries.data.push({ x: date, y: item.count, strength: item.TotalStrength });
                        } else {
                            // If the series does not exist, create a new one
                            acc.push({
                                name: item.DesignationName,
                                data: [{ x: date, y: item.count, strength: item.TotalStrength }]
                            });
                        }

                        return acc;
                    }, []);

                    // Sort data points in each series by date
                    for (var j = 0; j < seriesData.length; j++) {

                        seriesData[j].data.sort(function (a, b) {
                            return a.x - b.x;
                        });
                    }

                    Highcharts.chart('container', {
                        chart: {
                            type: 'column'
                        },
                        title: {
                            //align: 'left',
                            text: 'Designation Wise Strength Wise Presence'
                        },
                        accessibility: {
                            announceNewData: {
                                enabled: true
                            }
                        },
                        xAxis: {
                            type: 'datetime',
                            title: {
                                text: 'Date'
                            },
                            labels: {
                                formatter: function () {
                                    // Format the date label
                                    return Highcharts.dateFormat('%Y-%m-%d', this.value);
                                },
                                step: 2 // Ensure that every label is displayed
                            },
                            tickInterval: 96 * 3600 * 1000 // Interval of 1 day (in milliseconds)
                        },
                        yAxis: {
                            title: {
                                text: 'Count'
                            }
                        },
                        legend: {
                            enabled: false
                        },
                        plotOptions: {
                            series: {
                                borderWidth: 0,
                                dataLabels: {
                                    enabled: false,
                                },
                                pointWidth: 25 // Set the width of the columns here (in pixels)
                            }
                        },
                        tooltip: {
                            formatter: function () {
                                var point = this.point;
                                return '<b>' + this.series.name + '</b><br/>Date: ' + Highcharts.dateFormat('%Y-%m-%d', this.x) + '<br/>Count: ' + this.y + '<br/>Total Strength: ' + ((point.strength == null) ? 0 : point.strength);
                            }
                        },
                        colors: [
                            '#31DE6C', // Green
                            '#EE663C', // Orange
                            '#EB76ED', // Pink
                            '#8E7EEE', // Light Purple
                            '#5DA2E8', // Blue
                            '#FCAA6B', // Light Orange
                            '#AAADB2', // Grey
                        ],
                        series: seriesData
                    });
                    //////////// 24-07-2024 Create the chart : End ////////////
                    //if (data.isRedirect) {
                    //    window.location.href = data.redirectUrl;
                    //}
                    //$('#ajax_loaderAtwork').hide();
                    //$("#_MissPunchCount").html(data[0].Rescnt);
                },
                error: function () {
                    $("#_MissPunchCount").html(0);
                    console.log("FillDesignationwiseChart method in admindashboard Get call.", date.toString());
                }
            });
        }
    </script>


