			fillcustomfieldtype(t.row($(this).parent('td').parent('tr')).data()["FieldTypeID"])
			//$("#CustomPageID").val(t.row($(this).parent('td').parent('tr')).data()["CustomPageID"]);
			//fillPage(t.row($(this).parent('td').parent('tr')).data()["SequenceNo"],t.row($(this).parent('td').parent('tr')).data()["CustomPageID"]);
			$('#FieldLabel').val(t.row($(this).parent('td').parent('tr')).data()["FieldLabel"]);
			$("#FieldID").val(t.row($(this).parent('td').parent('tr')).data()["FieldID"]);
			$("#FieldPlaceHolder").val(t.row($(this).parent('td').parent('tr')).data()["FieldPlaceHolder"]);
			//$("#Iscompulsory").val(t.row($(this).parent('td').parent('tr')).data()["Iscompulsory"]);
			$('#Iscompulsory').prop('checked', t.row($(this).parent('td').parent('tr')).data()["Iscompulsory"]);
			//fillSequenceNo(t.row($(this).parent('td').parent('tr')).data()["SequenceNo"], t.row($(this).parent('td').parent('tr')).data()["CustomPageID"]);
			//$('#SequenceNo').val(t.row($(this).parent('td').parent('tr')).data()["SequenceNo"]);
			//$("#CompanyEmail").attr("readOnly", true);
			$(".editclass").attr("data-toggle", "modal");
			$(".editclass").attr("data-target", "#frmpopup");
		});
	});
	function fillcustomfieldtype(selectedfieldtype) {
		$('#FieldTypeID').empty();
		$.ajax(
		 {
			 type: "GET",
			 headers: { 'Authorization': '@_tokan' },
			 url: '@_webapiurl' + "/Master/fieldtypeGetAll",
			 //data: { CountryId: Countryid },
			 contentType: "application/json; charset=utf-8",
			 dataType: "json",
			 beforeSend: function () {
				 //     $(".loading").show();
			 },
			 success: function (data) {
				 if (data.isRedirect) {
					 window.location.href = data.redirectUrl;
				 }
				 //      $(".loading").hide();
				 $("#FieldTypeID").append("<option value=''>Select Field Type</option>");
				 for (var x = 0; x < data.length; x++) {
					 $("#FieldTypeID").append("<option value=" + data[x].FieldTypeID + ">" + data[x].FieldTypeName + "</option>");
				 }
				 $("#FieldTypeID option[value = '" + selectedfieldtype + "' ]").prop('selected', true);
			 },
			 error: function (jqXHR, ajaxOptions, thrownError) {
			     if (jqXHR.status == 500) { //InternalServerError = 500,
			         toastr.error("InternalServerError");
			     } else if (jqXHR.status == 400) { //BadRequest = 400,
			         toastr.error("BadRequest");
			     } else if (jqXHR.status == 401) {
			         window.location.href = "/PayTime/LoginPage";
			     }
			 }
		 });
	}
	function fillPage(selectedSequenceNo,selectedpage) {
		$('#CustomPageID').empty();
		$.ajax(
		 {
			 type: "GET",
			 headers: { 'Authorization': '@_tokan' },
			 url: '@_webapiurl' + "/Master/PageGetAll",
			 contentType: "application/json; charset=utf-8",
			 dataType: "json",
			 beforeSend: function () {
				 //     $(".loading").show();
			 },
			 success: function (data) {
				 if (data.isRedirect) {
					 window.location.href = data.redirectUrl;
				 }
				 //      $(".loading").hide();
				 $("#CustomPageID").append("<option value=''>Select Page</option>");
				 for (var x = 0; x < data.length; x++) {
					 $("#CustomPageID").append("<option value=" + data[x].CustomPageID + ">" + data[x].CustomPageName + "</option>");
				 }
				 $("#CustomPageID option[value = '" + selectedpage + "' ]").prop('selected', true);
				 if (selectedpage != undefined) {
					 if (selectedpage != undefined && selectedSequenceNo != undefined) {
						 //$('#SequenceNo').empty();
						 //fillSequenceNo(selectedSequenceNo, selectedpage);
					 }
					 else {
						 //fillSequenceNo(0, selectedpage);
					 }
				 }
				 //if (selectedpage != undefined && selectedSequenceNo != undefined) {
				 //    $('#SequenceNo').empty();
				 //    fillSequenceNo(selectedSequenceNo, selectedpage);
				 //}

			 },
			 error: function (jqXHR, ajaxOptions, thrownError) {
			     if (jqXHR.status == 500) { //InternalServerError = 500,
			         toastr.error("InternalServerError");
			     } else if (jqXHR.status == 400) { //BadRequest = 400,
			         toastr.error("BadRequest");
			     } else if (jqXHR.status == 401) {
			         window.location.href = "/PayTime/LoginPage";
			     }
			 }
		 });
	}
	function fillSequenceNo(selectedSequenceNo, pageid) {
		$('#SequenceNo').empty();
		if (pageid == "" || pageid == null) {
			pageid = 0;
		}
		$.ajax(
		 {
			 type: "GET",
			 headers: { 'Authorization': '@_tokan' },
			 url: '@_webapiurl' + "/Master/SequenceNoGetAll?pageID=" + pageid + "&selectedSequenceNo=" + selectedSequenceNo + "",
			 contentType: "application/json; charset=utf-8",
			 dataType: "json",
			 beforeSend: function () {
				 //     $(".loading").show();
			 },
			 success: function (data) {
				 if (data.isRedirect) {
					 window.location.href = data.redirectUrl;
				 }
				 //      $(".loading").hide();
				 $("#SequenceNo").append("<option value=''>Select Sequence No</option>");
				 for (var x = 0; x < data.length; x++) {
					 $("#SequenceNo").append("<option value=" + data[x].SequenceNo + ">" + data[x].SequenceName + "</option>");
				 }
				 $("#SequenceNo option[value = '" + selectedSequenceNo + "' ]").prop('selected', true);
			 },
			 error: function (jqXHR, ajaxOptions, thrownError) {
			     if (jqXHR.status == 500) { //InternalServerError = 500,
			         toastr.error("InternalServerError");
			     } else if (jqXHR.status == 400) { //BadRequest = 400,
			         toastr.error("BadRequest");
			     } else if (jqXHR.status == 401) {
			         window.location.href = "/PayTime/LoginPage";
			     }
			 }
		 });
	}
	function frmClear() {
		$("#CustomFieldID").val("");
		$("#FieldTypeID").val("");
		$("#CustomPageID").val("");
		$('#FieldLabel').val("");
		$("#FieldID").val("");
		$("#FieldPlaceHolder").val("");
		$('#Iscompulsory').val("");
		$('#Iscompulsory').prop('checked', false);
		//$('#SequenceNo').val("");
		//$('#SequenceNo').empty();
	}
</script>
