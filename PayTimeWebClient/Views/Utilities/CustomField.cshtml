@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "CustomField";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}

<script type="text/javascript">
	$(document).ready(function () {
		var t = $('#tblCustomFields').DataTable(
	{
		"processing": true,
		"ajax": {
			url: '@_webapiurl' + 'Master/tblCustomFieldGetAllGrid',
			type: "GET",
			headers: { 'Authorization': '@_tokan' },
			dataSrc: '',
		},
		"columns": [
			{ "data": null },
			{ "data": "CustomFieldID" },
			{ "data": "FieldTypeID" },
			{ "data": "FieldID" },
			{ "data": "SequenceNo" },
			{ "data": "CustomPageID" },
			{ "data": "FieldLabel" },
			{ "data": "FieldPlaceHolder" },
			{ "data": "FieldTypeName" },
			{ "data": "CustomPageName" },
			{ "data": "Iscompulsory" },
		],
		"columnDefs": [
			{
				"targets": [1,2,4,5,6,7,9],
				"visible": false
			},
			{
				"targets": 11,
				"data": null,
				"render": function (data, type, full, meta) {
					if ('@obj.CanEdit.ToString()' == 'True') {
					data = "<a class='editclass btn btn-xs blue tooltips' title='Edit'><i class='fa-regular fa-pen-to-square'></i></a";
					}
					else {
					data = "";
					}
					return data;
				}

			},
			{
				"searchable": false,
				"orderable": false,
				"targets": 0
			}],
		"order": [[1, 'asc']],
	}
	);
		t.on('order.dt search.dt', function () {
			t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
				cell.innerHTML = i + 1;
			});
		}).draw();
		$("#Add").on('click', function () {
			$("#FieldLabel").removeClass('field_error');
			$("#FieldID").removeClass('field_error');
			$("#FieldTypeID").removeClass('field_error');
			//$("#CustomPageID").removeClass('field_error');
			//$("#SequenceNo").removeClass('field_error');
			frmClear();
			fillcustomfieldtype()
			//fillPage();
			fillSequenceNo(0, 0);
			$("#Add").attr("data-toggle", "modal");
			$("#Add").attr("data-target", "#frmpopup");
		});
		//$("#CustomPageID").change(function () {
		//	fillSequenceNo(0, $('option:selected', this).val());
		//});
		fillcustomfieldtype();
		//fillPage();
		fillSequenceNo(0, 0);
		$("#FieldLabel").keypress(function (e) {
			$("#FieldLabel").removeClass('field_error');
		})
		$("#FieldID").keypress(function (e) {
			$("#FieldID").removeClass('field_error');
		})
		$("#FieldTypeID").change(function (e) {
			$("#FieldTypeID").removeClass('field_error');
		})
		//$("#CustomPageID").change(function (e) {
		//	$("#CustomPageID").removeClass('field_error');
		//})
		//$("#SequenceNo").change(function (e) {
		//	$("#SequenceNo").removeClass('field_error');
		//})

		$('#btnCreateField').click(function (event) {
			if ($("#FieldLabel").val() == "") {
				$("#FieldLabel").addClass('field_error');
				$("#FieldLabel").focus();
				event.preventDefault();
				return false;
			}
			else {
				$("#FieldLabel").removeClass('field_error');
			}
			if ($("#FieldID").val() == "") {
				$("#FieldID").addClass('field_error');
				$("#FieldID").focus();
				event.preventDefault();
				return false;
			}
			else {
				$("#FieldID").removeClass('field_error');
			}
			if ($("#FieldTypeID").val() == "") {
				$("#FieldTypeID").addClass('field_error');
				$("#FieldTypeID").focus();
				event.preventDefault();
				return false;
			}
			else {
				$("#FieldTypeID").removeClass('field_error');
			}
			//if ($("#CustomPageID").val() == "") {
			//	$("#CustomPageID").addClass('field_error');
			//	$("#CustomPageID").focus();
			//	event.preventDefault();
			//	return false;
			//}
			//else {
			//	$("#CustomPageID").removeClass('field_error');
			//}
			//if ($("#SequenceNo").val() == "") {
			//	$("#SequenceNo").addClass('field_error');
			//	$("#SequenceNo").focus();
			//	event.preventDefault();
			//	return false;
			//}
			//else {
			//	$("#SequenceNo").removeClass('field_error');
			//}

			var obj = {
				CustomFieldID: $('#CustomFieldID').val(),
				FieldTypeID: $("#FieldTypeID").val(),
				//CustomPageID: $("#CustomPageID").val(),
				FieldLabel: $('#FieldLabel').val(),
				FieldID: $('#FieldID').val(),
				FieldClass: 'form-control input-sm',
				FieldPlaceHolder: $('#FieldPlaceHolder').val(),
				Iscompulsory: $("#Iscompulsory").prop('checked')
				//SequenceNo: $("#SequenceNo").val()
			};
			if ($('#CustomFieldID').val() == "0" || $('#CustomFieldID').val() == "") {
				$.ajax({
					type: "POST",
					headers: { 'Authorization': '@_tokan' },
					url: '@_webapiurl' + 'Master/CustomFieldCreate',
					data: JSON.stringify(obj),
					contentType: "application/json; charset=utf-8",
					dataType: "json",
					success: function (response) {
						if (response != null) {
							$("<div class='alert alert-success overlay'><label>" + response.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
							$('#tblCustomFields').DataTable().ajax.reload();
							$('#frmpopup').modal('toggle');
						} else {
							$("<div class='alert alert-danger overlay'><label>" + response.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
							$('#tblCustomFields').DataTable().ajax.reload();
							$('#frmpopup').modal('toggle');
						}
					},
					error: function (response) {
						if (response != null) {
							var obj = JSON.parse(response.responseText);
							if (obj.MegSts == 'error') {
								$("<div class='alert alert-danger overlay'><label>" + obj.Meg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
								$('#tblCustomFields').DataTable().ajax.reload();
								$('#frmpopup').modal('toggle');
							}
						}
					}
