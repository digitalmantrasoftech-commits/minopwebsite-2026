    function fillDeviceSerailNo() {
        $.ajax({
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + "Master/DeviceGetAllGrid?compCode='" + '@_compcode' + "'",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response)
            {

                if (response != null) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    $(".loading").hide();
                    var markup = '';
                    for (var x = 0; x < response.length; x++)
                    {
                        markup += "<option value='" + response[x].DeviceSrNo + "'>" + response[x].DeviceName + " (" + response[x].DeviceSrNo +")"+ "</option>";
                    }
                    var newOption = '<option selected="selected" value="0">Select Device</option>';
                    $('#device_serail_no').html(newOption).append(markup);
                }
            },
            error: function (jqXHR, ajaxOptions, thrownError) {
                $(".loading").hide(); // Hide the loading indicator on error
                switch (jqXHR.status) {
                    case 500: // InternalServerError
                        toastr.error("Internal Server Error");
                        break;
                    case 400: // BadRequest
                        toastr.error("Bad Request");
                        break;
                    case 401: // Unauthorized
                        window.location.href = "/PayTime/LoginPage";
                        break;
                    default:
                        toastr.error("An unexpected error occurred");
                }
            }
        });
    }
