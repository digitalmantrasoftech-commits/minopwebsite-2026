                                            <div class="table-responsive" id="tableResponsive1">
                                                <table id="tblempmaster" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column">
                                                    <thead>
                                                        <tr>
                                                            <th>Punch ID</th>
                                                            <th>Employee Name</th>
                                                            <th>Email</th>
