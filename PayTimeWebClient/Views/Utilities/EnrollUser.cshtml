                        <div class="modal-footer">

                            <!-- First Tab Button -->
                            <div class="row" id="FrstTabBtnDiv" style="display:none;">
                                <div class="editor-field form-group  col-md-12 control-label text-right">
                                    <button class="btn blue btn-sm nextBtn pull-right" type="button" id="frstNext">Next <i class="fa-light fa-angle-right"></i></button>
                                </div>
