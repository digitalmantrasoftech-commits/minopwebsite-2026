    <!-- Datatable Block : End -->
    <!-- Filter Block : Begin -->
    <div class="portlet filter_boxModal">
        <div class="filterbox_header">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="filter-title">Filters</h4>
                <button type="button" class="filterclose_btn"><i class="fa-light fa-xmark"></i></button>
            </div>
        </div>
        <div class="filterbox_body">
            <div class="col-lg-12">
                <div class="form-group">
                    <label for="deviceSrNo" class="control-label">Device Sr No.<span class="required" aria-required="true"> * </span></label>
                    <!-- Add an input field if necessary -->
                    <select id="device_serail_no" class="form-control input-sm select2"></select>
                </div>
            </div>
            <!--<div class="col-lg-12">
            <div class="form-group">
                <label for="punch_id" class="control-label">PunchID<span class="required" aria-required="true"> * </span></label>-->
            <!-- Add an input field if necessary -->
            <!--<select id="punch_id" class="form-control input-sm select2">
                    </select>
                </div>
            </div>-->
            <div class="col-lg-12">
                <div class="form-group">
                    <label for="deviceStatus" class="control-label">Status<span class="required" aria-required="true"> * </span></label>
                    <!-- Add a dropdown or input field if necessary -->
                    <select id="device_status" class="form-control">
                        <option value="">Select status</option>
                        <option value="0">Pending</option>
                        <option value="1">Success</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group data_picker_box">
                    <label class="control-label">From Date<span class="required" aria-required="true"> * </span></label>
                    <div class="input-group input-group-sm date date-picker" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-end-date="0d" data-date-viewmode="years">
                        <span class="input-group-btn">
                            <button class="btn default btn-sm" type="button">
                                <i class="fa-light fa-calendar-days"></i>
                            </button>
                        </span>
                        @if (@_isdateformat == "dd-M-yyyy" || @_isdateformat == "M-dd-yyyy" || @_isdateformat == "yyyy-M-dd")
                        {
                            <input class="form-control" id="from_date" name="from_date" type="text" placeholder="@_isdateformat.Replace("M", "MMM")" autocomplete="off">
                        }
                        else
                        {
                            <input class="form-control" id="from_date" name="from_date" type="text" placeholder="@_isdateformat" autocomplete="off">
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group data_picker_box">
                    <label class="control-label">To Date<span class="required" aria-required="true"> * </span></label>
                    <div class="input-group input-group-sm date date-picker" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-end-date="0d" data-date-viewmode="years">
                        <span class="input-group-btn">
                            <button class="btn default btn-sm" type="button">
                                <i class="fa-light fa-calendar-days"></i>
                            </button>
                        </span>
                        @if (@_isdateformat == "dd-M-yyyy" || @_isdateformat == "M-dd-yyyy" || @_isdateformat == "yyyy-M-dd")
                        {
                            <input class="form-control" id="to_date" name="to_date" type="text" placeholder="@_isdateformat.Replace("M", "MMM")" autocomplete="off">
                        }
                        else
                        {
                            <input class="form-control" id="to_date" name="to_date" type="text" placeholder="@_isdateformat" autocomplete="off">
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="filterbox_footer">
            <div class="text-right">
                <button type="button" id="clear_opration" class="clear_btn tooltips" data-placement="top" data-original-title="Clear Filters" style="display: inline-block;"><i class="fa-regular fa-eraser"></i></button>
                <a href="javascript:void(0)" id="Add" class="btn icon_btn margin-left-5 tooltips" data-placement="top" data-original-title="Assign User"><i class="fa-regular fa-download"></i></a>
                <button type="button" id="search_btn" class="icon_btn margin-left-5 tooltips" data-placement="top" data-original-title="Search Filters" style="display: inline-block;"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
        </div>
    </div>
    <!-- Filter Block : End -->
</div>

<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>
