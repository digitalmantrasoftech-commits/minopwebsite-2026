                                            @*<div class="row">
                                            <div class="col-md-12 control-label text-right">
                                                <hr />
                                                <button class="btn blue btn-sm prevbtn" type="button"><i class="fa-regular fa-angle-left"></i> Prev</button>
                                                <button type="submit" class=" btn btn-sm blue" id="btnEnrollsubmit"> <i class="fa-solid fa-check"></i> Enroll</button>
                                            </div>
