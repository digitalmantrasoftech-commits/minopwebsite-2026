        $("#tblEnrollUsers").on('click', '.verifyEnroll', function () {            
            const table = $('#tblEnrollUsers').DataTable();
            const rowData = table.row($(this).closest('tr')).data();            
            const punchId = rowData.EmpId;
            const deviceSrNo = rowData.DeviceSrNo;
            $.ajax({
                type : "GET",
                url: '@_webapiurl' + "DeviceDemo/VerifyDeviceForEnroll",
                headers: { 'Authorization': '@_tokan' },
                data: { PunchID: punchId, DeviceSerialNumber: deviceSrNo },
                dataType: "json",
                success: function (res) {
                    if (res == "VerifyEnroll command successfully.") {
                        toastr.remove();
                        toastr.success("VerifyEnroll command successfully.");
                    } else if (res == "Employee already Verified.") {
                        toastr.remove();
                        toastr.success(res)
                    } else {
                        toastr.remove();
                        toastr.error(res)
                    }
                },
                error: function () {
                    toastr.error("something wrong occures.");
                }
            })
        });

