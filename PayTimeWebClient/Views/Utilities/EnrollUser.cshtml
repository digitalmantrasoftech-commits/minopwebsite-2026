        $("#search_btn").click(function (event) {
            if ($("#device_serail_no").val() == "0") {
                toastr.remove();
                toastr.error("Please select device.");
                event.preventDefault();
                return false;
            }
            if ($("#device_status").val() == "") {
                $("#device_status").addClass('field_error');
                event.preventDefault();
                return false;
            }
            if ($("#from_date").val() == "") {
                $("#from_date").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            if ($("#to_date").val() == "") {
                $("#to_date").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            var filFrmDate = $("#from_date").val();
            var filToDate = $("#to_date").val();

            var isDateFormat = "@_isdateformat";

            if ("@_isdateformat" == "dd-mm-yyyy") {
                isDateFormat = "DD-MM-YYYY"
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                isDateFormat = "MM-DD-YYYY"
            }
            else if ("@_isdateformat" == "yyyy-mm-dd") {
                isDateFormat = "YYYY-MM-DD"
            }
            else if ("@_isdateformat" == "yyyy-M-dd") {
                isDateFormat = "YYYY-MMM-DD"
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {
                isDateFormat = "MMM-DD-YYYY"
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {
                isDateFormat = "DD-MMM-YYYY"
            }

            var frmDateMoment =moment(filFrmDate,isDateFormat);
            var toDateMoment =moment(filToDate,isDateFormat);


            if (frmDateMoment > toDateMoment) {
                toastr.remove("");
                toastr.error("From date should be greater than to date.");
                return false;
            }
            var FromDate = moment(filFrmDate,isDateFormat).format("YYYY-MM-DD");;
            var ToDate = moment(filToDate,isDateFormat).format("YYYY-MM-DD");;
            var obj =
            {
                "DeviceSerialNumber": $("#device_serail_no").val(),
                "DeviceStatus": $("#device_status").val(),
                "FromDate": FromDate,
                "ToDate": ToDate,
                "PunchID": 0,
                "flag":1
            }
            $("#NotificationGrid-empty1").hide();
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").show();
            }
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");
            tableGet(obj);
            renderDownloadButton();
