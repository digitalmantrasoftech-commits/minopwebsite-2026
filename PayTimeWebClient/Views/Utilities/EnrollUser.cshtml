                                                            <th style="align-content:center"><input type="checkbox" id="selectall"> </th>
                                                        </tr>
                                                    </thead>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @*<div class="row">
                                <div class="col-md-12 control-label text-right">
                                    <hr />
                                    <button class="btn blue btn-sm prevbtn" type="button"><i class="fa-regular fa-angle-left"></i> Prev</button>&nbsp;
                                    <button class="btn blue btn-sm nextBtn pull-right" type="button" id="SecondNext">Next<i class="fa-light fa-angle-right"></i></button>
                                </div>
                            </div>*@
                            </div>
                            <div class="setup-content" id="s-3">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="table-responsive" id="tableResponsive2">
                                            <table class="table new_datatbl table-striped table-bordered table-hover order-column" id="tbldevice">
                                                <thead>
