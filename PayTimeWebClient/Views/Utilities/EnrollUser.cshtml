        function fillemp() {
            var branchid = $('#ddlBranch').val();
            var cmpid = $('#ddlcompany').val();
            var statusid = $('#ddlStatus').val();
            var SelectedDepartmentID = [];

            $('#ddlDepartmentID :selected').each(function ()
            {
                if (SelectedDepartmentID == "") {
                    SelectedDepartmentID = $(this).val();
                }
                else {
                    SelectedDepartmentID += "," + $(this).val();
                }
            });
            if (SelectedDepartmentID.length == 0)
            {
                SelectedDepartmentID = "";
            }
            let isSelectedAll = $("#ddlDepartmentIDContainer li").hasClass("multiselect-item multiselect-all active") == true ? 1 : 0;

            let searchTerm = "";
            if ($("#ddlDepartmentIDContainer li input").hasClass("multiselect-search")) {
                searchTerm = $("#ddlDepartmentIDContainer li .multiselect-search").val().trim();
            }
            if (isSelectedAll) {
                SelectedDepartmentID = "";
                if (searchTerm.length > 0) {
                    SelectedDepartmentID = "0"
                }
            }
            var mainObj =
            {
                "SelectAll": isSelectedAll,
                "SelectAllSearchTerm": searchTerm,
                "BranchId": branchid,
                "CmpId": cmpid,
                "StatusId": statusid,
                "DptId": SelectedDepartmentID,
                "DataGridValues": DataGridThreSold,
                "webapiurl" : '@_webapiurl',
                "tokan": '@_tokan',
                "pageSize": "10",
                "page" : "1"
            };
            LoadEnrollUserGridData(1,mainObj)
        }

