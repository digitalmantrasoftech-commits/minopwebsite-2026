        function fillbranch(selectedcompanyid) {

            $('#ddlBranch').empty();
            var empid = '@_empid';

            if (emprole !=  6806) {
                var _url = '@_webapiurl' + "Master/BranchGetAll";
            }
            else{
                if (empid != 0)
                {
                    var  _url =  "/MasterData/GetBranchlist?CompanyID=" + selectedcompanyid + "&Empid=" + empid;
                }
                else{
                    var  _url =  "/MasterData/FillBranchbyChange?id=" + selectedcompanyid ;
                }
            }
            $.ajax(
                {
                    type: "GET",
                    headers: { 'Authorization': '@_tokan' },

                    // url: '@_webapiurl' + "Master/BranchGetAll",
                    // url :  "/MasterData/GetBranchlist?CompanyID=" + companyid + "&Empid=" + empid,
                    url : _url,
                    dataType: "json",
                    beforeSend: function () {
                    },
                    success: function (data) {

                        if (data.isRedirect) {
                            window.location.href = data.redirectUrl;
                            return; // Stop further execution if redirected
                        }
                        $("#ddlBranch").append("<option value='0'>Select Branch</option>");

                        // Sort the branches alphabetically by BranchName
                        //data.sort(function (a, b) {
                        //    return a.BranchName.localeCompare(b.BranchName); // Correct sorting based on BranchName
                        //});

                        $("#ddlBranch").append("<option value='-1'>All Branch</option>");
                        var _cmpid = 0;

                        for (var x = 0; x < data.length; x++) {
                            if (selectedcompanyid != '0') { // Only append branches if a specific company is selected
                                if('@_RoleId' == 1 || '@_RoleId' == 6805 )
                                {
                                    $("#ddlBranch").append("<option value='" + data[x].BranchId + "'>" + data[x].branchname + "</option>");
                                }
                                else if( '@_RoleId' == 6806 ){
                                    $("#ddlBranch").append("<option value='" + data[x].BranchId + "'>" + data[x].BranchName + "</option>");
                                }
                                else
                                {
                                    $("#ddlBranch").append("<option value='" + data[x].BranchId + "'>" + data[x].BranchName + "</option>");
                                }
                                _cmpid = data[x].CompanyID; // Track the matching company ID
                            }
                        }
                        if (_cmpid == selectedcompanyid || selectedcompanyid == '-1') {
                            $("#ddlBranch option[value='-1']").prop('selected', true);
                        } else if (_cmpid == '0') {
                            // Hide "All Branch" option if no matching company was found
                            $("#ddlBranch option[value='-1']").hide();
                        }
                    },

                    error: function (jqXHR, ajaxOptions, thrownError) {
                        if (jqXHR.status == 500) { //InternalServerError = 500,
