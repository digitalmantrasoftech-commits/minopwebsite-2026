                            <!-- Second Tab Button -->
                            <div class="row" id="SecondTabBtnDiv" style="display:none;">
                                <div class="col-md-12 control-label text-right">
                                    <button class="btn prev_btn prevbtn" type="button" id="Secondprev"><i class="fa-regular fa-angle-left"></i> Prev</button>&nbsp;
                                    <button class="btn blue btn-sm nextBtn pull-right" type="button" id="SecondNext">Next <i class="fa-light fa-angle-right"></i></button>
                                </div>
