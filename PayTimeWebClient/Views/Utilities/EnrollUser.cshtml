        function filldevice(selectedDept) {
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "Master/DeviceGetAllGrid?compCode='" + '@_compcode' + "'",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {

                    if (response != null) {
                        var table = "";
                        var tbl = "";
                        $('#s-3 #dataTables_tbl_header').remove();

                        for (var i = 0; i < response.length; i++)
                        {

                            var flag = response[i].DeviceTypeCode == 39 ? 1 : 0;

                            DeviceFlags.push(
                            {
                                DeviceTypeCode: response[i].DeviceTypeCode,
                                Flag: flag,
                                deviceSrno:response[i].DeviceSrNo
                            });

                            if (response[i].DeviceTypeCode == 34 && response[i].DeviceStatus == 'Online')
                            {

                                tbl = tbl + "<tr class='odd gradeX'>";
                                tbl = tbl + "<td  hidden>" + response[i].DeviceId + "</td>";
                                tbl = tbl + "<td>" + response[i].DeviceName + "</td>";
                                tbl = tbl + "<td>" + response[i].DeviceSrNo + "</td>";
                                if (selectedDept.length != 0) {
                                    var re = new RegExp("(^|,)" + response[i].DeviceId + "($|,)");
                                    if (re.test(selectedDept) == true) {
                                        tbl = tbl + "<td><input type='checkbox' class='ClsChkDevice' id='chk_" + response[i].DeviceId + "' checked/></td>";
                                    }
                                    else {
                                        tbl = tbl + "<td><input type='checkbox' class='ClsChkDevice' id='chk_" + response[i].DeviceId + "'/></td>";
                                    }
                                }
                                else {
                                    tbl = tbl + "<td><input type='checkbox' class='ClsChkDevice' id='chk_" + response[i].DeviceId + "'/></td>";
                                }
                                tbl = tbl + "</tr>";

                            }
                            else if (response[i].DeviceTypeCode == 37) {

                                tbl = tbl + "<tr class='odd gradeX'>";
                                tbl = tbl + "<td  hidden>" + response[i].DeviceId + "</td>";
                                tbl = tbl + "<td>" + response[i].DeviceName + "</td>";
                                tbl = tbl + "<td>" + response[i].DeviceSrNo + "</td>";
                                if (selectedDept.length != 0) {
                                    var re = new RegExp("(^|,)" + response[i].DeviceId + "($|,)");
                                    if (re.test(selectedDept) == true) {
                                        tbl = tbl + "<td><input type='checkbox' class='ClsChkDevice' id='chk_" + response[i].DeviceId + "' checked/></td>";
                                    }
                                    else {
                                        tbl = tbl + "<td><input type='checkbox' class='ClsChkDevice' id='chk_" + response[i].DeviceId + "'/></td>";
                                    }
                                }
                                else {
                                    tbl = tbl + "<td><input type='checkbox' class='ClsChkDevice' id='chk_" + response[i].DeviceId + "'/></td>";
                                }
                                tbl = tbl + "</tr>";
                            }
                            else if (response[i].DeviceTypeCode == 39) {

                                tbl = tbl + "<tr class='odd gradeX'>";
                                tbl = tbl + "<td  hidden>" + response[i].DeviceId + "</td>";
                                tbl = tbl + "<td>" + response[i].DeviceName + "</td>";
                                tbl = tbl + "<td>" + response[i].DeviceSrNo + "</td>";
                                if (selectedDept.length != 0) {
                                    var re = new RegExp("(^|,)" + response[i].DeviceId + "($|,)");
                                    if (re.test(selectedDept) == true) {
                                        tbl = tbl + "<td><input type='checkbox' class='ClsChkDevice' id='chk_" + response[i].DeviceId + "' checked/></td>";
                                    }
                                    else {
                                        tbl = tbl + "<td><input type='checkbox' class='ClsChkDevice' id='chk_" + response[i].DeviceId + "'/></td>";
                                    }
                                }
                                else {
                                    tbl = tbl + "<td><input type='checkbox' class='ClsChkDevice' id='chk_" + response[i].DeviceId + "'/></td>";
                                }
                                tbl = tbl + "</tr>";
                            }
                        }
                        table += tbl;
                        $("#tbldevice").destroy;
                        $('#tbldevice').append(table);

                        $('#tbldevice').dataTable({
                            dom: _domCommon,
                            language: _languageCommon,
                            searching: true,
                            paging: false,
                            "columnDefs": [
                                {
                                    "targets": [0],
                                    "visible": false,
                                    "searchable": false,
                                },
                                {
                                    "targets": 3,
                                    orderable: false,
                                }


                            ],
                            "fnDrawCallback": function (oSettings) {
                                $("#selectallD").prop('checked', false)
                            },
                            "destroy": true,
                            "bInfo": false,
                            "bPaginate": false,
                            "bLengthChange": false,
                            "columns": [
                                { "data": "DeviceId" },
                                { "data": "DeviceName" },
                                { "data": "DeviceSrNo" },
                            ],
                            "order": [[1, 'asc']],
                        });
                        setTimeout(function () {
                            $("#" + "tbldevice" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive2"));
                            $('.tooltips').tooltip();
                        }, 100);
                    }
                },

                beforeSend: function () {
                    //$(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
