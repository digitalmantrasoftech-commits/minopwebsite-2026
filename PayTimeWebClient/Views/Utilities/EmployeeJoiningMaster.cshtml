@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "EmployeeJoiningMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _EmpId = Convert.ToInt32(HttpContext.Current.Session["EmpId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _PlanId = HttpContext.Current.Session["planId"].ToString();
    string _lockAttendanceDay = HttpContext.Current.Session["lockAttendanceDay"].ToString();
    //int _lockAttendance_Day = Convert.ToInt32(HttpContext.Current.Session["lockAttendanceDay"]);

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
      ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
      : "false"; // Default to "false" if the session is null
}
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<script>
    var count = 0;
    var form = "Attendance Details";
    var operation = "";
    var pkloginemployeeid = '@_EmpId';
    var emprole = '@_RoleId';
    var tblempjoinlist = "";

    $(document).ready(function () {

        GetAttndancelist()
        timeMeInitialize();

        var dateyear = new Date().getFullYear();
        var lastyear = dateyear - 2;
        for (var i = lastyear; i <= dateyear; i++) {
            if (i != dateyear) {
                $('#Select_year').append("<option value=" + i + ">" + i + "</option>");
            }
            else {
                $('#Select_year').append('<option value="' + i + '" selected>' + i + '</option>');
            }
        }
        var datemonth = new Date().getMonth() + 1;
        $('#Select_month').val(datemonth);


        function GetAttndancelist() {
            var _status = $("#Select_status").val();
            if (_status == "" || _status == null) {
                _status = '0';
            }


            var currentDate = new Date();
            if ($('#Select_month').val() != "0") {
                currentMonth = $('#Select_month').val();
            }
            else {
                currentMonth = currentDate.getMonth() + 1;
            }
            if ($('#Select_year').val() != "0") {
                currentYear = $('#Select_year').val();
            }
            else {
                currentYear = currentDate.getFullYear();
            }

            var obj = {
                status: _status,
                Year: currentYear,
                Month: currentMonth,
                RoleID: emprole
            };
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            $.ajax({
                url: '@_webapiurl' + 'Utility/GetmonthlyEmp',
                type: 'POST',
                headers: { 'Authorization': '@_tokan' },
                data: JSON.stringify(obj),
                contentType: "application/json",
                dataType: "json",
                async: false,
                beforeSend: function (xhr) {
                    $("#ajax_loader").show();
                },
                success: function (data) {
                    if (data.length == 0) {
                        const wrapper = $(".filter_portlet_wrapper");
                        wrapper.removeClass("full-width");
                    }
                    if (data != null) {
                        const list = data;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", list, {
                            imageUrl: "emptyscreen_3.png",
                            subText: "No matching records found for the selected filters."
                        });
                    }
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                        return;
                    }

                    var columns = [
                        { title: "Empcode", data: "Empcode" },
                        { title: "EmpName", data: "EmpName" },
                        { title: "PunchID", data: "PunchID" },
                        { title: "EmailID", data: "EmailID" },
                        { title: "Company", data: "Company" },
                        { title: "Branch", data: "Branch" },
                        { title: "Department", data: "Department" },
                        { title: "Designation", data: "Designation" }
                    ];

                    if (_status == 1) {
                        columns.push({ title: "EmpJoinDate", data: "EmpJoinDate" });
                    } else {
                        columns.push({ title: "EmpResignDate", data: "EmpResignDate" });
                    }

                    $("#tblempjoinlist").empty();

                    $("#dataTables_tbl_header").remove();
                    // Initialize DataTable
                    var tblempjoinlist = $("#tblempjoinlist").DataTable({
                        destroy: true,
                        //dom: 'lBfrtip',
                        dom: _domCommon,
                        language: _languageCommon,
                        buttons: [
                            { extend: 'excelHtml5' }
                        ],
                        lengthMenu: [
                            //[100, 50, 25, 10],
                            //[100, 50, 25, 10]
                            [10, 25, 50, 100],
                            [10, 25, 50, 100]
                        ],
                        data: data,
                        columns: columns,
                        //columnDefs: [
                        //    {
                        //        targets: 0,
                        //        render: function (data, type, row, meta) {
                        //            return meta.row + 1;
                        //        }
                        //    }
                        //],
                    });
                    setTimeout(function () {
                        $("#" + "tblempjoinlist" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                        $('.tooltips').tooltip();
                    }, 100);

                    $("#ajax_loader").hide();
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                    $("#ajax_loader").hide();
                }
            });
        }


        $("#Search_OPration").click(function () {
            if ($("#Select_month").val() == 0) {
                $("#Select_month").addClass('field_error');
                toastr.remove();
                toastr.error("Please select month.");
            } else if ($("#Select_year").val() == 0) {
                $("#Select_month").removeClass('field_error');
                $("#Select_year").addClass('field_error');
                toastr.remove();
                toastr.error("Please select year.");
            }
            else {
                $("#Select_year").removeClass('field_error');
                $("#Select_month").removeClass('field_error');
                GetAttndancelist();
            }

            const visibleTable = $('table:visible').attr('id');
            $("#buttons").append(`
            <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
            </div>
        `);
            var $exportButtons = $('[id="export-button"]');
            if ($exportButtons.length > 1) {
                $exportButtons.slice(1).remove();
            }
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").show();
            }
        });

        $("#Clear_OPration").click(function () {
            $("#Select_month").val('0');
            $("#Select_year").val('0');
            $("#Select_status").val('0');
            $("#Select_Employee").val('0');
            $SelectEmployee.multiselect('rebuild');
            $('#tblempjoinlist').dataTable().fnClearTable();
            $("#dataTables_tbl_header").remove();
        });

        //$("#Filter_search").click(function () {
        //    $("#filter_open_div").toggle();
        //});

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

    });

</script>
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == " True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard" )"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Employee Joining</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Employee Joining</span>
            </li>
        </ul>
    }

    <div class="page-toolbar text-right">
        <a href="javascript:;" class="btn icon_transparent_btn tooltips" id="Filter_search" data-placement="left" data-original-title="Filter" data-toggle="tooltip"><i class="fa-light fa-filter" aria-hidden="true"></i> </a>
    </div>
</div>
