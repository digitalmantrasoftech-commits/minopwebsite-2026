                <div class="portlet-body">
                    <div class="row">
                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                            <div class="form-group margin-0">
                                <label>Select Category<span class="required" aria-required="true"> * </span></label>
                                <select class="form-control input-sm select2" id="ddlClassMaster" name="ddlClassMaster">
                                    <option value="0" selected>Select Category</option>
                                    <option value="1">Company</option>
                                    <option value="2">Branch</option>
                                    <option value="3">Department</option>
                                    <option value="4">Designation</option>
                                    <option value="5" id="Importemployeeid">Employee</option>
                                </select>
                            </div>
                        </div>
                        <input type="hidden" name="compcode" id="compcode">
                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12" id="ddlCompany_block" style="display:none;">
                            <div class="form-group margin-0">
                                <label>Select Company<span class="required" aria-required="true"> * </span></label>
                                <select class="form-control input-sm select2" id="ddlCompany" name="ddlCompany">
                                    <option value="0" selected>Select Company</option>
                                    @if (ViewBag.CompanyList != null && ((IEnumerable<SelectListItem>)ViewBag.CompanyList).Any())
                                    {
                                        foreach (var item in ViewBag.CompanyList as IEnumerable<SelectListItem>)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                    </select>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12" hidden>
                            <div class="form-group margin-0">
                                <label>Select Branch<span class="required" aria-required="true"> * </span></label>
                                <select class="form-control input-sm select2" id="ddlBranch" name="ddlBranch">
                                    <option value="0" selected>Select Branch</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                            <div class="form-group margin-0">
                                <label>Select File<span class="required" aria-required="true"> * </span></label>
                                <div class="fileinput fileinput-new" data-provides="fileinput">
                                    <div class="input-group">
                                        <div class="form-control uneditable-input input-fixed input" data-trigger="fileinput">
                                            <i class="fa-light fa-file"></i>&nbsp;
                                            <span class="fileinput-filename"> </span>
                                        </div>
                                        <span class="input-group-addon btn blue btn-file">
                                            <span class="fileinput-new"> Select File </span>
                                            <span class="fileinput-exists"> Change </span>
                                            <input type="file" name="FileUpload" id="FileUpload">
                                        </span>
                                        <a href="javascript:;" class="input-group-addon btn red fileinput-exists" data-dismiss="fileinput"> Remove </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <hr class="save_hr_line" />
                        </div>
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-10">
                                    <div class="row sample_sheet_box">
                                        <div class="col-lg-9">
                                            <p>Download the attached sample CSV, which can be used as a template to import your data into the application</p>
                                        </div>
                                        <div class="col-lg-3">
                                            <a class="btn green-dark linkexcel"></a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-2 text-right">
                                    @if (obj.CanAdd)
                                    {
                                        <button type="submit" id="btnImport" class="btn save_btn"><i class="fa-regular fa-upload"></i> Import</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <!-- Employee Datatable-->
                <div class="portlet" id="gridEmployee" style="display:none;">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <div id="tblempty">
                                    <div class="table-responsive" id="tableResponsiveEmployee">
                                        <table id="tblEmployeeMaster" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column" style="display:none">
                                            <thead>
                                                <tr>
                                                    <th hidden>Sr ID</th>
                                                    <th>Startdate</th>
                                                    <th>Status</th>
                                                    <th hidden>CreatedDtFlag</th>
                                                    <th hidden>Err</th>
                                                    <th>View Error List</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                                <div id="NotificationGrid-empty" style="display: none">
                                    <div class="datanotfound">
                                        <img src="" width="280" height="148" alt="Nodata Found Icon">
                                        <p class="datanotfound_title"></p> <!-- titleText -->
                                        <p class=""></p><!-- subText -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Company Datatable-->
                <div class="portlet" id="gridCompany" style="display: none;">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <div id="tblempty1">
                                    <div class="table-responsive" id="tableResponsiveCompany">
                                        <table id="tblCompanyMaster" class="table  new_datatbl table-striped table-bordered table-hover table-checkable order-column" style="display: none;">
                                            <thead>
                                                <tr>
                                                    <th style="display:none;">Sr No.</th>
                                                    <th>Startdate</th>
                                                    <th>Status</th>
                                                    <th hidden>CreatedDtFlag</th>
                                                    <th hidden>Err</th>
                                                    <th>View Error List</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                                <div id="NotificationGrid-emptyCompany" style="display: none">
                                    <div class="datanotfound">
                                        <img src="" width="280" height="148" alt="Nodata Found Icon">
                                        <p class="datanotfound_title"></p> <!-- titleText -->
                                        <p class=""></p><!-- subText -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Branch Datatable-->
                <div class="portlet" id="gridBranch" style="display:none;">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <div id="tblempty2">
                                    <div class="table-responsive" id="tableResponsiveBranch">
                                        <table id="tblBranchMaster" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column" style="display: none;">
                                            <thead>
                                                <tr>
                                                    <th style="display:none;">Sr No.</th>
                                                    <th>Startdate</th>
                                                    <th>Status</th>
                                                    <th hidden>CreatedDtFlag</th>
                                                    <th hidden>Err</th>
                                                    <th>View Error List</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                                <div id="NotificationGrid-emptyBranch" style="display: none">
                                    <div class="datanotfound">
                                        <img src="" width="280" height="148" alt="Nodata Found Icon">
                                        <p class="datanotfound_title"></p> <!-- titleText -->
                                        <p class=""></p><!-- subText -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Department Datatable-->
                <div class="portlet" id="gridDepartment" style="display:none;">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <div id="tblempty3">
                                    <div class="table-responsive" id="tableResponsiveDepartment">
                                        <table id="tblDepartmentMaster" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column" style="display:none">
                                            <thead>
                                                <tr>
                                                    <th style="display:none;">Sr ID</th>
                                                    <th>Startdate</th>
                                                    <th>Status</th>
                                                    <th hidden>CreatedDtFlag</th>
                                                    <th hidden>Err</th>
                                                    <th>View Error List</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                                <div id="NotificationGrid-emptyDep" style="display: none">
                                    <div class="datanotfound">
                                        <img src="" width="280" height="148" alt="Nodata Found Icon">
                                        <p class="datanotfound_title"></p> <!-- titleText -->
                                        <p class=""></p><!-- subText -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Designation Datatable-->
                <div class="portlet" id="gridDesignation" style="display:none;">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <div id="tblempty4">
                                    <div class="table-responsive" id="tableResponsiveDesignation">
                                        <table id="tblDesignationMaster" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column" style="display:none">
                                            <thead>
                                                <tr>
                                                    <th style="display:none;">Sr ID</th>
                                                    <th>Startdate</th>
                                                    <th>Status</th>
                                                    <th hidden>CreatedDtFlag</th>
                                                    <th hidden>Err</th>
                                                    <th>View Error List</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                                <div id="NotificationGrid-emptyDes" style="display: none">
                                    <div class="datanotfound">
                                        <img src="" width="280" height="148" alt="Nodata Found Icon">
                                        <p class="datanotfound_title"></p> <!-- titleText -->
                                        <p class=""></p><!-- subText -->
