@model PayTimeWebClient.Models.Importfaillog
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "ImportEmployeeExcel";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _flgempover = ViewBag.flgempover;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    if (_flgempover == "true")
    {
        obj.CanAdd = false;
    }
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _compcode = HttpContext.Current.Session["cmpcode"].ToString();
    string _CheckBestsellerCustomClient = ConfigurationManager.AppSettings["BestSeller"].ToString();
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
}
<style>
    .progress {
        position: relative;
        height: 15px;
        background-color: #e9ecef;
    }

    .progress-bar {
        height: 100%;
        background-color: #5C95FF;
        border-radius: 3px !important;
    }
</style>
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/AssetsNew/js/exportexcel.js"></script>
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<script type="text/javascript">
    var hrefValue = "";
    var linkText = "";
    var linkerrtext = "";
    var tempclass = "";
    var activeTableId = "";
    var interval = "";
    var compcode = '@_compcode';
    var userid = '@_UserId';
    var dbName = '@_dbName';
    var customclientName = '@_CheckBestsellerCustomClient';

    $(document).ready(function () {
        window.history.replaceState(null, null, window.location.href);
        if ("@_Message" != "") {
            toastr.remove();
            toastr.success("@_Message");
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
        }
        tempclass = "@TempData["ddlClassMaster"]";
        $("#compcode").val('@_compcode');
        if (tempclass != null &&  tempclass != "") {
            $("#ddlClassMaster").val(tempclass);
        }
        $("#gridEmployee, #gridCompany, #gridBranch, #gridDepartment, #gridDesignation").hide();
        ["#tblEmployeeMaster", "#tblCompanyMaster", "#tblBranchMaster", "#tblDepartmentMaster", "#tblDesignationMaster"].forEach(function (table) {
            if ($.fn.dataTable.isDataTable(table)) {
                $(table).DataTable().destroy();
                $(table + " tbody").empty();
            }
        });
        $("#ddlCompany_block").hide();
        var classValue = $("#ddlClassMaster").val();
        if (classValue === "5") {
            $("#ddlCompany_block").show();
            $("#gridEmployee").show();
            $("#gridCompany, #gridBranch, #gridDepartment, #gridDesignation").hide();
            ["#tblCompanyMaster", "#tblBranchMaster", "#tblDepartmentMaster", "#tblDesignationMaster"].forEach(function (table) {
                if ($.fn.dataTable.isDataTable(table)) {
                    $(table).DataTable().destroy();
                    $(table + " tbody").empty();
                }
            });
            generateEmployeegriddata(userid);
            generateprogressdata(classValue);
        }
        else if (classValue === "1") {
            $("#ddlCompany_block").hide();
            $("#gridCompany").show();
            $("#gridEmployee, #gridBranch, #gridDepartment, #gridDesignation").hide();
            ["#tblEmployeeMaster", "#tblBranchMaster", "#tblDepartmentMaster", "#tblDesignationMaster"].forEach(function (table) {
                if ($.fn.dataTable.isDataTable(table)) {
                    $(table).DataTable().destroy();
                    $(table + " tbody").empty();
                }
            });
            generateCompanygriddata(userid);
            generateprogressdata(classValue);
        }
        else if (classValue === "2") {
            $("#ddlCompany_block").hide();
            $("#gridBranch").show();
            $("#gridEmployee, #gridCompany, #gridDepartment, #gridDesignation").hide();
            ["#tblEmployeeMaster", "#tblCompanyMaster", "#tblDepartmentMaster", "#tblDesignationMaster"].forEach(function (table) {
                if ($.fn.dataTable.isDataTable(table)) {
                    $(table).DataTable().destroy();
                    $(table + " tbody").empty();
                }
            });
            generateBranchgriddata(userid);
            generateprogressdata(classValue);

        }
        else if (classValue === "3") {
            $("#ddlCompany_block").hide();
            $("#gridDepartment").show();
            $("#gridEmployee, #gridCompany, #gridBranch, #gridDesignation").hide();
            ["#tblEmployeeMaster", "#tblCompanyMaster", "#tblBranchMaster", "#tblDesignationMaster"].forEach(function (table) {
                if ($.fn.dataTable.isDataTable(table)) {
                    $(table).DataTable().destroy();
                    $(table + " tbody").empty();
                }
            });
            generateDepartmentgriddata(userid);
            generateprogressdata(classValue);
        }
        else if (classValue === "4") {
            $("#ddlCompany_block").hide();
            $("#gridDesignation").show();
            $("#gridEmployee, #gridCompany, #gridBranch, #gridDepartment").hide();
            ["#tblEmployeeMaster", "#tblCompanyMaster", "#tblBranchMaster", "#tblDepartmentMaster"].forEach(function (table) {
                if ($.fn.dataTable.isDataTable(table)) {
                    $(table).DataTable().destroy();
                    $(table + " tbody").empty();
                }
            });
            generateDesignationgriddata(userid);
            generateprogressdata(classValue);
        }
        linkText = "Select a Class to Download Sample Sheet";
        $("a.linkexcel").attr("href", hrefValue).append('<i class="fa-regular fa-file-excel"></i> ' + linkText);
        $("#ddlClassMaster").change(function () {
            $("#gridEmployee, #gridCompany, #gridBranch, #gridDepartment, #gridDesignation").hide();
            var classMasterValue = $("#ddlClassMaster").val();
            if (classMasterValue == "5") {
                $("#ddlCompany_block").show();
                $("#gridEmployee").show();
                $("#gridCompany, #gridBranch, #gridDepartment, #gridDesignation").hide();
                ["#tblCompanyMaster", "#tblBranchMaster", "#tblDepartmentMaster", "#tblDesignationMaster"].forEach(function (table) {
                    if ($.fn.dataTable.isDataTable(table)) {
                        $(table).DataTable().destroy();
                        $(table + " tbody").empty();
                    }
                });
                generateEmployeegriddata(userid);
                generateprogressdata(classMasterValue);
            }
            else if (classMasterValue == "1") {
                $("#ddlCompany_block").hide();
                $("#ddlCompany_block").hide();
                $("#gridCompany").show();
                $("#gridEmployee, #gridBranch, #gridDepartment, #gridDesignation").hide();
                ["#tblEmployeeMaster", "#tblBranchMaster", "#tblDepartmentMaster", "#tblDesignationMaster"].forEach(function (table) {
                    if ($.fn.dataTable.isDataTable(table)) {
                        $(table).DataTable().destroy();
                        $(table + " tbody").empty();
                    }
                });
               generateCompanygriddata(userid);
                generateprogressdata(classMasterValue);
            }
            else if (classMasterValue == "2") {
                $("#ddlCompany_block").hide();
                $("#gridBranch").show();
                $("#gridEmployee, #gridCompany, #gridDepartment, #gridDesignation").hide();
                ["#tblEmployeeMaster", "#tblCompanyMaster", "#tblDepartmentMaster", "#tblDesignationMaster"].forEach(function (table) {
                    if ($.fn.dataTable.isDataTable(table)) {
                        $(table).DataTable().destroy();
                        $(table + " tbody").empty();
                    }
                });
                generateBranchgriddata(userid);
                generateprogressdata(classMasterValue);
            }
            else if (classMasterValue == "3") {
                $("#ddlCompany_block").hide();
                $("#gridDepartment").show();
                $("#gridEmployee, #gridCompany, #gridBranch, #gridDesignation").hide();
                ["#tblEmployeeMaster", "#tblCompanyMaster", "#tblBranchMaster", "#tblDesignationMaster"].forEach(function (table) {
                    if ($.fn.dataTable.isDataTable(table)) {
                        $(table).DataTable().destroy();
                        $(table + " tbody").empty();
                    }
                });
                generateDepartmentgriddata(userid);
                generateprogressdata(classMasterValue);
            }
            else if (classMasterValue == "4") {
                $("#ddlCompany_block").hide();
                $("#gridDesignation").show();
                $("#gridEmployee, #gridCompany, #gridBranch, #gridDepartment").hide();
                ["#tblEmployeeMaster", "#tblCompanyMaster", "#tblBranchMaster", "#tblDepartmentMaster"].forEach(function (table) {
                    if ($.fn.dataTable.isDataTable(table)) {
                        $(table).DataTable().destroy();
                        $(table + " tbody").empty();
                    }
                });
                generateDesignationgriddata(userid);
                generateprogressdata(classMasterValue);
            }
            else {
                $("#ddlCompany_block").css("display", "none");
            }
            hrefValue = $('a.btn.green-dark').attr('href');
            if (hrefValue != "") {
                $("a.btn.green-dark").attr("href", "").append('<i class="fa-regular fa-file-excel"></i> ' + "");
            }
            switch (classMasterValue) {
                case "1":
                    hrefValue = "/SampleXlFile/Company.xls";
                    linkText = "Company Sample Sheet";
                    break;
                case "2":
                    hrefValue = "/SampleXlFile/Branch.xls";
                    linkText = "Branch Sample Sheet";
                    break;
                case "3":
                    hrefValue = "/SampleXlFile/Department.xls";
                    linkText = "Department Sample Sheet";
                    break;
                case "4":
                    hrefValue = "/SampleXlFile/Designation.xls";
                    linkText = "Designation Sample Sheet";
                    break;
                case "5":
                    hrefValue = (dbName == customclientName)
                        ? "/SampleXlFile/Emp_Bestseller.xlsx"
                        : "/SampleXlFile/Emp.xls";
                    linkText = "Employee Sample Sheet";
                    break;
                default:
                    hrefValue = "";
                    linkText = "Select a Class to Download Sample Sheet";
                    break;
            }
            $("a.btn.green-dark").attr("href", "").text("");
            $("a.btn.green-dark").attr("href", hrefValue).append('<i class="fa-regular fa-file-excel"></i> ' + linkText);
        });
        $("#btnImport").click(function (event) {
            checkSession();
            var classMasterValue = $("#ddlClassMaster").val();
            if (classMasterValue == "0") {
                toastr.remove();
                toastr.error("Please select Category.");
                event.preventDefault();
                return false;
            } else if (classMasterValue == "5") {
                if ($("#ddlCompany").val() == "0") {
                    toastr.remove();
                    toastr.error("Please select company.");
                    event.preventDefault();
                    return false;
                }
                if (document.getElementById("FileUpload").files.length == 0) {
                    toastr.remove();
                    toastr.error("Please upload file.");
                    event.preventDefault();
                    return false;
                }
            } else if (classMasterValue != "5") {
                if (document.getElementById("FileUpload").files.length == 0) {
                    toastr.remove();
                    toastr.error("Please upload file.");
                    event.preventDefault();
                    return false;
                }
            }
        });
        $("#FileUpload").change(function () {
            if ($("#FileUpload").val() != null) {
                var validExts = new Array(".xlsx", ".xls", ".csv");
                var fileExt = $("#FileUpload").val();
                if (fileExt != "") {
                    fileExt = fileExt.substring(fileExt.lastIndexOf('.'));
                    if (validExts.indexOf(fileExt) < 0) {
                        toastr.remove();
                        toastr.error("Invalid file selected, valid files are of " + validExts.toString() + " types.");
                        $("#FileUpload").val("");
                        return false;
                    }
                }
            }
        });

    });
    function generateprogressdata(classValue) {
          $(".loading1").show();
          if (interval) {
              clearInterval(interval);
              interval = "";
          }
          activeTableId = classValue;
          interval = setInterval(() => {
              $.ajax({
                  url: '@_webapiurl' + "Utility/GetProgressData?tableID=" + activeTableId + "&compcode=" + compcode,
                  type: "GET",
                  headers: { 'Authorization': '@_tokan' },
                  contentType: "application/json; charset=utf-8",
                  datatype: "json",
                  success: function (data) {
                      if (data != null) {
                          const companylist = data;
                          handleGridVisibility("tblempty1", "NotificationGrid-emptyCompany", companylist, {
                              imageUrl: "emptyscreen_1.png",
                              subText: "No entries found. Please add a record to get started."
                          });
                      }
                      if (Array.isArray(data) && data.length > 0 && data[0].Progress !== undefined && data[0].Error !== undefined) {
                             var progressValue = data[0].Progress;
                              var responseCompcode = data[0].compcode;
                              var responseerror = data[0].Error;
                              if (responseCompcode === compcode) {
                                  if (classValue == 1) {
                                      $("#tblCompanyMaster tbody tr").each(function (index) {
                                          var rowDiv = $(this).find("div[id^='row_']");
                                          if (rowDiv.length) {
                                              var rowId = rowDiv.attr("id").replace("row_", "");
                                              var progressBar = $("#progress_company_bar_" + rowId);
                                              var progressText = $("#progress_company_val_" + rowId);
                                              if (responseerror == 101) {
                                                  GetExcelFailedStatusCompanyGridData();
                                              }
                                              if (progressBar.length && progressText.length) {
                                                  progressBar.css("width", progressValue + "%").attr("aria-valuenow", progressValue);
                                                  progressText.text(progressValue + "%");
                                              }
                                          }
                                      });
                                  }
                                  else if (classValue == 2) {
                                      $("#tblBranchMaster tbody tr").each(function (index) {
                                          var rowDiv = $(this).find("div[id^='row_']");
                                          if (rowDiv.length) {
                                              var rowId = rowDiv.attr("id").replace("row_", "");
                                              var progressBar = $("#progress_Branch_bar_" + rowId);
                                              var progressText = $("#progress_Branch_val_" + rowId);
                                              if (responseerror == 101) {
                                                  GetExcelFailedStatusBranchGridData();
                                              }
                                              if (progressBar.length && progressText.length) {
                                                  progressBar.css("width", progressValue + "%").attr("aria-valuenow", progressValue);
                                                  progressText.text(progressValue + "%");
                                              }
                                          }
                                      });
                                  }
                                  else if (classValue == 3) {
                                      $("#tblDepartmentMaster tbody tr").each(function (index) {
                                          var rowDiv = $(this).find("div[id^='row_']");
                                          if (rowDiv.length) {
                                              var rowId = rowDiv.attr("id").replace("row_", "");
                                              var progressBar = $("#progress_Dept_bar_" + rowId);
                                              var progressText = $("#progress_Dept_val_" + rowId);
                                              if (responseerror == 101) {
                                                  GetExcelFailedStatusDepartmentGridData();
                                              }
                                              if (progressBar.length && progressText.length) {
                                                  progressBar.css("width", progressValue + "%").attr("aria-valuenow", progressValue);
                                                  progressText.text(progressValue + "%");
                                              }
                                          }
                                      });
                                  }
                                  else if (classValue == 4) {
                                      $("#tblDesignationMaster tbody tr").each(function () {
                                          var rowDiv = $(this).find("div[id^='row_']");
                                          if (rowDiv.length) {
                                              var rowId = rowDiv.attr("id").replace("row_", "");
                                              var progressBar = $("#progress_Desg_bar_" + rowId);
                                              var progressText = $("#progress_Desg_val_" + rowId);
                                              if (responseerror == 101) {
                                                  GetExcelFailedStatusDesignationGridData();
                                              }
                                              if (progressBar.length && progressText.length) {
                                                  progressBar.css("width", progressValue + "%").attr("aria-valuenow", progressValue);
                                                  progressText.text(progressValue + "%");
                                              }
                                          }
                                      });
                                  }
                                  else if (classValue == 5) {
                                      $("#tblEmployeeMaster tbody tr").each(function () {
                                          var rowDiv = $(this).find("div[id^='row_']");
                                          if (rowDiv.length) {
                                              var rowId = rowDiv.attr("id").replace("row_", "");
                                              var progressBar = $("#progress_Emp_bar_" + rowId);
                                              var progressText = $("#progress_Emp_val_" + rowId);
                                              if (responseerror == 101) {
                                                  GetExcelFailedStatusEmpGridData();
                                              }
                                              if (progressBar.length && progressText.length) {
                                                  progressBar.css("width", progressValue + "%").attr("aria-valuenow", progressValue);
                                                  progressText.text(progressValue + "%");
                                              }
                                          }
                                      });
                                  }
                                  if (progressValue >= 100) {
                                      clearInterval(interval);
                                      $(".loading1").hide();

                                      switch (parseInt(classValue)) {
                                          case 5:
                                              generateEmployeegriddata(userid);
                                              break;
                                          case 1:
                                              generateCompanygriddata(userid);
                                              break;
                                          case 2:
                                              generateBranchgriddata(userid);
                                              break;
                                          case 3:
                                              generateDepartmentgriddata(userid);
                                              break;
                                          case 4:
                                              generateDesignationgriddata(userid);
                                              break;
                                          default:
                                              //console.warn("Invalid class master value.");
                                              break;
                                      }
                                  }
                              }
                          }
                  },
                  error: function (jqXHR, ajaxOptions, thrownError) {
                      if (jqXHR.status === 500) {
                          toastr.error("Internal Server Error.");
                      } else if (jqXHR.status === 400) {
                          toastr.error("Bad Request.");
                      } else if (jqXHR.status === 401) {
                          window.location.href = "/PayTime/LoginPage";
                      }
                      clearInterval(interval); // Stop interval on error
                      $(".loading1").hide(); // Hide loading indicator on error
                  }
              });
          }, 3000);
   }
    function generateCompanygriddata(userid) {
        $("#dataTables_tbl_header").remove();
    $.ajax({
        url: '@_webapiurl' + "Utility/GetExcelCompanyGridData?userid=" + userid,
        type: "GET",
        headers: { 'Authorization': '@_tokan' },
        contentType: "application/json; charset=utf-8",
        datatype: "json",
        beforeSend: function () {
            $("#ajax_loader_Import").show();
        },
        complete: function () {
            $('#ajax_loader_Import').hide(); // Hide loader after request completes
        },
        success: function (response) {
            if (response != null) {
                const companylist = response;
                handleGridVisibility("tblempty1", "NotificationGrid-emptyCompany", companylist, {
                    imageUrl: "emptyscreen_1.png",
                    subText: "No entries found. Please add a record to get started."
                });
            }
            if (response && response.length > 0) {
                $("#tblCompanyMaster").show();
                if ($.fn.dataTable.isDataTable('#tblCompanyMaster')) {
                    $('#tblCompanyMaster').DataTable().clear().destroy();
                }
                var tableData = [];
                for (var i = 0; i < response.length; i++) {
                    var row = [];
                    row.push(i + 1);
                    row.push(response[i].Startdate);

                    if (response[i].Err === 1 && response[i].Status !== "Pending") {
                        row.push("<div id='row_" + i + "' style='display: flex;'><span class='red_font'>Failed – Error record found.</span></div>");
                    }
                    else if (response[i].Status === "Success") {
                        row.push("<div id='row_" + i + "' style='display: flex;'><span class='green_font'>" + response[i].Status + "</span></div>");
                    }
                    else if (response[i].Status === "Pending") {
                        row.push(
                            "<div id='row_" + i + "' style='display: flex;'>" +
                            "<div class='orange_font' id='statusCompany_" + i + "'>" + response[i].Status + "</div>" +
                            "<div class='loading1' style='width: 100px; margin: 0 8px;'>" +
                            "<div class='progress' style='margin-bottom: 0;'>" +
                            "<div class='progress-bar' id='progress_company_bar_" + i + "' role='progressbar' style='width: 0%;' aria-valuenow='0' aria-valuemin='0' aria-valuemax='100'></div>" +
                            "</div>" +
                            "</div>" +
                            "<span class='progress-value' id='progress_company_val_" + i + "'>0%&nbsp;</span>" +
                            "</div>"
                        );
                    }
                    else {
                        row.push(response[i].Status);
                    }

                   row.push(response[i].CreatedDtFlag);
                   row.push(response[i].Err);
                   if (response[i].Err == 1 && response[i].Status != "Pending") {
                       row.push(
                           "<a class='btnDownloadErrorList btn btn-xs seagreen_btnnew' " +
                           "onclick='generateCompExcelFile(\"" + response[i].CreatedDtFlag + "\", \"" + $("#ddlClassMaster").val() + "\")'>" +
                           "<i class='fa-regular fa-file-excel'></i></a>"
                       );
                   }
                   else if (response[i].Status == "Success")
                   {
                       row.push("");
                   }
                   else {
                       row.push(
                           "<button class='btn btn-xs seagreen_btnnew' style='display:none;' id='regenerateCompany_" + i + "' " +
                           "onclick='regenerateEntryCompany(\"" + response[i].CreatedDtFlag + "\", \"" + compcode + "\", this ," + i + ")'>" +
                           "<i class='fa-light fa-rotate'></i></button>"
                       );
                   }
                    tableData.push(row);
                }
                // Initialize DataTable
                $('#tblCompanyMaster').DataTable({
                    data: tableData,
                    columns: [
                        { title: "Sr No.",visible:false},
                        { title: "StartDate"},
                        { title: "Status"},
                        { title: "CreatedDtFlag", visible: false },
                        { title: "Err", visible: false },
                        { title: "View Error File"}
                    ],
                    dom: _domCommon,
                    language: _languageCommon,
                    ordering: true,
                    lengthChange: true,
                    info: true,
                    autoWidth: false,
                    responsive: true,
                    "initComplete": function () {
                        const visibleTable = $('table:visible').attr('id');
                        $("#buttons").append(`
                            <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                                <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                            </div>
                        `);
                    }
                });
                setTimeout(function () {
                    $("#" + "tblCompanyMaster" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsiveCompany"));
                    $('.tooltips').tooltip();
                }, 100);
                $("#ajax_loader_Import").hide();
            }
        },
        error: function (xhr, ajaxOptions, thrownError) {
            $("#ajax_loader_Import").hide();
        },
        complete: function () {
            $("#ajax_loader_Import").hide();
        }
        });
    }
    function generateEmployeegriddata(userid) {
        $("#dataTables_tbl_header").remove();
        $.ajax({
            url: '@_webapiurl' + "Utility/GetExcelEmpGridData?userid=" + userid,
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            beforeSend: function () {
                $("#ajax_loader_Import").show();
            },
            complete: function () {
                $('#ajax_loader_Import').hide(); // Hide loader after request completes
            },
            success: function (response) {
                if (response != null) {
                    const employeeList = response;
                    handleGridVisibility("tblempty", "NotificationGrid-empty", employeeList, {
                        imageUrl: "emptyscreen_1.png",
                        subText: "No entries found. Please add a record to get started."
                    });
                }
                if (response && response.length > 0) {
                    $("#tblEmployeeMaster").show();
                    if ($.fn.dataTable.isDataTable('#tblEmployeeMaster')) {
                        $('#tblEmployeeMaster').DataTable().clear().destroy();
                    }
                    var tableData = [];
                    for (var i = 0; i < response.length; i++) {
                        var row = [];
                        row.push(i + 1);
                        row.push(response[i].Startdate);
                        if (response[i].Err === 1 && response[i].Status !== "Pending") {
                            row.push("<div id='row_" + i + "' style='display: flex;'><span class='red_font'>Failed – Error record found.</span></div>");
                        }
                        else if (response[i].Status === "Success") {
                            row.push("<div id='row_" + i + "' style='display: flex;'><span class='green_font'>" + response[i].Status + "</span></div>");
                        }
                        else if (response[i].Status === "Pending") {
                            row.push(
                                "<div id='row_" + i + "' style='display: flex;'>" +
                                "<div class='orange_font' id='statusEmp_" + i + "'>" + response[i].Status + "</div>" +
                                "<div class='loading1' style='width: 100px; margin: 0 8px;'>" +
                                "<div class='progress' style='margin-bottom: 0;'>" +
                                "<div class='progress-bar' id='progress_Emp_bar_" + i + "' role='progressbar' style='width: 0%;' aria-valuenow='0' aria-valuemin='0' aria-valuemax='100'></div>" +
                                "</div>" +
                                "</div>" +
                                "<span class='progress-value' id='progress_Emp_val_" + i + "'>0%&nbsp;</span>" +
                                "</div>"
                            );
                        }
                        else {
                            row.push(response[i].Status);
                        }

