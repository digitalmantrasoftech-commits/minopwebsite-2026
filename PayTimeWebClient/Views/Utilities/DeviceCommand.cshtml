@model PayTimeWebClient.Models.Devicecommand
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "DeviceCommand";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
       ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
       : "false"; // Default to "false" if the session is null
}
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script type="text/javascript">
    var count = 0;
    var form = "Devicecommand";
    var operation = "";
    $(document).ready(function () {
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        $(".alert").hide();
        if ("@_Message" != "") {
            toastr.success("@_Message");
            //$(".alert-danger").hide();
            //$(".alert-success").show();
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
            //$(".alert-danger").show();
            //$(".alert-success").hide();
        }
        $('#tbldeviceCommand').DataTable({
            dom: _domCommon,
            language: _languageCommon,
        });
        setTimeout(function () {
            $("#" + "tbldeviceCommand" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Device Command";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })
    });
</script>
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> DeviceCommand</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> DeviceCommand</span>
            </li>
        </ul>
    }
</div>
@if (obj.CanView)
{

    <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>
    <div class="portlet">
        <div class="portlet-body">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    @if (ViewBag.DeviceCommandlist != null && ViewBag.DeviceCommandlist.Count > 0)
                    {
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tbldeviceCommand" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column ">
                                <thead>
                                    <tr>
                                        <th style="display:none;">Sr. No</th>
                                        <th hidden>Devicecmdid</th>
                                        <th hidden>Device id</th>
                                        <th>Branch Name</th>
                                        <th>Device Code</th>
                                        <th hidden>Command id</th>
                                        <th>Command Name</th>
                                        <th>Command Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                        <th>Execute Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                        <th>Status</th>
                                        @*<th>Response Status</th>
                            <th>Response Message</th>*@
                                    </tr>
                                </thead>
                                @{int n = 1;}
                                <tbody>
                                    @if (ViewBag.DeviceCommandlist != null)
                                    {
                                        foreach (var i in ViewBag.DeviceCommandlist)
                                        {
                                            <tr class="odd gradeX">
                                                <td style="display:none;" id="sr">@n</td>
                                                <td id="hdnDevicecmdid" hidden>@i.Devicecmdid</td>
                                                <td id="Deviceid" hidden>@i.Deviceid</td>
                                                <td id="BranchName">@i.BranchName</td>
                                                <td id="DeviceCode"> @i.DeviceCode </td>
                                                <td id="Commandid" hidden>@i.Commandid</td>
                                                <td id="Commandname">@i.Commandname</td>
                                                <td id="Commanddate">@i.Commanddate</td>
                                                <td id="Commandexecutedate">
                                                    @i.Commandexecutedate
                                                </td>
                                                <td id="IsExecuted">
                                                    @if (i.IsExecuted == 1)
                                                    {
                                                        <span>Completed</span>
                                                    }
                                                    else if (i.IsExecuted == 2)
                                                    {
                                                        <span>In Process</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Pending</span>
                                                    }
                                                </td>
                                                @*<td id="RespSatus">@i.RespSatus</td>
                                    <td id="Responce">@i.Responce</td>*@
                                            </tr>
                                            n++;
                                        }
                                    }
                                    else
                                    {
                                        <tr colspan="8" class="odd gradeX">No Data Available</tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div id="NotificationGrid-empty">
                            <div class="datanotfound">
                                <img src="~/assets/images/emptyscreen_1.png" height="148" width="280" alt="Nodata Found Icon">
                                <p class="datanotfound_title">No data found</p> <!-- titleText -->
                                <p class="">No entries found. Please add a record to get started.</p><!-- subText -->
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>
