@using System.Data
@using System
@model DataTable
@{
    ViewBag.Title = "ViewCustomforms";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _companyid = HttpContext.Current.Session["CompanyId"].ToString();
    string _selectitemval = TempData["frmname"] != null ? TempData["frmname"].ToString() : "";
    string _emesge = TempData["emsg"] != null ? TempData["emsg"].ToString() : "";
    string _smesge = TempData["smsg"] != null ? TempData["smsg"].ToString() : "";
}

<script src="~/Scripts/customform/form-render.min.js"></script>
<script src="~/Scripts/toastr.min.js"></script>
