<style>
    .btn.icon_btn {
        top: -10px;
        position: relative;
        left: 20px;
    }
</style>

<script>
    jQuery(function ($) {

        if ('@_emesge' != '') {
            toastr.remove();
            toastr.error('@_emesge');
        }
        if ('@_smesge' != '') {
            toastr.remove();
            toastr.success('@_smesge');
        }


        $('#crpttbl').DataTable({
            //"dom": 'Bfrtip',
            dom: _domCommon,
            language: _languageCommon,
            "ordering": false,
            "buttons": [{
                extend: 'excelHtml5',
                //text: '<i class="fa-regular fa-file-excel" style="color:green; Font-size:15px"></i>',
                titleAttr: 'Export to excel',
                filename: '@_selectitemval',
                title: '@_selectitemval',
                exportOptions: {
                    columns: ':gt(0)'
                },
                header: false
            }],
            "columns": [
                { data: "pkid", visible: false },
                { title:"Autocomplete",data: "Autocomplete" },
                { title:"Text Field",data: "Text Field" },
            ],
            "columnDefs": [
                    {
                        "targets": [0],
                        "visible": false
                    }],
            "oLanguage": {
                "sEmptyTable": "No data to Display"
            }

        });
        setTimeout(function () {
            $("#" + "crpttbl" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        //$("<button class='dt-button buttons-html5' tabindex='0' onClick='showformtoadd();' aria-controls='crpttbl' title='Add'><span>Add</span></button>").insertAfter(".dt-buttons");

        $(".dt-buttons").append("<button class='btn icon_btn tooltips' tabindex='0' onClick='showformtoadd();' aria-controls='crpttbl' data-placement='bottom' data-original-title='Add Details'><i class='fa-solid fa-plus'></i></button>");
        $('.tooltips').tooltip();
        var _frmdata;
        var _tblname;
        var _fileupload;
        var itemselect = '@_selectitemval';
        var _lstfrmcustom = @Html.Raw(ViewBag.lstcustomform)

        $.each(_lstfrmcustom, function (value) {
            if (_lstfrmcustom[value].frmdisplayname.trim() == itemselect) {
                _frmdata = _lstfrmcustom[value].frmdata;
                _tblname = _lstfrmcustom[value].frmtblname;
                $("<h3>" + _lstfrmcustom[value].frmdisplayname + "</h3>").insertBefore("#fb-render");
                //document.cookie = "frmrendata=" + itemselect + "";
                return false;
            }
        })

        var fbRender = document.getElementById('fb-render'),
        vformData = _frmdata,
        formRenderOpts = {
            dataType: 'json',
            render: true,
            formData: vformData
        };


        var fbinstance = $(fbRender).formRender(formRenderOpts);
        //var udata = formRenderInstance.userData;


        $('.ui-autocomplete-input').on('keypress', function (e) {
            var container = $(this).attr('name');
            var num = $('#' + container + '').val().length;
            if (num >= 49) {

                var num1 = $('#' + container + '').val().substring(0, 49);
                $('#' + container + '').val(num1);
                return false;
            }
        });

        $('input[type="text"]').on('keypress copy paste', function () {
            var container = $(this).attr('name');
            var num = $('#' + container + '').val().length;
            if (num >= 49) {

                var num1 = $('#' + container + '').val().substring(0, 49);
                $('#' + container + '').val(num1);
                return false;
            }
        });
        $('input[type="text"]').on('keydown', function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $('input').on('keydown', function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $('textarea[type="textarea"]').on('keypress copy paste', function () {
            var container = $(this).attr('name');
            var num = $('#' + container + '').val().length;
            if (num >= 100) {
                var num1 = $('#' + container + '').val().substring(0, 99);
                $('#' + container + '').val(num1);
                return false;
            }
        });
        $('textarea[type="textarea"]').on('keydown', function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $('input[type="decimal"]').on('change', function () {
            var container = $(this).attr('name');
            var num = parseFloat($('#' + container + '').val());
            if (num == "NaN") {
                $('#' + container + '').val('');
                return false;
            }
            var cleanNum = num.toFixed(2);
            $(this).val(cleanNum);
            if (num / cleanNum < 1) {
                toastr.remove();
                toastr.error("Please enter only 2 decimal places, we have truncated extra points.");
                $('#' + container + '').val('');
                return false;
            }

        });

        $('input[name="tel"]').keyup(function (e) {
            var container = $(this).attr('name');
            var num = parseFloat($('#' + container + '').val());
            if (/\D/g.test(this.value)) {
                // Filter non-digits from input value.
                var _num = this.value.replace(/\D/g, '');
                $('#' + container + '').val('_num');
            }
        });

        $('input[type="file"]').on('change', function () {
            //var file = $('#' + container + '').val();
            _fileupload = event.target.files[0].name;
            $("#hdnuploadfile").val(event.target.files[0]);
            var container = $(this).attr('name');
            var file_size = $('#' + container + '')[0].files[0].size;
            if (file_size > 2097152) {
                toastr.remove();
                toastr.error("File size is greater than 2MB");
                $('#' + container + '').val('');
                return false;
            }
        });

        $(fbRender).submit(function (event) {
            //    //var data1 = fbinstance.userData;
            //    //alert(JSON.stringify(data1));
            //    ////$.ajax({
            //    ////    type: 'POST',
            //    ////    url: 'ViewCustomforms',
            //    ////    data: { "formdt": JSON.stringify(data1) },
            //    ////    contentType: "application/json; charset=utf-8",
            //    ////    dataType: 'json',
            //    ////    processData: false,
            //    ////    cache: false
            //    ////});
            @*var url ='@_webapiurl'+"";
            $.ajax({
                type: "POST",

                url: 'Customform/Savecustomformdata',
                //data: JSON.stringify(data1)
            });*@
            $("#menurender").val(itemselect);
            var ss = $("<div class='formbuilder-hidden form-group field-hidden'><input type='hidden' id='menurender' name='menurender' value='" + itemselect + "' /><input type='hidden' id='selecttblname' name='selecttblname' value='" + _tblname + "' /><input id='hdnuploadfile' name ='hdnuploadfile' type='hidden' value='" + _fileupload + "'  /></div>").insertBefore(".rendered-form");
            //alert(JSON.stringify(ss));
        });

    });
    $(function () {
        var searchUrl = "";
        var mname = "";
        var txtname = "";
        var optselect = "";
        $("input[myatt='Minop']").click(function () {
            txtname = $(this).attr("id");
            mname = $(this).attr("selectedmaster");
            optselect = $(this).attr('require-valid-option');
            searchUrl = "Callautocomple";
            if (optselect == "false") {
                $('.formbuilder-autocomplete-list').empty();
            }
            else {
                searchUrl = "";
            }
        })

        $("input[myatt='Minop']").autocomplete({
            delay: 300,
            source: function (request, response) {
                var objreq = {
                    'searchfrom': mname,
                    'searchval': request.term,
                    'tblname': ""
                }

                $.ajax({
                    type: 'POST',
                    url: searchUrl,
                    data: JSON.stringify(objreq),
                    contentType: "application/json; charset=utf-8",
                    dataType: 'json',
                    cache: false,
                    success: function (json) {
                        if (json.length > 0) {
                            response($.map(json, function (item) {
                                return { value: item.value, id: item.label }
                            }))
                        }
                        else {
                            response([{ label: 'No results found.', value: -1 }]);
                        }
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        console.log('error', textStatus, errorThrown);
                    }
                });
            },
            //minLength: 2,
            select: function (event, ui) {
                var tame = "#" + txtname;
                var thame = "#" + txtname.replace("-input", "");
                $(thame).val(ui.item.value);
                $(tame).val(ui.item.value);
                if (ui.item.value == -1) {
                    //Clear the AutoComplete TextBox.
                    $(this).val("");
                    return false;
                }
                $('.formbuilder-autocomplete-list').append("<li value='" + ui.item.value + "'>" + ui.item.value + "</li>");
                return false;
            }
        })


        $("select[myatt='Minop']").each(function (index) {
            var selname = "";
            var selectopt = "";
            var selmname = "";
            searchUrl = "Callautocomple";
            selname = $(this).attr("id");
            selmname = $(this).attr("master");
            selectopt = $(this).attr('staticopt');
            searchUrl = "Callautocomple";
            //if (selectopt == "true") {
            //    searchUrl = "";
            //}
            //else {
            //    $(this).empty();
            //    Binddropdown(selname, selmname, searchUrl);
            //}
            //alert(selectopt);
            if (selectopt == "true") {

                searchUrl = "";
            }
            else {
                $(this).empty();
                Binddropdown(selname, selmname, searchUrl);
            }
        });



        //$("select[myatt='Minop']").on('focus','hover', function () {

        //    selname = $(this).attr("id");
        //    selmname = $(this).attr("master");
        //    optselect = $(this).attr('staticopt');
        //    searchUrl = "Callautocomple";
        //    if (optselect == "true") {
        //        searchUrl = "";
        //    }
        //    else {
        //        $(this).empty();

        //        Binddropdown(selname, mname, searchUrl);

        //    }
        //})


    });

    function Binddropdown(ctlname, ctlmaster, ctlurl) {

        var objreq = {
            'searchfrom': ctlmaster,
            'searchval': "",
            'tblname': "All"
        }

        $("#" + ctlname).append($("<option disabled='null' selected='null'>Select " + ctlmaster + "</option>"));
        //alert(Json.stringify(objreq));
        $.ajax({
            type: 'POST',
            url: ctlurl,
            data: JSON.stringify(objreq),
            contentType: "application/json; charset=utf-8",
            dataType: 'json',
            cache: false,
            success: function (json) {
                //$.each(res.d, function (data, value) {

                //    $("#"+ctlname).append($("<option disabled="null" selected="null">Select Company</option>").val(value.CountryId).html(value.CountryName));
                //})
                $.map(json, function (item) {
                    $("#" + ctlname).append($("<option></option>").val(item.value).html(item.label));
                    //return { value: item.value, id: item.label }
                })
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                console.log('error', textStatus, errorThrown);
            }
        });
    }

    function showformtoadd() {
        $("#myformdata").hide();
        $("#myfom").show();
    }

    function fileupload(file) {
        //alert('~/Downloads/' + file);
        //window.open('~/Downloads/' + file, ' _blank');

    }
</script>


<link href="../Newlayout/css/CustomDesign/ViewCustomforms.css" rel="stylesheet" />

<div class="page-bar">
    @if (_RoleId == 1)
    {
        <ul class="page-breadcrumb">
            @if (Convert.ToInt32(Session["IsSchool"]) == 1)
            {
                <li>
                    <a href="/School/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                </li>
            }
            else
            {
                <li>
                    <a href="/Dashboard/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                </li>
            }
            <li>
                <span><i class="fa-light fa-angle-right"></i> @_selectitemval</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> @_selectitemval</span>
            </li>
        </ul>
    }
</div>
<input type="hidden" id="frmrendata" name="frmrendata">

<div class="custom_form_box" id="myfom" style="display:none">
    <div id="fb-rendered-form">
        <form action="SaveCustomforms" id="fb-render" method="post" enctype="multipart/form-data">
            <input id="hdnuploadfile" type="hidden" />
        </form>
    </div>
</div>

<div id="myformdata" class="portlet">
    @if (Model != null && Model.Rows.Count != 0)
    {
        <div class="table-responsive" id="tableResponsive">
            <table id="crpttbl" class="new_datatbl display nowrap table table-striped table-bordered table-hover table-checkable order-column dataTable no-footer">
                <thead>
                    <tr>
                        @foreach (DataColumn col in Model.Columns)
                        {
                            <th>
                                @*@col.ColumnName*@
                                @col.ColumnName.Replace("file-", "")
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (DataRow row in Model.Rows)
                    {
                        <tr>
                            @foreach (DataColumn col in Model.Columns)
                            {
                                if (col.ColumnName == "Attn Date")
                                {
                                    <td>@System.DateTime.Parse(row[col.ColumnName].ToString()).ToString("dd-MMM-yyyy")</td>
                                }
                                else if (col.ColumnName.Contains("file-"))
                                {
                                    <td>
                                        <a href='/FileuploadControlData/@Session["cmpcode"]/@row[col.ColumnName]' target=" _blank" download>
                                            @row[col.ColumnName]
                                        </a>
                                    </td>
                                }
                                else
                                {
                                    <td>@row[col.ColumnName]</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
         </div>
            }
            else
            {
            <table id="crpttbl" class="display nowrap portlet" style="width:100%">
                <tbody>
                    <tr>
                        <td style="text-align:center"> No data to Display</td>
                    </tr>
                </tbody>
            </table>

            }
        </div>

        <script>
            setTimeout(function () {
                $("#crpttbl_wrapper > .dataTables_info").before('<div class="customforms_table"></div>');
                $("#crpttbl").appendTo(".customforms_table");
            }, 3000);
        </script>
