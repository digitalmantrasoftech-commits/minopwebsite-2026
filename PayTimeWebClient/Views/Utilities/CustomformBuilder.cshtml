@{
    ViewBag.Title = "CustomformBuilder";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _companyid = HttpContext.Current.Session["CompanyId"].ToString();
    int _frmid = Convert.ToInt32(TempData["frmid"]);
    var _frmdata = string.Empty;
    int _mnuop = 0;
    string _frmdisp = string.Empty;
    string _tblname = string.Empty;

    if (_frmid > 0)
    {
        _mnuop = Convert.ToInt32(TempData["frmoperationparentid"]);
        _frmdisp = TempData["frmdisplayname"].ToString();
        _tblname = TempData["frmtblname"].ToString();

        if (TempData["frmdata"] == null)
        {
            _frmdata = "[{}]";
        }
        else
        {
            _frmdata = TempData["frmdata"].ToString();
        }
    }
}

<script src="~/Scripts/customform/jquery.min.js"></script>
<script src="~/Scripts/customform/jquery-ui.min.js"></script>
<script src="~/Scripts/customform/form-builder.min.js"></script>
<script src="~/Scripts/customform/form-render.min.js"></script>
<script src="~/Scripts/toastr.min.js"></script>
<link href="~/Content/toastr.min.css" rel="stylesheet" />
<link href="../Newlayout/css/CustomDesign/Customforms.css" rel="stylesheet" />
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script>

    var din = '@_frmdisp';
    var fid = '@_frmid';
    var fomid = '@_mnuop';
    var _frdt = '@_frmdata';
    var _frtbl = '@_tblname';
    var arrobj = [];

    jQuery(function ($) {        
        if (fid > 0) {
            $('#txtfrmdisplayname').val(din);
            $('#frmid').val(fid);
            $('#frmoperationparentid').val(fomid);
            var jsonfrmdata = JSON.parse(_frdt.replace(/&quot;/g, '"'));
            var _custlmt = 0;
            var vrbtn = '';

            if (din == "Company Master" || din == "Branch Master" || din == "Department Master" || din == "Designation Master" || din == "Employee Master") {
                vrbtn = 'button';
                _custlmt = 1;
                $('#txtfrmdisplayname').attr('disabled', 'disabled');
                $('#frmoperationparentid').attr('disabled', 'disabled');                
            }
            const formData = JSON.stringify(jsonfrmdata);
            
            var $fbEditor = $(document.getElementById('fb-editor')),
            $formContainer = $(document.getElementById('fb-rendered-form')),
            fbOptions = {

                typeUserEvents: {
                    text: {
                        onremove: function (fieldId) {
                            Deleterow(fieldId);
                        }
                    },

                    textarea: {
                        onremove: function (fieldId) {

                            Deleterow(fieldId);
                        }
                    },

                    'checkbox-group': {
                        onremove: function (fieldId) {
                            Deleterow(fieldId);
                        }

                    },
                    autocomplete: {
                        onremove: function (fieldId) {
                            Deleterow(fieldId);
                        }

                    },
                    date: {
                        onremove: function (fieldId) {
                            Deleterow(fieldId);
                        }

                    },
                    header: {
                        onremove: function (fieldId) {
                            Deleterow(fieldId);
                        }

                    },
                    number: {
                        onremove: function (fieldId) {
                            Deleterow(fieldId);
                        }

                    },
                    'radio-group': {
                        onremove: function (fieldId) {
                            Deleterow(fieldId);
                        }

                    },
                    select: {
                        onremove: function (fieldId) {
                            Deleterow(fieldId);
                        }

                    },
                    file: {
                        onremove: function (fieldId) {
                            Deleterow(fieldId);
                        }
                },
                },

                onAddField: function (fieldData, fieldId) {
                    

                    var fieldDatacnt = JSON.stringify(fieldData);

                    var _fdt = formBuilder.formData;
                    var jsonfrmdata = JSON.parse(_fdt.replace(/&quot;/g, '"'));                    
                    var _cnt = fieldDatacnt.split('-');

                    if (_custlmt == 1) {
                        if (jsonfrmdata.length >= 10) // Master Page
                        {
                            $("#" + fieldData).remove();
                            return false;
                        }
                    }
                    else {
                        if (jsonfrmdata.length >= 20) // Master Page
                        {
                            $("#" + fieldData).remove();
                            return false;
                        }
                    }

                    // ------ Save arrobj
                    var t = JSON.stringify(fieldId.label);
                    var colname = "";
                    var coltype = "";
                    if (t.indexOf("checkbox-group") != "-1") {
                        colname = fieldId.name;
                        coltype = "checkbox";
                    }
                    else if (t.indexOf("radio-group") != "-1") {
                        colname = fieldId.name;
                        coltype = "radio";
                    }
                    else if (t.indexOf("select-") != '-1') {
                        coltype = "select";
                        colname = fieldId.name;
                    }
                    else {

                        colname = fieldId.name;
                        coltype = fieldId.type;

                    }

                    var n = JSON.stringify(fieldId.label);
                    var collable = "";
                    var isnull = "NULL";
                    if (n.toString().indexOf("*") > 0) {
                        collable = n.replace("*", "");
                        isnull = "NOT NULL";
                    }
                    else {
                        collable = n;
                    }
                    var collen = "100";
                    if (coltype == "textarea") {
                        collen = "250";
                    }
                    if (coltype != "button") {
                        var obj = {
                            vfrmtblname: _frtbl,
                            vcolname: colname,
                            vcollen: collen,
                            visnull: isnull,
                            vcollable: collable.replace('"', '').replace('"', ''),
                            vcoltype: coltype,
                        }
                        arrobj.push(obj);
                    }
                },

                onOpenFieldEdit: function (e) {

                },
                onCloseFieldEdit: function (e) {
                    
                    var t = "#" + e.parentElement["childNodes"][4].firstElementChild.firstChild["htmlFor"]
                    var colname = "";
                    var coltype = "";
                    if (t.indexOf("checkbox-group") != "-1") {
                        var _columnname = t.split("-preview");
                        colname = _columnname[0].replace("#", "");
                        coltype = "checkbox";
                    }
                    else if (t.indexOf("radio-group") != "-1") {
                        var _columnname = t.split("-preview");
                        colname = _columnname[0].replace("#", "");
                        coltype = "radio";
                    }
                    else if (t.indexOf("select-") != '-1') {
                        coltype = "select";
                        colname = $(t).attr("name").replace("-preview", "");
                    }
                    else {
                        colname = $(t).attr("name").replace("-preview", "");
                        coltype = $(t).attr("type");
                    }

                    var n = e.parentElement["childNodes"][4].firstElementChild.firstChild["innerText"];


                    var collable = "";
                    var isnull = "NULL";
                    if (n.toString().indexOf("*") > 0) {
                        collable = n.replace("*", "");
                        isnull = "NOT NULL";
                    }
                    else {
                        collable = n;
                    }
                    //if (coltype == "text" || coltype == "textarea") {

                    //    var k = $(t).attr("maxlength");

                    //    if (k != undefined) {
                    //        collen = k;
                    //    }
                    //}

                    //alert(_frtbl + '---' + colname + '---' + collen + '---' + isnull + '---' + collable + '---' + coltype)

                    var obj = {
                        vfrmtblname: _frtbl,
                        vcolname: colname,
                        vcollen: collen,
                        visnull: isnull,
                        vcollable: collable,
                        vcoltype: coltype,
                    }

                    //var _idexitem = jQuery.inArray(colname, arrobj);

                    //if (_idexitem > 0)
                    //{
                    //    alert(_idexitem);
                    //    arrobj.slice(_idexitem);

                    //}

                    //alert(obj);

                    arrobj.push(obj);

                },

                onSave: function () {
                    
                    var _fdt = formBuilder.formData;
                    var flg = 0;
                    var fn = $("#txtfrmdisplayname").val().trim();
                    //alert(fn.length);
                    var fms = $('#frmoperationparentid').val();
                    toastr.remove();
                    if (fms == 0) {
                        flg = 1
                        toastr.info('Please select master menu.');
                    }
                    if (fn == '') {
                        flg = 1
                        toastr.info('Form name required.');
                    } else if (fn.length < 6) {
                        flg = 1
                        toastr.info('Form name should be more than 6 characters.');
                    }
                    else if (_fdt.length <= 0) {
                        flg = 1
                        toastr.info('Form should not be empty.');
                    }


                    if (flg == 0) {

                        //updatecol();
                        //saveform(_fdt);

                        updatecol(_fdt);

                    }
                },
                controlPosition: 'left',
                dataType: 'json',
                disabledActionButtons: ['data'],
                actionButtons: [{
                    id: 'btncancel',
                    className: 'btn btn-success',
                    label: 'Cancel',
                    type: 'button',
                    events: {
                        click: function () {
                            window.location.href = "Customforms";
                        }
                    }
                }],
                typeUserAttrs: {

                    autocomplete: {
                        //staticopt: {
                        //    label: 'Bind predefine option <span class="tooltip-element" tooltip="asdsadsadsadas" style="display: inline-block;">?</span>',
                        //    value: 'false',
                        //    type: 'checkbox'
                        //},
                        myatt: {
                            label: 'Powered by',
                            value: 'Minop',
                            readonly: "readonly"
                        },
                        selectedmaster: {
                            label: 'Search from masters',
                            options: {
                                'Company': 'Company',
                                'Branch': 'Branch',
                                'Policy': 'Policy',
                                'Department': 'Department',
                                'Designation': 'Designation',
                                'Employee': 'Employee',
                                'Device': 'Device',
                                'BU': 'BU',
                                'SBU': 'SBU'
                            }
                        },
                    },

                    select: {
                        staticopt: {
                            label: 'Bind predefine option <span class="tooltip-element" tooltip="asdsadsadsadas" style="display: inline-block;">?</span>',
                            value: 'false',
                            type: 'checkbox'
                        },
                        myatt: {
                            label: 'Powered by',
                            value: 'Minop',
                            readonly: "readonly"

                        },
                        master: {
                            label: 'Select from masters',
                            options: {
                                'Company': 'Company',
                                'Branch': 'Branch',
                                'Policy': 'Policy',
                                'Department': 'Department',
                                'Designation': 'Designation',
                                'Employee': 'Employee',
                                'Device': 'Device',
                                'BU': 'BU',
                                'SBU': 'SBU'
                            }
                        },
                    }
                },
                disabledSubtypes: {
                    button: ['button', 'reset']
                },

                disabledAttrs: ['access', 'className', 'description', 'other', 'value', 'name'],
                disableFields: [vrbtn, 'hidden', 'paragraph', 'header'],

                disabledFieldButtons: {
                    text: ['copy'],
                    'checkbox-group': ['copy'],
                    date: ['copy'],
                    header: ['copy'],
                    number: ['copy'],
                    'radio-group': ['copy'],
                    textarea: ['copy'],
                    select: ['copy'],
                    autocomplete: ['copy'],
                    button: ['copy'],
                    file: ['copy'],
                },
                fieldRemoveWarn: true,

            },
            formBuilder = $fbEditor.formBuilder(fbOptions);
            formBuilder.promise.then(function (fb) {
                fb.actions.setData(formData);
            });
        }
        else {

            var $fbEditor = $(document.getElementById('fb-editor')),
            $formContainer = $(document.getElementById('fb-rendered-form')),
            fbOptions = {
                onSave: function () {

                    var _fdt = formBuilder.formData;
                    var flg = 0;
                    var fn = $("#txtfrmdisplayname").val().trim();
                    var fms = $('#frmoperationparentid').val();
                    toastr.remove();
                    if (fms == 0) {
                        flg = 1
                        toastr.info('Please select parent menu.');
                    }
                    if (fn == '') {
                        flg = 1
                        toastr.info('Form name required.');
                    } else if (fn.length < 6) {
                        flg = 1
                        toastr.info('Form name should be more than 6 characters.');
                    }
                    else if (_fdt.length <= 0) {
                        flg = 1
                        toastr.info('Form shoud not be empty');
                    }

                    if (flg == 0) {
                        saveform(_fdt);
                        //formBuilder.actions.clearFields();
                    }
                },
                typeUserAttrs: {
                    autocomplete: {
                        myatt: {
                            label: 'Powered by',
                            value: 'Minop',
                            readonly: "readonly"
                        },
                        selectedmaster: {
                            label: 'Search from masters',
                            options: {
                                'Company': 'Company',
                                'Branch': 'Branch',
                                'Policy': 'Policy',
                                'Department': 'Department',
                                'Designation': 'Designation',
                                'Employee': 'Employee',
                                'Device': 'Device',
                                'BU': 'BU',
                                'SBU': 'SBU'
                            }
                        },
                    },

                    select: {
                        staticopt: {
                            label: 'Bind predefine option',
                            value: 'false',
                            type: 'checkbox',
                        },
                        myatt: {
                            label: 'Powered by',
                            value: 'Minop',
                            readonly: "readonly"

                        },
                        master: {
                            label: 'Select from masters',
                            options: {
                                'Company': 'Company',
                                'Branch': 'Branch',
                                'Policy': 'Policy',
                                'Department': 'Department',
                                'Designation': 'Designation',
                                'Employee': 'Employee',
                                'Device': 'Device',
                                'BU': 'BU',
                                'SBU': 'SBU'
                            }
                        },
                    },
                },
                controlPosition: 'left',
                disabledActionButtons: ['data'],
                disabledSubtypes: {
                    button: ['button', 'reset']
                },
                disabledAttrs: ['access', 'className', 'description', 'other', 'value', 'name'],
                disableFields: ['hidden', 'paragraph', 'header'],
                disabledFieldButtons: {
                    text: ['copy'],
                    'checkbox-group': ['copy'],
                    date: ['copy'],
                    header: ['copy'],
                    number: ['copy'],
                    'radio-group': ['copy'],
                    textarea: ['copy'],
                    select: ['copy'],
                    autocomplete: ['copy'],
                    button: ['copy'],
                },
            },

             formBuilder = $fbEditor.formBuilder(fbOptions);
        }



        function clerform() {
            $('#frmid').val(0);
            $("#txtfrmdisplayname").val('');
            $('#frmoperationparentid').val(0);
            formBuilder.actions.clearFields();
        }
    });


    $(document).ready(function () {
        $('input[type="text"]').on('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.keyCode == 86) {
                e.preventDefault();
                return false;
            }

        });

        //$('.fld-label form-control').on('keydown', function (e) {
        //    alert('hi');
        //    alert('hi');
        //    if ($(this).val() > 100
        //        && e.keyCode !== 46 // keycode for delete
        //        && e.keyCode !== 8 // keycode for backspace
        //       ) {
        //        e.preventDefault();
        //        $(this).val(100);
        //    }
        //});


        $('#txtfrmdisplayname').keydown(function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });

        $("#txtfrmdisplayname").keypress(function (e) {
            var keyCode = e.which;
            var Responce = validateKeyPress(keyCode);
            if (Responce == true) {
            }
            else { e.preventDefault(); }
        });
        $("#txtfrmdisplayname").blur(function () {
            var frmDisplayname = removeTags($("#txtfrmdisplayname").val());
            $("#txtfrmdisplayname").val(frmDisplayname);
        });
        document.oncontextmenu = function () { return false; };
        $(document).mousedown(function (e) {
            if (e.button == 2) {
                return false;
            }
            return true;
        });
    });

    function Deleterow(fieldId) {
        
                var t = "#" + fieldId.childNodes[4].firstElementChild.firstChild["htmlFor"];
                var m = "";
                if (t.indexOf("radio-group") != "-1") {
                    var _columnname = t.split("-preview");
                    m = _columnname[0].replace("#", "");
                }
                else if (t.indexOf("checkbox-group") != "-1") {
                    var _columnname = t.split("-preview");
                    m = _columnname[0].replace("#", "");
                }
                else {
                    m = $(t).attr("name").replace("-preview", "");
                }

                var obj = {
                    vfrmtblname: _frtbl,
                    vcolname: m,
                    vcollen: "",
                    visnull: "",
                    vcollable: "",
                    vcoltype: "delete",
                }
                arrobj.push(obj);

        }

    function saveform(_formdata) {
            var obj = {
                frmid: $('#frmid').val(),
                frmdisplayname: $("#txtfrmdisplayname").val().trim(),
                frmdata: _formdata,
                frmoperationparentid: $('#frmoperationparentid').val(),
            };
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + 'Customform/Addcustomform',
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    if (response != null) {
                        if (response.MegSts == 'ok') {
                            toastr.remove();
                            toastr.success(response.Meg, { timeOut: 3000 });
                            window.location.href = "Customforms";
                        }
                        else {
                            toastr.remove();
                            toastr.error(response.Meg, { timeOut: 3000 });
                        }
                    } else {
                        toastr.remove();
                        toastr.error(response.Meg, { timeOut: 3000 });
                    }
                    $("#ajax_loader").hide();
                },
                error: function (response) {
                    if (response != null) {
                        var obj = JSON.parse(response.responseText);
                        if (obj.MegSts == 'error') {
                            toastr.remove();
                            toastr.error("Requiring at least one filed.");
                        }
                    }
                    $("#ajax_loader").hide();
                }
            });
        }

    function updatecol(_fdt) {
            var obj = {
                lstcls: arrobj
            };

            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + 'Customform/OnUpdatecol',
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response != null) {
                        if (response == "true") {
                            toastr.remove();
                            toastr.success("Form updated successfully.", { timeOut: 3000 });
                        }
                        else if (response == false) {
                            toastr.remove();
                            toastr.error("Requiring at least one filed.", { timeOut: 3000 });
                            $("<div class='alert alert-danger overlay'><label>Error on update</label></div>").insertBefore("#frmbilder").fadeOut(3000);
                            return false;

                        }
                    } else {
                        toastr.remove();
                        toastr.error(response.Meg);
                    }
                   saveform(_fdt);
                },
                error: function (response) {
                    if (response != null) {
                        var obj = JSON.parse(response.responseText);
                        toastr.remove();
                        toastr.error("Error on customform.");
                    }
                    saveform(_fdt);
                }
            });
    }


</script>

