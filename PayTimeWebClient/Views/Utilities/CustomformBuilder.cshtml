<div class="row">
    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
        <div class="form-group ">
            <label class="control-label">Custom Form Name<span class="required" aria-required="true"> * </span></label>
            <input type="text" class="form-control" id="txtfrmdisplayname" name="txtfrmdisplayname" maxlength="45" placeholder="enter the custom form name">
            <input type="hidden" id="frmid" name="frmid" value="0">
            <span class="help-block" style="color:red;" hidden id="spfrmdisplayname"></span>
        </div>
    </div>
    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
        <div class="form-group">
            <label class="control-label">Select Parent Menu For Custom Form<span class="required" aria-required="true"> * </span></label>
            <select class="form-control" id="frmoperationparentid" name="frmoperationparentid">
                <option value="0" selected>Select Menu</option>
                @if (ViewBag.Mastermenulist != null)
                {
                    foreach (var item in ViewBag.Mastermenulist)
                    {
                        <option value="@item.OperationId">@item.OperationName</option>
                    }
                }
            </select>
            <span class="help-block" style="color:red;" hidden id="spfrmoperationparentid"></span>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div id="fb-editor" class="fb-edit"></div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div id="fb-rendered-form">
            <form action="#"></form>
            <button class="btn btn-default edit-form">Edit</button>
        </div>
    </div>
</div>
