@model ImportDeHiringfaillog
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "DeHiring";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _flgempover = ViewBag.flgempover;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    if (_flgempover == "true")
    {
        obj.CanAdd = false;
    }
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _compcode = HttpContext.Current.Session["cmpcode"].ToString();
}
<script>
     var compcode = '@_compcode';
    $(document).ready(function () {
        if ("@_Message" != "") {
            toastr.remove();
            toastr.success("@_Message");
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
        }
        $('#tblErrorRecords').DataTable({
            dom: 'Blfrtip', // Enables buttons
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: 'Download Excel',
                    title: 'Employee Data',
                    className: 'btn btn-success'
                }
            ]
        });
        $("#compcode").val('@_compcode');
        $("#FileUpload").change(function () {
            if ($("#FileUpload").val() != null) {
                var validExts = new Array(".xlsx", ".xls", ".csv");
                var fileExt = $("#FileUpload").val();
                if (fileExt != "") {
                    fileExt = fileExt.substring(fileExt.lastIndexOf('.'));
                    if (validExts.indexOf(fileExt) < 0) {
                        toastr.remove();
                        toastr.error("Invalid file selected, valid files are of " + validExts.toString() + " types.");
                        $("#FileUpload").val("");
                        return false;
                    }
                }
            }
        });

        $("#btnImport").click(function (event) {

            if (document.getElementById("FileUpload").files.length == 0) {
                toastr.remove();
                toastr.error("Please upload file.");
                event.preventDefault();
                return false;
            }

        })
    });
</script>

<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/AdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> DeHiring </span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/PayTime/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> DeHiring </span>
            </li>
        </ul>
    }

</div>

<div>
    @using (Html.BeginForm("DeHiring", "Utilities", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="portlet">
            <div class="portlet-body">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group margin-0">
                            <label>Select File<span class="required" aria-required="true"> * </span></label>
                            <div class="fileinput fileinput-new" data-provides="fileinput">
                                <div class="input-group">
                                    <div class="form-control uneditable-input input-fixed input" data-trigger="fileinput">
                                        <i class="fa-light fa-file"></i>&nbsp;
                                        <span class="fileinput-filename"> </span>
                                    </div>
                                    <span class="input-group-addon btn blue btn-file">
                                        <span class="fileinput-new"> Select File </span>
                                        <span class="fileinput-exists"> Change </span>
                                        <input type="file" name="FileUpload" id="FileUpload">
                                    </span>
                                    <a href="javascript:;" class="input-group-addon btn red fileinput-exists" data-dismiss="fileinput"> Remove </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <hr class="save_hr_line" />
                    </div>
                    <input type="hidden" name="compcode" id="compcode">
                    <div class="col-lg-12">
                        <div class="row">
                            <div class="col-lg-8">
                                <div class="row sample_sheet_box">
                                    <div class="col-lg-12">
                                        <p>Download the attached sample CSV, which can be used as a template to import your data into the application</p>
                                    </div>                                    
                                </div>
                            </div>
                            <div class="col-lg-4 text-right">
                                <a href="~/SampleXlFile/DeHiring.xlsx" class="btn green-dark linkexcel"><i class="fa-regular fa-file-excel"></i> Sample Sheet</a>
                                @*@if (obj.CanAdd)
        {*@
                                <button type="submit" id="btnImport" class="btn save_btn"><i class="fa-regular fa-upload"></i> Import</button>
                                @*}*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (Model != null && Model.DehiringError.Any())
    {
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <!-- Employee Datatable-->
                <div class="portlet" id="gridEmployee" >
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <table id="tblErrorRecords" class="table table-striped table-bordered table-hover table-checkable order-column">
                                    <thead>
                                        <tr>
                                            <th>EmpPunchID</th>
                                            <th>EmpName</th>
                                            <th>Startdate</th>

                                            <th hidden>CreatedDtFlag</th>

                                            <th>Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var emp in Model.DehiringError)
                                        {
                                            <tr>
                                                <td>@emp.EmpPunchID</td>
                                                <td>@emp.EmpName</td>
                                                <td>
                                                    @Convert.ToDateTime(emp.Startdate).ToString("dd-MM-yyyy HH:mm:ss")
                                                </td>
                                                <td hidden>@emp.CreatedDtFlag</td>
                                                <td>@emp.Reason</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }
    </div>