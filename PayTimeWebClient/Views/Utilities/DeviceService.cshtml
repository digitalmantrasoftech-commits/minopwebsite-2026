@model PayTimeWebClient.Models.DeviceService
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "DeviceService";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
   ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
   : "false"; // Default to "false" if the session is null
}
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script type="text/javascript">
    var count = 0;
    var form = "Device Service";
    var operation = "";
    $(document).ready(function () {
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        $(".alert").hide();
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }
        $('#tbldeviceService').DataTable();
        $("#AddDevice").click(function () {
            //frmClear();
            $("#AddDevice").attr("data-toggle", "modal");
            $("#AddDevice").attr("data-target", "#frmpopup");
        });
        $('#btnDeptSubmit').click(function () {
            count++;
            operation = "Download Services";
        })
        //$(".editclass").click(function (event) {
        $("#tbldeviceService").on('click', '.editclass', function () {
            var Accountcode = $(this).parent('td').parent('tr').children(1)[2].innerText;
            var Deviceserviceid = $(this).parent('td').parent('tr').children(1)[1].innerText;
            var Ipaddress = $(this).parent('td').parent('tr').children(1)[3].innerText;
            var Systemcode = $(this).parent('td').parent('tr').children(1)[4].innerText;
            var Iswhitelist = $(this).parent('td').parent('tr').children(1)[5].innerText;
            $.ajax({
                type: "POST",
                url: "/Utilities/Whitelistipaddress",
                datatype: "json",
                data: {
                    accountcode: Accountcode.trim(),
                    deviceserviceid: Deviceserviceid.trim(),
                    ipaddress: Ipaddress.trim(),
                    systemcode: Systemcode.trim(),
                    iswhitelist: Iswhitelist
                },
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    $(".loading").hide();
                    var obj = JSON.parse(response);
                    if (obj.MegSts == "ok") {
                        $(".alert-danger").hide();
                        $(".alert-success").text(obj.Meg);
                        $('.alert-success').fadeIn('fast').delay(2000).fadeOut('slow').show();
                        window.location.reload();
                    }
                    else {
                        $(".alert-success").hide();
                        $(".alert-danger").text(obj.Meg);
                        $('.alert-success').fadeIn('fast').delay(2000).fadeOut('slow').show();
                    }
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        });
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Device Services";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })
    });
</script>
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Device Service</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Device Service</span>
            </li>
        </ul>
    }
    <div class="page-toolbar">
        <div class="text-right">
            @using (Html.BeginForm("DeviceManagment", "Utilities", FormMethod.Post))
            {
                <button type="submit" id="btnDeptSubmit" class="btn download_btn"><i class="fa-regular fa-download"></i> Download Service</button>
            }
        </div>
    </div>
</div>
@if (obj.CanView)
{
    <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
    </div>
    <div class="portlet">
        <div class="portlet-body">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <table id="tbldeviceService" class="table table-striped table-bordered table-hover table-checkable order-column ">
                        <thead>
                            <tr>
                                <th>Sr. No</th>
                                <th hidden>DeviceServiceId</th>
                                <th>Account Code</th>
                                <th>IP Address</th>
                                <th>System Code</th>
                                <th>IsWhiteListed</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        @{int n = 1;}
                        <tbody>
                            @if (ViewBag.DeviceServicelist != null)
                            {
                                foreach (var i in ViewBag.DeviceServicelist)
                                {
                                    <tr class="odd gradeX">
                                        <td id="sr">@n</td>
                                        <td id="hdnDeviceServiceId" hidden>@i.Deviceserid</td>
                                        <td id="AccountCode">@i.AccountCode</td>
                                        <td id="IpAddress"> @i.IpAddress </td>
                                        <td id="SystemCode">@i.SystemCode</td>
                                        <td id="Iswhitelist">@i.Iswhitelist</td>
                                        <td id="Col_@i.Deviceserid">

                                            @if (i.Iswhitelist)
                                            {
                                                <button class="editclass btn btn-xs red" title="Remove from whitelist" id="RemoveWhilelist" style="width:100px;">Remove from whitelist</button>
                                            }
                                            else
                                            {
                                                <button class="editclass btn btn-xs green" title="Add to whitelist" id="AddWhitelist" style="width:100px;">Add to whitelist</button>
                                            }
                                        </td>
                                    </tr>
                                            n++;
                                }
                            }
                            else
                            {
                                <tr colspan="8" class="odd gradeX">No Data Available</tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
        
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>
