                    for (var i = 0; i < response.length; i++) {

                        var tbl = "<tr class='odd gradeX'>";

                        tbl = tbl + "<td>" + response[i].Code;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td>" + response[i].Name;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td>" + response[i].Department;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td>" + response[i].Date;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td>" + response[i].Shift;
