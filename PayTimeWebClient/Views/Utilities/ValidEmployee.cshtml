@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;

@{
    ViewBag.Title = "ValidEmployee";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    string IsSettingFlag = HttpContext.Current.Session["IsSetting"].ToString();
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<script type="text/javascript">
    $(document).ready(function () {

        var navListItems = $('div.setup-panel div a'),
            allWells = $('.setup-content');
        allWells.hide();
        navListItems.click(function (e) {
            e.preventDefault();
            var $target = $($(this).attr('href')),
                    $item = $(this);

            if (!$item.hasClass('disabled')) {
                navListItems.removeClass('btn-primary').addClass('btn-default');
                $item.addClass('btn-primary');
                allWells.hide();
                $target.show();
            }
        });
        $('#tblValidUser').DataTable();
        $('#tblInvalidUser').DataTable();
        $('#tblInvalidPunch').DataTable();
        $('div.setup-panel div a.btn-primary').trigger('click');
    });
</script>
<div class="page-bar">
    @if (_RoleId != 1)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Valid Employee</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Valid Employee</span>
            </li>
        </ul>
    }
</div>
@if (obj.CanView)
{
<div class="stepwizard">
    <div class="stepwizard-row setup-panel">
        <div class="stepwizard-step">
            <a href="#Step1" type="button" id="lnkValidUser" class="btn btn-primary btn-circle">Valid User</a>
        </div>
        <div class="stepwizard-step">
            <a href="#Step2" id="lnkInvalidEmp" type="button" class="btn btn-default btn-circle">Invalid User</a>
        </div>
        <div class="stepwizard-step">
            <a href="#Step3" id="lnkInvalidPunch" type="button" class="btn btn-default btn-circle">Invalid Punch</a>
        </div>
    </div>
</div>
<div class="row setup-content active" id="Step1">
    <table id="tblValidUser" class="table table-striped table-bordered table-hover table-checkable order-column">
        <thead>
            <tr>
                <th>Sr. No</th>
                <th hidden>Emp Id</th>
                <th>Emp code</th>
                <th>Emp Name</th>
                <th>Punch ID</th>
                <th hidden>BranchId</th>
                <th>Branch Name</th>
                <th hidden>Company Id</th>
                <th>Company Name</th>
            </tr>
        </thead>
        @{
            int n = 1;
        }
        <tbody>
            @if (ViewBag.validuser != null)
            {
                foreach (var i in ViewBag.validuser)
                {
                    <tr class="odd gradeX">
                        <td>@n</td>
                        <td id="EmpId1" hidden>@i.EmpId</td>
                        <td id="Empcode1">@i.Empcode</td>
                        <td id="EmpName1">@i.EmpName</td>
                        <td id="EmpPunchID1">@i.EmpPunchID</td>
                        <td id="Empbranch1" hidden>@i.BranchId</td>
                        <td id="EmpBranchName">@i.BranchName</td>
                        <td id="EmpCompanyId" hidden>@i.CompanyId</td>
                        <td id="EmpCompanyName">@i.CompanyName</td>
                    </tr>


                            n++;
                }
            }
        </tbody>
    </table>
</div>

<div class="row setup-content" id="Step2">
        <table id="tblInvalidUser" class="table table-striped table-bordered table-hover table-checkable order-column">
            <thead>
                <tr>
                    <th>Sr. No</th>
                    <th hidden>Emp Id</th>
                    <th>Emp code</th>
                    <th>Emp Name</th>
                    <th>Punch ID</th>
                    <th hidden>BranchId</th>
                    <th>Branch Name</th>
                    <th hidden>Company Id</th>
                    <th>Company Name</th>
                </tr>
            </thead>
            @{
                int j = 1;
            }
            <tbody>
                @if (ViewBag.Invaliduser != null)
            {
                foreach (var i in ViewBag.Invaliduser)
                {
            <tr class="odd gradeX">
                <td>@j</td>
                        <td id="EmpId1" hidden>@i.EmpId</td>
                        <td id="Empcode1">@i.Empcode</td>
                        <td id="EmpName1">@i.EmpName</td>
                        <td id="EmpPunchID1">@i.EmpPunchID</td>
                        <td id="Empbranch1" hidden>@i.BranchId</td>
                        <td id="EmpBranchName">@i.BranchName</td>
                        <td id="EmpCompanyId" hidden>@i.CompanyId</td>
                        <td id="EmpCompanyName">@i.CompanyName</td>
                    </tr>


                    j++;
                }
            }
            </tbody>
        </table>
    </div>

<div class="row setup-content" id="Step3">
    <table id="tblInvalidPunch" class="table table-striped table-bordered table-hover table-checkable order-column">
        <thead>
            <tr>
                <th>Sr. No</th>
                <th>Device UserId</th>
                <th>Enroll No</th>
                <th hidden>DeviceId</th>
                <th>Device Name</th>
                <th>Device SrNo</th>
                <th>Device Code</th>
                <th>Device IP</th>
                <th hidden>DeviceType</th>
                <th>DeviceType Name</th>
            </tr>
        </thead>
        @{
            int x = 1;
        }
        <tbody>
            @if (ViewBag.InvalidPunch != null)
            {
                foreach (var i in ViewBag.InvalidPunch)
                {
                    <tr class="odd gradeX">
                        <td>@x</td>
                        <td id="DeviceUserId">@i.DeviceUserId</td>
                        <td id="EnrollNo">@i.EnrollNo</td>
                        <td id="DeviceId" hidden>@i.DeviceId</td>
                        <td id="DeviceName">@i.DeviceName</td>
                        <td id="DeviceSrNo">@i.DeviceSrNo</td>
                        <td id="DeviceCode">@i.DeviceCode</td>
                        <td id="DeviceIP">@i.DeviceIP</td>
                        <td id="DeviceType" hidden>@i.DeviceType</td>
                        <td id="DeviceTypeName">@i.DeviceTypeName</td>
                    </tr>


                    x++;
                }
            }
        </tbody>
    </table>
</div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}

