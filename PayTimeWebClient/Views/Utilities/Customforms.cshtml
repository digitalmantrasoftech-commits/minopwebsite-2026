@{
    ViewBag.Title = "Custom Forms";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _companyid = HttpContext.Current.Session["CompanyId"].ToString();
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script type="text/javascript">
    var count = 0;
    var form = "Custom Forms";
    var operation = "";
    function frmedit(_frmid, _frmdata, _frmdisp, _frmmop, _frmtblname) {
        $('#frmid').val(_frmid);
        $('#frmdisplayname').val(_frmdisp);
        $('#frmdata').val(_frmdata);
        $('#frmoperationparentid').val(_frmmop);
        $('#tblname').val(_frmtblname);
        $('#frmcustm').submit();

    }
    function Displaycontrol(_id) {
        var ctnname = 'controlpenal_' + _id;
        var x = document.getElementById('' + ctnname + '');        
    }
    function Hidediv(_) {
        //$('.divctl').hide();
    }
    $(document).ready(function () {
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize(); 
        //$('#tbllstcustomform').DataTable();

        //var t = $('#tbllstcustomform').DataTable(
		//	{
		//	    "processing": true,
		//	    "columnDefs": [
        //        	{
		//			    "targets": 5,
		//			    "data": null
		//			},
		//			{
		//			     "searchable": false,
		//			     "orderable": false,
		//			     "targets": 0
		//			 }],
			    
		//	});
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Custom Forms";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })
    });


</script>

<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            @if (Convert.ToInt32(Session["IsSchool"]) == 1)
            {
                <li>
                    <a href="/School/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                </li>
            }
            else
            {
                <li>
                    <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
                </li>
            }
            <li>
                <span><i class="fa-light fa-angle-right"></i> Custom Forms</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Custom Forms</span>
            </li>
        </ul>
    }

    <div class="page-toolbar">
        <div class="text-right">
            <a class="btn icon_transparent_btn tooltips" id="btn_Create_Form" href="CustomformBuilder" data-placement="left" data-original-title="Create New Form"><i class="fa-solid fa-plus button"></i></a>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        @if (ViewBag.lstcustomform != null)
