                                {

                                    @*<tr onmouseover="Displaycontrol('@i.frmid')" hidden>
                            <td hidden> <i class="fa-regular fa-file" style="color:blue;"></i> </td>
                            <td style="text-align:left;">
                                &nbsp;<i class="fa-regular fa-file"></i>&nbsp;@i.frmdisplayname
                            </td>
                            <td>
                                @i.frmCustomField
                            </td>
                            <td width="30%" hidden>
                                <small>  @i.frmcreatedate</small>
                            </td>
                            <td width="10%">
                                <div id="controlpenal_@i.frmid" class="divctl">
                                    <a href="javascript:void(0);" title="Edit Form" onclick="frmedit('@i.frmid', '@i.frmdata', '@i.frmdisplayname', '@i.frmoperationparentid','@i.frmtblname')"
                                       style="cursor:pointer;"
                                       class='btn editclass'>
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>*@
                                    <tr onmouseover="Displaycontrol('@i.frmid')">
                                        <td>
                                            <div class="form_box" id="controlpenal_@i.frmid">
                                                <span class="form_icon"><i class="fa-regular fa-file-lines"></i></span>
                                                <h4>@i.frmdisplayname</h4>
                                                <a class="form_edit_btn" href="javascript:void(0)" style="display:none;" title="Edit Form" onclick="frmedit('@i.frmid', '@i.frmdata', '@i.frmdisplayname', '@i.frmoperationparentid','@i.frmtblname')"><i class="fa-regular fa-pen-to-square tooltips" data-placement="top" data-original-title="Edit"></i></a>
                                                <p>Created on : <span style="font-size : 12px"> @i.frmcreatedate <i class='fa-regular fa-circle-info tooltips' data-placement='top' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097; font-size: 13px;'></i></span></p>
                                                <p>Created fields : <span style="font-size : 12px">@i.frmCustomField</span></p>
                                                <ul style="display:none;">
