                <a href="#" class="list-group-item list-group-item-action flex-column align-items-start active">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">Data Not Available</h5>
                    </div>
                </a>
            </div>
        }
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <form method="post" action="CustomformBuilder" id="frmcustm" name="frmcustm">
            <input type="hidden" id="frmid" name="frmid" />
            <input type="hidden" id="frmdisplayname" name="frmdisplayname" />
            <input type="hidden" id="frmdata" name="frmdata" />
            <input type="hidden" id="frmoperationparentid" name="frmoperationparentid" />
            <input type="hidden" id="tblname" name="tblname" />
            <input type="hidden" id="frmCustomField" name="frmCustomField" />
        </form>
    </div>
</div>
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <hr />
    </div>
</div>




<style type="text/css">
    @@import url("../Newlayout/css/CustomDesign/Customforms.css");
</style>