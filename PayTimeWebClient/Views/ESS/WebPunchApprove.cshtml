            if ($("#selectstatus").val() == "3") {
                $("#allnoteid").show();
            }
            else {
                $("#allnoteid").hide();
            }
            $('#tblWebpunchApproval').destroy;
            $("#dataTables_tbl_header").remove();
            $("#noteid").hide();

            t = $('#tblWebpunchApproval').DataTable({
                // processing: true,
                serverSide: true,
                "ajax": ({
                    "url": "/Ess/webpunchAjaxFilter?FilterFromDate=" + FilterFromDate + "&FilterToDate=" + FilterToDate + "&selectstatus=" + selectstatus + "&Isheararchy=" + '@_hierchywis',
