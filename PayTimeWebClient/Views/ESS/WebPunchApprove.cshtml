                        } else if (jqXHR.status == 0 && thrownError == "") {
                            window.location.href = "/PayTime/LoginPage";
                        }
                    },
                }),
                "language": {
                    "search": "Search",
                    "searchplaceholder": "Search..."
                },
                order:
                [
                    [1, 'desc']
                ],
                searching: true,
                searchDelay: 500,
                "bDestroy": true,
                //dom: 'lBfrtip',
                dom: _domCommon,
                language: _languageCommon,
                buttons: [
                    {
                        //extend: 'excelHtml5',
                        //exportOptions: {
                        //    columns: [3, 4, 5, 6, 7, 8,9]
                        //}
                    }
                ],
                "columns": [
                    { "data": "" },
                    { "data": "WebpunchId" },
                    { "data": "Empid" },
                    { "data": "EmpName" },
                    {
                        "data": "Attn_Dt",
                        "render": function (data) {
                            var date = eval(("new " + data).replace(/\//g, "")),
                            month = date.getMonth() + 1;
                            if (month < 10) {
                                month = '0' + month;
                            }
                            var day = date.getDate();
                            if ("@_isdateformat" == "dd-mm-yyyy") {
                                return (day > 9 ? day : "0" + day) + "-" + month + "-" + date.getFullYear();
                            }
                            else if ("@_isdateformat" == "yyyy-mm-dd") {
                                return date.getFullYear() + "-" + month + "-" + (day > 9 ? day : "0" + day);
                            }
                            else if ("@_isdateformat" == "mm-dd-yyyy") {
                                //return date.getFullYear() + "-" + month + "-" + (day > 9 ? day : "0" + day);
                                return month + "-" + (day > 9 ? day : "0" + day) + "-" + date.getFullYear();
                            }
                            else if ("@_isdateformat" == "yyyy-M-dd") {
                                var date = eval(("new " + data).replace(/\//g, ""));
                                var locale = "en-us";
                                var month = date.toLocaleString(locale, { month: "short" });
                                var day = date.getDate();
                                return date.getFullYear() + "-" + month + "-" + (day > 9 ? day : "0" + day);
                            }
                            else if ("@_isdateformat" == "M-dd-yyyy") {
                                var date = eval(("new " + data).replace(/\//g, ""));
                                var locale = "en-us";
                                var month = date.toLocaleString(locale, { month: "short" });
                                var day = date.getDate();
                                return month + "-" + (day > 9 ? day : "0" + day) + "-" + date.getFullYear();
                            }
                            else if ("@_isdateformat" == "dd-M-yyyy") {
                                var date = eval(("new " + data).replace(/\//g, ""));
                                var locale = "en-us";
                                var month = date.toLocaleString(locale, { month: "short" });
                                var day = date.getDate();
                                return (day > 9 ? day : "0" + day) + "-" + month + "-" + date.getFullYear();
                            }
                        }
                    },
                    {
                        "data": "In_Out_Time",
                        "render": function (data) {
                            var dt = eval(("new " + data).replace(/\//g, ""));
                            return (dt.getHours() < 10 ? '0' : '') + dt.getHours() + ":" + (dt.getMinutes() < 10 ? '0' : '') + dt.getMinutes() + ":" + (dt.getSeconds() < 10 ? '0' : '') + dt.getSeconds();
                        }
                    },
                    { "data": "Mode" },
                    {
                        "data": "Reason",
                    },
                    { "data": "LocAddress" },
                    { "data": "IsApprove" },
                    { "data": "Empcode" },
                    { "data": "ApprovalDate" },
                    { "data": "ReportingName" },
                ],
                "columnDefs": [
                    {
                        "targets": [1, 2, 7],
                        "visible": false
                    },
                    {
                        'targets': 0,
                        'bSortable': false,
                        "render": function (data, type, full, meta) {
                            var selectstatus = $("#selectstatus").val();
