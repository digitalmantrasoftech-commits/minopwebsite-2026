       // Function to send attendance reminder notification
        function sendReminderNotification(params, successCallback, errorCallback) {
            debugger
            const requestData = {
                EmpId: params.EmpId,
                AttCorrectionID: params.AttCorrectionID
            };

            $.ajax({
                url: '@_webapiurl' + "NotificationRuleDetails/Remindernotificationattendence",
                type: 'POST',
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(requestData),
                success: function (response) {
                    console.log("Notification sent successfully:", response);

                    if (typeof successCallback === 'function') {
                        successCallback(response);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Notification sending failed:", error);
                    console.warn("Response:", xhr.responseText);

                    if (typeof errorCallback === 'function') {
                        errorCallback(xhr, status, error);
                    }
                }
            });
        }

        // Use event delegation with class selector (not ID)
        $(document).on('click', '.btnnotification', function () {
            debugger
            var $row = $(this).closest('tr');
            var AttCorrectionId = $row.find('td:eq(1)').text().trim();

            Swal.fire({
                title: `<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_info.svg' alt=''> Notification`,
                html: `
            <div class="swal_subtitle">
                <b>Are you sure you want to send this notification?</b>
                <p>Once sent, the selected user will immediately receive this notification.</p>
                <p><b>Note:</b> This action cannot be undone.</p>
            </div>
        `,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No, Cancel',
                confirmButtonText: 'Yes, Send Notification',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const $btn = $(this); 
                    $btn.prop('disabled', true);

                    const notifyParams = {
                        EmpId: id, 
                        AttCorrectionID: AttCorrectionId
                    };

                    // Send the notification
