    </div>
    <div class="row">
        @*<div id='ajax_loader' class="loading" style="display: none;">
                <img src="~/LandingAssets/images/loading.gif" style="margin-top: 8%; cursor: auto; width: 30%; vertical-align: text-bottom;" />
            </div>*@
        <div class="col-md-12">
            <div class="portlet">

                <div class="portlet-body">
                    @if (ViewBag.getallappliedattnd.Count > 0)
                    {
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tblAttendancecorrection" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column ">
                                <thead>
                                    <tr>
                                        <th style="display:none;">Sr. No</th>
                                        <th hidden>AttendanceCorrectionID</th>
                                        <th>Employee</th>
                                        <th>Punch Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                        <th>In Punch</th>
                                        <th>Out Punch</th>
                                        <th>Apply Reason</th>
                                        <th>Approve Reason</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                @{
                                    int n = 1;
                                }
                                <tbody>
                                    @if (ViewBag.getallappliedattnd != null)
                                    {
                                        foreach (var item in ViewBag.getallappliedattnd)
                                        {
                                            <tr>
                                                <td hidden>@n</td>
                                                <td hidden>@item.AttCorrectionId</td>
                                                <td>@item.empname</td>
                                                <td>@item.PunchDate</td>
                                                <td>@item.InPunchTime</td>
                                                <td>@item.OutPunchTime</td>
                                                <td>@item.ApplyReason</td>
                                                <td>@item.ApprovalReason</td>
                                                <td>@item.StatusName</td>
                                                <td id="Col_@item.AttCorrectionId">
                                                    @if (_RoleId == 1 && item.Status == 3)
                                                    {
                                                        <a href="javascript:;" class="btn red_btnnew tooltips btnnotification"data-bs-toggle="tooltip" data-bs-placement="top" title="Notification" data-id="@item.AttCorrectionId"> <i class="fa-light fa-bell"></i> </a>
                                                        <a href="javascript:;" class="btn blue_btnnew tooltips editclass" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><i class="fa-regular fa-pen-to-square"></i> </a>
                                                    }
                                                    else if (_RoleId > 1 && obj.CanEdit && _RoleId != 6805 && _RoleId != 6806 && item.Status == 3)
                                                    {
                                                        <a href="javascript:;" class="btn red_btnnew tooltips btnnotification" data-bs-toggle="tooltip" data-bs-placement="top" title="Notification" data-id="@item.AttCorrectionId"> <i class="fa-light fa-bell"></i> </a>
                                                        <a href="javascript:;" class="btn blue_btnnew tooltips editclass" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"> <i class="fa-regular fa-pen-to-square"></i> </a>
                                                        <a href="javascript:;" class="btn red_btnnew tooltips cancel_btn"  data-bs-toggle="tooltip" data-bs-placement="top" title="Cancel">  <i class="fa-solid fa-xmark"></i> </a>
                                                    }
                                                </td>
                                            </tr>
                                            n++;
                                        }
                                    }
                                </tbody>

                            </table>
                        </div>
                    }
                    else
                    {
                        <div id="NotificationGrid-empty">
                            <div class="datanotfound">
                                <img src="~/assets/images/emptyscreen_1.png" height="148" width="280" alt="Nodata Found Icon">
                                <p class="datanotfound_title">No data found</p> <!-- titleText -->
                                <p class="">No entries found. Please add a record to get started.</p><!-- subText -->
                            </div>
                        </div>
                    }
                    <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                        <div class="modal-dialog">
                            <!-- Modal content-->
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Attendance Correction</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="alert alert-danger popMsg" hidden>
                                        <a href="#" class="close" data-dismiss="alert">&times;</a>
                                        <strong id="strstg">Error ! </strong> @_error
                                    </div>
                                    <div class="modal-card">
                                        <div class="row setup-content" id="step-1">
                                            <fieldset>
                                                <input type="hidden" id="AttCorrectionId">
                                                <input type="hidden" id="EmpId" value="@Convert.ToInt32(Session["EmpId"])">
                                                <div class="col-md-12">
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="form-group data_picker_box">
                                                                <label>Select Date<span class="required" aria-required="true"> * </span></label>
                                                                <div class="input-group input-group-sm  date date-picker" data-date="@DateTime.Now" data-date-end-date="0d" data-date-format="@_isdateformat" data-date-viewmode="years">
                                                                    <span class="input-group-btn">
                                                                        <button class="btn default" type="button">
                                                                            <i class="fa-light fa-calendar-days"></i>
                                                                        </button>
                                                                    </span>
                                                                    @if (_isdateformat == "dd-M-yyyy" || _isdateformat == "M-dd-yyyy" || _isdateformat == "yyyy-M-dd")
                                                                    {
                                                                        <input type="text" class="form-control" id="fromdate" name="fromdate" placeholder="@_isdateformat.Replace("M","MMM")" readonly="readonly" autocomplete="off">
                                                                    }
                                                                    else
                                                                    {
                                                                        <input type="text" class="form-control" id="fromdate" name="fromdate" placeholder="@_isdateformat" readonly="readonly" autocomplete="off">
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <label>IN Time <span class="required" aria-required="true"> *(24 Hr) </span></label>
                                                                <a class="tooltips" data-placement="bottom" title="Set in time in 24hr format">
                                                                    <i class="fa-regular fa-circle-info tooltips"></i>
                                                                </a>
                                                                <div class="input-group input-group-sm" id="OutDiv">
                                                                    <input type="text" class="form-control timepicker timepicker-24" data-minute-step="1" id="InPunchTime" name="InPunchTime" placeholder="00:00">
                                                                    <span class="input-group-btn">
                                                                        <button class="btn default" type="button" id="btnouttime">
                                                                            <i class="fa-regular fa-clock tooltips"></i>
                                                                        </button>
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="form-group">
                                                                <label>OUT Time <span class="required" aria-required="true"> *(24 Hr) </span></label>
                                                                <a class="tooltips" data-placement="bottom" title="Set out time in 24hr format">
                                                                    <i class="fa-regular fa-circle-info"></i>
                                                                </a>
                                                                <div class="input-group input-group-sm" id="OutDiv">
                                                                    <input type="text" class="form-control timepicker timepicker-24" data-minute-step="1" id="OutPunchTime" name="OutPunchTime" placeholder="00:00">
                                                                    <span class="input-group-btn">
                                                                        <button class="btn default" type="button" id="btnouttime">
                                                                            <i class="fa-regular fa-clock"></i>
                                                                        </button>
                                                                    </span>
                                                                </div>
                                                            </div>


                                                            @*<div class="form-group">
                                                                    <label>Out Time<span class="required" aria-required="true"> * </span></label>

                                                                    <input type="time" class="form-control input-sm" id="OutPunchTime" name="OutPunchTime" value="00:00" required="">

                                                                </div>*@
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <label id="lblreason">Reason</label>
                                                        <textarea id="ApplyReason" name="ApplyReason" class="form-control input-sm" maxlength="100"></textarea>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 form-actions text-right">
                                            <button type="button" id="btnSave" class="btn btn-sm blue"><i class="fa-light fa-floppy-disk"></i> Save</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
