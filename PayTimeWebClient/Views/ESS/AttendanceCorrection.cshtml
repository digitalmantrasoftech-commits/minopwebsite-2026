                        notifyParams,
                        function (response) {
                            toastr.remove();
                            if (response.status === "Success") {
                                toastr.success("Reminder notification sent successfully.");
                            }
                            else if (response.status === "Already") {
                                toastr.info("Reminder already sent today.");
                            }
                            else if (response.status === "Fail") {
                                toastr.error("Failed to send reminder notification.");
                            }
                            else {
                                toastr.warning("Something went wrong. Please try again.");
                            }

                        },
                        function (xhr, status, error) {
                            toastr.error("Failed to send notification");
                        }
                    );


                    setTimeout(() => $btn.prop('disabled', false), 2000);
                }
            });
        });

        function sendAttedanceRequestNotification(params, successCallback, errorCallback)
        {
            //?? Call to send notification (Backend API call)
            $.ajax({
                url: '@_webapiurl' + "NotificationRuleDetails/AttedanceCorrectionRequestNotification",
