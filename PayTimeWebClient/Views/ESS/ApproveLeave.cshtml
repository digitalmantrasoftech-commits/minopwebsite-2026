@model PayTimeWebClient.Models.LeaveList
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Approval";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _EmpId = Convert.ToInt32(HttpContext.Current.Session["EmpId"]);
    int _hierchywis = Convert.ToInt32(HttpContext.Current.Session["Ishierchy"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _lockAttendanceDay = HttpContext.Current.Session["lockAttendanceDay"].ToString();
    string _PlanId = HttpContext.Current.Session["planId"].ToString();
    int activeTab = 0;

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
? HttpContext.Current.Session["IsClientDBMatch"].ToString()
: "false"; // Default to "false" if the session is null

}
<style>
    /* Default styles for the image */
    .zoom-image {
        border-radius: 50%;
        width: 54px;
        height: 54px;
        transition: transform 0.5s; /* Smooth zoom transition */
    }

        /* Style for the image when hovered */
        .zoom-image:hover {
            transform: scale(2.5); /* Increase the size to zoom in */
        }

    .tab-content > .active {
        padding: 0;
    }

    .approvaloption .nav-tabs {
        border-bottom: none;
    }

        .approvaloption .nav-tabs > li > a {
            margin: 0;
            padding: 2px 10px 2px 10px;
            font-size: 14px;
            background-color: transparent;
            border: 1px solid transparent;
            color: #666666;
            margin-right: 10px;
        }

            .approvaloption .nav-tabs > li > a:hover, .approvaloption .nav-tabs > li > a:focus {
                color: #000000;
                border-bottom: 2px solid #a9a9a9 !important;
            }

        .approvaloption .nav-tabs > li.active > a {
            background-color: transparent;
            color: #000000;
            border-bottom: 2px solid #a9a9a9 !important;
            border-color: transparent;
        }
</style>
<script src="~/Pages_JS/VirtuallScroll/ServerSideMultiSelectDropDown.js"></script>

<div class="page-bar" style="display: none">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                @if (isClientDBMatchFlag == "True")
                {
                    <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                }
                else
                {
                    <a href="/Dashboard/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                }
            </li>
            <li><span><i class="fa-light fa-angle-right"></i> Attendance Regularization</span></li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li><a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a></li>
            <li><span><i class="fa-light fa-angle-right"></i> Attendance Regularization</span></li>
        </ul>
    }
</div>

<div id="ajax_loaderbranch" class="modal_bg loading" aria-hidden="true" style="z-index: 11111; display: none;">
    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
</div>

<div class="approvaloption">
    <ul class="nav nav-tabs nav-tabs-custom" role="tablist">
        <li class="nav-item  active">
            <a class="nav-link" id="tab1" data-toggle="tab" href="#leavetab_1" role="tab" aria-selected="false" data-url="@Url.Action("LeaveApproval", "ESS")">
                <span class="d-block d-sm-none"></span>
                <span class="d-none d-sm-block"><i class="fa-regular fa-check"></i> Approve Leave</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="tab2" data-toggle="tab" href="#attendancetab_2" role="tab" aria-selected="true" data-url="@Url.Action("AttendanceApproval", "ESS")">
                <span class="d-block d-sm-none"></span>
                <span class="d-none d-sm-block"><i class="fa-light fa-calendar-check"></i> Approve Attendance</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="tab3" data-toggle="tab" href="#webpunchtab_3" role="tab" aria-selected="false" data-url="@Url.Action("WebPunchApproval", "ESS")">
                <span class="d-block d-sm-none"></span>
                <span class="d-none d-sm-block"><i class="fa-light fa-desktop"></i> Approve Webpunch</span>
            </a>
        </li>
        <li class="nav-item" style="display: none">
            <a class="nav-link" id="tab4" data-toggle="tab" href="#facepunchtab_4" role="tab" aria-selected="false" data-url="@Url.Action("FacePunchApproval", "ESS")">
                <span class="d-block d-sm-none"></span>
                <span class="d-none d-sm-block"><i class="fa-light fa-mobile" style="font-size:18px; top: 3px; position: relative;"></i> Approve Facepunch</span>
            </a>
        </li>
    </ul>
    <div class="tab-content tab_content_box">

        <div class="tab-pane  active" id="leavetab_1" role="tabpanel">
        </div>
        <div class="tab-pane" id="attendancetab_2" role="tabpanel">
        </div>
        <div class="tab-pane" id="webpunchtab_3" role="tabpanel">
        </div>
        <div class="tab-pane" id="facepunchtab_4" role="tabpanel">
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Function to load the content of the active tab via AJAX
       
        $('.nav-link').click(function () {
            checkSession();
        })
        function loadTabContent(tab) {

            var url = $(tab).data('url'); // Get the URL to load content from
            var target = $(tab).attr('href'); // Get the target pane selector (e.g., #leavetab_1)

            // Clear content of all tab panes before loading new content
            $('.tab-pane').empty();
            sessionStorage.removeItem('activeTab');
            // Load content for the active tab into the corresponding tab-pane
            $(target).load(url, function () {
                // Optionally, run any additional JS here after loading
            });
        }

        // Check for a previously stored active tab in sessionStorage
        var activeTab = sessionStorage.getItem('activeTab');

        if (activeTab) {
        
            // Find the tab element using the stored value (e.g., #attendancetab_2)
            var tabToActivate = $('.nav-tabs a[href="' + activeTab + '"]');

            // Activate the tab first, then load its content
            if (tabToActivate.length) {
                tabToActivate.tab('show'); // Activate the stored tab
                loadTabContent(tabToActivate); // Load content for the activated tab
            }

            // Clear the session storage value after activation

        } else {
            // If no tab is stored, activate and load the content of the first tab by default
            var firstTab = $('.nav-tabs .nav-item.active .nav-link');
            loadTabContent(firstTab);
        }

        // Handle tab clicks to load content dynamically
        $('.nav-tabs a').on('click', function (e) {
            e.preventDefault(); // Prevent the default behavior (e.g., URL change)

            var tab = $(this); // The clicked tab
            var target = tab.attr('href'); // Get the target tab-pane selector (e.g., #leavetab_1)

            // Store the active tab in sessionStorage (for persistence across reloads/redirects)
            sessionStorage.setItem('activeTab', target);

            // Load the content for the clicked tab
            loadTabContent(tab);
        });
    });

    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
</script>

