        $("#tblAttendanceApproval").on('click', '.approve', function () {

            checkSession();
            $("#ApprovalReason").removeClass('field_error');
            $("#ApprovalReason").val("");
            if ('@_RoleId' == 1) {
                $("#ApprovalReason").val("Approved by admin");
            }
             if ('@_RoleId' == 6805) {
                $("#ApprovalReason").val("Approved by companyadmin");
            }
             if ('@_RoleId' == 6806) {
                $("#ApprovalReason").val("Approved by branchadmin");
            }
            $("#AttCorrectionId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
            $("#EmpId").val($(this).parent('td').parent('tr').children(1)[2].innerText);
            if ("@_isdateformat" == "dd-mm-yyyy") {
                var attnDt = $(this).parent('td').parent('tr').children(1)[5].innerText.split("-");
                $("#attn_dt").val(attnDt[2] + "-" + attnDt[1] + "-" + attnDt[0]);
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                var attnDt = $(this).parent('td').parent('tr').children(1)[5].innerText.split("-");
                $("#attn_dt").val(attnDt[2] + "-" + attnDt[0] + "-" + attnDt[1]);
            }
            else if ("@_isdateformat" == "yyyy-mm-dd") {
                var attnDt = $(this).parent('td').parent('tr').children(1)[5].innerText.split("-");
                $("#attn_dt").val(attnDt[0] + "-" + attnDt[1] + "-" + attnDt[2]);
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {
                var attnDt = $(this).parent('td').parent('tr').children(1)[5].innerText.split("-");
                var getMonth = attnDt[1];
                $("#attn_dt").val(attnDt[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + attnDt[0]);
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {
                var attnDt = $(this).parent('td').parent('tr').children(1)[5].innerText.split("-");
                var getMonth = attnDt[0];
