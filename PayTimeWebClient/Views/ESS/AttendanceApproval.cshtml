                        <span id="allnoteid" style="display: none; color: red; font-size: 12px; font-weight: 400;"> Note:This option is exclusively intended for viewing purposes and does not involve any operations or actions.</span>
                    </div>
                    <div>
                        <span id="prv_Date" style="display: none; color: red; font-size: 12px; font-weight: 400"></span>
                    </div>
                </div>
                <div class="appoval_actionbtn" id="appactionbtn" style="display:none">
                    <button type="button" id="btnactive" class="btn icon_btn tooltips" data-placement="top" data-original-title="Approve"><i class="fa-solid fa-check"></i></button>
                    <button type="button" id="btnDeactive" class="btn clear_btn margin-left-5 tooltips" data-placement="top" data-original-title="Reject"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div id="tblempty">
                    <div class="table-responsive" id="tableResponsive">
                        <table id="tblAttendanceApproval" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column ">
                            <thead>
                                <tr>
                                    @*<th>Sr. No</th>*@
                                    <th style="align-content:center" class="left-fixed-column"><input type="checkbox" id="selectall"></th>
                                    <th hidden>Attendance ID</th>
                                    <th hidden>Employee ID</th>
                                    <th class="left-fixed-column-1">Employee</th>
                                    <th>Request Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                    <th>Correction Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                    <th>In Time</th>
                                    <th>Out Time</th>
                                    <th>Apply Reason</th>
                                    <th>Approval Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                    <th>Reason</th>
                                    <th>Status</th>
                                    <th>EmpCode</th>
                                    <th>Reporting Person</th>
                                    <th style="min-width:100px;" class="right-fixed-column">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div id="NotificationGrid-empty" style="display: none">
                    <div class="datanotfound">
                        <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="Nodata Found Icon">
                        <p class="datanotfound_title">No data found</p> <!-- titleText -->
                        <p class="">No matching records found for the selected filters.</p><!-- subText -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Datatable Block : End -->
    <!-- Filter Block : Begin -->
    <div class="portlet filter_boxModal">
        <div class="filterbox_header">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="filter-title">Filters</h4>
                <button type="button" class="filterclose_btn"><i class="fa-light fa-xmark"></i></button>
            </div>
        </div>
        <div class="filterbox_body">
            <div class="col-lg-12">
                <label class="control-label">From Date <span class="required" aria-required="true"> * </span></label>
                <div class="input-group date date-picker margin-bottom-10" data-date-format="yyyy-mm-dd" data-date-end-date="0d" data-date-viewmode="years">

                    <span class="input-group-btn">
                        <button class="btn default btn-sm" type="button">
                            <i class="fa-light fa-calendar-days"></i>
                        </button>
                    </span>
                    <input type="text" id="FilterFromDate" class="form-control input-sm" autocomplete="off" onchange="FilterFromDate()">
                </div>
            </div>
            <div class="col-lg-12">
                <label class="control-label">To Date <span class="required" aria-required="true"> * </span></label>
                <div class="input-group date date-picker margin-bottom-10" data-date-format="yyyy-mm-dd" data-date-end-date="0d" data-date-viewmode="years">
                    <span class="input-group-btn">
                        <button class="btn default btn-sm" type="button" id="frmtodate">
                            <i class="fa-light fa-calendar-days"></i>
                        </button>
                    </span>
                    <input type="text" id="FilterToDate" class="form-control input-sm" autocomplete="off" onchange="FilterToDate()">
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group">
                    <label>Status <span class="required" aria-required="true"> * </span></label>
                    <select class="form-control input-sm select2" id="selectstatus" name="selectstatus">
                        <option value="4">All</option>
                        <option value="1">Approved</option>
                        <option value="3" selected>Pending </option>
                        <option value="2">Rejected</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-12" id="Select_Atn_EmployeeContainer">
                <div class="form-group">
                    <label class="control-label">Employee</label>
                    <input type="text" id="txt2" value="0" hidden />
                    <select id="Select_Atn_Employee" class="mt-multiselect btn-sm btn blue btn-outline" aria-haspopup="true" aria-expanded="false" multiple="multiple" data-width="100%"></select>
                </div>
            </div>            
        </div>
        <div class="filterbox_footer">
            <div class="text-right">
                <button type="button" id="SearchFilter" class="btn icon_btn tooltips" data-placement="top" data-original-title="Search Filters"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
        </div>
    </div>
    <!-- Filter Block : End -->

</div>

<!-- Modal : Begin -->
<div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Employee's Attendance Correction </h4>
            </div>
            <div class="modal-body">
                <div class="modal-card">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <fieldset>
                                <div>

                                    @Html.HiddenFor(model => model.AttCorrectionId)
                                    @Html.HiddenFor(model => model.EmpId)
                                    @Html.HiddenFor(model => model.InPunchTime)
                                    @Html.HiddenFor(model => model.OutPunchTime)
                                    @Html.HiddenFor(model => model.ApplyReason)
                                    @Html.HiddenFor(model => model.Status)
                                    @Html.HiddenFor(model => model.attn_dt)
                                    @Html.HiddenFor(model => model.empname)
                                    @*@Html.HiddenFor(model => model.ApprovalReason)*@
                                </div>
                                <div class="form-group">
                                    <label class="control-label">Reason For approval or rejection in Attendance</label>
                                    @*@Html.EditorFor(model => model.ApprovalReason, new { htmlAttributes = new { @class = "form-control input-sm" } })*@
                                    <textarea id="ApprovalReason" class="form-control input-sm" name="ApprovalReason" rows="4"></textarea>
                                    @*<textarea class="form-control input-sm" id="CompanyAddress" name="CompanyAddress" rows="4" required=""></textarea>*@
                                    @*<span class="help-block" hidden></span>*@
                                </div>
                            </fieldset>
                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                        <button type="submit" class=" btn save_btn" id="btnsave"><i class="fa-light fa-floppy-disk"></i> Save</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal : End -->

<script src="~/assets/pages/scripts/components-date-time-pickers.min.js" type="text/javascript"></script>