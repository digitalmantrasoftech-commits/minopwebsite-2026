@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "InsuranceDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = "0";
    string _branchid = "0";
    int _EmpId = 0;
    if (_RoleId == 6805 || _RoleId == 6806 || _RoleId > 1)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
        _EmpId = Convert.ToInt32(HttpContext.Current.Session["EmpId"]);
    }
}
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<script type="text/javascript">
    var empid = '@_EmpId';
    $(document).ready(function () {
       var url = "";
        url = '@_webapiurl' + 'Master/GetInsuranceDetailsById?empid=' + empid;
        $("#dataTables_tbl_header").remove();
       var t = $('#tblInsuranceDetail').DataTable(
            {
                "destroy": true,
                "ajax": {
                    url: url,
                    type: "GET",
                    headers: { 'Authorization': '@_tokan' },
                    dataSrc: '',
                 },
               /*dom: 'lBfrtip',*/
               dom: _domCommon,
               language: _languageCommon,
                 buttons: [
                     {
                         extend: 'excelHtml5',
                         text: 'Excel',
                         titleAttr: 'Excel',
                         exportOptions: {
                             columns: [4,5,7,8,9,10,12,13,14,17,18,19,20]
                         }
                     }
                 ],
               "columns": [
                   { "data": null, visible: false },
                    { "data": "insurance_id" },
                    { "data": "employee_code"},
                    { "data": "insurance_of" },
                    { "data": "insurance_rel" },
                    { "data": "EmpName" },
                    { "data": "policy" },
                    { "data": "policy_type" },
                    { "data": "insurance_company_name" },
                    { "data": "policy_number" },
                    { "data": "registration_date" },
                    { "data": "due_date" },
                    { "data": "expire_date" },
                    { "data": "insurance_amount" },
                    { "data": "monthly_premium" },
                    { "data": "premium_deduct_salary" },
                    { "data": "isverified" },
                    { "data": "premium_deduct_salary_type" },
                    { "data": "is_verify_type" },
                    { "data": "link" },
                    { "data": "UID" }
                ],
                "columnDefs": [
                     {
                         "searchable": false,
                         "orderable": false,
                         "targets": 0
                    },
                    {
                        "targets": [1,2,3,6,11,15,16],
                        "visible": false
                    },
                    {
                        "targets": 10,
                        "render": function (data, type, row) {
                                if (data != "") {
                                    var formattedDate = moment(data, 'YYYY-MM-DD');
                                    var firstValue = '';
                                    if ("@_isdateformat" == "dd-mm-yyyy") {
                                        firstValue = formattedDate.format('DD-MM-YYYY');
                                    }
                                    else if ("@_isdateformat" == "yyyy-mm-dd") {
                                        firstValue = formattedDate.format('YYYY-MM-DD');
                                    }
                                    else if ("@_isdateformat" == "mm-dd-yyyy") {
                                        firstValue = formattedDate.format('MM-DD-YYYY');
                                    }
                                    else if ("@_isdateformat" == "yyyy-M-dd") {
                                        firstValue = formattedDate.format('YYYY-MMM-DD');
                                    }
                                    else if ("@_isdateformat" == "M-dd-yyyy") {
                                        firstValue = formattedDate.format('MMM-DD-YYYY');
                                    }
                                    else if ("@_isdateformat" == "dd-M-yyyy") {
                                        firstValue = formattedDate.format('DD-MMM-YYYY');
                                    }
                                    return firstValue;
                                }
                                else {
                                    return "";
                                }
                            }
                    },
                    {
                         "targets": 12,
                        "render": function (data, type, row) {
                                 if (data != "") {
                                 var formattedDate = moment(data, 'YYYY-MM-DD');
                                 var firstValue = '';
                                 if ("@_isdateformat" == "dd-mm-yyyy") {
                                     firstValue = formattedDate.format('DD-MM-YYYY');
                                 }
                                 else if ("@_isdateformat" == "yyyy-mm-dd") {
                                     firstValue = formattedDate.format('YYYY-MM-DD');
                                 }
                                 else if ("@_isdateformat" == "mm-dd-yyyy") {
                                     firstValue = formattedDate.format('MM-DD-YYYY');
                                 }
                                 else if ("@_isdateformat" == "yyyy-M-dd") {
                                     firstValue = formattedDate.format('YYYY-MMM-DD');
                                 }
                                 else if ("@_isdateformat" == "M-dd-yyyy") {
                                     firstValue = formattedDate.format('MMM-DD-YYYY');
                                 }
                                 else if ("@_isdateformat" == "dd-M-yyyy") {
                                     firstValue = formattedDate.format('DD-MMM-YYYY');
                                 }
                                 return firstValue;
                             }
                             else {
                                 return "";
                             }
                        }
                    }
                ],
               "order": [[1, 'asc']],
               "initComplete": function (settings, json) {
                   if (json != null) {
                       const insurance = json;
                       handleGridVisibility("tblempty", "NotificationGrid-empty", insurance, {
                           imageUrl: "emptyscreen_1.png",
                           subText: "No entries found. Please add a record to get started."
                       });
                   }
               }
            }
        );
        setTimeout(function () {
            $("#" + "tblInsuranceDetail" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

         t.on('order.dt search.dt', function () {
            t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
         }).draw();
    });
</script>
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/AdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> InsuranceDetails</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i>Insurance Details</span>
            </li>
        </ul>
    }
</div>
@if (obj.CanView)
{
    <div class="row">
        <div class="col-md-12">
            <div class="portlet">
                <div class="portlet-body">
                    <div style="width:100%;margin-left:auto;margin-right:auto;">
                        <div id="tblempty">
                            <div class="table-responsive" id="tableResponsive">
                                <table id="tblInsuranceDetail" class="new_datatbl table table-striped table-bordered table-hover  order-column">
                                    <thead>
                                        <tr>
                                            <th style="display:none;">Sr. No</th>
                                            <th hidden>Insurance ID</th>
                                            <th hidden>Employeecode</th>
                                            <th hidden>Insurance Of</th>
                                            <th>Insurance Of</th>
                                            <th>Name</th>
                                            <th hidden>Policy</th>
                                            <th>Policy Type</th>
                                            <th>Company</th>
                                            <th>Policy No.</th>
                                            <th>Registration Date </th>
                                            <th hidden>Due Date </th>
                                            <th>Expire Date</th>
                                            <th>Amount</th>
                                            <th>Monthly</th>
                                            <th hidden>Deduct From Salary id</th>
                                            <th hidden>Is verifyed Or Not id</th>
                                            <th>Deduct From Salary</th>
                                            <th>Is verifyed Or Not</th>
                                            <th>Link</th>
                                            <th>UID</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div id="NotificationGrid-empty" style="display: none">
                            <div class="datanotfound">
                                <img src="" height="148" width="280" alt="Nodata Found Icon">
                                <p class="datanotfound_title"></p> <!-- titleText -->
                                <p class=""></p><!-- subText -->
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}

