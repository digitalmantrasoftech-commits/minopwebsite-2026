@model PayTimeWebClient.Models.Policies
@using System.Configuration;
@using PayTimeWebClient.Models;
@using PayTimeWebClient.Helper
@{
    ViewBag.Title = "PolicyCreation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = "";
    string _error = "";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = "0";
    string _branchid = "0";
    int _EmpId = 0;
    if (_RoleId == 6805 || _RoleId == 6806 || _RoleId > 1)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
        _EmpId = Convert.ToInt32(HttpContext.Current.Session["EmpId"]);
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<script type="text/javascript">
    var $Companyselect = "";
    var $Branchselect = "";
    var emprole = '@_RoleId';
    var cmpId = '@_companyid';
    var branchId = '@_branchid';
    $(document).ready(function () {
        $Companyselect = $("#CompanyID").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '400',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Company'

        });
        $Branchselect = $("#BranchIds").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Branch',

        });
        var url = "";
        url = '@_webapiurl' + 'Master/GetEmployeeReferenceGuide?Roleid=' + emprole + "&ComanyID=" + cmpId + "&BranchID=" + branchId + "&flag=0";
        var t = $('#tblPolicies').DataTable(
        {
            "destroy": true,
            "ajax": {
                url: url,
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                dataSrc: '',
            },
                //dom: 'lBfrtip',
                dom: _domCommon,
                language: _languageCommon,
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        titleAttr: 'Excel',
                        exportOptions: {
                            columns: [2, 3,7]
                        }
                    }
            ],
            "columns": [
                { "data": null,visible:false },
                { "data": "policy_title" },
                { "data": "policy_description" },
                { "data": "uploaded_date" },
                { "title":"Action"},
                { "data": "policy_id", visible: false },
                { "data": "document_path", visible: false },
                { "data": "company_id", visible: false },
                { "data": "branch_id", visible: false },
            ],
            "columnDefs": [
	             {
	                 "searchable": false,
	                 "orderable": false,
	                 "targets": 0
                },
                //{
                //    "targets": [1,4,5,6],
                //    "visible": false
                //},
                {
                    "targets": [4],
                    "render": function (data, type, row) {
                        if (emprole == 1) {
                            data = "<a class='editclass seagreen_btnnew tooltips' title='Edit'><i class='fa-regular fa-pen-to-square'></i></a";
                        }
                        else if (emprole == 6805 && '@obj.CanEdit.ToString()' == 'True' && (row.company_id != "0" && row.company_id == cmpId.toString())) {
                            data = "<a class='editclass seagreen_btnnew tooltips' title='Edit'><i class='fa-regular fa-pen-to-square'></i></a";
                        }
                        else if (emprole == 6806 && '@obj.CanEdit.ToString()' == 'True' && (row.company_id != "0" && row.branch_id == branchId.toString())) {
                            data = "<a class='editclass seagreen_btnnew tooltips' title='Edit'><i class='fa-regular fa-pen-to-square'></i></a";
                        }
                        else if (emprole > 1 && '@obj.CanEdit.ToString()' == 'True' && emprole != 6805 && emprole != 6806) {
                            data = "<a class='editclass seagreen_btnnew tooltips' title='Edit'><i class='fa-regular fa-pen-to-square'></i></a";
                        }
                        else {
                            data = "";
                        }
                        return data;

                    }
                },
                {
                    "orderable": false,
                    "targets": 4
                },
            ],
                "order": [[1, 'asc']],
                "initComplete": function (settings, json) {
                    if (json != null) {
                        const insurance = json;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", insurance, {
                            imageUrl: "emptyscreen_1.png",
                            subText: "No entries found. Please add a record to get started."
                        });
                    }
                }
        }
        );
        setTimeout(function () {
            $("#" + "tblPolicies" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
     t.on('order.dt search.dt', function () {
        t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
            cell.innerHTML = i + 1;
        });
     }).draw();
     t.on('draw.dt', function () {
         $('.tooltips').tooltip();
         $("#ajax_loader").hide();
     });
     fillcompany();
     $("#CompanyID").change(function () {
         var s = $('#CompanyID').val();
         fillBranchbycompnyid(s, "");
     });
     $("#tblPolicies").on('click', '.editclass', function () {
         $("#policy_id").val(t.row($(this).parent('td').parent('tr')).data()["policy_id"]);
         $("#policy_title").val(t.row($(this).parent('td').parent('tr')).data()["policy_title"]);
         $("#policy_description").val(t.row($(this).parent('td').parent('tr')).data()["policy_description"]);
         var policiesUrl = t.row($(this).parent('td').parent('tr')).data()["document_path"];
         if (policiesUrl) {
             var filename = policiesUrl.split('/').pop(); // Extract filename from the URL
             var blob = new Blob([''], { type: 'application/octet-stream' }); // Create a blob
             var file = new File([blob], filename); // Create a new File object

             // Create a new DataTransfer object to hold the file
             var fileList = new DataTransfer();
             fileList.items.add(file); // Add the file to the DataTransfer object

             // Set the files property of the file input element
             var fileInput = $('#policy_file')[0];
             fileInput.files = fileList.files;

             // Pass the filename to a text element (for example, a <span> with id 'current_filename')
             $('#policy_file').text(filename); // Set the filename in the text element
         }
         var companyID = t.row($(this).parent('td').parent('tr')).data()["company_id"];
         var selectedCompany = companyID.split(",");
         for (var i in selectedCompany) {
             var optionVal = selectedCompany[i].trim(); // Ensure there are no leading/trailing spaces

             if (optionVal) {
                 $("#CompanyID").find("option[value=" + optionVal + "]").prop("selected", "selected");
             }
         }
         $("#CompanyID").multiselect("rebuild");
         var branchID = t.row($(this).parent('td').parent('tr')).data()["branch_id"];
         fillBranchbycompnyid(companyID, branchID)
         $(".editclass").attr("data-toggle", "modal");
         $(".editclass").attr("data-target", "#frmpolicycreation");
     });
     $("#AddPolicies").click(function () {
         frmclear();
         $("#AddPolicies").attr("data-toggle", "modal");
         $("#AddPolicies").attr("data-target", "#frmpolicycreation");
     });
     $("#policy_title").keypress(function (e) {
         $("#policy_title").removeClass('field_error');
         if (((e.which >= '65') && (e.which <= '90')) ||
             ((e.which >= 48 && e.which <= 57)) ||
             ((e.which >= '97') && (e.which <= '122')) ||
             (e.which == '46') ||
             (e.which == '32') ||
             e.which == '45' ||
             e.which == '8') {
             return true;
         } else {
             return false;
         }
     });
    $("#policy_title").on('paste', function (event) {
        event.preventDefault();
    });
    $("#policy_title").blur(function () {
        var policy_title = removeTags($("#policy_title").val());
        $("#policy_title").val(policy_title);
    });
    $("#policy_title").change(function () {
        $("#policy_title").removeClass('field_error');
    });
    $("#policy_title").keypress(function () {
        $("#policy_title").removeClass('field_error');
    });
    $("#policy_description").keypress(function (e) {
        $("#policy_description").removeClass('field_error');
        if (
            (e.which >= 48 && e.which <= 57) ||
            (e.which >= 65 && e.which <= 90) ||
            (e.which >= 97 && e.which <= 122) ||
            e.which == 32 ||
            e.which == 46 ||
            e.which == 45 ||
            e.which == 8 ||
            e.which == 44 ||
            e.which == 59
        ) {
            return true;
        } else {
            return false;
        }
    });
    $("#policy_description").on('paste', function (event) {
        event.preventDefault();
    });
    $("#policy_description").blur(function () {
        var policy_description = removeTags($("#policy_description").val());
        $("#policy_description").val(policy_description);
    });
    $("#policy_description").change(function () {
        $("#policy_description").removeClass('field_error');
    });
    $("#policy_description").keypress(function () {
        $("#policy_description").removeClass('field_error');
    });

    $("#policy_file").change(function () {
        $("#policy_file").removeClass('field_error');
    });
    $("#policy_file").keypress(function () {
        $("#policy_file").removeClass('field_error');
    });
    $("#policy_file").change(function () {
        $("#policy_file").removeClass('field_error');
        var policy_file = this.files; // Get the selected files
        var maxSize = 5 * 1024 * 1024; // 2 MB in bytes
        var validExts = [".pdf", ".png", ".jpg", ".jpeg", ".xls", ".xlsx", ".csv"];
        if (policy_file.length > 0) {
            var file = policy_file[0];
            if (file.size > maxSize) {
                toastr.remove();
                toastr.error("File size exceeds 5 MB.");
                $('#policy_file').val(''); // Reset the file input to clear the selected files
                return false; // Stop further execution
            }
            // File extension validation
            var fileExt = file.name.substring(file.name.lastIndexOf('.')).toLowerCase(); // Get the file extension in lowercase
            if (!validExts.includes(fileExt)) {
                toastr.remove();
                toastr.error("Invalid file selected, valid files are of " + validExts.join(", ") + " types.");
                $('#policy_file').val(''); // Reset the file input to clear the selected files
                return false; // Stop further execution
            }
        }
        var fileName = policy_file[0].name;
        $('#policy_file').text(fileName);
    });

        $("#save_policies").click(function (event) {
            if ($("#policy_title").val() == "") {
                $("#policy_title").addClass('field_error');
                $("#policy_title").focus();
                event.preventDefault();//or return false
                return false;
            }
            else {
               $("#policy_title").removeClass('field_error');
            }
            if ($("#policy_description").val() == "") {
                $("#policy_description").addClass('field_error');
                $("#policy_description").focus();
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#policy_description").removeClass('field_error');
            }
            if ($("#policy_file").val() == "") {
                $("#policy_file").addClass('field_error');
                $("#policy_file").focus();
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#policy_file").removeClass('field_error');
           }
           if ($("#CompanyID").val() == "0" || $("#CompanyID").val() == null)
           {
               toastr.remove();
               toastr.error("Please select company.");
               return false;
            }
             if ($("#BranchIds").val() == "0" || $("#BranchIds").val() == null) {
                 toastr.remove();
                 toastr.error("Please select branch.");
                 return false;
             }
            var obj = {
                policy_id: $('#policy_id').val(),
                policy_title: $("#policy_title").val(),
                policy_description: $('#policy_description').val(),
                document_path: $("#policy_file").text(),
                is_active: 1,
                CompanyID:  Array.isArray($("#CompanyID").val()) ? $("#CompanyID").val().join(",") : $("#CompanyID").val(),
                BranchID:   Array.isArray($("#BranchIds").val()) ? $("#BranchIds").val().join(",") : $("#BranchIds").val()
            };
           if ($('#policy_id').val() == "0") {
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurl' + 'Master/PoliciesCreate',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response) {
                        $("#ajax_loader").hide();
                        if (response != null) {
                            var uploaddoc = $("#policy_file").val();
                            if (uploaddoc != null && uploaddoc !== "") {
                                setTimeout(function () {
                                    $("#frmupload").submit();
                                }, 1000);
                            }
                            $('#frmpolicycreation').modal('toggle');
                            toastr.remove();
                            toastr.success("Policy created successfully.");
                        } else {
                            toastr.remove();
                            toastr.error(response);
                        }
                    },
                    error: function (response) {
                        $("#ajax_loader").hide();
                        if (response != null) {
                            var obj = JSON.parse(response.responseText);
                            if (obj.MegSts == 'error') {
                                toastr.remove();
                                toastr.error(obj.Meg);
                                $('#tblPolicies').DataTable().ajax.reload();
                                $('#frmpolicycreation').modal('toggle');
                            }
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            } else {
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurl' + 'Master/PoliciesUpdate',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response) {
                        $("#ajax_loader").hide();
                        if (response != null) {
                            var uploaddoc = $("#policy_file").val();
                            if (uploaddoc != null && uploaddoc !== "") {
                                setTimeout(function () {
                                    $("#frmupload").submit();
                                }, 1000);
                            }
                            $('#frmpolicycreation').modal('toggle');
                            toastr.remove();
                            toastr.success("Policy update successfully.");
                        } else {
                            toastr.remove();
                            toastr.error(response);
                        }
                    },
                    error: function (response) {
                        $("#ajax_loader").hide();
                        $("#ajax_loader").hide();
                        if (response != null) {
                            var obj = JSON.parse(response.responseText);
                            if (obj.MegSts == 'error') {
                                toastr.remove();
                                toastr.error(obj.Meg);
                                $('#tblPolicies').DataTable().ajax.reload();
                                $('#frmpolicycreation').modal('toggle');
                            }
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            }
        });
    });
    function frmclear() {
        $("#policy_id").val(0);
        $("#policy_title").val("");
        $("#policy_description").val("");
        $("#policy_file").val("");
        $("#policy_file").text("");
        $("#CompanyID").val(0);
        $("#CompanyID Option:selected").prop("selected", false);
        $("#CompanyID").multiselect('refresh');
        $("#BranchIds option:selected").prop("selected", false);
        $("#BranchIds").multiselect('refresh');
        $("#BranchIds").empty();
        $("#BranchIds").multiselect('disable');
        $("#txt1").val(0);
        $("#txt2").val(0);
    }
    function fillcompany() {
        var _urlcmp = '@_webapiurl' + "Master/CompanyGetAll";
        $("#CompanyID").empty()
        $.ajax(
            {
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: _urlcmp,
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (data) {
                    var markup = '';
                    data.sort(function (a, b) {
                        return a.CompanyName.localeCompare(b.CompanyName);
                    });
                    if (emprole == 6805 || emprole == 6806 || (emprole > 1)) {
                        for (var x = 0; x < data.length; x++) {
                            if (data[x].CompanyID.toString() == cmpId.toString()) {
                                markup += "<option value=" + data[x].CompanyID + ">" + data[x].CompanyName + "</option>";
                            }
                        }
                    }
                    else {
                        for (var x = 0; x < data.length; x++) {
                            markup += "<option value=" + data[x].CompanyID + ">" + data[x].CompanyName + "</option>";
                        }
                    }
                    $("#CompanyID").append(markup);
                    if (emprole > 1  && emprole != 6805 && emprole != 6806) {
                        $("#CompanyID option[value = '" + cmpId + "' ]").prop('selected', true);
                    }
                    $Companyselect.multiselect('rebuild');
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
    }
    function fillBranchbycompnyid(companyid, selectedBranch) {
        $('#BranchIds').empty();
        $.ajax(
            {
                type: "GET",
                url: "/MasterData/GetBranchbycomapnyid?CompanyID=" + companyid,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    var markup = '';
                    for (var x = 0; x < data.length; x++) {
                        data.sort(function (a, b) {
                            return a.BranchName.localeCompare(b.BranchName);
                        });
                        markup += "<option value=" + data[x].BranchId + ">" + data[x].BranchName + "</option>";
                    }
                    $('#BranchIds').append(markup);
                    var selectedBranchIds = selectedBranch.split(",");
                    if (selectedBranchIds.length > 0) {
                        selectedBranchIds.forEach(function (branchId) {
                            $("#BranchIds").find("option[value='" + branchId + "']").prop("selected", true);
                        });
                    }
                    $Branchselect.multiselect('rebuild');
                    $(document.body).on('change', '#BranchIds', function () {
                        $("#spvalidation").hide();
                        var branid = $('#BranchIds option:selected');
                        var BranchArray = [];
                        $(branid).each(function (index, branid) {
                            BranchArray.push([$(this).val()]);
                        });
                        if (BranchArray == "") {
                            $("#txt2").val(0);
                        }
                        else {
                            $("#txt2").val(BranchArray);
                            $("#spValidation").hide();
                        }
                        var Arrbranch = $("#txt2").val();
                        BranchIdlst = Arrbranch;
                        $("#BranchId").val(BranchIdlst);
                    });
                },
                error: function (xhr, ajaxOptions, thrownError) {

                    if (xhr.status == 404) { //NotFound = 404
                        toastr.error(thrownError);
                    } else if (xhr.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (xhr.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (xhr.status == 419) {
                        window.location.href = "/PayTime/LoginPage";
                    } else {
                        toastr.error(thrownError);
                    }
                }
            });
    }
</script>
<div class="page-bar">
