    <div class="row">
        <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
            <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
        </div>
    </div>
    <div id="frmpolicycreation" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog w-500">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Create Policies</h4>
                </div>
                <div class="modal-body">
                    <div class="modal-card">
                        <div class="row">
                            <div class="col-lg-12">
                                <span class="help-block" hidden style="color:red;" id="spvalidation"></span>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <input type="hidden" id="policy_id" name="policy_id">
                                    <label>Title <span class="required" aria-required="true"> * </span></label>
                                    <input type="text" class="form-control input-sm" maxlength="50" id="policy_title" placeholder="Enter title" required maxlength="50" />
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-group">
