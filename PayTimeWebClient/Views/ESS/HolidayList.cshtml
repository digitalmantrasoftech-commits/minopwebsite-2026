        function tblgetEmployeeHeirachy() {
           $.ajax(
             {
                 type: "GET",
                 headers: { 'Authorization': '@_tokan' },
                   url: '@_webapiurl' + 'Master/GetReportingEmployees',
                 data: 'roleid=' + @_RoleId + '&loginempid=@_EmpId',
                 contentType: "application/json; charset=utf-8",
                 dataType: "json",
                 beforeSend: function () {
                     $("#ajax_loader").show();
                 },
                   success: function (data) {
                     if (data.isRedirect) {
                         window.location.href = data.redirectUrl;
                     }
                       if (data != null && data.length > 0) {
                           if (data[0].empid > 0) {
                               $('a[href="#approvalrequest"]').closest('li').show();
                           }
                           else {
                               $('a[href="#approvalrequest"]').closest('li').hide();
                           }
                     }
                     else {
                         $('a[href="#approvalrequest"]').closest('li').hide();
                     }
                 },
                 error: function (jqXHR, ajaxOptions, thrownError) {
                     if (jqXHR.status == 500) {
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) {
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                     $("#ajax_loader").hide();
                 },
                 complete: function () {
                     $("#ajax_loader").hide();
                 }
             });
        }
        function checkSession() {
            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                },
                error: function (data) {
                    window.location.href = data;
                }
            });
        }
        function parseDateByFormat(dateStr, format) {
            if (format === "dd-mm-yyyy") {
                var parts = dateStr.trim().split("-");
                return new Date(parts[2], parts[1] - 1, parts[0]);
            } else if (format === "mm-dd-yyyy") {
                return moment(dateStr, "MM-DD-YYYY").toDate();
            } else if (format === "yyyy-M-dd") {
                return moment(dateStr, "YYYY-MMM-DD").toDate();
            } else if (format === "M-dd-yyyy") {
                return moment(dateStr, "MMM-DD-YYYY").toDate();
            } else if (format === "dd-M-yyyy") {
                return moment(dateStr, "DD-MMM-YYYY").toDate();
            } else {
                return new Date(dateStr);
            }
        }
    });
</script>
