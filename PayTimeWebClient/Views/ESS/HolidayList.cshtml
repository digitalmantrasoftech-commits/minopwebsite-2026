@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "HolidayList";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = "0";
    string _branchid = "0";
    int _EmpId = 0;
    string _empName = "0";
    if (_RoleId == 6805 || _RoleId == 6806 || _RoleId > 1)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
        _EmpId = Convert.ToInt32(HttpContext.Current.Session["EmpId"]);
        _empName = HttpContext.Current.Session["EmpName"].ToString();
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
  ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
  : "false"; // Default to "false" if the session is null
    int _OptHolidayLimit = Convert.ToInt32(HttpContext.Current.Session["OptHolidayLimit"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);

}
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<link href="~/AssetsNew/css/introjs.css" rel="stylesheet" />
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<style type="text/css">
    .mysubscription .nav-tabs {
        margin: 0;
        padding: 0;
        border: none;
        display: block;
        margin-bottom: 10px;
    }

        .mysubscription .nav-tabs > li {
            margin: 0;
            float: none;
            display: inline-block;
        }

            .mysubscription .nav-tabs > li > a {
                margin: 0;
                padding: 2px 10px 2px 10px;
                font-size: 14px;
                background-color: transparent;
                border: 1px solid transparent;
                color: #666666;
                margin-right: 10px;
            }

                .mysubscription .nav-tabs > li > a:hover {
                    color: #000000;
                    border-bottom: 2px solid #a9a9a9 !important;
                }

            .mysubscription .nav-tabs > li.active > a {
                background-color: transparent;
                color: #000000;
                border-bottom: 2px solid #a9a9a9 !important;
                border-color: transparent;
            }

                .mysubscription .nav-tabs > li.active > a > i {
                    color: #000000 !important;
                }

    .tab_content_box {
        color: #333;
        margin: 0;
        padding: 0;
    }

        .tab_content_box .tab-pane {
            margin: 0;
            padding: 0;
            border: 0;
        }
</style>
<script type="text/javascript">
    var isDateFormat = '@_isdateformat';
    var count = 0;
    var _NewEmpID = "@_EmpId";
    var _NewEmpName = "@_empName";
    var operation = "";
    var delay = 2000;
    var HolidayLimit = "@_OptHolidayLimit";
    var _RoleIDnew = '@_RoleId';
    var isactive = 1;
    var Dt_table = "";
    $(document).ready(function () {
        if (@_RoleId != 1) {
            loadHolidayTable();
            tbloptional_Holiday();
            tbloptional_Holiday_team();
            tblgetEmployeeHeirachy();
        }
        else {
            $('a[href="#optionalholiday"]').tab('show');
            tbloptional_Holiday();
        }
        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var target = $(e.target).attr("href");
            if (target === "#holiday") {
                loadHolidayTable();
            }
            if (target === "#optionalholiday") {
                tbloptional_Holiday();
            }
            if (target === "#approvalrequest") {
                tbloptional_Holiday_team();
            }
        });
        $(document).on("change", ".checkbox", function () {
            if ($(".checkbox:checked").length > 0) {
                $("#btn_note_id").show();
            } else {
                $("#btn_note_id").hide();
            }
        });
        function frmClear() {
            $("#OptHoliday").val("0");
            $("#HolidayDate").val("");
            $("#HolidayToDate").val("");
            $("#Empname").val("");
        }
        function filloptholiday(empid) {
            $('#OptHoliday').empty();
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + "Master/GetHolidayOptionalall?empid=" + empid,
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (data) {
                    if (data != null && data.length > 0) {
                        $("#OptHoliday").append("<option value='0'>Select Holiday</option>");
                        for (var i = 0; i < data.length; i++) {
                            $("#OptHoliday").append("<option value='" + data[i].HolidayId + "'>" + data[i].HolidayName + "</option>");
                        }
                    }
                },
                error: function (error) {
                    console.error("Error fetching optional holidays: " + error.statusText);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }

        $("#OptHoliday").on('change', function () {
            var HolidayId = $('#OptHoliday').val();
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + 'Master/GetHolidayOptionaldate?HolidayId=' + HolidayId,
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (data) {
                    if (data && data.length > 0) {
                        $("#HolidayDate").val(data[0].HolidayDate);
                    }
                },
                error: function (error) {
                    //alert("Error fetching cities: " + error.statusText);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });

        $("#tblholidayoptionalapllied").on('click', '.clm_edit_btn', function () {
            frmClear();
            var row = $(this).closest('tr');
            var empId = row.find('td.EmpId').text().trim();
            var empName = row.find('td.EmpName').text().trim();
            var holidayDate = row.find('td.HolidayDate').text().trim();
            var optHolidayId = row.find('td.OptHolidayId').text().trim();
            var holidayName = row.find('td.HolidayName').text().trim();
            filloptholiday(empid);
            $("#empid").val(empId);
            $("#Empname").val(empName);
            $("#HolidayDate").val(holidayDate);
            $("#OptHolidayId").val(optHolidayId);
            $("#OptHoliday option").each(function () {
                if ($(this).text().trim() === holidayName) {
                    $(this).prop("selected", true);
                }
            });
            $('#OptHoliday').trigger('change.select2');
            $("#Empname").prop("disabled", true);
            $("#HolidayDate").prop("disabled", true);
            $("#tblholidayoptionalapllied").attr("data-toggle", "modal");
            $("#tblholidayoptionalapllied").attr("data-target", "#frmpopup");
        });
        //Update
        $("#btnSubmit").click(function () {
            if (($("#OptHoliday").val() == null || $("#OptHoliday").val() == "0")) {
                $("#OptHoliday").addClass('field_error');
                toastr.remove();
                toastr.error("Please Optinal Holiday.");
                return false;
            }
            var createdDate = new Date().toString("YYYY-MM-dd HH:mm:ss");
            var empid = $("#empid").val();
            var isactive = 1;
            var holidayid = $("#OptHoliday").val();
            var OptHolidayId = $("#OptHolidayId").val();
            var obj = {
                EmpId: empid,
                HolidayId: holidayid,
                CreatedDate: createdDate,
                IsActive : isactive,
                OptHolidayId: OptHolidayId
            };
            $.ajax({
                url: '@_webapiurl' + 'Master/OptionalHolidayUpdate',
                type: 'POST',
                headers: { 'Authorization': '@_tokan' },
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    if (data.MegSts == "ok") {
                        toastr.remove();
                        toastr.success(data.Meg);
                        $(".loading").hide();
                        setTimeout(function () {
                            window.location.reload(true);
                        }, delay);

                    }
                    else {
                        toastr.error("already exist");
                    }
                }
            });
        });
         $("#btnactive").click(function () {
                checkSession();
                var HolidayOptionalRequest = [];
                var checkboxChecked = false;
                $("#tblholidayoptionallist .checkbox").each(function () {
                    if ($(this).is(':checked')) {
                        checkboxChecked = true;
                        var row = $(this).closest('tr');
                        var holidayDateStr = row.find('.HolidayDate').text().trim();
                        var holidayToDateStr = row.find('.HolidayToDate').text().trim();
                        var holidayDate = parseDateByFormat(holidayDateStr, isDateFormat);
                        var holidayToDate = parseDateByFormat(holidayToDateStr, isDateFormat);
                        var obj = {
                            holidayname: row.find('.HolidayName').text().trim(),
                            holidayDate: holidayDate,
                            holidayToDate: holidayToDate,
                            CreatedDate: row.find('.CreatedDate').text().trim(),
                            HolidayId: row.find('.HolidayId').text().trim(),
                            EmpId: _NewEmpID,
                            IsActive: isactive
                        };
                        HolidayOptionalRequest.push(obj);
                    }
                });

                if (!checkboxChecked) {
                    toastr.error("Please select Holiday.");
                    return false;
                }
                var checkedCount = $('#tblholidayoptionallist .checkbox:checked').length;
                if (checkedCount != HolidayLimit) {
                    toastr.error("Please select exactly " + HolidayLimit + " optional holiday(s).");
                    return false;
                }
                var requestData = {
                    HolidayOptionalRequest: HolidayOptionalRequest
                };
                $.ajax({
                    url: '@_webapiurl' + 'Master/HolidayMasterOptionalCreate',
                    type: 'POST',
                    headers: { 'Authorization': '@_tokan' },
                    data: JSON.stringify(requestData),
                    contentType: "application/json; charset=utf-8",
                    beforeSend: function () {
                        $(".loading").show();
                    },
                    success: function (data) {
                        if (data.isRedirect) {
                            window.location.href = data.redirectUrl;
                            return;
                        }

                        if (data.MegSts === "ok") {
                            toastr.remove();
                            toastr.success(data.Meg);
                            $(".loading").hide();
                            $("#getselectedHoliday").show();
                            $("#GetOptionalholiday").hide();
                            if ($.fn.dataTable.isDataTable('#tblholidayoptionalapllied')) {
                                $('#tblholidayoptionalapllied').DataTable().destroy();
                            }
                            var objHoliday = {
                                Roleid: _RoleIDnew,
                                EmpId: _NewEmpID,
                                flag:0
                            };
                            tbloptional_Holiday();
                        } else {
                            toastr.remove();
                            toastr.error("Error.");
                            $(".loading").hide();
                        }
                    },
                    statusCode: {
                        404: function () { alert('Cannot find resource'); },
                        500: function () { alert('Internal server error'); }
                    },
                    error: function (jqXHR) {
                        $(".loading").hide();
                        if (jqXHR.status == 500) {
                            toastr.error("InternalServerError");
                        } else if (jqXHR.status == 400) {
                            toastr.error("BadRequest");
                        } else if (jqXHR.status == 401) {
                            window.location.href = "/PayTime/LoginPage";
                        }
                    }
                });
            });
        function loadHolidayTable() {
            if ($.fn.DataTable.isDataTable("#tblHoliday")) {
                $("#tblHoliday").DataTable().clear().destroy();
            }
            $.ajax({
                url: '/ESS/GetHolidays',
                type: 'GET',
                dataType: 'json',
                contentType: "application/json; charset=utf-8",
                beforeSend: function () {
                    $('.loading').show();
                },
                success: function (response) {
                    if (response != null) {
                        const holiday = response.Holidayslist;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", holiday, {
                            imageUrl: "emptyscreen_1.png",
                            subText: "No entries found. Please add a record to get started."
                        });
                    }
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                        return;
                    }
                    $("#tblHoliday tbody").empty();
                    var table = '';
                    for (var i = 0; i < response.Holidayslist.length; i++) {
                        var holiday = response.Holidayslist[i];
                        var sr = i + 1;
                        var tbl = "<tr class='odd gradeX'>";
                        tbl += "<td hidden>" + sr + "</td>";
                        tbl += "<td class='HolidayId' hidden>" + holiday.HolidayId + "</td>";
                        tbl += "<td class='HolidayName'>" + holiday.HolidayName + "</td>";
                        tbl += "<td class='HolidayDate'>" + holiday.HolidayDate + "</td>";
                        tbl += "<td class='HolidayToDate'>" + holiday.HolidayToDate + "</td>";
                        tbl += "<td class='BranchName' hidden>" + holiday.BranchName + "</td>";
                        tbl += "<td class='CountryName' hidden>" + holiday.CountryName + "</td>";
                        tbl += "<td class='StateName' hidden>" + holiday.StateName + "</td>";
                        tbl += "<td class='TimeZoneName' hidden>" + holiday.TimeZoneName + "</td>";
                        tbl += "<td class='Religion' hidden>" + holiday.ReligionName + "</td>";
                        tbl += "<td class='IsHolidayType' hidden>" + (holiday.IsHolidayType ? "compulsory" : "Optional") + "</td>";
                        tbl += "<td class='HolidayApplicable' hidden>" + holiday.HolidayApplicable + "</td>";
                        tbl += "<td class='CountryID' hidden>" + holiday.CountryId + "</td>";
                        tbl += "<td class='StateId' hidden>" + holiday.StateId + "</td>";
                        tbl += "</tr>";
                        table += tbl;
                    }
                    $("#tblHoliday tbody").append(table);
                    $("#dataTables_tbl_header").remove();
                    $("#tblHoliday").DataTable({
                        dom: _domCommon,
                        language: _languageCommon,
                        paging: true,
                        searching: true,
                        autoWidth: true,
                        initComplete: function () {
                            const reqid = 'tblHoliday';
                            $("#buttons").append(`
                            <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${reqid}">
                                <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                            </div>
                           `);

                        },
                    });
                    setTimeout(function () {
                        $("#" + "tblHoliday" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                        $('.tooltips').tooltip();
                    }, 100);
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    $(".loading").hide();
                    if (jqXHR.status === 500) {
                        toastr.error("Internal Server Error");
                    } else if (jqXHR.status === 400) {
                        toastr.error("Bad Request");
                    } else if (jqXHR.status === 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                },
                complete: function () {
                    $('.loading').hide();
                }
            });
        }
        function tbloptional_Holiday() {
            $("#btn_note_id").hide();
            $('#tblholidayoptionallist').DataTable().destroy();
            $.ajax({
                url: '@_webapiurl' + "Master/HolidayGetOptionalAll?cmpid=@_companyid&branchid=@_branchid",
                method: 'GET',
                headers: { 'Authorization': '@_tokan' },
                dataType: 'json',
                contentType: 'application/json',
                beforeSend: function () {
                    $('#ajax_loaderbranch').show();
                },
                buttons: [
                       "excelHtml5",
                ],
                success: function (response) {
                    if (response != null) {
                        const holiday = response;
                        handleGridVisibility("tblemptys", "NotificationGrid-emptys", holiday, {
                            imageUrl: "emptyscreen_1.png",
                            subText: "No entries found. Please add a record to get started."
                        });
                    }
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    $('#tblholidayoptionallist tbody').empty();
                    var table = '';
                    for (var i = 0; i < response.length; i++) {
                        var tbl = "<tr class='odd gradeX'>";
                        tbl += "<td><input type='checkbox' class='checkbox' /></td>";  // Add checkbox
                        tbl += "<td class='HolidayId'hidden>" + response[i].HolidayId + "</td>";
                        tbl += "<td class='HolidayName'>" + response[i].HolidayName + "</td>";
                        tbl += "<td class='HolidayDate'>" + response[i].HolidayDate + "</td>";
                        tbl += "<td class='HolidayToDate'>" + response[i].HolidayToDate + "</td>";
                        tbl += "<td hidden>" + response[i].CountryId + "</td>";
                        tbl += "<td hidden>" + response[i].BranchId + "</td>";
                        tbl += "<td hidden>" + response[i].IsHolidayType + "</td>";
                        tbl += "<td hidden>" + response[i].IsActive + "</td>";
                        tbl += "</tr>";
                        table += tbl;
                    }
                    $('#tblholidayoptionallist tbody').append(table);
                    $("#dataTables_tbl_header").remove();
                    $("#tblholidayoptionallist").DataTable({

                        dom: _domCommon,
                        language: _languageCommon,
                        paging: true,
                        searching: true,
                        autoWidth: true,
                        initComplete: function () {
                            const reqid = 'tblholidayoptionallist';
                            $("#buttons").append(`
                            <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${reqid}">
                                <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                            </div>
                           `);

                        },
                    }); setTimeout(function () {
                        $("#" + "tblholidayoptionallist" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsiveOptional"));
                        $('.tooltips').tooltip();
                    }, 100);
                    $("#tblholidayoptionallist").on("keyup", "input", function () {
                        var t = $("#tblholidayoptionallist").DataTable();
                        t.column($(this).parent().index())
                            .search(this.value)
                            .draw();
                    });
                    $('#tblholidayoptionallist').on('click', '.checkbox', function () {
                        var checkedCount = $('#tblholidayoptionallist .checkbox:checked').length;
                        if (this.checked && checkedCount > HolidayLimit) {
                            alert("You can only select up to " + HolidayLimit + " holidays.");
                            this.checked = false;
                        }
                    });
                    $('#tblholidayoptionalapllied').DataTable().destroy();
                     var objHoliday = {
                         Roleid: _RoleIDnew,
                         EmpId: _NewEmpID,
                         flag: 0
                     };
                     $.ajax({
                         url: '@_webapiurl' + 'Master/GetHolidayOptionalSelected',
                         method: 'GET',
                         headers: { 'Authorization': '@_tokan' },
                         data: objHoliday,
                         dataType: 'json',
                         contentType: 'application/json',
                         beforeSend: function () {
                             $('#ajax_loaderbranch').show();
                         },
                         success: function (response) {
                             if (response.isRedirect) {
                                 window.location.href = response.redirectUrl;
                             }
                             $('#tblholidayoptionalapllied tbody').empty();
                             var table = '';
                             var _Flag = 0;
                             if (response != null && response.length > 0) {
                                 for (var i = 0; i < response.length; i++) {
                                     if (response[i].Flag == 1) {
                                             _Flag = 1;
                                     }
                                     if (response[i].EmpId == _NewEmpID) {
                                         var tbl = "<tr class='odd gradeX'>";
                                         tbl += "<td class= 'EmpId' hidden>" + response[i].EmpId + "</td>";
                                         tbl += "<td  class='OptHolidayId'hidden>" + response[i].OptHolidayId + "</td>";
                                         tbl += "<td  class='HolidayID'hidden>" + response[i].HolidayID + "</td>";
                                         tbl += "<td class='EmpName'>" + response[i].EmpName + "</td>";
                                         tbl += "<td class='HolidayName'>" + response[i].HolidayName + "</td>";
                                         tbl += "<td class='HolidayDate'>" + response[i].HolidayDate + "</td>";
                                         tbl += "<td class='HolidayToDate'>" + response[i].HolidayToDate + "</td>";
                                         if (_RoleIDnew == 1) {
                                             tbl += "<td><a class='editclass btn blue_btnnew tooltips clm_edit_btn' data-placement='top' title='Edit'><i class='fa-regular fa-pen-to-square'></i></a></td>";
                                         }
                                         else {
                                             tbl += "<td class='Action'>" + 'Applied ' + "</td>";
                                         }
                                         tbl += "</tr>";
                                         table += tbl;
                                     }
                                 }
                                 $('#tblholidayoptionalapllied tbody').append(table);
                                 $("#optionalholiday #dataTables_tbl_header").remove();
                                 var t = $("#tblholidayoptionalapllied").DataTable({
                                     dom: _domCommon,
                                     language: _languageCommon,
                                         paging: true,
                                         autoWidth: true,
                                         ordering: false,
                                     buttons: ["excelHtml5"],
                                     initComplete: function () {
                                         const visibleTable = $('table:visible').attr('id');
                                         $("#buttons").append(`
                                        <div id="export-button" class="export-button tooltips" data-placement="top" data-original-title="Download" data-table-id="${visibleTable}">
                                            <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                                        </div>
                                     `);

                                     },
                                 });
                                 setTimeout(function () {
                                     $("#" + "tblholidayoptionalapllied" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive10"));
                                     $('.tooltips').tooltip();

                                 }, 100);
                                     $("#tblholidayoptionalapllied").on("keyup", "input", function () {
                                         t.column($(this).parent().index())
                                             .search(this.value)
                                             .draw();
                                     });
                                     $('#getselectedHoliday').show();
                                     $('#GetOptionalholiday').hide();
                                     $("#btnactive").hide();
                             } else {
                                 $('#GetOptionalholiday').css('display', 'block');
                                 $('#getselectedHoliday').css('display', 'none');
                             }
                             if (_RoleIDnew == 1) {
                                 $('#GetOptionalholiday').hide();
                                 $('#getselectedHoliday').show();
                             }
                             else {
                                 var _empoptselect = 0;
                                 for (var i = 0; i < response.length; i++) {
                                     if (response[i].EmpId == _NewEmpID) {
                                         _empoptselect = 1;
                                     }
                                 }

                                 if (_empoptselect == 0) {
                                     $('#getselectedHoliday').hide();
                                     $('#GetOptionalholiday').show();
                                     $("#btnactive").show();
                                 }
                             }
                         },
                         complete: function () {
                             $('#ajax_loaderbranch').hide();
                         }
                         });
                        }
                    });
        }
        function tbloptional_Holiday_team() {
            if ($.fn.dataTable.isDataTable('#tblholidayoptionalListManger')) {
                $('#tblholidayoptionalListManger').DataTable().destroy();
            }
              var objHoliday = {
                  Roleid: _RoleIDnew,
                  EmpId: _NewEmpID,
                  flag: 1
            };
            $("#dataTables_tbl_header").remove();
            $('#tblholidayoptionalListManger').DataTable({
                  ajax: {
                      url: '@_webapiurl' + 'Master/GetHolidayOptionalSelected',
                      method: 'GET',
                      headers: { 'Authorization': '@_tokan' },
                      data: objHoliday,
                      dataType: 'json',
                      contentType: 'application/json',
                      dataSrc: '' ,
                      beforeSend: function () {
                          $('#ajax_loaderbranch').show();
                      },
                      error: function (jqXHR) {
                          $(".loading").hide();
                          if (jqXHR.status == 500) {
                              toastr.error("InternalServerError");
                          } else if (jqXHR.status == 400) {
                              toastr.error("BadRequest");
                          } else if (jqXHR.status == 401) {
                              window.location.href = "/PayTime/LoginPage";
                          }
                      },
                      complete: function () {
                          $('#ajax_loaderbranch').hide();
                      }
                },
                dom: _domCommon,
                language: _languageCommon,
                  columns: [
                      { data: 'EmpName' },
                      { data: 'HolidayName' },
                      { data: 'HolidayDate' },
                      { data: 'HolidayToDate' },
                ],
                initComplete: function (json) {
                    if (json != null) {
                        const Holiday = json.json;
                        handleGridVisibility("tblemptyss", "NotificationGrid-emptyss", Holiday, {
                            imageUrl: "emptyscreen_1.png",
                            subText: "No entries found. Please add a record to get started."
                        });
                    }
                    const reqid = 'tblholidayoptionalListManger';
                    $("#buttons").append(`
                            <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${reqid}">
                                <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                            </div>
