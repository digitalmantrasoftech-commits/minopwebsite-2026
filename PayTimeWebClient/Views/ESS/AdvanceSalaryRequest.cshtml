<!-- Add Feedback Modal : Begin -->
<div id="Addrequest_modal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog w-500">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Advance Salary Request</h4>
            </div>
            <div class="modal-body">
                <div class="modal-card">
                    <fieldset>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="control-label">Amount <span class="required" aria-required="true">*</span></label>
                                    <input type="text" id="reqAmount" placeholder="Please Enter" class="form-control" name="Value" />
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group data_picker_box">
                                    <label class="control-label">Prefer Date<span class="required" aria-required="true">*</span></label>
                                    <div class="input-group input-group-sm date date-picker" id="preferDate" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                                        <span class="input-group-btn">
                                            <button class="btn default" type="button">
                                                <i class="fa-light fa-calendar-days"></i>
                                            </button>
                                        </span>
                                        <input type="text" class="form-control" id="preDate" data-date-format="@_isdateformat" placeholder="@_isdateformat.Replace("M","MMM")" autocomplete="off">
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12">
                                <div class="form-group">
                                    <label>Reason <span class="required" aria-required="true">*</span></label>
                                    <textarea class="form-control" rows="5" name="" maxlength="100" id="reason" placeholder="Please Enter Reason" style="resize: vertical;"></textarea>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                        <button type="button" class="btn save_btn" id="btnSubmit">Submit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
