<!-- Datatable Block : Begin -->
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="portlet">
            <div class="portlet-body">
                <div class="table-responsive" id="tableResponsive">
                    <table class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column" id="tbladvsalary">
                        <thead>
                            <tr>
                                <th style="min-width:100px;">Amount</th>
                                <th style="min-width:250px;">Reason</th>
                                <th>Prefer Date</th>
                                <th style="min-width:100px;">Status</th>
                                <th style="min-width: 100px; width: 100px;">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div id="request-empty" style="display:none;">
                    <div class="empty_block no_record datanotfound">
                        <img src="~/assets/images/emptyscreen_1.png" height="122" width="230" alt="No Records Found">
