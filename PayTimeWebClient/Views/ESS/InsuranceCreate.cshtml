    function fillempCode(empid) {
        var eId = 0;
        if (empid != null) {
            eId = empid;
        }
        var _urlcmp = '/MasterData/EmployeeGetReporting';
        $('#ddl_employee_code').empty();
        $.ajax(
            {
                type: "GET",
                url: _urlcmp,
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (data) {
                    if (data != null) {
                        var compressedData = atob(data);
                        var data = JSON.parse(pako.inflate(compressedData, { to: 'string' }));
                        if (data.isRedirect) {
                            window.location.href = data.redirectUrl;
                        }
                        $("#ajax_loader").hide();
                        var markup = '';
                        data.sort(function (a, b) {
                            return a.EmpName.localeCompare(b.EmpName);
                        });
                        for (var x = 0; x < data.length; x++) {
                            if (emprole != 6805 && emprole != 6806 && emprole == 1) {

                                markup += "<option value=" + data[x].EmpId + ">" + data[x].Empcode + "(" + data[x].EmpName + ")" + "</option>";
                            }
                            else if (emprole == 6805) {
                                if (data[x].CompanyID == cmpId) {
                                    markup += "<option value=" + data[x].EmpId + ">" + data[x].Empcode + "(" + data[x].EmpName + ")" + "</option>";
                                }
                            }
                            else if (emprole == 6806) {
                                if (data[x].BranchId == branchId) {
                                    markup += "<option value=" + data[x].EmpId + ">" + data[x].Empcode + "(" + data[x].EmpName + ")" + "</option>";
                                }
                            }
                        }
                        var newOption = '<option selected="selected"  value="0">Please Select</option>';
                        $('#ddl_employee_code').html(newOption);
                        $('#ddl_employee_code').append(markup);
                    }
                    if (eId != null & eId != 0) {
                        $("#ddl_employee_code option[value ='" + eId + "']").prop('selected', true);
                        $('#ddl_employee_code').trigger('change.select2');
                    }
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) {
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) {
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });

    }
     function fillPolicy(policyId) {
       $('#policy_type').empty();
        var pId = 0;
           if (policyId != null) {
               pId = policyId;
           }
        $.ajax({
            type: "GET",
            url: '@_webapiurl' + 'Master/GetInsurancePolicy',
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response != null) {
                    response.sort(function (a, b) {
                        return a.policy_type.localeCompare(b.policy_type); // Sort company names in ascending order
                    });
                    $("#policy_type").append("<option value='0' selected>Please Select</option>");
                    for (var i = 0; i < response.length; i++) {
                        $("#policy_type").append("<option value='" + response[i].id + "'>" + response[i].policy_type + "</option>");
                    }
                }
                if (pId != null & pId != 0) {
                    $("#policy_type option[value ='" + pId + "']").prop('selected', true);
                    $('#policy_type').trigger('change.select2');
                }
                $("#ajax_loader").hide();
            },
            error: function () {
                $("#ajax_loader").hide();
            }
        });
    }
