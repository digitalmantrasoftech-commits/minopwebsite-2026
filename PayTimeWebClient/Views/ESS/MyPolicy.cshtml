@model PayTimeWebClient.Models.HRPolicy
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "MyPolicy";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>My Policy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <link href="~/PDFContent/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/PDFContent/css/responsive.css" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
    <style type="text/css">
        .container {
            width: 1024px;
        }

        .panel-primary > .panel-heading {
            color: #fff !important;
            background-color: #337ab7 !important;
            border-color: #337ab7 !important;
        }

        .logo {
            padding: 10px 0;
            display: block;
        }

        section {
            margin-bottom: 50px;
        }

        ul li {
            list-style-image: url(~/PDFContent/img/arrow.png);
            margin-bottom: 10px;
            color: #4d4d4d;
        }

            ul li span {
                color: #3598dc;
            }

        .pname {
            text-align: center;
            font-size: 20px;
            padding: 10px 0;
        }

            .pname span {
                color: #3598dc;
            }

        .footer {
            border-top: 2px solid #000;
            padding: 10px 0;
            text-align: center;
        }

            .footer a {
                color: #000;
            }

        .header {
            height: 50px;
            border-bottom: 2px solid #3598dc;
            width: 100%;
            background-color: 3598dc;
        }

        .panel-heading {
            font-size: 20px;
        }

        .title {
            background: #337ab7 !important;
            height: 40px;
            padding: 5px 10px;
            margin: 30px 0;
            border-bottom: 3px solid #51abe8;
            color: #fff !important;
            font-size: 20px;
            border-radius: 3px;
        }

        .no_style {
            padding: 0px;
        }

            .no_style li {
                list-style: none;
                padding-left: 0px;
            }

        .tag {
            font-family: Arial, sans-serif;
            width: 200px;
            position: relative;
            top: 5px;
            font-weight: bold;
            text-transform: uppercase;
            display: block;
            float: left;
        }

        label {
            display: flex;
        }

        .regular-checkbox {
            display: none;
        }

            .regular-checkbox + label {
                border: 1px solid #cacece;
                box-shadow: 0 1px 2px rgba(0,0,0,0.05), inset 0px -15px 10px -12px rgba(0,0,0,0.05);
                padding: 9px;
                border-radius: 3px;
                display: inline-block;
                position: relative;
                margin-right: 10px;
            }

                .regular-checkbox + label:active, .regular-checkbox:checked + label:active {
                    box-shadow: 0 1px 2px rgba(0,0,0,0.05), inset 0px 1px 3px rgba(0,0,0,0.1);
                }

            .regular-checkbox:checked + label {
                border: 1px solid #adb8c0;
                box-shadow: 0 1px 2px rgba(0,0,0,0.05), inset 0px -15px 10px -12px rgba(0,0,0,0.05), inset 15px 10px -12px rgba(255,255,255,0.1);
                color: #99a1a7;
            }

                .regular-checkbox:checked + label:after {
                    content: '\2714';
                    font-size: 22px;
                    position: absolute;
                    top: -10px;
                    left: 2px;
                    color: #337ab7 !important;
                }
    </style>
</head>


<body id="myPage" data-spy="scroll" data-target=".navbar" data-offset="60">
    <div class="header">
        <div class="container">
            <div class="row">
                <div class="col-md-12">

                    <div class="logo"><a> <img src="~/PDFContent/img/logo.png"> </a></div>

                </div>
            </div>
        </div>
    </div>
    @foreach (var i in ViewBag.policydata as IEnumerable<HRPolicy>)
    {

        <section>
            <h1 class="pname"><b>Policy :</b><span> @i.PolicyName</span></h1>
            <div class="container">
                <div class="row">

                    <div class="col-md-6 col-sm-6">


                        <div class="panel panel-primary">
                            <div class="panel-heading">
                                Employeement Rules
                            </div>
                            <div class="panel-body">
                                <ul>
                                    <li>
                                        First Week Off :
                                        @if (i.EmpWeekOff == 0)
                                        {
                                            <span>None</span>
                                        }
                                        else if (i.EmpWeekOff == 1)
                                        {
                                            <span>Sunday</span>
                                        }
                                        else if (i.EmpWeekOff == 2)
                                        {
                                            <span>Monday</span>
                                        }
                                        else if (i.EmpWeekOff == 3)
                                        {
                                            <span>Tuesday</span>
                                        }
                                        else if (i.EmpWeekOff == 4)
                                        {
                                            <span>Wednesday</span>
                                        }
                                        else if (i.EmpWeekOff == 5)
                                        {
                                            <span>Thursday</span>
                                        }
                                        else if (i.EmpWeekOff == 6)
                                        {
                                            <span>Friday</span>
                                        }
                                        else if (i.EmpWeekOff == 7)
                                        {
                                            <span>Saturday</span>
                                        }
                                    </li>
                                    <li>
                                        Second Week off :
                                        @if (i.EmpSecondWeekOff == 0)
                                        {
                                            <span>None</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 1)
                                        {
                                            <span>Sunday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 2)
                                        {
                                            <span>Monday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 3)
                                        {
                                            <span>Tuesday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 4)
                                        {
                                            <span>Wednesday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 5)
                                        {
                                            <span>Thursday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 6)
                                        {
                                            <span>Friday</span>
                                        }
                                        else if (i.EmpSecondWeekOff == 7)
                                        {
                                            <span>Saturday</span>
                                        }
                                    </li>
                                    <li>
                                        Half Day Off :
                                        @if (i.EmpHalfDay == 0)
                                        {
                                            <span>None</span>
                                        }
                                        else if (i.EmpHalfDay == 1)
                                        {
                                            <span>Sunday</span>
                                        }
                                        else if (i.EmpHalfDay == 2)
                                        {
                                            <span>Monday</span>
                                        }
                                        else if (i.EmpHalfDay == 3)
                                        {
                                            <span>Tuesday</span>
                                        }
                                        else if (i.EmpHalfDay == 4)
                                        {
                                            <span>Wednesday</span>
                                        }
                                        else if (i.EmpHalfDay == 5)
                                        {
                                            <span>Thursday</span>
                                        }
                                        else if (i.EmpHalfDay == 6)
                                        {
                                            <span>Friday</span>
                                        }
                                        else if (i.EmpHalfDay == 7)
                                        {
                                            <span>Saturday</span>
                                        }
                                    </li>
                                    <li>
                                        Allow OverTime :
                                        @if (i.EmpAllowOT == 0)
                                        {
                                            <span>No</span>
                                        }
                                        else if (i.EmpAllowOT == 1)
                                        {
                                            <span>Yes</span>
                                        }
                                    </li>

                                    <li>
                                        Second Week Off Rule :

                                        @{
        if (i.EmpSecondWeekOffRule == "0" || i.EmpSecondWeekOffRule == null)
        {
            <span>None</span>
        }
        else
        {
            string str = i.EmpSecondWeekOffRule;
            var lat = str.Split(',');

            for (var j = 0; j < lat.Length; j++)
            {
                if (lat[j] == "1")
                {
                    <span>First</span>
                }
                if (lat[j] == "2")
                {
                    <span>Second</span>
                }
                if (lat[j] == "3")
                {
                    <span>Third</span>
                }
                if (lat[j] == "4")
                {

                    <span>Fourth</span>
                }
                if (lat[j] == "5")
                {
                    <span>Fifth</span>
                }
            }
        }


                                        }
                                    </li>
                                    <li>
                                        HalfDay Rule :
                                        @{
        if (i.EmpHalfDayRule == "0" || i.EmpHalfDayRule == null)
        {
            <span>None</span>
        }
        else
        {
            string strHalf = i.EmpHalfDayRule;
            var latHalf = strHalf.Split(',');

            for (var j = 0; j < latHalf.Length; j++)
            {
                if (latHalf[j] == "1")
                {
                    <span>First</span>
                }
                if (latHalf[j] == "2")
                {
                    <span>Second</span>
                }
                if (latHalf[j] == "3")
                {
                    <span>Third</span>
                }
                if (latHalf[j] == "4")
                {

                    <span>Fourth</span>
                }
                if (latHalf[j] == "5")
                {
                    <span>Fifth</span>
                }
            }
        }
                                        }

                                    </li>
                                </ul>
                            </div>

                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6">
                        <div class="panel panel-primary">
                            <div class="panel-heading">
                                Formula of Shift Calculation
                            </div>
                            <div class="panel-body">

                                <ul>
                                    <li>OUT Punch accepted within :<span>@i.MaxOutDur</span>Hrs.</li>
                                    <li>Grace Time For Late IN  :<span>@i.GraceLateIN</span> Minutes</li>
                                    <li>Application Mode :<span>Auto</span></li>
                                    <li>Time Duration between two punches :<span> @i.TimeBetPunch</span> Minutes</li>
                                    <li>Grace Time For Early OUT  :<span> @i.GraceEarlyOUT</span> Minutes</li>
                                    <li>Start Day of the Monthly Report :<span>  @i.MonthlyRptStaDay</span></li>
                                </ul>
                            </div>

                        </div>
                    </div>





                </div>


                <div class="row">
                    <div class="col-md-12 ">
                        <div class="title">Overtime Calculation Formula</div>
                    </div>
                    <div class="col-md-12 col-sm-12">
                        @if (i.OTFormula == 1)
                        {
                            <center><h4><label><b><u> Working Hrs - Shift Hrs</u></b></label></h4></center>
                        }
                        @if (i.OTFormula == 2)
                        {
                            <center><h4><label><b><u> Working Hrs - Present Hrs</u></b></label></h4></center>
                        }
                        @if (i.OTFormula == 3)
                        {
                            <center><h4><label><b><u>After Shift - End Time</u></b></label></h4></center>
                        }
                        @if (i.OTFormula == 4)
                        {
                            <center><h4><label><b><u>Before Shift - Start Time</u></b></label></h4></center>
                        }

                        <ul class="no_style ">
                            <li><label><input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label>  Minimum Hour for OverTime Start  :  <span>  @i.OTMinHour  </span>&nbsp; Minutes </label></li>

                            <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Weekly off hour Calculated as OverTime Hour :  <span>    @i.WeekOffOTHour  </span>&nbsp;  Minutes </label></li>

                            <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Holiday off hour Calculated as OverTime Hour :  <span>   @i.HolidayOffOTHour  </span>&nbsp;  Minutes </label></li>

                            <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Calculated As absent for Weekly Off & Holiday Off if Employee not Present for Whole Month</label></li>
                        </ul>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 ">
                        <div class="title">Sandwhich Rule</div>
                    </div>
                    <div class="col-md-12 col-sm-12">
                        @if (i.Issedwrule == 1)
                        {
                            <center><h4><label><b><u>  Sandwich rule applied </u></b></label></h4></center>
                        }
                        <ul class="no_style ">
                            @if(i.IssedwruleType == 1)
                            {
                                <li><label><input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Week off or Holiday absent if prefix And suffix day absent </label></li>
                            }
                            @if (i.IssedwruleType == 2)
                            {
                                <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Week off or Holiday absent if prefix Or suffix day absent </label></li>
                            }
                            @if (i.IssedwruleType == 3)
                            {
                                <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Week off or Holiday absent if prefix day absent  </label></li>
                            }
                            @if (i.IssedwruleType == 4)
                            {
                                <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Week off or Holiday absent if suffix day absent </label></li>
                            }                            
                        </ul>
                    </div>
                </div>


                <div class="row">



                    <div class="col-md-12 col-sm-12">
                        <div class="title">Attendance Rule</div>
                        <ul class="no_style">
                            @if (i.AllErrorCase == 1)
                            {
                                <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label>Calculate present in Any Error Case </label> </li>
                            }
                            else
                            {
                                <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Calculate Half Day when Error case</label> </li>
                            }
                        </ul>
                        <hr>
                        <ul class="no_style">
                            @if (i.HdLate != 0)
                            {
                                <li><label><input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Calculate Half Day if Late Count Greater or equal @i.HdLate</label> </li>
                            }
                            @if (i.HdEd != 0)
                            {
                                <li><label><input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Calculate Half Day if Early Departure Count Greater or equal @i.HdEd</label> </li>
                            }
                            @if (i.HdLateorEd != 0)
                            {
                                <li><label><input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Calculate Half Day if Late or Early Departure Count Greater or equal  @i.HdLateorEd</label> </li>
                            }
                            @if (i.ALate != 0)
                            {
                                <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Calculate Absent if Late Count Greater or equal @i.ALate</label> </li>
                            }
                            @if (i.AED != 0)
                            {
                                <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Calculate Absent if Early Departure Count Greater or equal @i.AED</label> </li>
                            }
                            @if (i.ALateorED != 0)
                            {
                                <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Calculate Absent if Late or Early Departure Count Greater or equal  @i.ALateorED</label> </li>
                            }
                        </ul>

                        <hr>
                        <ul class="no_style">
                            @if (i.TotalHrafterStatus == 1)
                            {
                                <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Total hour calculated when After Shift Start </label> </li>
                            }
                            @if (i.TotalHrbeforeStatus == 1)
                            {
                                <li><label> <input type="checkbox" id="checkbox-1-1" class="regular-checkbox" checked disabled /><label for="checkbox-1-1"></label> Total hour calculated when Before Shift End </label> </li>
                            }


                        </ul>
                    </div>

                </div>
            </div>
        </section>

    }
    <div class="footer">
        <a>app.minopcloud.com</a>
    </div>
</body>
</html>



