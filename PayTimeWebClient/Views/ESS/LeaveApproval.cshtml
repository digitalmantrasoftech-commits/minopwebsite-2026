                        toastr.success("Leave rejected successfully.");
                        $("#appactionbtn").hide()
                        $(".loading").hide();
                        Search_filter();

                    }
                    else
                    {
                        toastr.remove();
                        toastr.error("Error in rejecting Leave.");
                        $(".loading").hide();
                    }

                    //// 📤 Send notification in Rejected background (non-blocking)
                    //if (leaveDeactiveNotifi.length > 0)
                    //{
                    //    sendLeaveApproveNotification(leaveDeactiveNotifi);
                    //}
                },
                statusCode: {
                    404: function (content) { alert('cannot find resource'); },
                    500: function (content) { alert('internal server error'); }
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    $(".loading").hide();

                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
        });
        $('#ApprovalReason').on('paste', function (e) {
            e.preventDefault();
        });

        $("#btnSave").click(function (event)
        {

            checkSession();
            count++;
            $('#ApprovalReason').change(function () {
                $("#ApprovalReason").removeClass('field_error');
            });

            if ($("#ApprovalReason").val().trim() == "") {
                $("#ApprovalReason").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else
            {
                $("#ApprovalReason").removeClass('field_error');
            }

            $("#ApprovalReason").keypress(function (e) {
                $("#DesignationName").removeClass('field_error');
            });

            if ("@_isdateformat" == "dd-mm-yyyy") {
                var fromDate = $("#FromDate").val().split("-");
                var _Fromdate = fromDate[2] + "-" + fromDate[1] + "-" + fromDate[0];
                var toDate = $("#ToDate").val().split("-");
                var _toDate = toDate[2] + "-" + toDate[1] + "-" + toDate[0];
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                var fromDate = $("#FromDate").val().split("-");
                var _Fromdate = fromDate[2] + "-" + fromDate[0] + "-" + fromDate[1];
                var toDate = $("#ToDate").val().split("-");
                var _toDate = toDate[2] + "-" + toDate[0] + "-" + toDate[1];
            }
            else if ("@_isdateformat" == "yyyy-mm-dd") {
                var fromDate = $("#FromDate").val().split("-");
                var _Fromdate = fromDate[0] + "-" + fromDate[1] + "-" + fromDate[2];
                var toDate = $("#ToDate").val().split("-");
                var _toDate = toDate[0] + "-" + toDate[1] + "-" + toDate[2];
            }
            else if ("@_isdateformat" == "yyyy-M-dd") {
                var fromDate = $("#FromDate").val().split("-");
                var getMonth = fromDate[1];
                var _Fromdate = fromDate[0] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + fromDate[2];
                var toDate = $("#ToDate").val().split("-");
                var getMonth = toDate[1];
                var _toDate = toDate[0] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + toDate[2];
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {
                var fromDate = $("#FromDate").val().split("-");
                var getMonth = fromDate[0];
                var _Fromdate = fromDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + fromDate[1];
                var toDate = $("#ToDate").val().split("-");
                var getMonth = toDate[0];
                var _toDate = toDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + toDate[1];
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {
                var fromDate = $("#FromDate").val().split("-");
                var getMonth = fromDate[1];
                var _Fromdate = fromDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + fromDate[0];
                var toDate = $("#ToDate").val().split("-");
                var getMonth = toDate[1];
                var _toDate = toDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + toDate[0];
            }
            var leaveId = $("#LeaveId").val();
            var empId = $("#EmpId").val();
            var fromDate = _Fromdate;
            var toDate = _toDate;
            var applyReason = $("#ApplyReason").val();
            var leaveTypeId = $("#LeaveTypeId").val();
            var leavePaid = $("#LeavePaid").val();
            var leaveStatus = $("#LeaveStatus").val();
            var approvalReason = $("#ApprovalReason").val();
            var IsHalfLeave = $("#IsHalfLeave").val();
            var LeaveDoc = $("#LeaveDoc").val();
            var _eventID = 0;

            var _EmpName = $("#EmployeeName").val();
            var _LeaveTypeName = $("#LeaveTypeName").val();

            ////Cancel Leave Status
            if (leaveStatus == 4)
            {
                ///Leave Cancel Event ID
                _eventID = 3;
            }
            ////Rejected Leave Status
            else if (leaveStatus == 2)
            {
                ///Rejected Cancel Event ID
                _eventID = 4;
            }

            var obj =
            {
                LeaveId: leaveId,
                EmpId: empId,
                FromDate: fromDate,
                ToDate: toDate,
                ApplyReason: applyReason,
                LeaveTypeId: leaveTypeId,
                LeavePaid: leavePaid,
                LeaveStatus: leaveStatus,
                ApprovalReason: approvalReason,
                IsHalfLeave: IsHalfLeave,
                LeaveDoc: LeaveDoc
            };

            var notificationParams =
            [{
                EmpId: empId,
                InPunchTime: fromDate,
                OutPunchTime: toDate,
                ApplyReason: applyReason,
                LeaveTypeName: _LeaveTypeName,
                EmployeeName: _EmpName,
                EventId: _eventID,
                ApprovalReason: approvalReason,
                ReportingPersonName: approvalReason,
                LeaveCorrectionID: leaveId
            }];

            $.ajax({
                url: '/ESS/ApproveLeave',
                type: 'POST',
                headers: { 'Authorization': '@_tokan' },
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (data) {

                    if (data.ad == "ok") {
                        var leaveStatus = $("#LeaveStatus").val();
                        if (leaveStatus == 1) {
                            toastr.remove();
                            toastr.success("Leave approved successfully.");
                            $(".loading").hide();
                        }
                        else if (leaveStatus == 2) {
                            toastr.remove();
                            toastr.success("Leave rejected successfully.");
                            $(".loading").hide();
                        }
                        else if (leaveStatus == 4) {
                            toastr.remove();
                            toastr.success("Leave canceled successfully.");
                            $(".loading").hide();
                        }
                        $('#frmpopup').modal('toggle');
                        t.draw();
                        $(".loading").hide();
                    }
                    else {
                        var leaveStatus = $("#LeaveStatus").val();
                        if (leaveStatus == 1) {
                            toastr.remove();
                            toastr.error("Error in approving Leave.");
                            $(".loading").hide();
                        }
                        else if (leaveStatus == 2) {
                            toastr.remove();
                            toastr.error("Error in rejecting Leave.");
                            $(".loading").hide();
                        }
                        else if (leaveStatus == 4) {
                            toastr.remove();
                            toastr.error("Error in canceling Leave.");
                            $(".loading").hide();
                        }
                        $('#frmpopup').modal('toggle');
                        t.draw();
                        $(".loading").hide();
                    }
                    //// 📤 Send notification in Rejected background (non-blocking)
                    setTimeout(function ()
                    {
                        sendLeaveApproveNotification(notificationParams);
                    }, 1000);
                },
                statusCode: {
                    404: function (content) { alert('cannot find resource'); $(".loading").hide(); },
                    500: function (content) { alert('internal server error'); $(".loading").hide(); }

                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    $(".loading").hide();

                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
        });

        $("#tblleaveapproval").on('click', '.disapprove', function () {
            $('#btndisableapprove').attr("disabled", "disabled");
            $('#btndisableapprove').unbind("click");
        });
        $("#tblleaveapproval").on('click', '.disreject', function () {
            $('#btndisableapprove').attr("disabled", "disabled");
            $('#btndisableapprove').unbind("click");
        });
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Approved Leave";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        });
        function checkSession() {
            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {

                    if (data.isRedirect) {
                        window.top.location.href = data.redirectUrl;
                    }
                },
                error: function (data) {

                    window.top.location.href = data;
                }
            });
        }
        $('.tooltips').tooltip();

        function sendLeaveApproveNotification(leaveDeactiveNotifi, successCallback, errorCallback)
        {
            //?? Call to send notification (Backend API call)
            $.ajax({
                url:'@_webapiurl' + "NotificationRuleDetails/LeaveApproveNotification",
                type: 'POST',
                headers: { 'Authorization': '@_tokan' },
                dataType: "json",
                data: JSON.stringify(leaveDeactiveNotifi),
                contentType: "application/json",
                success: function (response)
                {
                    console.log("Notification sent successfully:", response);
                    if (typeof successCallback === 'function')
                    {
                        successCallback(response);
                    }
                },
                error: function (xhr, status, error)
                {
                    console.warn("Notification sending failed:", error);
                    if (typeof errorCallback === 'function')
                    {
                        errorCallback(xhr, status, error);
                    }
                }
            });
        }
    });
</script>

