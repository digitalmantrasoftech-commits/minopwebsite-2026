        function checkPrevReq() {            
            checkSession();
            var totalOptions = $('#Select_Employee option').length;
            var selectedOptions = $('#Select_Employee option:selected').length;
            if (sessionStorage.getItem("LeaveCount") == "0") {
                sessionStorage.removeItem("LeaveCount");
                event.preventDefault();
                $('#tblempty').hide();  // Example: Show an empty message
                $('#NotificationGrid-empty1').show();
                return;
            }

            var _EmpId = '@Convert.ToInt32(Session["EmpId"])';
            var _ClientCompanyId = '@Convert.ToInt32(Session["ClientCompanyId"])';
            var _BranchId = '@Convert.ToInt32(Session["BranchId"])';

            var selectedStatus = $("#selectstatus").val();
            if ($("#selectstatus").val() == 0) {
                $("#allnoteid").show();
            }
            else {
                $("#allnoteid").hide();
            }
            var filterFromDate = $("#FilterFromDate").val();
            var filterToDate = $("#FilterToDate").val();
            var _arrEmployee = ['0'];
            var _Employee = $("#Select_Employee").val();
            if (_Employee == "" || _Employee == null) {
                _Employee = ['0'];
            }
            if (totalOptions == selectedOptions) {
                _arrEmployee = "0"
            }
            else {
                _arrEmployee = _Employee.join(",");
            }

            _arrstatus = selectedStatus;

            var Employeeids = _arrEmployee;
            let isSelectedAll = $("#Select_EmployeeContainer li").hasClass("multiselect-item multiselect-all active") == true ? 1 : 0;
            let searchTerm = "";
            if ($("#Select_EmployeeContainer li input").hasClass("multiselect-search")) {
                searchTerm = $("#Select_EmployeeContainer li .multiselect-search").val().trim();
                if (isSelectedAll == 1 && searchTerm.length > 0) _arrEmployee = "";
            }
            $("#prv_Date").empty();
            var obj = {
                FilterFromDate: filterFromDate,
                FilterToDate: filterToDate,
                _IsStatus: selectedStatus,
                roleid: '@_RoleId',
                EmpId: _EmpId,
                cmpid: _ClientCompanyId,
                branchid: _BranchId == null ? 0 : _BranchId,
                planid: '@_PlanId',
                _lockAttendanceDay: '@_lockAttendanceDay',
                Employeeids: Employeeids,
                selectAllSearchTerm: searchTerm
            }
            $.ajax({
                type: "POST",
                url: "@_webapiurl" + "Transaction/checkPrevleaveReq",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify(obj),
                headers: { 'Authorization': '@_tokan' },
                dataType: "json",
                success: function (data) {
                    const wrapper = $(".filter_portlet_wrapper");
                    wrapper.addClass("full-width");
                    console.log(data);
                    if (data.length > 0) {
                        $("#tblAttendanceApproval_wrapper").hide();
                        var cnt = data[0]["cnt"];
                        if (cnt > 0) {

                            $("#noteid").hide();
                            var LastDate = data[0]["Mindt"];
                            var _LastDate = LastDate.split('T');
                            $("#prv_Date").hide();
                            $("#prv_Date").show();
                            $("#prv_Date").append("Your previous leave is pending on date: " + _LastDate[0]);
                            $('#tblempty').hide();  // Example: Show an empty message
                            $('#NotificationGrid-empty1').show();
                        }
                        else {
                            Search_filter();
                        }
                    }
                },
                error: function (errormsg) {
                    console.log(errormsg);
                }
            });
        }
