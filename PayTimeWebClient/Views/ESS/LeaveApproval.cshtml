        function fillEmplist(BranchId, selectedDept) {
            if (emprole == '' || emprole == null) return;
            $("#Select_Employee").empty();
            $SelectEmployee.data = { EmpId: pkloginemployeeid, RoleId: emprole, CompanyID :'@_CompanyId', BranchID:'@_BranchId', EmpId:'@_EmpId' };
            $SelectEmployee.loadInitialData();

        }
        function FilterFromDate() {
            var days = 31;
            var selectedStatus = $("#selectstatus").val();
            if (selectedStatus == 0) {
                days = 185;
            }

            if ($('#FilterFromDate').val() != "") {
                var start = $('#FilterFromDate').val();
                var end = $('#FilterToDate').val();
                if (end != "") {
                    var diff = Date.parse(end) - Date.parse(start);
                    days = diff / 1000 / 60 / 60 / 24;
                    if (selectedStatus == 0) {
                        if (days > 185) {
                            days = 185;
                        }
                    }
                    else {
                        if (days > 31) {
                            days = 31;
                        }
                    }
                }
                else {
                    end = 31;
                }

                var date = new Date($("#FilterFromDate").val()), daynew, daynew = days
                if (!isNaN(date.getTime())) {
                    date.setDate(date.getDate() + daynew);
                    $("#FilterToDate").val(date.toInputFormat());
                }

            }
        };
        function FilterToDate() {
            var days = 31;
            var selectedStatus = $("#selectstatus").val();
            if (selectedStatus == 0) {
                days = 185;
            }


            if ($('#FilterToDate').val() != "") {
                var start = $('#FilterFromDate').val();
                var end = $('#FilterToDate').val();
                if (start != "") {
                    var diff = Date.parse(end) - Date.parse(start);
                    days = diff / 1000 / 60 / 60 / 24;
                    if (selectedStatus == 0) {
                        if (days > 185) {
                            days = 185;
                        }
                    }
                    else {
                        if (days > 31) {
                            days = 31;
                        }
                    }
                }
                else {
                    days = 31;
                }
                var date = new Date($("#FilterToDate").val()), daynew, daynew = days

                if (!isNaN(date.getTime())) {
                    date.setDate(date.getDate() - daynew);
                    $("#FilterFromDate").val(date.toInputFormat());
                }
            }
        };

