    $(document).ready(function () {
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        sessionStorage.setItem('Active_Page', 'Leave');

        $SelectEmployee = new ServerVirtualDropdown({
            apiUrl: '@_webapiurl' + "DataDropDownOptimize/GetEmployeeHierarchyDropDownData",
