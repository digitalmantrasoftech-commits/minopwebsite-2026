    function Timezone() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/WebPunchTimezoneInfo",
            contentType: "application/json; charset=utf-8",
            dataType: "text",
            success: function (data) {
                nd = new Date(JSON.parse(data));
                var _Hours = nd.getHours();
                if (nd.getHours().toString().length != 2) {
                    _Hours = "0" + nd.getHours();
                }
                var _Minutes = nd.getMinutes();
                if (nd.getMinutes().toString().length != 2) {
                    _Minutes = "0" + nd.getMinutes();
                }
                var _Seconds = nd.getSeconds();
                if (nd.getSeconds().toString().length != 2) {
                    _Seconds = "0" + nd.getSeconds();
                }
                var _tolzone = _Hours + "" + _Minutes + "" + _Seconds;
                //var midday = "AM";
                //midday = (_Hours >= 12) ? "PM" : "AM";
                //$(".ampm").text(midday);
                var _sshour = JSON.parse(data);
                if (_sshour.indexOf("AM") != -1) {
                    $(".ampm").text("AM");
                }
                else {
                    $(".ampm").text("PM");
                }
                var _curday = nd.getDay();
                var days = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
                var _days = "";
                for (j = 0; j < 7; j++) {
                    if (j == nd.getDay()) {
                        _days += "<span class='active'>" + days[j] + "</span>";
                    }
                    else {
                        _days += "<span>" + days[j] + "</span>";
                    }
                }
                $(".weekdays").html(_days);
                var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                $("#Monthdt").text(nd.getDate());
                $("#Monthname").text(monthNames[nd.getMonth()]);
                $("#MonthYear").text(nd.getFullYear());
                var i;
                var _fromatTime = ""
