        for (j = 0; j < 7; j++) {
            if (j == nd.getDay()) {
                _days += "<span class='active'>" + days[j] + "</span>";
            }
            else {
                _days += "<span>" + days[j] + "</span>";
            }
        }
        $(".weekdays").html(_days);

        var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        $("#Monthdt").text(nd.getDate());
        $("#Monthname").text(monthNames[nd.getMonth()]);
        $("#MonthYear").text(nd.getFullYear());
        var i;
        var _fromatTime = ""
        for (i = 0; i < _tolzone.length; i++) {
            var _sl = _tolzone[i];
            if (_sl == 0) {
                _fromatTime += "<div class='zero'>";
            }
            if (_sl == 1) {
                _fromatTime += "<div class='one'>";
            }
            if (_sl == 2) {
                _fromatTime += "<div class='two'>";
            }
            if (_sl == 3) {
                _fromatTime += "<div class='three'>";
            }
            if (_sl == 4) {
                _fromatTime += "<div class='four'>";
            }
            if (_sl == 5) {
                _fromatTime += "<div class='five'>";
            }
            if (_sl == 6) {
                _fromatTime += "<div class='six'>";
            }
            if (_sl == 7) {
                _fromatTime += "<div class='seven'>";
            }
            if (_sl == 8) {
                _fromatTime += "<div class='eight'>";
            }
            if (_sl == 9) {
                _fromatTime += "<div class='nine'>";
            }
            _fromatTime += "<span class='d1'></span><span class='d2'></span><span class='d3'></span><span class='d4'></span><span class='d5'></span><span class='d6'></span><span class='d7'></span></div>";
            if (i == 1 || i == 3) {
                _fromatTime += "<div class='dots'></div>";
            }
        }
        var _tmformate = "<div class='zero'><span class='d1'>" + _Hours + "</span><span class='d2'></span><span class='d3'></span><span class='d4'></span><span class='d5'></span><span class='d6'></span><span class='d7'></span></div><div class='zero'><span class='d1'>" + _Minutes + "</span></div><div class='zero'><span class='d1'>" + _Seconds + "</span></div>";
        $(".digits").html(_fromatTime);
        var t = setTimeout(calcTime, 1000);
    }
