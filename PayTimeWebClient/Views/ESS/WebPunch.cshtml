                    </div>
                </div>
                <hr />
                <div class="table-responsive">
                    <table id="tblwebpunch" class=" table table-striped table-bordered table-hover table-checkable order-column ">
                        <thead class="ui-state-default">
                            <tr>
                                <th>Sr. No</th>
                                <th>Date  <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                <th>Punch Mode</th>
                                <th>Punch Time</th>
                                <th>Location</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int n = 1;
                            }
                            @if (ViewBag.GetPunchbyEmployee != null)
                            {
                                foreach (var i in ViewBag.GetPunchbyEmployee)
                                {
                                    <tr class="odd gradeX">
                                        <td id="sr">@n</td>
                                        @*<td id="punchdate">@Convert.ToDateTime(i.In_Out_Time).ToString("yyyy-MM-dd")</td>*@
                                        @*<td id="punchdate">@Convert.ToDateTime(i.In_Out_Time).ToString(@_isdateformat.Replace("mm", "MM"))</td>*@
                                        @if (_isdateformat == "yyyy-M-dd" || _isdateformat == "M-dd-yyyy" || _isdateformat == "dd-M-yyyy")
                                        {
                                            <td id="punchdate">@Convert.ToDateTime(i.In_Out_Time).ToString(@_isdateformat.Replace("M", "MMM"))</td>
                                        }
                                        else
                                        {
                                            <td id="punchdate">@Convert.ToDateTime(i.In_Out_Time).ToString(@_isdateformat.Replace("mm", "MM"))</td>
                                        }
                                        <td id="punchmode">@i.Mode</td>
                                        <td id="inouttime">@Convert.ToDateTime(i.In_Out_Time).ToString("HH:mm:ss")</td>
                                        <td id="LocationAdd">@i.LocAddress</td>
                                        @if (i.EntryMode == 0)
                                        {
                                            <td>Manual Punch</td>
                                        }
                                        else if (i.EntryMode == 1)
                                        {
                                            <td>Device Punch</td>
                                        }
                                        else
                                        {
                                            if (i.IsApprove == 0)
                                            {
                                                <td>Pending</td>
                                            }
                                            else if (i.IsApprove == 1)
                                            {
                                                <td>Approved</td>
                                            }
                                            else
                                            {
                                                <td>Rejected</td>

                                            }
                                        }

                                    </tr>
                                    n++;
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>
