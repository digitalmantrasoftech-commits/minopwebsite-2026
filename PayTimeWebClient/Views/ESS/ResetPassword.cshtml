@model PayTimeWebClient.Models.ResetPassword
@{
    Layout = null;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reset Password | Mantra</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <link rel="shortcut icon" href="assets/images/favicon.ico">
    <script src="~/Scripts/jquery-1.12.4.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <link rel="stylesheet" type="text/css" href="~/Content/toastr.min.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/fonts/stylesheet.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/style.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/font-awesome.min.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/responsive.css" />
    <link rel="stylesheet" type="text/css" href="~/Newlayout/css/forgotpassword.css" />
</head>

<body>
    @using (Html.BeginForm("ResetPassword", "ESS", FormMethod.Post))
    {
        <div class="row">
            <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
                <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
            </div>
        </div>

        <div class="forgot_block">
            <div class="col-md-6 col-sm-6 left-block-50">
                <img class="img-fluid" src="/Assets/images/forgotpass_img.png" alt="Forgot Password Image">
            </div>

            <div class="col-md-6 col-sm-6">
                <div class="right-block-50">
                    <div class="forgot_pwd_right">
                        <div class="content">
                            <img src="/AssetsNew/images/logo.png" width="200" alt="Logo">
                            <div class="row">
                                <div id="divresetpass">
                                    <div class="col-md-12">
                                        <h3 class="font-green spanlogin">Reset Password</h3>
                                        <p class="title red">@ViewBag.Meg</p>
                                        <div class="form-group" hidden>
                                            <input type="text" class="form-control" id="RoleId" name="RoleId" value="@_RoleId" />
                                            @if (_RoleId == 6805 || _RoleId == 6806)
                                            {
                                                <input type="text" class="form-control" id="EmpId" name="EmpId" value="@Session["UserId"]" />
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" id="EmpId" name="EmpId" value="@Session["EmpId"]" />
                                            }

                                            <input type="text" class="form-control" id="UserEmail" name="UserEmail" value="@Session["UserEmail"]" />
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label">Current Password<span class="required" aria-required="true" style="color:red;"> * </span></label>
                                            <input type="password" class="form-control" id="Password" name="Password" required="" value="@Session["UserEmail"]" readonly />
                                        </div>
                                        <div class="form-group password-strength">
                                            <label class="control-label">New Password<span class="required" aria-required="true" style="color:red;"> * </span></label>
                                            <input type="password" class="form-control" id="NewPassword" name="NewPassword" />
                                            <span class="eye-icon" id="togglePassword" style="cursor: pointer; position: absolute; right: 10px; bottom: 8px; font-size: 12px;">
                                                <i class="fa fa-eye"></i>
                                            </span>
                                        </div>
                                        <div class="form-group">
                                            <label class="control-label">Confirm New Password<span class="required" aria-required="true" style="color:red;"> * </span></label>
                                            <input type="password" class="form-control" id="RePassword" name="RePassword" required="" />
                                            <span class="eye-icon" id="togglePassword1" style="cursor: pointer; position: absolute; right: 10px; bottom: 8px; font-size: 12px;">
                                                <i class="fa fa-eye"></i>
                                            </span>
                                        </div>
                                        <div class="login-btn margin-bottom-10">
                                            <input type="submit" class="btn btn-block btn-submit" value="Reset Password" id="btnchangepassword" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <p class="footer_forgot">
                            Copyright ©
                            <script>document.write(new Date().getFullYear())</script> Mantra Softech. All Rights Reserved
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</body>
</html>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ajax_loader").hide();
            $('input[type="password"]').on('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.keyCode == 86) {
                    e.preventDefault();
                    return false;
                }
            });

            $('#Password').keypress(function (e) {
                var keynum;
                if (window.event) { // IE
                    keynum = e.keyCode;
                } else if (e.which) { // Netscape/Firefox/Opera
                    keynum = e.which;
                }
                if (keynum == 62 || keynum == 60)
                    e.preventDefault();
            });

            $('#NewPassword').keypress(function (e) {
                var keynum;
                if (window.event) { // IE
                    keynum = e.keyCode;
                } else if (e.which) { // Netscape/Firefox/Opera
                    keynum = e.which;
                }
                if (keynum == 62 || keynum == 60)
                    e.preventDefault();
            });

            $('#RePassword').keypress(function (e) {
                var keynum;
                if (window.event) { // IE
                    keynum = e.keyCode;
                } else if (e.which) { // Netscape/Firefox/Opera
                    keynum = e.which;
                }
                if (keynum == 62 || keynum == 60)
                    e.preventDefault();
            });

            if ("@_Message" != "") {
                toastr.remove();
                toastr.success("@_Message");
            }
            if ('@_error' != "") {
                toastr.remove();
                toastr.error("@_error");
            }
             if ('@ViewBag.msg' == "Password updated successfully!.") {
                toastr.remove();
                toastr.success("Password change successfully and redirect to the login page.");
                window.setTimeout(function () {
                    window.location.href = '/Paytime/LoginPage';
                }, 3000);
        }

            $("#Password").change(function () {
                $("#Password").removeClass('field_error');
            });

            $("#NewPassword").change(function () {
                $("#NewPassword").removeClass('field_error');
            });

            $("#RePassword").change(function () {
                $("#RePassword").removeClass('field_error');
            });

            $("#NewPassword").change(function () {
                var regexpNewPwd = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;
                if (!regexpNewPwd.test($("#NewPassword").val())) {
                    $("#NewPassword").val('');
                    toastr.remove();
                    toastr.error("Password must contain eight characters, at least one uppercase letter and one lowercase letter, one number and one special character(@@,$,!,%,*,?,&).");
                    event.preventDefault();
                    return false;
                }
            });

            $("#RePassword").change(function () {
                var regexprePwd = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;
                if (!regexprePwd.test($("#RePassword").val())) {
                    $("#RePassword").val('');
                    toastr.remove();
                    toastr.error("Confirm password must contain eight characters, at least one uppercase letter and one lowercase letter, one number and one special character(@@,$,!,%,*,?,&).");
                    event.preventDefault();
                    return false;
                }
            });

            $("#btnchangepassword").click(function (event) {
                var currentpass = $("#Password").val();
                var newpass = $("#NewPassword").val();
                if ($('#Password').val() == '') {
                    $("#Password").addClass('field_error');
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#Password").removeClass('field_error');
                }
                if ($("#NewPassword").val() == '') {
                    $("#NewPassword").addClass('field_error');
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#NewPassword").removeClass('field_error');
                }
                if ($("#RePassword").val() == '') {
                    $("#RePassword").addClass('field_error');
                    event.preventDefault();
                    return false;
                }
                else {
                    $("#RePassword").removeClass('field_error');
                }
                if (newpass != $("#RePassword").val()) {
                    toastr.remove();
                    toastr.error("New password and confirm new password does not match.");
                    $("#NewPassword").val('');
                    $("#RePassword").val('');
                    event.preventDefault();
                    return false;

                } else {
                    $("#spPasswordnotmatch").hide();
                }
            });

            $("#RePassword").change(function () {
                var newpass = $("#NewPassword").val();
                if (newpass != $("#RePassword").val()) {
                    toastr.remove();
                    toastr.error("New password and confirm new password does not match.");
                    $("#NewPassword").val('');
                    $("#RePassword").val('');
                    return false;
                } else {
                    $("#spPasswordnotmatch").hide();
                    return true;
                }
            });

            $('#togglePassword').click(function () {
                var passwordInput = $('#NewPassword');
                var inputType = passwordInput.attr('type');
                if (inputType === 'Password' || inputType === 'password') {
                    passwordInput.attr('type', 'text');
                    $('#togglePassword i').removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    passwordInput.attr('type', 'password');
                    $('#togglePassword i').removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            $('#togglePassword1').click(function () {
                var passwordInput = $('#RePassword');
                var inputType = passwordInput.attr('type');
                if (inputType === 'Password' || inputType === 'password') {
                    passwordInput.attr('type', 'text');
                    $('#togglePassword1 i').removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    passwordInput.attr('type', 'password');
                    $('#togglePassword1 i').removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

        })
</script>