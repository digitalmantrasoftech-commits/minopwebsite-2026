        $("#btnactive").click(function () {
            checkSession();
            allEmp = [];

            $("#tblFacePunchApproval .ClsChkEmp").each(function (key, value) {
                if ($(this).is(':checked') == true) {
                    var FacePunch = t.row($(this).parent('td').parent('tr')).data()["FacepunchId"];
