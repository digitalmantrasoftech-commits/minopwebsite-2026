    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }


    function search_Filter() {
        if (sessionStorage.getItem("FacePunchCount") === "0") {
            sessionStorage.removeItem("FacePunchCount");
            event.preventDefault();
            $('#tblempty').hide();  // Example: Show an empty message
            $('#NotificationGrid-empty').show();
            return;
        }
        checkSession();
        var FilterFromDate = $("#FilterFromDate").val();
        var FilterToDate = $("#FilterToDate").val();
        var selectstatus = $("#selectstatus").val();
        if ($("#selectstatus").val() == "3") {
            $("#allnoteid").show();
        }
        else {
            $("#allnoteid").hide();
        }
        $('#tblFacePunchApproval').destroy;
        $("#dataTables_tbl_header").remove();
        $("#noteid").hide();
        var obj = {
            empid: '@_EmpId',
            planid: '@_PlanId',
            roleId: '@_RoleId',
            FilterFromDate: FilterFromDate,
            FilterToDate: FilterToDate,
            cmpid: '@_cmpid',
            branchid: '@_branchid',
            selectstatus: selectstatus,
            Isheararchy: '@_hierchywis',
            _lockAttendanceDay: '@_lockAttendanceDay'

        }
        $.ajax({
            type: "POST",
            url: '@_webapiurl' + "Master/FacepunchApproveGetAllFilter?id=0",
            data: JSON.stringify(obj),
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $('#ajax_loaderDevice').show();
            },
            success: function (data) {
                if (data.length == 0) {
                    $('#tblempty').hide();  // Example: Show an empty message
                    $('#NotificationGrid-empty').show();
                }
                else if (data.length > 0) {
                    $('#tblempty').show();  // Example: Show an empty message
                    $('#NotificationGrid-empty').hide();
                    t = $('#tblFacePunchApproval').DataTable({
                        deferRender: true,
                        data: data,
                        order: [],
                        destroy: true,
                        dom: _domCommon,
                        language: _languageCommon,
                        columns: [
                            { "data": "" },
                            { "data": "FacepunchId" },
                            { "data": "Empid" },
                            //{ "data": "EmpPhoto" },
                            {
                                "data": "EmpPhoto" ,
                                "render": function (data, type, full, meta) {
                                    var photo = '/UploadEmpPhoto/' + '@_accountcd' + '/' + data;
                                    if (data != null && data != '') {
                                        data = '<img src="' + photo + '" alt="" style="border-radius: 50%!important;width:34px;height:34px;" class="zoom-image">';
                                    }
                                    else {
                                        data = '<img src= "/Newlayout/images/avtar_two.jpg" style="border-radius: 50%!important;width:34px;height:34px;" class="zoom-image">';
                                    }
                                    return data;
                                }
                            },
                            { "data": "EmpName" },
                            {
                                "data": "Attn_Dt",
                                "render": function (data) {
                                    let dateFormat = '@_isdateformat' == "yyyy-M-dd" ? "YYYY-MMM-DD" : '@_isdateformat' == "M-dd-yyyy" ? "MMM-DD-YYYY" : '@_isdateformat' == "dd-M-yyyy" ? "DD-MMM-YYYY" : '@_isdateformat';
                                    return date = moment(data).format(dateFormat.toUpperCase());
                                }
                            },
                            {
                                "data": "In_Out_Time",
                                "render": function (data) {
                                    return date = moment(data).format("HH:mm:ss");
                                }
                            },
                            { "data": "Mode" },
                            {
                                "data": "Reason",
                            },
                            { "data": "LocAddress" },
                            { "data": "FlagReason" },
                            { "data": "IsApprove" },
                            { "data": "Empcode" },
                            { "data": "ApprovalDate" },
                            { "data": "ReportingName" },
                        ],
                        columnDefs: [
                            {
                                "targets": [1, 2, 8],
                                "visible": false
                            },
                            {
                                'targets': 0,
                                'bSortable': false,
