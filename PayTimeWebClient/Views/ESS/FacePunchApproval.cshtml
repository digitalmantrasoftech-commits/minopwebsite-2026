    $(document).ready(function () {
        var days = 15;

        Date.prototype.toInputFormat = function () {
            var yyyy = this.getFullYear().toString();
            var mm = (this.getMonth() + 1).toString(); // getMonth() is zero-based
            var dd = this.getDate().toString();
            return yyyy + "-" + (mm[1] ? mm : "0" + mm[0]) + "-" + (dd[1] ? dd : "0" + dd[0]); // padding
        };
        var todaydate = new Date();
        if (!isNaN(todaydate.getTime())) {
            todaydate.setDate(todaydate.getDate());
            $("#FilterToDate").val(todaydate.toInputFormat());


        }
        if (!isNaN(todaydate.getTime())) {
            todaydate.setDate(todaydate.getDate() - days);
            $("#FilterFromDate").val(todaydate.toInputFormat());

        }
        //$('#FilterToDate').prop('disabled', true);
        //$("#frmtodate").prop('disabled', true);
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        $("#allnoteid").hide();
        var isDateFormat = '@_isdateformat';
