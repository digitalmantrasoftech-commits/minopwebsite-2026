            $('#btndisableapprove').unbind("click");
        });
        var FilterFromDate = $("#FilterFromDate").val();
        var FilterToDate = $("#FilterToDate").val();
        var selectstatus = $("#selectstatus").val();
        var _RoleId = '@Convert.ToInt32(Session["RoleId"])';
        var _EmpId = '@Convert.ToInt32(Session["EmpId"])';
        var _cmpid = 0;
        var _branchid = 0;
