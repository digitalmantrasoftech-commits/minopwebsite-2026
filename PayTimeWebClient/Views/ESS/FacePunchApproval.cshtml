            _cmpid = '@_cmpid'
            _branchid = '@_branchid'
        }
        var obj = {
            FilterFromDate: FilterFromDate,
            FilterToDate: FilterToDate,
            roleid: _RoleId,
            empid: _EmpId,
            cmpid: _cmpid,
            branchid: _branchid,
            planid: '@_PlanId',
            _lockAttendanceDay: '@_lockAttendanceDay'
        }
        $.ajax({
            type: 'POST',
            //url: "/Ess/AttendanceFilter?FilterFromDate=" + FilterFromDate + "&FilterToDate=" + FilterToDate + "&_IsStatus=" + selectstatus,
            url: '@_webapiurl' + '/Master/FacePunchApproveGetAllprvData',
            //url: '@_webapiurlMS' + '/Master/FacePunchApproveGetAllprvData',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify(obj),
            headers: { 'Authorization': '@_tokan' },
