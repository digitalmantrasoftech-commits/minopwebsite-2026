    function FilterFromDate() {
        var daynew = 15;
        if ($('#FilterFromDate').val() != "") {

            var start = $('#FilterFromDate').val();
            var end = $('#FilterToDate').val();
            if (end != "") {
                var diff = Date.parse(end) - Date.parse(start);
                daynew = diff / 1000 / 60 / 60 / 24;
                if (daynew < 0 || daynew > 31) {
                    if (selectstatus == 3) {
                        daynew = 31;
                    } else {
                        daynew = 15;
                    }
                }
            }
            else {
                if (selectstatus == 3) {
                    daynew = 31;
                } else {
                    daynew = 15;
                }
            }

            var date = new Date($("#FilterFromDate").val()), daynew,
             selectstatus = $("#selectstatus").val();

            if (!isNaN(date.getTime())) {
                date.setDate(date.getDate() + daynew);
                $("#FilterToDate").val(date.toInputFormat());
            }
        }
    };
    function FilterToDate() {

        var daynew = 15;
        if ($('#FilterToDate').val() != "") {

            var start = $('#FilterFromDate').val();
            var end = $('#FilterToDate').val();
            if (start != "") {
                var diff = Date.parse(end) - Date.parse(start);
                daynew = diff / 1000 / 60 / 60 / 24;
                if (daynew < 0 || daynew > 31) {
                    if (selectstatus == 4) {
                        daynew = 31;
                    } else {
                        daynew = 15;
                    }
                }
            }
            else {
                if (selectstatus == 4) {
                    daynew = 31;
                } else {
                    daynew = 15;
                }
            }


            var date = new Date($("#FilterToDate").val()), daynew,
             selectstatus = $("#selectstatus").val();
            if (!isNaN(date.getTime())) {
                date.setDate(date.getDate() - daynew);

                $("#FilterFromDate").val(date.toInputFormat());
            }
        }
    };
</script>

<script type="text/javascript">
    function initMap() {
        console.log('at maps');
        var map = new google.maps.Map(document.getElementById('MyMapLOC'), {
            zoom: 10,
            center: { lat: -34.397, lng: 150.644 }
        });
    }
    function showPosition(position) {
        var lat = position.split(',')[0];
        var long = position.split(',')[1];
        var LatLng = new google.maps.LatLng(lat, long);
        var mapOptions = {
            center: LatLng,
            zoom: 16,
            mapTypeId: google.maps.MapTypeId.ROADMAP
        };
        var map = new google.maps.Map(document.getElementById("MyMapLOC"), mapOptions);
        var geocoder = new google.maps.Geocoder;
        var infowindow = new google.maps.InfoWindow;
        var address = '';
        geocoder.geocode({ 'location': LatLng }, function (results, status) {
            if (status === 'OK') {
                if (results[0]) {

                    var marker = new google.maps.Marker({
                        position: LatLng,
                        title: results[0].formatted_address
                    });
                    $("#latlagAddress").val(results[0].formatted_address);
                    marker.setMap(map);
                    var getInfoWindow = new google.maps.InfoWindow({
                        content: "<b>Your Current Location</b><br/> :" +
                            results[0].formatted_address.replace(',', ',<br/>') + ""
                    });
                    getInfoWindow.open(map, marker);
                } else {
                    window.alert('No results found');
                }
            } else {
                window.alert('Geocoder failed due to: ' + status);
            }
        });

    }


</script>

