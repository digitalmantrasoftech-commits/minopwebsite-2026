                },
                success: function (data) {
                    $(".loading").hide();
                    if (data.MegSts == "Ok") {

                        toastr.remove();
                        toastr.success("FacePunch rejected successfully.");

                    }
                    else {
                        toastr.remove();
                        toastr.error("Error in approving face punch.");
                        //$("<div class='alert alert-danger overlay'><label>Error in approving web punch.</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                    }
                    search_Filter()
                },
                statusCode: {
                    404: function (content) { alert('cannot find resource'); },
