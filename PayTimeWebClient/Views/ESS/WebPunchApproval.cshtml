    function FilterFromDate() {
        var daynew = 15;
        if ($('#FilterFromDate').val() != "") {

            var start = $('#FilterFromDate').val();
            var end = $('#FilterToDate').val();
            if (end != "") {
                var diff = Date.parse(end) - Date.parse(start);
                daynew = diff / 1000 / 60 / 60 / 24;
                if (daynew < 0 || daynew > 31) {
                    if (selectstatus == 3) {
                        daynew = 31;
                    } else {
                        daynew = 15;
                    }
                }
            }
            else {
                if (selectstatus == 3) {
                    daynew = 31;
                } else {
                    daynew = 15;
                }
            }

            var date = new Date($("#FilterFromDate").val()), daynew,
             selectstatus = $("#selectstatus").val();

            if (!isNaN(date.getTime())) {
                date.setDate(date.getDate() + daynew);
                $("#FilterToDate").val(date.toInputFormat());
            }
        }
    };
    function FilterToDate() {

        var daynew = 15;
        if ($('#FilterToDate').val() != "") {

            var start = $('#FilterFromDate').val();
            var end = $('#FilterToDate').val();
            if (start != "") {
                var diff = Date.parse(end) - Date.parse(start);
                daynew = diff / 1000 / 60 / 60 / 24;
                if (daynew < 0 || daynew > 31) {
                    if (selectstatus == 4) {
                        daynew = 31;
                    } else {
                        daynew = 15;
                    }
                }
            }
            else {
                if (selectstatus == 4) {
                    daynew = 31;
                } else {
                    daynew = 15;
                }
            }


            var date = new Date($("#FilterToDate").val()), daynew,
             selectstatus = $("#selectstatus").val();
            if (!isNaN(date.getTime())) {
                date.setDate(date.getDate() - daynew);

                $("#FilterFromDate").val(date.toInputFormat());
            }
        }
    };

    function sendWebPunchApproveNotification(leaveDeactiveNotifi, successCallback, errorCallback)
    {
        //?? Call to send notification (Backend API call)
        $.ajax({
            url: '@_webapiurl' + "NotificationRuleDetails/WebPunchApproveNotification",
            type: 'POST',
            headers: { 'Authorization': '@_tokan' },
            dataType: "json",
            data: JSON.stringify(leaveDeactiveNotifi),
            contentType: "application/json",
            success: function (response)
            {
                console.log("Notification sent successfully:", response);
                if (typeof successCallback === 'function')
                {
                    successCallback(response);
                }
            },
            error: function (xhr, status, error)
            {
                console.warn("Notification sending failed:", error);
                if (typeof errorCallback === 'function')
                {
                    errorCallback(xhr, status, error);
                }
            }
        });
    }
