        //  Reusable AJAX Function for Reminder Notification
        function sendReminderNotification(params, successCallback, errorCallback) {
            const requestData = {
                EmpId: params.EmpId,
                roleid: params.RoleId,
                EventId: params.EventId,
                LeaveId: params.LeaveId
            };

            $.ajax({
                url: '@_webapiurl' + "NotificationRuleDetails/Remindernotification",
                type: 'POST',
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(requestData),
                success: function (response) {
                    console.log(" Notification sent successfully:", response);
                    if (typeof successCallback === 'function') {
                        successCallback(response);
                    }
                },
                error: function (xhr, status, error) {
                    console.error(" Notification sending failed:", error);
                    console.warn("Response:", xhr.responseText);
                    if (typeof errorCallback === 'function') {
                        errorCallback(xhr, status, error);
                    }
                }
            });
        }
        // Button Click Handler
        $(document).on('click', '.btnnotification', function ()
        {
            var $row = $(this).closest('tr');
            var leaveID = $row.find('td:eq(1)').text().trim();

            Swal.fire({
                title: `<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_info.svg' alt=''>Notification`,
                html: `
                    <div class="swal_subtitle">
                        <b>Are you sure you want to send this notification?</b>
                        <p>Once sent, the selected user will immediately receive this notification.</p>
                        <p><b>Note:</b> This action cannot be undone.</p>
                    </div>
                `,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No, Cancel',
                confirmButtonText: 'Yes, Send Notification',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const $btn = $('#btnnotification');
                    $btn.prop('disabled', true);

                    const notifyParams =
                    {
                        EmpId: '@_EmpId',
                        RoleId: '@_RoleId',
                        LeaveId: leaveID,
                        EventId: 1
                    };

                    sendReminderNotification(
                        notifyParams,
                        function (response) {

                            toastr.remove();

                            if (response.status === "Success") {
                                toastr.success("Reminder notification sent successfully.");
                            }
                            else if (response.status === "Already") {
                                toastr.info("Reminder already sent today.");
                            }
                            else if (response.status === "Fail") {
                                toastr.error("Failed to send reminder notification.");
                            }
                            else {
                                toastr.warning("Something went wrong. Please try again.");
                            }

                        },
                        function (xhr, status, error) {
                            toastr.remove();
                            toastr.error("Failed to send notification");
                        }

                    );
                    setTimeout(() => $btn.prop('disabled', false), 2000);
                }
            });
        });






