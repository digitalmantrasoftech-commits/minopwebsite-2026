            <a href="#" id="btnAddLeave" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Add Leave"><i class="fa-solid fa-plus"></i></a>
        </div>
    }
</div>

@if (obj.CanView)
{
    <div class="row">
        @*<div id='ajax_loader' class="loading" style="display: none;">
                <img src="~/LandingAssets/images/loading.gif" style="margin-top: 8%; cursor: auto; width: 30%; vertical-align: text-bottom;" />
            </div>*@
        <div class="col-md-12">
            <div class="portlet">


                <div class="portlet-body">
                    @if (ViewBag.allemp.Count != 0)
                    {
                        <div class="table-responsive" id="tableResponsive_leave_request">
                            <table id="tblOnDutyLeave" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column ">
                                <thead>
                                    <tr>
                                        <th hidden>Sr. No</th>
                                        <th hidden>Leave ID</th>
                                        <th>Leave Type</th>
                                        <th>From Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                        <th>To Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                        <th>Reason</th>
                                        <th>Leave Status</th>
                                        <th hidden> LeaveTypeId </th>
                                        <th > Is HalfLeave </th>
                                        <th > Leave Paid </th>
                                        <th hidden> LeaveDoc </th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                @{
                                    int n = 1;
                                }
                                <tbody>
                                    @if (ViewBag.allemp != null)
                                    {
                                        foreach (var item in ViewBag.allemp)
                                        {
                                            <tr>
                                                <td hidden>@n</td>
                                                <td hidden>@item.LeaveId</td>
                                                <td>@item.LeaveTypeName</td>
                                                <td>@item.FromDate</td>
                                                <td>@item.ToDate</td>
                                                <td>@item.ApplyReason</td>
                                                <td>@item.LeaveStatusName</td>
                                                <td hidden>@item.LeaveTypeId </td>
                                                <td >@item.IsHalfLeave </td>
                                                <td>@(item.LeavePaid == 0 ? "Unpaid" : "Paid")</td>
                                                <td hidden>@item.LeaveDoc </td>
                                                <td id="Col_@item.LeaveId">

                                                    @{
                                                        DateTime? fromdate = null; // Declare fromdate at a higher scope and initialize it as nullable

                                                        if (_isdateformat == "yyyy-mm-dd")
                                                        {
                                                            fromdate = DateTime.ParseExact(item.FromDate, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
                                                        }
                                                        else if (_isdateformat == "mm-dd-yyyy")
                                                        {
                                                            fromdate = DateTime.ParseExact(item.FromDate, "MM-dd-yyyy", System.Globalization.CultureInfo.InvariantCulture);
                                                        }
                                                        else if (_isdateformat == "dd-mm-yyyy")
                                                        {
                                                            fromdate = DateTime.ParseExact(item.FromDate, "dd-MM-yyyy", System.Globalization.CultureInfo.InvariantCulture);
                                                        }
                                                        else if (_isdateformat == "yyyy-M-dd")
                                                        {
                                                            fromdate = DateTime.ParseExact(item.FromDate, "yyyy-MMM-dd", System.Globalization.CultureInfo.InvariantCulture);
                                                        }
                                                        else if (_isdateformat == "M-dd-yyyy")
                                                        {
                                                            fromdate = DateTime.ParseExact(item.FromDate, "MMM-dd-yyyy", System.Globalization.CultureInfo.InvariantCulture);
                                                        }
                                                        else if (_isdateformat == "dd-M-yyyy")
                                                        {
                                                            fromdate = DateTime.ParseExact(item.FromDate, "dd-MMM-yyyy", System.Globalization.CultureInfo.InvariantCulture);
                                                        }
                                                    }

                                                    @if (fromdate.HasValue && fromdate.Value.ToString("yyyy-MM") == DateTime.Now.ToString("yyyy-MM"))
                                                    {
                                                        if (_RoleId == 1 && @item.LeaveStatus == 3)
                                                        {
                                                            <a href="javascript:;" class="btn red_btnnew tooltips btnnotification" data-placement="top" title="Notification" data-id="@item.LeaveId" ><i class="fa-light fa-bell"></i></a>
                                                            <a href="javascript:;" class="btn red_btnnew tooltips cancel" data-placement="top" title="Cancel Leave" id="btncancelleave"><i class="fa-regular fa-ban"></i></a>
                                                        }
                                                        else if (_RoleId > 1 && obj.CanEdit && _RoleId != 6805 && _RoleId != 6806 && @item.LeaveStatus == 3)
                                                        {
                                                            <a href="javascript:;" class="btn red_btnnew tooltips btnnotification" data-placement="top" title="Notification" data-id="@item.LeaveId"><i class="fa-light fa-bell"></i></a>
                                                            <a href="javascript:;" class="btn red_btnnew tooltips cancel" data-placement="top" title="Cancel Leave" id="btncancelleave"><i class="fa-regular fa-ban"></i></a>
                                                        }
                                                    }

                                                </td>
                                            </tr>
                                            n++;
                                        }

                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div id="NotificationGrid-empty">
                            <div class="datanotfound">
                                <img src="~/assets/images/emptyscreen_1.png" height="148" width="280" alt="Nodata Found Icon">
                                <p class="datanotfound_title">No data found</p> <!-- titleText -->
                                <p class="">No entries found. Please add a record to get started.</p><!-- subText -->
                            </div>
                        </div>
                    }

                    <div id='ajax_loaderCompany' class="modal_bg loading">
                        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
                    </div>

                    <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                        <div class="modal-dialog">
                            <!-- Modal content-->
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Leave Request</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="alert alert-danger popMsg" hidden>
                                        <a href="#" class="close" data-dismiss="alert">&times;</a>
                                        <strong id="strstg">Error ! </strong> @_error
                                    </div>
                                    <div class="modal-card">
                                        <div class="row setup-content" id="step-1">
                                            <fieldset>
                                                <input type="hidden" id="OnDutyLeaveId" value="0">
                                                <input type="hidden" id="hfEmpCode" value="0">
                                                <input type="hidden" id="hfAvailBal" value="0">
                                                <input type="hidden" id="CompanyID" value="0" />
                                                <input type="hidden" id="BranchID" value="0" />
                                                <input type="hidden" id="ddlEmployee" value="@Convert.ToInt32(Session["EmpId"])">
                                                <input type="hidden" id="IsPaidFlag" value="0" />

                                                <div class="col-md-12">
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="form-group">
                                                                <label>Leave <span class="required" aria-required="true"> * </span></label>
                                                                <select class="form-control input-sm" id="ddlLeaveType" name="ddlLeaveType">
                                                                    <option value="0" selected>-- Select Leave --</option>
                                                                    @foreach (var item in ViewBag.LeaveTypeList as IEnumerable<SelectListItem>)
                                                                    {
                                                                        <option value="@item.Value">@item.Text</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="form-group data_picker_box">
                                                                <label>From Date <span class="required" aria-required="true"> * </span></label>
                                                                <div class="input-group input-group-sm date date-picker" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                                                                    <span class="input-group-btn">
                                                                        <button class="btn default" type="button">
                                                                            <i class="fa-light fa-calendar-days"></i>
                                                                        </button>
                                                                    </span>
                                                                    @if (_isdateformat == "dd-M-yyyy" || _isdateformat == "M-dd-yyyy" || _isdateformat == "yyyy-M-dd")
                                                                    {
                                                                        <input type="text" class="form-control" id="txtFromDate" placeholder="@_isdateformat.Replace("M","MMM")" autocomplete="off">
                                                                    }
                                                                    else
                                                                    {
                                                                        <input type="text" class="form-control" id="txtFromDate" placeholder="@_isdateformat" autocomplete="off">
                                                                    }
                                                                </div>

                                                            </div>

                                                            <div class="form-group margin-top-30">
                                                                <label class="check mt-checkbox mt-checkbox-outline">
                                                                    <input type="checkbox" id="chkIsHalfLeave" class=""> Is Half-Leave?
                                                                    <span></span>
                                                                </label>
                                                            </div>

                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="form-group">
                                                                <label>Leave Type </label>
                                                                <select class="form-control input-sm" id="ddlLeavePaid" name="ddlLeavePaid">
                                                                    <option value="0" selected>UnPaid</option>
                                                                    <option value="1" selected>Paid</option>
                                                                </select>
                                                            </div>

                                                            <div class="form-group data_picker_box">
                                                                <label>To Date <span class="required" aria-required="true"> * </span></label>
                                                                <div class="input-group input-group-sm date date-picker" data-date-format="@_isdateformat" data-date-viewmode="years">
                                                                    <span class="input-group-btn">
                                                                        <button class="btn default" type="button">
                                                                            <i class="fa-light fa-calendar-days"></i>
                                                                        </button>
                                                                    </span>
                                                                    @if (_isdateformat == "dd-M-yyyy" || _isdateformat == "M-dd-yyyy" || _isdateformat == "yyyy-M-dd")
                                                                    {
                                                                        <input placeholder="@_isdateformat.Replace("M","MMM")" type="text" id="txtToDate" data-date-format="@_isdateformat" class="form-control" autocomplete="off">
                                                                    }
                                                                    else
                                                                    {
                                                                        <input placeholder="@_isdateformat" type="text" id="txtToDate" data-date-format="@_isdateformat" class="form-control" autocomplete="off">
                                                                    }
                                                                </div>
                                                            </div>
                                                            <div class="form-group" id="uploadDoc">
                                                                <form id="frmupload" method="post" action="/ESS/UploadLeaveRequestDocument" enctype="multipart/form-data">
                                                                    <div class="form-group">
                                                                        <label>Upload Document <span class="required" aria-required="true" id="uploadleaveid"> * (File size Required 5 MB. and extension files:.pdf,.png,.jpg,.jpeg)</span></label>
                                                                        <input type="file" name="UploadLeaveDoc" id="UploadLeaveDoc" value="">
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6" id="leaveTypeDurationBlock" style="display: none;">
                                                            <div class="form-group">
                                                                <label>Leave Summary</label>
                                                                <select id="ddlLeaveDuration" class="form-control input-sm">
                                                                    <option value="1" selected>First Half</option>
                                                                    <option value="2">Second Half</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12">
                                                            <div class="form-group">
                                                                <label>Reason <span class="required" aria-required="true"> * </span></label>
                                                                <textarea id="txtReason" class="form-control input-sm" maxlength="100"></textarea>
                                                            </div>

                                                            <div class="form-group">
                                                                <div class="row">
                                                                    <div class="col-md-4">
                                                                        <div class="form-group">
                                                                            <input type="hidden" id="latlag" name="latlag" value="">
                                                                            <input type="hidden" id="lat" name="lat" value="">
                                                                            <input type="hidden" id="lag" name="lag" value="">
                                                                            <input type="hidden" id="latlagAddress" name="latlagAddress" value="">
                                                                            <a class="btn default blue-stripe btn-block"><i class="fa-light fa-calendar-check"></i> Leave Balance  : <span id="lblLeaveBalance"> 0</span> </a>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-5">
                                                                        <div class="form-group">
                                                                            <a class="btn default green-stripe btn-block"><i class="fa-light fa-calendar-plus"></i> Carry Forward leaves : <span id="lblEncashLeave"> 0</span> </a>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <div class="form-group">
                                                                            <a class="btn default red-stripe btn-block"><i class="fa-light fa-calendar-circle-plus"></i> Total : <span id="lblTotalBalance"> 0</span> </a>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-xs-12 col-xs-12 form-actions text-right">
                                            <button type="submit" id="btnSave" class="btn btn-sm blue"><i class="fa-light fa-floppy-disk"></i> Save</button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>

}






