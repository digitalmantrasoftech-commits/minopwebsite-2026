        function updateSelectionCount() {
            var table = $("#tbladvsalaryapproval").DataTable();
            var visibleCheckboxes = table.rows({ search: 'applied' }).nodes().to$().find('.ClsChkEmp');
            var totalVisible = visibleCheckboxes.length;
            var checked_count = visibleCheckboxes.filter(':checked').length;

