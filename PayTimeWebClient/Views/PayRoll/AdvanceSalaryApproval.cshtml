        function addMonthsToDate(dateString, monthsToAdd) {
            var date = new Date(dateString);
            var year = date.getFullYear();
            var month = date.getMonth();
            var day = date.getDate();

            // Calculate the new month and year after adding months
            var newMonth = (month + monthsToAdd) % 12;
            var yearsToAdd = Math.floor((month + monthsToAdd) / 12);

            // Adjust year and month if necessary
            var newYear = year + yearsToAdd;
            if (newMonth < 0) {
                newMonth += 12;
                newYear -= 1;
            }

            // Create a new date with the calculated year and month
            var newDate = new Date(newYear, newMonth, day);

            // Adjust the day if the new day is greater than the last day of the new month
            if (newDate.getMonth() !== newMonth) {
                newDate.setDate(0); // Set to the last day of the previous month
            }

            return newDate;
        }

        function getformatedate(date) {
            var day = date.getDate();
            if ("@_isdateformat" == "dd-mm-yyyy") {
                var _month = date.getMonth() + 1;
                return (day > 9 ? day : "0" + day) + "-" + (_month > 9 ? _month : "0" + _month) + "-" + date.getFullYear();
            }
            else if ("@_isdateformat" == "yyyy-mm-dd") {
                var _month = date.getMonth() + 1;
                return date.getFullYear() + "-" + (_month > 9 ? _month : "0" + _month) + "-" + (day > 9 ? day : "0" + day);
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                var _month = date.getMonth() + 1;
                return (_month > 9 ? _month : "0" + _month) + "-" + (day > 9 ? day : "0" + day) + "-" + date.getFullYear();
            }
            else if ("@_isdateformat" == "yyyy-M-dd") {
                var locale = "en-us";
                var month = date.toLocaleString(locale, { month: "short" });
                var day = date.getDate();
                return date.getFullYear() + "-" + month + "-" + (day > 9 ? day : "0" + day);
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {
                var locale = "en-us";
                var month = date.toLocaleString(locale, { month: "short" });
                var day = date.getDate();
                return month + "-" + (day > 9 ? day : "0" + day) + "-" + date.getFullYear();
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {
                var locale = "en-us";
                var month = date.toLocaleString(locale, { month: "short" });
                var day = date.getDate();
                return (day > 9 ? day : "0" + day) + "-" + month + "-" + date.getFullYear();
            }
        }

