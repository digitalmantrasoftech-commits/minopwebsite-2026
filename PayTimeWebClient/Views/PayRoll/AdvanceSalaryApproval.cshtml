                                                </span>
                                                @if (_isdateformat == "dd-M-yyyy" || _isdateformat == "M-dd-yyyy" || _isdateformat == "yyyy-M-dd")
                                                {
                                                    <input type="text" id="end_date" placeholder="@_isdateformat.Replace("M","MMM")" class="form-control input-sm" data-date-format="@_isdateformat" readonly="readonly" disabled="disabled">
                                                }
                                                else
                                                {
                                                    <input type="text" id="end_date" placeholder="@_isdateformat" class="form-control input-sm" data-date-format="@_isdateformat" readonly="readonly" disabled="disabled">
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12">
                                        <div class="form-group">
                                            <label>Comments </label>
                                            <textarea class="form-control" placeholder="Comments" maxlength="500" id="Commemt_id"></textarea>
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </fieldset>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                            <button type="button" class="btn save_btn" id="btnUpdate">Update</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Add Feedback Modal : End -->

</div>
<!-- Request Timeline Modal : Begin -->
<div id="advanceSalaryTimelineModal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">×</button>
                <h4 class="modal-title">Policy Appraisal Timeline</h4>
            </div>
            <div class="modal-body nomodalfooter">
                <div class="modal-card" id="timeline-container">
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Request Timeline Modal : End -->
<!-- Approval/Rejection Modal : Begin -->
<div class="modal fade" id="approvalModal" tabindex="-1" role="dialog" aria-labelledby="approvalModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="approvalModalLabel">Approve or Reject Request</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="approvalTimelineId" />
                <div class="form-group">
                    <label for="approvalRemarks">Remarks</label>
                    <textarea class="form-control" id="approvalRemarks" rows="3" placeholder="Enter your remarks"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="btnApprove">Approve</button>
                <button type="button" class="btn btn-danger" id="btnReject">Reject</button>
            </div>

        </div>
    </div>
</div>
<!-- Approval/Rejection Modal: End -->
