            var approvestatusCount = 0;

            table.$('.ClsChkEmp').each(function () {
                if ($(this).is(':checked')) {
                    var rowData = table.row($(this).closest('tr')).data();
                    var status = rowData["status"];

                    if (status == 6) disburseStatusCount++;
                    if (status == 2) approvestatusCount++;
                }
