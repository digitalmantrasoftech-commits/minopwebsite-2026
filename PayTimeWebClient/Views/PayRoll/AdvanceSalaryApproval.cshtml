                                        } else {
                                            return "";
                                        }
                                    }
                                },

                                {
                                    "targets": [1],
                                    "orderable": true,
                                    "render": function (data, type, row) {
                                        data = "<div class='totoalpay'>" + row["Empcode"] + "</div>";
                                        return data;
                                    }
                                },

                                {
                                    "targets": [2],
                                    "render": function (data, type, row, meta) {
                                        var nameParts = row["EmpName"].split('|')[0].replace(/\s+/g, ' ').trim().split(" ");
                                        var initials = nameParts[0].charAt(0).toUpperCase();
                                        if (nameParts.length > 1) {
                                            initials += nameParts[1].charAt(0).toUpperCase();
                                        }
                                        const colors = ["#e74c3c", "#8e44ad", "#3498db", "#16a085", "#f39c12", "#d35400", "#2c3e50"];
                                        const randomColor = "#295097";

                                        data = `<img alt="" class="user_img img-circle" src="/UploadEmpPhoto/${row["EmpName"].split('|')[1]}"
                               onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"/>
                               <span style="display: none; font-size: 11px; min-width: 20px; height: 20px; line-height: 20px; text-align: center; background-color: #ecf3ff; color:  ${randomColor}; border-radius: 50% !important; border: 1px solid #8ab1f7; margin-right: 8px;">
                               ${initials}</span><span>${row["EmpName"].split('|')[0]}</span>`;
                                        return data;
                                    }
                                },

                                {
                                    "targets": [3],
                                    "render": function (data, type, row) {
                                        data = "<div class='CompanyName'>" + row["CompanyName"] + "</div>";
                                        return data;
                                    }
                                },


                                {
                                    "targets": [4],
                                    "render": function (data, type, row) {
                                        data = "<div class='BranchName'>" + row["BranchName"] + "</div>";
                                        return data;
                                    }
                                },

                                {
                                    "targets": [5],
                                    "render": function (data, type, row) {
                                        data = "<div class='DepartmentName'>" + row["DepartmentName"] + "</div>";
                                        return data;
                                    }
                                },

                                {
                                    "targets": [6],
                                    "render": function (data, type, row) {
                                        data = "<div class='green_font font-weight-bold amount'>₹" + row["amount"] + "</div>";
                                        return data;
                                    }
                                },

                                {
                                    "targets": [7],
                                    "render": function (data, type, row) {
                                        var PreferDate = row["prefer_date"];
                                        var parsedDate = new Date(PreferDate);
                                        var dateformat = "@_isdateformat";
                                        if (!isNaN(parsedDate)) {
                                            data = "<div class='PreferDate'>" + formatDate(parsedDate, dateformat) + "</div>";
                                        }
                                        else {
                                            data = "<div class='PreferDate'>" + parseDateSafe(PreferDate) + "</div>";
                                        }
                                        return data;
                                    }
                                },

                                {
                                    targets: [8],
                                    render: function (data, type, row, meta) {
                                        const workflowName = row.WorkflowName || 'Unassign';

                                        const isWorkflowAssigned = (data === true || data === 1 || data === "1");
                                        const btnClass = isWorkflowAssigned ? "text-success" : "blue_font";
                                        const tooltip = isWorkflowAssigned
                                            ? "Workflow Assigned - Click to change"
                                            : "Assign Workflow";

                                        const status = row.status;

                                        // Disable if already sent for approval (status >= 4)
                                        const isDisabled = status >= 4 || status >= 2;

                                        if (isDisabled) {
                                            return `<span class="tooltips" title="Workflow locked after submission">${workflowName}</span>`;
                                        } else {
                                            return `<a href="javascript:;" class="${btnClass} tooltips Unassign_Btn"data-id="${row.request_id}"data-placement="left"title="${tooltip}">${workflowName}</a>`;
                                        }
                                    }
                                },

                                {
                                    "targets": [11],
                                    "render": function (data, type, row) {
                                        let statusText = "";
                                        let statusClass = "";
                                        status = row["status"];
                                        switch (row["status"]) {
                                            case 1:
                                                statusText = "Pending";
                                                statusClass += 'orange_font';
                                                break;
                                            case 2:
                                                statusText = "Approved";
                                                statusClass += 'green_font';
                                                break;
                                            case 3:
                                                statusText = "Rejected";
                                                statusClass += 'red_font';
                                                break;
                                            case 4:
                                                statusText = "Sent for approval";
                                                statusClass += 'purple_font';
                                                 break;
                                            case 5:
                                                 statusText = "Canceled";
                                                 statusClass += '';
                                                 break;
                                            case 6:
                                                statusText = "Disburse";
                                                statusClass += 'orange_font';
                                                break;
                                            default:
                                                statusText = "Pending";
                                                statusClass += 'orange_font';
                                        }
                                        return `<div class='${statusClass}'>${statusText}</div>`;
                                    },
                                    createdCell: function (td, cellData, rowData, row, col) {
                                        $(td).addClass('fixed-column-1');  // apply class here
                                    }
                                },

                                {
                                    "targets": [12],
                                    orderable: false,
                                    "render": function (data, type, row) {
                                          let btn = '';
                                        if (row.status == 1) {
                                         btn += `  <a class="btn btn-xs seagreen_btnnew tooltips editBtn"data-id="${row.request_id}"data-placement="left"title="Edit"><i class="fa-regular fa-pen-to-square"></i> </a>`;
                                            if (!row.is_workflow_set) {
                                                btn += `
                                                  <a class="btn btn-xs red_btnnew tooltips cancelBtn"
                                                    data-id="${row.request_id}"
                                                    data-placement="left"
                                                    title="Cancel Request">
                                                    <i class="fa-regular fa-ban"></i>
                                                 </a>`
                                            } else {
                                                btn +=`<a class="btn btn-xs seagreen_btnnew tooltips Sendforapprovalbtn"
                                                       data-id="${row.request_id}"
                                                       data-empid="${row.emp_id}"
                                                       data-workflowid="${row.workflowid}"
                                                       data-placement="left"
                                                       title="Send for approval">
                                                       <i class="fa-regular fa-paper-plane"></i>
                                                    </a>`
                                            }

                                        } else {
                                            if (row.status == 3) {
                                                btn += ` <a class="btn btn-xs seagreen_btnnew tooltips editBtn"
                                                    data-id="${row.request_id}"
                                                    data-placement="left"
                                                    title="Edit">
                                                    <i class="fa-regular fa-pen-to-square"></i>
                                                 </a>
                                                 <a class="btn btn-xs seagreen_btnnew tooltips Sendforapprovalbtn"
                                                    data-id="${row.request_id}"
                                                    data-empid="${row.emp_id}"
                                                    data-workflowid="${row.workflowid}"
                                                    data-placement="left"
                                                    title="Send for approval">
                                                    <i class="fa-regular fa-paper-plane"></i>
                                                 </a>`
                                            }
                                            if (row.status != 5) {
                                                btn += `<a class="btn btn-xs blue_btnnew tooltips approvalTimelineBtn"
                                                   data-id="${row.request_id}"
                                                   title="View Approval Timeline">
                                                   <i class="fa-regular fa-info-circle"></i>
                                                </a>`
                                            }
                                        }
                                        return btn;

                                    },
                                    createdCell: function (td, cellData, rowData, row, col) {
                                        $(td).addClass('fixed-column');  // apply class here
                                    }
                                },



                            ],
                        });
                        setTimeout(function () {
                            $("#" + "tbladvsalaryapproval" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                            $('.tooltips').tooltip();
                        }, 100);
                    }
                    else {
                        //$(".filter_portlet_tbl").remove();
                        //console.log("heloo")
                    }
                }
            });
        });

        $('#clear_operation').on('click', function () {
            $("#CompanyID").val("0")
            $("#BranchIds").val("0")
            $("#DeptIds").val("0")
            $("#DesignationID").val("0")
            $("#Status_filter").val("0")
            $Companyselect.multiselect('rebuild');
            $Branchselect.multiselect('rebuild');
            $Departmentselect.multiselect('rebuild');
            $Designationselect.multiselect('rebuild');
        })
    });
      function saleryslip(id, fileName) {
      var apiUrl = '@_webapiurlpayroll' + 'ExportSheet/download/excel?id=' + id;
      var xhr = new XMLHttpRequest();
      xhr.open('GET', apiUrl);
      xhr.setRequestHeader('Authorization', '@_tokan');
      xhr.responseType = 'blob';
      xhr.onload = function () {
          if (xhr.status === 200) {
              var url = URL.createObjectURL(xhr.response);
              var link = document.createElement('a');
              link.href = url;
              link.target = '_blank';
              link.download = fileName || 'download.xlsx';
              document.body.appendChild(link);
              link.click();
              document.body.removeChild(link);
          } else {
              console.error('Error:', xhr.status);
              toastr.remove();
              toastr.error('Error occurred while downloading the file.');
          }
      };
      xhr.send();
  }
</script>

