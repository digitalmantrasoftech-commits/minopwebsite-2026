        function downloadBlobAsExcel(blobData, fileName) {
            const blobURL = URL.createObjectURL(blobData);

            const link = document.createElement('a');
            link.href = blobURL;
            link.target = '_blank';
            link.download = fileName;

            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            URL.revokeObjectURL(blobURL);
        }

        function bindExportcolumn() {

            //bind column names
            checkSession();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'AdvanceSalaryResponse/GetExportSheet',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {

                    $("._column").empty();
                    var str1 = '<div class="col-md-4 ol-xs-6"><label><input type="checkbox" value="' + 'SelectAll' + '" ><span> ' + 'Select All' + '</span></label></div>';
                    $("._column").append(str1);
                    if (response.success == true && response.responseCode == 200) {

                        for (var i = 0; i < response.exportSheetColumns.length; i++) {

                            var str = '<div class="col-md-4 ol-xs-6"><label><input type="checkbox" value="' + response.exportSheetColumns[i].columnCode + '" ><span> ' + response.exportSheetColumns[i].columnTitle + '</span></label></div>';
                            $("._column").append(str);

                        }
                    }

                    // Ensure default checkboxes are selected
                    ensureChecked("input[type='checkbox'][value='Request Amount']");
                    ensureChecked("input[type='checkbox'][value='BankAccountNumber']");
                    ensureChecked("input[type='checkbox'][value='EmployeeCode']");
                    ensureChecked("input[type='checkbox'][value='EmployeeName']");


                    // Prevent unchecking of specified checkboxes
                    preventUncheck("input[type='checkbox'][value='Request Amount']");
                    preventUncheck("input[type='checkbox'][value='BankAccountNumber']");
                    preventUncheck("input[type='checkbox'][value='EmployeeCode']");
                    preventUncheck("input[type='checkbox'][value='EmployeeName']");

                    // "Select All" functionality
                    $("input[type='checkbox'][value='SelectAll']").on("change", function () {

                        var checkboxes =
                            $(this).closest(".col-md-4.ol-xs-6")
                                .siblings()
                                .find("input[type='checkbox']:not([value='Request Amount']):not([value='BankAccountNumber']):not([value='EmployeeCode']):not([value='EmployeeName'])");
                        checkboxes.prop("checked", this.checked);
                        ensureChecked("input[type='checkbox'][value='RequestAmount']");
                        ensureChecked("input[type='checkbox'][value='BankAccountNumber']");
                        ensureChecked("input[type='checkbox'][value='EmployeeCode']");
                        ensureChecked("input[type='checkbox'][value='EmployeeName']");
                        //ensureChecked("input[type='checkbox'][value='Designation']");
                    });
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }


