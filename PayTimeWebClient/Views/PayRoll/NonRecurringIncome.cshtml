            //getEmployee();
            function getEmployee(id, selectedid) {
                checkSession();
                $("#employee").empty();
                $.ajax({
                    type: "POST",
                    url: '@_webapiurlpayroll' + 'Employee/GetEmployeesByCustomHeadids?head_id=' + id,
                    headers: { 'Authorization': '@_tokan' },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    async: "false",
                    success: function (response) {
                        var res = JSON.parse(response);
                        var option = "";
                        if (res != null && res.length > 0) {
                            for (var i = 0; i < res.length; i++) {
                                if (selectedid == res[i].EmpId) {
                                    option += '<option selected value="' + res[i].EmpId + '">' + res[i].EmpName + " (" + res[i].Empcode + ") " + '</option>';
                                } else {
                                    option += '<option  value="' + res[i].EmpId + '">' + res[i].EmpName + " (" + res[i].Empcode + ") " + '</option>';
                                }
                            }
                        }
                        $("#employee").append(option);
                        $employee.multiselect('rebuild');

                        if (selectedid > 0) {
                            $("#employee").closest('div').find('button').prop('disabled', true);
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });

            }

