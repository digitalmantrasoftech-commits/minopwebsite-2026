        function addMonthsToDate(dateString, monthsToAdd) {
            var date = new Date(dateString);
            var year = date.getFullYear();
            var month = date.getMonth();
            var day = date.getDate();

            // Calculate the new month and year after adding months
            var newMonth = (month + monthsToAdd) % 12;
            var yearsToAdd = Math.floor((month + monthsToAdd) / 12);

            // Adjust year and month if necessary
            var newYear = year + yearsToAdd;
            if (newMonth < 0) {
                newMonth += 12;
                newYear -= 1;
            }

            // Create a new date with the calculated year and month
            var newDate = new Date(newYear, newMonth, day);

            // Adjust the day if the new day is greater than the last day of the new month
            if (newDate.getMonth() !== newMonth) {
                newDate.setDate(0); // Set to the last day of the previous month
            }

            return newDate;
        }
