        function getformatedate(date) {
            var day = date.getDate();
            if ("@_isdateformat" == "dd-mm-yyyy") {
                var _month = date.getMonth() + 1;
                return (day > 9 ? day : "0" + day) + "-" + (_month > 9 ? _month : "0" + _month) + "-" + date.getFullYear();
            }
            else if ("@_isdateformat" == "yyyy-mm-dd") {
                var _month = date.getMonth() + 1;
                return date.getFullYear() + "-" + (_month > 9 ? _month : "0" + _month) + "-" + (day > 9 ? day : "0" + day);
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                var _month = date.getMonth() + 1;
                return (_month > 9 ? _month : "0" + _month) + "-" + (day > 9 ? day : "0" + day) + "-" + date.getFullYear();
            }
            else if ("@_isdateformat" == "yyyy-M-dd") {
                var locale = "en-us";
                var month = date.toLocaleString(locale, { month: "short" });
                var day = date.getDate();
                return date.getFullYear() + "-" + month + "-" + (day > 9 ? day : "0" + day);
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {
                var locale = "en-us";
                var month = date.toLocaleString(locale, { month: "short" });
                var day = date.getDate();
                return month + "-" + (day > 9 ? day : "0" + day) + "-" + date.getFullYear();
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {
                var locale = "en-us";
                var month = date.toLocaleString(locale, { month: "short" });
                var day = date.getDate();
                return (day > 9 ? day : "0" + day) + "-" + month + "-" + date.getFullYear();
            }
        }

