                    var month = parseInt($("#month_id").val());
                    var Amount = parseInt($("#Amount_id").val());
                    var installment = Amount / month;
                    $("#installment_amount").val(installment.toFixed(2));
                } else {
                    $("#installment_amount").val("");
                }
            });
