        function datatablebind() {
            var table = "";
            var loan_tbl = $('#loan_tbl').DataTable();
            loan_tbl.destroy();
            //Datatable call
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'Employee/GetAllemployeesalarycustomhead',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    $(".empcount_title").html("Non RecuringIncome : 0");
                    var emp_count = 0;
                    if (response.length > 0) {
                        for (var i = 0; i < response.length; i++) {
                            emp_count++;
                            var tbl = "<tr>";

                            tbl = tbl + "<td>" + response[i].Empcode + "<span class='custom_head_id' style='display:none'>" + response[i].custom_head_id + "</span><span class='is_earning' style='display:none'>" + response[i].is_earning + "</span> <span class='is_deduction' style='display:none'>" + response[i].is_deduction + "</span>";
                            tbl = tbl + "</td>";

                            if (response[i].EmpPhoto != null && response[i].EmpPhoto != "") {
                                tbl = tbl + "<td class='emp_box '>" + '<img src="/UploadEmpPhoto/' + response[i].EmpPhoto + '" alt="" class="user_img"><span><p class="emp_name tooltips " title="' + response[i].EmpName + '">' + response[i].EmpName + '</p><p class="tooltips" title="' + response[i].UserEmail + '">' + response[i].UserEmail + '</p></span>';
                            } else {
                                tbl = tbl + "<td class='emp_box'>" + '<img src="/assets/images/avtar.png" alt="" class="user_img"><span><p class="emp_name">' + response[i].EmpName + '</p><p>' + response[i].UserEmail + '</p></span>';
                            }
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td>" + response[i].head_name + "<span style='display:none' class='salary_head_id'>" + response[i].salary_head_id + "</span>";
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td class='amount'>" + response[i].amount;
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td class='Installment'>" + response[i].Installment;
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td class='no_Installment'>" + response[i].number_of_Installment;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td class='start_date'>" + response[i].start_date.split('T')[0];
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td class='end_date'>" + response[i].end_date.split('T')[0];
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td>" + response[i].status;
                            tbl = tbl + "</td>";
                            if (response[i].status == "Pending") {
                                if ('@obj.CanAdd' == 'True') {
                                    tbl = tbl + "<td>" + "<a class='btn btn-xs tooltips edit_clm_btn editloan ' title='Edit'><i class='fa fa-pencil'></i></a><span  class='emp_id' style='display:none'>" + response[i].emp_id + "</span></span> <span  class='description' style='display:none'>" + response[i].description + "</span>";
                                } else {
                                    tbl = tbl + "<td>";
                                }
                            } else {
                                tbl = tbl + "<td>";
                            }
                            tbl = tbl + "</td>";

                            tbl = tbl + "</tr>";
                            table += tbl;
                        }
                        $(".empcount_title").html("Non RecuringIncome : " + emp_count);
                        $("#loan_tbl tbody").empty();
                        $("#loan_tbl tbody").append(table);
                        $('#loan_tbl').destroy;
                        // Create search inputs in footer
                        $("#loan_tbl tfoot th").each(function () {
                            var title = $(this).text();
                            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
                        });

                        // DataTable initialisation
                        loan_tbl = $("#loan_tbl").DataTable({
                            dom: "<'row'<'col-lg-9 col-sm-7 col-xs-12 mb_margin_bottom_15'<'selected_emp_main'<'tbl_text'>>><'col-lg-3 col-sm-5 col-xs-12 recordbtn_end'<'record_btn_main'l,><'dt-buttons'Bf>>>" +
                                  "<'row'<'col-sm-12 margin-bottom-10'<'customforms_table'tr'>>>" +
                                  "<'row'<'col-md-5 col-sm-5'i><'col-md-7 col-sm-7'p>>",
                            paging: true,
                            autoWidth: true,
                            ordering: false,
                            buttons: [
                                "excelHtml5",
                                {
                                    "className": "buttons-columns btnColumnvisibility",
                                },
                            ],
                            initComplete: function (settings, json) {
                                var footer = $("#loan_tbl tfoot tr");
                                $("#loan_tbl thead").append(footer);
                            }
                        });

                        //$('div.tbl_text').html('<div class="dft_view">Default View</div>');
                        // Apply the Search
                        $("#loan_tbl thead").on("keyup", "input", function () {
                            loan_tbl.column($(this).parent().index())
                            .search(this.value)
                            .draw();
                        });
                    } else {
                        // Create search inputs in footer
                        $("#loan_tbl tfoot th").each(function () {
                            var title = $(this).text();
                            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
                        });
                        // DataTable initialisation
                        loan_tbl = $("#loan_tbl").DataTable({
                            dom: "<'row'<'col-lg-9 col-sm-7 col-xs-12 mb_margin_bottom_15'<'selected_emp_main'<'tbl_text'>>><'col-lg-3 col-sm-5 col-xs-12 recordbtn_end'<'record_btn_main'l,><'dt-buttons'Bf>>>" +
                                  "<'row'<'col-sm-12 margin-bottom-10'<'customforms_table'tr'>>>" +
                                  "<'row'<'col-md-5 col-sm-5'i><'col-md-7 col-sm-7'p>>",
                            paging: true,
                            autoWidth: true,
                            ordering: false,
                            buttons: [
                                "excelHtml5",
                                {
                                    "className": "buttons-columns btnColumnvisibility",
                                },
                            ],
                            initComplete: function (settings, json) {
                                var footer = $("#loan_tbl tfoot tr");
                                $("#loan_tbl thead").append(footer);
                            }
                        });
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }
        function modelclear() {
            $("#Amount_id").val("");
            $("#month_id").val("");
            $("#installment_amount").val("");
            $("#Commemt_id").val("");
            $("#employee").val(0);
            $('#employee').trigger('change.select2');
            $("#select_head").val(0);
            $('#select_head').trigger('change.select2');
            $("#start_date").val("");
            $("#end_date").val("");
            $("#_earningdeduct").val(1);
            $("#select_head").empty();
            $("#select_head").append("<option value='0'> None </option>");
        }
        function headdropdown(id, selectid) {
