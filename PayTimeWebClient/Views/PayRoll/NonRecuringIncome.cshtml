        function Gettrasactiondatabycustomheadid(custom_head_id, emp_name) {
            $(".tital_name").html(emp_name);
            var table = "";
            var loan_tbl_view = $('#loan_tbl_view').DataTable();
            loan_tbl_view.destroy();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'Employee/Gettrasactiondatabycustomheadid?custom_head_id=' + custom_head_id,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    debugger;
                    //loan_tbl_view
                    if (response.length > 0 && response != null) {
                        for (var i = 0; i < response.length; i++) {
                            var tbl = "<tr>";

                            tbl = tbl + "<td>" + response[i].transaction_effective_date.split('T')[0];
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td>" + response[i].transaction_emi_amount;
                            tbl = tbl + "</td>";

                            if (response[i].is_processed == true) {
                                tbl = tbl + "<td>" + "Paid UP";
                                tbl = tbl + "</td>";
                            } else if (response[i].is_processed == false) {
                                tbl = tbl + "<td>" + "Pending";
                                tbl = tbl + "</td>";
                            }

                            if (response[i].is_earning == true) {
                                tbl = tbl + "<td>" + "Addition";
                                tbl = tbl + "</td>";
                            } else if (response[i].is_deduction == true) {
                                tbl = tbl + "<td>" + "Deduction";
                                tbl = tbl + "</td>";
                            }

                            tbl = tbl + "</tr>";
                            table += tbl;
                        }
                        $("#loan_tbl_view tbody").empty();
                        $("#loan_tbl_view tbody").append(table);
                        $('#loan_tbl_view').destroy;
                        // Create search inputs in footer
                        $("#loan_tbl_view tfoot th").each(function () {
                            var title = $(this).text();
                            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
                        });

                        // DataTable initialisation
                        loan_tbl_view = $("#loan_tbl_view").DataTable({
                            dom: "<'row'<'col-lg-7 col-sm-6 col-xs-0 mb_margin_bottom_15'<'selected_emp_main'<'tbl_text'>>><'col-lg-5 col-sm-6 col-xs-12 '<'record_btn_main'l,><'dt-buttons'Bf>>>" +
                                  "<'row'<'col-sm-12 margin-bottom-10'<'customforms_table'tr'>>>" +
                                  "<'row'<'col-md-5 col-sm-5'i><'col-md-7 col-sm-7'p>>",
                            paging: true,
                            autoWidth: true,
                            ordering: false,
                            buttons: [
                                "excelHtml5",
                            ],
                            initComplete: function (settings, json) {
                                var footer = $("#loan_tbl_view tfoot tr");
                                $("#loan_tbl_view thead").append(footer);
                            }
                        });

                        //$('div.tbl_text').html('<div class="dft_view">Default View</div>');
                        // Apply the Search
                        $("#loan_tbl_view thead").on("keyup", "input", function () {
                            loan_tbl_view.column($(this).parent().index())
                            .search(this.value)
                            .draw();
                        });
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }
    </script>

