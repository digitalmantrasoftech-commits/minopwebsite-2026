        function GetPolicyDetailstable(obj) {
            checkSession();

            // Destroy existing DataTable before AJAX call
            if ($.fn.DataTable.isDataTable('#tblincrementapproval')) {
                $('#tblincrementapproval').DataTable().clear().destroy();
            }
            $("#tblincrementapproval tbody").empty();

            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'SalaryIncrementApproval/GetPolicyDataByYearAndStatus',
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(obj),
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    $("#tblincrementapproval tbody").empty();

                    // Destroy any existing DataTable (you do this outside success, but can repeat to be safe)
                    if ($.fn.DataTable.isDataTable('#tblincrementapproval')) {
                        $('#tblincrementapproval').DataTable().clear().destroy();
                    }
                    var tbl = "";

                    if (response && response.PolicyDetailsByYearAndStatustbl && response.PolicyDetailsByYearAndStatustbl.length > 0) {
                        var filteredRows = response.PolicyDetailsByYearAndStatustbl.filter(function (item) {
                            return item.No_of_employee !== 0 && item.policy_status == obj.Policy_status;
                        });

                        if (filteredRows.length === 0) {
                            // No matching data to show
                            $("#NotificationGrid-empty").show();
                            $("#tblempty").hide();
                            $(".filter_portlet_wrapper").removeClass("full-width");
                            return;
