                var _UpdateCTC = response.EncryptCTC;
                $.ajax({
                    type: "GET",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurlpayroll' + 'EmployeeCTC/GetEmployeePayrollCalculationByCTC?ctcamount=' + _UpdateCTC + '&empid=' + Empid,
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response) {
                        if (response.ResponseCode == 200 && response.Message == "Success") {
                            //$('.dayswise_box').html('<img src="/UploadEmpPhoto/' + "" + '" alt="" class="user_img"> <span> ' + response.employeeBankDetail[0].bank_holder_name + '</span>')
                            $(".emp_p_name").html(response.resultData.structure_name);
                            $(".emp_p_str").html(response.resultData.structure_type);
                            $(".salarayBasedOn").html(response.resultData.calculation_type);
                            $(".emp_Net_Salary").html(response.resultData.fixedPayMonthly);
                            $("#Take_home_salary_per_month").html(response.resultData.netMonthlySalary + " /-");
                            $("#Gross_monthly_salary").html(response.resultData.grossMonthlyEarning + " /-");

                            //$(".emp_Salary_Month").html(response.salary_month);
                            //$(".emp_Salary_Days").html(response.salary_days);
                            //$(".emp_Net_Salary").html(response.net_salary);
                            //$(".emp_total_payment").html("Total Payout (₹) : " + response.total_payout);
                            //$(".emp_total_payment").html("Total Payout (₹) : " + response.final_payout);

                            var E_table = ""
                            var D_table = ""
                            var R_table = ""
                            $("#Reimbursement_table tbody").empty();
                            $("#Earning_table tbody").empty();
                            $("#Deduction_table tbody").empty();

                            if (response.resultData.earnings.length > 0) {
                                for (var i = 0; i < response.resultData.earnings.length; i++) {
                                    E_table = E_table + '<tr><td><div class="d-flex justify-content-between"><div class="emp_pay_box"><div class="emp_pay_title">' + response.resultData.earnings[i].head_name + '</div><div class="emp_pay_subtitle">' + response.resultData.earnings[i].strcalcbasedOn + '</div></div><div class="emp_pay_total"><div class="emp_pay_title">' + response.resultData.earnings[i].Amount + '</div></div></div></td></tr>';
                                }
                                $("#Earning_table tbody").append(E_table);
                            }
                            if (response.resultData.deductions.length > 0) {
                                for (var i = 0; i < response.resultData.deductions.length; i++) {
                                    D_table = D_table + '<tr><td><div class="d-flex justify-content-between"><div class="emp_pay_box"><div class="emp_pay_title">' + response.resultData.deductions[i].head_name + '</div><div class="emp_pay_subtitle">' + response.resultData.deductions[i].strcalcbasedOn + '</div></div><div class="emp_pay_total"><div class="emp_pay_title">' + response.resultData.deductions[i].Amount + '</div></div></div></td></tr>';
                                }
                                $("#Deduction_table tbody").append(D_table);
                            }
                            if (response.resultData.reimbursements.length > 0) {
                                for (var i = 0; i < response.resultData.reimbursements.length; i++) {
                                    R_table = R_table + '<tr><td><div class="d-flex justify-content-between"><div class="emp_pay_box"><div class="emp_pay_title">' + response.resultData.reimbursements[i].head_name + '</div><div class="emp_pay_subtitle">' + response.resultData.reimbursements[i].strcalcbasedOn + '</div></div><div class="emp_pay_total"><div class="emp_pay_title">' + response.resultData.reimbursements[i].Amount + '</div></div></div></td></tr>';
                                }
                                $("#Reimbursement_table tbody").append(R_table);
                            }
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }

                });
            }
        });
        }

    function getPolicyStatusValue(status) {
        switch (status) {
            case "Created":
                return 0;
            case "Pending":
                return 0;
                break;
            case "Send For Approval":
                return 2;
                break;
            case "Revise":
                return 3;
                break;
            case "Approved":
                return 4;
                break;
            case "Rejected":
                return 5;
                break;
            case "Hold":
                return 6;
                break;
            case "Applied":
                return 7;
                break;
            default:
                return -1;
                break;
        }
    }

    function checkSession() {

        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
        }

        //$("#Filsearch_btn").click(function () {
        //    $("#filtercolumn_block").toggle();
        //});

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });


    });





</script>

