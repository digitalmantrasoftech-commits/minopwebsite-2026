        function GetBatchWiseTotalGrowth(batchIdValue, policyStatus) {

            checkSession();
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'SalaryIncrementApproval/GetTotalCTCGrowthByBatch?batchID=' + batchIdValue + '&approvalStatus=' + policyStatus,
                contentType: "application/json",
                //data: JSON.stringify(obj),
                dataType: "json",
                async: true,
                beforeSend: function () {
                    $('#ajax_loader').show();
                },
                complete: function () {
                    $('#ajax_loader').hide();
                },
                success: function (response) {

                    var proposedGrowthdisable = true;

                    if (response.success) {

                        PolicyGrowthCTC = response.totalNewCTC;
                        $("#totalcurrentCTC").val(response.totalPreviousCTC);
                        $("#newProposedCTC").val(PolicyGrowthCTC);
                        var growthValue = response.growthbyPercentage || "0";
                        var numericValue = parseFloat(growthValue.replace('%', '')) || 0;
                        $("#proposedGrowth").val(numericValue);

                        //hide show revise btn


                        var ishowapplybutton = response.objShowStatusButton.IsWorkflowApprovalNotRequired || false;

                        if (!ishowapplybutton) {
                            var isshowrevise = response.objShowStatusButton.isshowrevisionbutton || false;

                            if (isshowrevise) {
                                $("#Revise").show();
                                proposedGrowthdisable = false;
                            }
                            else {
                                $("#Revise").hide();
                            }

                        var isshowapprove = response.objShowStatusButton.isshowapprovebutton || false;
                        if (isshowapprove) {
                            var isapplast = response.objShowStatusButton.isapprovallaststep || false;
                            if (isapplast) {
                                $("#Approve").text("Approve");
                            }
                            else {
                                $("#Approve").text("Send for approve");
                            }

                            $("#Approve").show();
                            proposedGrowthdisable = false;
                        }
                        else {
                            $("#Approve").hide();
                        }

                        var isshowreject = response.objShowStatusButton.isshowrejectbutton || false;
                        if (isshowreject) {
                            proposedGrowthdisable = false;
                            $("#Reject").show();
                        }
                        else {
                            $("#Reject").hide();
                        }

                        var isshowhold = response.objShowStatusButton.isshowholdbutton || false;
                        if (isshowhold) {
                            proposedGrowthdisable = false;
                            $("#Hold").show();
                        }
                        else {
                            $("#Hold").hide();
                        }

                        var isshowApply = response.objShowStatusButton.isshowApplybutton || false;
                        if (isshowApply) {
                            $("#applypolicy").show();
                        }
                        else {
                            $("#applypolicy").hide();
                        }


                        if (proposedGrowthdisable) {
                            $("#proposedGrowth").prop("disabled", true); // Disable if policy applies
                            $("#ApplyGrowthtoPolicy").prop("disabled", true);
                            $("#Clear_Operation").prop("disabled", true);

                        } else {

                            $("#proposedGrowth").prop("disabled", false); // Enable otherwise
                            $("#ApplyGrowthtoPolicy").prop("disabled", false);
                            $("#Clear_Operation").prop("disabled", false);
                        }

                        }
                        else {
                            $("#Revise").hide();
                            $("#Approve").hide();
                            $("#Reject").hide();
                            $("#Hold").hide();
                            $("#applypolicy").show();
                        }
                    }
                    else {

                        if (proposedGrowthdisable) {
                            $("#proposedGrowth").prop("disabled", true); // Disable if policy applies
                            $("#ApplyGrowthtoPolicy").prop("disabled", true);
                            $("#Clear_Operation").prop("disabled", true);

                        } else {
                            $("#proposedGrowth").prop("disabled", false); // Enable otherwise
                            $("#ApplyGrowthtoPolicy").prop("disabled", false);
                            $("#Clear_Operation").prop("disabled", false);
                        }
                        $("#totalcurrentCTC").val(0);
                        $("#newProposedCTC").val(0);
                        $("#proposedGrowth").val(0);
                        $("#Revise").hide();
                        $("#Approve").hide();
                        $("#Hold").hide();
                        toastr.remove();
                        toastr.error(response.message);

                    }
                    $("#ajax_loader").hide();
                },
                error: function (xhr, status, error) {
                    toastr.error("Failed to fetch data: ", error);
                }
            });
        }

        function downloadFile(fileId, fileName) {
            // API endpoint
            var url = '@_webapiurlpayroll' + 'SalaryIncrementApproval/DownloadFile?id=' + fileId;

            // Fetch options
            var options = {
                method: 'GET',
                headers: {
                    'Authorization': '@_tokan'
                }
            };
            //Fetch request
            fetch(url, options)
                .then(function (response) {

                    if (!response.ok) {
                        toastr.remove();
                        toastr.error(response.statusText);
                        return { isError: true, errorMessage: response.statusText };
                    }
                    // Get content type and content disposition from headers
                    //var contentDisposition = response.headers.get('Content-Disposition');
                    //var contentType = response.headers.get('Content-Type');

                    // Return the response as a blob
                    return response.blob().then(function (blob) {
                        return { blob: blob, fileName: fileName, isError : false, errorMessage : "" };
                    });
                })
                .then(function (data) {
                    // Create a link element to download the file

                    if (!data.isError) {
                        var link = document.createElement('a');
                        link.href = window.URL.createObjectURL(data.blob);
                        link.download = data.fileName;

                        // Trigger the download
                        link.click();

                        // Clean up the object URL
                        setTimeout(function () {
                            window.URL.revokeObjectURL(link.href);
                        }, 1000);
                    }
                    else {
                        toastr.remove();
                        toastr.error("File " + data.errorMessage.toLowerCase());
                        return false;
                    }
                })
                .catch(function (error) {
                    toastr.remove();
                    toastr.error('An error occurred while downloading the file: ' + error.message);
                });
        }


        function Status_Update_ForBatch(policyId, status, Remarks) {
            checkSession();
            $("#ajax_loader").show();
            var URL = "";
            switch (parseInt(status)) {
                case 3:
                    URL = 'SalaryIncrementApproval/ReviseBatch';
                    break;
                case 4:
                    URL = 'SalaryIncrementApproval/ApproveBatch';
                    break;
                case 5:
                    URL = 'SalaryIncrementApproval/RejectBatch';
                    break;
                case 6:
                    URL = 'SalaryIncrementApproval/HoldBatch';
                    break;
                case 7:
                    URL = 'SalaryIncrementApproval/ApplyBatch';
                    break;
                default:
                    // Handle unknown status or provide default URL, if necessary
                    toastr.error("Invalid status value");
                    break;
            }

            var obj = {
                policyID: policyId,
                remarks: Remarks
            };

            if (URL !== "") {
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurlpayroll' + URL,
                    contentType: "application/json",
                    data: JSON.stringify(obj),
                    dataType: "json",
                    beforeSend: function () {
                        $('#ajax_loader').show();
                    },
                    complete: function () {
                        $('#ajax_loader').hide();
                    },
                    success: function (response) {
                        if (response.Success) {
                            toastr.remove();
                            toastr.success(response.Message);
                        }
                        else {
                            toastr.remove();
                            toastr.error(response.Message);
                        }
                        $("#ajax_loader").hide();
                        setTimeout(function () {
                            window.location.reload();
                        }, 2500);

                    },
                    error: function (xhr, status, error) {
                        toastr.error("Failed to fetch data: ", error);
                    }
                })
            }

            else {
                $("#ajax_loader").hide();
                toastr.remove();
                toastr.error("Invalid status passed for process.");
            }
        }

