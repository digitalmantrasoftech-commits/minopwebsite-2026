        //on edit GrowthInput validation
        $("#Employee_dataTable").on('input', '.newgrowth', function () {

            var value = $(this).val();
            if (IsIncrementmodepercentage == 1) {
                //valid decimal and does not exceed 100.00
                if (/^\d+(\.\d{0,2})?$/.test(value) && parseFloat(value) <= 100) {
                    // If valid, update the value in the input field
                    if (value == "100.00") {
                        value = "100.00";
                    }
                    $(this).val(value);
                } else {
                    // If invalid, revert the value to the previous valid value
                    $(this).val(value.substring(0, value.length - 1));
                }
            }
            else {
                // Flat amount validation
                const numberRegex = /^\d+(\.\d{0,2})?$/; // Allow decimals up to 2 places
                if (value.length > 9) {
                    value = value.slice(0, 9);
                    $(this).val(value);
                }
                if (!numberRegex.test(value)) {
                    // Clear invalid input
                    $(this).val("");
                    toastr.error("Please enter a valid flat amount (positive number).");
                }
            }

        });


        $("#Employee_dataTable").on('click', '.Activeclass', function () {
            let clickedRow = $(this).closest("tr");
            handleActiveClassClick(clickedRow);
        });

        function handleActiveClassClick(clickedRow) {
            return new Promise(function (resolve, reject) {
                checkSession();

                let id = clickedRow.find(".incrementid").text();
                let newgrowth = clickedRow.find(".newgrowth").val();

                if (newgrowth == '') {
                    toastr.remove();
                    toastr.error("please enter growth");
                    reject("Missing growth");
                } else {
                    $.ajax({
                        type: "POST",
                        headers: { 'Authorization': '@_tokan' },
                        url: '@_webapiurlpayroll' + 'SalaryIncrementPlanning/UpdateGrowthamount?Growth=' + newgrowth + "&incrementid=" + id,
                        contentType: "application/json",
                        dataType: "json",
                        beforeSend: function () {
                            $('#ajax_loader').show();
                        },
                        complete: function () {
                            $('#ajax_loader').hide();
                        },
                        success: function (response) {
                            if (response != null) {
                                if (response.success == true) {
                                    toastr.remove();
                                    toastr.success(response.message);
                                    Employeetablebind(currentPolicyIdViewID, 1, isFromProposedView = 0);
                                    GetBatchWiseTotalGrowth(currentPolicyIdViewID, currentPolicyViewStatus);
                                    resolve(response);
                                } else {
                                    toastr.remove();
                                    toastr.error(response.message);
                                    reject(response.error)
                                }
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Failed to fetch data: ", error);
                            reject(error);
                        }
                    });
                }
            })
        }

        function reviseSalary(increamentid) {
            var obj = {
