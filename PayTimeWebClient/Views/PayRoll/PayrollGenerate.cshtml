@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "hrpayrollgenerateedit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurlpayroll = ConfigurationManager.AppSettings["webapipaytimePayroll"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<script src="~/Newlayout/js/sweet_alert_payroll.js"></script>
<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">
<style type="text/css">
    .dataTables_wrapper .dataTables_filter {
        display: none !important;
    }

    .dataTables_wrapper {
        padding: 0px 0 0px 0;
    }

    .fixed-column {
        width: 100px !important;
        min-width: 85px !important;
        right: 0px;
        position: sticky !important;
        background-color: #fff !important;
    }

    .fixed-column-1 {
        width: 80px !important;
        min-width: 85px !important;
        right: 97px;
        position: sticky !important;
        background-color: #fff !important;
    }

    .fixed-column-2 {
        width: 80px !important;
        min-width: 85px !important;
        right: 195px;
        position: sticky !important;
        background-color: #fff !important;
        box-shadow: -2px 2px 4px 0px rgba(0, 0, 0, 0.20);
    }

        .fixed-column-2 input.search_input,
        .fixed-column-2 i.clm-search {
            display: none;
        }

    #PayrollGeneratetable thead tr th:first-child {
        min-width: 70px;
    }

    #emp_close:hover {
        cursor: pointer;
    }
</style>
@if (obj.CanView)
{
    <script>
        var Total_Employee_Attendance = 0;
        var table = "";
        var Pay_days = "";
        $(document).ready(function () {
            tableget();
            $("#share_acteam_btn").on('click', function () {
                Swal.fire({
                    html: '<div class="swal_title"> Payroll Generate to be finalized for Payroll TDS </div><div class="swal_subtitle">Would you like to share your final payroll TDS?</div><div class="swal_thirdtitle">You cannot edit the shared file again after sharing.</br> Please verify all info once more before sharing.</br> Go for Next Step ( Payroll TDS Section)</div>',
                    closeOnConfirm: true,
                    showCloseButton: false,
                    showCancelButton: true,
                    focusConfirm: false,
                    confirmButtonText: 'Yes',
                    confirmButtonColor: '#093150',
                    cancelButtonColor: '#d33',
                    cancelButtonText: 'No',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                }).then(function (isConfirm) {
                    if (isConfirm.isConfirmed == true) {
                        var currentDate = new Date();
                        var currentMonth = currentDate.getMonth();
                        var currentYear = currentDate.getFullYear();
                        var obj = {
                            "month": currentMonth,
                            "year": currentYear
                        }
                        $.ajax({
                            type: "POST",
                            headers: { 'Authorization': '@_tokan' },
                            url: '@_webapiurlpayroll' + 'HrPayrollFinalize/ApprovalPayrollFinalizedForPayrollTDS',
                            data: JSON.stringify(obj),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            beforeSend: function () {
                                $("#ajax_loader").show();
                            },
                            success: function (response) {
                                if (response.success == true && response.responseCode == 206) {
                                    toastr.remove();
                                    toastr.success(response.message);
                                    setTimeout(function () {
                                        window.location.href = '/PayRoll/AccountPayroll';
                                    }, 1500);
                                }
                            },
                            complete: function () {
                                $("#ajax_loader").hide();
                            }
                        });
                    }
                });

            });

            $("body").on('click', '#emp_close', function () {
                tableget();
            })
            //Edit - ROW wise
            $('#PayrollGeneratetable').on('click', '.edit_btn', function () {
                $('.edit_btn').not(this).prop('disabled', true);
                var currentRow = $(this).closest('tr');
                currentRow.find('.edit_btn').hide(); // hide edit btn
                currentRow.find('.Activeclass').show(); // show update btn
                Pay_days = currentRow.find('td:eq(2)').text();
                //currentRow.find('td:eq(2)').html('<div class="d-flex align-items-center" style="justify-content:space-around;"> <input type="text" style="text-align:center;width: 80px; " class="form-control input-sm " value="' + Pay_days.split('/')[0] + '">' + '<span> /' + Pay_days.split('/')[1] + '</span></div>');
                currentRow.find('td:eq(2)').html('<div style="display:flex;justify-content: center;"> <input type="text" style="text-align:center;width: 80px; " maxlength="5" class="form-control input-sm Pay_days" value="' + Pay_days.split('/')[0].trim() + '"></div>');
                
                var columns = currentRow.find('td');
                var totalColumns = columns.length;
                var startIndex = 4; // Index of the 5th column
                var endIndex = totalColumns - 4; // Index of the column before the length-6 column

                for (var i = startIndex; i <= endIndex; i++) {
                    var column = columns.eq(i);
                    column.html('<div style="display:flex;justify-content: center;"> <input type="text" style="text-align:center;width: 80px; " maxlength="5" class="form-control input-sm Pay_days" value="' + column.text() + '"></div>');
                }
                $("#emp_close").show();
            });
            $('body').on('keydown', '.Pay_days', function (event) {
                var keyPressed = event.which;
                if ((keyPressed >= 65 && keyPressed <= 90) || (keyPressed >= 97 && keyPressed <= 122)) {
                    event.preventDefault();
                }
            });

            //Update - ROW wise
            $('#PayrollGeneratetable tbody').on('click', '._update', function () {
                var currentRow = $(this).closest('tr');
                var Paydays = currentRow.find('.Pay_days').val();
                var payroll_finalize_id = dataTableInstance.row($(this).parent('td').parent('tr')).data()["payroll_finalize_id"];
                var pattern = /^\d+(\.\d+)?$/;
                var value = currentRow.find(".Pay_days").val();
                var _Absent_day = currentRow.find(".Absent_day").val();
                var _Taken_Leave = currentRow.find(".Taken_Leave").val();
                
                if (!pattern.test(value)) {
                    currentRow.find(".Pay_days").val('');
                    currentRow.find(".Pay_days").addClass('field_error');
                } else {
                    currentRow.find(".Pay_days").removeClass('field_error');
                    if (parseFloat(Paydays) > parseFloat(Pay_days.split('/')[1])) {
                        toastr.remove();
                        toastr.error("Pay days must be less then or equal to total days . ");
                        currentRow.find(".Pay_days").addClass('field_error');
                    } else if (parseFloat(_Absent_day) > parseFloat(Pay_days.split('/')[1])) {
                        toastr.remove();
                        toastr.error("Absent days must be less then or equal to total days . ");
                        currentRow.find(".Absent_day").addClass('field_error');
                    } else if (parseFloat(_Taken_Leave) > parseFloat(Pay_days.split('/')[1])) {
                        toastr.remove();
                        toastr.error("Taken leave days must be less then or equal to total days . ");
                        currentRow.find(".Taken_Leave").addClass('field_error');
                    }
                    else if (Paydays != Pay_days.split('/')[0]) {
                        currentRow.find(".Pay_days").removeClass('field_error');
                        var obj = {
                            "payroll_finalize_id": payroll_finalize_id,
                            "pay_days": Paydays
                        }
                        $.ajax({
                            type: "POST",
                            headers: { 'Authorization': '@_tokan' },
                            url: '@_webapiurlpayroll' + 'HrPayrollFinalize/UpdatePayrollAttendaceAfterPayrollFinalize',
                            contentType: "application/json; charset=utf-8",
                            data: JSON.stringify(obj),
                            dataType: "json",
                            beforeSend: function () {
                                $("#ajax_loader").show();
                            },
                            success: function (response) {
                                if (response.success == true && response.responseCode == 206) {
                                    toastr.remove();
                                    toastr.success(response.message);
                                    currentRow.find('.edit_btn').show(); // hide edit btn
                                    currentRow.find('.Activeclass').hide(); // show update btn
                                    currentRow.find('td:eq(2)').html(Paydays + '/' + Pay_days.split('/')[1]);
                                    $('.edit_btn').not(this).prop('disabled', false);
                                    tableget();
                                    $("#emp_close").hide();
                                } else {
                                    toastr.remove();
                                    if (response.message != '') {
                                        toastr.error(response.message);
                                    } else {
                                        var str = "";
                                        str = response.validationErrors.join(', ')
                                        toastr.error(str);
                                    }
                                }
                            },
                            complete: function () {
                                $("#ajax_loader").hide();
                            }

                        });
                    } else {
                        currentRow.find('.edit_btn').show(); // hide edit btn
                        currentRow.find('.Activeclass').hide(); // show update btn
                        currentRow.find('td:eq(2)').html(Paydays + '/' + Pay_days.split('/')[1]);
                        $('.edit_btn').not(this).prop('disabled', false);
                        currentRow.find(".Pay_days").removeClass('field_error');
                    }
                }

            });
            //Close - ROW wise
            $('#PayrollGeneratetable tbody').on('click', '._close', function () {
                var currentRow = $(this).closest('tr');
                var Paydays = currentRow.find('.Pay_days').val();
                currentRow.find('td:eq(2)').html(Pay_days);
                $("#emp_close").hide();
                //ajax

                $('.edit_btn').not(this).prop('disabled', false);
                currentRow.find('.edit_btn').show(); // hide edit btn
                currentRow.find('.Activeclass').hide(); // show update btn
            });
            $("body").on('click', '.emp_box', function () {
                $(".emp_box").attr("data-toggle", "modal");
                $(".emp_box").attr("data-target", "#emp_totalpayout_modal");
                
                var _payrollid = dataTableInstance.row($(this).parent('td').parent('tr')).data()["payroll_id"];
                $.ajax({
                    type: "GET",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurlpayroll' + 'HrPayrollFinalize/GetEmployeePayrollDetailsByPayrollId?payrollid=' + _payrollid,
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response) {
                        if (response.ResponseCode == 200 && response.Message == "Success") {
                            $('.dayswise_box').html('<img src="/UploadEmpPhoto/' + response.emp_detail.split('|')[2].trim() + '" alt="" class="user_img"> <span> ' + response.emp_detail.split('|')[0] + '</span>')
                            $(".emp_p_str").html(response.structure_name);
                            $(".emp_Salary_Month").html(response.salary_month);
                            $(".emp_Salary_Days").html(response.salary_days);
                            $(".emp_Net_Salary").html(response.net_salary);
                            $(".emp_total_payment").html("Total Payout (₹) : " + response.total_payout);
                            var E_table = ""
                            var D_table = ""
                            var R_table = ""
                            $("#Reimbursement_table tbody").empty();
                            $("#Earning_table tbody").empty();
                            $("#Deduction_table tbody").empty();

                            if (response.earning.length > 0) {
                                for (var i = 0; i < response.earning.length; i++) {
                                    E_table = E_table + '<tr><td><div class="d-flex justify-content-between"><div class="emp_pay_box"><div class="emp_pay_title">' + response.earning[i].head_name_in_salary_slip + '</div><div class="emp_pay_subtitle">' + response.earning[i].description + '</div></div><div class="emp_pay_total"><div class="emp_pay_title">' + response.earning[i].head_amount + '</div></div></div></td></tr>';
                                }
                                $("#Earning_table tbody").append(E_table);
                            }
                            if (response.deduction.length > 0) {
                                for (var i = 0; i < response.deduction.length; i++) {
                                    D_table = D_table + '<tr><td><div class="d-flex justify-content-between"><div class="emp_pay_box"><div class="emp_pay_title">' + response.deduction[i].head_name_in_salary_slip + '</div><div class="emp_pay_subtitle">' + response.deduction[i].description + '</div></div><div class="emp_pay_total"><div class="emp_pay_title">' + response.deduction[i].head_amount + '</div></div></div></td></tr>';
                                }
                                $("#Deduction_table tbody").append(D_table);
                            }
                            if (response.reimbursment.length > 0) {
                                for (var i = 0; i < response.reimbursment.length; i++) {
                                    R_table = R_table + '<tr><td><div class="d-flex justify-content-between"><div class="emp_pay_box"><div class="emp_pay_title">' + response.reimbursment[i].head_name_in_salary_slip + '</div><div class="emp_pay_subtitle">' + response.reimbursment[i].description + '</div></div><div class="emp_pay_total"><div class="emp_pay_title">' + response.reimbursment[i].head_amount + '</div></div></div></td></tr>';
                                }
                                $("#Reimbursement_table tbody").append(R_table);
                            }
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });


            });
        });
        var dataTableInstance;
        // DataTable initialisation
        function tableget() {
            //var table = $('#PayrollGeneratetable').DataTable();
            //table.destroy();
            var currentDate = new Date();
            var currentMonth = currentDate.getMonth();
            var currentYear = currentDate.getFullYear();
            var columns = [];
            var t = "";
            var _columnsname = "";
            var _num = "";
            var _hdrcnt = 0;
            var P = 4;
            var _Cnttd = 0;
            var _chkarrylst = [];
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'HrPayrollFinalize/GetAllEmpPayrollGenerateList?month=' + currentMonth + '&year=' + currentYear,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    Total_Employee_Attendance = 0;
                    if (response != null && response.length > 0) {
                        // Destroy the previous DataTable instance
                        if (dataTableInstance) {
                            dataTableInstance.destroy();
                        }
                        _chkarrylst = 0;
                        columnNames = Object.keys(response[0]);
                        var _CheckcolumnNames = Object.keys(response[0]);

                        for (var i in columnNames) {
                            columns.push({
                                data: columnNames[i],
                                title: columnNames[i]
                            });
                        }

                        $("#PayrollGeneratetable tbody").empty();

                        // Add dynamic columns to the table header
                        var tfoot = $('#PayrollGeneratetable tfoot tr');
                        var columnNames = Object.keys(response[0]); // Assume all objects have the same keys
                        columnNames.forEach(function (key) {
                            tfoot.append('<th>' + key + '</th>');

                        });

                        // Create search inputs in footer
                        $("#PayrollGeneratetable tfoot tr th").each(function () {
                            var title = $(this).text();
                            $(this).html('<input type="text" class="search_input"  placeholder="Search" /><i class="clm-search" id=""></i>');
                        });

                        // Add dynamic data rows to the table body
                        var tbody = $('#PayrollGeneratetable tbody');
                        response.forEach(function (rowData, key) {
                            var tr = $('<tr></tr>');
                            columnNames.forEach(function (key) {
                                tr.append('<td>' + rowData[key] + '</td>');
                            });
                            tbody.append(tr);
                            Total_Employee_Attendance++;
                        });

                        // DataTable initialisation
                        dataTableInstance = $("#PayrollGeneratetable").DataTable({
                            dom: "<'row'<'col-lg-3 col-sm-5 col-xs-12'<'record_btn_main'l,><'dt-buttons'Bf>><'col-lg-9 col-sm-7 col-xs-12 mb_margin_bottom_15'<'selected_emp_main'<'tbl_text'><'tbl_text_close'>>>>" +
                                  "<'row'<'col-sm-12 margin-bottom-10'<'customforms_table'tr'>>>" +
                                  "<'row'<'col-md-5 col-sm-5'i><'col-md-7 col-sm-7'p>>",
                            paging: true,
                            autoWidth: true,
                            ordering: false,
                            "columns": columns,
                            "bdestroy": true,
                            buttons: [
                                "excelHtml5",
                                //{
                                //    "className": "buttons-columns btnColumnvisibility",
                                //},
                            ],
                            initComplete: function (settings, json) {
                                var footer = $("#PayrollGeneratetable tfoot tr");
                                $("#PayrollGeneratetable thead").append(footer);
                            },
                            "columnDefs": [
                               {
                                   "targets": [columnNames.length - 1, columnNames.length - 2, columnNames.length - 3],
                                   "visible": false
                               },
                                {
                                    "targets": [1],
                                    "render": function (data, type, row) {
                                        if (row["Employee Details"] == null) {
                                            return '';
                                        } else {
                                            return '<div class="emp_box" id="emp_totalpayout" ><img src="/UploadEmpPhoto/' + row["Employee Details"].split('|')[2].trim() + '"  class="user_img"><span><p class="e_details">' + row["Employee Details"].split('|')[1] + '</p></span></div>'
                                        }
                                    }
                                },
                                {
                                    targets: [3],
                                    "render": function (data, type, row) {
                                        return '<div class="net_sala0ry purple_font" >' + row["Net Salary"] + '</div>'
                                    }
                                },
                                {
                                    "targets": [columnNames.length - 5],
                                    "render": function (data, type, row) {
                                        return '<div class="total_payment green_font " > ₹ ' + row["Total Payout"] + '</div>'
                                    }
                                },
                                {
                                    "targets": [columnNames.length - 6],
                                    "render": function (data, type, row) {
                                        var str = "";
                                        if (row["Payroll"] == '2') {
                                            str = '<select class="form-control input-sm" id="" disabled><option value="1" selected>Freezed</option><option value="2" class="red_font">On Hold</option><option value="3" class="blue_font">FNF</option></select>'
                                        } else {
                                            str = '<select class="form-control input-sm" id=""><option value="1">Freezed</option><option value="2" class="red_font">On Hold</option><option value="3" class="blue_font">FNF</option></select>'
                                        }
                                        return str;

                                    }
                                }, {
                                    "targets": [columnNames.length - 4],
                                    "render": function (data, type, row) {
                                        return '<a class="editclass btn seagreen_btnnew tooltips edit_btn" data-placement="top" title="Edit" > <span id="sp3" hidden="">1002</span> <i class="fa-regular fa-pen-to-square"> </i> </a> <a style="display:none" class="Activeclass btn blue_btnnew tooltips _update" data-placement="top" title="Update"><i class="fa-solid fa-check"></i></a> <a style="display:none" class="Activeclass btn blue_btnnew tooltips _close" data-placement="top" title="Close"><i class="fa-solid fa-xmark"></i></a>';

                                    }
                                }

                            ]
                        })
                        //} else {
                        //    
                        //    $("#PayrollGeneratetable").destory;
                        //    table = $("#PayrollGeneratetable").DataTable();
                        //}
                        //$('div.tbl_text').html('<div class="dft_view">Default View</div><span class="attendance_freeze_msg">: You cannot update the shared finalized Payroll Generate.</span>');
                        $('div.tbl_text_close').html('<div class="reset_filter_btn" id="emp_close" style="display:none">Reset</div>');
                        // Apply the Search
                        $("#PayrollGeneratetable thead").on("keyup", "input", function () {
                            
                            dataTableInstance.column($(this).parent().index())
                            .search(this.value)
                            .draw();
                        });
                        $('.empcount_title').html("");
                        $('.empcount_title').html(" Hr-Payroll Generate, Edit : " + Total_Employee_Attendance);
                        $('#PayrollGeneratetable th').each(function () {
                            var columnName = $(this).text();
                            if (columnName.startsWith('Col_')) {
                                var newColumnName = columnName.replace('Col_', '');
                                $(this).text(newColumnName);
                            }
                        });
                        var lastColumnIndex = dataTableInstance.columns().count() - 4;
                        // Get the reference to the column's cells
                        var columnCells = dataTableInstance.column(lastColumnIndex).header();
                        var _columnCells = dataTableInstance.column(lastColumnIndex).nodes();
                        // Add a class to each cell in the column
                        $(columnCells).addClass('fixed-column');
                        $(_columnCells).addClass('fixed-column');

                        var lastColumnIndex1 = dataTableInstance.columns().count() - 5;
                        // Get the reference to the column's cells
                        var columnCells1 = dataTableInstance.column(lastColumnIndex1).header();
                        var _columnCells1 = dataTableInstance.column(lastColumnIndex1).nodes();
                        // Add a class to each cell in the column
                        $(columnCells1).addClass('fixed-column-1');
                        $(_columnCells1).addClass('fixed-column-1');

                        var lastColumnIndex2 = dataTableInstance.columns().count() - 6;
                        // Get the reference to the column's cells
                        var columnCells2 = dataTableInstance.column(lastColumnIndex2).header();
                        var _columnCells2 = dataTableInstance.column(lastColumnIndex2).nodes();
                        // Add a class to each cell in the column
                        $(columnCells2).addClass('fixed-column-2');
                        $(_columnCells2).addClass('fixed-column-2');

                        var headerCell = $('table.dataTable thead tr:eq(1) th:eq(-2)');
                        $(headerCell).addClass('fixed-column-1');
                        var _headerCell = $('table.dataTable thead tr:eq(1) th:eq(-1)');
                        $(_headerCell).addClass('fixed-column');
                        var headerCell2 = $('table.dataTable thead tr:eq(1) th:eq(-3)');
                        $(headerCell2).addClass('fixed-column-2');

                        var secondHeaderRow = $("#PayrollGeneratetable").find("thead tr:eq(1)");
                        if (secondHeaderRow.length) {
                            $("#PayrollGeneratetable thead tr:eq(1) th").each(function () {
                                var title = $(this).text();
                                $(this).html('<input type="text" class="search_input"  placeholder="Search" /><i class="clm-search" id=""></i>');
                            });
                        }
                    } else {
                        
                        $(".no_recoed").show();
                        $("#share_acteam_btn").attr("disabled", "disabled");
                    }

                    // Modal Open Close Code ================
                    $(".btnColumnvisibility").on('click', function () {
                        $(".btnColumnvisibility").attr("data-toggle", "modal");
                        $(".btnColumnvisibility").attr("data-target", "#frmpopupCustomfld");
                    });


                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });

        }

    </script>

    <div class="page-bar">
        <ul class="page-breadcrumb" style="float: none">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Hr-Payroll Generate, Edit</span>
            </li>
        </ul>

        <div class="emptotalcount">
            <div class="empcount_title"></div>
            <div class="page-toolbar">
                <div class="emp_btn_block">
                    <div class="text-right">
                        <a href="#" class="btn ftrsearch_btn btn-effect" id="importexcel_btn"><i class="fa-solid fa-plus"></i> Import Excel</a>
                        <a href="#" class="btn add_btn margin-left-10" id="share_acteam_btn">Share With Account Team</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="portlet">
        <div class="portlet-body">
            <div id="ajax_loader" class="modal_bg loading" aria-hidden="true" style="display:none">
                <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
            </div>
            <div class="row">
                <div class="payroll_details_table">
                    <!-- Datatable : Begin -->
                    <table id="PayrollGeneratetable" class="table table-striped table-bordered tbl_middle table-hover tbl_newdatatbl serch_datatable table-checkable order-column">
                        <thead></thead>
                        <tbody></tbody>
                        <tfoot><tr></tr></tfoot>
                    </table>
                    <!-- Datatable : End -->
                    <div style="display:none" class="no_recoed"><h3>No record found .</h3></div>
