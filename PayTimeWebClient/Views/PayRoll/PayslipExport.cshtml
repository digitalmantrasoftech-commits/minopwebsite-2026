        $("body").on('click', '.download_bulk', function () {

            var row = $(this).closest('tr');
            var download_id = row.find('.download_id').text();

            var downloadUrl = "@_webapiurlpayroll" + "SalaryslipExport/bulkpayslipdownload?Payslip_path=" + download_id,

            xhr = new XMLHttpRequest();
            xhr.open('GET', downloadUrl);
            xhr.setRequestHeader('Authorization', '@_tokan');
            xhr.responseType = 'blob';
            xhr.onload = function () {
                if (xhr.status === 200) {

                    var url = URL.createObjectURL(xhr.response);
                    var link = document.createElement('a');
                    link.href = url;
                    link.target = '_blank';
                    link.download = "payslip" + download_id.split('_')[0];
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                } else {
                    console.error('Error:', xhr.status);
                    toastr.remove();
                    toastr.error('Error occurred while downloading the file.');
                }
            };
            xhr.send();
        });

