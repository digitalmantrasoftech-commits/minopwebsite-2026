    function downloadPDF(base64DataArray) {
        const pdfBlobs = [];

        // Check if base64DataArray is an array and not empty
        if (!Array.isArray(base64DataArray) || base64DataArray.length === 0) {
            console.error('Invalid or empty base64DataArray');
            return;
        }

        $.each(base64DataArray, function (index, base64Data) {
            const byteCharacters = atob(base64Data);
            const byteNumbers = new Array(byteCharacters.length);

            for (let i = 0; i < byteCharacters.length; i++) {
                byteNumbers[i] = byteCharacters.charCodeAt(i);
            }

            const byteArray = new Uint8Array(byteNumbers);
            const pdfBlob = new Blob([byteArray], { type: 'application/pdf' });
            pdfBlobs.push(pdfBlob);
        });

        if (pdfBlobs.length === 0) {
            console.error('No valid PDF blobs to merge');
            return;
        }

        const mergedPdfBlob = new Blob(pdfBlobs, { type: 'application/pdf' });
        const pdfDataUrl = URL.createObjectURL(mergedPdfBlob);

        const iframe = $('<iframe>').attr({
            src: pdfDataUrl,
            width: '100%',
            height: '500px'
        });

        // Assuming you have a div with id 'pdfContainer' in your HTML
        $('#pdfContainer').empty().append(iframe);
        $('#pdfContainer').show();
    }


