            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (data) {
                var markup = '';
                if (data.length > 0 && data != null) {
                    markup = "<option value='0'> Select Employee </option>"
                    for (var x = 0; x < data.length; x++) {
                        data.sort(function (a, b) {
                            return a.employeeList.localeCompare(b.employeeList);
                        });
                        if ('@_RoleId' == 1) {
                            markup += "<option value=" + data[x].employeeId + ">" + data[x].employeeList + " (" + data[x].empCode + ")" + "</option>";
                        } else {
                            markup += "<option selected value=" + data[x].employeeId + ">" + data[x].employeeList + " (" + data[x].empCode + ")" + "</option>";
                        }
                        keyEmailId[data[x].employeeId] = data[x].employeeEmail;

                    }

                    $('#EmployeeList').append(markup);
                    //$EmployeeList.multiselect('rebuild');
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                if (xhr.status == 404) { //NotFound = 404
                    toastr.error(thrownError);
                } else if (xhr.status == 500) { //InternalServerError = 500,
                    toastr.error("InternalServerError");
                } else if (xhr.status == 400) { //BadRequest = 400,
                    toastr.error("BadRequest");
                } else if (xhr.status == 419) {
                    window.location.href = "/PayTime/LoginPage";
                } else {
                    toastr.error(thrownError);
                }
            },
            complete: function () {
                $("#ajax_loader").hide();
            },
        });

