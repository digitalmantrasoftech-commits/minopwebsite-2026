    function PayrollBulkList(month, year) {
        $(".payroll_payslip_bulk").show();
        $('#pdfContainer').hide();
        var tbl_payroll_bulk = $('#tbl_payroll_bulk').DataTable();
        tbl_payroll_bulk.destroy();
        var tbl_payroll_bulk_fail = $('#tbl_payroll_bulk_fail').DataTable();
        tbl_payroll_bulk_fail.destroy();

        $.ajax({
            type: "Get",
            headers: { 'Authorization': '@_tokan' },
            url: "@_webapiurlpayroll" + "SalaryslipExport/PayrollBulkList?month=" + month + "&year=" + year,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                $("#tbl_payroll_bulk tbody").empty();
                //$("#tbl_payroll_bulk thead tr:eq(1)").remove();
                var table = "";
                if (response != null) {
                    if (response.length > 0) {
                        for (var i = 0; i < response.length; i++) {
                            var tbl = "<tr>";

                            tbl = tbl + "<td>" + response[i].Task_id
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td>" + $("#Monthforfinalizedata").val()
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td>" + $("#Yearforfinalizedata").val()
                            tbl = tbl + "</td>";

                            if (response[i].Is_read == 0) {
                                tbl = tbl + "<td class='red_font'>" + "pending"
                                tbl = tbl + "</td>";
                            } else {
                                tbl = tbl + "<td class='green_font'>" + "success"
                                tbl = tbl + "</td>";
                            }

                            if (response[i].Is_read == 0) {
                                tbl = tbl + "<td>" + "-";
                                tbl = tbl + "</td>";
                            } else {

                                tbl = tbl + "<td>" + '<a class="download_bulk editclass btn btn-xs blue tooltips" title="Download"><i class="fa-regular fa-download"></i></a>'
                                tbl = tbl + "</td>";
                            }


                            tbl = tbl + "<td class='download_id' hidden>" + response[i].Task_id + "_" + response[i].db_name
                            tbl = tbl + "</td>";


                            tbl = tbl + "</tr>";
                            table += tbl;

                        }
                    }
                }

                $("#tbl_payroll_bulk tbody").append(table);
                $('#tbl_payroll_bulk').destroy;

                // Create search inputs in footer
                $("#tbl_payroll_bulk tfoot th").each(function () {
                    var title = $(this).text();
                    $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
                });

                // DataTable initialisation
                var table = $("#tbl_payroll_bulk").DataTable({
