        //repayroll
        $('#approvaltable').on('click', '.repayroll', function () {

            var row = $(this).closest('tr');
            company_id = row.find('.clscompanyid').text();
            branch_id = row.find('.clsbranchid').text();
            department_id = row.find('.clsdepartmentid').text();
