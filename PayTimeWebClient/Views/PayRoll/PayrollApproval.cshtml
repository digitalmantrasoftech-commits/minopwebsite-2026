            // Split the monthYear string into month and year
            let [monthName, yearName] = monthYear.split('-');
            month = new Date(`${monthName} 1, 2020`).getMonth() + 1;
            year = parseInt(yearName, 10);
            var status = 3;


            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'Approval/Rollbackpayrollfromapprovaltosalaryprocess?month=' + month + "&year=" + year + "&status=" + status + "&Dpartmentid=" + department_id + "&CompanyID=" + company_id + "&BranchID=" + branch_id + "&Attendancetype=" + Attendancetype + "&ShiftID=" + Shiftlst,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {

                    if (response.success == true && response.responseCode == 200) {
                        toastr.remove();
                        toastr.success(response.message);
                        GetApprovalDashBoardDetailsSummary(company_id, branch_id, department_id, Attendancetype, '0', Shiftlst);
                        GetAllApproval('0');
                    } else {
                        toastr.remove();
                        toastr.error(response.message);
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });


