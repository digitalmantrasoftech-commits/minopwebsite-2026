        function fillDeptTable(BranchId, selectedDept) {
            $("#DeptIds").empty();
            checkSession();
            $.ajax({
                type: "POST",
                //url: "/MasterData/GetDeptbyBranchstr?BranchId=" + BranchId,  //Old URL
                url: "/MasterData/GetDeptbyBranchstrnew?BranchId=" + BranchId, //New URL
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            if (selectedDept.length != 0 && selectedDept != null) {
                                var re = new RegExp("(^|,)" + response[i].Value + "($|,)");
                                if (re.test(selectedDept) == true) {
                                    $('#DeptIds').append('<option value=" ' + response[i].Value + '" selected>' + response[i].Text + '</option>');
                                }
                                else {
                                    $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                                }
                            }
                            else {
                                $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                            }
                        }
                        $Departmentselect.multiselect('rebuild');
                        $(document.body).on('change', '#DeptIds', function () {
                            $("#spvalidation").hide();
                            var deptid = $('#DeptIds option:selected');
                            var DeptArray = [];
                            $(deptid).each(function (index, deptid) {
                                DeptArray.push([$(this).val()]);
                            });
                            if (DeptArray == "") {
                                $("#txt3").val(0);
                            }
                            else {
                                $("#txt3").val(DeptArray);
                                $("#spValidation").hide();
                            }
                            var ArrDept = $("#txt3").val();
                            DeptIdlst = ArrDept;
                            $("#DepId").val(DeptIdlst);
                            $("#DesignationId").val('0');
                            $DesignationId.multiselect('rebuild');
                        });
                        //DesignationId
                        $(document.body).on('change', '#DesignationId', function () {
                            $("#spvalidation").hide();
                            var desgid = $('#DesignationId option:selected');
                            var DesgArray = [];
                            $(desgid).each(function (index, deptid) {
                                DesgArray.push([$(this).val()]);
                            });
                            if (DesgArray == "") {
                                $("#txt4").val("");
                            }
                            else {
                                $("#txt4").val(DesgArray);
                                $("#spValidation").hide();
                            }
                            var Arrdesg = $("#txt4").val();
                            DesgIdlst = Arrdesg;
                        });

                    }
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }
        function getEmp() {
            $('#EmpIds').empty();
            var cID = $("#CompanyID").val();
            var bID = $("#BranchIds").val();
            checkSession();
            $.ajax({
                type: "GET",
                // url: '@_webapiurl' + 'Master/GetEmployeeByComBranch?ComapnyId=' + cID + '&Branchid=' + bID,
                url: '@_webapiurlpayroll' + 'HrPayrollFinalize/GetEmployeeByComBranchPayStructure?ComapnyId=' + cID + '&Branchid=' + bID,
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    $('#EmpIds').empty();
                    var res = JSON.parse(response);
                    if (res != null && res.length > 0) {
                        res.sort(function (a, b) {
                            return a.EmpName.localeCompare(b.EmpName);
                        });
                        for (var i = 0; i < res.length; i++) {
                            $('#EmpIds').append('<option value=" ' + res[i].EmpId + ' ">' + res[i].EmpName + " (" + res[i].EmpCode + ") " + '</option>');
