        function GetPayrollCycleDate() {
            // Destroy the DataTable instance if it exists before re-initializing
            if ($.fn.DataTable.isDataTable('#payrollCycleDetails')) {
                $('#payrollCycleDetails').DataTable().destroy();
            }
            //dataTable
