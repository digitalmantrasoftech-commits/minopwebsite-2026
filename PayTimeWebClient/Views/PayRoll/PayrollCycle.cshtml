    function formatDate(date, format) {
        if (isNaN(date)) return '';
        const monthNames = [
            "Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
        ];
        const map = {
            yyyy: date.getFullYear(),
            yy: String(date.getFullYear()).slice(-2),
            M: monthNames[date.getMonth()],
            mm: String(date.getMonth() + 1).padStart(2, '0'),
            dd: String(date.getDate()).padStart(2, '0')
        };
        return format.replace(/yyyy|M|mm|dd|yy/g, matched => map[matched]);
    }

    function clear_data() {
        $("#Startdate").val("");
        $("#Enddate").val("");
    }

    function getDayNextMonth(dayNum) {
        const today = new Date();
        const startDate = new Date(today.getFullYear(), today.getMonth(), dayNum);
        var endDate = new Date(startDate);

        endDate.setMonth(startDate.getMonth() + 1);

        endDate.setDate(startDate.getDate());

        // Format the Enddate to yyyy-mm-dd
        var formattedEndDate = endDate.toISOString().slice(0, 10);
        var endDate = formattedEndDate.split("-")[2];
        return endDate;
    }

