                            imageUrl: "emptyscreen_1.png",
                            subText: "No entries found. Please add a record to get started."
                        });
                    }
                    var table = "";
                    if (response != null && response.length > 0) {
                        for (var i = 0; i < response.length; i++) {
                            var tbl = "<tr>";

                            tbl = tbl + "<td hidden class=''>" + (i + 1) + "</td>";
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td class='' hidden>" + (response[i].payroll_transactionid) + "</td>";
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td class=''>" + (response[i].start_date) + "</td>";
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td class=''>" + (response[i].end_date) + "</td>";
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td class=''><span class='" + (response[i].isActive ? 'green_font' : 'red_font') + "'>" + (response[i].isActive ? 'Active' : 'InActive') + "</span></td>";
                            tbl = tbl + "</td>";

                            //let dateString = response[i].created_date;
                            //let date = dateString.split('T')[0];

                            var CreatedDate = response[i].created_date;
                            var parsedDate = new Date(CreatedDate);
                            var dateformat = "@_isdateformat";
                            if (!isNaN(parsedDate)) {
                                var date = formatDate(parsedDate, dateformat);
                            } else {
                                var date = parseDateSafe(CreatedDate);
                            }

                            tbl = tbl + "<td class=''>" + (date) + "</td>";
                            tbl = tbl + "</td>";

                            tbl = tbl + "</tr>";
                            table += tbl;
                        }
                    }

