    function checkSession() {

        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }

    function getFilterTable(type) {

        var filter_table = $("#filter_table").DataTable();
        $.ajax({
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            url: "@_webapiurlpayroll" + "Report/GetFilterDetails",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                // Destroy existing DataTable instance
                if ($.fn.DataTable.isDataTable('#filter_table')) {
                    $('#filter_table').DataTable().destroy();
                }
                $("#filter_table tbody").empty();
                var table = "";
                if (response != null) {
                    if (response.length > 0) {
                        var j = 0;

                        for (var i = 0; i < response.length; i++) {
                            var tbl = "";
                            //Payroll Disbursement report filter
                            if (type == 6 && response[i].IsReportDisburse == 1) {
                                j = j + 1;
                                tbl = "<tr>";
                                tbl = tbl + "<td hidden>" + (j);
                                tbl = tbl + "</td>";
                                tbl = tbl + "<td hidden class='filter_id'>" + response[i].filter_id;
                                tbl = tbl + "</td>";


                                if (type == 6 && response[i].filter_name == "Month") {

                                }
                                else {
                                    tbl = tbl + "<td class='filter_name'>" + response[i].filter_name;
                                    tbl = tbl + "</td>";
                                }

                                tbl = tbl + "<td hidden class='filter_static_head_ids'>" + response[i].filter_static_head_ids;
                                tbl = tbl + "</td>";

                                tbl = tbl + "<td hidden class='filter_head_ids'>" + response[i].filter_head_ids;
                                tbl = tbl + "</td>";

                                tbl = tbl + "<td hidden class='filter_dynamic_head_ids'>" + response[i].filter_dynamic_head_ids;
                                tbl = tbl + "</td>";

                                tbl = tbl + "<td hidden class='is_applied'>" + response[i].IsApplied;
                                tbl = tbl + "</td>";

                                if (response[i].is_active) {
                                    tbl = tbl + '<td class="action"> <a class="editclass btn blue_btnnew tooltips edit_clm_btn" data-placement="top" id="edit_filter" title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>'
                                    //tbl = tbl + '<a style="' + (response[i].IsApplied ? 'background-color: #008000; border-color: #008000; color: #fff;' : '') + '" class="Act_classbtn blue_btnnew tooltips applyFilter" data-placement="top" title="' + (response[i].IsApplied ? 'Active Filter' : 'Apply') + '"><i class="fa-solid fa-check"></i></a>';
                                    tbl = tbl + '<a  class="Act_class' + (response[i].IsApplied ? ' activefilter_btn' : "")  + ' btn blue_btnnew tooltips applyFilter" data-placement="top" title="' + (response[i].IsApplied ? 'Active Filter' : 'Apply') + '"><i class="fa-solid fa-check"></i></a>';

                                    tbl = tbl + "</td>";
                                }

                                //If no-filter active then no need to show Deaffut seeting button
                                if (response[i].IsApplied == true) { $("#reset_filter").show() };



                                tbl = tbl + "</tr>";
                            }

                            //MonthWise Salary Register Report
                            if (type == 7 && response[i].IsReportDisburse == 0) {
                                j = j + 1;
                                tbl = "<tr>";
                                tbl = tbl + "<td hidden>" + (j);
                                tbl = tbl + "</td>";
                                tbl = tbl + "<td hidden class='filter_id'>" + response[i].filter_id;
                                tbl = tbl + "</td>";

                                if (type == 7 && response[i].filter_name == "Month") {

                                }
                                else {
                                    tbl = tbl + "<td class='filter_name'>" + response[i].filter_name;
                                    tbl = tbl + "</td>";
                                }

                                //tbl = tbl + "<td class='filter_name'>" + response[i].filter_name;
                                //tbl = tbl + "</td>";


                                tbl = tbl + "<td hidden class='filter_static_head_ids'>" + response[i].filter_static_head_ids;
                                tbl = tbl + "</td>";

                                tbl = tbl + "<td hidden class='filter_head_ids'>" + response[i].filter_head_ids;
                                tbl = tbl + "</td>";

                                tbl = tbl + "<td hidden class='filter_dynamic_head_ids'>" + response[i].filter_dynamic_head_ids;
                                tbl = tbl + "</td>";

                                tbl = tbl + "<td hidden class='is_applied'>" + response[i].IsApplied;
                                tbl = tbl + "</td>";

                                if (response[i].is_active) {
                                    tbl = tbl + '<td class="action"> <a class="editclass btn blue_btnnew tooltips edit_clm_btn" id="edit_filter" data-placement="top" title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>'
                                    //tbl = tbl + '<a style="' + (response[i].IsApplied ? 'background-color: #008000; border-color: #008000; color: #fff;' : '') + '" class="Act_class btn blue_btnnew tooltips applyFilter" data-placement="top" title="' + (response[i].IsApplied ? 'Active Filter' : 'Apply') + '"><i class="fa-solid fa-check"></i></a>';
                                    tbl = tbl + '<a  class="Act_class' + (response[i].IsApplied ? ' activefilter_btn' : "") + ' btn blue_btnnew tooltips applyFilter" data-placement="top" title="' + (response[i].IsApplied ? 'Active Filter' : 'Apply') + '"><i class="fa-solid fa-check"></i></a>';
                                    tbl = tbl + "</td>";
                                }


                                //If no-filter active then no need to show Deaffut seeting button
                                if (response[i].IsApplied == true) { $("#reset_filter").show() };

                                tbl = tbl + "</tr>";
                            }

                            table += tbl;
                        }
                    }

                        //If no-filter creted/active then no need to show Deaffut seeting button
                    else {
                        $("#reset_filter").hide();
                    }
                }
                else {

                }

                if (table != "") {
                    $("#filter_table tbody").append(table);
                } else {
                    $("#filter_table tbody").empty();
                }
                datatable_res();

                // Destroy existing DataTable instance
                if ($.fn.DataTable.isDataTable('#filter_table')) {
                    $('#filter_table').DataTable().destroy();
                }

                // DataTable initialisation
                filter_table = $("#filter_table").DataTable({
                    dom: _domCommon,
                    language: _languageCommon,
                    paging: true,
                    autoWidth: true,
                    ordering: true,
                    buttons: [
                        "excelHtml5",
                        {
                            "className": "buttons-columns btnColumnvisibility",
                        },
                    ],
                    columnDefs: [
                        { targets: -1, orderable: false },
                    ],
                    initComplete: function (settings, json) {
                        var footer = $("#filter_table tfoot tr");
                        $("#filter_table thead").append(footer);
                    }
                });
                setTimeout(function () {
                    $("#" + "filter_table" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsiveFilter"));
                    $('.tooltips').tooltip();
                }, 100);
                //Update row numbers after filtering or sorting
                //$("#filter_table").DataTable().on('order.dt search.dt', function () {
                //    $("#filter_table").DataTable().column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                //        cell.innerHTML = i + 1;
                //    });
                //}).draw();
            },
            error: function (xhr, status, error) {
                console.error(xhr.responseText);
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }

</script>

