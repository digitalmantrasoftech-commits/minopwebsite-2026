        $("#filter_name").on("keypress", function (e) {
            var key = e.which || e.keyCode;

            // Allow letters (A-Z, a-z), numbers (0-9), and space (keyCode 32)
            if (!((key >= 48 && key <= 57) ||  // 0-9
                  (key >= 65 && key <= 90) ||  // A-Z
                  (key >= 97 && key <= 122) || // a-z
                  key === 32)) {              // Space (keyCode 32)
                e.preventDefault();
            }
        });



        $("#filter_save").click(function () {


            var filterName = $("#filter_name").val().trim();
            if (!/^[a-zA-Z0-9\s]+$/.test(filterName)) {
                toastr.remove();
                toastr.error("Only letters and numbers are allowed.");
                $("#filter_name").focus().val("").addClass("field_error");
                return false;
            }
            else {
                $("#filter_name").removeClass("field_error");
            }

            var staticHeadId = $('#columnSelector input[type="checkbox"].staticHead:checked').map(function () { return $(this).val(); }).get().join(',');
            staticHeadId = staticHeadId.startsWith(',') ? staticHeadId.slice(1) : staticHeadId;

            var nondyanamicHeadId = $('#columnSelector input[type="checkbox"].nondynamicHead:checked').map(function () { return $(this).val(); }).get().join(',');
            nondyanamicHeadId = nondyanamicHeadId.startsWith(',') ? nondyanamicHeadId.slice(1) : nondyanamicHeadId;

            //var dyanamicHeadId = $('#columnSelector input[type="checkbox"].dynamicHead:checked').map(function ()
            //{ return $(this).val(); }).get().join(',');
            //dyanamicHeadId = dyanamicHeadId.startsWith(',') ? dyanamicHeadId.slice(1) : dyanamicHeadId;

            //Added by Damini on 09-01-2025
            var dyanamicHeadId = $('#columnSelector input[type="checkbox"].dynamicHead:checked')
                .map(function () {
                    var value = $(this).val();
                    return value.endsWith('D') ? value : value + 'D'; // Append 'D' only if not already present
                })
                .get()
                .join(',');

            dyanamicHeadId = dyanamicHeadId.startsWith(',') ? dyanamicHeadId.slice(1) : dyanamicHeadId;
            var isReportDisburseType = 1;
            var staticHeadIdArray = [];
            var dyanamicHeadIdArray = [];
            var nondyanamicHeadIdArray = [];

            if (staticHeadId != "") {
                staticHeadIdArray = staticHeadId.split(",");
            }

            if (dyanamicHeadId != "") {
                dyanamicHeadIdArray = dyanamicHeadId.split(",");
            }

            if (nondyanamicHeadId != "") {
                nondyanamicHeadIdArray = nondyanamicHeadId.split(",");
            }

            if (filterName == "") {
                toastr.remove();
                toastr.error("Please enter filter name");
                $("#filter_name").addClass("field_error");
                return false;
            }
            else { $("#filter_name").removeClass("field_error") }

            //for Payroll disbursment report
            if ($("#select_report").val() == 6) {

                if (staticHeadIdArray.length == 0 && dyanamicHeadIdArray.length == 0 && nondyanamicHeadIdArray.length == 0) {

                    toastr.remove();
                    toastr.error("Please select at least one filter head to create a custom filter.");
                    return false;
                }
                else {
                    //Check Static Range between 0 to 8 static head
                    for (var i = 0; i < staticHeadIdArray.length; i++) {
                        if (parseInt(staticHeadIdArray[i]) >= 0 && parseInt(staticHeadIdArray[i]) <= 8) {
                            continue;
                        }
                        else {
                            toastr.remove();
                            toastr.error("Filter data insert failed due to invalid filter passed.");
                            return false;
                        }

                    }

                    //Check non-dyanamic heads
                    for (var i = 0; i < nondyanamicHeadIdArray.length; i++) {
                        if (parseInt(nondyanamicHeadIdArray[i]) != NaN) {
                            continue;
                        }
                        else {
                            toastr.remove();
                            toastr.error("Filter data insert failed due to invalid filter passed.");
                            return false;
