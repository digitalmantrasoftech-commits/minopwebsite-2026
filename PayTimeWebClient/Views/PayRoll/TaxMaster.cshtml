        function datatableTaxRange(taxRangeId) {
            var tableTaxRnage = "";
            var taxRnage_tbl = $('#taxRange_table').DataTable();
            taxRnage_tbl.destroy();
            //Datatable call
            checkSession();
            $.ajax({
