        //Taxmaster Table Click
        //Monday 11/12/2023 Check from here
        $("#taxMaster").on('click', '.location_view', function () {
            debugger;
            var row = $(this).closest('tr')
            taxRangeId = row.find('.taxid').text();
            taxRangeId = parseInt(taxRangeId);

            $(".location_view").attr("data-toggle", "modal");
