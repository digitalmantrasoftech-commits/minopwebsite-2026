<script>
    // Main Tax Range Id
    var taxRangeId;
    //Clear Form
    function formClear() {
        //$("#effective_date").val('');
        $("#employee_count").val('');
        $("#employer_count").val('');
        $("#MaxAmount").val('');
        $("#esiccheckbox").prop("checked", false);
        $("#esic_id").val('');
    }

    function TaxSlabBox() {
        var table = "";
        var tbl = "<tr>";

        tbl = tbl + "<td class='calculate_td_120'>" + '<div class="col-xs-12"><input type="text" class="form-control input-sm" pattern="[0-9]+" name="" value="' + "" + '" id="startRange' + 1 + '" placeholder=""></div>';
        tbl = tbl + "</td>";
        tbl = tbl + "<td class='calculate_td_120'>" + '<div class="col-xs-12"><input type="text" class="form-control input-sm" pattern="[0-9]+" name="" value="' + "" + '" id="endRange' + 1 + '" placeholder=""></div>';
        tbl = tbl + "</td>";
        tbl = tbl + "<td class='calculate_td_250'>" + '<div class="col-xs-12"><input type="text" class="form-control input-sm" pattern="[0-9]+" name="" value="' + "" + '" id="taxAmount' + 1 + '" placeholder=""></div>';
        tbl = tbl + "</td>";

        tbl = tbl + "<td class='calculate_td_120'>" + '<div class="col-xs-12"><a href="javascript:void(0)" class="btn add_fields_btn" title="Add new fields" ><i class="fa fa-plus"></i></a><a href="javascript:void(0)" class="btn btn-xs red disreject" title="Remove fields"><i class="fa fa-close"></i></a></div>';
        tbl = tbl + "</td>";
        tbl = tbl + "</tr>";
        table += tbl;
        $('#Calculation_types_table').append(table);
        $("#startRange1").val(1);
        $("#startRange1").prop("disabled", true);
