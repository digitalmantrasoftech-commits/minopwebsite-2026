    $(document).ready(function () {
        //Add New Click


        TaxSlabBox();

        $("#Calculation_types_table").on('click', '.add_fields_btn', function () {
            var rowCount = $('#Calculation_types_table tr').length;
            debugger;
            if (rowCount < 8) {
                head_bind = '';
                var newRow = $('<tr>');

                var startRange1 = $('<td class="calculate_td_120">').html('<div class="col-xs-12"><input type="text" class="form-control input-sm inp" pattern="[0-9]+" name="" value="' + "" + '" id="startRange' + rowCount + '" placeholder=""></div>');
                var endRange1 = $('<td class="calculate_td_120">').html('<div class="col-xs-12"><input type="text" class="form-control input-sm inp" pattern="[0-9]+" name="" value="' + "" + '" id="endRange' + rowCount + '" placeholder=""></div>');
                var taxAmount1 = $('<td class="calculate_td_250">').html('<div class="col-xs-12"><input type="text" class="form-control input-sm inp" pattern="[0-9]+" name="" value="' + "" + '" id="taxAmount' + rowCount + '" placeholder=""></div>');
                var btn = $('<td class="calculate_td_120">').html('<div class="col-xs-12"><a href="javascript:void(0)" class="btn add_fields_btn" title="Add new fields" ><i class="fa fa-plus"></i></a><a href="javascript:void(0)" class="btn btn-xs red disreject" title="Remove fields"><i class="fa fa-close"></i></a></div>');

                newRow.append(startRange1);
                newRow.append(endRange1);
                newRow.append(taxAmount1);
                newRow.append(btn);
                $('#Calculation_types_table').append(newRow);
                for (var i = 1; i < (rowCount) ; i++) {
                    debugger;
                    if (rowCount == 1) {
                        $("#endRange" + rowCount).val(9999999);

                    }
                    else {
                        if (rowCount > 1) {
                            $("#endRange" + rowCount).val(9999999);
                            if ($("#endRange" + (rowCount - 1)).val() == 9999999) {
                                $("#endRange" + (rowCount - 1)).val('');
                            }
                        }
                    }
                }                
            }
        });


        $("#taxRange_table").on('click', '.add_fields_btn', function () {
            var rowCount = $('#taxRange_table tr').length;
            if (rowCount < 8) {
                head_bind = '';
                var newRow = $('<tr>');

                var startRange1 = $('<td class="calculate_td_120">').html('<div class="col-xs-12"><input type="text" class="form-control input-sm inp" pattern="[0-9]+" name="" value="' + "" + '" id="taxStartRange' + (rowCount - 1) + '" placeholder=""></div>');
                var endRange1 = $('<td class="calculate_td_120">').html('<div class="col-xs-12"><input type="text" class="form-control input-sm inp" pattern="[0-9]+" name="" value="' + "" + '" id="taxEndRange' + (rowCount - 1) + '" placeholder=""></div>');
                var taxAmount1 = $('<td class="calculate_td_250">').html('<div class="col-xs-12"><input type="text" class="form-control input-sm inp" pattern="[0-9]+" name="" value="' + "" + '" id="taxMonthlyAmount' + (rowCount - 1) + '" placeholder=""></div>');
                var btn = $('<td class="calculate_td_120">').html('<div class="col-xs-12"><a href="javascript:void(0)" class="btn add_fields_btn" title="Add new fields" ><i class="fa fa-plus"></i></a><a href="javascript:void(0)" class="btn btn-xs red disreject" title="Remove fields"><i class="fa fa-trash"></i></a></div>');

                newRow.append(startRange1);
                newRow.append(endRange1);
                newRow.append(taxAmount1);
                newRow.append(btn);
                $('#taxRange_table').append(newRow);
            }
        });



        // "remove row" check box
        $("#Calculation_types_table").on('click', '.disreject', function () {
            debugger;
            var rowCount = $('#Calculation_types_table tr').length;
            if (rowCount > 2) {
                @*var CurrentId = $(this).closest('tr').find('.inp').attr('id');
                var Id = parseInt(CurrentId.charAt(CurrentId.length - 1));*@
                $("#startRange" + (rowCount - 1)).closest('tr').remove();
            }

            rowCount = $('#Calculation_types_table tr').length
            if (rowCount < 8) {
                if (rowCount == 2) { }
                else { $("#endRange" + (rowCount - 1)).val(9999999); }
            }
        });

        $("#taxRange_table").on('click', '.disreject', function () {
            debugger;
            var rowCount = $('#taxRange_table tr').length;
            var Deleterow = $(this).closest('tr');
            var startRangeDel =  $("#taxStartRange" + (rowCount-2)).val();
            if (rowCount > 2) {
                var row = $(this).closest("tr");
                var rangeId = row.find(".rangeId").val();
                rangeId = parseInt(rangeId, 10); 
                

                if (rangeId > 0) {
                    checkSession();
                    $.ajax({
                        type: "POST",
                        headers: { 'Authorization': '@_tokan' },
                        url: '@_webapiurlpayroll' + 'TaxMaster/DeleteRange?id=' + rangeId,
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        beforeSend: function () {
                            $("#ajax_loader").show();
                        },
                        success: function (response) {
                            if (response.success == true) {
                                Deleterow.remove();
                                toastr.remove();
                                toastr.error(response.message);

                            }
                            if (response.success == false) {
                                toastr.remove();
                                toastr.error(response.message);
                            }

                        },
                        complete: function () {
                            $("#ajax_loader").hide();
                        }
                    });
                }
                
                else if (isNaN(rangeId)) {
                    Deleterow.remove();

                }
                else {
                    toastr.remove();
                    toastr.error("Something went wronge try again later");

                }
            }
        });


        function clearForm() {
            var rowCount = ($('#Calculation_types_table tr').length)
            if (rowCount > 1) {
                for (var i = 7; i > 0; i--) {
                    if (i == 1) {
                        $("#startRange" + i).val(1);
                        $("#endRange" + i).val('');
                        $("#taxAmount" + i).val('');
                        $("#Location").val('');
                        $("#TaxStatus").prop('checked', false);
                    }
                    else {
                        $("#startRange" + i).closest('tr').remove();
                    }
                }
            }
        }

        $("#Btn_Save").on('click', function () {

            var rowCount = ($('#Calculation_types_table tr').length);
            var validationFlag = 0;
            var locationName = $("#Location").val();
            if (locationName == null) {
                validationFlag = 1;
                toas.error("'Location' must not be empty.")
                return false
            }

            for (var i = 1; i < rowCount; i++) {

                var startRangeNum = parseInt($("#startRange" + i).val());
                var endRangeNum = parseInt($("#endRange" + i).val());
                var DeductionAmountNum = parseInt($("#taxAmount" + i).val());

                //1St Checks Start Range
                if (!(startRangeNum > 0)) {
                    toastr.remove();
                    $("#startRange" + i).val("").focus().addClass('field_error');
                    toastr.error("Start range must be greater than zero");
                    validationFlag = 1;
                    return false;
                }
                else {
                    $("#startRange" + i).removeClass('field_error');
                }

                //2nd Check End range
                if (!(endRangeNum > startRangeNum)) {
                    $("#endRange" + i).val("").focus().addClass('field_error');
                    toastr.remove();
                    toastr.error("End range must be grether than start range!");
                    validationFlag = 1;
                    return false;
                }
                else {
                    $("#endRange" + i).removeClass('field_error');

                }

                //3rd Checks Deducation amount must be less range and end range
                if (!(DeductionAmountNum < endRangeNum)) {

                    $("#taxAmount" + i).val("").focus().addClass('field_error');
                    if (i > 1) {
                        $("#endRange" + (i)).removeClass('field_green');
                    }


                    toastr.remove();
                    toastr.error("Monthly tax amount must be less than end range.");
                    validationFlag = 1;
                    return false;

                }
                else {
                    $("#taxAmount" + i).removeClass('field_error');
                }

                //Multipal-tax slabs Validation for endrange and start range
                if (i > 1) {
                    debugger;

                    //var startRangee = parseInt($("#startRange" + (i)).val());
                    //var endRangeOff = parseInt($("#endRange" + (i - 1)).val());
                    //if (startRangee == endRangeOff + 1) {
                    //    alert("Range of 2nd row is 1 more than 1st row End Range");
                    //    return false;
                    //}


                    if (parseInt($("#startRange" + (i)).val()) === (parseInt($("#endRange" + (i - 1)).val()) + 1) ) {
                        validationFlag = 0;
                        $("#startRange" + (i)).removeClass('field_error');
                        $("#endRange" + (i - 1)).removeClass('field_green');
                        $("#endRange" + (i - 1)).removeClass('field_error');
                    }
                    else {
                        //validationFlag = 1;
                        $("#startRange" + (i)).val("").focus().addClass('field_error');
                        $("#endRange" + (i - 1)).addClass('field_green');
                        toastr.remove();
                        toastr.error("Start range of " + i + "nd row should be 1 more than end range of " + (i - 1) + "st row.");
                        validationFlag = 1;
                        return false;
                    }
                }
            }

            //alert(validationFlag);
            var mainObj = [];
            for (var i = 1; i < rowCount; i++) {

                var taxslab =
                    {
                        startRange: $("#startRange" + i).val(),
                        endRange: $("#endRange" + i).val(),
                        DeductionAmount: $("#taxAmount" + i).val()
                    }

                mainObj.push(taxslab)
            }




            // Table pay_taxmaster
            var taxId = $("#taxId").val();
            (taxId == null || taxId == "") ? taxId = 0 : taxId = $("#taxId").val()

            toastr.remove();
            var obj = {

                "Tax_id": taxId,
                "Location": locationName,
                "TaxStatus": $("#TaxStatus").is(":checked") ? 1 : 0,
                "TaxSlabs": mainObj
            }
            if (validationFlag == 0) {
                checkSession();
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurlpayroll' + 'TaxMaster/AddTaxdetails',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response) {
                        if (response.success == true) {
                            toastr.remove();
                            toastr.success(response.message);
                            datatablebind();
                            clearForm();
                            debugger;
                        }

                        else if (response.success == false && response.responseCode == '400') {
                            //toastr.remove();
                            //toastr.error(response.validationErrors);
                            toastr.remove();
                            var errorLines = response.validationErrors;
                            // Display each error message separately
                            for (var i = 0; i < errorLines.length; i++) {
                                toastr.error(errorLines[i]);
                            }
                        }
                        else if (response.success == false) {
                            toastr.remove();
                            toastr.error(response.message);
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            }
        });

        //------------------------------------------------------------------Tax-Slab APi Call--------------------------------------------------------------------------------------------------------------------------------

        $("#taxslabSave").on('click', function () {

            debugger;
            var rowCount = ($('#taxRange_table tr').length);
            var validationFlag = 0;

            if (taxRangeId == 0 || taxRangeId == "") {
                toastr.error("Something Went Rwonge, Try after sometime.");
                validationFlag = 1;
                return false;

            }

            for (var i = 0; i < (rowCount - 1) ; i++) {

                var startRangeNum = parseInt($("#taxStartRange" + i).val());
                var endRangeNum = parseInt($("#taxEndRange" + i).val());
                var DeductionAmountNum = parseInt($("#taxMonthlyAmount" + i).val());

                //1St Checks Start Range
                if (!(startRangeNum > 0)) {
                    toastr.remove();
                    $("#taxStartRange" + i).val("").focus().addClass('field_error');
                    toastr.error("Start range must be greater than zero");
                    validationFlag = 1;
                    return false;
                }
                else {
                    $("#taxStartRange" + i).removeClass('field_error');
                }

                //2nd Check End range
                if (!(endRangeNum > startRangeNum)) {
                    $("#taxEndRange" + i).val("").focus().addClass('field_error');
                    toastr.remove();
                    toastr.error("End range must be grether than start range!");
                    validationFlag = 1;
                    return false;
                }
                else {
                    $("#taxEndRange" + i).removeClass('field_error');

                }

                //3rd Checks Deducation amount must be less range and end range
                if (!(DeductionAmountNum < endRangeNum)) {

                    $("#taxMonthlyAmount" + i).val("").focus().addClass('field_error');
                    if (i > 0) {
                        $("#taxEndRange" + (i - 1)).removeClass('field_green');
                    }


                    toastr.remove();
                    toastr.error("Monthly tax amount must be less than end range.");

                    validationFlag = 1;
                    return false;

                }
                else {
                    $("#taxMonthlyAmount" + i).removeClass('field_error');
                }

                //Multipal-tax slabs Validation for endrange and start range
                if (i > 0) {
                    if (parseInt($("#taxStartRange" + (i)).val()) > parseInt($("#taxEndRange" + (i - 1)).val())) {
                        validationFlag = 0;
                        $("#taxStartRange" + (i)).removeClass('field_error');
                        $("#taxEndRange" + (i - 1)).removeClass('field_green');
                        $("#taxEndRange" + (i - 1)).removeClass('field_error');
                    }
                    else {
                        //validationFlag = 1;
                        $("#taxStartRange" + (i)).val("").focus().addClass('field_error');
                        $("#taxEndRange" + (i - 1)).addClass('field_green');
                        toastr.remove();
                        toastr.error("Start range of " + i + "nd row should be greater than end range of " + (i - 1) + "st row.");
                        validationFlag = 1;
                        return false;
                    }
                }



            }

            //alert(validationFlag);
            var mainObj = [];
            for (var i = 0; i < rowCount - 1 ; i++) {

                if ($("#taxRangeId" + i).val() == undefined || $("#taxRangeId" + i).val() == null) {
                    var taxslab =
                    {
                        range_id: 0,
                        startRange: $("#taxStartRange" + i).val(),
                        endRange: $("#taxEndRange" + i).val(),
                        DeductionAmount: $("#taxMonthlyAmount" + i).val()
                    }
                }
                else {
                    var taxslab =
                    {
                        range_id: $("#taxRangeId" + i).val(),
                        startRange: $("#taxStartRange" + i).val(),
                        endRange: $("#taxEndRange" + i).val(),
                        DeductionAmount: $("#taxMonthlyAmount" + i).val()
                    }
                }
                mainObj.push(taxslab)
            }


            // Table TaxSlab
            var taxId = taxRangeId;
            toastr.remove();

            //Here Obj Containes Main taxId and its taxRanges values this taxRanges have Unique RangeId
            var obj = {

                "Tax_id": taxId,
                "TaxSlabs": mainObj
            }
            if (validationFlag = 1) {
                checkSession();
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurlpayroll' + 'TaxMaster/AddUpdateTaxRange',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response) {
                        if (response.success == true) {
                            toastr.remove();
                            toastr.success(response.message);
                            datatablebind();
                            $('#taxRange').modal('toggle');
                        }

                        else if (response.success == false && response.responseCode == '400') {
                            //toastr.remove();
                            //toastr.error(response.validationErrors);
                            toastr.remove();
                            var errorLines = response.validationErrors;
                            // Display each error message separately
                            for (var i = 0; i < errorLines.length; i++) {
                                toastr.error(errorLines[i]);
                            }
                        }
                        else if (response.success == false) {
                            toastr.remove();
                            toastr.error(response.message);
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            }
        })


        //------------------------------------------------------------------Tax-Slab APi Call Ends here--------------------------------------------------------------------------------------------------------------------------------






        //DataTable TaxMaster
        datatablebind();
        function datatablebind() {
