                            tbl = tbl + "<td hidden class='taxid' style='display:none'>" + response[i].tax_id + "<span></span>";
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td class='Number'>" + (i + 1) + "<span></span>";
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td class='location location_view' style='color: #2196F3'>" + response[i].location_name + "<span></span>";
