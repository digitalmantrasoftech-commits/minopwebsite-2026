           //Use to parse the 6 date format (DD-MMM-YYYY, DD-MM-YYYY, MMM-DD-YYYY, MM-DD-YYYY, YYYY-MMM-DD, YYYY-MM-DD)
            function parseDateSafe(value) {
                if (!value) return null;
                const monthNames = {
                    Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,
                    Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11
                };
                value = value.trim().replace(/[\s]+/g, '');
                const patterns = [
                    { regex: /^(\d{2})-([A-Za-z]{3})-(\d{4})$/, order: ['D', 'M', 'Y'] },
                    { regex: /^(\d{2})-(\d{2})-(\d{4})$/, order: ['D', 'N', 'Y'] },
                    { regex: /^([A-Za-z]{3})-(\d{2})-(\d{4})$/, order: ['M', 'D', 'Y'] },
                    { regex: /^(\d{2})-(\d{2})-(\d{4})$/, order: ['N', 'D', 'Y'] },
                    { regex: /^(\d{4})-([A-Za-z]{3})-(\d{2})$/, order: ['Y', 'M', 'D'] },
                    { regex: /^(\d{4})-(\d{2})-(\d{2})$/, order: ['Y', 'N', 'D'] }
                ];
                for (let pattern of patterns) {
                    const match = value.match(pattern.regex);
                    if (match) {
                        let day, month, year;
                        pattern.order.forEach((part, i) => {
                            const val = match[i + 1];
                            switch (part) {
                                case 'D': day = parseInt(val); break;
                                case 'M': month = monthNames[val.substring(0, 3)] ?? -1; break;
                                case 'N': month = parseInt(val) - 1; break;
                                case 'Y': year = parseInt(val); break;
                            }
                        });
                        const date = new Date(year, month, day);
                        if (!isNaN(date)) {
                            // Manual formatting to YYYY-MM-DD (local date)
                            const mm = String(month + 1).padStart(2, '0');
                            const dd = String(day).padStart(2, '0');
                            return `${year}-${mm}-${dd}`;
                        }
                    }
                }
                // fallback
                const fallback = new Date(value);
                if (isNaN(fallback)) return null;
                return fallback.toISOString().split("T")[0];
        }


        function formatDate(date, format) {
            if (isNaN(date)) return '';
            const monthNames = [
                "Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
            ];
            const map = {
                yyyy: date.getFullYear(),
                yy: String(date.getFullYear()).slice(-2),
                M: monthNames[date.getMonth()],
                mm: String(date.getMonth() + 1).padStart(2, '0'),
                dd: String(date.getDate()).padStart(2, '0')
            };
            return format.replace(/yyyy|M|mm|dd|yy/g, matched => map[matched]);
        }


