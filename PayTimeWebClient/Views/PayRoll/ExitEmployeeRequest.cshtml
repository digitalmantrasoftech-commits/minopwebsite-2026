        $("#reason").keypress(function (e) {
            var maxLength = 45;
            var currentLength = $(this).val().length;

            // Allow backspace, delete, arrow keys, etc.
            if (e.which === 0 || e.which === 8 || e.which === 46 || (e.which >= 37 && e.which <= 40)) {
                return true;
            }
            if (currentLength >= maxLength) {
                e.preventDefault();
            }
        });



        $("#leavingdate").keypress(function (e) {
            var charCode = e.which || e.keyCode;
            var charStr = String.fromCharCode(charCode);
            var regex = /^[0-9\/\-\:\s]$/;
            if (!regex.test(charStr)) {
                e.preventDefault();
            }
        });
        $("#leavingdate").on("blur", function () {
            var dateValue = $(this).val();
            var dateTimeRegex = /^\d{2}[\/\-]\d{2}[\/\-]\d{4}\s\d{2}:\d{2}$/;
            if (!dateTimeRegex.test(dateValue)) {
                $(this).val("");
                return false;
            }
        });

        $("#interviewdate").keypress(function (e) {
            var charCode = e.which || e.keyCode;
            var charStr = String.fromCharCode(charCode);
