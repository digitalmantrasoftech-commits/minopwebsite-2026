        // Function to call the Approved and reject on backened call
        function processApproval(empid, Remarks, isApproved, ExitEmployeeId, WorkFlowId, LevelId, EmpCode, EmpName) {

            var obj = {
                "EmpCode": EmpCode,
                "EmpName": EmpName,
                "empid": empid,
                "ExitEmployeeId": ExitEmployeeId,
                "WorkFlowId": WorkFlowId,
                "LevelId": LevelId,
                "Remarks": Remarks,
                "isapproved": isApproved
            };
            checkSession();
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'Full_FinalSettlement/ApprovalorRejectedExitEmployee',
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {

                    toastr.remove();
                    if (response.success && response.responseCode == 200) {

                        $.ajax({
                            type: "GET",
                            headers: { 'Authorization': '@_tokan' },
                            url: '@_webapiurlpayroll' + 'Full_FinalSettlement/ApprovalClearance',
                            data: { ExitEmployeeId: ExitEmployeeId, EmpName: EmpName },
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            beforeSend: function () {
                                $("#ajax_loader").show();
                            },
                            success: function (response) {

                                toastr.remove();
                                if (response.success && response.responseCode == 200) {
                                    toastr.success(response.message);
                                    //exitemployeerequesttbl();
                                    $("#exitclearance_tbl, #exitclearance_tbl_wrapper").show();
                                    setTimeout(function () {
                                        window.location.reload(true);
                                    }, 10);
                                }
                                else if (response.success === false && response.responseCode == 205) {
                                    toastr.success(response.message);
                                }
                                else {
                                    toastr.error(response.message);
                                }
                            },
                            error: function (xhr) {
                                console.error("GET Error:", xhr.status, xhr.responseText);
                                toastr.error(xhr.responseJSON?.title || "An unexpected error occurred. Please try again.");
                            },
                            complete: function () {
                                $("#ajax_loader").hide();
                            }
                        });


                        toastr.success(response.message);
                        $("#exitclearance_tbl, #exitclearance_tbl_wrapper").show();
                        setTimeout(function () {
                            window.location.reload(true);
                        }, 5000);
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    toastr.remove();
                    toastr.error("An error occurred: " + error);
                    console.error("Error:", status, error);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }



