        $("#Printbtn").on('click', function () {
         
            checkSession();
            var checkboxValues = '';
            $('.toggle-vis').each(function (index) {
                if ($(this).prop('checked')) {
               
                    if (checkboxValues !== '') {
                        checkboxValues += ',';
                    }
                    checkboxValues += $(this).val();
                }
            });

            if (checkboxValues != "") {
                if (typeof ExitEmployeeId === "undefined" || isNaN(ExitEmployeeId)) {
                    console.error("ExitEmployeeId is not valid:", ExitEmployeeId);
                    return;
                }
                $.ajax({
                    type: "GET",
                    url: '@_webapiurlpayroll' + "Full_FinalSettlement/PrintExitEmployeeRequest?ExitEmployeeId=" + ExitEmployeeId + "&Print_value=" + checkboxValues,
                    headers: { 'Authorization': '@_tokan' },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response, status, xhr) {
                        if (response && response.length > 0) {
                            var newWindow = window.open();
                            newWindow.document.title = "Employee Exit Request Print";
                            newWindow.document.write(response);
                            newWindow.document.close();
                        } else if (typeof response === "undefined" || response === undefined) {
                            toastr.error("No data found");
                        } else {
                            toastr.error("No data found");
                        }
