        function fillBranchbycompnyid(companyid, selectedBranch) {

            $('#BranchIds').empty();
            $("#ajax_loaderaddon").show();
            $("#ajax_loader").show();
            checkSession();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "Master/BranchGetAll",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    $("#BranchIds").append("<option value='0' selected>Select Branch</option>");
                    var markup = '';
                    var companyIdsToFind = companyid;
                    if (companyid != null) {
                        var filteredData = data.filter(function (item) {
                            return companyid == item.CompanyID;
                        });

                        filteredData.sort(function (a, b) {
                            return a.branchname.localeCompare(b.branchname);
                        });

                        filteredData.forEach(function (branch) {
                            if (selectedBranch && selectedBranch.length > 0) {
                                var isSelected = selectedBranch.includes(branch.BranchId.toString());
                                markup += `<option value="${branch.BranchId}" ${isSelected ? 'selected="selected"' : ''}>${branch.branchname}</option>`;
                            } else {
                                markup += `<option value="${branch.BranchId}">${branch.branchname}</option>`;
                            }
                        });

                        // Append all options to the dropdown
                        $('#BranchIds').append(markup);

                        // Set the branch ID if available
                        $('#BranchIds').val(BranchId).trigger('change');

                        // Change event handler
                        $(document.body).on('change', '#BranchIds', function () {

                            var branchid = $('#BranchIds option:selected');
                            var BranchArray = [];

                            branchid.each(function () {
                                BranchArray.push($(this).val());
                            });

                            if (BranchArray.length === 0) {
                                $("#txt2").val(0);
                            } else {
                                $("#txt2").val(BranchArray.join(","));
                            }

                            BranchIdlst = $("#txt2").val();
                            getEmp();
                        });
                    } else {
                       // $('#BranchIds').append("<option value='' disabled>No branch available</option>");
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    if (xhr.status == 404) {
                        toastr.error(thrownError);
                    } else if (xhr.status == 500) {
                        toastr.error("Internal Server Error");
                    } else if (xhr.status == 400) {
                        toastr.error("Bad Request");
                    } else if (xhr.status == 419) {
                        window.location.href = "/PayTime/LoginPage";
                    } else {
                        toastr.error(thrownError);
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }

