        //Bind department depend on the company and branch
        function fillDepartment(BranchId, selectedDept) {

            checkSession();
            $("#DeptIds").empty();
            $.ajax({
                type: "POST",
                url: "/MasterData/GetDeptbyBranchstrnew?BranchId=" + BranchId,
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {

                    $("#DeptIds").append("<option value='0' selected>Select Department</option>");
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            if (selectedDept.length != 0 && selectedDept != null) {
                                var re = new RegExp("(^|,)" + response[i].Value + "($|,)");
                                if (re.test(selectedDept) == true) {
                                    $('#DeptIds').append('<option value="' + response[i].Value + '" selected>' + response[i].Text + '</option>');
                                }
                                else {
                                    $('#DeptIds').append('<option value="' + response[i].Value + '">' + response[i].Text + '</option>');
                                }
                            }
                            else {
                                $('#DeptIds').append('<option value="' + response[i].Value + '">' + response[i].Text + '</option>');
                            }
                        }

                        $('#DeptIds').val(DepartmentId).trigger('change');

                        $(document.body).on('change', '#DeptIds', function () {

                            $("#spvalidation").hide();
                            var deptid = $('#DeptIds option:selected');
                            var DeptArray = [];
                            $(deptid).each(function (index, deptid) {
                                DeptArray.push([$(this).val()]);
                            });
                            if (DeptArray == "") {
                                $("#txt3").val(0);
                            }
                            else {
                                $("#txt3").val(DeptArray);
                                $("#spValidation").hide();
                            }
                            var ArrDept = $("#txt3").val();
                            DeptIdlst = ArrDept;
                            $("#DeptIds").val(DeptIdlst);
                            fillEvaluationBy();
                            //fillEvaluationBy(branchId, deptId, selectedEmp, null);
                        });
                    }
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }

