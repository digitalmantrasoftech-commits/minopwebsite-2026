                    if (response && response.length > 0) {
                        response.forEach((data, index) => {
                            var CompanyID = data.CompanyID ? data.CompanyID.toString().split(',') : [];
                            BranchId = data.BranchId ? data.BranchId.toString().split(',') : [];
                            EmpId = data.EmpId ? data.EmpId.toString().split(',') : [];
                            DepartmentId = data.DepartmentId ? data.DepartmentId.toString().split(',') : [];
                            IsClearance = data.IsClearance ? data.IsClearance.toString().split(',') : [];
                            WorkFlowId = data.WorkFlowId ? data.WorkFlowId.toString().split(',') : [];
                            var ExitType = data.ExitType ? data.ExitType.toString().split(',') : [];
                            var ExitInterview = data.ExitInterview ? data.ExitInterview.toString().split(',') : [];
                             EvaluationBy = data.EvaluationBy ? data.EvaluationBy.toString().split(',') : [];
                            var InterviewPlace = data.InterviewPlace ? data.InterviewPlace.toString().split(',') : [];
                            var Reason = data.Reason ? data.Reason.toString().split(',') : [];
                            Status = data.Status ? data.Status.toString().split(',') : [];

                            var LeavingDate = data.LeavingDate ? data.LeavingDate.toString().split(',').map(function (dateTime) {
                                return dateTime.split('T')[0];
                            }) : [];
                            var parsedDate = new Date(LeavingDate);
                            var dateformat = "@_isdateformat";
                            var LeavingDate = formatDate(parsedDate, dateformat)


                            var InterviewDate = data.InterviewDate ? data.InterviewDate.toString().split(',').map(function (dateTime) {
                                return dateTime.split('T')[0];
                            }) : [];
                            var parsedDate = new Date(InterviewDate);
                            var dateformat = "@_isdateformat";
                            var InterviewDate = formatDate(parsedDate, dateformat)

                            var InterviewTime = data.InterviewTime ? data.InterviewTime.toString().split(',').map(function (dateTime) {
                                return dateTime.split('T')[0];
                            }) : [];

                            if (!InterviewTime) {
                                InterviewTime = "12:00 AM";
                            } else {
                                if (!InterviewTime.includes(":")) {
                                    InterviewTime += ":00";
                                }
                                let [hours, minutes] = InterviewTime.trim().split(":").map(Number);
                                let modifier = "AM";
                                if (hours >= 12) {
                                    modifier = "PM";
                                    if (hours > 12) {
                                        hours -= 12;
                                    }
                                } else if (hours === 0) {
                                    hours = 12;
                                }
                                let hoursStr = hours.toString();
                                let minutesStr = minutes.toString().padStart(2, '0');
                                InterviewTime = `${hoursStr}:${minutesStr} ${modifier}`;
                            }



                            $('#CompanyID').val(CompanyID).trigger('change');
                            $('#BranchIds').val(BranchId).trigger('change');
                            //$('#EmpIds').val(EmpId).trigger('change');
                            $('#exittype').val(ExitType).trigger('change');
                            $("#leavingdate").val(LeavingDate);
                            $("#reason").val(Reason);
                            $('#isclearance').val(IsClearance).trigger('change');
                            $('#exitinterview').val(ExitInterview).trigger('change');

                            if (IsClearance == 1) {
                                $("#clearancelevel").show();
                                $("#viewflow").hide();
                                getallworkflow(1);
                                $('#workflow').val(WorkFlowId).trigger('change');
                            }
                            else {
                                $("#clearancelevel").hide();
                            }

