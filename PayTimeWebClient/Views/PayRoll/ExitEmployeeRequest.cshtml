        function getallworkflow(Status) {
            checkSession();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'Full_FinalSettlement/GetAllWorkFlow',
                data: { Status: Status },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {

                    if (response.length > 0) {
                        $("#workflow").empty();
                        $("#workflow").append("<option value='0' selected>Select Workflow</option>");
                        response.sort(function (a, b) {
                            return a.WorkFlowName.localeCompare(b.WorkFlowName);
                        });
                        var markup = "";
                        for (var x = 0; x < response.length; x++) {
                            markup += "<option value=" + response[x].WorkFlowId + ">" + response[x].WorkFlowName + "</option>";
                        }
                        $("#workflow").append(markup);
                        $("#workflow").val(WorkFlowId).trigger('change');

                        $(document).on('change', '#workflow', function () {
                            var workflowid = $("#workflow").val();
                            if (workflowid && workflowid > 0) {
                                $("#viewflow").show();
                            } else {
                                $("#viewflow").hide();
                            }
                        });
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    if (xhr.status == 404) {
                        toastr.error(thrownError);
                    } else if (xhr.status == 500) {
                        toastr.error("InternalServerError");
                    } else if (xhr.status == 400) {
                        toastr.error("BadRequest");
                    } else if (xhr.status == 419) {
                        window.location.href = "/PayTime/LoginPage";
                    } else {
                        toastr.error(thrownError);
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }

