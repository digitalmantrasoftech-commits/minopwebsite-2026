        function GetWorkFlowView(ExitEmployeeId) {
            checkSession();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'Full_FinalSettlement/GetWorkFlowView',
                data: { ExitEmployeeId: ExitEmployeeId },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {

                    if (response && response.length > 0) {
                        var modalContent = '';

                        response.forEach(function (data, index) {
                             var status = data.StatusApproval;
                             var RoleId = @_RoleId;

                            statustext = "";


                            if (status == 1) {
                                if (RoleId != '1' && RoleId != '6805' && RoleId != '6806') {
                                    statustext = "Pending for Approval";
                                    statusClass = "blue_font";
                                } else {
                                    statustext = "Sending for Approval";
                                    statusClass = "purple_font";
                                }
                            }
                            else if (status == 0) {
                                statustext = "Pending";
                                statusClass = "orange_font";
                            }
                            else if (status == 2) {
                                statustext = "Approved";
                                statusClass = "green_font";
                            }
                            else if (status == 3) {
                                statustext = "Rejected";
                                statusClass = "red_font";
                            }
                            else {
                                statustext = "Pending";
                                statusClass = "orange_font";
                            }
                            //else if (status == 4)
                            //{
                            //    statustext = "Pending";
                            //    statusClass = "orange_font";
                            //}

                            modalContent += `
                        <div class="clearance-level-block">
                            <div>Level <span>${index + 1}</span></div>
                            <div class="level-approval">
                                Name: <span class="margin-left-5 margin-right-5">${data.EmpName}</span>
                                <div class="level-date">${new Date(data.ApprovalDate).toLocaleString().replace('T', ' ').split('.')[0]}<span class="margin-left-5"></span></div>
                            </div>
                            <div class="level-data">
                                <div>Department: <span>${data.DepartmentName}</span></div>
                                <div class="level-status">Status: <span class="${statusClass}">${statustext}</span></div>
                            </div>
                        </div>`;
                        });

                        $("#viewflow_modal .modal-body").html(modalContent);
                        $("#view_workflow").modal('show');

                    } else {
                        $("#create_workflow").show();
                        $("#workflow_form").hide();
                        $("#create_newworkflowbtn").hide();
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.error("Error:", textStatus, errorThrown);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }

