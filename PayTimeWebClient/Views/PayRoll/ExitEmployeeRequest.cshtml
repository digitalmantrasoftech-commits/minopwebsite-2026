                                $("#exitinterview_level").show();
                                $('#DeptIds').val(DepartmentId).trigger('change');
                                $('#evaluationby').val(EvaluationBy).trigger('change');
                                $("#interviewdate").val(InterviewDate);
                                $("#interviewtime").val(InterviewTime);
                                $("#interviewplace").val(InterviewPlace);
                            }
                            else {
                                $("#exitinterview_level").hide();
                            }
                        });
