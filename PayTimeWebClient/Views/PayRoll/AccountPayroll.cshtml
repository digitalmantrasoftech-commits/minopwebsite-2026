            function Status_Update(status) {
                var selectedValues = []; // An array to store the selected values

                $("#Generate_TDS_table").DataTable().$('input[type="checkbox"]').each(function (key, value) {
                    if ($(this).is(':checked')) {
                        selectedValues.push($(this).val()); // Add the checked value to the array
                    }
                });

                var concatenatedString = selectedValues.join(', ');
                if (selectedValues.length > 0) {
                    checkSession();

                    var Object = {
                        Payroll_finalize_id: concatenatedString,
                        status: parseInt(status),
                    };

                    $.ajax({
                        type: "POST",
                        headers: { 'Authorization': '@_tokan' },
                        url: '@_webapiurlpayroll' + 'HRAttendanceFinalize/UpdateBulkAttendanceStatus',
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        data: JSON.stringify(Object),
                        beforeSend: function () {
                            $("#ajax_loader").show();
                        },
                        success: function (response) {
                            setTimeout(function () {
                                tableget(status);
                            }, 1500);

                            if (response.success == true) {
                                if (status == 4) {
                                    toastr.remove();
                                    toastr.success("Employee Salary successfully Freezed ");
                                } else if (status == 5) {
                                    toastr.remove();
                                    toastr.success("Employee Salary successfully On Hold ");
                                } else if (status == 6) {
                                    toastr.remove();
                                    toastr.success("Employee Salary successfully FNF ");
                                } else if (status == 9) {
                                    toastr.remove();
                                    toastr.success("Employee send for salary approval successfully");
                                }
                            }
                        },
                        error: function (xhr, status, error) {
                            // Handle error response
                        }
                    });
                }
