                <table id="pfmastertable" class="viewstructure table table-striped table-bordered table_box_border table-hover serch_datatable table-checkable order-column">
                    <thead>
                        <tr>
                            <th style="min-width: 250px;">PFStructure Name</th>
                            <th style="min-width: 90px;">PF Calculationon</th>
                            <th style="min-width: 150px;">Employee Contribution (%)</th>
                            <th style="min-width: 120px;">Employer Contribution (%)</th>
                            @*<th style="min-width: 80px;">Created Date</th>*@
                            <th style="min-width: 80px;">Max Amount</th>
                            <th style="min-width: 90px;">PF Fixed</th>
                            <th style="min-width: 90px;">PF Fixedamount</th>
                            <th> Action</th>
                            <th hidden>PF_id</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                <!-- Datatable : End -->
            </div>
        </div>

        <!-- Create New Column Modal : Begin -->
        <div id="create_newpf" class="modal fade popup_info_model" role="dialog" data-keyboard="false" data-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">

                <!-- Modal content -->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title" id="Create_head">Create Pf Master</h4>
                        <h4 class="modal-title" id="Edit_head" style="display:none">Edit Pf Master</h4>
                    </div>
                    <div class="modal-body">
                        <fieldset>
                            <div class="row">
                                @*<div class="col-md-8 col-xs-12">
                                        <div class="form-group ">
                                            <label class="control-label">Structure Name<span class="required" aria-required="true"> * </span></label>
                                            <input type="text" id="txt5" value="0" hidden />
                                            <select id="StructureID" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%"></select>
                                        </div>
                                    </div>*@

                                <input class="form-control" id="PF_id" type="text" value="" placeholder="Enter pf_id" style="display:none">

                                <div class="col-md-8 col-xs-12">
                                    <div class="form-group">
                                        <label>PFStructure Name<span class="required" aria-required="true"> * </span></label>
                                        <input type="text" class="form-control input-sm" name="" id="pfstructure_name" placeholder="Enter PFStructure Name" maxlength="50">
                                    </div>
                                </div>

                                <div class="col-md-8 col-xs-12">
                                    <div class="form-group">
                                        <label class="control-label">PF Calculation On<span class="required" aria-required="true"> * </span></label>
                                        <div class="row">
                                            <div class="col-md-3 col-xs-3">
                                                <label>
                                                    <input type="radio" name="pfcalculationOn" id="pfcalculationBasic" value="0" />
                                                    Basic
                                                </label>
                                            </div>
                                            <div class="col-md-3 col-xs-3">
                                                <label>
                                                    <input type="radio" name="pfcalculationOn" id="pfcalculationGross" value="1" />
                                                    Gross
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="col-md-8 col-xs-12">
                                    <div class="form-group">
                                        <label class="control-label">Employee Contribution(in %)<span class="required" aria-required="true"> * </span></label>
                                        <input type="text" class="form-control input-sm" id="employee_contribution" placeholder="Enter Employee Contribution" maxlength="3">
                                    </div>
                                </div>

                                <div class="col-md-8 col-xs-12">
                                    <div class="form-group">
                                        <label class="control-label">Employer Contribution(in %)<span class="required" aria-required="true"> * </span></label>
                                        <input type="text" class="form-control input-sm" id="employer_contribution" placeholder="Enter Employer Contribution" maxlength="3">
                                    </div>
                                </div>

                                <input class="form-control" id="Column_id" type="text" value="" placeholder="Enter Column Title" style="display:none">
                                <div class="col-md-8 col-xs-12">
                                    <div class="form-group amount_box">
                                        <label class="control-label">Max Amount applicable<span class="required" aria-required="true"> * </span></label>
                                        <span class="currency-symbol">&#8377;</span>
                                        <input type="text" class="form-control input-sm number" id="max_amount" placeholder="Enter Max Amount" maxlength="10">
                                    </div>
                                </div>

                                <div class="col-md-8 col-xs-12">
                                    <div class="fixed-checkbox">
                                        <input type="checkbox" id="pfCheckbox" value="true">
                                        <label for="myCheckbox">Pf Fixed</label>
                                    </div>
                                    <div class="form-group amount_box" id="pfTextboxBlock" style="display:none">
                                        <span class="currency-symbol">&#8377;</span>
                                        <input class="form-control" type="text" id="pfTextbox" value="" placeholder="Enter Pf Fixed Amount" maxlength="50">
                                    </div>
                                </div>

                            </div>
                        </fieldset>
                    </div>
                    <div class="modal-footer">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                                <button type="button" class="btn save_btn" id="btnsave"> Save </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <!-- Create New Column Modal : End -->
    </div>
</div>





