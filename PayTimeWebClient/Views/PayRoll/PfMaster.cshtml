<script type="text/javascript">
    $(document).ready(function () {
        var Structureselect;
        var pfid = 0;
        var selectedValue;
        var pffixedcheckboxVal = false;
        //var pffixedamount = 0;

        //Multiselect Structure
        //$Structureselect = $("#StructureID").multiselect({
        //    selectAllValue: 'multiselect-all',
        //    enableCaseInsensitiveFiltering: true,
        //    includeSelectAllOption: true,
        //    allSelectedText: 'All Select',
        //    enableFiltering: true,
        //    maxHeight: '300',
        //    buttonWidth: '100%',
        //    enableClickableOptGroups: true,
        //    nonSelectedText: 'Select Structure'
        //});
        //$('#StructureID').change(function () {
        //    var s = $('#StructureID').val();
        //    $('#structure_name').val($("#StructureID option:selected").text());
        //    var branid = $('#StructureID option:selected');
        //    var StructureArray = [];
        //    $(branid).each(function (index, branid) {
        //        StructureArray.push([$(this).val()]);
        //    });
        //    if (StructureArray == "") {
        //        $("#txt5").val(0);
        //    }
        //    else {
        //        $("#txt5").val(StructureArray);
        //    }
        //    var Arrbranch = $("#txt5").val();
        //    StructureIdlst = Arrbranch;
        //});

        //PF Calculationon Radio Button
        $("#pfcalculationBasic").click(function () {
            if ($(this).is(":checked")) {
                selectedValue = $(this).val();
            }
        });
        $("#pfcalculationGross").click(function () {
            if ($(this).is(":checked")) {
                selectedValue = $(this).val();
            }
        });

        //Checkbox of PF Fixed
        $('#pfCheckbox').on('change', function () {
            if ($(this).is(':checked')) {
                pffixedcheckboxVal = true;
                $('#pfTextboxBlock').show();
            } else {
                $('#pfTextboxBlock').hide();
                pffixedcheckboxVal = false;
            }
        });

        //Click on Save Button
        $("#btnsave").on('click', function () {
            if ($("#pfstructure_name").val() == "" || $("#pfstructure_name").val() == null) {
                toastr.remove();
                toastr.error("Please select pfstructure name.");
                $("#pfstructure_name").addClass('field_error');
                return false;
            }
            else {
                $("#pfstructure_name").removeClass('field_error');
            }
            if ($("#employee_contribution").val() == "" || $("#employee_contribution").val() == null) {
                toastr.remove();
                toastr.error("Please enter employee contribution.");
                $("#employee_contribution").addClass('field_error');
                return false;
            }
            else {
                $("#employee_contribution").removeClass('field_error');
            }
            if ($("#employer_contribution").val() == "" || $("#employer_contribution").val() == null) {
                toastr.remove();
                toastr.error("Please enter employer contribution.");
                $("#employer_contribution").addClass('field_error');
                return false;
            }
            else {
                $("#employer_contribution").removeClass('field_error');
            }
            if ($("#max_amount").val() == "" || $("#max_amount").val() == null) {
                toastr.remove();
                toastr.error("Please enter max amount.");
                $("#max_amount").addClass('field_error');
                return false;
            }
            else {
                $("#max_amount").removeClass('field_error');
            }

            var pffixedamount = 0;
            if (pffixedcheckboxVal) {
                pffixedamount = parseInt($("#pfTextbox").val());
            }
            var obj = {
                "PFId": parseInt($("#PF_id").val()),
                "pfstructurename": $("#pfstructure_name").val(),
                "pfcalculationon": parseInt(selectedValue),
                "employeecontribution": parseInt($("#employee_contribution").val()),
                "employercontribution": parseInt($("#employer_contribution").val()),
                "maxamount": parseInt($("#max_amount").val()),
                "pffixedamount": pffixedamount,
                "pffixed": pffixedcheckboxVal
            }
            var delay = 1000;
            if ($("#PF_id").val() == 0) {
                checkSession();
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurlpayroll' + 'Payroll/AddPFMaster',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response) {
                        if (response.success == true) {
                            toastr.remove();
                            toastr.success("Pf Master added successfully");
                            $('#create_newpf').modal('toggle');
                            setTimeout(function () {
                                window.location.reload(true);
                            }, delay);
                        }
                        else if (response.success == false) {
                            toastr.remove();
                            toastr.error(response.message);
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            }
            else {
                checkSession();
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurlpayroll' + 'Payroll/UpdatePFMaster',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response) {
                        if (response.success == true) {
                            toastr.remove();
                            toastr.success("Pf Master updated successfully");
                            $('#create_newpf').modal('toggle');
                            setTimeout(function () {
                                window.location.reload(true);
                            }, delay);
                        }
                        else if (response.success == false) {
                            toastr.remove();
                            toastr.error(response.message);
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            }
        });

        //Edit
        $("#pfmastertable").on('click', '.edit_clm_btn', function () {
            frmclear();
            var PF_id = t.row($(this).parent('td').parent('tr')).data()["PF_id"];
            $("#PF_id").val(PF_id);
            var pfstructure_name = t.row($(this).parent('td').parent('tr')).data()["pfstructure_name"];
            $("#pfstructure_name").val(pfstructure_name);
            var pf_calculationon = t.row($(this).parent('td').parent('tr')).data()["pf_calculationon"];
            if (pf_calculationon == 0) {
                $('#pfcalculationBasic').prop('checked', true);
                $('#pfcalculationGross').prop('checked', false);
                selectedValue = 0;
            }
            else {
                $('#pfcalculationGross').prop('checked', true);
                $('#pfcalculationBasic').prop('checked', false);
                selectedValue = 1;
            }
            var employee_contribution = t.row($(this).parent('td').parent('tr')).data()["employee_contribution"];
            $("#employee_contribution").val(employee_contribution);
            var employer_contribution = t.row($(this).parent('td').parent('tr')).data()["employer_contribution"];
            $("#employer_contribution").val(employer_contribution);
            var max_amount = t.row($(this).parent('td').parent('tr')).data()["max_amount"];
            $("#max_amount").val(max_amount);
            var pf_fixedamount = t.row($(this).parent('td').parent('tr')).data()["pf_fixedamount"];
            $("#pf_fixedamount").val(pf_fixedamount);
            var pf_fixed = t.row($(this).parent('td').parent('tr')).data()["pf_fixed"];
            if (pf_fixed === true) {
                $('#pfCheckbox').prop('checked', true);
                $('#pfTextboxBlock').show();
                $('#pfTextbox').val(pf_fixedamount);
            } else {
                $('#pfTextboxBlock').hide();
                $('#pfCheckbox').prop('checked', false);
            }
            $(".edit_clm_btn").attr("data-toggle", "modal");
            $(".edit_clm_btn").attr("data-target", "#create_newpf");
            $("#create_pf").hide();
        });

        var t = $("#pfmastertable").DataTable({
            dom: "<'row'<'col-lg-9 col-sm-7 col-xs-12'<'selected_emp_main'<'tbl_text'>>><'col-lg-3 col-sm-5 col-xs-12 recordbtn_end'<'record_btn_main'l,><'dt-buttons'Bf>>>" +
            "<'row'<'col-sm-12 margin-bottom-10'<'customforms_table'tr'>>>" +
            "<'row'<'col-md-5 col-sm-5'i><'col-md-7 col-sm-7'p>>",
            paging: true,
            autoWidth: true,
            "ajax": {
                url: '@_webapiurlpayroll' + 'Payroll/GetAll',
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                dataSrc: '',
            },

            "columns": [
                { "data": "pfstructure_name" },
                { "data": "pf_calculationon" },
                { "data": "employee_contribution" },
                { "data": "employer_contribution" },
                //{ "data": "created_date" },
                { "data": "max_amount" },
                { "data": "pf_fixed" },
                { "data": "pf_fixedamount" },
                { "data": "PF_id" }
            ],
            ordering: false,
            buttons: [

            ],
            initComplete: function (settings, json) {
                var footer = $("#pfmastertable tfoot tr");
                $("#pfmastertable thead").append(footer);
            },
            "columnDefs": [
                {
                    "targets": 1,
                    "render": function (data, type, row) {
                        if (row.pf_calculationon === 0) {
                            data = 'Basic';
                        } else if (row.pf_calculationon === 1) {
                            data = 'Gross';
                        } else {
                            data = '';
                        }
                        return data;
                    }
                },
                {
                    "targets": 5,
                    "render": function (data, type, row) {
                        if (row.pf_fixed === true) {
                            data = 'Yes';
                        } else if (row.pf_fixed === false) {
                            data = 'No';
                        } else {
                            data = '';
                        }
                        return data;
                    }
                },
                {
                    "targets": 7,
                    "render": function (data, type, row) {
                        data = '<a class="btn btn-xs tooltips edit_clm_btn" id="edit_column_data" title="Edit"><i class="fa fa-pencil"></i></a>';
                        return data;
                    }
                }
            ],
        });
        // Apply the Search
        $("#pfmastertable thead").on("keyup", "input", function () {
            strcturetable.column($(this).parent().index())
                .search(this.value)
                .draw();
        });
        //Click the modal of create pf
        $("#create_pf").on('click', function () {
            frmclear();
            $("#create_pf").attr("data-toggle", "modal");
            $("#create_pf").attr("data-target", "#create_newpf");
            $("#create_pf").show();

            //fillStructure();
            //Max Amount Textbox Validation
            $("#max_amount").on("input", function () {
                var inputValue = $(this).val();
                // Remove any non-numeric characters using a regular expression
                var numericValue = inputValue.replace(/[^0-9]/g, '');
                $(this).val(numericValue);
            });
            $("#max_amount").keypress(function (event) {
                // Check if the input consists only of 0's
                var inputValue = $(this).val();
                if (/^0+$/.test(inputValue)) {
                    $("#max_amount").val('');
                }
            });

            //Employee Contribution Textbox Validation
            $("#employee_contribution").on("input", function () {
                var inputValue = $(this).val();
                var numericValue = inputValue.replace(/[^0-9]/g, '');
                $(this).val(numericValue);
            });
            $("#employee_contribution").keypress(function (event) {
                // Check if the input consists only of 0's
                var inputValue = $(this).val();
                if (/^0+$/.test(inputValue)) {
                    $("#employee_contribution").val('');
                }
            });

            //Employer Contribution Textbox Validation
            $("#employer_contribution").on("input", function () {
                var inputValue = $(this).val();
                var numericValue = inputValue.replace(/[^0-9]/g, '');
                $(this).val(numericValue);
            });
            $("#employer_contribution").keypress(function (event) {
                // Check if the input consists only of 0's
                var inputValue = $(this).val();
                if (/^0+$/.test(inputValue)) {
                    $("#employer_contribution").val('');
                }
            });



        });

    });
    function frmclear() {
        $("#PF_id").val(0);
        $("#pfstructure_name").val("");
        $("#pfcalculationOn").val("");
        $("#employee_contribution").val("");
        $("#employer_contribution").val("");
        $("#max_amount").val();
        $("#pfCheckbox").val();
        $("#pfTextbox").val();
    }

    function checkSession() {

        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
