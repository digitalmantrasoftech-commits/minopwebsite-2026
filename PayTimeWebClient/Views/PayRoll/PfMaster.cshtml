<div class="portlet">
    <div id="ajax_loader" class="modal_bg loading" aria-hidden="true" style="display:none">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" />
    </div>
    <div class="portlet-body">
