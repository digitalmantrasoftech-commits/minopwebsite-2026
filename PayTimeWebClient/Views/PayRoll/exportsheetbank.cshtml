                            if (response.success == true) {
                                toastr.remove();
                                toastr.success(response.message);
                                getSheetlist();
                            } else if (response.success == false && response.responseCode == 203) {
                                toastr.remove();
                                toastr.error(response.message);
                            } else if (response.success == false) {
                                toastr.remove();
                                toastr.error(response.message);
                            }
                        },
                        complete: function () {
                            $("#ajax_loader").hide();
                        }
                    });
                }
            });
        });


        function saleryslip(id, fileName) {
            var apiUrl = '@_webapiurlpayroll' + 'ExportSheet/download/excel?id=' + id;
            var xhr = new XMLHttpRequest();
            xhr.open('GET', apiUrl);
            xhr.setRequestHeader('Authorization', '@_tokan');
            xhr.responseType = 'blob';
            xhr.onload = function () {
                if (xhr.status === 200) {
                    var url = URL.createObjectURL(xhr.response);
                    var link = document.createElement('a');
                    link.href = url;
                    link.target = '_blank';
                    link.download = fileName || 'download.xlsx';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                } else {
                    console.error('Error:', xhr.status);
                    toastr.remove();
                    toastr.error('Error occurred while downloading the file.');
                }
            };
            xhr.send();
        }

        function downloadBlobAsExcel(blobData, fileName) {
            const blobURL = URL.createObjectURL(blobData);

            const link = document.createElement('a');
            link.href = blobURL;
            link.target = '_blank';
            link.download = fileName;

            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            URL.revokeObjectURL(blobURL);
        }

        function resetCheckboxes() {
            
            $('input[type="checkbox"]').each(function () {
                $(this).prop('checked', false);
                ensureChecked("input[type='checkbox'][value='Payout']");
                ensureChecked("input[type='checkbox'][value='BankAccountNumber']");
                ensureChecked("input[type='checkbox'][value='EmployeeCode']");
                ensureChecked("input[type='checkbox'][value='EmployeeName']");
            });
        }
        function getSheetlist() {
            //get sheet data
            $(".exportsheet_main").empty();
            checkSession();
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'ExportSheet/GetExportSheetLog',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    if (response != null && response.length > 0) {
                        for (var i = 0; i < response.length; i++) {
                            var str = '<div class="exportsheet_logs_block"><div class="row"><div class="col-md-6 col-sm-10 col-xs-12 exportsheet_logs"><div>' + response[i]["Log Date"] + '</div><div class="excel_export"><img src="/assets/images/exl_download.svg"> ' + response[i].Title + ' </div></div><div class="col-md-6 col-sm-2 col-xs-12 text-right"><a href="javascript:;"><img src="/assets/images/download_logs.svg" class="d_logs" alt="Download Logs" onclick="saleryslip(' + response[i].export_sheet_log_id + ', \'' + response[i].Title + '\')"></a></div></div></div>';
                            $(".exportsheet_main").append(str);
                        }
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }

        function checkSession() {

            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                },
                error: function (data) {
                    window.location.href = data;
                }
            });
        }

    </script>

