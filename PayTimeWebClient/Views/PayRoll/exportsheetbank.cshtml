                    //$("input[type='checkbox'][value='Payout']").prop("checked", true);
                    //$("input[type='checkbox'][value='BankAccountNumber']").prop("checked", true);
                    //$("input[type='checkbox'][value='EmployeeCode']").prop("checked", true);
                    //$("input[type='checkbox'][value='EmployeeName']").prop("checked", true);

                    //$("input[type='checkbox'][value='Payout'],[value='BankAccountNumber'],[value='EmployeeCode'],[value='EmployeeName']").on("change", function () {
                        
                    //    if (!$(this).prop("checked")) {
                    //        $(this).prop("checked", true);
                    //    }
                    //});

                    //$("input[type='checkbox'][value='SelectAll']").on("change", function () {
                    //    
                    //    var checkboxes =
                    //        $(this).closest(".col-md-3.col-sm-4.col-xs-6")
                    //        .siblings()
                    //        .find("input[type='checkbox']:not([value='Payout']):not([value='BankAccountNumber']):not([value='EmployeeCode']):not([value='EmployeeName'])");
                    //    checkboxes.prop("checked", this.checked);
