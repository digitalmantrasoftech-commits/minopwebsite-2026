        function resetWorkflow() {
            $("#WorkflowId").val('0');
            document.getElementById("WorkflowId").disabled = false;
        }
        function disableWorkflow() {
            $("#WorkflowId").val("0").trigger('change');
            document.getElementById("WorkflowId").disabled = true;
        }
        function enableWorkflow() {
            document.getElementById("WorkflowId").disabled = false;
            $("#WorkflowId").val("0").trigger('change');
        }
        function fillWorkflow() { //In use
            $.ajax({
                type: "GET",
                url: '@_webapiurlpayroll' + "SalaryIncrementWorkFlowDetails/getsalaryincrementworkflowlist",
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                dataType: "json",

                success: function (data) {
                    $("#WorkflowId").empty();
                    var option = '';
                    option = "<option value='0'> Select Workflow </option>"
                    //data.sort(function (a, b) {
                    //    return a.WorkFlowName.localeCompare(b.WorkFlowName);
                    //});
                    if (data != null && data.length > 0 ) {

                        for (var i = 0; i < data.length; i++) {

                            option += "<option value='" + data[i].WorkFlowId + "'> " + data[i].WorkFlowName + "</option>";

                        }
                    }
                    $("#WorkflowId").append(option);
                    //$Workflowselect.multiselect('rebuild');
                },
                error: function (xhr, ajaxOptions, thrownError) {

                    if (xhr.status == 404) { //NotFound = 404
                        toastr.error(thrownError);
                    } else if (xhr.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (xhr.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (xhr.status == 419) {
                        window.location.href = "/PayTime/LoginPage";
                    } else {
                        toastr.error(thrownError);
                    }
                }
            });
        }

        function frmclear() {
            // Reset select dropdowns
            $('#CompanyID option').prop('selected', false);
            $('#CompanyID').multiselect('refresh');

            $('#BranchIds option').prop('selected', false);
            $('#BranchIds').multiselect('refresh');

            $("#DeptIds").val(0).trigger('change');
            $("#DesignationId").val(0).trigger('change');
            $("#financialYearDropdown").val(0).trigger('change');
            $("#IncrementCycle").val(1).trigger('change');
            $("#IncrementMode").val(1).trigger('change');
            $("#isclearance").val(0).trigger('change');
            $("#WorkflowId").val(0).trigger('change');

            // Clear input fields
            $("#EffectiveDate").val('');
            $("#PolicyName").val('');
            $("#IncrementValue").val('');
            $("#InstallmentMonth").val('');
            resetFileInput();
        }

        //Reset the inputfile
        function resetFileInput() {
            var $fileInput = $('.fileinput');
            $fileInput.removeClass('fileinput-exists').addClass('fileinput-new');
            $fileInput.find('.fileinput-filename').text('');
            $('#FileUpload').val('');
        }


        $('input[name="rb"]').change(function () {
            var selectedValue = $(this).val();
            if (selectedValue === "true") {
                enableWorkflow();
            } else if (selectedValue === "false") {
                disableWorkflow();
            }
        });

        $('input[name="rb2"]').change(function () {
            var selectedValue = $(this).val();
            if (selectedValue === "true") {
                $("#isArrearsTypediv").show();
                $('#ArrearsTypes').val('1').trigger('change');
            } else if (selectedValue === "false") {
                $("#isArrearsTypediv").hide();
                $("#ArrearsTypes").val('');
                $('#InstallmentMonthdiv').hide();
                $("#InstallmentMonth").val('');
            }
        });


        $('#ArrearsTypes').on('change', function () {
            var selectedValues = $(this).val(); // Returns array of selected values
            // Check if "2" (Multiple) is selected
            if (selectedValues && selectedValues.includes("2")) {
                $('#InstallmentMonthdiv').show();
            } else {
                $('#InstallmentMonthdiv').hide();
                $("#InstallmentMonth").val('');
            }
        });

    });
</script>

