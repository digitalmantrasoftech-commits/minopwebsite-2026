                                        render: function (data, type, full) {

                                            var val = full?.isAppRequired;

                                            if (val == 1) {
                                                return "Yes"
                                            }
                                            else if (val == 0) {
                                                return "No"
                                            }
                                            else {
                                                return "";
                                            }
                                        }
                                    },


                                    {
                                        targets: 4,
                                        render: function (data, type, full) {
                                            let cycle = parseInt(full.incrementcycle);
                                            if (cycle == 1) {
                                                return "Yearly";
                                            } else if (cycle == 2) {
                                                return "Half Yearly";
                                            } else {
                                                return "";
                                            }
                                        }
                                    },

                                    {
                                        targets: 5,
                                        render: function (data, type, full) {
                                            let Arrears = full.IsArrearsRequire;
                                            if (Arrears == true) {
                                                return "Yes"
                                            }
                                            else if (Arrears == false) {
                                                return "No"
                                            }
                                            else {
                                                return "";
                                            }
                                        }
                                    },

                                    //{
                                    //    "targets": 5,
                                    //    data: "empcount",
                                    //    title: "No Of Employees(s)",
                                    //    render: function (data, type, full) {
                                    //        debugger;
                                    //        return full.empcount;
                                    //    }
                                    //},

                                        {
                                            "targets": 7,
                                            "render": function (data, type, full) {
                                                return '<span class="Financial_year">' + full.Financial_year + '</span>';

                                            }
                                        },
                                        {
                                            "targets": 8,
                                            orderable:false,
                                            "render": function (data, type, full) {
                                                if (full.empcount == 0) {
                                                    return '<span class="_Batchid" hidden="">' + full.policyid + '</span> <span></span><a style="display:none" class="Activeclass btn blue_btnnew tooltips" data-placement="left" title="Active"><i class="fa-solid fa-check"></i></a><a class="Inactiveclass btn blue_btnnew tooltips" data-placement="left" title="Delete"><i class="fa-solid fa-xmark"></i></a> <a class="previewclass btn seagreen_btnnew tooltips viewpolicyreqtimeline" data-placement="left" data-original-title="View Policy Request"><i class="fa-regular fa-info-circle"></i></a> ';
                                                } else {
                                                    return '<a class="eyeclass btn blue_btnnew tooltips eye_btn" data-placement="left" title="View" > <span class="_Batchid" hidden="">' + full.policyid + '</span> <i class="fa-regular fa-eye"> </i>  </a> <span hidden class="_PolicyStatus">' + full.policyapprovalstatus + '</span><a style="display:none" class="Activeclass btn blue_btnnew tooltips" data-placement="left" title="Delete"><i class="fa-solid fa-check"></i></a><a class="previewclass btn seagreen_btnnew tooltips viewpolicyreqtimeline" data-placement="left" data-original-title="View Policy Request"><i class="fa-regular fa-info-circle"></i></a>';
                                                }
                                            }
                                        }
                                ],
                                "lengthMenu": [
