        function getPolicyStatusValue(status) {
            switch (status) {
                case "Pending":
                    return 2;
                    break;
                case "Revise":
                    return 3;
                    break;
                case "Approved":
                    return 4;
                    break;
                case "Rejected":
                    return 5;
                    break;
                case "Hold":
                    return 6;
                    break;
                case "Applied":
                    return 7;
                    break;
                default:
                    return -1;
                    break;
            }
        }


