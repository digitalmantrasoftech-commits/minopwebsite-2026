@using System.Configuration;
@{
    ViewBag.Title = "AdvanceSalaryPolicy";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurlpayroll = ConfigurationManager.AppSettings["webapipaytimePayroll"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
}

<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">

<script>
    $(document).ready(function () {
        $("#AddStrfrmbtn").on('click', function () {
            $("#filtercolumn_block").toggle();
            $("#main_bock").toggle();
            $("#AddStrfrmbtn").hide();
            $("#BackStrbtn").show();
        });

        $("#BackStrbtn").on('click', function () {

            $("#filtercolumn_block").hide();
            $("#main_bock").show();
            $("#BackStrbtn").hide();
            $("#AddStrfrmbtn").show();

        });
        GetPolicy();
          function GetPolicy() {
              $.ajax({
              type: "GET",
              headers: { 'Authorization': '@_tokan' },
              url: '@_webapiurlpayroll' + 'AdvanceSalaryPolicy/GetAdvanceSalaryPolicy',
              contentType: "application/json",
              dataType: "json",
              beforeSend: function () {
                  $('#ajax_loader').show();
              },
              complete: function () {
                  $('#ajax_loader').hide();
              },
                  success: function (response) {
                      if (response.length === 0) {
                          $("#request-empty").show();
                          $("#tableResponsive").hide();
                          $("#dataTables_tbl_header").hide();
                      }

                 if (response && response.length > 0) {
                      // Destroy old instance if already initialized
                     if ($.fn.DataTable.isDataTable("#tbladvancesalarypolicy")) {
                         $("#tbladvancesalarypolicy").DataTable().clear().destroy();
                      }

                     // DataTable initialisation
                     var table = $("#tbladvancesalarypolicy").DataTable({
                         dom: _domCommon,
                         language: _languageCommon,
                         data: response,
                         columns: [
                             { data: 'policy_name' },
                             { data: 'min_service_months' },
                             { data: 'advance_range' },
                             { data: 'advance_type' },
                             { data: 'advance_value' },
                             {
                                 data: 'is_active',
                                 render: function (data, type, row) {
                                     if (data === true || data === 1) {
                                         return '<span class="green_font  fw-bold">Active</span>';
                                     } else {
                                         return '<span class="red_font  fw-bold">InActive</span>';
                                     }
                                 }
                             },
                             {
                                 data: null,
                                 orderable: false,
                                 render: function (data, type, row) {
                                     if (row.is_active) {
                                         return `<a href="javascript:;" class="btn red_btnnew action tooltips data-id="${row.policy_id}" data-placement="left" data-original-title="InActive"><i class="fa-solid fa-xmark "></i></a>`
                                     } else {
                                         return `<a href="javascript:;" class="btn green_btnnew action tooltips data-id="${row.policy_id}" data-placement="left" data-original-title="Active"><i class="fa-solid fa-check "></i></a>`
                                     }
                                 }
                             }
                             ],
                          "columnDefs": [         
                             ],
                               initComplete: function (settings, json) {
                                    const visibleTable = $('table:visible').attr('id');
                                    $("#buttons").append(`
                                    <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                                        <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                                    </div>`)
                                }

                     });
                     setTimeout(function () {
                         $("#" + "tbladvancesalarypolicy" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                         $('.tooltips').tooltip();
                     }, 100);
                  }
                  }
              })
          }

        $("#btnSubmit").on('click', function () {
            if ($("#PolicyName").val() == "") {
                toastr.remove();
                toastr.error("Please Enter PolicyName");
                return false;
            } else {
                toastr.remove();
            }
            if ($("#MinServiceMonths").val() == "") {
                toastr.remove();
                toastr.error("Please Enter Minimum Service Months");
                return false;
            } else {
                toastr.remove();
            }
            if ($("#PolicyValidUpto").val() == "") {
                toastr.remove();
                toastr.error("Please Enter Valid Date");
                return false;
            } else {
                toastr.remove();
            }
            if ($("#minAdvancevalue").val() == "") {
                toastr.remove();
                toastr.error("Please Enter Min Advance Value");
                return false;
            } else {
                toastr.remove();
            }
            if ($("#maxAdvancevalue").val() == "") {
                toastr.remove();
                toastr.error("Please Enter Max Advance Value");
                return false;
            } else {
                toastr.remove();
            }

            var formData = new FormData();
            var requestObj = {
                "PolicyName": $("#PolicyName").val(),
                "MinServiceMonths": $("#MinServiceMonths").val(),
                "minAdvanceValue": $("#minAdvancevalue").val(),
                "maxAdvanceValue": $("#maxAdvancevalue").val(),
                "AdvanceType": $("#advanceType").val(),
                "AdvanceValue": $("#advanceValue").val(),
                "EndDate": $("#PolicyValidUpto").val()
            }
            for (var key in requestObj) {
                formData.append(key, requestObj[key]);
            }

            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'AdvanceSalaryPolicy/CreateAdvanceSalaryPolicy',
                processData: false,
                contentType: false,
                dataType: 'json',
                data: formData,
                beforeSend: function () {
                    $('#ajax_loader').show();
                },
                complete: function () {
                    $('#ajax_loader').hide();
                },
                success: function (response) {
                    if (response != null) {
                        if (response.Success == true) {
                            toastr.remove();
                            toastr.success(response.Message);
                            $("#Back_btn").hide();
                            setTimeout(function () {
                                window.location.reload();
                            }, 2500);
                        } else {
                            $('#ajax_loader').hide();
                            toastr.remove();
                            toastr.error(response.Message);
                        }
                    } else {
                        $('#ajax_loader').hide();
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Failed to fetch data: ", error);
                }
            });
            

        })
        $("#tbladvancesalarypolicy").on('click', ".action", function () {
            let table = $('#tbladvancesalarypolicy').DataTable();
            let currentRow = $(this).closest('tr');
            let rowData = table.row(currentRow).data();
            const id = rowData.policy_id;
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurlpayroll' + 'AdvanceSalaryPolicy/AdvanceSalaryPolicyEnable/Disable?Id=' + id,
                    processData: false,
                    contentType: false,
                    dataType: 'json',
                    beforeSend: function () {
                        $('#ajax_loader').show();
                    },
                    complete: function () {
                        $('#ajax_loader').hide();
                    },
                    success: function (response) {
                        if (response != null) {
                            if (response.Success == true) {
                                toastr.remove();
                                toastr.success(response.Message);
                                $("#Back_btn").hide();
                                setTimeout(function () {
                                    window.location.reload();
                                }, 2500);
                            } else {
                                $('#ajax_loader').hide();
                                toastr.remove();
                                toastr.error(response.Message);
                            }
                        } else {
                            $('#ajax_loader').hide();
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Failed to fetch data: ", error);
                    }
                });
            })
    })

</script>

