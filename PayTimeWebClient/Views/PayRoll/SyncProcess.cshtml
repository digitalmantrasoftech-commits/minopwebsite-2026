    //});
    ////////////////---------LOP Process Bind Calll and All Validation are Code here----------30/09/2021------//
    function getPayrollProcessEmp(_firstDay, _lastDay, _allData) {
        $("#tblPayrollProcess").destroy;
        $("#tblPayrollProcess").empty();
        if (_firstDay == "" || _firstDay == undefined || _allData == undefined) {
            _allData = "1";
            _firstDay = "";
            _lastDay = "";
        }
        checkSession();
        $.ajax({
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + "Payroll/GetgreythrEmppayrollprocess?Fromdate=" + _firstDay + "&Todate=" + _lastDay + "&AllData=" + _allData + "",
            contentType: "application/json; charset=utf-8",
            async: "false",
            dataType: "json",
            success: function (response) {
                var table = "";
                if (response != null && response.length > 0) {
                    for (var i = 0; i < response.length; i++) {
                        var tbl = "<tr class='odd gradeX'>";
                        tbl = tbl + "<td id=''><input type='checkbox' onchange='checkLOPProcess(this)' class='ClsChkLOPEmp' id='" + response[i].Empcode + "'/>";
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='eid hidden'>" + response[i].EmpId;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='enm'>" + response[i].EmpName;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='enmcode'>" + response[i].Empcode;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='epid'>" + response[i].greythrEmpID;                        
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='eLOP'>" + response[i].LOP;
                        tbl = tbl + "</td>";
                        tbl = tbl + "</tr>";
                        table += tbl;
                    }
                }
                $("#tblPayrollProcess").destroy;
                $('#tblPayrollProcess').append(table);
                $('#tblPayrollProcess').dataTable({

                    "columnDefs": [
                           {
                               "targets": [1],
                               "visible": false,
                               "searchable": false,
                           }
                    ],
                    "destroy": true,
                    "bInfo": false,
                    "bPaginate": true,
                    "bLengthChange": false,
                    "columns": [
                         { "title": "<input type='checkbox' class='ClsChkAllLOP' onchange='AllCheckedLOPEmp(this)' />" },
                         { "title": "Employee ID" },
                         { "title": "Employee Name" },
                         { "title": "Employee Code" },
                         { "title": "GreythrEmpID" },
                         { "title": "LOP" },
                    ]
                });
            }
        });
    }
    $("#Payroll_Process").click(function () {
        if ($("#Select_month").val() == "0") {
            toastr.remove();
            toastr.error("Please select month.");
            return false;
        }

        if ($("#Select_year").val() == "") {
            toastr.remove();
            toastr.error("Please select year.");
            return false;
        }
        objCorrection = [];
        $("#tblPayrollProcess .ClsChkLOPEmp").each(function () {
            if ($(this).is(':checked') == true) {
                var _EMPName = $(this).parent('td').parent('tr').children(1)[1].innerText;
                var _EMPCode = $(this).parent('td').parent('tr').children(1)[2].innerText;
                var _GrayTHRID = $(this).parent('td').parent('tr').children(1)[3].innerText;
                var _LOP = $(this).parent('td').parent('tr').children(1)[4].innerText;

                var date = new Date();
                var _firstDay = $("#Select_year").val() + "-" + $("#Select_month").val() + "-01"
                var last_Day = new Date($("#Select_year").val(), $("#Select_month").val(), 0).getDate();
                var _lastDay = $("#Select_year").val() + "-" + $("#Select_month").val() + "-" + last_Day;
                var obj = {
                    EMPName: _EMPName,
                    EMPCode: _EMPCode,
                    greythrEmpID: _GrayTHRID,
                    LOP: _LOP,
                    Fromdate: _firstDay,
                    Todate: _lastDay,
                    AllData: ""
                };
                objCorrection.push(obj);
            }
        });
        if (objCorrection.length == 0) {
            event.preventDefault();
            toastr.remove();
            toastr.error("Please select employee for LOP process.");
            return false;
        }
        $(".loading").show();
        checkSession();
        $.ajax({
            type: "POST",
            dataType: 'json',
            url: "/Payroll/Getpayroll?objcorrection=" + JSON.stringify(objCorrection),
            contentType: "application/json; charset=utf-8",
            processData: false

        }).done(function (data) {
            $(".loading").hide();
            if (data.ad == "ok") {
                toastr.remove();                
                toastr.success('Employee payroll process success.');
                ClearLOP();
            }
            else {
                toastr.remove();
                toastr.success(data.ad);
                ClearLOP();

            }
        }).fail(function (xhr, status, errorThrown) {
            $(".loading").hide();
            toastr.remove();
            ClearLOP();
            toastr.error('Employee payroll process failed.');
        })
    });

    function ClearLOP() {
        $(".ClsChkAllLOP").prop('checked', false);
        $(".ClsChkLOPEmp").prop('checked', false);
    }

    $("#btnLOPDetail").click(function () {
        count++;
        operation = "LOP Details";
        $("#Search_LOPprocess").css("display", "block");
        $("#Search_SyncPprocess").css("display", "none");
    });

    $("#Select_month").change(function () {
        var date = new Date();
        _firstDay = $("#Select_year").val() + "-" + $("#Select_month").val() + "-01"
        last_Day = new Date($("#Select_year").val(), $("#Select_month").val(), 0).getDate();
        _lastDay = $("#Select_year").val() + "-" + $("#Select_month").val() + "-" + last_Day;
        _allData = "";
        getPayrollProcessEmp(_firstDay, _lastDay, _allData);
    });

    $("#Select_year").change(function () {
        var date = new Date();
        _firstDay = $("#Select_year").val() + "-" + $("#Select_month").val() + "-01"
        last_Day = new Date($("#Select_year").val(), $("#Select_month").val(), 0).getDate();
        _lastDay = $("#Select_year").val() + "-" + $("#Select_month").val() + "-" + last_Day;
        _allData = "";
        getPayrollProcessEmp(_firstDay, _lastDay, _allData);
    });
    window.onload = function () {
        timeSpentOnPage();
    }
    $(window).on("beforeunload", function () {
        if (operation == "" || operation == null || operation == '') {
            operation = "View  Payroll";
        }
        var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
        var timeSpent = timeSpentOnPage();
        analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
    })

</script>