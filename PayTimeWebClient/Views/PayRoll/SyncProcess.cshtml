<script type="text/javascript">
    var count = 0;
    var form ="Payroll";
    var operation = "";
    $(document).ready(function () {
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        getUnSyncEmp();
        getPayrollProcessEmp();
        function getGreythrselect() {
            checkSession();
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + 'Payroll/Greythrselect?Cmpcode=' + cmpcode,
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                dataType: "json",
                success: function (response) {
                    if (response != null && response.length > 0) {
                        for (var i = 0; i < response.length; i++) {                            
                            $("#Companycode").val(cmpcode),
                            $("#greythrtoken").val(response[i].greythrtoken),
                            $("#greythrurl").val(response[i].greythrurl),
                            $("#greythrdomain").val(response[i].greythrdomain),
                            $("#greythrapi").val(response[i].greythrapi)
                        }
                    }
                }
            });
        }
        $("#btnSave").click(function () {
            count++;
            operation = "Sync Process";
            $("#Search_LOPprocess").css("display", "none");
            $("#Search_SyncPprocess").css("display", "block");
            save();
        });
        function getUnSyncEmp() {
            $("#tblunSyncProcess").destroy;
            $("#tblunSyncProcess").empty();
            checkSession();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + 'Payroll/GetpayrollgreythrEmpIDlst',
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                dataType: "json",
                success: function (response) {
                    var table = "";
                    if (response != null && response.length > 0) {
                        for (var i = 0; i < response.length; i++) {
                            var tbl = "<tr class='odd gradeX'>";
                            tbl = tbl + "<td id='EmployeeID'><input type='checkbox' onchange='checkedDept(this)' class='ClsChkEmp' id='" + response[i].Empcode + "'/>";
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td id='eid' hidden>" + response[i].EmpId;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td id='ecode'>" + response[i].Empcode;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td id='enm'>" + response[i].EmpName;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td id='epid'>" + response[i].IsActive;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td id='egrayhrreason'>" + response[i].Graytyhrreason;
                            tbl = tbl + "</td>";
                            tbl = tbl + "</tr>";
                            table += tbl;
                        }
                    }
                    $("#tblunSyncProcess").destroy;
                    $('#tblunSyncProcess').append(table);
                    $('#tblunSyncProcess').dataTable({

                        "columnDefs": [
                               {
                                   "targets": [1,4],
                                   "visible": false,
                                   "searchable": false,
                               }
                        ],
                        "destroy": true,
                        "bInfo": false,
                        "bPaginate": true,
                        "bLengthChange": false,
                        "columns": [
                             { "title": "<input type='checkbox' class='ClsChkAllDept' onchange='AllCheckedEmp(this)' />" },
                             { "title": "Employee ID" },
                             { "title": "EmpCode" },
                             { "title": "Employee Name" },
                             { "title": "Status" },
                             { "title": "GraytHrResponse" }

                        ]
                    });
                }
            });
        }
        function save() {
            if (valid()) {
                var allVals = [];
                $("#tblunSyncProcess .ClsChkEmp").each(function () {
                    if ($(this).is(':checked') == true) {
                        allVals.push($(this).attr("id"));
                    }
                });
                var obj = {
                    "EmployeeId": JSON.stringify(allVals)
                };
                checkSession();
                $.ajax({
                    type: "POST",
                    //url: "/Payroll/SyncProcess?obj=" + JSON.stringify(obj),
                    url: "/Payroll/SyncProcess?obj=" + JSON.stringify(obj) + "&Companycode=" + $("#Companycode").val() + "&greythrtoken=" + $("#greythrtoken").val() + "&greythrurl=" + $("#greythrurl").val() + "&greythrdomain=" + $("#greythrdomain").val() + "&greythrapi=" + $("#greythrapi").val(),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    async: "false",
                    beforeSend: function () {
                        $(".loading").hide();
                    },
                    success: function (response) {
                        if (response != null) {
                            if (response.ad == "OK") {
                                Clear();
                                toastr.success("SyncProcess saved successfully.");
                                window.setTimeout(function () {
                                    getUnSyncEmp();
                                }, 1000);
                            }
                            else {
                                Clear();
                                toastr.remove();
                                toastr.error("SyncProcess is failed on employee.");
                                //toastr.error("Failed on Employee SyncProcess.");
                                window.setTimeout(function () {
                                    getUnSyncEmp();
                                }, 1000);
                            }
                        }
                    },
                    error: function (response) {
                        $(".loading").hide();
                        toastr.remove();
                        toastr.error(response);
                    },
                });
            }
        }
    });
    function AllCheckedDept(ths) {
        $(".popMsg").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkDept").prop('checked', true);
        }
        else {
            $(".ClsChkDept").prop('checked', false);
        }
    }
    function AllCheckedEmp(ths) {
        $(".popMsg").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkEmp").prop('checked', true);
        }
        else {
            $(".ClsChkEmp").prop('checked', false);
        }
    }
    function checkedDept(ths) {
        $(".popMsg").hide();
    }
    function valid() {
        var allVals = [];
        $("#tblunSyncProcess .ClsChkEmp").each(function () {
            if ($(this).is(':checked') == true) {
                allVals.push($(this).attr("id"));
            }
        });
        if (allVals.length == 0) {
            toastr.remove();
            toastr.error("Please select employee.");
            return false;
        }
        return true;
    }
    function Clear() {
        $(".ClsChkAllDept").prop('checked', false);
        $(".ClsChkDept").prop('checked', false);
        $(".ClsChkEmp").prop('checked', false);
    }

    function checkSession() {

        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }

</script>

