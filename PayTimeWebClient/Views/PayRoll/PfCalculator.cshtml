                $("#pfblockid").show();
                $("#MonthlyCTC").val(0);
                $("#epfId").hide();
                $("#Ptid").hide();
                $("#esicId").hide();
                $("#isPfRadio").hide();
                $("#MonthlyCTC").blur(function () {
                    var valpt = $('input[name="PfEsicChoice"]:checked').val();
                    var monthlyctc = parseInt($("#MonthlyCTC").val());
                    if (monthlyctc != 0) {
