        var employeePF;
        var providentPF;
        var IsPfEsic = 0;

        //Vaidations of monthly ctc textbox
        $('.input-sm').keypress(function (e) {
            var charCode = (e.which) ? e.which : event.keyCode
            if (String.fromCharCode(charCode).match(/[^0-9]/g))
                return false;
        });

        //When PF is bydefault selected
