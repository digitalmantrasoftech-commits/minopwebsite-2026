                var valpf = $('input[name="PfEsicChoice"]:checked').val();
                var monthlyctc = parseInt($("#MonthlyCTC").val());
                var basicofmonthlyctc = (40 / 100) * monthlyctc;
                if (basicofmonthlyctc != 0) {
                    if (basicofmonthlyctc < 15000) {
                        if (valpf == '1') {
                            checkSession();
                            $.ajax({
                                type: "GET",
                                headers: { 'Authorization': '@_tokan' },
                                url: '@_webapiurlpayroll' + 'Payroll/IsPFApplicable/' + monthlyctc + "/" + IsPfEsic,
                                contentType: "application/json; charset=utf-8",
                                dataType: "json",
                                beforeSend: function () {
                                    $("#ajax_loader").show();
                                },
                                success: function (response) {
                                    var basicofmonthlyctc = response.basicofmonthlyctc;
                                    if (response.basicofmonthlyctc < 15000) {
                                        $("#isPfRadio").hide();
                                        $("#epfId").show();
                                        $("#employeePF").val(response.employeePF);
                                        $("#providentPF").val(response.providentPF);
                                    }                                   
