                                    url: '@_webapiurlpayroll' + 'Payroll/IsPFApplicable/' + monthlyctc + "/" + IsPfEsic,
                                    contentType: "application/json; charset=utf-8",
                                    dataType: "json",
                                    beforeSend: function () {
                                        $("#ajax_loader").show();
                                    },
                                    success: function (response) {
                                        var monthlyctc = response.monthlyctc;
                                        if (response.monthlyctc >= 12000) {
                                            $("#isPfRadio").hide();
                                            $("#epfId").hide();
                                            $("#Ptid").show();
                                            $("#professionaltax").val(response.professionaltax);
                                        }
                                    },
                                    complete: function () {
                                        $("#ajax_loader").hide();
                                    }
                                });
                            }
                        }
                        else if (monthlyctc < 12000) {
                            if (valpt == 3) {
                                checkSession();
                                $.ajax({
                                    type: "GET",
                                    headers: { 'Authorization': '@_tokan' },
                                    url: '@_webapiurlpayroll' + 'Payroll/IsPFApplicable/' + monthlyctc + "/" + IsPfEsic,
                                    contentType: "application/json; charset=utf-8",
                                    dataType: "json",
                                    beforeSend: function () {
