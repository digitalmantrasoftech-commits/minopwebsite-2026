                                var IsPfActual = false;
                                if (basicofmonthlyctc != 0) {
                                    if (basicofmonthlyctc > 15000) {
                                        checkSession();
                                        $.ajax({
                                            type: "GET",
                                            headers: { 'Authorization': '@_tokan' },
                                            url: '@_webapiurlpayroll' + 'Payroll/IsTotalPFApplicable/' + monthlyctc + "/" + IsPfFixed + "/" + IsPfActual,
                                            contentType: "application/json; charset=utf-8",
                                            dataType: "json",
                                            beforeSend: function () {
                                                $("#ajax_loader").show();
                                            },
                                            success: function (response) {
                                                var basicofmonthlyctc = response.basicofmonthlyctc;
                                                if (response.basicofmonthlyctc < 15000) {
                                                    $("#isPfRadio").hide();
                                                    $("#epfId").show();
                                                    $("#employeePF").val(response.employeePF);
                                                    $("#providentPF").val(response.providentPF);
