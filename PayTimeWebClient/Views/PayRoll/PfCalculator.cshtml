                                                    beforeSend: function () {
                                                        $("#ajax_loader").show();
                                                    },
                                                    success: function (response) {
                                                        if (response.basicofmonthlyctc < 15000) {
                                                            $("#epfId").show();
                                                            $("#employeePF").val(response.employeePF);
