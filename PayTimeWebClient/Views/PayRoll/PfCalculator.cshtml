    });

    function ConfirmDialog(message) {
        $('<div></div>').appendTo('body')
          .html('<div><h6>' + message + '?</h6></div>')
          .dialog({
              modal: true,
              title: 'PF Message',
              zIndex: 10000,
              autoOpen: true,
              width: 'auto',
              resizable: false,
              buttons: {

                  Yes: function () {
                      var confirmationResult = "Yes";
                      $(this).dialog("close");
                      $("#isPfRadio").show();
                  },
                  No: function () {
                      var confirmationResult = "No";
                      $("#isPfRadio").hide();
                      $(this).dialog("close");

                  }
              },
              close: function (event, ui) {
                  $(this).remove();
              }
          });
    }

    function checkSession() {

        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }


</script>

