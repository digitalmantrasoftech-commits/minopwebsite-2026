                            if (valpf == '1') {
                                ConfirmDialog("Basic of monthly ctc is greater than 15K. Do you want to deduct PF ?");
                                $("#epfId").hide();
                                $("#Ptid").hide();
                                $("#isPfRadio").hide();
                                $('input[name="IsPfchoice"]').change(function () {
                                    var selectedValue = $(this).val();
                                    if (selectedValue === "yes") {
                                        var IsPfFixed = true;
                                        var IsPfActual = false;
                                        if (basicofmonthlyctc != 0) {
                                            if (basicofmonthlyctc > 15000) {
                                                checkSession();
                                                $.ajax({
                                                    type: "GET",
