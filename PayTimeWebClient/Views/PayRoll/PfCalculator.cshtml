                                                    contentType: "application/json; charset=utf-8",
                                                    dataType: "json",
                                                    beforeSend: function () {
                                                        $("#ajax_loader").show();
                                                    },
                                                    success: function (response) {
                                                        var basicofmonthlyctc = response.basicofmonthlyctc;
                                                        if (response.basicofmonthlyctc < 15000) {
                                                            $("#isPfRadio").hide();
                                                            $("#epfId").show();
