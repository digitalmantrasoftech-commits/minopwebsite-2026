                    toastr.remove();
                    toastr.error("Please select company.");
                    $("#CompanyID").addClass('field_error');
                    event.preventDefault();
                    Isflag = 1;
                    return false;
                } else {
                    $("#CompanyID").removeClass('field_error');
                    Isflag = 0
                }
                if ($("#BranchIds").val() == "0" || $("#BranchIds").val() == null) {
                    toastr.remove();
                    toastr.error("Please select branch.");
                    $("#BranchIds").addClass('field_error');
                    event.preventDefault();
                    Isflag = 1;
                    return false;
                } else {
                    $("#BranchIds").removeClass('field_error');
                    Isflag = 0
                }
                if ($("#MonthIds").val() == "" || $("#MonthIds").val() == null) {
                    toastr.remove();
                    toastr.error("Please select month.");
                    $("#Month").addClass('field_error');
                    event.preventDefault();
                    Isflag = 1;
                    return false;
                } else {
                    $("#Month").removeClass('field_error');
                    Isflag = 0
                }
            }
