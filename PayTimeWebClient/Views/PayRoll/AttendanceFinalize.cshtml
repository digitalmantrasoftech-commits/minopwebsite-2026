                    type: "GET",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurl' + "Master/BranchGetAll",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {

                        var markup = '';
                        var companyIdsToFind = companyid; // Change '1,2,3' to the actual comma-separated CompanyIDs you want to find

                        if (companyid != null) {

                            var filteredData = data.filter(function (item) {
                                return companyid.includes(item.CompanyID.toString());
                            });

                            filteredData.sort(function (a, b) {
                                return a.branchname.localeCompare(b.branchname);
                            });
                            for (var x = 0; x < filteredData.length; x++) {
                                if (selectedBranch.length != 0) {
                                    var re = new RegExp("(^|,)" + filteredData[x].BranchId + "($|,)");
                                    if (re.test(selectedBranch) == true) {
                                        markup += '<option selected="selected" value="' + filteredData[x].BranchId + '" >' + filteredData[x].branchname + '</option>';
                                    }
                                    else {
                                        markup += "<option value=" + filteredData[x].BranchId + ">" + filteredData[x].branchname + "</option>";
                                    }
                                }
                                else {
                                    markup += "<option value=" + filteredData[x].BranchId + ">" + filteredData[x].branchname + "</option>";
                                }
                            }
                            $('#BranchIds').append(markup);
                            $Branchselect.multiselect('rebuild');
                            $(document.body).on('change', '#BranchIds', function () {
                                var branid = $('#BranchIds option:selected');
                                var BranchArray = [];
                                $(branid).each(function (index, branid) {
                                    BranchArray.push([$(this).val()]);
                                });
                                if (BranchArray == "") {
                                    $("#txt2").val(0);
                                }
                                else {
                                    $("#txt2").val(BranchArray);
                                }
                                var Arrbranch = $("#txt2").val();
                                BranchIdlst = Arrbranch;
                                $("#BranchId").val(BranchIdlst);
                                getEmp();
                            });
                        } else {
                            $Branchselect.multiselect('rebuild');
                        }
                    },
                    error: function (xhr, ajaxOptions, thrownError) {

                        if (xhr.status == 404) { //NotFound = 404
                            toastr.error(thrownError);
                        } else if (xhr.status == 500) { //InternalServerError = 500,
                            toastr.error("InternalServerError");
                        } else if (xhr.status == 400) { //BadRequest = 400,
                            toastr.error("BadRequest");
                        } else if (xhr.status == 419) {
                            window.location.href = "/PayTime/LoginPage";
                        } else {
                            toastr.error(thrownError);
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            }

