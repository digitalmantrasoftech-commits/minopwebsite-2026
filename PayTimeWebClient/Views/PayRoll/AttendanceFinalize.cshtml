            $('body').on('keydown', '.validateche', function (event) {
                // Get the key code of the pressed key
                var keyPressed = event.which;

                // Allow only numeric keys: 0-9, numpad 0-9, backspace, delete, arrow keys, and other navigation keys
                var isNumericKey = (keyPressed >= 48 && keyPressed <= 57) || // 0-9 (top row)
                        (keyPressed >= 96 && keyPressed <= 105) || // 0-9 (numpad)
                        (keyPressed === 8) || // Backspace
                        (keyPressed === 46) || // Delete
                        (keyPressed >= 37 && keyPressed <= 40) || // Arrow keys
                        (keyPressed === 9) || // Tab
                        (keyPressed === 13) || // Enter
                        (keyPressed === 190 || keyPressed == 110); // Period (.)

                // Prevent input if the key is not numeric
                if (!isNumericKey) {
                    event.preventDefault();
                }
            });
