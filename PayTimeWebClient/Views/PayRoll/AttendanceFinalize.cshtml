        function pointvalidation(inputValue) {
            if (inputValue.indexOf('.') !== -1 && parseFloat(inputValue.split('.')[1]) > 0) {
                var pattern = /\.5/;
                if (pattern.test(inputValue)) {
                    return true;
                } else {
