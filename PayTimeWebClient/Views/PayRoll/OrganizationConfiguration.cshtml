<script>
    function getAll() {
        checkSession();
        // DataTable initialisation
        var t = $("#OrganizationConfig").DataTable({

            dom: "<'row'<'col-lg-3 col-sm-5 col-xs-12'<'record_btn_main'l,><'dt-buttons'Bf>><'col-lg-9 col-sm-7 col-xs-12 mb_margin_bottom_15'<'selected_emp_main'<'tbl_text'>>>>" +
                  "<'row'<'col-sm-12 margin-bottom-10'<'customforms_table'tr'>>>" +
                  "<'row'<'col-md-5 col-sm-5'i><'col-md-7 col-sm-7'p>>",
            paging: true,
            searching: true,
            "processing": true,
            "ajax": {
                url: '@_webapiurlpayroll' + 'OrganizationConfiguration/GetSpecificColumnsFromOrganizationConfiguration',
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                //contentType: "application/json;charset=utf-8",
                dataSrc: '',
            },
            "columns": [
                { "data": null },
                { "data": "org_config_id" },
                { "data": "config_type" },
                { "data": "config_value" },
                { "data": "config_text_value" },
                { "data": "config_description" },
                {
                    "data": "is_active",
                    "render": function (data, type, row) {
                        return data ? "1" : "";
                    }
                }
               //org_config_id, config_type, config_value, config_text_value, config_description, is_active
            ],
            autoWidth: true,
            ordering: false,
            buttons: [

            ],
            "columnDefs": [
                   {
                       "targets": [1],
                       "visible": false
                   },
                   {
                       "targets": [7],
                       "render": function (data, type, row) {
                           if (true) {
                               data = '<a class="btn btn-xs tooltips edit_clm_btn" id="edit_column_data" title="Edit"><i class="fa-regular fa-pencil"></i></a>'; //<a class="btn btn-xs tooltips delete_clm_btn" title="Delete"><i class="fa-regular fa-trash-can-o"></i></a>
                           } else {
                               data = "";
                           }
                           return data;
                       }
                   }
            ],
        });
        t.on('order.dt search.dt', function () {
            t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();
    }

    function validateInput() {
        if ($("#Config_value").val() == '') {
            $("#Config_value").addClass('field_error');
            toastr.remove();
            toastr.error("Please enter config value!");
            return false;
        } else {
            $("#Config_value").removeClass('field_error');
        }

        if ($("#Config_description").val() == '') {
            $("#Config_description").addClass('field_error');
            toastr.remove();
            toastr.error("Please enter config description!");
            return false;
        } else {
            $("#Config_valueConfig_description").removeClass('field_error');
        }
    }

    $(document).ready(function () {
        getAll();

        $("#OrganizationConfig").on('click', '.edit_clm_btn', function () {
            var t = $("#OrganizationConfig").DataTable();
            
            var ORGColumnid = t.row($(this).parent('td').parent('tr')).data()["org_config_id"];
            var ConfigType = t.row($(this).parent('td').parent('tr')).data()["config_type"];
            var ConfigValue = t.row($(this).parent('td').parent('tr')).data()["config_value"];
            var ConfigTextValue = t.row($(this).parent('td').parent('tr')).data()["config_text_value"];
            var Configdescription = t.row($(this).parent('td').parent('tr')).data()["config_description"];
            var Activestatus = t.row($(this).parent('td').parent('tr')).data()["is_active"];


            $("#ORGColumn_id").val(ORGColumnid);
            $("#Config_Type").val(ConfigType);
            $("#Config_value").val(ConfigValue);
            
            $("#Config_Text_Value").val(ConfigTextValue);
            $("#Config_description").val(Configdescription);
            if (Activestatus == 1) {
                $("#Active_status").prop('checked', true);
                $('#Active_status').prop('disabled', true);  //Active_status disabled
            } else {
                $("#Active_status").prop('checked', false);
                $('#Active_status').prop('disabled', false);
            }
            
            
            
            $('#Config_Type').prop('disabled', true);       //Config type disabled
             

            $(".edit_clm_btn").attr("data-toggle", "modal");
            $(".edit_clm_btn").attr("data-target", "#create_newcolumn");
            $("#Edit_head").show();
            $("#Create_head").hide();

        });

        //Save Button Click
        $("#btnsave").on('click', function () {
            
            //org_config_id, config_type, config_value, config_text_value, config_description, is_active
            //Update
            validateInput();
            ConfigTextValue = $("#Config_Text_Value").val();
            if (ConfigTextValue == "") {
                ConfigTextValue = "ABC"
            }
            if ( $("#Active_status").prop('checked') ) {
                isActive1 = 1
            } 
            var obj = {
                columnorgid: parseInt($("#ORGColumn_id").val()),
                configvalue: parseInt($("#Config_value").val()),
                configtextvalue: ConfigTextValue,
                configdescription: $("#Config_description").val(),
                isactive: isActive1
            }
            checkSession();
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'OrganizationConfiguration/UpdatedyColumnsFromOrganizationConfiguration',
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    console.log(response);
                    if (response.success == true) {
                        toastr.remove();
                        toastr.success(response.message);
                        $('#OrganizationConfig').DataTable().ajax.reload();

                        //setTimeout(function () {
                        //    window.location.reload(true);
                        //}, 3000);
                        
                    }
                    if (response.success == false && response.responseCode == 210) {
                        toastr.remove();
                        toastr.error(response.message);
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });

        function checkSession() {

            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                },
                error: function (data) {
                    window.location.href = data;
                }
            });
        }

    }); //Document ends here

   
</script>

    


<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            @*<a href="/Dashboard/AdminDashboard"><i class="fa-regular fa-house"></i></a>*@
            <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
        </li>
        <li>
            <span><i class="fa-light fa-angle-right"></i> Organization Configuration</span>
        </li>
    </ul>
    <div class="page-toolbar">
        <div class="emp_btn_block">
            <div class="text-right">
                <a href="#" id="create_column" class="btn add_btn"><i class="fa-solid fa-plus"></i> Create New Column</a>
            </div>
        </div>
    </div>
</div>
 

<div class="portlet">
    <div id="ajax_loader" class="modal_bg loading" aria-hidden="true" style="display:none">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
    </div>
    <div class="portlet-body">
        <div class="row">
            <div class="payroll_details_table">
                <!-- Datatable : Begin -->
                <table id="OrganizationConfig" class="table table-striped table-bordered tbl_middle table-hover serch_datatable table-checkable order-column">
                    <thead>
                        <tr>
                            <th>SrNo.</th>
                            <th hidden>column_id</th>
                            <th style="min-width: 80px;">Config Type</th>
                            <th style="">Config_value</th>
                            <th style="">Config Text Value</th>
                            <th style="">Config description</th>
                            <th style="">Active Status</th>
                            <th style="">Action</th>
                            <!--org_config_id, config_type, config_value, config_text_value, config_description, is_active!-->

                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Create New Column Modal : Begin -->
        <div id="create_newcolumn" class="modal fade popup_info_model" role="dialog" data-keyboard="false" data-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">

                <!-- Modal content -->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title" id="Create_head">Create New Column</h4>
                        <h4 class="modal-title" id="Edit_head" style="display:none">Edit Columns</h4>
                    </div>
                    <div class="modal-body">
                        <div class="modal-card">
                            <fieldset>
                                <div class="row">
                                    <input class="form-control" id="ORGColumn_id" type="text" value="" placeholder="Enter Column Title" style="display:none">
                                    <div class="col-md-10 col-xs-12">
                                        <div class="form-group">
                                            <label class="control-label">Config Type <span class="required" aria-required="true"> * </span></label>
                                            <input class="form-control" id="Config_Type" type="text" value="" placeholder="Enter Config Type" maxlength="50">

                                        <label class="control-label">Config value <span class="required" aria-required="true"> * </span></label>
                                        <input class="form-control" id="Config_value" type="text" value="" placeholder="Config value" maxlength="50">

                                        <label class="control-label">Config Text Value </label>
                                        <input class="form-control" id="Config_Text_Value" type="text" value="" placeholder="Config Text Valu" maxlength="50">

                                        <label class="control-label">Config description <span class="required" aria-required="true"> * </span></label>
                                        <input class="form-control" id="Config_description" type="text" value="" placeholder="Enter Config description" maxlength="50">

                                        @*<label class="control-label">Active status <span class="required" aria-required="true"> * </span></label>
                                        <input class="form-control" id="Active_status" type="text" value="" placeholder="1" maxlength="50">*@
                                                     
                                    </div>
                                    <div class="col-md-4 col-xs-1">
                                        <label class="control-label">Active status</label>
                                        <input class="form-control" id="Active_status" type="checkbox">

                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                                <button type="button" class="btn save_btn" id="btnsave"> Save </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <!-- Create New Column Modal : End -->
    </div>
</div>
