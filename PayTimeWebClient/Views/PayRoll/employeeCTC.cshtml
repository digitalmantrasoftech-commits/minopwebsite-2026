        function tableget(Company, Branch, Department, designation) {
            $("#NotificationGrid-empty1").hide();
            checkSession();

            var obj = {
                "CompanyIds": Company.join(", "),
                "BranchIds": Branch.join(", "),
                "DepartmentId": Department.join(", "),
                "DesignationId": designation.join(", ")
            }

            // Destroy the DataTable instance if it exists before re-initializing
            if ($.fn.DataTable.isDataTable('#employee_ctc_table')) {
                $('#employee_ctc_table').DataTable().destroy();
            }

            // Make the AJAX request and populate the DataTable with the response
            $.ajax({
                headers: { 'Authorization': '@_tokan' },
                url: '/Payroll/GetAllEmployeePayrollCTCDetails',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(obj),
                dataType: "json",
                beforeSend: function () {
                    $('#ajax_loader').show();
                },
                complete: function () {
                    $('#ajax_loader').hide();
                    $("#fil_col_div").hide();
                },
                success: function (response) {
                    if (response.data.length == 0) {
                       const wrapper = $(".filter_portlet_wrapper");
                       wrapper.removeClass("full-width");
                    }
                    if (response != null) {
                        const ctc = response.data;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", ctc, {
                            imageUrl: "emptyscreen_3.png",
                            subText: "No matching records found for the selected filters."
                        });
                    }
                    //Removes import's error/succsess block
                    $('#tblImportErrorBody').empty();
                    $(".portleterrors").hide();
                    $(".payroll_details_table").css("display", "block");
                    //Clears file inputs
                    let fileInputGroup = $('.fileinput');
                    fileInputGroup.closest('.fileinput').find('input[type="file"]').val('');
                    fileInputGroup.find('.fileinput-filename').text('');
                    fileInputGroup.removeClass('fileinput-exists').addClass('fileinput-new');
                    // Initialize the DataTable with the data returned from the AJAX call
                    $("#dataTables_tbl_header").remove();
                    $('#employee_ctc_table').DataTable({
                        //dom: 'lBfrtip',
                        dom: _domCommon,
                        language: _languageCommon,
                        data: response.data, // Use the data from the AJAX response
                        //language: {
                        //    search: "Search",
                        //    searchPlaceholder: "Search..."
                        //},
                        order: [[3, 'desc']],
                        searching: true,
                        searchDelay: 500,
                        destroy: true, // Allows re-initialization
                        //buttons: [
                        //    "excelHtml5",
                        //    {
                        //        className: "buttons-columns btnColumnvisibility",
                        //    },
                        //],

                        buttons: [
                        {
                            extend: 'excelHtml5',
                            text: 'Excel',
                            titleAttr: 'Excel',
                            exportOptions: {
                                columns: ':visible:not(:last-child)'
                            }
                        },

                        ],
                        columns: [
                            { data: "emp_code" },
                            { data: "EmpPhoto" },
                            { data: "structure_name" },
                            {
                                data: "monthly_ctc",
                                render: function (data) {
                                    return "<div class='enc_ctc ctc' >" + data + "</div>";
                                }
                            },
                            { data: "emp_id" },
                            { data: "EmpName" }
                        ],
                        columnDefs: [
                            {
                                targets: [5],
                                visible: false
                            },
                            {
                                targets: [1],
                                render: function (data, type, full) {

                                    var nameParts = full.EmpName.replace(/\s+/g, ' ').trim().split(" ");
                                    var initials = nameParts[0].charAt(0).toUpperCase();
                                    if (nameParts.length > 1) {
                                        initials += nameParts[1].charAt(0).toUpperCase();
                                    }
                                    const colors = ["#e74c3c", "#8e44ad", "#3498db", "#16a085", "#f39c12", "#d35400", "#2c3e50"];
                                    //const randomColor = colors[Math.floor(Math.random() * colors.length)];
                                    const randomColor = "#295097";
                                    return `<div class="emp_box empbox_pending">
                                              <img alt="" class="user_img img-circle tooltips" data-placement="right" data-original-title="EmpCode: ${full.emp_code}" src="/UploadEmpPhoto/${full.EmpPhoto}" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"/>
                                              <span class=" tooltips"  data-placement="right" data-original-title="Empcode : ${full.emp_code}" style="display: none; min-width: 30px; height: 30px; line-height: 30px; text-align: center; background-color: #ecf3ff; color:  ${randomColor}; border-radius: 50% !important; border: 1px solid #8ab1f7; margin-right: 8px;">
                                              ${initials}</span><span><p class="emp_name">${full.EmpName}</p></span></div>`;
                                    //if (!full.EmpPhoto) {
                                    //    return "<div class='emp_box'>" +
                                    //           '<img src="/assets/images/avtar.png" alt="User icon" class="user_img">' +
                                    //           '<span><p class="emp_name">' + full.EmpName + '</p></span></div>';
                                    //} else {
                                    //    return "<div class='emp_box'>" +
                                    //           '<img src="/UploadEmpPhoto/' + full.EmpPhoto + '" alt="User icon" class="user_img">' +
                                    //           '<span><p class="emp_name">' + full.EmpName + '</p></span></div>';
                                    //}
                                }
                            },
                            {
                                targets: [4],
                                orderable:false,
                                render: function (data, type, full) {
                                    if ('@obj.CanEdit' === 'True') {
                                        if (full.monthly_ctc == 0.00) {
                                            return "<div class='dayswise_action blue_font'>Enter CTC</div>" +
                                                   "<div hidden class='emp_id'>" + full.emp_id + "</div>";
                                        } else {
                                            return "<div class='dayswise_action blue_font'>Update CTC</div>" +
                                                   "<div hidden class='emp_id'>" + full.emp_id + "</div>";
                                        }
                                    }
                                    return data;
                                }
                            }
                        ],
                        initComplete: function () {
                            const visibleTable = $('table:visible').attr('id');
                            $("#buttons").append(`
                                <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                                    <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                                </div>
                            `);
                        }
                    });
                    setTimeout(function () {
                        $("#" + "employee_ctc_table" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                        $('.tooltips').tooltip();
                    }, 100);

                },
                error: function (xhr, status, error) {
                    console.error("Failed to fetch data: ", error);
                }
            });
        }

        function empdetailview(_ctc, Empid, Actionname) {

            checkSession();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '/Payroll/EmployeeCTCEncrypt?EmployeeCTC=' + _ctc,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var _UpdateCTC = response.EncryptCTC;
                    $.ajax({
                        type: "GET",
                        headers: { 'Authorization': '@_tokan' },
                        url: '@_webapiurlpayroll' + 'EmployeeCTC/GetEmployeePayrollCalculationByCTC?ctcamount=' + _UpdateCTC + '&empid=' + Empid,
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        beforeSend: function () {
                            $("#ajax_loader").show();
                        },
                        success: function (response) {
                            $('input[name="Fixed"][id="Fixed_yes"]').prop('checked', false);
                            $('input[name="Fixed"][id="Fixed_no"]').prop('checked', false);
                            $('input[name="Fixed"][id="noRadio"]').prop('checked', false);
                            $('.dayswise_box').html("Employee : " + Empname);
                            $("#Take_home_salary_per_month").html(" 0/-");
                            if (response.Success == true && response.ResponseCode == 200 && response.resultData.isError == false) {
                                var structure_type = response.resultData.structure_type;
                                $(".add_grad").html(structure_type);
                                $("#Strcture_name").html("Payroll Structure : " + response.resultData.structure_name);
                                var payroll_type = response.resultData.calculation_type;
                                if (payroll_type == "daily") {
                                    $("#monthly_based").hide();
                                    $("#daily_based").show();
                                }
                                else {
                                    $("#monthly_based").show();
                                    $("#daily_based").hide();
                                }
                                var earnings = response.resultData.earnings;
                                var deductions = response.resultData.deductions;
                                var reimbursements = response.resultData.reimbursements;
                                var netMonthlySalary = response.resultData.netMonthlySalary;
                                var grossMonthlySalary = response.resultData.grossMonthlyEarning;
                                if (earnings.length > 0) {
                                    $("#ActualEarning").empty();
                                    var ActualEarning = "";
                                    for (var i = 0; i < earnings.length; i++) {
                                        ActualEarning += '<div class="row pay_earning_bg"><div class="col-xs-9"><div class="d-flex justify-content-between"><span class="pay_earning_title"> ' + earnings[i].head_name + '</span><span class="pay_earning_sub">' + earnings[i].strcalcbasedOn + '</span></div></div><div class="col-xs-3"><div class="pay_earning_amount">' + earnings[i].Amount + '</div></div></div>';
                                    }
                                    $("#ActualEarning").append(ActualEarning);
                                } else {
                                    $("#ActualEarning").empty();
                                }
                                if (deductions.length > 0) {
                                    $("#ActualDeduction").empty();
                                    var ActualDeduction = "";
                                    for (var i = 0; i < deductions.length; i++) {
                                        ActualDeduction += '<div class="row pay_earning_bg"><div class="col-xs-9"><div class="d-flex justify-content-between"><span class="pay_earning_title">' + deductions[i].head_name + '</span><span class="pay_earning_sub">' + deductions[i].strcalcbasedOn + '</span></div></div><div class="col-xs-3"><div class="pay_earning_amount">' + deductions[i].Amount + '</div></div></div>';
                                    }
                                    $("#ActualDeduction").append(ActualDeduction);
                                } else {
                                    $("#ActualDeduction").empty();
                                }
                                if (reimbursements.length > 0) {
                                    $("#ActualReimbursements").empty();
                                    var ActualReimbursements = "";
                                    for (var i = 0; i < reimbursements.length; i++) {
                                        ActualReimbursements += '<div class="row pay_earning_bg"><div class="col-xs-9"><div class="d-flex justify-content-between"><span class="pay_earning_title">' + reimbursements[i].head_name + '</span><span class="pay_earning_sub">' + reimbursements[i].strcalcbasedOn + '</span></div></div><div class="col-xs-3"><div class="pay_earning_amount">' + reimbursements[i].Amount + '</div></div></div>';
                                    }
                                    $("#ActualReimbursements").append(ActualReimbursements);
                                } else {
                                    $("#ActualReimbursements").empty();
                                }

                                isPayStructure_Pf_Applicable = response.resultData.isPayStructure_Pf_Applicable;
                                if (response.resultData.isPayStructure_Pf_Applicable == true) {
                                    $("#Provident_Fund_yes").show();
                                    if (response.resultData.isEmployee_Pf_Applicable == true) {
                                        //for employee pf is true
                                        if (response.resultData.is_Pf_Only_Actual == true) {
                                            $('input[name="Fixed"][id="Fixed_no"]').prop('checked', true);
                                            $("._Actual").show();
                                            $("._No").hide();
                                            $("._Fixed").hide();
                                            $("#Actual_pf").show();
                                            $("#Fixed_pf").hide();
                                        } else {

                                            if (response.resultData.IsEmployee_pf_Fixed == true) {
                                                $("._No").show();
                                                $("._Fixed").show();
                                                $("._Actual").show();
                                                $('input[name="Fixed"][id="Fixed_yes"]').prop('checked', true);
                                                $("#payStruct_Employee_PFFixedAmount").val(response.resultData.Emp_Employee_PFFixedAmount);
                                                $("#payStruct_Employer_PFFixedAmount").val(response.resultData.Emp_Employer_PFFixedAmount);
                                                $("#Actual_pf").hide();
                                                $("#Fixed_pf").show();
                                            }
                                            if (response.resultData.IsEmployeePFActual == true) {
                                                $("._No").show();
                                                $("._Fixed").show();
                                                $("._Actual").show();
                                                $('input[name="Fixed"][id="Fixed_no"]').prop('checked', true);
                                                $("#payStruct_Employee_PFActualPercent").val(response.resultData.Emp_Employee_PFActualPercent);
                                                $("#payStruct_Employer_PFActualPercent").val(response.resultData.Emp_Employer_PFActualPercent);
                                                $("#Actual_pf").show();
                                                $("#Fixed_pf").hide();
                                            }
                                            if (response.resultData.isEmp_PF_No == true) {
                                                $("._No").show();
                                                $("._Fixed").show();
                                                $("._Actual").show();
                                                $("#Actual_pf").hide();
                                                $("#Fixed_pf").hide();
                                                $('input[name="Fixed"][id="noRadio"]').prop('checked', true);
                                            }
                                        }
                                    } else {
                                        //for Pay structure pf is true
                                        $("#Provident_Fund_yes").show();
                                        if (response.resultData.is_Pf_Only_Actual == true) {
                                            $('input[name="Fixed"][id="Fixed_no"]').prop('checked', true);
                                            $("._Actual").show();
                                            $("._No").hide();
                                            $("._Fixed").hide();
                                            $("#Actual_pf").show();
                                            $("#Fixed_pf").hide();
                                        } else {

                                            if (response.resultData.IsPayStruct_PFFixed == true) {
                                                $("._No").show();
                                                $("._Fixed").show();
                                                $("._Actual").show();
                                                $('input[name="Fixed"][id="Fixed_yes"]').prop('checked', true);
                                                $("#payStruct_Employee_PFFixedAmount").val(response.resultData.PayStruct_Employee_PFFixedAmount);
                                                $("#payStruct_Employer_PFFixedAmount").val(response.resultData.PayStruct_Employer_PFFixedAmount);
                                                $("#Actual_pf").hide();
                                                $("#Fixed_pf").show();
                                            }
                                            if (response.resultData.IsPayStruct_PFActual == true) {
                                                $("._No").show();
                                                $("._Fixed").show();
                                                $("._Actual").show();
                                                $('input[name="Fixed"][id="Fixed_no"]').prop('checked', true);
                                                $("#payStruct_Employee_PFActualPercent").val(response.resultData.PayStruct_Employee_PFActualPercent);
                                                $("#payStruct_Employer_PFActualPercent").val(response.resultData.PayStruct_Employer_PFActualPercent);
                                                $("#Actual_pf").show();
                                                $("#Fixed_pf").hide();
                                            }
                                            if (response.resultData.isEmp_PF_No == true) {
                                                $("._No").show();
                                                $("._Fixed").show();
                                                $("._Actual").show();
                                                $("#Actual_pf").hide();
                                                $("#Fixed_pf").hide();
                                                $('input[name="Fixed"][id="noRadio"]').prop('checked', true);
                                            }
                                        }
                                    }
                                }
                                else {
                                    //$('input[name="pfyesno"][id="noRadio"]').prop('checked', true);
                                    $("#Provident_Fund_yes").hide();
                                }
                                $("#Take_home_salary_per_month").html(netMonthlySalary + " /-");
                                $("#Gross_monthly_salary").html(grossMonthlySalary + " /-");

                                if (response.resultData.isPFCalculateOnGross == true) {
                                    $(".pfCalOnGross").empty();
                                    $(".pfCalOnGross").append(" <b>Note:</b> Please enter the desired amount to view the real salary calculation, PF calculation is on gross amount");
                                }
                                else {
                                    $(".pfCalOnGross").empty();
                                    $(".pfCalOnGross").append("<b>Note:</b> Please enter the desired amount to view the real salary calculation.")

                                }

                                if (response.employeeBankDetail.length > 0) {
                                    $("#Bank_holder_name").val(response.employeeBankDetail[0]["bank_holder_name"]);
                                    $("#Bank_IFSC_Code").val(response.employeeBankDetail[0]["bank_ifsc_code"]);
                                    $("#Bank_account_number").val(response.employeeBankDetail[0]["bank_account_number"]);
                                    $("#Bank_branch_name").val(response.employeeBankDetail[0]["bank_branch_name"]);
                                    $("#Bank_city").val(response.employeeBankDetail[0]["bank_city"]);
                                    $("#ESIC_Number").val(response.employeeBankDetail[0]["esic_number"]);
                                    $("#Pan_number").val(response.employeeBankDetail[0]["pan_number"]);
                                    $("#PF_account_number").val(response.employeeBankDetail[0]["pf_account_number"]);
                                    $("#Uan_number").val(response.employeeBankDetail[0]["uan_number"]);
                                    empBankDetails = true
                                }
                                if (response.employeeBankDetail.length == 0) {
                                    empBankDetails = false
                                }




                            }
                            else if (response.resultData.isError == true) {
                                toastr.remove();
                                toastr.error(response.resultData.errorMessage);

                            }
                        },
                        complete: function () {
                            $("#ajax_loader").hide();
                        }

                    });
                }
            });

            if (Actionname == "Enter CTC" && _ctc == 0) {
                $("#FirstNext").hide();
                $("#FirstSave").show();
                $("#FirstSave").html("Save");

            }
            else if (Actionname == "Update CTC" && _ctc != 0) {
                $("#FirstNext").show();
                $("#FirstSave").html("Update");
                $("#FirstSave").show();

            }
        }

