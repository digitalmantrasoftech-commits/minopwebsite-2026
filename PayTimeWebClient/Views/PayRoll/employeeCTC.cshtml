            function updateSalaryUI() {  //Soumya
                var ctcStr = $("#Ctc_input").val().trim().replace(/,/g, "");
                var ctcamount = parseFloat(ctcStr);

                if (isNaN(ctcamount)) {
                    $("#Take_home_salary_per_month").text("Invalid CTC");
                    $("#Gross_monthly_salary").text("-");
                    return;
                }

                var isFixedPF = $('#Fixed_yes').is(':checked');
                var isActualPF = $('#Fixed_no').is(':checked');
                var isNoPF = $('#noRadio').is(':checked');

                var pfDeduction = 0;
                if (isFixedPF) {
                    pfDeduction = 1800;
                } else if (isActualPF) {
                    pfDeduction = ctcamount * 0.12;
                } else if (isNoPF) {
                    professionalTax = 200;
                }


                var professionalTax = 200;
                var totalDeduction = 1800 + pfDeduction + professionalTax;

                var takeHome = ctcamount - totalDeduction;
                if (takeHome < 0) takeHome = 0;

                var grossMonthlySalary = ctcamount - pfDeduction;

                $("#Take_home_salary_per_month").text(takeHome.toFixed(2));
                $("#Gross_monthly_salary").text(grossMonthlySalary.toFixed(2));
            }


