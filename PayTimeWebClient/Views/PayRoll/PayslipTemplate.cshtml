        $("#companylogo").on("change", function () {

            var filePath = $(this).val();
            var file = this.files[0];
            var allowedExtensions = /(\.jpg|\.jpeg|\.png|\.gif)$/i;

            if ((file.size) / (1024 * 1024) > 1) {
                toastr.remove();
                toastr.error("Image Size should not exceed more than 1 MB.");
                return false;
            }

            if (!allowedExtensions.exec(filePath)) {
                toastr.error('Please upload a file with extensions .jpeg/.jpg/.png only.');
                $(this).val('');
                $(".changeFile").hide();
                $("#clearlogo").hide();
                $('.fileinput-filename').text("");
                return false;
            }
            else {

                $(".selectFile").hide();
                $(".changeFile").show();
                $("#clearlogo").show();
                $('.fileinput-filename').text(file.name);
            }

        });

