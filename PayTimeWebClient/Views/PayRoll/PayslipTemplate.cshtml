        //Table Edite Button CLick event
        $("body").on("click", ".btnEditLogo", function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.removeClass("full-width");
            is_update = 1;
            var row = $(this).closest('tr')
            var logoID = parseInt(row.find('#logoID').val());
            var Base64file = row.find('#imageFile').attr('src').replace(/^data:image\/(png|jpg);base64,/, '');;
            var fileName = row.find(".logo_filename img").attr('src');


            //var altText = (row.find(".alt_text").text());
            //var headerText = (row.find('.header_text').text());
            var footerText = (row.find('.footer_text').text());
            var templateID = (row.find('.template_id').text());


            $("#LogoID").val(logoID);
            //$("#altTextImage").val(altText);
            //$("#headerText").val(headerText);
            $("#footerText").val(footerText);
            $("#template_select").val(templateID);



            //Getting Orgianal file name
            var fileNameWithoutGuid = fileName.substring(0, fileName.lastIndexOf('_')); // Removing last 36 characters before _
            var extension = fileName.substring(fileName.lastIndexOf('.')); // Get the file extension

            // Concatenate the filename without the GUID and the extension
            var finalFileName = fileNameWithoutGuid + extension;

            fileName = finalFileName;


            // Convert base64 to binary
            var binaryString = atob(Base64file);
            var byteArray = new Uint8Array(binaryString.length);
            for (var i = 0; i < binaryString.length; i++) {
                byteArray[i] = binaryString.charCodeAt(i);
            }

            // Create a Blob from the binary data
            var blob = new Blob([byteArray], { type: 'image/png' });

            // Create a File object from the Blob
            var file = new File([blob], fileName, { type: 'image/png' });
            $('.fileinput-filename').text(fileName);

            var fileList = new DataTransfer();
            fileList.items.add(file);
            $(".selectFile").hide();
            $(".changeFile").show();
            $("#clearlogo").show();

            $("#companylogo").prop('files', fileList.files);

        });

        //Active and Inactive code
        $("#companyLogotable").on("click", ".btnActive", function () {
            var row = $(this).closest('tr')
            var Id = parseInt(row.find('#logoID').val());
            checkSession();
            $.ajax({
                //thucdbs
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: "@_webapiurlpayroll" + 'PayslipTemplate/StatusUpdate?Id=' + Id + '&status=' + 1,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    if (response != "") {

                        if (response.success) {
                            toastr.remove();
                            toastr.success(response.message);
                            dataTableLogoBind();
                        }
                        else {
                            toastr.remove();
                            toastr.error(response.message);
                        }
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });


        });


        $("#companyLogotable").on("click", ".btnInactive", function () {
            var row = $(this).closest('tr')
            var Id = parseInt(row.find('#logoID').val());
            checkSession();
            $.ajax({
                //thucdbs
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: "@_webapiurlpayroll" + 'PayslipTemplate/StatusUpdate?Id=' + Id + '&status=' + 0,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    if (response != "") {

                        if (response.success) {
                            toastr.remove();
                            toastr.success(response.message);
                            dataTableLogoBind();
                        }
                        else {
                            toastr.remove();
                            toastr.error(response.message);
                        }
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            })

        });

        $('#clearlogo').click(function () {
            $('#companylogo').val('');
        });
        $('#btnClear').click(function () {
            is_update = 0;
            formclear();
            $(".selectFile").show();
            $(".changeFile").hide();
            $("#clearlogo").hide();

        });


        $('#btnSave').click(function () {

            if (is_update = 0) {
            }

            if ($('#companylogo').val() == "" || $('#companylogo').val() == null) {
                toastr.remove();
                toastr.error("Please select company logo to upload.");
                $('#companylogo').addClass('field_error');
                return false;
            }
            else {
                $('#companylogo').removeClass('field_error');
            }

            if ($('#template_select').val() == 0) {
                toastr.remove();
                toastr.error("Please select Template");
                $('#template_select').addClass('field_error');
                return false;
            }
            else {
                $('#template_select').removeClass('field_error');
            }

            var logoFile = $('#companylogo')[0].files[0];
            if ((logoFile.size) / (1024 * 1024) > 1) {
                toastr.remove();
                toastr.error("Image Size should not exceed more than 1 MB.");
                return false;
            }

            var logo_id = $("#LogoID").val();
            //var altText = $("#altTextImage").val();
            var headerText = $("#headerText").val();
            var footerText = $("#footerText").val();
            var templateID = $("#template_select").val();

            if (logo_id == "" || logo_id == undefined) {
                logo_id = 0;
            }

            if(templateID > 2){
                toastr.remove();
                toastr.error("Please select either Template 1 or Template 2.");
                return false;
            }

            var formData = new FormData();
            formData.append('file', logoFile);
            //console.log(typeof (formData));
            formData.append('Logo_id', logo_id);
            //formData.append('Alt_text', altText);
            formData.append('Header_text', headerText);
            formData.append('Footer_text', footerText);
            formData.append('Template_id', templateID);
            checkSession();
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: "@_webapiurlpayroll" + "PayslipTemplate/UploadLogoandDetails",
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    const wrapper = $(".filter_portlet_wrapper");
                    wrapper.addClass("full-width");
                    var screenWidth = $(window).width();
                    if (screenWidth >= 300 && screenWidth <= 600) {
                        $(".filter_portlet_tbl").show();
                    }
                    if (response.success) {
                        formclear();
                        $(".selectFile").show();
                        $(".changeFile").hide();
                        $("#clearlogo").hide();
                        dataTableLogoBind();
                        //$('#companyLogotable').DataTable().ajax.reload();
                        toastr.remove();
                        toastr.success(response.message);
                        //setTimeout(function () {
                        //    location.reload();
                        //}, 1000);

                    }
                    else {
                        toastr.remove();
                        toastr.error(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    toastr.remove();
                    toastr.error(response.message)
                }
            });
        });

        function checkSession() {

            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                },
                error: function (data) {
                    window.location.href = data;
                }
            });
        }

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

    });
</script>

