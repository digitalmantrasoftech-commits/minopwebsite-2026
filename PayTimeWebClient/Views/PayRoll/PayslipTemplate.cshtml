        function dataTableLogoBind() {

            if ($.fn.dataTable.isDataTable('#companyLogotable')) {
                $('#companyLogotable').DataTable().destroy();

            }
            $("#dataTables_tbl_header").remove();
            var logo_tbl = $('#companyLogotable').DataTable({
                dom: _domCommon,
                language: _languageCommon,
                paging: true, // Disable paging
                searching: true, // Disable searching
                "columnDefs": [
                    {
                        "targets": 6,
                        orderable: false
                    },
                    ]
            });
            setTimeout(function () {
                $("#" + "companyLogotable" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                $('.tooltips').tooltip();
            }, 100);
            checkSession();
            // Datatable call
            // checkSession();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'PayslipTemplate/GetCompanyLogo',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    if (response != null) {
                        const payslip = response;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", payslip, {
                            imageUrl: "emptyscreen_3.png",
                            subText: "No matching records found for the selected filters."
                        });
                    }
                    var emp_count = 0;
                    if (response.length > 0) {
                        // Clear existing table data
                        logo_tbl.clear();

                        // Add new rows to the table
                        for (var i = 0; i < response.length; i++) {

                            var tbl = "<tr>";

                            tbl = tbl + "<td hidden class=''><input type='text' id='logoID' value='" + response[i].logoID + "'/>";
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td hidden class='logo_filename'><img  height='50' src= '" + response[i].file_name + "' alt='Image' />";
                            tbl = tbl + "</td>";

                            if (response[i].Image == null || response[i].Image == "") { //Deafult logo if Image file not found
                                response[i].Image = "https://app.minopcloud.com/AssetsNew/images/logo.png"
                            }

                            tbl = tbl + "<td class='logo_image'><img height='30' id='imageFile' src= '" + response[i].Image + "' alt='Random Image' /><span hidden>" + i + "</span>";
                            tbl = tbl + "</td>";

                            //tbl = tbl + "<td class='alt_text'>" + response[i].alt_text;
                            //tbl = tbl + "</td>";

                            //tbl = tbl + "<td class='header_text'>" + response[i].header_text;
                            //tbl = tbl + "</td>";

                            tbl = tbl + "<td class='footer_text'>" + response[i].footer_text;
                            tbl = tbl + "</td>";

                            tbl = tbl + "<td class='template_id'>" + response[i].template_id;
                            tbl = tbl + "</td>";

                            if (response[i].is_active == true) {
                                tbl = tbl + "<td class='status'><span class='green_font'>Active</span></td>";
                                if ('@obj.CanEdit' == "True") {

                                    tbl = tbl + "<td> <button id='' class='btn seagreen_btnnew btnEditLogo tooltips' data-placement='top' data-original-title='Edit'><i class='fa-regular fa-pen-to-square'></i></button>"
                                    tbl = tbl + "<button id='' class='btn red_btnnew btnInactive tooltips' data-placement='top' data-original-title='Inactive' style='border-radius: 3px !important;'><i class='fa-solid fa-xmark'></i></button><span hidden>" + i + "</span>"
                                    tbl = tbl + "</td>";
                                }
                                else {
                                    tbl += "<td></td>";
                                }
                            }

                            else {
                                tbl = tbl + "<td class='status'><span class='red_font'>InActive</span></td>";
                                if ('@obj.CanEdit' == "True") {
                                    tbl = tbl + "<td> <button id='' class='btn seagreen_btnnew btnEditLogo tooltips' data-placement='top' data-original-title='Edit'><i class='fa-regular fa-pen-to-square'></i></button>"
                                    tbl = tbl + "<button id='' class='btn green_btnnew btnActive tooltips' data-placement='top' data-original-title='Active'><i class='fa-solid fa-check'></i></button><span hidden>" + i + "</span>"
                                    tbl = tbl + "</td>";
                                }
                                else {
                                    tbl += "<td></td>";
                                }
                            }


                            tbl = tbl + "</tr>";
                            logo_tbl.row.add($(tbl)).draw(false);
                            $('.tooltips').tooltip();
                        }

                    } else {
                        // Handle case when no data is returned
                    }
                },

                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }



        dataTableLogoBind();

        //Footter Test, header text validation
        $("#footerText").on("keypress", function (e) {
            var keycode = e.which;
            if (keycode == 45 || keycode == 46 || keycode == 58) { }
            else {
                if ((keycode >= 65 && keycode <= 90) || (keycode >= 48 && keycode <= 57) || (keycode >= 97 && keycode <= 122) || keycode == 46) { }
                else { e.preventDefault() }
            }
