                    <label class="control-label">Footer Text<span class="required" aria-required="true">  </span></label>
                    <div class="form-group">
                        <input type="text" class="form-control input-sm inp" pattern="" name="" id="footerText" placeholder="Enter Footer Text" maxlength="1000">
                    </div>
                </div>
                <div class="col-lg-12" id="template_drop">
                    <div class="form-group">
                        <label class="control-label">Template <span class="required" aria-required="true"> * </span></label>
                        <select id="template_select" class="form-control input-sm" data-width="100%">
                            <option value="0">Select Template</option>
                            <option value="1">Template 1</option>
                            <option value="2">Template 2</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="filterbox_footer">
                <div class="text-right">
                    @if (obj.CanAdd)
                    {
                        <button id="btnClear" class="btn clear_btn tooltips" data-placement="top" data-original-title="Clear all field"><i class="fa-regular fa-eraser"></i></button>
                        <button id="btnSave" class="btn icon_btn margin-left-5 tooltips" data-placement="top" data-original-title="Save Details"><i class="fa-light fa-floppy-disk"></i></button>
                    }
                </div>
            </div>
        </div>
        <!-- Filter Block : End -->
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}