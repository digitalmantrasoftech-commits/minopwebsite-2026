                    var startRange1 = $('<td class="calculate_td_120">').html('<div class="col-xs-12"><input type="text" class="form-control inpPT input-sm" pattern="[0-9]+" name="" value="' + "" + '" id="startRange' + (rowCount - 1) + '" placeholder="" maxlength="8"></div>');
                    var endRange1 = $('<td class="calculate_td_120">').html('<div class="col-xs-12"><input type="text" class="form-control inpPT input-sm" pattern="[0-9]+" name="" value="' + "" + '" id="endRange' + (rowCount - 1) + '" placeholder="" maxlength="8"></div>');
