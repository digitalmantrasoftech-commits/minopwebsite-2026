            //funcations for OT
            function timeToDecimal(timeString) {
                var parts = timeString.split(':');
                var hours = parseInt(parts[0], 10);
                var minutes = parseInt(parts[1], 10);

                // Convert minutes to fraction of an hour
                var fraction = minutes / 60;

                // Add fraction to hours
                var decimalTime = hours + fraction;

                return decimalTime;
            }

