                } else { $("#Location").removeClass('field_error'); }

                for (var i = 0; i < rowCount - 1; i++) {

                    var startRangeNum = parseInt($("#startRange" + i).val());
                    var endRangeNum = parseInt($("#endRange" + i).val());
                    var DeductionAmountNum = parseInt($("#taxAmount" + i).val());

                    //1St Checks Start Range
                    if (!(startRangeNum > 0)) {
                        toastr.remove();
                        $("#startRange" + i).val("").focus().addClass('field_error');
                        toastr.error("Start range must be greater than zero.");
                        validationFlag = 1;
                        return false;
                    }
                    else {
                        $("#startRange" + i).removeClass('field_error');
                    }

                    //2nd Check End range
                    if (!(endRangeNum > startRangeNum)) {
                        $("#endRange" + i).val("").focus().addClass('field_error');
                        toastr.remove();
                        toastr.error("End range must be greater than start range!");
                        validationFlag = 1;
                        return false;
                    }
                    else {
                        $("#endRange" + i).removeClass('field_error');
                    }

                    //3rd Checks Deducation amount must be less range and end range
                    if (!(DeductionAmountNum < endRangeNum)) {

                        $("#taxAmount" + i).val("").focus().addClass('field_error');
                        if (i > 1) {
                            $("#endRange" + (i)).removeClass('field_green');
                        }


                        toastr.remove();
                        toastr.error("Monthly tax amount must be less than end range.");
                        validationFlag = 1;
                        return false;
                    }
                    else {
                        $("#taxAmount" + i).removeClass('field_error');
                    }

                    //Multipal-tax slabs Validation for endrange and start range
                    if (i > 0) {
                        if (parseInt($("#startRange" + (i)).val()) === (parseInt($("#endRange" + (i - 1)).val()) + 1)) {
                            validationFlag = 0;
                            $("#startRange" + (i)).removeClass('field_error');
                            $("#endRange" + (i - 1)).removeClass('field_green');
                            $("#endRange" + (i - 1)).removeClass('field_error');
