            function dataTableOtbind(otModeid) {
                frmclear();
                $("#overtimeruletable tbody").empty();
                var overtimerule_tbl = $('#overtimeruletable').DataTable();
                overtimerule_tbl.destroy();
                var obj = {
                    "otModeId": otModeid,
                }
                var table = "";

                //Datatable call
                $.ajax({
                    type: "post",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurlpayroll' + 'OvertimeTemplate/GetOTtemplateByOtTypeAndOtMode',
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify(obj),
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response) {

                        var response = JSON.parse(response.overtimeTemplates);
                        $("#overtimeruletable tbody").empty();
                        $("#overtimeruletable thead tr:eq(1)").remove();


                        if (response != null && response.length > 0) {
                            for (var i = 0; i < response.length; i++) {
