            //Inpute blur
            $("body").on('blur', '.inp', function () {

                var inputValue = $(this).val();
                var parentTr = $(this).closest('tr');
                var secondDropdown = parentTr.find('.drp2').val();
                var decimalRegex = /^\d*\.?\d+$/; numericRegex = /^[0-9]+$/;

                if (inputValue.indexOf('0') == 0) {
                    if (inputValue >= 1) {
                        $(this).val(inputValue.slice(1));
                    }
                }

                if (numericRegex.test(inputValue) || decimalRegex.test(inputValue)) {
                    if (secondDropdown == 2) {
                        if (inputValue == 0) {
                            parentTr.find('.drp2').val(2);
                            //toastr.error("Flat amount value can't be 0");
                            //$(this).val('');
                            $(this).val(0);
                        }

                    } else {
                        if (parseInt(inputValue) > 100 || parseFloat(inputValue) > 100) {
                            toastr.remove();
                            toastr.error("Please enter value between 0 to 100")
                            $(this).val("");
                        } else {
                            if (parseFloat(inputValue) == 0) {
                                parentTr.find('.drp2').val(2);
                            }
                            if (parseFloat(inputValue) < 0) {
                                toastr.remove();
                                toastr.error("Please enter value between 0 to 100")
                                $(this).val("");
                            }
                        }
                    }
                } else {
                    if (inputValue == '') {

                    }
                    else {
                        toastr.remove();
                        toastr.error("Enter only number")
                        $(this).val("");
                    }
                }
            });

