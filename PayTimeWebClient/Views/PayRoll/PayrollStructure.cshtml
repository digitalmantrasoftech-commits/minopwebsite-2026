        function clickviewmore(id, thi) {
            $('#view_Data').modal('toggle');
            var row = $(thi).closest('tr');
            var title = row.find('.Head_name').text();
            $("#view_Head").html(title);
            checkSession();
            $.ajax({
                type: "Get",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'Organization/GetHeadConfigurationDetailsById?id=' + id + '&structure_id=' + G_structure_id,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {

                    if (id != 11) {
                        var columns = [];
                        columnNames = Object.keys(response.HeadConfiguration[0]);
                        var _CheckcolumnNames = Object.keys(response.HeadConfiguration[0]);
                        for (var i in columnNames) {
                            columns.push({
                                data: columnNames[i],
                                title: response.HeadConfiguration[0][columnNames[i]]
                            });
                        }

                        $("#view_Data_table tbody").empty();
                        $("#view_Data_table thead").remove();
                        var table = '';
                        if (columns.length > 0) {
                            for (var i = 0; i < columns.length ; i++) {
                                var tbl = "<tr>";
                                if (columns[i].data == "Basic number of days" && columns[i].title == 0) {
                                    break;
                                }
                                tbl = tbl + "<td style='min-width: 70px;'>" + columns[i].data;
                                tbl = tbl + "</td>";
                                tbl = tbl + "<td>" + columns[i].title;
                                tbl = tbl + "</td>";
                                tbl = tbl + "</tr>";
                                table += tbl;
                            }
                        }
                    } else {
                        $("#view_Data_table thead").remove();
                        $("#view_Data_table tbody").empty();
                        $("#view_Data_table ").append("<thead><tr><th>Name</th><th>Start Range</th><th>End Range</th><th>Deduction Amount</th></tr></thead>");

                        if (response.HeadConfiguration.length > 0) {
                            for (var i = 0; i < response.HeadConfiguration.length; i++) {
                                var tbl = "<tr>";
                                tbl = tbl + "<td>" + response.HeadConfiguration[i].Location;
                                tbl = tbl + "</td>";
                                tbl = tbl + "<td>" + response.HeadConfiguration[i]["Start Range"];
                                tbl = tbl + "</td>";
                                tbl = tbl + "<td>" + response.HeadConfiguration[i]["End Range"];
                                tbl = tbl + "</td>";
                                tbl = tbl + "<td>" + response.HeadConfiguration[i]["Deduction Amount"];
                                tbl = tbl + "</td>";
                                tbl = tbl + "</tr>";
                                table += tbl;
                            }
                        }
                    }
                    if (response.Note == "") {
                        $("#note_div").hide();
                    } else {
                        $("#note_div").show();
                        $("#note_div").html(response.Note);
                    }

                    $("#view_Data_table tbody").append(table);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }
        function ComplatePaystr(objid, status) {
            checkSession();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'PayStructure/CompletePayStructure?id=' + objid + "&status=" + status,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    if (response.success == true) {
                        toastr.remove();
                        if (status == 4) {
                            if (_Update == 0) {
                                toastr.remove();
                                toastr.success("Successfully created new pay stracture. You can assgin Employees");
                            } else {
                                toastr.remove();
                                toastr.success("Successfully updated pay stracture. You can assgin Employees");
                            }
                            $('#strcturetable').DataTable().ajax.reload();
                            setTimeout(function () {
                                $("#ajax_loader").hide();
                                window.location.reload();
                            }, 2000);
                        }
                    }
                    else {
                        toastr.remove();
                        toastr.error(response.message);
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }


