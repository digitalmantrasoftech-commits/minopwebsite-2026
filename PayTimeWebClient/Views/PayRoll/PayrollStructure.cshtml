            //AJAX request to download the Excel file format.
            $("#downloadButton").click(function () {

                var apiUrl = '@_webapiurlpayroll' + 'PayStructure/downloadSampleExcel';
                var xhr = new XMLHttpRequest();
                xhr.open('GET', apiUrl);
                xhr.setRequestHeader('Authorization', '@_tokan');
                xhr.responseType = 'blob';
                xhr.onload = function () {
                    if (xhr.status === 200) {
                        var url = URL.createObjectURL(xhr.response);
                        var link = document.createElement('a');
                        link.href = url;
                        link.target = '_blank';
                        link.download = 'SampleImport.xlsx';
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    } else {
                        console.error('Error:', xhr.status);
                        toastr.remove();
                        toastr.error('Error occurred while downloading the file.');
                    }
                };
                xhr.send();

            });
            $(document).on('click', '#closedatten', function () {

                $('#dataTables_tbl_header').remove();
            });
            $("#closeModel").on('click', function () {
                $(".dataTables_filter").removeClass("active");
            })

            //Import the file
            $("#btnImport").click(function () {
                if (document.getElementById("FileUpload").files.length == 0) {
                    toastr.remove();
                    toastr.error("Please upload file.");
                    event.preventDefault();
                    return false;
                } else {
                    $("#ajax_loader").show();
                }
            });
            $("#FileUpload").change(function () {
                if ($("#FileUpload").val() != null) {
                    var validExts = new Array(".xlsx", ".xls", ".csv");
                    var fileExt = $("#FileUpload").val();
                    if (fileExt != "") {
                        fileExt = fileExt.substring(fileExt.lastIndexOf('.'));
                        if (validExts.indexOf(fileExt) < 0) {
                            toastr.remove();
                            toastr.error("Invalid file selected, valid files are of " + validExts.toString() + " types.");
                            $("#FileUpload").val("");
                            return false;
                        }
                    }
                }
            });

            $("#btnImport").click(function () {

                var fileInput = $("#FileUpload")[0].files[0];
                if (fileInput) {
                    var formData = new FormData();
                    formData.append('file', fileInput);
                    checkSession();
                    $.ajax({
                        headers: { 'Authorization': '@_tokan' },
                        url: '@_webapiurlpayroll' + 'PayStructure/UploadFile',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        beforeSend: function () {
                            $("#ajax_loader").show();
                        },
                        success: function (data) {

                            if (data.success && data.isValid) {
                                toastr.remove();
                                toastr.success(data.msg);
                                setTimeout(function () {
                                    window.location.reload();
                                }, 1000);
                            }
                            else if (data.success && !data.isValid) {
                                toastr.remove();
                                if (data.msg == null || data.msg == "") {
                                    toastr.error(data.error);
                                } else {
                                    toastr.error(data.msg);
                                }

                            }
                            else {
                                toastr.remove();
                                if (data.error != null) {
                                    toastr.error(data.error);
                                }
                            }
                            // Clear existing rows in the table body
                            $('#tblImportErrorBody').empty();

                            // Populate the table body with data from the AJAX call
                            if (data.failPayStructureDataList && data.failPayStructureDataList.length > 0) {
                                $.each(data.failPayStructureDataList, function (index, item) {
                                    var row = $('<tr class="odd gradeX">');
                                    row.append($('<td>').text(index + 1));
                                    row.append($('<td>').text(item.empCode));
                                    row.append($('<td>').text(item.reason));
                                    $('#tblImportErrorBody').append(row);
                                });
                                $(".paystructure_details_table").hide();
                                $(".portleterrors").show()
                            }
                            else {
                                $(".paystructure_details_table").show();
                                $(".portleterrors").hide()
                            }
                            console.log('File uploaded successfully:', data);
                        },
                        error: function (error) {
                            toastr.remove();
                            toastr.error('File upload failed');
                            //console.error('File upload failed:', error);
                            $("#ajax_loader").hide();
                        },
                        complete: function () {
                            $("#ajax_loader").hide();
                        }
                    });
                } else {
                    $("#ajax_loader").hide();
                    console.error('Please select a file to upload');
                }
            });

