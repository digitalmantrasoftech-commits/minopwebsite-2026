                // Get the key code of the pressed key
                var keyCode = e.keyCode || e.which;
                var key = e.key;
                var noSpecialChar = validateKeyPress(e.which);

                if (keyCode == 8 || keyCode == 110) {
                    noSpecialChar = !noSpecialChar;
                }
                if ((key >= '0' && key <= '9')) {
                    return;
                }
                if (keyCode == 16 || noSpecialChar) {
                    return false;
                }

                if ((keyCode >= 65 && keyCode <= 90) || (keyCode >= 97 && keyCode <= 109) || (keyCode >= 111 && keyCode <= 122) || (keyCode >= 219 && keyCode <= 222)) {
                    e.preventDefault();
                }

                if ((keyCode >= 186 && keyCode <= 189) || (keyCode == 191) || (keyCode == 192)) {
                    e.preventDefault();
                }
            });
