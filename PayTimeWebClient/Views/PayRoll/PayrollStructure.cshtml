            //Active Labour Welfare Fund Template
            $('body').on('click', '.activate_grd_pf', function () {
                checkSession();
                $.ajax({
                    type: "GET",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurlpayroll' + 'Payroll/pfactiveinactive?id=' + pf_id + "&Status=1",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function (response) {
                        if (response.success == true) {
                            toastr.remove();
                            toastr.success("PF Status activated successfully");
                            pfdatatablebind();
                        } else {
                            toastr.remove();
                            toastr.error(response.message);
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            });

            //Inactive PF Template
            $('body').on('click', '.inactivate_grd_pf', function (e) {
                checkSession();
                var row = $(this).closest('tr');
                var pfID = row.find('.PF_id').val();
                var isCurrentchekedpf = $("#pfdatatablecheckbox" + pfID).prop('checked');
                if (isCurrentchekedpf) {
                    toastr.remove();
                    toastr.error("Can not inactive selected provident fund.");
                } else {
                    $.ajax({
                        type: "GET",
                        headers: { 'Authorization': '@_tokan' },
                        url: '@_webapiurlpayroll' + 'Payroll/pfactiveinactive?id=' + pf_id + "&Status=0",
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        beforeSend: function () {
                            $("#ajax_loader").show();
                        },
                        success: function (response) {
                            if (response.success == true) {
                                toastr.remove();
                                toastr.success("PF Status inactivated successfully");
                                pfdatatablebind();
                            } else {
                                toastr.remove();
                                toastr.error(response.message);
                            }
                        },
