@{
    ViewBag.Title = "PaySlipView";
    Layout = "~/Views/Shared/_LayoutLandingAPI.cshtml";
}

@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "PaySlip View";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _webapiurlpayroll = ConfigurationManager.AppSettings["webapipaytimePayroll"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _PlanId = HttpContext.Current.Session["planId"].ToString();

}
<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">

<script>
    payslipviewtable = "";
    var t = true;
    $(document).ready(function () {
        t = $("#PaySlipLog").DataTable({
            dom: "<'row'<'col-lg-3 col-sm-5 col-xs-12'<'record_btn_main'l,><'dt-buttons'Bf>><'col-lg-9 col-sm-7 col-xs-12 mb_margin_bottom_15'<'selected_emp_main'<'tbl_text'>>>>" +
             "<'row'<'col-sm-12 margin-bottom-10'<'customforms_table'tr'>>>" +
             "<'row'<'col-md-5 col-sm-5'i><'col-md-7 col-sm-7'p>>",
            paging: true,
            searching: true,
            "processing": true,

            "ajax": {
                url: '@_webapiurlpayroll' + 'PayslipLog/GetPaySlipLog',
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                dataSrc: '',
            },
            // pay_slip_email_log_id, email, from_email, to_email, Is_sent
            "columns": [

                { "data": "pay_slip_email_log_id", },
                { "data": "email" },
                { "data": "from_email" },
                { "data": "to_email" },

                {
                    "data": "Is_sent",
                    "render": function (data, type, row) {
                        return data ? 'true' : 'false';
                    }
                },
                {
                    "data": "email_content",
                    "render": function (data, type, row) {
                        return data ? 'Click Here <a class="btn btn-xs tooltips Payslipview" id="EmailData" title="Edit"><i class="fa-regular fa-eye"></i></a>' : 'No Data Here'

                    }
                }

            ],
            initComplete: function (settings, json) {
                var footer = $("#PaySlipLog tfoot tr");
                $("#PaySlipLog thead").append(footer);
                //$('#PaySlipLog th:eq(0)').hide();
                //$('#PaySlipLog td:eq(0)').hide();
            },
            autoWidth: true,
            ordering: false,
            buttons: [
            ],
            "columnDefs": [
                {
                    "targets": [0],
                    "visible": true,
                    searchable: false
                },
            ]


        });

        $("#PaySlipLog tfoot th").each(function () {
            
            var title = $(this).text();
            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
            $('#PaySlipLog tfoot th:eq(0)').hide();
        });



        // Apply the Search
        $("#PaySlipLog thead").on("keyup", "input", function () {
            
            t.column($(this).parent().index())
                .search(this.value)
                .draw();
        });

        //$(".PayslipCancel").css('display', 'none');
        //View PaySlip Click
        //$("body").on('click', '.Payslipview', function () {
        //    var t = $("#PaySlipLog").DataTable();
        //    var CurrentId = t.row($(this).parent('td').parent('tr')).data()["pay_slip_email_log_id"];
        //    var CurrentData = t.row($(this).parent('td').parent('tr')).data()["email_content"];
        //    $("#DataDisplay").html(CurrentData);
        //    $(".PayslipCancel").css('display', 'block');

        //});

        $("body").on('click', '.Payslipview', function () {
            var t = $("#PaySlipLog").DataTable();
            var CurrentId = t.row($(this).parent('td').parent('tr')).data()["pay_slip_email_log_id"];
            var CurrentData = t.row($(this).parent('td').parent('tr')).data()["email_content"];
            $("#popup").show();
            // Add HTML content to the popupData div
            $("#popupData").html(CurrentData);
        });


        //View Cancel
        $(".close").click(function () {
            $("#popup").hide();
            $("#popupData").html(CurrentData);
        });

    }); //Document Ends Here

</script>

<style type="text/css">
    .dataTables_wrapper .dataTables_filter {
        display: none !important;
    }

    .dataTables_wrapper {
        padding: 0px 0 0px 0;
    }

    .buttons-columns {
        display: none !important;
    }

    .payroll_details_table {
        display: block;
    }
    /*popup CSS*/
    .popup {
        display: none;
        position: fixed;
        z-index: 9999;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .popup-content {
        background-color: #fefefe;
        margin: 5% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 900px;
    }

    .close {
        color: black;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

        .close:hover,
        .close:focus {
            color: #ff0000;
            text-decoration: none;
            cursor: pointer;
        }
</style>

