                            <!--pay_slip_email_log_id, email, from_email, to_email, Is_sent -->
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>PaySlip Logid</th>
                            <th>Email</th>
                            <th>From Email</th>
                            <th>To Email</th>
                            <th>IsSent</th>
