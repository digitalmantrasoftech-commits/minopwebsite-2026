            function ExcelNameFormat(selectedText) {

                const match = selectedText.match(/\(([^)]+)\)/);
                if (match) {
                    const shortName = match[1];
                    sessionStorage.setItem("StatusValue", shortName);
                }

                var MonthYear = $("#MonthIds").val();
                const date = new Date(MonthYear);
                const month = date.toLocaleString('default', { month: 'long' });
                const year = date.getFullYear();
                const formattedMontyear = `${month}${year}`;
                sessionStorage.setItem("MonthYear", formattedMontyear);
                sessionStorage.setItem("CheckFastrackdb", '0');
            }

