        function downloadBlobAsExcel(blobData, fileName) {
            const blobURL = URL.createObjectURL(blobData);

            const link = document.createElement('a');
            link.href = blobURL;
            link.target = '_blank';
            link.download = fileName;

            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            URL.revokeObjectURL(blobURL);
        }
        function saleryslip(id, fileName) {
            var apiUrl = '@_webapiurlpayroll' + 'ExportSheet/download/excel?id=' + id;
            var xhr = new XMLHttpRequest();
            xhr.open('GET', apiUrl);
            xhr.setRequestHeader('Authorization', '@_tokan');
            xhr.responseType = 'blob';
            xhr.onload = function () {
                if (xhr.status === 200) {
                    var url = URL.createObjectURL(xhr.response);
                    var link = document.createElement('a');
                    link.href = url;
                    link.target = '_blank';
                    link.download = fileName || 'download.xlsx';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                } else {
                    console.error('Error:', xhr.status);
                    toastr.remove();
                    toastr.error('Error occurred while downloading the file.');
                }
            };
            xhr.send();
        }

        function checkSession() {

            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                },
                error: function (data) {
                    window.location.href = data;
                }
            });
        }
