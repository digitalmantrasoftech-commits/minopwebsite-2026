        function GetDashBoardDetailsSummary(status) {
            if (status == null || status == "") {
                status = $("#Status_filter").val()
            }
            var obj = {
                "month": $("#MonthIds").val().split('-')[1],
                "year": $("#MonthIds").val().split('-')[0],
                "Status": status,
                "StatusAttendanceLocked": "0", //Added for Rejected status EmployeeList View
                "Dpartmentid": DeptIdlst,
                "Designationid": DesgIdlst,
                "CompanyID": CompIdlst,
                "BranchID": BranchIdlst,
                "ShiftID": Shiftlst
            }
            checkSession();
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'PayrollDashboard/GetDashBoardDetailsSummary',
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    const wrapper = $(".filter_portlet_wrapper");
                    wrapper.addClass("full-width");
                    if (response.employeeList.length == 0) {
                        const wrapper = $(".filter_portlet_wrapper");
                        wrapper.removeClass("full-width");
                    }
                    clear();

                    if (response.basicInfo != null) {
                        $(".Regular_Payroll_Cycle").html(response.basicInfo.payrollCycle);
                        $(".Pay_Date").html(response.basicInfo.payDate.split('T')[0]);
                        //$("._Office").html(response.basicInfo.branchName);
                        $(".Total_Employee").html(response.basicInfo.totalEmployee);
                    }

                    if (response.payoutSummary != null) {
                        $(".Total_Final_Payout").html(response.payoutSummary.totalFinalPayOut);
                        //$(".Net_Salary").html(response.payoutSummary.totalNetSalary);
                        if (response.payoutSummary.dynamicColumnsTotallst.length > 0) {
                            for (var i = 0; i < response.payoutSummary.dynamicColumnsTotallst.length; i++) {
                                var str = '<div class="col-lg-3 col-xs-6"><div class="approval_info_block text-center"><div class="approval_salary_title">' + response.payoutSummary.dynamicColumnsTotallst[i].columnTitle + '</div><div class="approval_salary_value">&#8377; <b class="_Arrears">' + response.payoutSummary.dynamicColumnsTotallst[i].columnValue + '</b></div></div></div>';
                                $(".Payout_Summary_class").append(str);
                            }
                        }
                    }

                    if (response.deductionSummary != null) {
                        //$(".Tax_Deducted").html(response.deductionSummary.totalTaxDeducted);
                        $(".Provident_Fund").html(response.deductionSummary.totalPFDeducted);
                        $(".Professional_tax").html(response.deductionSummary.totalPTDeducted);
                        $(".Other_Deductions").html(response.deductionSummary.totalOtherDeduction);
                        $(".totalESICDeducted").html(response.deductionSummary.totalESICDeducted);
                    }
                    if (response.Success == true && response.employeeList.length > 0) {
                        _response = response.employeeList;
                        tableget(status);
                    } else {
                        $(".payroll_details_table").hide();
                        $("#table_div_1").hide();
                        $("#NotificationGrid-empty").show();
                        $("#fil_col_div").show();
                        //blanktable()
                    }
                    Summeryreportcount();
                    if (response.isPayrollLocked == true) {
                        $(".approved-label").css("display", "none");
                        $("#approve_pay_btn").show();
                        // $("#reject_pay_btn").show();
                    } else {
                        $("#approve_pay_btn").hide();
                        $("#reject_pay_btn").hide();
                        //$(".approved-label").css("display", "none");
                    }



                    if (response.isPayrollExist == true) {
                        if (response.isPayrollLocked == false) {
                            if (response.isPayrollApprovedOrReject == true) {
                                // $("#approve_pay_btn").hide();
                                // $("#reject_pay_btn").hide();
                                $(".approved-label").css("display", "inline");
                                $(".approved-label").text("Approved");
                            }
                            else {
                                $("#approve_pay_btn").hide();
                                $("#reject_pay_btn").hide();
                                $(".approved-label").css("display", "inline");
                                $(".approved-label").text("Rejected");
                            }
                        }
                    }
                    else {
                        $(".approved-label").css("display", "none");
                    }


                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }
