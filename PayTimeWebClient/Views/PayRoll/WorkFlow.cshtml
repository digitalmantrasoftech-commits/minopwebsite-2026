        function fillBranch(dropdownId) {
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + "Master/BranchGetAll",
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    // Get the specific select element by ID
                    var $branchSelect = $("#" + dropdownId);

                    // Clear existing options
                    $branchSelect.empty();

                    // Add the default "Select Branch" option
                    $branchSelect.append("<option value='' selected>Select Branch</option>");

                    if (data && data.length > 0) {
                        // Sort the data alphabetically by branch name
                        data.sort(function (a, b) {
                            return a.branchname.localeCompare(b.branchname);
                        });

                        // Append the branch options to the select element
                        data.forEach(function (branch) {
                            var option = `<option value="${branch.BranchId}">${branch.branchname}</option>`;
                            $branchSelect.append(option);
                        });
                    } else {
                        // Add an option to indicate no branches are available
                        $branchSelect.append("<option value='' disabled>No branches available</option>");
                    }

                    // Initialize or reinitialize Select2 for the dropdown
                    $branchSelect.select2({
                        placeholder: "Select Branch",
                        allowClear: false,
                        width: '100%'
                    });
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    // Handling different types of error responses
                    if (xhr.status == 404) { // NotFound = 404
                        toastr.error("Branch data not found.");
                    } else if (xhr.status == 500) { // InternalServerError = 500
                        toastr.error("Internal server error.");
                    } else if (xhr.status == 400) { // BadRequest = 400
                        toastr.error("Bad request.");
                    } else if (xhr.status == 419) { // Session expired or unauthorized
                        window.location.href = "/PayTime/LoginPage";
                    } else {
                        toastr.error(thrownError);
                    }
                }
            });
        }


