                dataType: "json",
                success: function (response) {
                    $deptSelect.append("<option value='' selected>Select Department</option>");

                    if (response && response.length > 0) {
                        response.forEach(dept => {
                           // var isSelected = selectedDept && selectedDept.split(',').includes(dept.Value) ? "selected" : "";
                            //$deptSelect.append(`<option value="${dept.Value}" ${isSelected}>${dept.Text}</option>`);

                            var isSelected = selectedDept && selectedDept.includes(dept.Value.toString());
                            //alert(isSelected);
                            $deptSelect.append(`<option value="${dept.Value}" ${isSelected ? "selected" : ""}>${dept.Text}</option>`);
                        });


                        $deptSelect.select2({
                            placeholder: "Select Department",
                            allowClear: false,
                            width: '100%'
                        });

                        if (selectedDept) {
                            $deptSelect.val(selectedDept.split(',')).trigger('change');
                        }
                    } else {
                        $deptSelect.append("<option value='' disabled>No departments available</option>");
                    }
                },
                error: function () {
                    toastr.error("Error loading departments. Please try again.");
                }
            });
        }


        function fillEmpTable(branchId, deptId, empDropdownId, selectedEmp) {
            var ajaxData = {
                departmentid: deptId,
                branchid: branchId,
                isActiveEmployee: 1
            };

            $.ajax({
                type: "GET",
                url: "/MasterData/GetEmpByBranchDept",
                data: ajaxData,
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: false,
                success: function (response) {
                    var $empSelect = $("#" + empDropdownId);
                    $empSelect.empty();
                    $empSelect.append("<option value='' selected>Select Authority Person</option>");

                    if (response && response.length > 0) {
                        response.forEach(emp => {
                            //var isSelected = selectedEmp && selectedEmp.split(',').includes(emp.EmpId) ? "selected" : "";
                            //$empSelect.append(`<option value="${emp.EmpId}" ${isSelected}>${emp.EmpName}</option>`);

                            var isSelected = selectedEmp && selectedEmp.split(',').includes(emp.EmpId.toString());
                            $empSelect.append(`<option value="${emp.EmpId}" ${isSelected ? "selected" : ""}>${emp.EmpName} (${emp.Empcode})</option>`); //soumya 22-07-20225 add Empcode
                        });

                        $empSelect.select2({
                            placeholder: "Select Authority Person",
                            allowClear: false,
                            width: '100%'
                        });

                        if (selectedEmp) {
                            $empSelect.val(selectedEmp.split(',')).trigger('change');
                        }
                    } else {
                        $empSelect.append("<option value='' disabled>No employees available</option>");
                    }
                },
                error: function () {
                    toastr.error("Error loading employees. Please try again.");
                }
            });
        }

        // Handling dropdown cascading
        function setupCascadingDropdowns(branchDropdownId, deptDropdownId, empDropdownId) {
            $("#" + branchDropdownId).on("change", function () {
                //var branchId = $(this).val();
                var branchId = $("#" + branchDropdownId).val();
                if (branchId) {
                    fillDeptTable(branchId, deptDropdownId, null);
                } else {
                    $("#" + deptDropdownId).empty().append("<option value='' selected>Select Department</option>");
                    $("#" + empDropdownId).empty().append("<option value='' selected>Select Authority Person</option>");
                }
            });

            $("#" + deptDropdownId).on("change", function () {
                var branchId = $("#" + branchDropdownId).val();
                var deptId = $("#" + deptDropdownId).val();
                if (deptId) {
                    fillEmpTable(branchId, deptId, empDropdownId, null);
                } else {
                    $("#" + empDropdownId).empty().append("<option value='' selected>Select Authority Person</option>");
                }
            });
        }


        function frmclear() {
            $("#workflow").val("");
            $("#inpid1").val("");
            $("#inpid2").val("");
            $("#inpid3").val("");
            $("#inpid4").val("");
            $("#inpid5").val("");
            $("#inpid6").val("");
            $("#inpid7").val("");
            $("#workflowfor").val(0).trigger('change');
            $("#approvaltype").val(1).trigger('change').prop('disabled', false);
            $("#BranchIds1").val(0).trigger('change');
            $("#DeptIds1").val(0).trigger('change');
            $("#EmpIds1").val(0).trigger('change');
            $("#BranchIds2").val(0).trigger('change');
            $("#DeptIds2").val(0).trigger('change');
            $("#EmpIds2").val(0).trigger('change');
            $("#BranchIds3").val(0).trigger('change');
            $("#DeptIds3").val(0).trigger('change');
            $("#EmpIds3").val(0).trigger('change');
            $("#BranchIds4").val(0).trigger('change');
            $("#DeptIds4").val(0).trigger('change');
            $("#EmpIds4").val(0).trigger('change');
            $("#BranchIds5").val(0).trigger('change');
            $("#DeptIds5").val(0).trigger('change');
            $("#EmpIds5").val(0).trigger('change');
            $("#BranchIds6").val(0).trigger('change');
            $("#DeptIds6").val(0).trigger('change');
            $("#EmpIds6").val(0).trigger('change');
            $("#BranchIds7").val(0).trigger('change');
            $("#DeptIds7").val(0).trigger('change');
            $("#EmpIds7").val(0).trigger('change');

            // Clear other fields based on the number of approval types
            for (var i = 1; i <= 7; i++) {
                // Find the level table based on the dynamic level id
                var $levelTable = $("#Level_table" + i);
                $levelTable.find('tr').each(function () {
                    var $inpid = $(this).find('input[id^="inpid"]');
                    $inpid.val("");
                });
            }
        }

        function checkSession() {
            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                },
                error: function (data) {
                    window.location.href = data;
                }
            });
        }
});


