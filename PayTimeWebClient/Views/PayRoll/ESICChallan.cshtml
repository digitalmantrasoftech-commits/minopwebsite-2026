    $(document).ready(function () {
        var ESICchallantbl;

        //Bind the month in Dropdownlist
        $("#Select_Month").each(function () {
            var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
            for (var i = 0; i < 12; i++) {
                var monthValue = i + 1;
                $(this).append('<option value = "' + monthValue + '">' + months[i] + '</option>')
            }
        });

        //Bind the year in Dropdownlist
        var currentYear = new Date().getFullYear();
        var currentMonth = new Date().getMonth();
        for (var i = currentYear - 10; i <= currentYear; i++) {
            $("#Select_Year").append("<option value='" + i + "'>" + i + "</option>");
        }
        $("#Select_Year").val(currentYear);
        $("#Select_Month").val(currentMonth + 1);

        $("#exportsheet_btn").click(function () {
            checkSession();
            if ($("#Select_Month").val() == 0) {
                $("#Select_Month").addClass('field_error');
                toastr.remove();
                toastr.error("Please select month.");
                return false;
            }
            else if ($("#Select_Year").val() == 0) {
                $("#Select_Month").removeClass('field_error');
                $("#Select_Year").addClass('field_error');
                toastr.remove();
                toastr.error("Please select year.");
                return false;
            }
            else {
                $("#Select_Year").removeClass('field_error');
                $("#Select_Month").removeClass('field_error');
            }

            if ($("#Select_Month").val() != 0 && $("#Select_Year").val() != 0) {
                $("#filter_open_div").hide();
                var monthval = $("#Select_Month").val();
                var yearval = $("#Select_Year").val();
            }
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").show();
            }
            var ESICchallantbl = $('#ESICchallantbl').DataTable();
            ESICchallantbl.destroy();
            $("#dataTables_tbl_header").remove();
            var obj = {
                month: monthval,
                year: yearval
            }
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'Payroll/GetAllESICChallan',
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    $("#NotificationGrid-empty1").hide();
                    if (response != null) {
                        const challan = response;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", challan, {
                            imageUrl: "emptyscreen_3.png",
                            subText: "No matching records found for the selected filters."
                        });
                    }
                    $("#ESICchallandiv").show();
                    $("#ESICchallantbl tbody").empty();
                    var table = "";
                    if (response != null && response.length > 0) {

                        for (var i = 0; i < response.length; i++) {
                            var tbl = "<tr>";
                            tbl = tbl + "<td class='' hidden>" + (response[i].empid !== null ? response[i].empid : "") + "</td>";
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td class=''>" + (response[i].IP_Number !== null ? response[i].IP_Number : "") + "</td>";
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td class=''>" + (response[i].IP_Name !== null ? response[i].IP_Name : "") + "</td>";
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td class=''>" + response[i].no_of_days;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td class=''> <span>&#8377; </span> " + response[i].monthly_wages;
                            tbl = tbl + "</td>";

                            response[i].Reason_Code = response[i].Reason_Code || "";

                            tbl = tbl + "<td class=''> " + response[i].Reason_Code;
                            tbl = tbl + "</td>";


                            response[i].Last_Working_Day = response[i].Last_Working_Day || "";
                            tbl = tbl + "<td class=''> " + response[i].Last_Working_Day;
                            tbl = tbl + "</td>";
                            tbl = tbl + "</tr>";
                            table += tbl;
                        }
                    }
                    else {

                    }

                    if (table != "") {
                        $("#ESICchallantbl tbody").append(table);
                    } else {
                        $("#ESICchallantbl tbody").empty();
                    }
                    datatable_res();
                    //$('#ESICchallantbl tbody').destroy;

                    // Destroy existing DataTable instance
                    if ($.fn.DataTable.isDataTable('#ESICchallantbl')) {
                        $('#ESICchallantbl').DataTable().destroy();
                        $("#dataTables_tbl_header").remove();
                    }
                    // DataTable initialisation
                    ESICchallantbl = $("#ESICchallantbl").DataTable({
                        "destroy": true,
                        //dom: 'lBfrtip',
                        dom: _domCommon,
                        language: _languageCommon,
                        processing: true,
                        paging: true,
                        ordering: true,
                        buttons: [
                            {
                                extend: 'excelHtml5',
                                //title: function () {
                                //    var monthNames = ["January", "February", "March", "April", "May", "June",
                                //                      "July", "August", "September", "October", "November", "December"];
                                //    var currentMonthName = monthNames[monthval - 1];
                                //    var currentYear = yearval;
                                //    return 'ECRM (' + currentMonthName + ' ' + currentYear + ')';
                                //},
                                exportOptions: {
                                    columns: [1, 2, 3, 4, 5, 6]
                                }
                            }
                        ],
                        initComplete: function (settings, json) {
                            var footer = $("#ESICchallantbl tfoot tr");
                            $("#ESICchallantbl thead").append(footer);
                            const visibleTable = $('table:visible').attr('id');
                            $("#buttons").append(`
                                <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                                    <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                                </div>
                            `);
                        },
                        //"columnDefs": [
                        //           { "orderable": false, "targets": 11 } // Disabling sorting for the third column
                        //],
                        lengthMenu: [
                            [10, 25, 50, 100],
                            [10, 25, 50, 100],
                        ]
                    });
                    setTimeout(function () {
                        $("#" + "ESICchallantbl" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                        $('.tooltips').tooltip();
                    }, 100);
                    //Update row numbers after filtering or sorting
                    $("#ESICchallantbl").DataTable().on('order.dt search.dt', function () {
                        $("#ESICchallantbl").DataTable().column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                            cell.innerHTML = i + 1;
                        });
                    }).draw();
                },
                error: function (xhr, status, error) {
                    console.error(xhr.responseText);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });


        //Clear all the data with clear button
        $("#resetsheet_btn").click(function () {
            $("#tblempty").hide();
            $("#NotificationGrid-empty1").show();
            $("#NotificationGrid-empty").hide();
            checkSession();
            $("#Select_Month").val('0');
            $("#Select_Year").val('0');
            $("#ESICchallandiv").hide();
        });

        //$("#Filter_search").click(function () {
        //    $("#filter_open_div").toggle();
        //});

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

    });

    //Add Scrollbar
    function datatable_res() {
        setTimeout(function () {
            $(".dataTables_wrapper > .dataTables_info").before('<div class="customforms_table"></div>');
            $(".dataTables_wrapper > table").appendTo(".customforms_table");
        }, 1000);
    }

    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
</script>

@if (obj.CanView)
{
    <div class="page-bar">
        <ul class="page-breadcrumb" style="float: none">
            <li>
                <a href="@(_CheckFastrackdb == 1 ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> ESIC Challan</span>
            </li>
        </ul>

        <div class="page-toolbar text-right">
            <a href="javascript:;" class="btn icon_transparent_btn tooltips" id="Filter_search" data-placement="left" data-original-title="Filter" data-toggle="tooltip"><i class="fa-light fa-filter" aria-hidden="true"></i> </a>
        </div>
    </div>

    <div id="ajax_loader" class="modal_bg loading" aria-hidden="true" style="display:none">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>

    <div class="filter_portlet_wrapper">

        <!-- Datatable Block : Begin -->
        <div class="portlet filter_portlet_tbl">
            <div class="portlet-body">
                <div id="ESICchallandiv" style="display:none">
                    <div class="payroll_details_table">
                        <!-- Datatable : Begin -->
                        <div id="tblempty">
                            <div class="table-responsive" id="tableResponsive">
                                <table id="ESICchallantbl" class="table new_datatbl table-striped table-bordered tbl_middle table-hover tbl_newdatatbl serch_datatable table-checkable order-column">
                                    <thead>
                                        <tr>
                                            <th hidden>EmployeeIDr</th>
                                            <th>IP Number</th>
                                            <th>IP Name</th>
                                            <th>No of days</th>
                                            <th>Total Monthly Wages</th>
                                            <th>Reason Code</th>
                                            <th>Last Working Day</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                    <tfoot>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                        <!-- Datatable : End -->
                    </div>
                </div>
                <div id="NotificationGrid-empty" style="display: none">
                    <div class="datanotfound">
                        <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="Nodata Found Icon">
                        <p class="datanotfound_title">No data found</p> <!-- titleText -->
                        <p class="">No matching records found for the selected filters.</p><!-- subText -->
                    </div>
                </div>
                <div id="NotificationGrid-empty1">
                    <div class="datanotfound">
                        <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="Nodata Found Icon">
                        <p class="datanotfound_title">No data show</p> <!-- titleText -->
                        <p class="">Start by applying a filter to view relevant data.</p><!-- subText -->
                    </div>
                </div>
            </div>
        </div>
        <!-- Datatable Block : End -->
        <!-- Filter Block : Begin -->
        <div class="portlet filter_boxModal">
            <div class="filterbox_header">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="filter-title">Filters</h4>
                    <button type="button" class="filterclose_btn"><i class="fa-light fa-xmark"></i></button>
                </div>
            </div>
            <div class="filterbox_body">
                <div class="col-lg-12" id="Monthdropdown">
                    <label class="control-label">Month<span class="required" aria-required="true"> * </span></label>
                    <div class="form-group d-flex">
                        <select id="Select_Month" class="form-control input-sm">
                            <option value="0">Select Month</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-12" id="Yeardropdown">
                    <label class="control-label">Year <span style="color:red"> *</span></label>
                    <div class="form-group d-flex">
                        <select id="Select_Year" class="form-control">
                            <option value="0">Select Year</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="filterbox_footer">
                <div class="text-right" id="btndiv1">
                    @if (obj.CanAdd)
                    {
                        <a href="javascript:;" class="btn clear_btn tooltips" id="resetsheet_btn" onclick="" data-placement="top" data-original-title="Reset"><i class="fa-regular fa-eraser"></i></a>
                        <a href="javascript:;" class="btn icon_btn margin-left-5 tooltips" id="exportsheet_btn" data-placement="top" data-original-title="Export Sheet"><i class="fa-regular fa-download"></i></a>
                        @*<a href="javascript:;" class="btn clear_btn margin-left-10" id="pdf_btn">PDF </a>*@
                    }
                </div>
            </div>
        </div>
        <!-- Filter Block : End -->

    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}