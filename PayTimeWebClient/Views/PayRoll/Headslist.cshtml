                    var seconddrop = $('<td class="calculate_td_250">').html('<div class="col-xs-12"><select class="form-control input-sm drp2" id="drp_2' + rowCount + '"><option value="1">% Percentage</option><option value="2" selected >Flat Amount</option></select></div>');
