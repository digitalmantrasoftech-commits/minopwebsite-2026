                                        var _regex = /\*(.*?)\//; // Regular expression to capture the value between "*" and "/"
                                        var _match = formula[i].match(_regex);
                                        var extractedValue = 0;
                                        if (_match) {
                                            extractedValue = _match[1];
                                        }
                                        table = "";
                                        var tbl = "<tr>";

                                        tbl = tbl + "<td class='calculate_td_250'>" + '<div class="col-xs-12 select2_width"><select class="form-control input-sm select2 drp" id="edit_head_drop' + i + '"><option value="0">None</option><option value="1">CTC</option>' + head_bind + '</select></div>';
                                        tbl = tbl + "</td>";
                                        tbl = tbl + "<td class='calculate_td_120'>" + '<div class="col-xs-12"><input type="text" class="form-control input-sm inp" pattern="[0-9]+" value="' + extractedValue + '" name="" id="inpid' + i + '" placeholder=""></div>';
                                        tbl = tbl + "</td>";
                                        tbl = tbl + "<td class='calculate_td_250'>" + '<div class="col-xs-12"><select class="form-control input-sm drp2" id="sec_drop' + i + '"><option value="1" selected>% Percentage</option><option value="2">Flat Amount</option></select></div>';
                                        tbl = tbl + "</td>";
                                        //if (i == (formula.length - 1)) {
                                        //    tbl = tbl + "<td class='calculate_td_120'>" + '<div class="col-xs-12"><a href="javascript:void(0)" class="btn add_fields_btn tooltips" title="Add new fields" ><i class="fa-solid fa-plus"></i></a><a href="javascript:void(0)" class="btn btn-xs red disreject tooltips" style="display: none" title="Remove fields"><i class="fa-solid fa-xmark"></i></a></div>';
                                        //    tbl = tbl + "</td>";
                                        //} else {
                                        tbl = tbl + "<td class='calculate_td_120'>" + '<div class="col-xs-12"><a href="javascript:void(0)" class="btn add_fields_btn tooltips" title="Add new fields" ><i class="fa-solid fa-plus"></i></a><a href="javascript:void(0)" class="btn btn-xs red disreject tooltips" title="Remove fields"><i class="fa-solid fa-xmark"></i></a></div>';
                                        tbl = tbl + "</td>";
                                        //}

                                        tbl = tbl + "</tr>";
                                        table += tbl;
                                        $('#Calculation_types_table').append(table);
                                        $('.tooltips').tooltip();
                                        $("#edit_head_drop" + i).val(ids[0]);
                                        $('.select2').select2();
                                        $("#HeadType").prop("disabled", false);
                                    }

                                } else {
                                    if (Headid > 7 && Headid < 13 || Headid == 6001 || Headid == 6000) {
                                        $("#HeadType").prop("disabled", true);
                                        $('#Calculation_types_table').empty();
                                        $("#table_view").hide();
                                    }

                                    else {
                                        //bind formula without ids
                                        table = "";
                                        var tbl = "<tr>";

                                        tbl = tbl + "<td class='calculate_td_250'>" + '<div class="col-xs-12 select2_width"><select class="form-control input-sm select2 drp" id="edit_head_drop' + i + '"><option value="0" selected>None</option><option value="1">CTC</option>' + head_bind + '</select></div>';
                                        tbl = tbl + "</td>";
                                        tbl = tbl + "<td class='calculate_td_120'>" + '<div class="col-xs-12"><input type="text" class="form-control input-sm inp" pattern="[0-9]+" name="" value="' + formula[i] + '" id="inpid' + i + '" placeholder=""></div>';
                                        tbl = tbl + "</td>";
                                        tbl = tbl + "<td class='calculate_td_250'>" + '<div class="col-xs-12"><select class="form-control input-sm drp2" id="sec_drop' + i + '"><option value="1">% Percentage</option><option value="2" selected>Flat Amount</option></select></div>';
                                        tbl = tbl + "</td>";
                                        //if (i == (formula.length - 1)) {
                                        //    tbl = tbl + "<td class='calculate_td_120'>" + '<div class="col-xs-12"><a href="javascript:void(0)" class="btn add_fields_btn tooltips" title="Add new fields" ><i class="fa-solid fa-plus"></i></a><a href="javascript:void(0)" class="btn btn-xs red disreject tooltips" style="display: none" title="Remove fields"><i class="fa-solid fa-xmark"></i></a></div>';
                                        //    tbl = tbl + "</td>";
                                        //} else {
                                        tbl = tbl + "<td class='calculate_td_120'>" + '<div class="col-xs-12"><a href="javascript:void(0)" class="btn add_fields_btn tooltips" title="Add new fields" ><i class="fa-solid fa-plus"></i></a><a href="javascript:void(0)" class="btn btn-xs red disreject tooltips" title="Remove fields"><i class="fa-solid fa-xmark"></i></a></div>';
                                        tbl = tbl + "</td>";
                                        //}

                                        tbl = tbl + "</tr>";
                                        table += tbl;

                                        $('#Calculation_types_table').append(table);
                                        $('.tooltips').tooltip();
                                        $('.select2').select2();
                                        $("#HeadType").prop("disabled", false);

                                    }
                                }
                            }

                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            });

            //inactive Structure
            $('body').on('click', '.inactive_grd', function (e) {
                var _row = $(this).closest('tr');
                Headid = _row.find('._head_id').val();
