@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;

@{
    ViewBag.Title = "Salary Heads";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    var _ErrorMsg = TempData["ErrorMsg"];
    var _SuccessMsg = TempData["SuccessMsg"];
    var _ExErrorMsg = TempData["ExErrorMsg"];
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurlpayroll = ConfigurationManager.AppSettings["webapipaytimePayroll"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _CheckCustomClientDBName = ConfigurationManager.AppSettings["CheckCustomClientDBName"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    int _CheckFastrackdb = 0;
    if (_CheckCustomClientDBName.Contains(_dbName))
    {
        _CheckFastrackdb = 1;
    }
}
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">
<style type="text/css">
    .dataTables_wrapper .dataTables_filter {
        display: none !important;
    }

    .dataTables_wrapper {
        padding: 0px 0 0px 0;
    }

    .buttons-columns {
        display: none !important;
    }

    .serch_datatable .ui-state-default a {
        color: var(--navyblue_color);
    }

    .view_additional_cal:hover, .additional_cal:hover {
        cursor: pointer;
    }

    .select2_width .select2-container {
        width: auto !important;
    }
</style>
@if (obj.CanView)
{
    <script>
        var t = "";
        var t1 = ""
        $(document).ready(function () {
            var total;
            var _drop_head_data = "";
            var all_master_head = "";
            var rowCount = 0;
            var head_bind = "";
            var inputValue = 0;
            var Headid = 0;
            var duplicateRowsData = 0;
            if ("@_Message" != "") {
                toastr.success("@_Message");
                if ('@_SuccessMsg' != null) {
                    $("#btnDownload").hide();
                }
            }
            if ('@_error' != "") {
                toastr.remove();
                toastr.error("@_error");
                if ('@_ErrorMsg' != "") {
                    $("#btnDownload").show();
                }
            }
            if ("@_ExErrorMsg" != "") {
                $("#btnDownload").hide();
                toastr.remove();
                toastr.error("@_ExErrorMsg");
            }

            $("#Custom_head").click(function () {
                if ($(this).prop('checked')) {
                    $("#table_view").hide();
                } else {
                    $("#table_view").show();
                }
            });
            $("#Calculation_types_table").on('input', '.inp', function (e) {
                var inputVal = $(this).val();
                var parentTr = $(this).closest('tr');
                var secondDropdown = parentTr.find('.drp2');
                var indexDot = inputVal.indexOf('.');
                var Percentage = parseInt(secondDropdown.val());
                var flatAmount = parseInt(secondDropdown.val());

                //for FlatAmount Dropdown
                if (flatAmount == 2 && (inputVal.length > 2 && inputVal.length < 5)) {
                    if (inputVal == "0.0") {

                    }
                    else if (inputVal.length == 4 && inputVal == 0) {
                        toastr.error("Flat amount value can't be 0");
                        $(this).val('');
                        return false;
                    }
                }
                if (flatAmount == 2 && indexDot > 0) {

                    if (indexDot == 1) {
                        $(this).val(inputVal.slice(0, 4));
                    }
                    if (indexDot == 2) {
                        $(this).val(inputVal.slice(0, 5));
                    }
                    if (indexDot == 3) {
                        $(this).val(inputVal.slice(0, 6));
                    }
                    if (indexDot == 4 || indexDot == 7) {
                        $(this).val(inputVal.slice(0, 7));
                    }
                    if (indexDot == 5) {
                        $(this).val(inputVal.slice(0, 8));
                    }
                }
                if (flatAmount == 2 && inputVal.length > 8) {
                    e.preventDefault();
                    $(this).val(inputVal.slice(0, 8)); // Truncate the input value to a maximum length of 3
                }

                //For Percentage Dropdown
                if (Percentage == 1 && inputVal.length > 5 && indexDot < -1) {
                    e.preventDefault();
                    $(this).val(inputVal.slice(0, 5));// Truncate the input value to a maximum length of 3
                }
                if (Percentage == 1 && (inputVal.length > 2 && inputVal.length < 5)) {
                    if (inputVal == "0.0") {

                    }
                    else if (inputVal.length == 4 && inputVal == 0) {
                        toastr.remove();
                        toastr.error("Percentage value can't be 0");
                        $(this).val('');
                        return false;
                    }
                }
                if (Percentage == 1 && inputVal.length == 3 && indexDot != 1) {
                    if (inputVal == 100) {
                        $(this).val(inputVal.slice(0, 3));
                    }
                    else {
                        $(this).val(inputVal.slice(0, 2) + '.');
                    }
                }
                if (Percentage == 1 && indexDot == 1 && inputVal.length > 3) {

                    $(this).val(inputVal.slice(0, 4));
                }
                if (Percentage == 1 && inputVal.length > 3 && inputVal > 999) {
                    $(this).val(inputVal.slice(0, 3));
                }
                if (Percentage == 1 && inputVal.length > 5) {
                    e.preventDefault();
                    $(this).val(inputVal.slice(0, 5));// Truncate the input value to a maximum length of 3
                }
            }).on('cut copy paste', function (e) {  //$('#inpid0')
                e.preventDefault();
            }).on('keydown', function (e) {
                // Get the key code of the pressed key
                var keyCode = e.keyCode || e.which;
                var key = e.key;
                var noSpecialChar = validateKeyPress(e.which);

                if (keyCode == 8 || keyCode == 110) {
                    noSpecialChar = !noSpecialChar;
                }
                if ((key >= '0' && key <= '9')) {
                    return;
                }
                if (keyCode == 16 || noSpecialChar) {
                    return false;
                }

                if ((keyCode >= 65 && keyCode <= 90) || (keyCode >= 97 && keyCode <= 109) || (keyCode >= 111 && keyCode <= 122) || (keyCode >= 219 && keyCode <= 222)) {
                    e.preventDefault();
                }

                if ((keyCode >= 186 && keyCode <= 189) || (keyCode == 191) || (keyCode == 192)) {
                    e.preventDefault();
                }
            });

