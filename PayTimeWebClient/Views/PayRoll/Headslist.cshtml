                                    var formula = response[0].custom_formula.split('+');

                                }

                            }
                            //var formula = response[0].custom_formula.split('+');
                            for (var i = 0; i < formula.length; i++) {
                                const regex = /{([^}]*)}/g;
                                const ids = [];
                                let match;
