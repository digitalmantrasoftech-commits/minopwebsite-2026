                    //on Click on removing last row  - Sh/25/04/2024
                    $("#inpid" + (rowCount - 1)).closest('tr').remove();
                }
            });

            //dropdown 1 change
            $("body").on('change', '.drp', function () {
                var selectedValue = $(this).val();
                var parentTr = $(this).closest('tr');
                var secondDropdown = parentTr.find('.drp2');
                var secondDropdown1 = parentTr.find('.drp');
                var inpu = parentTr.find('.inp');
                if (selectedValue != 0) {
                    // Change the value of the second dropdown
                    secondDropdown.val(1);
                    inpu.val("");
                }
                if (selectedValue == 0) {
                    // Change the value of the second dropdown
                    secondDropdown.val(2);
                    inpu.val("");
                }

                var rowIndex = $(this).closest('tr').index();

                var rowCount = $('#Calculation_types_table tr').length;
                if (rowCount > 1) {
                    if (selectedValue != 0) {
                        for (var i = 0; i < rowCount; i++) {
                            if (rowIndex != i) {
                                var _drpval = $("#Calculation_types_table tr:eq(" + i + ")").find('.drp').val();
                                if (_drpval == selectedValue) {
