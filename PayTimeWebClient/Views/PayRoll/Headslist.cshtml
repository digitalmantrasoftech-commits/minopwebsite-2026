        function clickviewmore(id, thi) {
            $('#view_Data').modal('toggle');
            var row = $(thi).closest('tr');
            var title = row.find('.Head_name').text();
            $("#view_Head").html(title);
            checkSession();
            $.ajax({
                type: "Get",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurlpayroll' + 'Organization/GetHeadConfigurationDetailsById?id=' + id + '&structure_id=0',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    $("#view_Data_table tbody").empty();
                    var table = '';
                    if (response.HeadConfiguration.length > 0) {

                        for (var i = 0; i < response.HeadConfiguration.length; i++) {
                            if (response.HeadConfiguration[i].config_description == "pf_fixed_amount_Employee" || response.HeadConfiguration[i].config_description == "pf_fixed_amount_Employer") {


                            }
                            else {
                                var tbl = "<tr>";
                                tbl = tbl + "<td>" + response.HeadConfiguration[i].config_description;
                                tbl = tbl + "</td>";
                                tbl = tbl + "<td>" + response.HeadConfiguration[i].config_value;
                                tbl = tbl + "</td>";
                                tbl = tbl + "</tr>";
                                table += tbl;

                            }

                        }
                    }
                    $("#note_div").html(response.Note);
                    $("#view_Data_table tbody").append(table);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }

        function checkSession() {

            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                },
                error: function (data) {
                    window.location.href = data;
                }
            });
        }
