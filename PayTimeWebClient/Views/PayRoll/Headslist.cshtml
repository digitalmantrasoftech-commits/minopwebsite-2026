                        } else if (response.success == false) {
                            toastr.remove();
                            toastr.error(response.message);
                        } else {
                            toastr.remove();
                            toastr.error(response.message);
                        }
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            });
