                    if (all_master_head[i].head_id != 8 && all_master_head[i].head_id != 9 && all_master_head[i].head_id != 10 && all_master_head[i].head_id != 11) {
                        head_bind += '<option value="' + all_master_head[i].head_id + '">' + all_master_head[i].head_name + '</option>';
                    }
                }

                var newRow = $('<tr>');
                var firstdrop = $('<td class="calculate_td_250">').html('<div class="col-xs-12"><select class="form-control input-sm select2 drp"  id="edit_head_drop' + rowCount + '"> <option value="0" selected>None</option><option value="1" >CTC</option> ' + head_bind + '</select></div>');
                firstdrop.find('.select2').select2();
                var input = $('<td class="calculate_td_120">').html('<div class="col-xs-12"><input type="text" class="form-control input-sm inp" name="" id="inpid' + rowCount + '" pattern="[0-9]+" placeholder=""></div>')
                var seconddrop = $('<td class="calculate_td_250">').html('<div class="col-xs-12"><select class="form-control input-sm drp2" id="drp_2' + rowCount + '"><option value="1">% Percentage</option><option value="2" selected >Flat Amount</option></select></div>');
