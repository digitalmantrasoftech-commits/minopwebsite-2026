    function AddLeave(Leave) {
        $.ajax({
            type: "POST",
            url: "/Transactions/OnDutyLeave?Leave=" + JSON.stringify(Leave),
            contentType: "application/json",
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                } else if (response.startsWith('\r\n\r')) {
                    window.location = "/PayTime/Index";
                } else if (response != null) {
                    if (response === "OK") {
                        var uploaddoc = $("#UploadLeaveDoc").val();
                        if (uploaddoc != null && uploaddoc !== "") {
                            setTimeout(function () {
                                $("#frmupload").submit();
                            }, 1000);
                        }
                        else {
                            Clear();
                            GetAllOnDutyLeave();
                        }
                        $('#frmpopup').modal('toggle');
                        toastr.remove();
                        toastr.success("Leave/OnDuty added successfully.");
                        $('#btnAddLeave').attr("disabled", "disabled");
                        $("#btnAddLeave").unbind("click");
                        $("#leaveTypeDurationBlock").hide();
                    } else {
                        toastr.remove();
                        toastr.error(response);
                    }
                } else {
                    $(".loading").hide();
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                $(".loading").hide();
                toastr.error("An error occurred while processing your request.");
                $("#leaveTypeDurationBlock").hide();
            },
            complete: function () {
                $(".loading").hide();
            }
        });
    }
