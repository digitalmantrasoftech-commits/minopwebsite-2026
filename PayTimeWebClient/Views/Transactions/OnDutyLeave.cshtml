        $("#UploadLeaveDoc").change(function () {
            var GetfileName = document.getElementById('UploadLeaveDoc');
            if ($("#UploadLeaveDoc").val() != null) {
                var GetfileName = document.getElementById('UploadLeaveDoc');
                var selectedfile = GetfileName.files[0].size;
                var validFileSize = 5 * 1024 * 1024; // 5 MB in bytes
                if (selectedfile > validFileSize) {
                    toastr.remove();
                    toastr.error("File size exceeds the maximum allowed size of 5 MB.");
                    $(this).val("");
                    return false;
                }
                var validExts = new Array(".pdf", ".png", ".jpg", ".jpeg");
                var fileExt = $("#UploadLeaveDoc").val();
                if (fileExt != "") {
                    fileExt = fileExt.substring(fileExt.lastIndexOf('.')).toLowerCase();
                    if (validExts.indexOf(fileExt) < 0) {
                        toastr.remove();
                        toastr.error("Invalid file selected, valid files are of " + validExts.join(", ") + " types.");
                        $("#UploadLeaveDoc").val("");
                        return false;
                    }
                }
            }
            var fileName = $(this).val().split('\\').pop(); // Get the file name without the full path
            $('#UploadLeaveDoc').text(fileName);
