@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Leave Encash/Carryforward";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _ChunkSize = Convert.ToInt32(HttpContext.Current.Session["DataDropDownThreShold"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    int _cmpid = 0;
    int _branchid = 0;
    int _empid = 0;
    if (_RoleId == 6805)
    {
        _cmpid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"]);
    }
    if (_RoleId == 6806)
    {
        _cmpid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"]);
        _branchid = Convert.ToInt32(HttpContext.Current.Session["BranchId"]);
    }
    if (_RoleId > 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _cmpid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"]);
        _branchid = Convert.ToInt32(HttpContext.Current.Session["BranchId"]);
        _empid = Convert.ToInt32(HttpContext.Current.Session["EmpId"].ToString());
    }
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
   ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
   : "false"; // Default to "false" if the session is null
}
<script src="~/Pages_JS/VirtuallScroll/NormalDropDownVirtualClientServer.js"></script>
<script src="~/Pages_JS/VirtuallScroll/ServerSideMultiSelectDropDown.js"></script>
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<style>
    .divEmp {
        position: relative;
    }
</style>
<script type="text/javascript">
    var DeptIdlst = "";
    var count = 0;
    var form = "Leave Encash/Carryforward";
    var operation = "";
    let CompanyDropdown = null;
    let BranchDropdown = null;
    $(document).ready(function () {
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        var $select = new ServerVirtualDropdown({
            apiUrl: '@_webapiurl' + "DataDropDownOptimize/GetDepartmentSimpleDropDownData",
            tokan: '@_tokan',
            chunkSize : Number('@_ChunkSize'),
            dropdownId: "DeptIds",
            selectAll: true,
            dataKey: "DepartmentId",
            labelKey: "DepartmentName",
        });
         $(window).on("load", function () {
             CompanyDropdown = new Select2Dropdown({
                    dropdownId: "ddlCompany", // ID of the dropdown
                    apiUrl: '@_webapiurl' + 'DataDropDownOptimize/GetCompanyDropDownPaginated', // API URL for fetching data
                    dataKey: "Id", // Key for value
                    labelKey: "Name", // Key for text
                    token: '@_tokan', // Optional auth token
                    chunkSize : Number('@_ChunkSize'),
                    extraParams: { RoleId: '@_RoleId', CompanyID: '@_cmpid' }
             });

             BranchDropdown = new Select2Dropdown({
                    dropdownId: "ddlBranch", // ID of the dropdown
                    apiUrl: '@_webapiurl' + 'DataDropDownOptimize/GetBranchDropDownPaginated', // API URL for fetching data
                    dataKey: "Id", // Key for value
                    labelKey: "Name", // Key for text
                    token: '@_tokan', // Optional auth token
                    chunkSize : Number('@_ChunkSize')
            });
        });
         GetAllLeaveEncashCarry();
        //$("#tableResponsive").hide();
       // $("#NotificationGrid-empty").show();
        $("#btnSave").click(function () {
            save();
        });
        $(".alert").hide();
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }

        $('#btnAddLeave').attr("disabled", "disabled");
        $("#btnAddLeave").unbind("click");
        $("#btnAddLeave").click(function () {
            count++;
            operation = "Add Form";
        })
        $("#ddlCompany").change(function () {
            $('#btnAddLeave').attr("disabled", "disabled");
            $("#btnAddLeave").unbind("click");
           $("#ddlBranch").val(null).trigger("change");
                BranchDropdown.extraParams = { CompanyID: $("#ddlCompany").val(), BranchID: '@_branchid', RoleId : '@_RoleId' };
                $("#ddlBranch").select2('close');
                $("#ddlBranch").trigger('change');
        });

        $("#ddlBranch").change(function () {
            if ($("#ddlBranch").val() == null) {
                $('#btnAddLeave').attr("disabled", "disabled");
                $("#btnAddLeave").unbind("click");
            }
           else {
                $("#btnAddLeave").removeAttr("disabled");
                $("#btnAddLeave").click(function () {
                    $("#btnAddLeave").attr("data-toggle", "modal");
                    $("#btnAddLeave").attr("data-target", "#frmpopup");
                    //   $("#frmpopup").dialog("open");
                    $(".alert-danger").hide();
                    $(".alert-success").hide();
                    //$("#tblEmp tbody").empty();
                    $("#tblEmp").empty();
                    $("#DeptIds option:selected").prop("selected", false);
                    $("#DeptIds").multiselect('refresh');
                    $(".ClsChkAllDept").prop('checked', false);
                    $(".ClsChkDept").prop('checked', false);

                    $("#DeptIds").empty();
                    $select.data = { BranchID: $("#ddlBranch").val() };
                    $select.loadInitialData();
                    $(document.body).on('change', '#DeptIds', function () {
                        $(".popMsg").hide();
                        var deptid = $('#DeptIds option:selected');
                        var DeptArray = [];
                        if ($("#DeptIdsContainer li").hasClass("multiselect-item multiselect-all active")) {
                            DeptIdlst = "";
                        }
                        else {

                            var ArrDept = $("#DeptIds").val();
                            if (ArrDept != null)
                                DeptIdlst = ArrDept.join(",");
                            else
                                DeptIdlst = "";
                        }
                        getEmp();
                    });
                });
            }
            GetAllLeaveEncashCarry();
        });
        function GetAllLeaveEncashCarry() {
            $("#tblLeaveEncashCarry").empty();
            var bID = $("#ddlBranch").val();
            $.ajax({
                type: "POST",
                url: "/Transactions/GetAllLeaveEncashCarry?BranchId=" + $("#ddlBranch").val(),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {     
                    if (response != null) {
                        const LeaveEncashCarry = response;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", LeaveEncashCarry, {
                            imageUrl: "emptyscreen_3.png",
                            subText: "No matching records found for the selected filters."
                        });
                    }
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var table = "";
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            var tbl = "<tr class='odd gradeX'>";
                            //tbl = tbl + "<td hidden>" + response[i].LeaveEncashCarryId;
                            //tbl = tbl + "</td>";
                            tbl = tbl + "<td>" + response[i].EmpName;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td>" + response[i].LeaveTypeName;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td>" + response[i].LeaveBalance;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td>" + response[i].TransactionYearName;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td>" + response[i].EncashCarry;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td hidden>" + response[i].LeaveEncashCarryId;
                            tbl = tbl + "</td>";
                            tbl = tbl + "</tr>";
                            table += tbl;
                        }
                    }
                    $("#tblLeaveEncashCarry").destroy;
                    $('#tblLeaveEncashCarry').append(table);
                    $("#dataTables_tbl_header").remove();
                    $('#tblLeaveEncashCarry').dataTable({
                        dom: _domCommon,
                        language: _languageCommon,
                        "columnDefs": [
                                        //{
                                        //    "targets": [0],
                                        //    "visible": false,
                                        //    "searchable": false,
                                        //},
                                            { "width": "30%", "targets": 1 },
                                            { "width": "40%", "targets": 4 }

                        ],
                        initComplete: function () {
                            const visibleTable = $('table:visible').attr('id');
                            $("#buttons").append(`
                                <div id="export-button" class="export-button tooltips" data-placement="top" data-original-title="Download" data-table-id="${visibleTable}">
                                    <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                                </div>
                            `);

                        },
                        "destroy": true,
                        "columns": [
                            { "title": "Name", data: "Name" },
                            { "title": "Leave Type", data: "Leave Type"},
                            { "title": "Leave Balance", data: "Leave Balance" },
                            { "title": "Transaction Year", data: "Transaction Year" },
                            { "title": "Encash/Carry", data: "Encash/Carry" },
                            { "title": "LeaveEncashCarryId", data: "LeaveEncashCarryId", visible: false, searchable: false, },
                        ]
                    });
                    setTimeout(function () {
                        $("#" + "tblLeaveEncashCarry" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                        $('.tooltips').tooltip();
                    }, 100);
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
            window.onload = function () {
                timeSpentOnPage();
            }
            $(window).on("beforeunload", function () {
                if (operation == "" || operation == null || operation == '') {
                    operation = "View LeaveCarryForward";
                }
                var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
                var timeSpent = timeSpentOnPage();
                analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
            })
        }

        function save() {
            if (valid()) {
                var allVals = [];
                $("#tblEmp .ClsChkEmp").each(function () {
                    if ($(this).is(':checked') == true) {
                        allVals.push($(this).attr("id"));
                    }
                });
                $.post("/Transactions/LeaveEncashCarry?EmpArr=" + allVals, function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    if (response != null) {

                        if (response.toLowerCase() == "ok") {
                            //Clear();
                            $('#frmpopup').modal('toggle');
                            toastr.remove();
                            toastr.success("Leave encashed/carryforwarded sucessfully.");
                            GetAllLeaveEncashCarry();
                        }
                        else {
                            toastr.remove();
                            toastr.error(response);
                        }
                    }
                });
            }
        }

        //$("#Filter_search").click(function () {
        //    $("#filter_open_div").toggle();
        //});

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

    });

    function getEmp() {
        $("#tblEmp").empty();
        var bID = $("#ddlBranch").val();
        var cID = $("#ddlCompany").val();
           let isSelectedAll = $("#DeptIdsContainer li").hasClass("multiselect-item multiselect-all active") == true ? 1 : 0;
            if (isSelectedAll) {
                DeptIdlst = "";
            }
            let searchTerm = "";
            if ($("#DeptIdsContainer li input").hasClass("multiselect-search")) {
                searchTerm = $("#DeptIdsContainer li .multiselect-search").val().trim();
                if (searchTerm != "") DeptIdlst = "";
            }
        $.ajax({
            type: "GET",
            url: "/Transactions/GetLeaveEncashCarryEmp?DeptArr=" + DeptIdlst + ";" + bID + ";" + cID + ";" + isSelectedAll + ";" + searchTerm,
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response != null) {
                    $("#lblemp").show();
                    var table = "";
                    for (var i = 0; i < response.length; i++) {

                        var tbl = "<tr class='odd gradeX'>";
                        tbl = tbl + "<td id='eid'>" + response[i].EmpId;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='ecode'>" + response[i].Empcode;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='enm'>" + response[i].EmpName;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='epid'>" + response[i].EmpPunchID;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id=''><input type='checkbox' onchange='checkedEmp(this)' class='ClsChkEmp' id='" + response[i].EmpId + "'/>";
                        //  tbl = tbl + "<td id=''><input type='checkbox' class='ClsChkEmp' id='" + response[i].EmpId + "'/>";
                        tbl = tbl + "</td>";
                        tbl = tbl + "</tr>";
                        table += tbl;
                    }
                }
                $("#tblEmp").destroy;
                $('#tblEmp').append(table);
                $('#tblEmp').dataTable({
                    "columnDefs": [
                               {
                                   "targets": [0],
                                   "visible": false,
                                   "searchable": false,
                               }

                    ],
                    "destroy": true,
                    "bInfo": false,
                    "bPaginate": false,
                    "bLengthChange": false,
                    "columns": [
                        { "title": "ID" },
                        { "title": "Code" },
                    { "title": "Name" },
                    { "title": "Punch ID" },
                        { "title": "<input type='checkbox' class='ClsChkAllDept' onchange='AllCheckedEmp(this)' />" }
                    ],
                    "order": [[2, 'asc']]
                });
                $(".loading").hide();
            },
            beforeSend: function () {
                $(".loading").show();
            },
            error: function () {
                $(".loading").hide();
            }
        });
    }

    function valid() {
        if ($("#DeptIds").val() == null) {
            toastr.remove();
            toastr.error("Please select at least one department.");
            return false;
        }
        var allVals = [];
        $("#tblEmp .ClsChkEmp").each(function () {
            if ($(this).is(':checked') == true) {
                allVals.push($(this).attr("id"));
            }
        });
        if (allVals.length == 0) {
            toastr.remove();
            toastr.error("Please select employee.");
            return false;
        }
        return true;
    }

    function Clear() {
        $("#ddlCompany").val("0");
        $("#ddlBranch").empty();
        $(".alert-danger").hide();
        $(".alert-success").hide();
        $(".alert-danger").text("");
        $(".alert-success").text("");
        $("#tblDept tbody").empty();
        $(".ClsChkAllDept").prop('checked', false);
        $("#tblEmp tbody").empty();
    }

    function AllCheckedDept(ths) {
        $(".popMsg").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkDept").prop('checked', true);
        }
        else {
            $(".ClsChkDept").prop('checked', false);
        }
        getEmp();
    }
    function checkedDept(ths) {
        $(".popMsg").hide();
        getEmp();
    }
    function checkedEmp(ths) {
        $(".popMsg").hide();

    }
    function AllCheckedEmp(ths) {
        $(".popMsg").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkEmp").prop('checked', true);

        }
        else {
            $(".ClsChkEmp").prop('checked', false);
        }

    }

</script>

<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Leave Encash/Carryforward</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Leave Encash/Carryforward</span>
            </li>
        </ul>
    }
    <div class="page-toolbar text-right">
        <a href="javascript:;" class="btn icon_transparent_btn tooltips" id="Filter_search" data-placement="left" data-original-title="Filter" data-toggle="tooltip"><i class="fa-light fa-filter" aria-hidden="true"></i> </a>
    </div>
</div>
<!-- END PAGE BAR -->
<!-- END PAGE HEADER-->
@if (obj.CanView)
{

    <div class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>

    <div class="filter_portlet_wrapper full-width">
        <!-- Datatable Block : Begin -->
        <div class="portlet filter_portlet_tbl">
            <div class="portlet-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div id="tblempty">
                            <div class="table-responsive" id="tableResponsive">
                                <table class="new_datatbl table table-striped table-bordered table-hover  order-column" id="tblLeaveEncashCarry"></table>
                            </div>
                        </div>
                        <div id="NotificationGrid-empty" style="display: none">
                            <div class="datanotfound">
                                <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="No Data Found Icon">
                                <p class="datanotfound_title">No data show</p>
                                <p class="datanotfound_subtitle">Start by applying a filter to view relevant data</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Datatable Block : End -->
        <!-- Filter Block : Begin -->
        <div class="portlet filter_boxModal">
            <div class="filterbox_header">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="filter-title">Filters</h4>
                    <button type="button" class="filterclose_btn"><i class="fa-light fa-xmark"></i></button>
                </div>
            </div>
            <div class="filterbox_body">
                <div class="col-lg-12">
                    <div class="form-group">
                        <label>Company</label>
                        <select class="form-control input-sm select2" id="ddlCompany" name="ddlCompany">
                        </select>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="form-group">
                        <label>Branch</label>
                        <select class="form-control input-sm select2" id="ddlBranch" name="ddlBranch">
                        </select>
                    </div>
                </div>
            </div>
            <div class="filterbox_footer">
                <div class="text-right">
                    @if (obj.CanAdd)
                    {
                        <a href="javascript:void(0)" id="btnAddLeave" class="btn icon_btn tooltips" data-placement="left" data-original-title="Select Employee"><i class="fa-solid fa-plus"></i></a>
                    }
                </div>
            </div>
        </div>
        <!-- Filter Block : End -->
    </div>

    <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Leave Carry Forward</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="alert alert-danger popMsg" hidden>
                                <a href="#" class="close" data-dismiss="alert">&times;</a>
                                <strong id="strstg">Error ! </strong> @_error
                            </div>
                        </div>
                    </div>
                    <div class="modal-card">
                        <fieldset>
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <input type="hidden" id="OnDutyLeaveId" value="0">
                                    <input type="hidden" id="hfEmpCode" value="0">
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" id="DeptIdsContainer">
                                    <label class="control-label">Department</label>
                                    <input type="text" id="txt2" value="0" hidden />
                                    <select id="DeptIds" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%"></select>
                                </div>
                                @*<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label>Department</label>
                                        <div class="divDept">
                                            <table class="table table-striped table-bordered table-hover table-checkable order-column" id="tblDept">
                                                <thead>
                                                    <tr>
                                                        <th style="display:none">DepartmentId</th>
                                                        <th>DepartmentName</th>
                                                    </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>*@
                                @*<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label>Department</label>
                                        <div class="divDept">
                                            <table class="table table-striped table-bordered table-hover table-checkable order-column" id="tblDept"></table>
                                        </div>
                                    </div>*@
                                @*<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <label>Employee</label>
                                        <select class="form-control input-sm" id="ddlEmployee" name="ddlEmployee">
                                            <option value="0" selected>-- Select Employee --</option>
                                        </select>
                                    </div>*@
                                <div class="clearfix"></div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="divEmp margin-top-20">
                                        <label id="lblemp" hidden style="position: absolute;top: 8px;">Employee</label>
                                        <table class="table table-striped table-bordered table-hover table-checkable order-column" id="tblEmp"></table>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                            <button type="submit" id="btnSave" class="btn save_btn"><i class="fa-regular fa-gear"></i> Process</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
