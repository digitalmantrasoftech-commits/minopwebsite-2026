@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "DataReceive";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}



<script type="text/javascript">
    var token = '@_tokan';
    var webapiurl = '@_webapiurl';

    var DeptIdlst = "";
    $(document).ready(function () {
        $(".alert").hide();
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }

        var $select = $("#DeptIds").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true
        });

        // Popup code
        var navListItems = $('div.setup-panel div a'),
                allWells = $('.setup-content'),
                allNextBtn = $('.nextBtn');
        allPrevBtb = $('.prevbtn');
        allWells.hide();
        navListItems.click(function (e) {
            e.preventDefault();
            var $target = $($(this).attr('href')),
                    $item = $(this);
            if (!$item.hasClass('disabled')) {
                navListItems.removeClass('btn-primary').addClass('btn-default');
                $item.addClass('btn-primary');
                allWells.hide();
                $target.show();
                //  $target.find('input:eq(0)').focus();
            }
        });
        $("#btnSave").click(function (event) {
            var allVals = [];
            if ($("#txt2").val() == 0) {
                $(".popMsg").html("Please select at least one department").show();
                event.preventDefault();
                return false;
            }
            var allempval = [];
            $("#tblEmp .ClsChkEmp").each(function () {
                if ($(this).is(':checked') == true) {
                    allempval.push($(this).attr("id"));
                }
            });
            if (allempval.length == 0) {
                $(".popMsg").text("Please select Employee");
                $(".popMsg").show();
                event.preventDefault();
                return false;
            }
            $(".popMsg").hide();
            save();

        });

        $('div.setup-panel div a.btn-primary').trigger('click');

        $('#btnStartDownload').attr("disabled", "disabled");
        $('#btnStartDownload').unbind("click");
        $("#ddlCompany").change(function () {
            $('#btnStartDownload').attr("disabled", "disabled");
            $("#btnStartDownload").unbind("click");
            $("#ddlBranch").empty();
            $(".loading").show();
            //$("#ajax_loaderCompany").show();
            $.post("/Transactions/FillBranch?id=" + $("#ddlCompany").val(), function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                //$("#ajax_loaderCompany").hide();
                $(".loading").hide();
                if (response != null) {
                    $("#ddlBranch").append("<option value='0'>-- Select Branch --</option>");
                    for (var i = 0; i < response.length; i++) {
                        $("#ddlBranch").append("<option value='" + response[i].BranchId + "'>" + response[i].BranchName + "</option>");
                    }
                }
            });
        });
        $("#ddlBranch").change(function () {
                if ($("#ddlBranch").val() == "0") {
                    $('#btnStartDownload').attr("disabled", "disabled");
                    $("#btnStartDownload").unbind("click");
                }
                if ($("#ddlBranch").val() != "0") {
                    $("#btnStartDownload").removeAttr("disabled");
                    $("#btnStartDownload").click(function () {
                    $(".alert-danger").hide();
                    $(".alert-success").hide();
                    $("#tblEmp tbody").empty();
                    $(".ClsChkAllDept").prop('checked', false);
                    $(".ClsChkAllEmp").prop('checked', false);
                    $("#btnStartDownload").attr("data-toggle", "modal");
                    $("#btnStartDownload").attr("data-target", "#frmpopup");
                });
                }

            $("#DeptIds").empty();
            $.ajax({
                type: "POST",
                url: "/Transactions/GetDeptbyBranch?BranchId=" + $("#ddlBranch").val(),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                if (response != null) {
                    for (var i = 0; i < response.length; i++) {
                            $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                    }
                        $select.multiselect('rebuild');
                        $(document.body).on('change', '#DeptIds', function () {
                            $(".popMsg").hide();
                            var deptid = $('#DeptIds option:selected');
                            var DeptArray = [];
                            $(deptid).each(function (index, deptid) {
                                DeptArray.push([$(this).val()]);
                            });
                            if (DeptArray == "") {
                                $("#txt2").val(0);
                }
                            else {
                                $("#txt2").val(DeptArray);
                                $("#spValidation").hide();
                            }
                            var ArrDept = $("#txt2").val();
                            DeptIdlst = ArrDept;
                            getEmp();
                });
                    }
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });

            //$('#tblDept').dataTable({
            //    "ajax": {
            //        "url": '/Transactions/GetDeptbyBranch?BranchId='+$("#ddlBranch").val()+'',
            //        "dataType": 'json',
            //        "type": "POST",
            //        "dataSrc": '',
            //        "beforeSend": function (xhr) {
            //            xhr.setRequestHeader("Authorization",
            //               token);
            //        }
            //    },
            //    "columns": [
            //       { "data": "DepartmentId", "visible": false },
            //        { "data": "DepartmentName" },
            //    ]
            //});
        });
    });

    function save() {

            var allVals = [];
            $("#tblEmp .ClsChkEmp").each(function () {
                if ($(this).is(':checked') == true) {
                    allVals.push($(this).attr("id"));
                }
            });
            $.ajax({
                type: 'POST',
                url: webapiurl + "/Utility/AttendanceProcess",
                data: '{"EmpID":"' + allVals + '" }',
                contentType: "application/json",
                dataType: 'json',
                async: false,
                cache: false,
                timeout: 30000,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("Authorization", token);
                },
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    //alert(data.responseJSON.Meg);
                },
                error: function (data) {
                   // alert(data.responseJSON.Meg);
                },
                complete: function (data) {
                    alert(data.responseJSON.Meg);
                }
            });

    }

    function getEmp() {

        $("#tblEmp").empty();
      

        var bID = $("#ddlBranch").val();

        $.ajax({
            type: "POST",
            url: "/Transactions/GetEmpByDept?empArr=" + DeptIdlst + ";" + bID,
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
            var table = "";
            if (response != null) {
                for (var i = 0; i < response.length; i++) {

                    var tbl = "<tr class='odd gradeX'>";
                    tbl = tbl + "<td id='eid' hidden>" + response[i].EmpId;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='ecode'>" + response[i].Empcode;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='enm'>" + response[i].EmpName;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='epid'>" + response[i].EmpPunchID;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id=''><input type='checkbox' onchange='checkedDept(this)' class='ClsChkEmp' id='" + response[i].EmpId + "'/>";
             
                    tbl = tbl + "</td>";
                    tbl = tbl + "</tr>";
                    table += tbl;
                }
            }
            $("#tblEmp").destroy;
            $('#tblEmp').append(table);
            $('#tblEmp').dataTable({
                // "data": data.d,
                "columnDefs": [
                                     {
                                         "targets": [0],
                                         "visible": false,
                                         "searchable": false,
                                     }

                ],
                "destroy": true,
                    "bInfo": false,
                    "bPaginate": false,
                    "bLengthChange": false,
                "columns": [
                    { "title": "Employee ID" },
                     { "title": "Code" },
                    { "title": "Employee Name" },
                    { "title": "Punch ID" },
                    { "title": "<input type='checkbox' class='ClsChkAllDept' onchange='AllCheckedEmp(this)' />" }
                ]
            });
                $(".loading").hide();
            },
            beforeSend: function () {
                $(".loading").show();
            },
            error: function () {
                $(".loading").hide();
            }
        });
    }
    function Clear() {
        $("#ddlCompany").val("0");
        $("#ddlBranch").empty();
        $(".alert-danger").hide();
        $(".alert-success").hide();
        $("#tblEmp tbody").empty();
        $("#tblDept tbody").empty();
        $(".ClsChkAllDept").prop('checked', false);
        $(".ClsChkAllEmp").prop('checked', false);
        var nextStepWizard = $('div.setup-panel div a[href="#step-1"]').parent().children("a");
        nextStepWizard.removeAttr('disabled').trigger('click');
        $('#btnStartDownload').attr("disabled", "disabled");
    }
    function AllCheckedDept(ths) {
        $(".popMsg").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkDept").prop('checked', true);

        }
        else {
            $(".ClsChkDept").prop('checked', false);
        }

    }
    function AllCheckedEmp(ths) {
        if ($(ths).prop('checked') == true) {
            $(".popMsg").hide();
            $(".ClsChkEmp").prop('checked', true);

        }
        else {
            $(".ClsChkEmp").prop('checked', false);
        }

    }
    function checkedDept(ths) {
        $(".popMsg").hide();
    }
</script>

<div class="page-bar">
    @if (_RoleId == 1)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Data Receive</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Data Receive</span>
            </li>
        </ul>
    }
</div>
<!-- END PAGE BAR -->
<!-- END PAGE HEADER-->
@if (obj.CanView)
{
<div class="row">
    <div class="col-md-12">
        <div class="portlet">
            <div class="portlet-title">
                <div class="row">
                    <div class="col-md-8">
                        <div class="row">
                            <div class="form-group col-md-6">

                                <select class="form-control input-sm col-md-8 select2" id="ddlCompany" name="ddlCompany">
                                    <option value="0" selected>Select Company</option>
                                    @foreach (var item in ViewBag.CompanyList as IEnumerable<SelectListItem>)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group col-md-6">

                                <select class="form-control input-sm col-md-7 select2" id="ddlBranch" name="ddlBranch">
                                    <option value="0" selected disabled>Select Branch</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        @if (obj.CanAdd)
                        {
                            <a href="#" id="btnStartDownload" class="btn blue btn-sm" style="float:right"> <i class="fa-regular fa-download"></i> Select Employee</a>
                        }
                    </div>
                </div>
            </div>
            <div class="portlet-body">                
                <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                    <div class="modal-dialog">
                        <!-- Modal content-->
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal">&times;</button>
                                <h4 class="modal-title">Data Receive</h4>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-danger popMsg" hidden>
                                    <a href="#" class="close" data-dismiss="alert">&times;</a>
                                    <strong id="strstg">Error ! </strong> @_error
                                </div>
                                <div class="modal-card">
                                    <fieldset>
                                        <div class="col-md-12">
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <label class="control-label">Department</label>
                                                    <input type="text" id="txt2" value="0" hidden />
                                                    <select id="DeptIds" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%"></select>
                                                </div>
                                                <div class="clearfix"></div>
                                                <div class="col-md-12">
                                                    <div class="divEmp margin-top-20">
                                                        <label class="pull-left" style=" margin-bottom:-25px;" id="lblemp" hidden>Employee</label>
                                                        <table class="table table-striped table-bordered table-hover table-checkable order-column" id="tblEmp"></table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <div class="row">
                                    <div class="col-md-12 text-right">
                                        @*<button class="btn blue btn-sm  nextBtn pull-right" id="frstNext" type="button">Next <i class="fa-light fa-angle-right"></i></button>*@
                                        <button type="button" class=" btn btn-sm blue" id="btnSave"> <i class="fa-light fa-arrows-retweet"></i> Start Process</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12 clsTable">
                    <table class="table table-striped table-bordered table-hover table-checkable order-column" id="tblManualPunch"></table>
                </div>
            </div>
        </div>
    </div>
</div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}




<div class="modal_bg loading" aria-hidden="true">
    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
</div>


<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>




