            return false;
        } else {
            $("#FromDate").removeClass('field_error');
        }

        // Validation for ToDate
        if (toDt == "") {
            $("#ToDate").addClass('field_error');
            event.preventDefault();
            return false;
        } else {
            $("#ToDate").removeClass('field_error'); // Fixed typo: from 'filed_error' to 'field_error'
        }

        var fromDate = $("#FromDate").val();
        var toDate = $("#ToDate").val();

        // Compare dates
        if (fromDate > toDate) {
            toastr.remove();
            toastr.error("To date should be greater than from date.");
            return false;
        }

        var empId = $("#EmpId").val();

        // Validation for EmpId
        if (empId == "" || empId == null) {
            toastr.remove();
            toastr.error("Please select at least one employee.");
            event.preventDefault();
            return false;
        }

        var selectedEmp = [];
        var DID = $("#ddldevice").val();

        // Date format conversion
        if ("@_isdateformat" == "dd-mm-yyyy") {
            var _fromDate = fromDate.split("-");
            fromDate = _fromDate[2] + "-" + _fromDate[1] + "-" + _fromDate[0];

            var _toDate = toDate.split("-");
            toDate = _toDate[2] + "-" + _toDate[1] + "-" + _toDate[0];

        } else if ("@_isdateformat" == "mm-dd-yyyy") {
            var _fromDate = fromDate.split("-");
            fromDate = _fromDate[2] + "-" + _fromDate[0] + "-" + _fromDate[1];

            var _toDate = toDate.split("-");
            toDate = _toDate[2] + "-" + _toDate[0] + "-" + _toDate[1];

        } else if ("@_isdateformat" == "yyyy-mm-dd") {
            var _fromDate = fromDate.split("-");
            fromDate = _fromDate[0] + "-" + _fromDate[1] + "-" + _fromDate[2];

            var _toDate = toDate.split("-");
            toDate = _toDate[0] + "-" + _toDate[1] + "-" + _toDate[2];

        } else if ("@_isdateformat" == "yyyy-M-dd") {
            var _fromDate = fromDate.split("-");
            var getMonth = _fromDate[1];
            fromDate = _fromDate[0] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _fromDate[2];

            var _toDate = toDate.split("-");
            getMonth = _toDate[1];
            toDate = _toDate[0] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _toDate[2];

        } else if ("@_isdateformat" == "M-dd-yyyy") {
            var _fromDate = fromDate.split("-");
            var getMonth = _fromDate[0];
            fromDate = _fromDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _fromDate[1];

            var _toDate = toDate.split("-");
            getMonth = _toDate[0];
            toDate = _toDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _toDate[1];

        } else if ("@_isdateformat" == "dd-M-yyyy") {
            var _fromDate = fromDate.split("-");
            var getMonth = _fromDate[1];
            fromDate = _fromDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _fromDate[0];

            var _toDate = toDate.split("-");
            getMonth = _toDate[1];
            toDate = _toDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _toDate[0];
        }

        var totalOptions = $('#EmpId option').length;
        var selectedOptions = $('#EmpId :selected').length;
        $('#EmpId :selected').each(function () {
            if (selectedOptions === totalOptions) {
                selectedEmp = "0";
            } else if (selectedEmp == "") {
                selectedEmp = $(this).val();
            } else {
                selectedEmp += "," + $(this).val();
            }
        });
        var EmployeeId = selectedEmp;

        var selecteddevice = [];
        var totalOptions_device = $('#ddldevice option').length;
        var selectedOptions_device = $('#ddldevice :selected').length;

        $('#ddldevice :selected').each(function () {

            if (selecteddevice == "") {
                selecteddevice = $(this).val();
            }
            else {
                selecteddevice += "," + $(this).val();
            }
        });


        var obj = { "DeviceID": selecteddevice, "FromDate": fromDate, "ToDate": toDate, "EmpId": EmployeeId, flag: "excel" };
        $.ajax({
            type: "POST",
            "url": "/Transactions/TransactionmonitorFilter?jsondata=" + JSON.stringify(obj),
            "data": JSON.stringify(obj),
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loaderCompany").show();
            },
            success: function (data) {


                try {
                    /*    const parsedData = JSON.parse(data);*/
                    const worker = new Worker('/app_assets/js/worker.js');
                    worker.postMessage({ data: data});
                    worker.onmessage = function (e) {
                        const message = e.data;
                        if (message.action === 'download') {
                            const blob = new Blob([message.data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                            const url = URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;
                            a.download = 'TransactionMonitor.xlsx';
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                            setTimeout(() => URL.revokeObjectURL(url), 100);
                        } else if (message.action === 'error') {
                            toastr.error("Error: " + message.message);
                        }
                        $("#ajax_loaderCompany").hide();
                        isDownloadInProgress = false;
                    };

                    worker.onerror = function (error) {
                        toastr.error("Worker error: " + (error.message || "Unknown error"));
                        $("#ajax_loaderCompany").hide();
                        isDownloadInProgress = false;
                    };

                    isDownloadInProgress = true;
                } catch (error) {
                    toastr.error("Error: " + error.message);
                    $("#ajax_loaderCompany").hide();
                    isDownloadInProgress = false;
                }
            },
            complete: function () {
                $("#ajax_loaderCompany").hide();
            }
        });


    }
