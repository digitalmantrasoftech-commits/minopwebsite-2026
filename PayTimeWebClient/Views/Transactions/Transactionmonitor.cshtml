                var _fromDate = $("#FromDate").val().split("-");
                var fromDate = _fromDate[2] + "-" + _fromDate[0] + "-" + _fromDate[1];
                var _toDate = $("#ToDate").val().split("-");
                var toDate = _toDate[2] + "-" + _toDate[0] + "-" + _toDate[1];
            }
            else if ("@_isdateformat" == "yyyy-mm-dd") {
                var _fromDate = $("#FromDate").val().split("-");
                var fromDate = _fromDate[0] + "-" + _fromDate[1] + "-" + _fromDate[2];
                var _toDate = $("#ToDate").val().split("-");
                var toDate = _toDate[0] + "-" + _toDate[1] + "-" + _toDate[2];
            }
            else if ("@_isdateformat" == "yyyy-M-dd") {
                var _fromDate = $("#FromDate").val().split("-");
                var getMonth = _fromDate[1];
                var fromDate = _fromDate[0] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _fromDate[2];
                var _toDate = $("#ToDate").val().split("-");
                var getMonth = _toDate[1];
                var toDate = _toDate[0] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _toDate[2];
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {
                var _fromDate = $("#FromDate").val().split("-");
                var getMonth = _fromDate[0];
                var fromDate = _fromDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _fromDate[1];
                var _toDate = $("#ToDate").val().split("-");
                var getMonth = _toDate[0];
                var toDate = _toDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _toDate[1];
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {
                var _fromDate = $("#FromDate").val().split("-");
                var getMonth = _fromDate[1];
                var fromDate = _fromDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _fromDate[0];
                var _toDate = $("#ToDate").val().split("-");
                var getMonth = _toDate[1];
                var toDate = _toDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _toDate[0];
            }
            $.ajax({
                type: "GET",
               url: "/Transactions/GetEmployeeByDeviceId?DeviceId=" + deviceid + "&fromdate=" + fromDate + "&ToDate=" + toDate + "&branchid=" + branchid + "&companyid=" + companyid,
		/*url: "/Transactions/GetEmployeeByDeviceId?DeviceId=" + deviceid + "&fromdate=" + fromDate + "&ToDate=" + toDate,*/
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {

                    if (response != null) {
                        currentData = response.sort((a, b) => a.EmpName.localeCompare(b.EmpName));
                        populateDropdown(currentData);
                    }
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
        }
        function populateDropdown(data) {
            $('#EmpId').empty();

            const empIdSet = new Set();

            data.forEach(item => {
                if (!empIdSet.has(item.EmpId)) {
                    // If EmpId is not in the Set, append the option and add EmpId to the Set
                    $('#EmpId').append('<option value="' + item.EmpId + '">' + item.EmpName + " (" + item.empcode +")" + '</option>');
            empIdSet.add(item.EmpId); // Add the EmpId to the Set to mark it as processed
        }
    });
    $EmpSelect.multiselect('rebuild');
    }
    function filterDropdown(query) {
        const filteredData = currentData.filter(item => item.EmpName.toLowerCase().includes(query.toLowerCase()));
        populateDropdown(filteredData);
    }
