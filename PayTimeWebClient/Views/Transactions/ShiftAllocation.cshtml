         var startIndex = 0;
        var isFetching = false;
        var fetchedEmpIds = new Set(); // Store fetched EmpIds to prevent duplicates
        var debounceTimer;
        var lastScrollTop = 0; // Track last scroll position
        var latestRequestId = 0; // Track the latest request
        var totalLoadedRecords = 0; // Track total records loaded
        var tableInstance;
        var _isServerSide = false;
        var isSelectAllChecked = false;

        function getEmp_load()
        {
            isSelectAllChecked = false;
            selectedEmpIds.clear();
            fetchedEmpIds.clear();
            var commonConfig = {};
            var bID = $("#ddlBranch").val();
            var pageSize = 50;
            let isSelectedAll = $("#DeptIdsContainer li").hasClass("multiselect-item multiselect-all active") == true ? 1 : 0;
            let searchTerm = "";
            if ($("#DeptIdsContainer li input").hasClass("multiselect-search")) {
                searchTerm = $("#DeptIdsContainer li .multiselect-search").val().trim();
            }

           var mainObj =
            {
                "RoleId": "@_RoleId",
                "CompanyIds": $("#ddlCompany").val(),
                "BranchId": bID,
               "DepartmentId": DeptIdlst,
                "DataGridValues":"@_DatagridEmpListThsold",
                "pageSize": pageSize,
                "page": "1",
                "sortColumn": "1",
                "sortOrder": "1",
                "LoginEmpId": 0,
                "SelectAll": isSelectedAll,
                "SelectAllSearchTerm": searchTerm
         };

        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: webapiurl + 'DataGridOptimize/EmployeeGetDataWithLazyLoading',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(mainObj),
            beforeSend: function () {
                $("#loader_tblEmployee").show();
            },
             success: function (response) {
            if (response && response.Data.length > 0)
            {
                $("#loader_tblEmployee").hide();
                var totalRecordCount = response.TotalRecords;
                var data = response.Data;
                _isServerSide = totalRecordCount > mainObj.DataGridValues;
                data.forEach(row => fetchedEmpIds.add(row.EmpId));
                totalLoadedRecords = data.length;
                startIndex = totalLoadedRecords;

                commonConfig =
                {
                    "processing": false,
                    "searching": false,
                    "ordering": true,
                    "paging": false,
                    "info": false,
                    "lengthChange": true,
                    "destroy": true,
                    "deferRender": true,
                    "order": [[2, 'asc']],
                   /* "columnDefs": [{ "targets": [0], "visible": false, "searchable": false }], */
                    "columns": [
                        { "title": "Code", "data": "Empcode" },
                        { "title": "Employee Name", "data": "EmpName" },
                        { "title": "Punch ID", "data": "EmpPunchID" },
                        {
                            "title": "<input type='checkbox' class='ClsChkAllDept' onchange='AllCheckedEmp(this)' />",
                            "data": null,
                            "orderable": false,  // Prevents sorting on the checkbox column
                            "className": "text-center",  // Aligns checkbox to center
                            "render": function (data, type, row) {
                                return `<div class='text-center'>
                            <input type='checkbox' class='ClsChkEmp' id='${row.EmpId}' onchange='checkedDept(this)'/>
                             </div>`;
                            }
                        }
                    ]
                };

                if (_isServerSide)
                {
                    commonConfig.serverSide = false;
                    commonConfig.searching = true,
                    commonConfig.ordering = true,
                    commonConfig.processing = true;
                    commonConfig.data = data;
                }
                else
                {
                    commonConfig.serverSide = false; // Disable server-side processing
                    commonConfig.ajax = null; // Use the initial data provided
                    commonConfig.data = data;
                    commonConfig.searching = true,
                    commonConfig.deferRender = true; // For performance with large data
                }
            }

            tableInstance = $('#tblEmp').DataTable(commonConfig);

            function debounce(func, wait) {
                var timeout;
                return function () {
                    var context = this;
                    var args = arguments;
                    if (timeout) {
                        clearTimeout(timeout);
                    }
                    timeout = setTimeout(function () {
                        timeout = null;
                        func.apply(context, args);
                    }, wait);
                };
            }
            const handleScroll = debounce(function ()
            {
                var $this = $(this);
                var scrollTop = $this.scrollTop();
                var scrollHeight = this.scrollHeight;
                var clientHeight = this.clientHeight;
                var isScrollingDown = scrollTop > lastScrollTop;

                if (_isServerSide && isScrollingDown &&
                    scrollTop + clientHeight >= scrollHeight - 50 &&
                    !isFetching &&
                    startIndex < totalRecordCount)
                {
                    if (startIndex < 50) return;
                    isFetching = true;
                    latestRequestId++;
                    const currentRequestId = latestRequestId;
                    fetchNextRecords(startIndex, currentRequestId, function (newData, requestId)
                    {
                        if (requestId !== latestRequestId)
                        {
                            isFetching = false;
                            return;
                        }

                        if (newData.length > 0)
                        {
                            const uniqueNewData = newData.filter(row =>
                            {
                                const isDuplicate = fetchedEmpIds.has(row.EmpId);
                                if (isDuplicate)
                                {

                                }
                                return !isDuplicate;
                            });

                            if (newData.length > 0)
                            {

                                const uniqueNewData = newData.filter(row => !fetchedEmpIds.has(row.EmpId));
                                const empIdArrayToCheck = [];
                                uniqueNewData.forEach(row => {
                                    fetchedEmpIds.add(row.EmpId);
                                    empIdArrayToCheck.push(row.EmpId);
                                    // Add row to the DataTable
                                    const newRow = tableInstance.row.add(row).node();

                                    // Auto-check the checkbox if EmpId is in our Set
                                    const checkbox = $(newRow).find('.ClsChkEmp');
                                    checkbox.prop('checked', true);
                                    checkedDept(checkbox[0]); // Trigger additional logic
                                });

                                // Redraw the table once after adding all rows
                                tableInstance.draw(false);

                                // Update counters
                                totalLoadedRecords += uniqueNewData.length;
                                startIndex = totalLoadedRecords;

                                // Optionally, call checkEmpCheckboxesByIds to ensure any existing rows are checked
                                checkEmpCheckboxesByIds(empIdArrayToCheck);
                                //totalLoadedRecords += newData.length;
                                //startIndex = totalLoadedRecords;
                            }
                        }
                        isFetching = false;
                    });
                }
                else if (!isScrollingDown)
                {

                }
                lastScrollTop = scrollTop;
            }, 300);

                 if (_isServerSide) {
                     const intervalId = setInterval(() => {
                         const $scrollContainer = $('#tblEmp_wrapper .table-scrollable');
                         const container = $scrollContainer[0];

                         if (container && container.scrollHeight > container.clientHeight) {
                             $scrollContainer.off('scroll').on('scroll', handleScroll);
                             clearInterval(intervalId);
                         }
                     }, 1000);
                 }
                 else {
                     $('#tblEmp_wrapper .table-scrollable').off('scroll'); // Ensure no scroll event for client-side
                 }

            //if (_isServerSide)
            //{
            //    $('#tblEmp_wrapper .table-scrollable').off('scroll').on('scroll', handleScroll);
            //}
            //else
            //{
            //    $('#tblEmp_wrapper .table-scrollable').off('scroll'); // Ensure no scroll event for client-side
            //}
        },
        error: function (jqXHR, textStatus, errorThrown)
        {
            console.error('AJAX Error:', textStatus, errorThrown);
        },
        complete: function ()
            {
                $(".loading").hide();
            }
            });
    }

    function checkEmpCheckboxesByIds(empIdArray)
    {
        if (!Array.isArray(empIdArray) || empIdArray.length === 0) {
            console.warn('Invalid or empty EmpId array provided.');
            return;
        }
        if (isSelectAllChecked) {
            // Iterate through each EmpId in the array
            empIdArray.forEach(empId => {
                // Find the checkbox with the matching EmpId
                const checkbox = $(`#tblEmp .ClsChkEmp[id="${empId}"]`);
                if (checkbox.length > 0) {
                    selectedEmpIds.add(empId);
                    checkbox.prop('checked', true);
                    checkedDept(checkbox[0]); // Trigger associated logic
                } else {
                    console.warn(`Checkbox for EmpId ${empId} not found in the table.`);
                }
            });
        }
    }
        function checkSelectedIds() {
            if (selectedEmpIds.size() > 0) {
                for (let id in selectedEmpIds) {
                    const checkbox = $(`#tblEmp .ClsChkEmp[id="${id}"]`);
                    if (checkbox.length > 0) {
                        selectedEmpIds.add(empId);
                        checkbox.prop('checked', true);
                        checkedDept(checkbox[0]); // Trigger associated logic
                    } else {
                        console.warn(`Checkbox for EmpId ${empId} not found in the table.`);
                    }
                }
            }
        }
        function fetchNextRecords(startIndex, requestId, callback, searchValue) {
            let isSelectedAll = $("#DeptIdsContainer li").hasClass("multiselect-item multiselect-all active") == true ? 1 : 0;
            let searchTerm = "";
            if ($("#DeptIdsContainer li input").hasClass("multiselect-search")) {
                searchTerm = $("#DeptIdsContainer li .multiselect-search").val().trim();
            }
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '/DataGridOptimize/GetLazyLoadingGetEmployee',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify({
                start: startIndex,
                length: 50,
                RoleId: "@_RoleId",
                CompanyIds: $("#ddlCompany").val(),
                BranchId: $("#ddlBranch").val(),
                DepartmentId: DeptIdlst,
                DatagridThresold:"@_DatagridEmpListThsold",
                search: {
                    value: $("#tblEmp_filter input").val().trim() || ''
                },
                SelectAllDept: isSelectedAll,
                SelectAllSearchTermDept: searchTerm
                
            }),
            beforeSend: function ()
            {
                $("#loader_tblEmployee").show();
            },
            success: function (response) {
                if (response && response.data && response.data.length > 0)
                {
                    callback(response.data, requestId);
                }
                else
                {
                    callback([], requestId);
                }
            },
            error: function (jqXHR, textStatus, errorThrown)
            {
                console.error('Error fetching records for request ID:', requestId, textStatus, errorThrown);
                callback([], requestId);
            },
            complete: function () {
                $("#loader_tblEmployee").hide();
            }
        });
    }
        function syncSelectAllState() {
            $('.ClsChkAllDept').prop('checked', false);
            isSelectAllChecked = false;
        }
