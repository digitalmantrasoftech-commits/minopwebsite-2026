    function generateShiftExcelFile(_Date, classMasterValue) {
    checkSession();
    var DtFlag = _Date
    $.ajax({
        url: "/Transactions/DownloadShiftAllocationErrList",
        type: "GET",
        headers: { 'Authorization': '@_tokan' },
        data: { DtFlag: _Date },
        contentType: "application/json; charset=utf-8",
        datatype: "json",
        success: function (data) {
            if (typeof data === "string") {
                try {
                    data = JSON.parse(data);
                } catch (error) {
                    toastr.error("Failed to parse data.");
                    $("#btnDownloadErrorList").prop('disabled', false);
                    return;
                }
            }
            if (!Array.isArray(data)) {
                toastr.error("Unexpected data format received.");
                $("#btnDownloadErrorList").prop('disabled', false);
                return;
            }
            if (data.length === 0) {
                toastr.error("No entry found in excel.");
            } else if (data.isRedirect) {
                window.location.href = data.redirectUrl;

            } else {
                try {
                    function stripHtmlTags(input) {
                        if (typeof input === 'string') {
                            return input.replace(/<[^>]+>/g, '').trim();
                        }
                        return input;
                    }
                     const formattedData = data.map(item => ({
                         EmpCode: item.EmpCode,
                         ShiftName: item.ShiftName,
                         Fromdate: item.Fromdate,
                         Todate: item.Todate,
                         Reason: item.Reason
                     }));

                    var worksheet = XLSX.utils.json_to_sheet(formattedData);
                    var workbook = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(workbook, worksheet,"ShiftAllocation");

                    // Apply styles to the header row
                    const range = XLSX.utils.decode_range(worksheet['!ref']);
                    const headerRow = range.s.r;

                    for (let col = range.s.c; col <= range.e.c; col++) {
                        const cellAddress = XLSX.utils.encode_cell({ r: headerRow, c: col });
                        if (!worksheet[cellAddress]) continue;

                        // Add styling properties to the header cells
                        worksheet[cellAddress].s = {
                            font: { bold: true, color: { rgb: "FFFFFF" } },
                            fill: { fgColor: { rgb: "4CAF50" } },
                            alignment: { horizontal: "center" }
                        };
                    }

                    // Optional: Set column widths for better readability
                    worksheet['!cols'] = [
                        { wch: 15 },
                        { wch: 25 },
                        { wch: 20 },
                        { wch: 20 },
                        { wch: 100  }
                    ];

                    XLSX.writeFile(workbook, 'ShiftAllocation.xlsx');
                    $("#btnDownloadErrorList").prop('disabled', false);

                } catch (error) {
                    $("#btnDownloadErrorList").prop('disabled', false);

                }
            }
        },
        error: function (jqXHR, ajaxOptions, thrownError) {
            if (jqXHR.status == 500) { //InternalServerError = 500,
                toastr.error("InternalServerError");
            } else if (jqXHR.status == 400) { //BadRequest = 400,
                toastr.error("BadRequest");
            } else if (jqXHR.status == 401) {
                window.location.href = "/PayTime/LoginPage";
            }
        }
    });
}
