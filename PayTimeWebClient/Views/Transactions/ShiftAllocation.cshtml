        function save() {
            if (valid()) {
                var allVals = [];
                //$("#tblEmp .ClsChkEmp").each(function ()
                //{
                //    if ($(this).is(':checked') == true) {
                //        allVals.push($(this).attr("id"));
                //    }
                //});

                var bID = $("#ddlBranch").val();
                var CID = $("#ddlCompany").val();
                var _chkselectallflage = isSelectAllChecked ? 1 : 0;
                allVals = Array.from(selectedEmpIds);
                if (_chkselectallflage == 1)
                {
                    allVals = null; // Use null instead of an empty string
                }
                let isSelectedAll = $("#DeptIdsContainer li").hasClass("multiselect-item multiselect-all active") == true ? 1 : 0;
                let searchTerm = "";
                if ($("#DeptIdsContainer li input").hasClass("multiselect-search")) {
                    searchTerm = $("#DeptIdsContainer li .multiselect-search").val().trim();
                }
                var ShiftAlloc = {
                    "ShiftID": parseInt($("#ddlShift").val()),
                    "FromDt": $("#txtFromDate").val(),
                    "ToDt": $("#txtToDate").val(),
                    "SelectAllFlage": _chkselectallflage,
                    "SelectAllSearchTerm": $('#tblEmp').DataTable().search(),
                    "EmpArr": allVals,
                    "CompanyID": CID,
                    "BranchID": bID,
                    "DepartmentID": DeptIdlst,
                    "SelectAllDept": isSelectedAll,
                    "SelectAllSearchTermDept": searchTerm
                };
                $.ajax({
                    type: "POST",
                    url: "/Transactions/ShiftAllocation?ShiftAlloc=" + JSON.stringify(ShiftAlloc),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    async: "false",
                    success: function (response) {
                        if (response.isRedirect) {
                            window.location.href = response.redirectUrl;
                        }
                        if (response != null) {
                            if (response == "OK") {
                                Clear();
                                $('#frmpopup').modal('toggle');
                                toastr.remove();
                                toastr.success("Shift allocated sucessfully.");
                                GetAllShiftAllocation();
                                $("#shiftFromDate").trigger('change');
                            }
                            else {
                                toastr.remove();
                                toastr.error(response);
                            }
                        }
                        $(".loading").hide();
                    },
                    beforeSend: function () {
                        $(".loading").show();
                    },
                    error: function () {
                        $(".loading").hide();
                    }
                });
            }
        }
        function GetAllShiftAllocation()
        {
            if ("@_isdateformat" == "dd-mm-yyyy")
            {
                var fromDate = $("#FilterFromDate").val().split("-");
                var fromdt = fromDate[2] + "-" + fromDate[1] + "-" + fromDate[0];
                var toDate = $("#FilterToDate").val().split("-");
                var todt = toDate[2] + "-" + toDate[1] + "-" + toDate[0];
                if (fromdt == 'undefined-undefined-')
                {
                    fromdt = "";
                }
                if (todt == 'undefined-undefined-')
                {
                    todt = "";
                }
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                var fromDate = $("#FilterFromDate").val().split("-");
                var fromdt = fromDate[2] + "-" + fromDate[0] + "-" + fromDate[1];
                var toDate = $("#FilterToDate").val().split("-");
                var todt = toDate[2] + "-" + toDate[0] + "-" + toDate[1];
                if (fromdt == 'undefined--undefined') {
                    fromdt = "";
                }
                if (todt == 'undefined--undefined') {
                    todt = "";
                }
            }
            else if ("@_isdateformat" == "yyyy-mm-dd") {
                var fromDate = $("#FilterFromDate").val().split("-");
                var fromdt = fromDate[0] + "-" + fromDate[1] + "-" + fromDate[2];
                var toDate = $("#FilterToDate").val().split("-");
                var todt = toDate[0] + "-" + toDate[1] + "-" + toDate[2];
                if (fromdt == '-undefined-undefined') {
                    fromdt = "";
                }
                if (todt == '-undefined-undefined') {
                    todt = "";
                }
            }
            else if ("@_isdateformat" == "yyyy-M-dd") {
                var _fromDate = $("#FilterFromDate").val().split("-");
                var getMonth = _fromDate[1];
                if ($("#FilterFromDate").val() != "")
                {
                    var fromdt = _fromDate[0] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _fromDate[2];
                }
                else {
                    var fromdt = '-undefined-undefined';
                }
                var _toDate = $("#FilterToDate").val().split("-");
                var getMonth = _toDate[1];
                if ($("#FilterToDate").val() != "")
                {
                    var todt = _toDate[0] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _toDate[2];
                }
                else {
                    var todt = '-undefined-undefined';
                }
                if (fromdt == '-undefined-undefined') {
                    fromdt = "";
                }
                if (todt == '-undefined-undefined') {
                    todt = "";
                }
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {
                var _fromDate = $("#FilterFromDate").val().split("-");
                var getMonth = _fromDate[0];
                if ($("#FilterFromDate").val() != "") {
                    var fromdt = _fromDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _fromDate[1];
                }
                else {
                    var fromdt = 'undefined--undefined';
                }
                var _toDate = $("#FilterToDate").val().split("-");
                var getMonth = _toDate[0];
                if ($("#FilterToDate").val() != "") {
                    var todt = _toDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _toDate[1];
                }
                else {
                    var todt = 'undefined--undefined';
                }
                if (fromdt == 'undefined--undefined') {
                    fromdt = "";
                }
                if (todt == 'undefined--undefined') {
                    todt = "";
                }
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {
                var _fromDate = $("#FilterFromDate").val().split("-");
                var getMonth = _fromDate[1];
                if ($("#FilterFromDate").val() != "") {
                    var fromdt = _fromDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _fromDate[0];
                }
                else {
                    var fromdt = 'undefined-undefined-';
                }
                var _toDate = $("#FilterToDate").val().split("-");
                var getMonth = _toDate[1];
                if ($("#FilterToDate").val() != "") {
                    var todt = _toDate[2] + "-" + (GetMonthNumber(getMonth).toString().length > 1 ? GetMonthNumber(getMonth) : "0" + GetMonthNumber(getMonth)) + "-" + _toDate[0];
                }
                else {
                    var todt = 'undefined-undefined-';
                }
                if (fromdt == 'undefined-undefined-') {
                    fromdt = "";
                }
                if (todt == 'undefined-undefined-') {
                    todt = "";
                }
            }
            $("#tblShiftAllocation").empty();
            var bID = $("#ddlBranch").val();
            if (bID == null) {
                bID = 0;
            }
            $("#dataTables_tbl_header").remove();
            $("#tblShiftAllocation").DataTable({
                dom: _domCommon,
                language: _languageCommon,
                "serverSide": true,
                "destroy": true,
                "pageLength": 10,
                "ajax": {
                    "url": "/Transactions/GetAllShiftAllocation",
                    "type": "POST",
                    "contentType": "application/json; charset=utf-8",
                    "data": function (d) {
                        d.BranchID = parseInt(bID);
                        d.fromdt = fromdt;
                        d.todt = todt;
                        d.searchValue = d.search.value;
                        return JSON.stringify(d);
                    }
                },
                "columns": [
                    { "data": "EmpName", "title": "Employee Name" },
                    { "data": "EmpPunchId", "title": "Emp PunchId" },
                    {
                        "data": "ShiftName",
                        "title": "Shift Name",
                        "render": function (data) {
                            if (data === "Week Off") {
                                return `<span class='label label-sm label-danger'>${data}</span>`;
                            } else if (data === "Holiday") {
                                return `<span class='label label-sm label-success' style='background-color: #ed6b75;'>${data}</span>`;
                            } else if (!data) {
                                return `<span class='label label-sm label-success' style='background-color: #ed6b75;'>NA</span>`;
                            } else {
                                return `<span class='label label-sm label-info'>${data}</span>`;
                            }
                        }
                    },
                    { "data": "ShiftDateStr", "title": "Shift Date" }
                ],
                "lengthMenu": [10, 100, 500, 1000],
                initComplete: function () {
                    if ($('#export-button').length) {
                        $('#export-button').remove();
                    }
                },
            });

            setTimeout(function () {
                $("#" + "tblShiftAllocation" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                $('.tooltips').tooltip();
            }, 100);

            $(".loading").hide();
            $('.tooltips').tooltip();
        }



    });


