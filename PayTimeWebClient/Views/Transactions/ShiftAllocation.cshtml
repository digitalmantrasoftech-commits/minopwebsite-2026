    function getEmp() {
        $("#tblEmp").empty();
        var allVals = [];

        $("#tblDept .ClsChkDept").each(function () {
            if ($(this).is(':checked') == true) {
                allVals.push($(this).attr("id"));
            }
        });
        var bID = $("#ddlBranch").val();
        $.ajax({
            type: "POST",
            url: "/Transactions/GetEmpByDept?empArr=" + DeptIdlst + ";" + bID,
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                var table = "";
                if (response != null) {
                    for (var i = 0; i < response.length; i++) {

                        var tbl = "<tr class='odd gradeX'>";
                        tbl = tbl + "<td id='eid' hidden>" + response[i].EmpId;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='ecode'>" + response[i].Empcode;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='enm'>" + response[i].EmpName;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id='epid'>" + response[i].EmpPunchID;
                        tbl = tbl + "</td>";
                        tbl = tbl + "<td id=''><input type='checkbox' onchange='checkedDept(this)' class='ClsChkEmp' id='" + response[i].EmpId + "'/>";
                        tbl = tbl + "</td>";
                        tbl = tbl + "</tr>";
                        table += tbl;
                    }
                }
                $("#tblEmp").destroy;
                $('#tblEmp').append(table);
                $('#tblEmp').dataTable({
                    "columnDefs": [
                                    {
                                        "targets": [0],
                                        "visible": false,
                                        "searchable": false,
                                    }

                    ],
                    "destroy": true,
                    "bInfo": false,
                    "bPaginate": false,
                    "bLengthChange": false,
                    "columns": [
                        { "title": "Employee ID" },
                        { "title": "Code" },
                        { "title": "Employee Name" },
                        { "title": "Punch ID" },
                        { "title": "<input type='checkbox' class='ClsChkAllDept' onchange='AllCheckedEmp(this)' />" }
                    ],
                    "order": [[2, 'asc']]
                });
                $(".loading").hide();
            },
            beforeSend: function () {
                $(".loading").show();
            },
            error: function () {
                $(".loading").hide();
            }
        });
    }

