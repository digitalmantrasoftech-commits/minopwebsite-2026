    function generateShiftgriddata(userid) {
    $.ajax({
        url: '@_webapiurl' + "Transaction/GetExcelShiftAllocationGridData?userid=" + userid,
        type: "GET",
        headers: { 'Authorization': '@_tokan' },
        contentType: "application/json; charset=utf-8",
        datatype: "json",
        success: function (response) {
            if (response && response.length > 0) {
                $("#tblshiftAllocationBulkUpload").show();
                if ($.fn.dataTable.isDataTable('#tblshiftAllocationBulkUpload')) {
                    $('#tblshiftAllocationBulkUpload').DataTable().clear().destroy();
                }
                var tableData = [];
                for (var i = 0; i < response.length; i++) {
                    var row = [];
                    row.push(i + 1);
                    row.push(response[i].Startdate);
                    if (response[i].Status === "Success") {
                        row.push("<div id = 'row_" + i +"' style='display: flex;'> <span class='green_font'>" + response[i].Status + "</span></div>");
                    } else if (response[i].Status === "Pending") {
                        row.push(
                            "<div id ='row_" + i +"' style='display: flex;'>"+
                            "<div class='orange_font' id='statusShift_" + i +"'>" + response[i].Status + "</div>" +
                            "<div class='loading1' style='width: 100px; margin: 0 8px;'>" +
                            "<div class='progress' style='margin-bottom: 0;'>" +
                            "<div class='progress-bar'  id='progress_Shift_bar_" + i + "' role='progressbar' style='width: 0%;' aria-valuenow='0' aria-valuemin='0' aria-valuemax='100'></div>" +
                            "</div>" +
                            "</div>" +
                            "<span class='progress-value' id='progress_Shift_val_" + i + "'>0%&nbsp;</span>" +
                            "</div>"
                        );
                    }
                    else {
                        row.push(response[i].Status);
                    }
                    row.push(response[i].CreatedDtFlag);
                    row.push(response[i].Err);
                    if (response[i].Err == 1 && response[i].Status == "Success") {
                        row.push(
                            "<a class='btnDownloadErrorList btn btn-xs seagreen_btnnew' " +
                            "onclick='generateShiftExcelFile(" + response[i].CreatedDtFlag + ")'>" +
                            "<i class='fa-regular fa-file-excel'></i></a>"
                        );
                    }
                    else if (response[i].Status == "Success")
                    {
                        row.push("");
                    }
                    else {
                        row.push(
                            "<button class='btn btn-xs seagreen_btnnew' style='display:none;' id='regenerate_" + i + "' " +
                            "onclick='regenerateEntryShift(\"" + response[i].CreatedDtFlag + "\", \"" + compcode + "\",this, " + i + "," + emprole + ", " + cmpid + ", " + branchid +","+ empid +")'>" +
                            "<i class='fa-light fa-rotate'></i></button>"
                        );
                    }
                    tableData.push(row);
                }
                $('#tblshiftAllocationBulkUpload').DataTable({
                    //dom: _domCommon,
                    //language: _languageCommon,
                    data: tableData,
                    columns: [
                        { title: "Sr No." , visible:false},
                        { title: "StartDate" },
                        { title: "Status" },
                        { title: "CreatedDtFlag", visible: false },
                        { title: "Err", visible: false },
                        { title: "View Error File" }
                    ],

                    info: false,
                    paging: false,
                    ordering: false,
                    searching: false
                });

                //setTimeout(function () {
                //    $("#" + "tblshiftAllocationBulkUpload" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                //    $('.tooltips').tooltip();
                //}, 100);

                $("#ajax_loader").hide();
            }
        },
        error: function (xhr, ajaxOptions, thrownError) {
            $("#ajax_loader").hide();
        },
        complete: function () {
            $("#ajax_loader").hide();
        }
    });
        }
    function generateprogressdata() {
            $(".loading1").show();
            if (interval) {
                clearInterval(interval);
                interval = "";
            }
            interval = setInterval(() => {
                $.ajax({
                    url: '@_webapiurl' + "Transaction/GetProgressShiftAllocationData?compcode=" + compcode,
                    type: "GET",
                    headers: { 'Authorization': '@_tokan' },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (Array.isArray(data) && data.length > 0 && data[0].Progress !== undefined && data[0].Error !== undefined) {
                               var progressValue = data[0].Progress;
                                var responseCompcode = data[0].compcode;
                                var responseerror = data[0].Error;
                                if (responseCompcode === compcode) {
                                    $("#tblshiftAllocationBulkUpload tbody tr").each(function (index) {
                                      var rowDiv = $(this).find("div[id^='row_']");
                                      if (rowDiv.length) {
                                          var rowId = rowDiv.attr("id").replace("row_", "");
                                          var progressBar = $("#progress_Shift_bar_" + rowId);
                                          var progressText = $("#progress_Shift_val_" + rowId);
                                          if (responseerror == 101) {
                                              //$("#statusShift_" + rowId).text("Failed");
                                              //$("#regenerate_" + rowId).show();
                                              GetExcelFailedStatusShiftGridData();
                                          }
                                          if (progressBar.length && progressText.length) {
                                              progressBar.css("width", progressValue + "%").attr("aria-valuenow", progressValue);
                                              progressText.text(progressValue + "%");
                                          }
                                      }
                                  });
                                 if (progressValue >= 100) {
                                     clearInterval(interval);
                                     $(".loading1").hide();
                                     generateShiftgriddata(userid);
                                 }
                                }
                            }
                    },
                    error: function (jqXHR, ajaxOptions, thrownError) {
                        if (jqXHR.status === 500) {
                            toastr.error("Internal Server Error.");
                        } else if (jqXHR.status === 400) {
                            toastr.error("Bad Request.");
                        } else if (jqXHR.status === 401) {
                            window.location.href = "/PayTime/LoginPage";
                        }
                        clearInterval(interval); // Stop interval on error
                        $(".loading1").hide(); // Hide loading indicator on error
                    }
                });
            }, 3000);
        }
    function GetExcelFailedStatusShiftGridData() {
          $.ajax({
              url: '@_webapiurl' + "Transaction/GetExcelFailedStatusShiftGridData",
                      type: "GET",
                      headers: { 'Authorization': '@_tokan' },
                      contentType: "application/json; charset=utf-8",
                      dataType: "json",
                      success: function (data) {
                          if (data.length > 0) {
                              data.forEach(function (item) {
                                  if (data[0].PendingCount > 0) {
                                      $("#tblshiftAllocationBulkUpload tbody tr").each(function () {
                                          var insertedCount = item.InsertedCount;
                                          var DuplicateCount = item.DuplicateCount;
                                          var PendingCount = item.PendingCount;
                                          var totalCount = insertedCount + DuplicateCount + PendingCount;
                                          var inscount = insertedCount + DuplicateCount;
                                          var progressValue = Math.round((inscount / totalCount) * 100);
                                          var rowDiv = $(this).find("div[id^='row_']");
                                          var rowId = rowDiv.attr("id").replace("row_", "");
                                          $("#statusShift_" + rowId).text("Pending");
                                          $("#regenerate_" + rowId).show();
                                          var progressBar = $("#progress_Shift_bar_" + rowId);
                                          var progressText = $("#progress_Shift_val_" + rowId);
                                          if (progressBar.length && progressText.length) {
                                              progressBar.css("width", progressValue + "%").attr("aria-valuenow", progressValue);
                                              progressText.text(progressValue + "%");
                                          }
                                      });
                                  }
                              });
                          }
                      },
                      error: function (jqXHR, ajaxOptions, thrownError) {
                          if (jqXHR.status === 500) {
                              toastr.error("Internal Server Error");
                          } else if (jqXHR.status === 400) {
                              toastr.error("Bad Request");
                          } else if (jqXHR.status === 401) {
                              window.location.href = "/PayTime/LoginPage";
                          }
                      }
                  });
      }
