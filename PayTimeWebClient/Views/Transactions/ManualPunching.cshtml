                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label>Device Mode</label>
                                        <select class="form-control input-sm" id="Mode1" name="Mode1">
