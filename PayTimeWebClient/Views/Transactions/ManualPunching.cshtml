                                            <option value="Out">Out</option>
                                            <option value="Default">Default</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label>Device Code <span class="required" aria-required="true"> * </span></label>
