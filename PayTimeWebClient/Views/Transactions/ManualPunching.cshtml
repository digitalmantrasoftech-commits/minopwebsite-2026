        function save() {
            if (valid()) {
                var allVals = [];
                $("#tblEmp .ClsChkEmp").each(function () {
                    if ($(this).is(':checked') == true) {
                        allVals.push($(this).attr("id"));
                    }
                });

                var inoutmodes = [];
                var inouttimes = [];
                if ($("#Inmode").is(':checked') == true) {
                    inoutmodes.push($("#Inmode").val());
                    inouttimes.push($("#in_time").val());
                }
                if ($("#Outmode").is(':checked') == true) {
                    inoutmodes.push($("#Outmode").val());
                    inouttimes.push($("#out_time").val());
                }
                var ManualPunch = {
                    "mode": inoutmodes,
                    "todate": $("#todate").val(),
                    "devicecode": 0,
                    "In_Out_Time": inouttimes,
                    "fromdate": $("#fromdate").val(),
                    "IPaddress": $("#ipaddress").val(),
                    "cmpid": $("#ddlCompany").val(),
                    "branchid": $("#ddlBranch").val(),
                    "empidlst": allVals
                };

                $.ajax({
                    type: "POST",
                    url: "/Transactions/ManualPunch?ManualPunch=" + JSON.stringify(ManualPunch),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    async: "false",
                    beforeSend: function () {
                        $("#ajax_loaderCompany").show();
                    },
                    success: function (response) {
                        if (response.isRedirect) {
                            window.location.href = response.redirectUrl;
                        }
                        if (response != null) {
                            if (response.ad == "OK") {
                                $('#frmpopup').modal('toggle');
                                GetAllManualPunchData();
                                Clear();
                                toastr.remove();
                                toastr.success("Manual Punch added successfully.");
                            }
                            else {
                                toastr.remove();
                                toastr.error(response);
                            }
                        }
                        $("#ajax_loaderCompany").hide();
                    },
                    error: function (response) {
                        $("#ajax_loaderCompany").hide();
                    },
                });
            }
        }
