            if (e.which != 8 && e.which != 46 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
            var _LeaveSanction = $("#txtLeaveSanction").val();
            if (_LeaveSanction.length == 0) {
                if (e.which == 46) {
                    return false;
                }
            }
            if (_LeaveSanction.length > 1) {
                var _Leave = $("#txtLeaveSanction").val().substring(0, _LeaveSanction.length - 1);
                if (_Leave == 0) {
                    if ($("#txtLeaveSanction").val() != "0.") {
                        $("#txtLeaveSanction").val('');
                    }
                }
            }
            var number = _LeaveSanction.split(".");
            var dotPos = _LeaveSanction.indexOf(".");
            if (dotPos == "0") {
                $("#txtLeaveSanction").val('');
            }
            else if (dotPos != "-1") {

                if (number[1].length == 1) {
                    var _num = $("#txtLeaveSanction").val().substring(0, _LeaveSanction.length - 1);
                    $("#txtLeaveSanction").val(_num);
                }
            }

