    function fillbranch(branchid) {
        $("#ddlBranch").empty();
        $.ajax({
            type: "POST",
            url: "/Transactions/FillBranch?id=" + $("#ddlCompany").val(),
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response != null) {
                    $("#ddlBranch").append("<option value='0'>Select Branch</option>");
                    for (var i = 0; i < response.length; i++) {
                        $("#ddlBranch").append("<option value='" + response[i].BranchId + "'>" + response[i].BranchName + "</option>");
                    }
                    if (emprole > 1 && emprole != 6805 && emprole != 6806) {
                        $("#ddlBranch option[value = '" + branchid + "' ]").prop('selected', true);
                    }
                }
                $(".loading").hide();
