                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (Array.isArray(data) && data.length > 0 && data[0].Progress !== undefined && data[0].Error !== undefined) {
                        var progressValue = data[0].Progress;
                        var responseCompcode = data[0].compcode;
                        var responseerror = data[0].Error;
                        if (responseCompcode === compcode) {
                            $("#tblLeaveSanctionBulkUpload tbody tr").each(function (index) {
                                var rowDiv = $(this).find("div[id^='row_']");
                                if (rowDiv.length) {
                                    var rowId = rowDiv.attr("id").replace("row_", "");
                                    var progressBar = $("#progress_Leave_bar_" + rowId);
                                    var progressText = $("#progress_Leave_val_" + rowId);
                                    if (responseerror == 101) {
                                        GetExcelFailedStatusLeaveGridData();
                                    }
                                    if (progressBar.length && progressText.length) {
                                        progressBar.css("width", progressValue + "%").attr("aria-valuenow", progressValue);
                                        progressText.text(progressValue + "%");
                                    }
                                }
                            });
                            if (progressValue >= 100) {
                                clearInterval(interval);
                                $(".loading1").hide();
                                generateLeaveSantiongriddata(userid);
                            }
                        }
                    }
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status === 500) {
                        toastr.error("Internal Server Error.");
                    } else if (jqXHR.status === 400) {
                        toastr.error("Bad Request.");
                    } else if (jqXHR.status === 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                    clearInterval(interval); // Stop interval on error
                    $(".loading1").hide(); // Hide loading indicator on error
                }
            });
        }, 3000);
  }
  function generateLeaveExcelFile(_Date, classMasterValue) {
    checkSession();
    var DtFlag = _Date
    $.ajax({
        url: "/Transactions/DownloadLeaveSanctionErrList",
        type: "GET",
        headers: { 'Authorization': '@_tokan' },
        data: { DtFlag: _Date },
        contentType: "application/json; charset=utf-8",
        datatype: "json",
        success: function (data) {
            if (typeof data === "string") {
                try {
                    data = JSON.parse(data);
                } catch (error) {
                    toastr.error("Failed to parse data.");
                    $("#btnDownloadErrorList").prop('disabled', false);
                    return;
                }
            }
            if (!Array.isArray(data)) {
                toastr.error("Unexpected data format received.");
                $("#btnDownloadErrorList").prop('disabled', false);
                return;
            }
            if (data.length === 0) {
                toastr.error("No entry found in excel.");
            } else if (data.isRedirect) {
                window.location.href = data.redirectUrl;

            } else {
                try {
                    function stripHtmlTags(input) {
                        if (typeof input === 'string') {
                            return input.replace(/<[^>]+>/g, '').trim();
                        }
                        return input;
                    }
                     const formattedData = data.map(item => ({
                         EmpCode: item.EmpCode,
                         LeaveType: item.LeaveType,
                         LeaveBalance: item.LeaveBalance,
                         BalanceDate: item.BalanceDate,
                         Reason: item.Reason
                     }));

                    var worksheet = XLSX.utils.json_to_sheet(formattedData);
                    var workbook = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(workbook, worksheet,"LeaveSanction");
                    // Apply styles to the header row
                    const range = XLSX.utils.decode_range(worksheet['!ref']);
                    const headerRow = range.s.r;
                    for (let col = range.s.c; col <= range.e.c; col++) {
                        const cellAddress = XLSX.utils.encode_cell({ r: headerRow, c: col });
                        if (!worksheet[cellAddress]) continue;

                        // Add styling properties to the header cells
                        worksheet[cellAddress].s = {
                            font: { bold: true, color: { rgb: "FFFFFF" } },
                            fill: { fgColor: { rgb: "4CAF50" } },
                            alignment: { horizontal: "center" }
                        };
                    }
                    // Optional: Set column widths for better readability
                    worksheet['!cols'] = [
                        { wch: 15 },
                        { wch: 25 },
                        { wch: 20 },
                        { wch: 20 },
                        { wch: 100 }
                    ];

                    XLSX.writeFile(workbook, 'LeaveSanction.xlsx');
                    $("#btnDownloadErrorList").prop('disabled', false);
                } catch (error) {
                    $("#btnDownloadErrorList").prop('disabled', false);

                }
            }
        },
        error: function (jqXHR, ajaxOptions, thrownError) {
            if (jqXHR.status == 500) { //InternalServerError = 500,
                toastr.error("InternalServerError");
            } else if (jqXHR.status == 400) { //BadRequest = 400,
                toastr.error("BadRequest");
            } else if (jqXHR.status == 401) {
                window.location.href = "/PayTime/LoginPage";
            }
        }
    });
}
