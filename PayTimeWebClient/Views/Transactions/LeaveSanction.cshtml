  function generateLeaveSantiongriddata(userid) {
    $.ajax({
        url: '@_webapiurl' + "Transaction/GetExcelLeaveSanctionGridData?userid=" + userid,
        type: "GET",
        headers: { 'Authorization': '@_tokan' },
        contentType: "application/json; charset=utf-8",
        datatype: "json",
        success: function (response) {
            if (response && response.length > 0) {
                $("#tblLeaveSanctionBulkUpload").show();
                if ($.fn.dataTable.isDataTable('#tblLeaveSanctionBulkUpload')) {
                    $('#tblLeaveSanctionBulkUpload').DataTable().clear().destroy();
                }
                var tableData = [];
                for (var i = 0; i < response.length; i++) {
                    var row = [];
                    row.push(i + 1);
                    row.push(response[i].Startdate);
                    if (response[i].Status === "Success") {
                        row.push("<div id = 'row_" + i +"' style='display: flex;'> <span class='green_font'>" + response[i].Status + "</span></div>");
                    } else if (response[i].Status === "Pending") {
                        row.push(
                            "<div id ='row_" + i +"' style='display: flex;'>"+
                            "<div class='orange_font' id='statusLeave_" + i +"'>" + response[i].Status + "</div>" +
                            "<div class='loading1' style='width: 100px; margin: 0 8px;'>" +
                            "<div class='progress' style='margin-bottom: 0;'>" +
                            "<div class='progress-bar'  id='progress_Leave_bar_" + i + "' role='progressbar' style='width: 0%;' aria-valuenow='0' aria-valuemin='0' aria-valuemax='100'></div>" +
                            "</div>" +
                            "</div>" +
                            "<span class='progress-value' id='progress_Leave_val_" + i + "'>0%&nbsp;</span>" +
                            "</div>"
                        );
                    }
                    else {
                        row.push(response[i].Status);
                    }
                    row.push(response[i].CreatedDtFlag);
                    row.push(response[i].Err);
                    if (response[i].Err == 1 && response[i].Status == "Success") {
                        row.push(
                            "<a class='btnDownloadErrorList btn btn-xs seagreen_btnnew' " +
                            "onclick='generateLeaveExcelFile(" + response[i].CreatedDtFlag + ")'>" +
                            "<i class='fa-regular fa-file-excel'></i></a>"
                        );
                    }
                    else if (response[i].Status == "Success") {
                        row.push("");
                    }
                    else {
                        row.push(
                            "<button class='btn btn-xs seagreen_btnnew' style='display:none;' id='regenerate_" + i + "' " +
                            "onclick='regenerateEntryLeave(\"" + response[i].CreatedDtFlag + "\", \"" + compcode + "\",this, " + i + " ," + emprole + ", " + cmpid + ", " + branchid +")'>" +
                            "<i class='fa-light fa-rotate'></i></button>"
                        );
                    }
                    tableData.push(row);
                }

                    $('#tblLeaveSanctionBulkUpload').DataTable({
                        data: tableData,

                        columns: [
                            { title: "Sr No.", visible:false },
                            { title: "StartDate" },
                            { title: "Status" },
                            { title: "CreatedDtFlag", visible: false },
                            { title: "Err", visible: false },
                            { title: "View Error File" }
                        ],

                        info: false,
                        paging: false,
                        ordering: false,
                        searching:false
                    });

                $("#ajax_loader").hide();
            }
        },
        error: function (xhr, ajaxOptions, thrownError) {
            $("#ajax_loader").hide();
        },
        complete: function () {
            $("#ajax_loader").hide();
        }
    });
        }
