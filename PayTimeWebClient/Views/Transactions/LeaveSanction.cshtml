    // jQuery function to check checkboxes based on an array of EmpId values
    function checkEmpCheckboxesByIds(empIdArray, isSelectAllChecked)
    {
        if (!Array.isArray(empIdArray) || empIdArray.length === 0) {
            console.warn('Invalid or empty EmpId array provided.');
            return;
        }
        if (isSelectAllChecked) {
            // Iterate through each EmpId in the array
            empIdArray.forEach(empId => {
                // Find the checkbox with the matching EmpId
                const checkbox = $(`#tblEmp .ClsChkEmp[id="${empId}"]`);
                if (checkbox.length > 0) {
                    selectedEmpIds.add(empId);
                    checkbox.prop('checked', true);
                    checkedDept(checkbox[0]); // Trigger associated logic
                } else {
                    console.warn(`Checkbox for EmpId ${empId} not found in the table.`);
                }
            });
        }
        else {
            if (selectedEmpIds.size > 0) {
                for (let empId of selectedEmpIds) {
                    const checkbox = $(`#tblEmp .ClsChkEmp[id="${empId}"]`);
                    if (checkbox.length > 0) {
                        checkbox.prop('checked', true);
                        checkedDept(checkbox[0]); // Trigger associated logic
                    } else {
                        console.warn(`Checkbox for EmpId ${empId} not found in the table.`);
                    }
                }
            }
        }
    }


    function fetchNextRecords(startIndex, requestId, callback, searchValue) {
        let SelectAll = 0;
        let SelectAllSearch = "";
        let SelectAllBranch = 0;
        let SelectAllBranchSearch = "";
        if ($("#DeptIdsContainer li").hasClass("multiselect-item multiselect-all active")) {
            SelectAll = 1;
            SelectAllSearch = $("#DeptIdsContainer li .multiselect-search").val().trim().toLowerCase()

        }
        if ($("#BranchIdsContainer li").hasClass("multiselect-item multiselect-all active")) {
            SelectAllBranch = 1;
            SelectAllBranchSearch = $("#BranchIdsContainer li .multiselect-search").val().trim().toLowerCase()
        }
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '/DataGridOptimize/GetLazyLoadingGetEmployeeLeaveSanction',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify({
                start: startIndex,
                length: 50,
                RoleId: "@_RoleId",
                CompanyIds: $("#CompanyID").val(),
                BranchId: BranchIdlst,
                DepartmentId: DeptIdlst,
                DatagridThresold:"@_DatagridEmpListThsold",
                LoginEmpId: "@_UserId",
                SelectAll: SelectAll,
                SelectAllSearchTerm: SelectAllSearch,
                SelectAllBranch: SelectAllBranch,
                SelectAllBranchSearchTerm: SelectAllBranchSearch,
                search:
                {
                    value: $("#tblEmp_filter input").val().trim() || ''
                }
            }),
            beforeSend: function () {
                $("#loader_tblEmployee").show();
            },
            success: function (response) {
                if (response && response.data && response.data.length > 0) {
                    callback(response.data, requestId);
                } else {
                    callback([], requestId);
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.error('Error fetching records for request ID:', requestId, textStatus, errorThrown);
                callback([], requestId);
            },
            complete: function () {
                $("#loader_tblEmployee").hide();
            }
        });
    }

    $(document).on('input', '#tblEmp_filter input', function ()
    {
        let searchText = $(this).val();
        if (_isServerSide) {
            if (searchText.length >= 3)
            {
                totalLoadedRecords = 0;
                startIndex = 0;
                fetchedEmpIds.clear();
                fetchNextRecords(0, 1, function (records, requestId) {
                    tableInstance.clear().rows.add(records).draw();
                    totalLoadedRecords = records.length;
                    startIndex = records.length;
                    records.forEach(row => fetchedEmpIds.add(row.EmpId));
                }, searchText);
                $('.ClsChkEmp').each(function () {
                    if (selectedEmpIds.has(this.id)) {
                        this.checked = true;
                    }
                });
                $('.ClsChkAllDept').prop('checked', false);
                if (isSelectAllChecked) {
                    selectedEmpIds.clear();
                    isSelectAllChecked = false;
                }

            }
            else {
                if (searchText.length == "") {

                    totalLoadedRecords = 0;
                    startIndex = 0;
                    fetchedEmpIds.clear();
                    fetchNextRecords(0, 1, function (records, requestId) {
                        tableInstance.clear().rows.add(records).draw();
                        totalLoadedRecords = records.length;
                        startIndex = records.length;
                        records.forEach(row => fetchedEmpIds.add(row.EmpId));
                    }, ""); // Send empty search param
                    $('.ClsChkEmp').each(function () {
                        if (selectedEmpIds.has(this.id)) {
                            this.checked = true;
                        }
                    });
                    $('.ClsChkAllDept').prop('checked', false);
                    if (isSelectAllChecked) {
                        selectedEmpIds.clear();
                        isSelectAllChecked = false;
                    }
                }
            }
        }
        else
        {
            tableInstance.search(searchText).draw();
        }
    });

