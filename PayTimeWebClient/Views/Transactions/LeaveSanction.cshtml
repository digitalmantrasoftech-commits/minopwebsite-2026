            formData.append("Companyid", Companyid);
            formData.append("branchid", branchid);
            $.ajax({
                url: "/Transactions/LeaveSanctionUpload",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    setTimeout(function () {
                        toastr.remove("");
                        toastr.success(response.message);
                        location.reload();
                    }, delay);
                    $("#FileUpload").val("");
