                                            <span></span>
                                        </label>
                                        <label class="mt-radio mt-radio-outline">
                                            Remove Leave
                                            <input value="True" name="rdRemoveLeave" id="rdRemoveLeave" type="radio">
                                            <span></span>
                                        </label>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <label>Sanction Leave <span class="required" aria-required="true"> * </span></label>
                                            <input class="form-control input-sm" name="txtLeaveSanction" id="txtLeaveSanction" type="text" maxlength="4">
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <label>Leave Type <span class="required" aria-required="true"> * </span></label>
                                            <select class="form-control input-sm" id="ddlLeaveType" name="ddlLeaveType">
                                                <option value="0" selected>-- Select Leave Type --</option>
                                                @foreach (var item in ViewBag.LeaveTypeList as IEnumerable<SelectListItem>)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group data_picker_box">
                                            <label>Sanction Date <span class="required" aria-required="true"> * </span></label>
                                            <div class="input-group  date date-picker" data-date-format="@_isdateformat" data-date-viewmode="years">
                                                <span class="input-group-btn">
                                                    <button class="btn default btn-sm" type="button">
                                                        <i class="fa-light fa-calendar-days"></i>
                                                    </button>
                                                </span>
                                                @if (_isdateformat == "dd-M-yyyy" || _isdateformat == "M-dd-yyyy" || _isdateformat == "yyyy-M-dd")
                                                {
                                                    <input type="text" id="txtSactionDate" placeholder="@_isdateformat.Replace("M","MMM")" class="form-control input-sm" readonly="readonly">
                                                }
                                                else
                                                {
                                                    <input type="text" id="txtSactionDate" placeholder="@_isdateformat" class="form-control input-sm" readonly="readonly">
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    @*<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <label class="control-label">Department<span class="required" aria-required="true"> * </span></label>
                                            <input type="text" id="txt2" value="0" hidden />
                                            <select id="DeptIds" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%"></select>
