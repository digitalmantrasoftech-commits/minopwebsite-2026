</div>
<!-- Page Bar : End -->
<!-- Ajax Loader : Begin -->
<div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" />
</div>
<!-- Ajax Loader : End -->


<div class="filter_portlet_wrapper full-width">
    <!-- Datatable Block : Begin -->
    <div class="portlet filter_portlet_tbl">
        <div class="portlet-body">
            <div class="appoval_actionbtn" id="appactionbtn" style="display:none">
                <button type="button" id="btnactive" class="btn icon_btn tooltips" data-placement="top" data-original-title="Approve"><i class="fa-solid fa-check"></i></button>
                <button type="button" id="btnDeactive" class="btn clear_btn margin-left-5 tooltips" data-placement="top" data-original-title="Reject"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="table-responsive" id="tableResponsive">
                <table class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column" id="tblShiftAllocationApprove">
                    <thead></thead>
                    <tbody></tbody>
                </table>
            </div>
            <div id="shift-empty" style="display: none">
                <div class="datanotfound">
                    <img src="~/assets/images/emptyscreen_1.png" width="280" height="148" alt="Nodata Found Icon">
                    <p class="datanotfound_title">No records Found.</p>
                    <p class="">No entries found. Please add a record to get started.</p>
                </div>
            </div>
            <div id="shift-empty1" style="display: none">
                <div class="datanotfound">
                    <img src="~/assets/images/emptyscreen_3.png" width="280" height="148" alt="Nodata Found Icon">
                    <p class="datanotfound_title">No records Found.</p>
                    <p class="">No matching records found for the selected filters.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Datatable Block : End -->
    <!-- Filter Block : Begin -->
    <div class="portlet filter_boxModal">
        <div class="filterbox_header">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="filter-title">Filters</h4>
                <button type="button" class="filterclose_btn"><i class="fa-light fa-xmark"></i></button>
            </div>
        </div>
        <div class="filterbox_body">
            <div class="col-lg-12">
                <div class="form-group">
                    <label>Shift<span class="required" aria-required="true">*</span></label>
                    <select id="shiftId" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%">
                    </select>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group">
                    <label>Status<span class="required" aria-required="true">*</span></label>
                    <select class="form-control input-sm select2" id="shiftStatus">
                        <option value="-1">All</option>
                        <option value="1">Approve</option>
                        <option value="0">Pending</option>
                        <option value="2">Reject</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group data_picker_box">
                    <label class="control-label">From Date<span class="required" aria-required="true">*</span></label>
                    <div class="input-group input-group-sm date date-picker" id="" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                        <span class="input-group-btn">
                            <button class="btn default" type="button">
                                <i class="fa-light fa-calendar-days"></i>
                            </button>
                        </span>
                        <input type="text" class="form-control" id="FromDate" data-date-format="@_isdateformat" placeholder="@_isdateformat.Replace("M","MMM")" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group data_picker_box">
                    <label class="control-label">To Date<span class="required" aria-required="true">*</span></label>
                    <div class="input-group input-group-sm date date-picker" id="" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                        <span class="input-group-btn">
                            <button class="btn default" type="button">
                                <i class="fa-light fa-calendar-days"></i>
                            </button>
                        </span>
                        <input type="text" class="form-control" id="ToDate" data-date-format="@_isdateformat" placeholder="@_isdateformat.Replace("M","MMM")" autocomplete="off">
                    </div>
                </div>
            </div>
        </div>
        <div class="filterbox_footer">
            <div class="text-right">
                <button type="submit" id="clear_operation" class="clear_btn tooltips" data-placement="top" data-original-title="Clear Filters"><i class="fa-regular fa-eraser"></i></button>
                <button type="submit" id="Search_operation" class="icon_btn margin-left-5 tooltips" data-placement="top" data-original-title="Search Filters"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
        </div>
    </div>
    <!-- Filter Block : End -->
</div>
