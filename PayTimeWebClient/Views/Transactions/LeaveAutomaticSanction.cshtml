        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" />
    </div>

    <div class="filter_portlet_wrapper full-width">

        <!-- Datatable Block : Begin -->
        <div class="portlet filter_portlet_tbl">
            <div class="portlet-body">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="res_table_box">
                            <div class="leave_automatic_box" id="tblleave"></div>
                        </div>
                        <div id="NotificationGrid-empty1" style="display: none">
                            <div class="datanotfound">
                                <img src="/assets/images/emptyscreen_3.png" height="148" width="280" alt="Nodata Found Icon">
                                <p class="datanotfound_title">No data Found</p> <!-- titleText -->
                                <p class="">No matching records found for the selected filters.</p><!-- subText -->
                            </div>
                        </div>
                        <div id="NotificationGrid-empty">
                            <div class="datanotfound">
                                <img src="/assets/images/emptyscreen_3.png" height="148" width="280" alt="Nodata Found Icon">
                                <p class="datanotfound_title">No data show</p> <!-- titleText -->
                                <p class="">Start by applying a filter to view relevant data.</p><!-- subText -->
                            </div>
                        </div>
                    </div>
