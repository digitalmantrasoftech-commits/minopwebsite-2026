        function save() {
            var selectedLeaveType = [];
            var Empid = "";

            $("#tblleavedetails .chkEmp").each(function () {

                if ($('.chkEmp').is(':checked')) {
                    if ($("#chkEmp_" + $(this).val() + "").is(':checked')) {


                            if (Empid == "") {
                                Empid = $(this).val();
                            } else {
                                Empid += "," + $(this).val();
                            }

                    }
                }
            });
            if (Empid == "") {
                toastr.remove();
                toastr.error("Please select at least one employee");
                event.preventDefault();
                return false;
            }
            var colLen = $("#tblleavedetails thead th").length - 4;
            var leavetype = "";
            for (var k = 1 ; k <= colLen; k++) {

                if ($('#chkallleave_' + k + '').is(':checked')) {
                    var _sval = $('#leavetype_' + k + '').val();
                    var _stxt = 'leavetype_' + k;
                    leavetype = _stxt + ":" + _sval
                    var selecteditem = { "leavetype": leavetype }
                    selectedLeaveType.push(selecteditem);
                }
            }
            if (selectedLeaveType == "") {
                toastr.remove();
                toastr.error("Please select at least one leave type.");
                event.preventDefault();
                return false;
            }

            var Employeeid = Empid;
            var leavetype = selectedLeaveType;

            $.ajax(
                 {
                     type: "POST",
                     headers: { 'Authorization': '@_tokan' },
                     @*url: '@_webapiurl' + "Transaction/leavesanction?Employeeid=" + Empid + "&leavetype=" + JSON.stringify(selectedLeaveType) + "&companyid=" + '@_companyid',*@
                     @*url: "/Transactions/leavesanction?Employeeid=" + Empid + "&leavetype=" + JSON.stringify(selectedLeaveType) + "&companyid=" + '@_companyid',*@
                     url: "/Transactions/leavesanction",
                     data: {
                         Employeeid: Empid,
                         leavetype: JSON.stringify(selectedLeaveType),
                         companyid: '@_companyid'
                     },
                     //contentType: "application/json; charset=utf-8",
                     dataType: "json",
                     beforeSend: function () {
                         $("#ajax_loader").show();
                     },
                     success: function (data) {
                         $("#ajax_loader").hide();
                         if (data.MegSts == "ok") {
                             toastr.remove();
                             toastr.success("Leave sanction rules define successfully.")
                             GetLeaveSanctionList();
                         }
                         else {
                             toastr.remove();
                             toastr.error("Error on leave sanction rules define.");
                         }
                     },
                     error: function (jqXHR, ajaxOptions, thrownError) {
                         $('.ajax_loader').hide();

                         if (jqXHR.status == 500) { //InternalServerError = 500,
                             toastr.error("InternalServerError");
                         } else if (jqXHR.status == 400) { //BadRequest = 400,
                             toastr.error("BadRequest");
                         } else if (jqXHR.status == 401) {
                             window.location.href = "/PayTime/LoginPage";
                         }
                     },
                 });
        }
