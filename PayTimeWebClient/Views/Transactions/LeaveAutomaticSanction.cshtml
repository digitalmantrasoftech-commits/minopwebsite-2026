                            if ($(this).is(":checked")) {
                                $(".chkEmp").prop('checked', true);
                            } else {
                                $(".chkEmp").prop('checked', false);
                            }
                        });
                    $("#dvsv").css("display", "block");
                    $("#ajax_loader").hide();
                },
                complete: function () {
                    $("#ajax_loader").hide();
                },

                error: function (xhr, ajaxOptions, thrownError) {
                    $("#ajax_loader").hide();
                        toastr.remove();
                        toastr.error("You can not auto sanction leave until any Leave Type added except OD, add Leave Type First.");
                    }
                });
        }
        function frmclear() {
            $('#tblleave').empty();
            $("#CompanyID").val(0);
            $("#CompanyID Option:selected").prop("selected", false);
            $("#CompanyID").multiselect('refresh');
            $("#BranchIds").empty();
            $("#BranchIds  Option:selected").prop("selected", false);
            $("#BranchIds").multiselect('disable');
            $("#BranchIds").multiselect('refresh');
            $("#DeptIds").empty();
            $("#DeptIds  Option:selected").prop("selected", false);
            $("#DeptIds").multiselect('disable');
            $("#DeptIds").multiselect('refresh');

            $("#DesigId").empty();
            $("#DesigId Option:selected").prop("selected", false);
            $("#DesigId").multiselect('disable');
            $("#DesigId").multiselect('refresh');

            $("#EmpIds").empty();
            $("#EmpIds  Option:selected").prop("selected", false);
            $("#EmpIds").multiselect('disable');
            $("#EmpIds").multiselect('refresh');

            $("#txt2").val(0);
            $("#txt3").val(0);
            $("#txt4").val(0);
            $("#txt5").val(0);
            $("#dvsv").css("display", "none");}

            //$("#Filter_search").click(function () {
            //    $("#filter_open_div").toggle();
            //});

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        });
</script>
