                        <div class="row margin-top-5">
                            <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4 text-left margin-top-10">
                                <div id="dvcnt" style="display: none; font-weight: 500;">
                                    <span id="totalcnt"></span>
                                </div>
                            </div>
                            <div class="col-lg-8 col-md-8 col-sm-4 col-xs-8 text-right">
                                <button type="submit" id="btnsave" class="btn save_btn"><i class="fa-light fa-floppy-disk"></i> Save</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Datatable Block : End -->
        <!-- Filter Block : Begin -->
