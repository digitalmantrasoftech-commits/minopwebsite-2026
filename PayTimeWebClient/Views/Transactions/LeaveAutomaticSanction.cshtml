                        {
                            @Html.DropDownList("CompanyID", new SelectList(ViewBag.Companyslist, "CompanyID", "CompanyName"), new { @class = "form-control input-sm", @multiple = "multiple" })
                        }
                        else
                        {
                            @Html.DropDownList("CompanyID", new SelectList(new[] { "" }), new { @class = "form-control input-sm", @multiple = "multiple" })
                        }
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="form-group ">
                        <label class="control-label">Branch</label>
                        <input type="text" id="txt2" value="0" hidden />
                        <select id="BranchIds" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%"></select>
                    </div>
                </div>
                <div class="col-lg-12">
