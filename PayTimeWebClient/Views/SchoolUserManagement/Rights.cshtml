@model PayTimeWebClient.Models.RoleRightsMapping
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Data;
@{
    ViewBag.Title = "Rights";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int nn = 0;
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
}

<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/School/AdminDashboard">Home</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>Admin Dashboard</span>
        </li>
    </ul>
</div>
<h1 class="page-title">
    <small></small>
</h1>
@if (obj.CanView)
{
    using (Html.BeginForm())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="portlet">

                    <div class="portlet-body">
                        @if (!string.IsNullOrEmpty(_Message))
                        {
                            
                        }
                        

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    @if (ViewBag.RoleList != null)
                                    {
                                        @Html.DropDownListFor(model => model.RoleId, new SelectList(ViewBag.RoleList, "RoleId", "RoleName"), "Select Role", new { @class = "form-control input-sm select2", onchange = @"var form = document.forms[0];form.action='Rights';form.submit();" })
                                    }
                                    else
                                    {
                                        @Html.DropDownList("RoleId", new SelectList(new[] { "" }), "Select Role", new { @class = "form-control input-sm select2" })
                                    }
                                </div>
                            </div>
                            <div class="col-md-4 ">
                                <div class="form-group">
                                    @if (Model.RoleMenuData != null && Model.RoleMenuData.Count() > 0)
                                    {
                                        <input id="btnRolePermission" class="blue btn " name="Command" type="submit" value="Set Permission" />
                                    }
                                </div>
                            </div>
                        </div>

                        @if (Model.RoleMenuData != null && Model.RoleMenuData.Count() > 0)
                        {
                            <div class="table-responsive">
                                <table class="  table table-bordered table-hover table-condensed table-striped webgrid">
                                    <thead>
                                        <tr class="ui-state-default">
                                            <th>Check all</th>
                                            <th class="text-center">Menu Name</th>
                                            <th class="text-center">Can View</th>
                                            <th class="text-center">Can Add</th>
                                            <th class="text-center">Can Edit</th>
                                            <th class="text-center">Can Export</th>
                                            <th class="text-center">Can Import</th>
                                        </tr>
                                    </thead>
                                    @if (Model.RoleMenuData != null && Model.RoleMenuData.Count() > 0)
                                    {
                                        var ParentMenu = (Model.RoleMenuData.Where(x => x.ParentMenuName != "" && x.ParentMenuName != "Time Reports").Select(x => x.ParentMenuName)).Distinct();
                                        foreach (string item in ParentMenu)
                                        {
                                            <tr class="@(nn % 2 == 1 ? "row_alternate" : "row_normal")">
                                                <td colspan="8" style="font-weight: bold; font-size: small">@item </td>
                                            </tr>
                                            var drSubMenu = Model.RoleMenuData.Where(x => x.ParentMenuName == item);

                                            foreach (var dr in drSubMenu)
                                            {
                                                <tr class="@(nn % 2 == 1 ? "row_alternate" : "row_normal")">
                                                    <td>
                                                        <input type="checkbox" class="checkall" />
                                                    </td>
                                                    <td>@Convert.ToString(dr.OperationName)</td>
                                                    <td class="text-center">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="checkboxes" id="chkCanView_@dr.OperationId" name="chkCanView_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanView)" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                    <td class="text-center">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="checkboxes" id="chkCanAdd_@dr.OperationId" name="chkCanAdd_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanAdd)" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                    <td class="text-center">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="checkboxes" id="chkCanEdit_@dr.OperationId" name="chkCanEdit_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanEdit)" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                    @*<td class="text-center">
                                                            <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                                <input type="checkbox" class="checkboxes" id="chkCanDelete_@dr.OperationId" name="chkCanDelete_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanDelete)" />
                                                                <span></span>
                                                            </label>
                                                        </td>*@
                                                    <td class="text-center">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="checkboxes" id="CanExport_@dr.OperationId" name="CanExport_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanExport)" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                    <td class="text-center">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="checkboxes" id="CanImport_@dr.OperationId" name="CanImport_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanImport)" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                </tr>

                                            }
                                            nn++;
                                        }
                                    }
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
<script type="text/javascript" language="javascript">
    $(document).ready(function () {
        $(".alert").hide();
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }
    }
    );
    $(".checkall").click(function () {
        $(this).parents('tr').find(':checkbox').prop('checked', this.checked);
    });
</script>
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>

