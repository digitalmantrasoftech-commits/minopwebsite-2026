            toastr.remove();
            toastr.success("@_Message");
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
        }

        var $select = $("#DeptIds").multiselect({
            selectAllValue: 'multiselect-all',
