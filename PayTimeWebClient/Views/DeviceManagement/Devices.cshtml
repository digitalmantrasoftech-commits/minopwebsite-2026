                    if (json != null) {
                        const device = json;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", device, {
                            imageUrl: "emptyscreen_3.png",
                            subText: "No matching records found for the selected filters."
                        });
                    }
                }
       }
);
        setTimeout(function () {
            $("#" + "tbldevice" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        $("#Commandid").change(function () {
            console.log('typeof jQuery:', typeof jQuery);
            console.log('typeof $.fn.dataTable:', typeof $.fn.dataTable);
            console.log('typeof $.fn.dataTable.Api:', typeof $.fn.dataTable.Api);
            var selectedoption = $('option:selected', this).val();
            //rows_selected = t.column(0).checkboxes.selected();//rows_selected = t.column(0).checkboxes.selected();
            rows_selected = $('option:selected', this).val();

            var ids = "";
            var command = "INFO";
            if (rows_selected.length > 0) {
                if (selectedoption == 1) {
                    for (var i = 0; i < rows_selected.length; i++) {
                        var obj = {
                            Command: command,
                            DeviceSrno: rows_selected[i],
                            Punchids: ids
                        }
                        $.ajax({
                            //url: '@_webapiurl' + 'DeviceManagement/CreateDeviceCommand?Command=INFO&DeviceSrno=' + rows_selected[i] + "&Punchids=",
                            url: '@_webapiurl' + "/DeviceManagement/CreateDeviceCommand",
                            type: 'POST',
                            datatype: "json",
                            data: obj,
                            headers: { 'Authorization': '@_tokan' },
                            //contentType: "application/json; charset=utf-8",
                            success: function (data) {
                                if (data.MegSts == "Ok") {
                                    $("#Commandid").val(0);
                                    toastr.remove();
                                    toastr.success("Command started successfully.");
                                    $('#tbldevice').DataTable().ajax.reload();
                                }
                                else {
                                    toastr.remove();
                                    toastr.error("Error on adding command.");
                                    $("#Commandid").val(0);
                                }
                            },
                            statusCode: {
                                404: function (content) { $("#Commandid").val(0); alert('cannot find resource'); },
                                500: function (content) { $("#Commandid").val(0); alert('internal server error'); }
                            },
                            error: function (req, status, errorObj) {
                                $("#Commandid").val(0);
                                // handle status === "timeout"
                                // handle other errors
                            }
                        });
                    }
                }
                else if (selectedoption == 2) {
                    Clear();
                    //$("#Commandid").attr("data-toggle", "modal");
                    //$("#Commandid").attr("data-target", "#frmpopupupload");
                    $('#frmpopupupload').modal('show');

                }
                else if (selectedoption == 3) {
                    Clear();
                    //$("#Commandid").attr("data-toggle", "modal");
                    //$("#Commandid").attr("data-target", "#frmpopupupload");
                    $('#frmpopupupload').modal('show');

                    //$("#Commandid").val(0);
                }
                else if (selectedoption == 4) {
                    var ids = "";
                    var command = "CHECK";
                    for (var i = 0; i < rows_selected.length; i++) {
                        var obj = {
                            Command: command,
                            DeviceSrno: rows_selected[i],
                            Punchids: ids
                        }
                        $.ajax({
                            //url: '@_webapiurl' + 'DeviceManagement/CreateDeviceCommand?Command=CHECK&DeviceSrno=' + rows_selected[i] + "&Punchids=",
                            url: '@_webapiurl' + "/DeviceManagement/CreateDeviceCommand",
                            type: 'POST',
                            datatype: "json",
                            data: obj,
                            headers: { 'Authorization': '@_tokan' },
                            success: function (data) {
                                if (data.MegSts == "Ok") {
                                    $("#Commandid").val(0);
                                    $('#tbldevice').DataTable().ajax.reload();
                                }
                                else {
                                    $("#Commandid").val(0);
                                }
                            },
                            statusCode: {
                                404: function (content) { $("#Commandid").val(0); alert('cannot find resource'); },
                                500: function (content) { $("#Commandid").val(0); alert('internal server error'); }
                            },
                            error: function (req, status, errorObj) {
                                $("#Commandid").val(0);
                                // handle status === "timeout"
                                // handle other errors
                            }
                        });
                    }
                }
            }
            else {
                toastr.remove();
                toastr.error("Please select atleast one device.");
                $("#Commandid").val(0);
            }
        });
        $("#btnSave").click(function () {
            //save();
            var ids = "";
            var allVals = [];
            //var t = $('#tbldevice').DataTable();
            //var rows_selected = t.column(0).checkboxes.selected();
            if (valid()) {
                $("#tblEmp .ClsChkEmp").each(function () {
                    if ($(this).is(':checked') == true) {
                        allVals.push($(this).attr("id"));
                    }
                });
                ids = allVals.join(',');
                var selectedoption = $('#Commandid').find(":selected").val();
                var command = "";
                if (selectedoption == 2) {
                    command = "Upload User";
                }
                else {
                    command = "Download User";
                }
                for (var i = 0; i < rows_selected.length; i++) {
                    var obj = {
                        Command: command,
                        DeviceSrno: rows_selected[i],
                        Punchids: ids
                    }
                    $.ajax({
                        type: "POST",
                        headers: { 'Authorization': '@_tokan' },
                        //url: '@_webapiurl' + "/DeviceManagement/CreateDeviceCommand?Command="+command+"&DeviceSrno=" + rows_selected[i] + "&Punchids=" + ids,
                        url: '@_webapiurl' + "/DeviceManagement/CreateDeviceCommand",
                        datatype: "json",
                        data: obj,
                        success: function (response) {
                            if (response.isRedirect) {
                                window.location.href = response.redirectUrl;
                            }
                            $('#frmpopupupload').modal('hide');
                            $("#ajax_loaderCompany").hide();
                            if (response.MegSts.toLowerCase() == "ok") {
                                toastr.remove();
                                toastr.success("Command started sucessfully.");
                            }
                            else {
                                toastr.remove();
                                toastr.error("Error on Adding Command.");
                            }
                        },
                        beforeSend: function () {
                            $("#ajax_loaderCompany").show();
                        },
                        error: function () {
                            $("#ajax_loaderCompany").hide();
                        }
                    });
                }
            }
            $("#Commandid").val(0);
        });
        setInterval(function () {
            t.ajax.reload();
        }, 10000);
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Devices";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })

        //$("#Filter_search").click(function () {
        //    $("#filter_open_div").toggle();
        //});

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

    });
    function valid() {
        var allVals = [];
        $("#tblEmp .ClsChkEmp").each(function () {
            if ($(this).is(':checked') == true) {
                allVals.push($(this).attr("id"));
            }
        });
        if (allVals.length == 0) {
            toastr.remove();
            toastr.error("please select employee.");
            return false;
        }
        return true;
    }
    function getEmp() {
        $("#lblemp").show();
        //var allVals = [];

        //$("#tblDept .ClsChkDept").each(function () {
        //    if ($(this).is(':checked') == true) {
        //        allVals.push($(this).attr("id"));
        //    }
        //});;
        $("#tblEmp").empty();
        var bID = $("#ddlBranch").val();
        $.post("/Transactions/GetEmpByDept?empArr=" + DeptIdlst + ";" + bID, function (response) {
            if (response.isRedirect) {
                window.location.href = response.redirectUrl;
            }
            var table = "";
            if (response != null) {
                for (var i = 0; i < response.length; i++) {

                    var tbl = "<tr class='odd gradeX'>";
                    tbl = tbl + "<td id='eid' hidden>" + response[i].EmpId;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='ecode'>" + response[i].Empcode;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='enm'>" + response[i].EmpName;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='epid'>" + response[i].EmpPunchID;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id=''><input type='checkbox' onchange='checkedDept(this)' class='ClsChkEmp' id='" + response[i].EmpPunchID + "'/>";
                    //tbl = tbl + "<td id=''><input type='checkbox' class='ClsChkEmp' id='" + response[i].EmpId + "'/>";
                    tbl = tbl + "</td>";
                    tbl = tbl + "</tr>";
                    table += tbl;
                }
            }
            $("#tblEmp").destroy;
            $('#tblEmp').append(table);
            $('#step-2 #dataTables_tbl_header').remove();
            $('#tblEmp').dataTable({
                dom: _domCommon,
                language: _languageCommon,
                "columnDefs": [
                    {
                        "targets": [0],
                        "visible": false,
                        "searchable": false,
                    }

                ],
                "destroy": true,
                "bInfo": false,
                "bPaginate": false,
                "bLengthChange": false,
                "columns": [
                    { "title": "Employee ID" },
                    { "title": "Code" },
                    { "title": "Employee Name" },
                    { "title": "Punch ID" },
                    { "title": "<input type='checkbox' class='ClsChkAllDept' onchange='AllCheckedEmp(this)' />" }
                ]
            });
            setTimeout(function () {
                $("#" + "tblEmp" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive1"));
                $('.tooltips').tooltip();
            }, 100);
        });
    }

    //***********************************frmattndpopup Model Steps Show/Hide with BtnTab for Fixed Footer***********************************//
    function Step1ShowHide() {

        //*****show/Hide setup-content perticular step*****//
        $("#step-1").css("display", "block");
        $("#step-2").css("display", "none");

        //For Highlight pericualr stepwizard-step
        $("#s1").addClass("btn-primary");
        $("#s2").removeClass("btn-primary");

        //For click perticular stepwizard-step
        $("#s1").removeClass("disabled");
        $("#s2").addClass("disabled");

        //*****Show/Hide Step perticular step Btntab*****//
        $("#FrstTabBtnDiv").css("display", "block");
        $("#SecondTabBtnDiv").css("display", "none");
    }

    function Step2ShowHide() {

        //*****show/Hide setup-content perticular step*****//
        $("#step-2").css("display", "block");
        $("#step-1").css("display", "none");

        //For Highlight pericualr stepwizard-step
        $("#s2").addClass("btn-primary");
        $("#s1").removeClass("btn-primary");

        //For click perticular stepwizard-step
        $("#s2").removeClass("disabled");
        $("#s1").removeClass("disabled");

        //*****Show/Hide Step perticular step Btntab*****//
        $("#SecondTabBtnDiv").css("display", "block");
        $("#FrstTabBtnDiv").css("display", "none");
    }

    //For click perticular stepwizard-step
    function AllstepsClicable() {
        $("#s1").removeClass("disabled");
        $("#s2").removeClass('disabled');
    }
    //******************************END********************************//

    function Clear() {
        $("#ddlCompany").val("0");
        $("#select2-ddlCompany-container").html("Select Company");
        $("#select2-ddlCompany-container").attr("title", "Select Company");
        $("#ddlBranch").empty();
        $("#ddlBranch").append("<option value='0' selected> Select Branch </option>");

        $("#DepartmentID option:selected").prop("selected", false);
        $("#DepartmentID").multiselect('refresh');
        $("#DepartmentID").multiselect('disable');
        $(".alert-danger").hide();
        $(".alert-success").hide();
        $("#tblEmp tbody").empty();
        $("#DeptIds option:selected").prop("selected", false);
        $("#DeptIds").multiselect('refresh');
        $("#DeptIds").empty();
        $("#DeptIds").multiselect('disable');
        $(".ClsChkAllDept").prop('checked', false);
        $(".ClsChkAllEmp").prop('checked', false);
        var nextStepWizard = $('div.setup-panel div a[href="#step-1"]').parent().children("a");
        nextStepWizard.removeAttr('disabled').trigger('click');

    }
    function AllCheckedDept(ths) {
        $(".popMsg").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkDept").prop('checked', true);

        }
        else {
            $(".ClsChkDept").prop('checked', false);
        }

    }
    function AllCheckedEmp(ths) {
        $(".popeMsg").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkEmp").prop('checked', true);

        }
        else {
            $(".ClsChkEmp").prop('checked', false);
        }

    }
    function checkedDept(ths) {
        $(".popMsg").hide();
    }
