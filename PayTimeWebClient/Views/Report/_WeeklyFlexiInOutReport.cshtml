@model IEnumerable<PayTimeWebClient.Models.DailyInOutReport>
@{
    string isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    var _isdateformat = "";
    if (isdateformat == "dd-M-yyyy" || isdateformat == "M-dd-yyyy" || isdateformat == "yyyy-M-dd")
    {
        _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString().Replace("M", "MMM");
    }
    else if (isdateformat == "dd-mm-yyyy" || isdateformat == "mm-dd-yyyy" || isdateformat == "yyyy-mm-dd")
    {
        _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString().Replace("mm", "MM");
    }
}
@{
    var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "GridView";
        settings.CallbackRouteValues = new { Controller = "Report", Action = "WeeklyFlexiInOutReport", FormMethod.Post };
        settings.SettingsBehavior.ConfirmDelete = true;
        settings.KeyFieldName = "EmpID";
        settings.EnableRowsCache = true;
        settings.SettingsPager.Visible = true;
        settings.Settings.ShowGroupPanel = true;
        settings.Settings.ShowFilterRow = true;        
        settings.SettingsLoadingPanel.Mode = GridViewLoadingPanelMode.Disabled;
        settings.SettingsBehavior.AllowSelectByRowClick = true;
        settings.SettingsBehavior.EnableCustomizationWindow = true;
        settings.ClientSideEvents.CustomizationWindowCloseUp = "grid_CustomizationWindowCloseUp";
        settings.SettingsAdaptivity.AdaptivityMode = GridViewAdaptivityMode.HideDataCellsWindowLimit;
        settings.SettingsAdaptivity.AdaptiveColumnPosition = GridViewAdaptiveColumnPosition.Right;
        settings.Styles.Header.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        settings.Styles.Header.Font.Bold = true;
        settings.SettingsAdaptivity.AdaptiveDetailColumnCount = 1;
        settings.SettingsAdaptivity.AllowOnlyOneAdaptiveDetailExpanded = true;
        settings.SettingsAdaptivity.HideDataCellsAtWindowInnerWidth = 0;
        settings.SettingsResizing.ColumnResizeMode = ColumnResizeMode.Control;
        settings.SettingsResizing.Visualization = ResizingMode.Postponed;
        settings.SettingsBehavior.AllowEllipsisInText = true;
        settings.Settings.ShowTitlePanel = true;        
        
        settings.Columns.Add("EmpID").Visible = false;
        settings.Columns.Add("Name", "EmpCode Name").GroupIndex = 3;
        settings.Columns.Add("EmpName").Visible = false;
        settings.Columns.Add("CardNo").Visible = false;
        settings.Columns.Add(column =>
        {
            column.FieldName = "Attn_dt";
            column.Caption = "Attn Date";
            column.ColumnType = MVCxGridViewColumnType.DateEdit;
            column.Settings.AutoFilterCondition = AutoFilterCondition.Equals;
            column.PropertiesEdit.DisplayFormatString = _isdateformat;            
        });        
        settings.Columns.Add("DepartmentName", "Department").GroupIndex = 2;
        settings.Columns.Add("ShiftStartTime").Visible = false;
        settings.Columns.Add("LessHr").Visible = false;
        settings.Columns.Add("LateHr").Visible = false;
        settings.Columns.Add("EarlyHr").Visible = false;
        settings.Columns.Add(column =>
        {
            column.FieldName = "InTime";
            column.Caption = "In Time";
            column.UnboundType = DevExpress.Data.UnboundColumnType.String;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        });
                
        settings.Columns.Add(column =>
        {
            column.FieldName = "OutTime";
            column.Caption = "Out Time";
            column.UnboundType = DevExpress.Data.UnboundColumnType.String;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        });
        settings.Columns.Add(column =>
        {
            column.FieldName = "TotHour";
            column.Caption = "Total Hrs";
            column.UnboundType = DevExpress.Data.UnboundColumnType.String;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        });
        //settings.Columns.Add(column =>
        //{
            
        //    column.FieldName = "Week";
        //    column.Caption = "Week of Year";
        //    column.UnboundType = DevExpress.Data.UnboundColumnType.String;            
        //    column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        //    column.Settings.AllowCellMerge = DevExpress.Utils.DefaultBoolean.True;
        //    column.CellRowSpan = 2;
                                    
        //});        
        settings.Columns.Add(column =>
        {
            column.FieldName = "WeekSumHrs";
            column.Caption = "Week Hrs/Total Week Hrs";
            column.UnboundType = DevExpress.Data.UnboundColumnType.String;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
            column.Settings.AllowCellMerge = DevExpress.Utils.DefaultBoolean.True;
                
            //column.CellRowSpan = 1;
            column.CellStyle.Wrap = DefaultBoolean.True;
        });
        //settings.Columns.Add(column =>
        //{
        //    column.FieldName = "Weekhrs";
        //    column.Caption = "Emp Week hrs";
        //    column.UnboundType = DevExpress.Data.UnboundColumnType.String;
        //    column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        //    column.Settings.AllowCellMerge = DevExpress.Utils.DefaultBoolean.True;
        //    column.CellRowSpan = 2;
        //});        
        settings.Columns.Add(column =>
        {
            column.FieldName = "FinalStatus";
            column.Caption = "Final Status";
            column.UnboundType = DevExpress.Data.UnboundColumnType.String;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
            column.Settings.AllowCellMerge = DevExpress.Utils.DefaultBoolean.True;
            column.CellRowSpan = 2;
        });
        
        settings.Columns.Add("BranchName", "Branch").GroupIndex = 1;
        settings.Columns.Add("CompanyName", "Company").GroupIndex = 0;
        settings.Columns.Add("HalfLeavePresent").Visible = false;
        settings.Columns.Add("InTimeFull").Visible = false;
        settings.Columns.Add("OutTimeFull").Visible = false;
        
        settings.SettingsBehavior.AutoExpandAllGroups = true;
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.SettingsText.Title = "Weekly Flexi In-Out Report";
        settings.SettingsPager.Mode = GridViewPagerMode.ShowPager;
        settings.SettingsPager.FirstPageButton.Visible = true;
        settings.SettingsPager.LastPageButton.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Items = new string[] { "10", "20", "50", "100" };
        settings.SettingsPager.PageSize = 20;
        settings.Settings.ShowTitlePanel = true;
        
        settings.SettingsExport.EnableClientSideExportAPI = true;

        settings.SettingsExport.ExcelExportMode = DevExpress.Export.ExportType.WYSIWYG;
        settings.SettingsExport.FileName = settings.SettingsText.Title;
        settings.Toolbars.Add(t =>
        {
            t.Items.Add(GridViewToolbarCommand.ExportToPdf);
            t.Items.Add(GridViewToolbarCommand.ExportToXls);        
        });
    });

}
@grid.Bind(Model).GetHtml()
