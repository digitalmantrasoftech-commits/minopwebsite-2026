<div class="page-bar">
    <ul class="page-breadcrumb">
        @if (IsSchool == "1")
        {
            <li>
                <a href="/School/AdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
        }
        else
        {
            if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
            {
                <li>
                    <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
                </li>
            }
            else
            {
                <li>
                    <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
                </li>
            }
        }
        <li><i class="fa-light fa-angle-right"></i> 
            <span>
                Report
            </span>
        </li>
    </ul>
    @if (obj.CanView)
    {
        <div class="page-toolbar">
            <div class="text-right">
                <div class="dropdown dropdown-quick-sidebar-toggler">
                    <a href="javascript:;" class="dropdown-toggle btn icon_btn tooltips" data-placement="left" title="Filter">
                        <i class="fa-light fa-filter"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (obj.CanView)
{
    <div class="row">
        <div class="col-md-12">
            <div class="note note-info" id="filternote">
                <h4 class="block">Reports</h4>
                <p id="filterpara"></p>
            </div>
            <div class="portlet-body">
                <div class="row">
                    @{
    if (!string.IsNullOrEmpty(_tokan) && _RoleId > 0)
    {

        var selectedUserMenu = objusedetails.GetReportDashBoardRoleWise(_RoleId);
        var ParentMenu = selectedUserMenu.Where(m => m.ParentMenuName == null).Select(m => new { m.OperationName, m.ImgClassName }).Distinct();
        //parent
        foreach (var item in ParentMenu)
        {


            //child

            <div class="">
                <div style="display:none;">
                    @ankercnt=1;
                </div>
                @foreach (PayTimeWebClient.Models.reqDailyInOutReport itemSub in selectedUserMenu.Where(m => m.ParentMenuName == item.OperationName))
                {
                    <div class="col-xl-3 col-md-6 col-lg-3 col-sm-6 col-xs-12">
                        <a href="#" class="local_report_icon report_@ankercnt">
                            <div class="repo_bg">
                                <div class="repo_left"><i class="@itemSub.ImgClassName"></i></div>
                                <div class="repo_right">
                                    <p>@itemSub.OperationName</p>
                                </div>
                            </div>
                        </a>
                    </div>
                    ankercnt++;
                }

            </div>

        }


        var customreporttemplate = objreport.GetCustomreportlist();

        if (customreporttemplate != null && _RoleId == 1)
        {


            <div style="display:none;">
                <div style="display:none;">
                    @ankercnt=1;
                </div>
                @foreach (PayTimeWebClient.Models.Reporttemplate itemSub in customreporttemplate)
                {
                    <div class="col-xl-3 col-md-6 col-lg-3 col-sm-6 col-xs-12">
                        <a href="#" class=@ankercnt>
                            <div class="repo_bg">
                                <div class="repo_left"><i class="fa-regular fa-file-lines"></i></div>
                                <div class="repo_right">
                                    <p>@itemSub.ReportName</p><input type="hidden" id="hdncrptid" value="@itemSub.ReportId" /><input type="hidden" id="hdncrpttype" value="@itemSub.ReportType" /><input type="hidden" id="hdncrptHeaderName" value="@itemSub.ReportHeaderName" />
                                </div>
                            </div>
                        </a>
                    </div>
                    ankercnt++;
                }

            </div>

        }

    }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="page-quick-sidebar-wrapper report_model" data-close-on-body-click="false">
        <div class="page-quick-sidebar">
            @Html.Partial("_ReportFilter")
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}