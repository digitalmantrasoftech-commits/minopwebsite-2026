<script type="text/javascript">
    function renderBUWiseGauges(lateIn, earlyOut, workingHour) {
        var gaugeConfig = [
            { id: 'gaugeLateIn', title: 'Late In', value: lateIn, color: '#295097' },
            { id: 'gaugeEarlyOut', title: 'Early Out', value: earlyOut, color: '#295097' },
            { id: 'gaugeWorkingHour', title: 'Working Hour', value: workingHour, color: '#295097' }
        ];
        for (var i = 0; i < gaugeConfig.length; i++) {
            createSemiGauge(gaugeConfig[i]);
        }
    }

    function createSemiGauge(config) {
        Highcharts.chart(config.id, {
            chart: {
                type: 'solidgauge',
                height: '65%',
                backgroundColor: 'transparent'
            },
            title: null,
            pane: {
                center: ['50%', '75%'],
                size: '90%',
                startAngle: -90,
                endAngle: 90,
                background: {
                    backgroundColor: '#e6e6e6',
                    innerRadius: '75%',
                    outerRadius: '100%',
                    shape: 'arc',
                    borderWidth: 0
                }
            },
            exporting: { enabled: false },
            credits: { enabled: false },
            tooltip: { enabled: false },
            yAxis: {
                min: 0,
                max: 100,
                stops: [[1, config.color]],
                lineWidth: 0,
                tickWidth: 0,
                minorTickInterval: null,
                tickAmount: 0,
                labels: {
                    enabled: true,
                    distance: -12,
                    style: { fontSize: '11px', color: '#999' },
                    y: 12
                },
                tickPositions: [0, 100]
            },
            plotOptions: {
                solidgauge: {
                    dataLabels: {
                        y: -30,
                        borderWidth: 0,
                        useHTML: true,
                        format: '<div class="buwise-gauge-datalabel">{y}</div>'
                    },
                    rounded: false
                }
            },
            series: [{
                name: config.title,
                data: [parseFloat(config.value.toFixed(1))],
                innerRadius: '75%',
                radius: '100%'
            }],
            subtitle: {
                text: config.title,
                align: 'center',
                verticalAlign: 'bottom',
                y: -16,
                style: { fontSize: '13px', fontWeight: '600', color: '#333' }
            }
        });
    }
</script>
