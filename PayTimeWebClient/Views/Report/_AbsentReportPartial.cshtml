@model IEnumerable<PayTimeWebClient.Models.AbsentReport>
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Absent report";
    string _UserEmail = HttpContext.Current.Session["UserEmail"].ToString();
}
<style>
    .report_header_box {
        color: #2196f3;
        background-color: #fff;
        margin: 20px 0;
        padding: 10px;
        font-size: 16px;
        font-weight: 500;
        text-align: center;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {
        $('.maskedMobile').each(function () {
            var fullMobile = $(this).text();
            var maskedMobile = fullMobile.substring(0, fullMobile.length - 3).replace(/\d/g, '*') + fullMobile.slice(-3);
            $(this).text(maskedMobile);
        });

        if ($('#tblAbsentReport').length) {
            $('#tblAbsentReport').DataTable({
                dom: 'lBfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        title: 'Absent Report',
                        text: 'Excel'
                    }
                ]
            });
        }
    });

    //function Ozontel(empMobile) {
    //    alert(empMobile);
    //}
    function Ozontel(empMobile) {
   

        const apiUrl = 'https://in1-ccaas-api.ozonetel.com/ca_apis/AgentManualDial';
        const apiKey = 'KK4397b7d5f5bb14dffb9d52cb75e4cd4e';
        const payload = {
            userName: "vedantu",
            agentID: '@_UserEmail',
            campaignName: "Click2call_140",
            customerNumber: empMobile
        };

        // Make the API call using jQuery AJAX
        $.ajax({
            url: apiUrl,
            type: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'accept': 'application/json',
                'apiKey': apiKey
            },
            data: JSON.stringify(payload),
            success: function (response) {
                //alert('Call initiated successfully!');
                toastr.remove();
                toastr.success('Call initiated successfully!');
            },
            error: function (xhr, status, error) {
                toastr.remove();
                toastr.error(xhr.status + " : " + xhr.responseJSON.message);
                
            }
        });
    }

</script>
<div class="report_header_box">
    <span id="customcaption">Absent Report</span>
</div>
<div class="portlet">
    <div class="portlet-body">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                @if (Model != null && Model.Any())
                {
                    <table id="tblAbsentReport" class="table table-striped table-bordered table-hover table-checkable order-column">
                        <thead>
                            <tr>
                                <th>Emp Code</th>
                                <th>Emp PunchID</th>
                                <th>Emp Name</th>
                                <th>Department Name </th>
                                <th>Attn Date</th>
                                <th>Status</th>
                                <th>Emp Mobile No</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Empcode</td>
                                    <td>@item.EmppunchID</td>
                                    <td>@item.EmpName</td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.Attn_dt</td>
                                    <td>@item.FinalStatus</td>
                                    <td class="maskedMobile" onclick="Ozontel('@item.EmpMNo')">@item.EmpMNo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="nodata_block no_recoed" style=" text-align: center;" id="no_data">
                        <img src="/assets/images/Data_not_found.jpg" height="200" width="200" alt="No Data Icon">
                    </div>
                }
            </div>
        </div>
    </div>
</div>


