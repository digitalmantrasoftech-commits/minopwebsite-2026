        function bindcoltablewithdata(_url) {
            var token = '@_tokan'
            $.ajax(
             {
                 type: "GET",
                 async: false,
                 url: _url,
                 contentType: "application/json;",
                 dataType: "json",
                 cache: false,
                 timeout: 30000,
                 beforeSend: function (xhr) {
                     xhr.setRequestHeader("Authorization", token)
                 },
                 success: function (result, status) {
                     var obj = JSON.parse(result);
                     $("#tblcol > tbody > tr").each(function () {
                         var currentRow = $(this);
                         var col3_value = currentRow.find("td:eq(3)").text();
                         for (var j = 0; j < obj.length; j++) {
                             if (col3_value == obj[j].ReportfieldName);
                             {
                                 currentRow.find("#chkselect_t" + obj[j].ReportfieldName).prop('checked', true);
                                 currentRow.find("#chkorder_" + obj[j].ReportfieldName).prop('disabled', false);
                                 currentRow.find("#txtgroup_" + obj[j].ReportfieldName).prop('disabled', false);
                                 currentRow.find("#txtorder_" + obj[j].ReportfieldName).prop('disabled', false);
                                 currentRow.find("#chkorder_" + obj[j].ReportfieldName).prop('checked', obj[j].IsOrderby);
                                 currentRow.find("#txtgroup_" + obj[j].ReportfieldName).val(obj[j].Groupbyorder);
                                 currentRow.find("#txtorder_" + obj[j].ReportfieldName).val(obj[j].Orderbyorder);
                                 currentRow.find("#txtalias_" + obj[j].ReportfieldName).val(obj[j].ReportfieldType);
                             }
                         }
                         $('.tooltips').tooltip();

                     });
                 },
                 error: function (jqXHR, ajaxOptions, thrownError) {
                     if (jqXHR.status == 500) { //InternalServerError = 500,
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) { //BadRequest = 400,
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                 }
             });
        }

