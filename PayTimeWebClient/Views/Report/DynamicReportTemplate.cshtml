                    for (var i = 0; i < coldt.length; i++) {
                        tr = '<tr>';
                        tr += ("<td> <input type='checkbox' onchange=Rowenable('" + coldt[i].COLUMN_NAME + "');  id='chkselect_t" + coldt[i].COLUMN_NAME + "' class='chkselectcol' name='chkselect_" + coldt[i].COLUMN_NAME + "' value='" + coldt[i].COLUMN_NAME + "'></td>");
                        tr += ("<td id='srno'>" + (i + 1) + "</td>");
                        tr += ("<td hidden>" + (i + 1) + "</td>");
                        tr += ("<td id='colname' hidden>" + coldt[i].COLUMN_NAME + "</td>");
                        tr += ("<td id='coldisp'>" + coldt[i].COLUMN_COMMENT.replace('`', '').replace('`', '') + "<a data-placement='right'><i class='fa-regular fa-circle-info tooltips' title='" + coldt[i].frmdisplayname + "' style='color: #295097;'></i></a></td>");
                        tr += ("<td> <input type='text' id='txtalias_" + coldt[i].COLUMN_NAME + "' class='form-control input-sm input-small input-inline' name=txtAlias_" + coldt[i].COLUMN_NAME + " maxlength='15' value=''></td>");
                        tr += ("<td hidden> <input type='checkbox' id='chkgroup_" + coldt[i].COLUMN_NAME + "' onchange=chkgrpchange('" + coldt[i].COLUMN_NAME + "');  class='chkgrpby' name=chkgroup_" + coldt[i].COLUMN_NAME + "  value=" + coldt[i].COLUMN_NAME + "></td>");
                        tr += ("<td> <input type='checkbox' id='chkorder_" + coldt[i].COLUMN_NAME + "'   onchange=chkorderchange('" + coldt[i].COLUMN_NAME + "'); class='chkordby' name='chkorder' value=" + coldt[i].COLUMN_NAME + "></td>");
                        tr += ("<td> <input type='number' id='txtgroup_" + coldt[i].COLUMN_NAME + "'  class='numgrpby' name=txtgroup_" + coldt[i].COLUMN_NAME + " min='0' max='" + coldt.length + "' step='1' value='0' size='2' onkeypress='checkpositive(event);' style='border-radius: 5px; border: 0.5px solid gray;'></td>");
                        tr += ("<td hidden> <input type='number' id='txtorder_" + coldt[i].COLUMN_NAME + "' class='numorderby' name=txtorder_" + coldt[i].COLUMN_NAME + " min='0' max='10' step='1' value='0' size='2'></td>");
                        tr += '</tr>';
                        $('#tblcolbody').append(tr);
                    }

                    var _transactionfld = "Attn_Dt,InTime,OutTime,TotHour,FinalStatus,OTHr"
                    _transactionfld = _transactionfld.split(",")

                    if (_Masterlst.indexOf("0") != "-1") {
                        var j = coldt.length + 1;
                        for (var i = 0; i < _transactionfld.length; i++) {
                            tr = '<tr>';
                            tr += ("<td> <input type='checkbox' onchange=Rowenable('" + _transactionfld[i] + "');  id='chkselect_t" + _transactionfld[i] + "' class='chkselectcol' name='chkselect_" + _transactionfld[i] + "' value='" + _transactionfld[i] + "'></td>");
                            tr += ("<td id='srno'>" + (j) + "</td>");
                            tr += ("<td hidden>" + (j) + "</td>");
                            tr += ("<td id='colname' hidden>" + _transactionfld[i] + "</td>");
                            if (_transactionfld[i] == "Attn_Dt") {
                                tr += ("<td id='coldisp'>Attendance Date <a data-placement='right'><i class='fa-regular fa-circle-info tooltips' title='Transaction' style='color: #295097;'></i></a></td>");
                                tr += ("<td> <input type='text' id='txtalias_" + _transactionfld[i] + "'  class='form-control input-sm input-small input-inline' name=txtAlias_" + _transactionfld[i] + " maxlength='15' value='Attendance Date'></td>");
                            }
                            else if (_transactionfld[i] == "FinalStatus") {
                                tr += ("<td id='coldisp'>Final Status <a data-placement='right'><i class='fa-regular fa-circle-info tooltips' title='Transaction' style='color: #295097;'></i></a></td>");
                                tr += ("<td> <input type='text' id='txtalias_" + _transactionfld[i] + "'  class='form-control input-sm input-small input-inline' name=txtAlias_" + _transactionfld[i] + " maxlength='15' value='Attendance Status'></td>");
                            }
                            else if (_transactionfld[i] == "OTHr") {
                                tr += ("<td id='coldisp'>Over Time <a data-placement='right'><i class='fa-regular fa-circle-info tooltips' title='Transaction' style='color: #295097;'></i></a></td>");
                                tr += ("<td> <input type='text' id='txtalias_" + _transactionfld[i] + "'  class='form-control input-sm input-small input-inline' name=txtAlias_" + _transactionfld[i] + " maxlength='15' value='Over Time'></td>");
                            }
                            else if (_transactionfld[i] == "TotHour") {
                                tr += ("<td id='coldisp'>Total hour <a data-placement='right'><i class='fa-regular fa-circle-info tooltips' title='Transaction' style='color: #295097;'></i></a></td>");
                                tr += ("<td> <input type='text' id='txtalias_" + _transactionfld[i] + "'  class='form-control input-sm input-small input-inline' name=txtAlias_" + _transactionfld[i] + " maxlength='15' value='Total hour'></td>");
                            }
                            else {
                                tr += ("<td id='coldisp'>" + _transactionfld[i] + " <a data-placement='right'><i class='fa-regular fa-circle-info tooltips' title='Transaction' style='color: #295097;'></i></a></td>");
                                tr += ("<td> <input type='text' id='txtalias_" + _transactionfld[i] + "'  class='form-control input-sm input-small input-inline' name=txtAlias_" + _transactionfld[i] + " maxlength='15' value='" + _transactionfld[i] + "'></td>");
                            }
                            //tr += ("<td> <input type='text' id='txtalias_" + _transactionfld[i] + "'  class='form-control input-sm input-small input-inline' name=txtAlias_" + _transactionfld[i] + " maxlength='15' value=''></td>");
                            tr += ("<td hidden> <input type='checkbox' id='chkgroup_" + _transactionfld[i] + "' onchange=chkgrpchange('" + _transactionfld[i] + "');  class='chkgrpby' name=chkgroup_" + _transactionfld[i] + "  value=" + _transactionfld[i] + "></td>");
                            tr += ("<td> <input type='checkbox' id='chkorder_" + _transactionfld[i] + "'   onchange=chkorderchange('" + _transactionfld[i] + "'); class='chkordby' name='chkorder' value=" + _transactionfld[i] + "></td>");
                            tr += ("<td> <input type='number' id='txtgroup_" + _transactionfld[i] + "'  class='numgrpby' name=txtgroup_" + _transactionfld[i] + " min='0' max='18' step='1' value='0' size='2' onkeypress='checkpositive(event);' style='border-radius: 5px; border: 0.5px solid gray;'></td>");
                            tr += ("<td hidden> <input type='number' id='txtorder_" + _transactionfld[i] + "' class='numorderby' name=txtorder_" + _transactionfld[i] + " min='0' max='10' step='1' value='0' size='2'></td>");
                            tr += '</tr>';
                            $('#tblcolbody').append(tr);
                            j = j + 1;
                        }
                    }

                    $('.chkgrpby').prop('disabled', true);
                    $('.chkordby').prop('disabled', true);
                    $('.numgrpby').prop('disabled', true);
                    $('.numorderby').prop('disabled', true);

                },
                error: function () {
                    $("#ajax_loader").hide();
                }
            });
        }

        $('#ReportType').on('change', function () {
            var optsel = $('#ReportType option:selected').val();
