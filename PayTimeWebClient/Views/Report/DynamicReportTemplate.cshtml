        <input type="hidden" id="SearchCriteria" name="SearchCriteria" />

        <div class="portlet">
            <div class="portlet-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div id="tblempty">
                            <div class="table-responsive" id="tableResponsive">
                                <table id="tblCustomrepotemplate" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column">
                                    <thead>
                                        <tr>
                                            <th style="display:none;">Sr. No</th>
                                            <th>Report Name</th>
                                            <th>Report HeaderName</th>
                                            <th>ReportId</th>
                                            <th>Report Type</th>
                                            <th style="width: 10%;">Action</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                        <div id="NotificationGrid-empty" style="display:none;">
                            <div class="datanotfound">
                                <img src="~/assets/images/emptyscreen_3.png" width="280" height="148" alt="Nodata Found Icon">
                                <p class="datanotfound_title">No data found</p> <!-- titleText -->
                                <p class="">No matching records found for the selected filters.</p><!-- subText -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Custom Report Template</h4>
                    </div>
                    <div class="modal-body">
                        <div class="modal-card">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <fieldset>
                                        <div class="form-group" hidden>
                                            <label>Report Type<span class="required" aria-required="true"> * </span></label>
                                            @Html.DropDownList("ReportType", new SelectList(new[] { "Daily Report" }), "Select ReportType", new { @class = "form-control input-sm" })
                                        </div>
                                        <div class="form-group">
                                            <label>Report Name <span class="required" aria-required="true"> * </span></label>
                                            @Html.Editor("ReportName", new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = 100 } })
                                        </div>
                                    </fieldset>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <fieldset>
                                        <div class="form-group">
                                            <label>Report HeaderName</label>
                                            @Html.Editor("ReportHeaderName", new { htmlAttributes = new { @class = "form-control input-sm" } })
                                        </div>
                                    </fieldset>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label>Option list <span class="required" aria-required="true"> * </span></label>
                                        <select id="Masterlst" class="mt-multiselect btn-sm btn blue btn-outline " aria-haspopup="true" aria-expanded="false" multiple="multiple" data-width="100%"></select>
                                        <div class="spMasterlst" style="color:red"></div>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 text-right padding-top-20">                                    
                                    <input type="button" class="btn clear_btn" style="display: none;" value="Clear" id="btnClear" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="important_note">
                                    Note:All other masters will become disable when Employee Master Option is selected and All other masters will enabled when Employee Master Option is not selected.
                                </div>
                            </div>                                
                            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="display:none;">
                                <div class="form-group">
                                    <label>Custom Form list@*<span class="required" aria-required="true"> * </span>*@</label>
                                    <select id="Customlst" class="mt-multiselect btn-sm btn blue btn-outline " aria-haspopup="true" aria-expanded="false" multiple="multiple" data-width="100%"></select>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <fieldset>
                                    <div class="form-group table_data_tblcol">
                                        <table id="tblcol" class="table table-striped table-bordered table-hover table-checkable order-column">
                                            <thead>
                                                <tr>
                                                    <th><input type='checkbox' class="chkallselectall" id="chkallcolumn" name="chkallcolumn" value="chkallcolumn" /></th>
                                                    <th>Sr no</th>
                                                    <th hidden>colid</th>
                                                    <th>
                                                        Report Columns Name <a class="tooltips" data-placement="right" title="columns name"><i class="fa-regular fa-circle-info"></i></a>
                                                    </th>
                                                    <th>
                                                        Report Columns Alias <a class="tooltips" data-placement="right" title="You can set alias(pet) name for column"><i class="fa-regular fa-circle-info"></i></a>
                                                    </th>
                                                    <th hidden>IsGroupby</th>
                                                    <th>
                                                        IsOrderby <a class="tooltips" data-placement="right" title="You can use to set data sorting order."><i class="fa-regular fa-circle-info"></i></a>

                                                    </th>
                                                    <th>
                                                        Display Order <a class="tooltips" data-placement="top" title="sequence or position of a component."><i class="fa-regular fa-circle-info"></i></a>
                                                    </th>
                                                    <th hidden>Orderby At</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tblcolbody"></tbody>
                                        </table>
                                    </div>                                        
                                </fieldset>
                            </div>
                        </div>                        
                    </div>
                    <div class="modal-footer">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                                <input type="button" class="btn save_btn" value="Go" id="btnGo" />
                                <button type="button" id="btnsave" class="btn save_btn"><i class="fa-light fa-floppy-disk"></i> Save</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess</span>
}
