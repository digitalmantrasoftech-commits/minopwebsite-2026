        function GetMultitableCloumnsList() {
            var _Masterlst = "";
            var _Customlst = "";
            var _Master_Customlst = 0;
            if ($("#Masterlst").val() != null) {
                _Masterlst = $("#Masterlst").val();
            }

            if ($("#Customlst").val() != null) {
                _Customlst = $("#Customlst").val();
            }

            if (_Masterlst != "") {
                _Master_Customlst = $("#Masterlst").val();
                if (_Customlst != "") {
                    _Master_Customlst += "," + $("#Customlst").val();
                }
            }
            else {
                if (_Customlst != "") {
                    _Master_Customlst = $("#Customlst").val();
                }
            }
            var _urlcmp = '@_webapiurl' + 'Report/GetMultitableCloumnsList';
            $.ajax({
                type: 'GET',
                headers: { 'Authorization': '@_tokan' },
                url: _urlcmp,
                data: { 'CloumnsList': "'" + _Master_Customlst + "'" },
                contentType: "application/json",
