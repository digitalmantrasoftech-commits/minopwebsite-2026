<script type="text/javascript">
    var selecteditemArray = [];
    var _seletedtbllist = "";
    var _seletedtbllistcustom = "";
    function Rowenable(ctl) {

        if ($('#chkselect_t' + ctl).prop('checked') == true) {

            $('#chkgroup_' + ctl + '').prop('disabled', false);
            $('#chkorder_' + ctl + '').prop('disabled', false);
            $('#txtgroup_' + ctl + '').prop('disabled', false);
        }
        else {
            $('#chkgroup_' + ctl + '').prop('checked', false);
            $('#chkorder_' + ctl + '').prop('checked', false);
            $('#txtgroup_' + ctl + '').val(0);
            $('#txtorder_' + ctl + '').val(0);
            $('#chkgroup_' + ctl + '').prop('disabled', true);
            $('#chkorder_' + ctl + '').prop('disabled', true);
            $('#txtgroup_' + ctl + '').prop('disabled', true);
            $('#txtorder_' + ctl + '').prop('disabled', true);
            var index = $.inArray(ctl, selecteditemArray);
            if (index != -1) {
                selecteditemArray.splice(index, 1);
            }
        }

        $("#hdnfieldList").val(selecteditemArray);
    }
    function chkgrpchange(ctl) {
        if ($('#chkgroup_' + ctl + '').prop('checked') == true) {
            $('#txtgroup_' + ctl + '').prop('disabled', false);

        }
        else {
            $('#txtgroup_' + ctl + '').val(0);
            $('#txtgroup_' + ctl + '').prop('disabled', true);
        }
    }

    function chkorderchange(ctl) {
        if ($('#chkorder_' + ctl + '').prop('checked') == true) {
            $('.chkordby').prop('checked', false);
            $('#chkorder_' + ctl + '').prop('checked', true);
        }
        else {
            $('#txtorder_' + ctl + '').val(0);
        }
    }
    function fillmasterlst() {
        var $select = $("#Masterlst").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: false,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: false,

        });

        var $select1 = $("#Customlst").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: false,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true
        });

        $('#Masterlst').empty();
        $('#Customlst').empty();


        $.ajax(
            {
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + 'Report/Gettblmasterlist',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    $("#Masterlst").append("<option data-role='divider' class='selectpicker'></option>");
                    $("#Masterlst").append("<optgroup label='Master' data-role='divider'></optgroup>");
                    for (var x = 0; x < data.length; x++) {
                        if (data[x].flg == 0)
                            $("#Masterlst").append("<option value=" + data[x].ReporttablesId + ">" + data[x].Reporttablealias.replace("Master", "") + "</option>");
                    }

                    $("#Masterlst").append("<option data-role='divider' class='selectpicker'></option>");
                    $("#Masterlst").append("<optgroup label='Transaction' data-role='divider'></optgroup>");
                    $("#Masterlst").append("<option value=0>Transaction</option>");

                    var y = 0;

                    for (var x = 0; x < data.length; x++) {
                        if (data[x].flg == 1) {

                            if (y == 0) {
                                $("#Masterlst").append("<option data-role='divider' class='selectpicker'></option>");
                                $("#Masterlst").append("<optgroup label='Custom'></optgroup>");
                                y = 1;
                            }

                            $("#Masterlst").append("<option value=" + data[x].ReporttablesId + ">" + data[x].Reporttablealias + "</option>");
                        }
                    }
                    $select.multiselect('rebuild');
                    $(document.body).on('change', '#Masterlst', function () {
                        $(".popMsg").hide();
                        var deptid = $('#Masterlst option:selected');
                        var DeptArray = [];
                        $(Masterlst).each(function (index, deptid) {
                            DeptArray.push($(this).val());
                        });
                        _seletedtbllist = DeptArray.join(',');
                    });
                    $("#ajax_loader").hide();
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#ajax_loader").hide();
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }

                }
            });
    }
    $(document).ready(function () {
