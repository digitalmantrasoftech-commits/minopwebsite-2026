                var newdate = new Date(fromDate);
            }
            else {
                var fromDate = $("#FromDate").val();
                var newdate = new Date(fromDate);
            }
            if ("@_isdateformat" == "dd-M-yyyy" || "@_isdateformat" == "M-dd-yyyy" || "@_isdateformat" == "yyyy-M-dd") {
                if (newdate.getMonth() <= 8) {
                    i = newdate.toLocaleString('en-us', { month: 'short' });
                }
                else {
