        function fillDeptTable(BranchId, selectedDept) {

            $("#DeptIds").empty();
            if ($.isArray(BranchId)) {
                var branchid = BranchId.join();
            }
            else {
                var branchid = BranchId;
            }
            var obj = {
                BranchId: branchid
            };
            $.ajax({
                type: "GET",
                url: "/MasterData/GetDeptbyBranchstrfltr",
                data: obj,
                //url: "/MasterData/GetDeptbyBranchstr?BranchId=" + BranchId,
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            if (selectedDept.length != 0 && selectedDept != null) {
                                var re = new RegExp("(^|,)" + response[i].Value + "($|,)");
                                if (re.test(selectedDept) == true) {
                                    $('#DeptIds').append('<option value=" ' + response[i].Value + '" selected>' + response[i].Text + '</option>');
                                }
                                else {
                                    $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                                }
                            }
                            else {
                                $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                            }
                        }
                        $select.multiselect('rebuild');
                        $(document.body).on('change', '#DeptIds', function () {
                            $("#spvalidation").hide();
                            var deptid = $('#DeptIds option:selected');
                            var DeptArray = [];
                            $(deptid).each(function (index, deptid) {
                                DeptArray.push([$(this).val()]);
                            });
                            if (DeptArray == "") {
                                $("#txt2").val(0);
                            }
                            else {
                                $("#txt2").val(DeptArray);
                                $("#spValidation").hide();
                            }
                            var ArrDept = $("#txt2").val();
                            DeptIdlst = ArrDept;
                            $("#DepId").val(DeptIdlst);
                            $("#ActiveEmployee").prop('checked', true);
                            $("#ActiveEmployee").attr("value", 1);
                            getEmp();
                            $("#IsFilo").prop('checked', true);
                            $("#IsFilo").attr("value", 1);

                        });
                    }
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }



        function fillAllTable() {
            var obj = { FromDate: $("#FromDate").val(), Todate: $("#Todate").val(), EmpID: selectedEmpArray, ReportName: $('#ReportName').val(), CompanyID: $('#CompanyID').val(), RptID: $('#RptID').val(), CompanyName: $('#CompanyName').val(), BranchName: $('#BranchName').val(), IsFilo: $("#FLOut").val(), };
            $.ajax(
             {
                 type: "Post",
                 url: "/Report/PayTimeWebReports",
                 dataType: "json",
                 data: JSON.stringify(obj),
                 contentType: "application/json; charset=utf-8",

                 error: function (jqXHR, ajaxOptions, thrownError) {
                     $('.loading').hide();

                     if (jqXHR.status == 500) { //InternalServerError = 500,
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) { //BadRequest = 400,
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                 },
             });
        };
        function getEmp() {
            $("#empdiv").show();
            $("#lblemp").show();
            $("#tblemp").empty();
            var bID = $("#BranchId").val();
            var dep = $("#txt2").val();
            var Dep = dep.replace(/\s/g, '');
            var isActiveEmployee = $("#ActiveEmployee").val();
            if (strselectedEmpID != "" && selectedBranch != "") {
                bID = selectedBranch;
                bID = bID.join();
            }
            else {
                bID = bID;
            }
            //var urls = "/MasterData/GetEmpByBranchDept?departmentid=" + Dep + "&branchid=" + bID + "&isActiveEmployee=" + isActiveEmployee;
            var urls = "/MasterData/GetEmpByBranchDept";
            var method = "GET";
            var ajaxData = {
                departmentid: Dep,
                branchid: bID,
                isActiveEmployee: isActiveEmployee
            };
            if (croleid > 1) {
                urls = "/Transactions/GetEmpByDept";
                method = "POST";
                ajaxData = JSON.stringify({ empArr: Dep + ";" + bID });
            }
            $.ajax({
                type: method,
                url: urls,
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                data: ajaxData,
                async: "false",
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var table = "";
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            var tbl = "<tr class='odd gradeX'>";
                            tbl = tbl + "<td id='eid' hidden>" + response[i].EmpId;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td id='ecode'>" + response[i].Empcode;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td id='enm'>" + response[i].EmpName;
                            tbl = tbl + "</td>";
                            tbl = tbl + "<td id='epid'>" + response[i].EmpPunchID;
                            tbl = tbl + "</td>";
                            if (strselectedEmpID.length != 0) {
                                var re = new RegExp("(^|,)" + response[i].EmpId + "($|,)");
                                if (re.test(strselectedEmpID) == true) {
                                    tbl = tbl + "<td id=''><input type='checkbox' onchange='checkedDept(this)' class='ClsChkEmp' id='" + response[i].EmpId + "' checked/>";
                                }
                                else {
                                    tbl = tbl + "<td id=''><input type='checkbox' onchange='checkedDept(this)' class='ClsChkEmp' id='" + response[i].EmpId + "'/>";
                                }
                            }
                            else {
                                tbl = tbl + "<td id=''><input type='checkbox' onchange='checkedDept(this)' class='ClsChkEmp' id='" + response[i].EmpId + "'/>";
                            }
                            tbl = tbl + "</td>";
                            tbl = tbl + "</tr>";
                            table += tbl;
                        }
                    }
                    $("#tblemp").destroy;
                    $('#tblemp').append(table);
                    $('#tblemp').dataTable({
                        "columnDefs": [
                                            {
                                                "targets": '@IsSchool' == "1" ? [0, 1] : [0],
                                                "visible": false,
                                                "searchable": false,
                                            }
                        ],
                        "destroy": true,
                        "bInfo": true,
                        "bPaginate": false,
                        "bLengthChange": false,
                        "columns": [
                            { "title": "Employee ID" },
                            { "title": "Code" },
                            { "title": "Name", "orderable": true },
                            { "title": "Punch ID" },
                            { "title": "<input type='checkbox' class='ClsChkAllDept' onchange='AllCheckedEmp(this)' />" }
                        ],
                        "order": [[2, 'asc']]
                    });
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }
        $('#tblemp').on('click', 'input[type="checkbox"]', function (e) {
            $("#tblemp .ClsChkEmp").each(function () {
                if ($(this).is(':checked') == true) {
                    if (jQuery.inArray($(this).attr("id"), selectedEmpArray) == -1)
                        selectedEmpArray.push($(this).attr("id"));
                }
                else {
                    if (jQuery.inArray($(this).attr("id"), selectedEmpArray) == -1) {
                        var removeItem = $(this).attr("id");
                        //selectedEmpArray.splice($.inArray(itemtoRemove, selectedEmpArray), 1);
                        selectedEmpArray = jQuery.grep(selectedEmpArray, function (value) {
                            return value != removeItem;
                        });
                    }
                }
            });
            $("#EmpID").val(selectedEmpArray);
        });
        $("#BtnSave").click(function (e) {
            $("#ReportName").val(selectedReportName);
            $("#RptID").val(selectedreportid);
            if ($("#FromDate").val() == "") {
                toastr.remove();
                toastr.error("Please select from date.");
                return false;
            }
            if ($("#Todate").val() == "") {
                toastr.remove();
                toastr.error("Please select to date.");
                return false;
            }
            if ('@_isdateformat' == "dd-mm-yyyy") {
                if ($("#FromDate").val() != "" && $("#Todate").val() != "") {
                     var datefrom = $("#FromDate").val().split("-");
                     var todate = $("#Todate").val().split("-");
                     datefrom = datefrom[2] + "-" + datefrom[1] + "-" + datefrom[0];
                     todate = todate[2] + "-" + todate[1] + "-" + todate[0];
                     if (datefrom > todate) {
                         toastr.remove();
                         toastr.error("To date should be greater than from date.");
                         return false;
                     }
                 }

             }
             else {
                 var datefrom = $("#FromDate").val();
                 var todate = $("#Todate").val();
                 // Convert the date strings to Date objects
                 var fromDateObj = new Date(datefrom);
                 var toDateObj = new Date(todate);

                 if (fromDateObj > toDateObj) {
                     toastr.remove();
                     toastr.error("To date should be greater than from date.");
                     return false;
                 }
             }
            selectedEmpArray = [];
            if ($("#tblemp .ClsChkEmp").length != 0) {
                $("#tblemp .ClsChkEmp").each(function () {
                    if ($(this).is(':checked') == true) {
                        if (jQuery.inArray($(this).attr("id"), selectedEmpArray) == -1)
                            selectedEmpArray.push($(this).attr("id"));
                    }
                    else {
                        if (jQuery.inArray($(this).attr("id"), selectedEmpArray) == -1) {
                            var removeItem = $(this).attr("id");
                            selectedEmpArray = jQuery.grep(selectedEmpArray, function (value) {
                                return value != removeItem;
                            });
                        }
                    }
                });

                if (selectedEmpArray.length == 0) {
                    if ('@IsSchool' == "1") {
                        toastr.remove();
                        toastr.error("Please select student.");
                    }
                    else {
                        toastr.remove();
                        toastr.error("Please select employee.");
                        //$("#spvalidation").text("Please select Employee").show();
                    }
                    $("body").addClass("page-quick-sidebar-open");
                    e.preventDefault();
                    return false;
                }
                $("#EmpID").val(selectedEmpArray);
            }
            else {
                if ('@IsSchool' == "1") {
                    toastr.remove();
                    toastr.error("Please select  division");
                } else {
                    toastr.remove();
                    toastr.error("Please select department.");
                }
                $("body").addClass("page-quick-sidebar-open");
                e.preventDefault();
                return false;
            }
        });        
        if (croleid > 1 && croleid != 6805 && croleid != 6806) {
            if (selectedDeparment == "" && SelectedBranchName == "" && SelectedCompany == "") {
                $("#CompanyIds option[value = '" + companyid + "' ]").prop('selected', true);
                if (_accountcode == "OLA9368" || _accountcode == "SKE107C") {
                    $("#CompanyIds").multiselect("rebuild");
                }
                $("#CompanyID").val(companyid);
                $('#CompanyName').val($("#CompanyIds option:selected").text());
                $("#BranchId").val(branchid);
                fillBranchbycompnyid(companyid, branchid);
                $('#txt2').val(departmentid);
                $("#DepId").val(departmentid);
                fillDeptTable(branchid, departmentid);
                $("#ActiveEmployee").prop('checked', true);
                $("#ActiveEmployee").attr("value", 1);
                getEmp();
                $('#EmpID').val(empid);
                strselectedEmpID = empid;
                getBranchName(branchid);
            }
        }
    });
    function AllCheckedDept(ths) {
        $("#spvalidation").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkDept").prop('checked', true);

        }
        else {
            $(".ClsChkDept").prop('checked', false);
        }

    }
    function getBranchName(branchid) {
        $.ajax({
            type: "GET",
            url: '@_webapiurl' + 'Master/BranchGetById?id=' + branchid, // Replace with your actual API endpoint to get the branch name
            contentType: "application/json; charset=utf-8",
            headers: { 'Authorization': '@_tokan' },
            dataType: "json",
            success: function (data) {
                // Assuming data contains the branch name, update the "BranchName" field
                $('#BranchName').val(data[0].BranchName);
            },
            error: function (jqXHR, ajaxOptions, thrownError) {
                $('.loading').hide();

                if (jqXHR.status == 500) { //InternalServerError = 500,
                    toastr.error("InternalServerError");
                } else if (jqXHR.status == 400) { //BadRequest = 400,
                    toastr.error("BadRequest");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            },
        });
    }

    function AllCheckedEmp(ths) {
        $("#spvalidation").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkEmp").prop('checked', true);

        }
        else {
            $(".ClsChkEmp").prop('checked', false);
        }
        SelectedEmp();
    }
    function checkedDept(ths) {
        $("#spvalidation").hide();
    }
    function SelectedEmp() {
        var selectedEmpArray = [];
        $("#tblemp .ClsChkEmp").each(function () {
            if ($(this).is(':checked') == true) {
                selectedEmpArray.push($(this).attr("id"));
            }

        });
        $("#EmpID").val(selectedEmpArray);
    }
    function EmpIdArray(selectedEmpId, selection) {

        if (selection == true) {
            selectedEmpArray.push(selectedEmpId)
        }
        if (selection == false) {
            selectedEmpArray = jQuery.grep(selectedEmpArray, function (value) {
                return value != selectedEmpId;
            });
        }
        $("#EmpID").val(JSON.stringify(selectedEmpArray));
    };

    $(".page-quick-sidebar-toggler").click(function () {
        $("body").removeClass("page-quick-sidebar-open");
    });
</script>

