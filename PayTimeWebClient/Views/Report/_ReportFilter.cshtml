                }
            }
            //var newdate = new Date(fromDate);
            if ("@_isdateformat" == "yyyy-mm-dd") {
                $("#Todate").val(newdate.getFullYear() + "-" + i + "-" + k);
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                $("#Todate").val(i + "-" + k + "-" + newdate.getFullYear());
            }
            else if ("@_isdateformat" == "dd-mm-yyyy") {
