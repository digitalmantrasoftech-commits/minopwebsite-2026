@model PayTimeWebClient.Models.reqDailyInOutReport
@using System.Data;
@using PayTimeWebClient.Helper;
@using System.Configuration;
@using PayTimeWebClient.Models;

@{
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();

    ViewBag.Title = "Dynamic Report Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ReportDataRestClient objreport = new ReportDataRestClient();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenurole = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenurole.Where(m => m.ActionUrl.ToLowerInvariant().Equals(actionurl.ToLowerInvariant()));
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    string IsSchool = HttpContext.Current.Session["IsSchool"].ToString();
}

<script>
    var selectedEmpArray = new Array();
    $(document).ready(function () {

        var flgscl = '@IsSchool';
        if (flgscl == "1") {
            $('.repo_right p').css({ "font-size": "13px", "padding-top": "0" });
        }
        $("#btnReports").css("display", "none");

        $('.row a').click(function (e) {
            $("#spvalidation").html('');
            var _searchcriteria = "";
            var _spvalidationvalid = "";
            var _ReportHead = "";
            $("#tblcol .chkselectcol").each(function () {
                if ($(this).is(':checked') == true) {
                    var ctl = $(this).val();
                    var _alias = $('#txtalias_' + ctl + '').val();
                    if (_alias == "") {
                        $("body").addClass("page-quick-sidebar-open");
                        $("#btnReports").css("display", "none");
                        $("#spvalidation").val("no any filed")
                        return false;
                    }
                    if (_searchcriteria == "") {
                        _searchcriteria = "`" + ctl + "`='" + _alias + "'";
                    }
                    else {
                        _searchcriteria += "and `" + ctl + "`='" + _alias + "'";
                    }
                }
            });

            $("#btnReports").css("display", "");

            if (_searchcriteria != "") {
                _searchcriteria = "'" + _searchcriteria + "'";
            }
            $("#SearchCriteria").val(_searchcriteria)

            $("body").toggleClass("page-quick-sidebar-open");
            $('#frmrpt').submit();

        });
    });

    $('.dropdown-toggle').click(function (e) {
        //alert('hi');
        var _ss = document.getElementById('tblcolbody').innerHTML;

    });

    function ShowReport() {
        $("#spvalidation").html('');
        var _searchcriteria = "";
        var _spvalidationvalid = "";
        var _ReportHeaderName = "";

        $("#tblcol .chkselectcol").each(function () {
            if ($(this).is(':checked') == true) {
                var ctl = $(this).val();
                var _alias = $('#txtalias_' + ctl + '').val();
                var _Contains = $('#txtContains_' + ctl + '').val();

                if (_alias == "") {
                    //$("#spvalidation").html("Please enter " + ctl + ".").show();
                    //_spvalidationvalid = $("#spvalidation").html();
                }


                if (_searchcriteria == "") {
                    //_searchcriteria = "`" + ctl + "`='" + _alias + "'";

                    if (_Contains == "IS") {
                        _searchcriteria = "`" + ctl + "` = '" + _alias + "'";
                    }
                    else if (_Contains == "ISNot") {
                        _searchcriteria = "`" + ctl + "` != '" + _alias + "'";
                    }
                    else if (_Contains == "StartWith") {
                        _searchcriteria += "`" + ctl + " `like '" + _alias + "%'";

                    }
                    else if (_Contains == "EndsWith") {
                        _searchcriteria += "`" + ctl + "` like '%" + _alias + "'";
                    }
                    else if (_Contains == "Like") {
                        _searchcriteria = "`" + ctl + "` like '%" + _alias + "%'";
                    }
                    else if (_Contains == "IsEmpty") {
                        _searchcriteria = "`" + ctl + "` = ''";
                    }
                    else if (_Contains == "IsNotEmpty") {
                        _searchcriteria = "`" + ctl + "` != ''";
                    }
                    else {
                        _searchcriteria = "`" + ctl + "` = '" + _alias + "'";
                    }

                }
                else {
                    //_searchcriteria += "and `" + ctl + "`='" + _alias + "'";

                    if (_Contains == "IS") {
                        _searchcriteria += "and `" + ctl + "` = '" + _alias + "'";
                    }
                    else if (_Contains == "ISNot") {
                        _searchcriteria += "and `" + ctl + "` != '" + _alias + "'";
                    }
                    else if (_Contains == "StartWith") {
                        _searchcriteria += "and `" + ctl + "` like '" + _alias + "%'";

                    }
                    else if (_Contains == "EndsWith") {
                        _searchcriteria += "and `" + ctl + "` like '%" + _alias + "'";
                    }
                    else if (_Contains == "Like") {
                        _searchcriteria += "and `" + ctl + "` like '%" + _alias + "%'";
                    }
                    else if (_Contains == "IsEmpty") {
                        _searchcriteria += "and `" + ctl + "` = ''";
                    }
                    else if (_Contains == "IsNotEmpty") {
                        _searchcriteria += "and `" + ctl + "`!=''";
                    }
                    else {
                        _searchcriteria += "and `" + ctl + "`='" + _alias + "'";
                    }
                }
            }
        });
        if (_searchcriteria != "") {
            _searchcriteria = "'" + _searchcriteria + "'";
        }
        $("#SearchCriteria").val(_searchcriteria)
        $("#ReportHead").val($("#lblReportName").text());
        //if (_spvalidationvalid == "") {
        var objcls = {
            "ReportId": $("#ReportID").val(),
            "SearchCriteria": $("#SearchCriteria").val(),
            "ReportHead": $("#ReportHead").text()
        }
        $("body").toggleClass("page-quick-sidebar-open");
        return true;
        //}
        //else
        //{
        //    return false;
        //}

    };
    function Rowenable(ctl) {
        if ($('#chkselect_t' + ctl).prop('checked') == true) {
            $('#txtalias_' + ctl + '').css('display', "block");
            $('#txtContains_' + ctl + '').css('display', "block");
        }
        else {
            $('#txtalias_' + ctl + '').css('display', "none");
            $('#txtalias_' + ctl + '').val('');
            $('#txtContains_' + ctl + '').css('display', "none");
            $('#txtContains_' + ctl + '').val('IS');
        }
    }
    function cleardata() {
        bindcoltablewithdata($("#ReportID").val());
    };
    function FilterCriteria(ID) {
        $("#spvalidation").html('');
        bindcoltablewithdata(ID);
    }
    function bindcoltablewithdata(ID) {
        $("#ReportID").val(ID)
        $("#SearchCriteria").val('');
        $("#ReportHead").val('');
        var token = '@_tokan'
        var _url = '@_webapiurl' + 'Report/GetselectColumnslist';
        $.ajax({
            type: 'GET',
            headers: { 'Authorization': '@_tokan' },
            url: _url,
            data: { 'ReportsID': "" + ID + "" },
            contentType: "application/json",
            dataType: 'json',
            async: false,
            cache: false,
            timeout: 30000,
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (data) {
                document.getElementById('tblcolbody').innerHTML = '';
                var tr;
                var coldt = data;
                tr = "<tr class='header_report_filter'>";
                tr += "<td style='width:10px;'>Select</td>";
                tr += "<td id='lbl_select'>Fields</td>";
                tr += "<td colspan='2'></td>";
                tr += "<td><input type='text' id='txtalias_'  class='form-control input-sm input-small input-inline' name='txtAlias_' maxlength='50' value='' style='display:none;'></td>";
                tr += "</tr>";
                $('#tblcolbody').append(tr);
                for (var i = 0; i < coldt.length; i++) {
                    $("#lblReportName").text("Reports Name :- " + coldt[i].ReportName)
                    tr = "<tr>";
                    tr += ("<td style='width:10px;'> <input type='checkbox' onchange=Rowenable('" + coldt[i].ReportfieldName + "');  id='chkselect_t" + coldt[i].ReportfieldName + "' class='chkselectcol' name='chkselect_" + coldt[i].ReportfieldName + "' value='" + coldt[i].ReportfieldName + "'></td>");
                    tr += ("<td id='lbl_" + coldt[i].ReportfieldName + "'>" + coldt[i].Reportfieldalias + "</td>");
                    tr += ("<td><span style='display:none;'>" + coldt[i].ReporttablesId + "</span></td>");
                    tr += ("<td><select class='form-control input-sm input-small input-inline' name='txtContains_" + coldt[i].ReportfieldName + "' id='txtContains_" + coldt[i].ReportfieldName + "'  style='display:none;'> <option value='IS'>IS</option>  <option value='ISNot'>IS Not</option>  <option value='StartWith'>Start With</option> <option value='EndsWith'>Ends With</option> <option value='Like'>Like</option> <option value='IsEmpty'>Is Empty</option> <option value='IsNotEmpty'>Is Not Empty</option> </select></td>");
                    tr += ("<td><input type='text' id='txtalias_" + coldt[i].ReportfieldName + "'  class='form-control input-sm input-small input-inline' name=txtAlias_" + coldt[i].ReportfieldName + " maxlength='50' value='' style='display:none;'></td>");
                    tr += "</tr>";
                    $('#tblcolbody').append(tr);
                }
                $("#ajax_loader").hide();
            },
            error: function () {
                $("#ajax_loader").hide();
            }
        });
    }
</script>
<div class="page-bar">
    <ul class="page-breadcrumb">
        @if (IsSchool == "1")
        {
            <li>
                <a href="/School/AdminDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
        }
        else
        {
            if (_RoleId == 1)
            {
                <li>
                    <a href="/Dashboard/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                </li>
            }
            else
            {
                <li>
                    <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
                </li>
            }
        }


        <li>
            <span><i class="fa-light fa-angle-right"></i> Report Filter</span>
        </li>
    </ul>
    @if (obj.CanView)
    {
        <div class="page-toolbar">
            <div class="text-right">
                <div class="dropdown dropdown-quick-sidebar-toggler">
                    <a href="javascript:;" class="dropdown-toggle btn icon_btn tooltips" data-placement="left" title="Filter">
                        <i class="fa-light fa-filter"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
@if (obj.CanView)
{

    <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="note note-info" id="filternote" style="display:none;">
                <h4 class="block">Filter Summary </h4>
                <p id="filterpara"></p>
            </div>
            <div>
                @{
    if (!string.IsNullOrEmpty(_tokan) && _RoleId > 0)
    {
        var Dynamicreporttemplate = objreport.GetDynamicreportlist();
        if (Dynamicreporttemplate != null && _RoleId == 1)
        {
                <div>
                    <div class="row">
                        @foreach (PayTimeWebClient.Models.Reporttemplate itemSub in Dynamicreporttemplate)
                    {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <a href="#">
                            <div class="repo_bg" onclick="FilterCriteria(@itemSub.ReportId)">
                                <div class="repo_left"><i class="fa-regular fa-file-lines"></i></div>
                                <div class="repo_right">
                                    <p>@itemSub.ReportName</p><input type="hidden" id="hdncrptid" value="@itemSub.ReportId" />
                                    <input type="hidden" id="hdncrpttype" value="@itemSub.ReportType" />
                                    <input type="hidden" id="hdncrptHeaderName" value="@itemSub.ReportHeaderName" name="hdncrptHeaderName" />
                                </div>
                            </div>
                        </a>
                    </div>
                    }

                    </div>
                </div>
        }
    }
                }
            </div>
        </div>
    </div>

    <form action="DynamicReportDashboard" method="post" id="login">
        <div class="portlet page-quick-sidebar-wrapper" data-close-on-body-click="false">
            <div class="portlet-title">
                <h2><i class="fa-light fa-filter"></i>&nbsp;Filter</h2>
                <a href="javascript:;" class="page-quick-sidebar-toggler"><i class="icon-login"></i></a>
            </div>
            <div class="portlet-body">
                <div class="box_filter_data">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <h3 class="title_filer_custom" id="lblReportName"></h3>
                            <br />
                            <center><span class="help-block" id="spvalidation" style="font-size:14px">Please select Report</span></center>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <fieldset>
                                <div class="table-responsive">
                                    <table id="tblcol" class="table table-striped table-hover table-checkable order-column">
                                        <tbody id="tblcolbody"></tbody>
                                    </table>
                                </div>
                            </fieldset>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                            <div class="form-actions" id="btnReports">
                                <input id="ReportID" type="hidden" name="ReportID">
                                <input id="SearchCriteria" type="hidden" name="SearchCriteria" >
                                <input id="ReportHead" type="hidden" name="ReportHead">
                                <button type="submit" onclick="ShowReport();" class="btn ok_btn">OK</button>
                                <button type="button" onclick="cleardata()" id="btnclear" class="btn clear_btn">Clear</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <style type="text/css">
        @@import url("../assets/css/CustomDesign/DynamicReportDashboard.css");
    </style>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}


