@model System.Data.DataTable
@{
    string _rname = ViewBag.Gridheader;
    int _rptid = ViewBag.Rptid;
    string title = "<b>" + _rname + "</b>";
}

@Html.DevExpress().GridView(
   settings =>
   {
       settings.Name = "GridView";
       settings.SettingsPager.Visible = true;
       settings.Settings.ShowGroupPanel = true;
       settings.Settings.ShowFilterRow = true;
       settings.KeyFieldName = "empid";
       settings.SettingsBehavior.AllowSelectByRowClick = true;
       settings.SettingsBehavior.EnableCustomizationWindow = true;
       settings.ClientSideEvents.CustomizationWindowCloseUp = "grid_CustomizationWindowCloseUp";
       settings.SettingsAdaptivity.AdaptivityMode = GridViewAdaptivityMode.HideDataCellsWindowLimit;
       settings.SettingsAdaptivity.AdaptiveColumnPosition = GridViewAdaptiveColumnPosition.Right;
       settings.Styles.Header.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
       settings.Styles.Header.Font.Bold = true;
       settings.SettingsAdaptivity.AdaptiveDetailColumnCount = 1;
       settings.SettingsAdaptivity.AllowOnlyOneAdaptiveDetailExpanded = true;
       settings.SettingsAdaptivity.HideDataCellsAtWindowInnerWidth = 0;
       settings.SettingsResizing.ColumnResizeMode = ColumnResizeMode.Control;
       settings.SettingsResizing.Visualization = ResizingMode.Postponed;
       settings.SettingsBehavior.AllowEllipsisInText = true;
       settings.Settings.ShowTitlePanel = true;
       settings.SettingsPager.Mode = GridViewPagerMode.ShowPager;
       settings.SettingsPager.FirstPageButton.Visible = true;
       settings.SettingsPager.LastPageButton.Visible = true;
       settings.SettingsPager.PageSizeItemSettings.Visible = true;
       settings.SettingsPager.PageSizeItemSettings.Items = new string[] { "10", "30", "50" };
       settings.SettingsPager.PageSize = 30;
       settings.SetTitlePanelTemplateContent(title);
       settings.CallbackRouteValues = new { Controller = "Report", Action = "SchoolReportsPartial" };
       
       if (Model != null && Model.Rows.Count != 0)
       {
           if (_rptid == 1)
           {
               foreach (System.Data.DataColumn column in Model.Columns)
               {
                   if (column.ColumnName == "SchoolName" || column.ColumnName == "SchoolAddress" || column.ColumnName == "ClassDiv" || column.ColumnName == "empid")
                   {
                       settings.Columns.Add(column.ColumnName).Visible = false;
                   }
                   else if (column.ColumnName == "Attn_dt")
                   {
                       settings.Columns.Add("Attn_dt", "Date").GroupIndex = 0;
                   }
                   else if (column.ColumnName == "WH")
                   {
                       settings.Columns.Add("WH", "WorkingHours");
                   }
                   else
                   {
                       settings.Columns.Add(column.ColumnName);
                   }

               }
               settings.SettingsBehavior.AutoExpandAllGroups = true;
           }
           else if (_rptid == 2)
           {

               foreach (System.Data.DataColumn column in Model.Columns)
               {
                   if (column.ColumnName == "SchoolName" || column.ColumnName == "SchoolAddress" || column.ColumnName == "ClassDiv")
                   {
                       settings.Columns.Add(column.ColumnName).Visible = false;
                   }
                   else
                   {
                       settings.Columns.Add(column.ColumnName);
                   }
               }
               
           }
           else if (_rptid == 3)
           {
               foreach (System.Data.DataColumn column in Model.Columns)
               {

                   if (column.ColumnName == "SchoolName" || column.ColumnName == "SchoolAddress" || column.ColumnName == "ClassDiv" || column.ColumnName == "Shift" || column.ColumnName == "ClassDiv" || column.ColumnName == "Stu_Name" || column.ColumnName == "CardNo" || column.ColumnName == "Admin_No")
                   {
                       settings.Columns.Add(column.ColumnName).Visible = false;
                   }
                   else if (column.ColumnName == "Gname")
                   {
                       settings.Columns.Add("Gname", "Student").GroupIndex = 0;
                   }
                   else
                   {
                       settings.Columns.Add(column.ColumnName);
                   }
               }
               settings.SettingsBehavior.AutoExpandAllGroups = true;
           }
           else if (_rptid == 4)
           {
               foreach (System.Data.DataColumn column in Model.Columns)
               {

                   if (column.ColumnName == "SchoolName" || column.ColumnName == "SchoolAddress" || column.ColumnName == "Shift" || column.ColumnName == "ClassDiv" || column.ColumnName == "Stu_Name" || column.ColumnName == "CardNo" || column.ColumnName == "Admin_No")
                   {
                       settings.Columns.Add(column.ColumnName).Visible = false;
                   }
                   else if (column.ColumnName == "Gname")
                   {
                       settings.Columns.Add("Gname", "Student").GroupIndex = 0;
                   }
                   else
                   {
                       settings.Columns.Add(column.ColumnName);
                   }
               }
               settings.SettingsBehavior.AutoExpandAllGroups = true;
           }
           else if (_rptid == 5)
           {
               foreach (System.Data.DataColumn column in Model.Columns)
               {

                   if (column.ColumnName == "SchoolName" || column.ColumnName == "SchoolAddress" || column.ColumnName == "Shift" || column.ColumnName == "ClassDiv" || column.ColumnName == "Attendance")
                   {
                       settings.Columns.Add(column.ColumnName).Visible = false;
                   }
                   else if (column.ColumnName == "PunchDate")
                   {
                       settings.Columns.Add("PunchDate", "Date").GroupIndex = 0;
                   }
                   else
                   {
                       settings.Columns.Add(column.ColumnName);
                   }
               }
               settings.SettingsBehavior.AutoExpandAllGroups = true;
           }
           else if (_rptid == 6)
           {
               foreach (System.Data.DataColumn column in Model.Columns)
               {
                   if (column.ColumnName == "ClassDiv" || column.ColumnName == "SchoolName" || column.ColumnName == "SchoolAddress" || column.ColumnName == "MonthRepostartday" || column.ColumnName == "LastdayMonth" || column.ColumnName == "empid")
                   {
                       settings.Columns.Add(column.ColumnName).Visible = false;
                   }
                   else if (column.ColumnName == "PunchID")
                   {
                       settings.Columns.Add(AdminNocolumn =>
                       {
                           AdminNocolumn.FieldName = "PunchID";
                           AdminNocolumn.Caption = "PunchID";
                           AdminNocolumn.Width = 125;
                           AdminNocolumn.FixedStyle = GridViewColumnFixedStyle.Left;
                           AdminNocolumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
                       });
                   }
                   else if (column.ColumnName == "GRNo")
                   {
                       settings.Columns.Add(AdminNocolumn =>
                       {
                           AdminNocolumn.FieldName = "GRNo";
                           AdminNocolumn.Caption = "G.R.No";
                           AdminNocolumn.Width = 100;
                           AdminNocolumn.FixedStyle = GridViewColumnFixedStyle.Left;
                           AdminNocolumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
                       });
                   }
                   else if (column.ColumnName == "Stu_Name")
                   {
                       settings.Columns.Add(StuNamecolumn =>
                       {
                           StuNamecolumn.FieldName = "Stu_Name";
                           StuNamecolumn.Caption = "Name";
                           StuNamecolumn.Width = 200;
                           StuNamecolumn.FixedStyle = GridViewColumnFixedStyle.Left;
                           StuNamecolumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
                       });
                   }
                   else
                   {
                       settings.Columns.Add(Daycolumn =>
                       {
                           Daycolumn.FieldName = column.ColumnName;
                           Daycolumn.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
                           Daycolumn.Width = 50;
                       });
                   }
               }
               settings.Settings.HorizontalScrollBarMode = ScrollBarMode.Visible;
               settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

               settings.SettingsExport.EnableClientSideExportAPI = true;

               settings.SettingsExport.ExcelExportMode = DevExpress.Export.ExportType.WYSIWYG;
               settings.SettingsExport.FileName = "School Reports";
               settings.Toolbars.Add(t =>
               {
                   //t.SettingsAdaptivity.Enabled = true;
                   //t.SettingsAdaptivity.EnableCollapseRootItemsToIcons = true;
                   t.Items.Add(GridViewToolbarCommand.ExportToPdf);
                   t.Items.Add(GridViewToolbarCommand.ExportToXls);
                   //t.Items.Add(GridViewToolbarCommand.ExportToXlsx);
                   //t.Items.Add(GridViewToolbarCommand.ExportToDocx);
                   //t.Items.Add(GridViewToolbarCommand.ExportToRtf);
                   //t.Items.Add(GridViewToolbarCommand.ExportToCsv);
               });
           }
       }

   }).Bind(Model).GetHtml()