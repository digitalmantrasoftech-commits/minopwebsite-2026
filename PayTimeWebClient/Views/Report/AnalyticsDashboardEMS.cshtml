<!-- Drag & Drop for Report Cards -->
<script>
    (function () {
        var ANALYTICS_USER_ID = '@_UserId';
        var SECTION_KEY = 'analyticsEMSSectionOrder_' + ANALYTICS_USER_ID;
        var CARD_KEY_PREFIX = 'analyticsEMSCardOrder_' + ANALYTICS_USER_ID + '_';

        var cardContainerIds = ['EMSReportContent1'];

        function addCardDragHandles(containerId) {
            $('#' + containerId + ' > div').each(function () {
                var $block = $(this).find('.report_block').first();
                if ($block.length && !$block.find('.drag-handle-report').length) {
                    $block.prepend('<span class="drag-handle-report tooltips" data-placement="top" data-original-title="Drag to reorder"><i class="fa-light fa-grip-dots-vertical"></i></span>');
                }
            });
        }

        function addSectionDragHandles() {
            $('#Reports_ui_blocks > .col-md-12').each(function () {
                var $title = $(this).find('.dashboard-sub-title').first();
                if ($title.length && !$title.find('.drag-handle-section').length) {
                    $title.prepend('<span class="drag-handle-section tooltips" data-placement="top" data-original-title="Drag section"><i class="fa-light fa-grip-dots-vertical"></i></span>');
                }
            });
        }

        function getOrder(containerId) {
            var order = [];
            $('#' + containerId + ' > div').each(function () {
                var id = $(this).find('a.local_report_icon').attr('id') || $(this).index().toString();
                order.push(id);
            });
            return order;
        }

        function getSectionOrder() {
            var order = [];
            $('#Reports_ui_blocks > .col-md-12').each(function () {
                var $toggle = $(this).find('[id^="leaveReportsToggle"]');
                if ($toggle.length) {
                    order.push($toggle.attr('id'));
                }
            });
            return order;
        }

        function saveCardOrder(containerId) {
            try {
                localStorage.setItem(CARD_KEY_PREFIX + containerId, JSON.stringify(getOrder(containerId)));
            } catch (e) { }
        }

        function saveSectionOrder() {
            try {
                localStorage.setItem(SECTION_KEY, JSON.stringify(getSectionOrder()));
            } catch (e) { }
        }

        function restoreCardOrder(containerId) {
            try {
                var saved = localStorage.getItem(CARD_KEY_PREFIX + containerId);
                if (!saved) return;
                var order = JSON.parse(saved);
                if (!Array.isArray(order) || order.length === 0) return;

                var $container = $('#' + containerId);
                var idMap = {};

                $container.children('div').each(function () {
                    var linkId = $(this).find('a.local_report_icon').attr('id');
                    if (linkId) {
                        idMap[linkId] = $(this);
                    }
                });

                for (var i = 0; i < order.length; i++) {
                    if (idMap[order[i]]) {
                        $container.append(idMap[order[i]]);
                        delete idMap[order[i]];
                    }
                }
                for (var key in idMap) {
                    $container.append(idMap[key]);
                }
            } catch (e) { }
        }

        function restoreSectionOrder() {
            try {
                var saved = localStorage.getItem(SECTION_KEY);
                if (!saved) return;
                var order = JSON.parse(saved);
                if (!Array.isArray(order) || order.length === 0) return;

                var $container = $('#Reports_ui_blocks');
                var idMap = {};

                $container.children('.col-md-12').each(function () {
                    var $toggle = $(this).find('[id^="leaveReportsToggle"]');
                    if ($toggle.length) {
                        idMap[$toggle.attr('id')] = $(this);
                    }
                });

                for (var i = 0; i < order.length; i++) {
                    if (idMap[order[i]]) {
                        $container.append(idMap[order[i]]);
                        delete idMap[order[i]];
                    }
                }
                for (var key in idMap) {
                    $container.append(idMap[key]);
                }
            } catch (e) { }
        }

        // Restore order IMMEDIATELY to prevent position flash
        restoreSectionOrder();
        for (var k = 0; k < cardContainerIds.length; k++) {
            restoreCardOrder(cardContainerIds[k]);
        }

        function initAnalyticsSortable() {
            var sectionEl = document.getElementById('Reports_ui_blocks');
            if (!sectionEl) return;

            addSectionDragHandles();
            $('.drag-handle-section.tooltips').tooltip({ container: 'body', trigger: 'hover' });

            Sortable.create(sectionEl, {
                handle: '.drag-handle-section',
                animation: 250,
                ghostClass: 'section-sortable-ghost',
                chosenClass: 'section-sortable-chosen',
                draggable: '.col-md-12',
                easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
                onEnd: function () {
                    saveSectionOrder();
                }
            });

            // Init card-level drag within each section
            for (var i = 0; i < cardContainerIds.length; i++) {
                var cId = cardContainerIds[i];
                var el = document.getElementById(cId);
                if (!el) continue;

                addCardDragHandles(cId);
                $('#' + cId + ' .drag-handle-report.tooltips').tooltip({ container: 'body', trigger: 'hover' });

                (function (containerId) {
                    Sortable.create(document.getElementById(containerId), {
                        handle: '.drag-handle-report',
                        animation: 250,
                        ghostClass: 'sortable-ghost',
                        chosenClass: 'sortable-chosen',
                        dragClass: 'sortable-drag',
                        easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
                        onEnd: function () {
                            saveCardOrder(containerId);
                        }
                    });
                })(cId);
            }
        }

        // Only delay Sortable init + drag handles, NOT the order restore
        setTimeout(function () {
            initAnalyticsSortable();
        }, 1000);
    })();
</script>

