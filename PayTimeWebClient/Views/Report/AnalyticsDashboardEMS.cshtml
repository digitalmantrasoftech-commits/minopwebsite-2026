    function fillDeptTable(BranchId, selectedDept) {
        $("#DepartmentID").empty();
        if ($.isArray(BranchId)) {
            var branchid = BranchId.join();
            tempbranch = BranchId.join();
        }
        else {
            var branchid = BranchId;
            tempbranch = BranchId;
        }
        var obj = {
            BranchId: branchid
        };
        $.ajax({
            type: "GET",
            url: "/MasterData/GetDeptbyBranchstrfltr",
            data: obj,
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            success: function (response) {

                if (response != null) {
                    for (var i = 0; i < response.length; i++) {
                        if (selectedDept.length != 0 && selectedDept != null) {
                            var re = new RegExp("(^|,)" + response[i].Value + "($|,)");
                            if (re.test(selectedDept) == true) {
                                $('#DepartmentID').append('<option value=" ' + response[i].Value + '" selected>' + response[i].Text + '</option>');
                            }
                            else {
                                $('#DepartmentID').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                            }
                        }
                        else {
                            $('#DepartmentID').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                        }
                    }
                    $select.multiselect('rebuild');
                    $(document.body).on('change', '#DepartmentID', function () {

                        $("#spvalidation").hide();
                        var deptid = $('#DepartmentID option:selected');
                        var DeptArray = [];
                        $(deptid).each(function (index, deptid) {
                            DeptArray.push([$(this).val()]);
                        });
                        if (DeptArray == "") {
                            $("#txt2").val(0);
                        }
                        else {
                            $("#txt2").val(DeptArray);
                            $("#spValidation").hide();
                        }
                        var ArrDept = $("#txt2").val();
                        DeptIdlst = ArrDept;
                        $("#DepId").val(DeptIdlst);
                        $("#ActiveEmployee").prop('checked', true);
                        $("#ActiveEmployee").attr("value", 1);
                        getEmp();
                    });
                }
                $(".loading").hide();
            },
            beforeSend: function () {
                $(".loading").show();
            },
            error: function () {
                $(".loading").hide();
            }
        });
    }
