    function FetchDates() {
        let selectedText = $("#daterange").val();
        if (predefinedRanges.hasOwnProperty(selectedText)) {
            let fromDate = predefinedRanges[selectedText][0].format("YYYY-MM-DD");
            let toDate = predefinedRanges[selectedText][1].format("YYYY-MM-DD");

            console.log("Predefined Range - From Date:", fromDate, "To Date:", toDate);
            return { fromDate, toDate };
        } else {

            let customRangeText = $("#custom_daterange").val();

            if (customRangeText) {
                let dates = customRangeText.split(" - ");
                let fromDate = moment(dates[0], "DD/MM/YYYY").format("YYYY-MM-DD");
                let toDate = moment(dates[1], "DD/MM/YYYY").format("YYYY-MM-DD");

                console.log("Custom Range - From Date:", fromDate, "To Date:", toDate);
                return { fromDate, toDate };
            } else {
                console.log("No valid date range selected.");
                return null;
            }
        }
    }
