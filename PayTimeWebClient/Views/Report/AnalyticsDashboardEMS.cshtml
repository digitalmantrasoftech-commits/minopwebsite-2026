    function validation(e) {
        var bid = $("#BranchID").val();
        if ((bid == "") || (bid == null)) {
            $("#DepartmentID").prop("disabled", true);
        }
        else {
            $("#DepartmentID").prop("disabled", false);
        }
        if ($("#CompanyID").val() == null || $("#CompanyID").val() == "") {
            toastr.error("Please select Company!");
            e.preventDefault();
            return false;
        }
        if ((bid == "") || (bid == null)) {
            toastr.error("Please select Branch!");
            e.preventDefault();
            return false;
        }
        if (departmentGlobal == null || departmentGlobal == "") {
            toastr.error("Please select Department!");
            e.preventDefault();
            return false;
        }
        if (selectedEmpArray.length == 0) {
            toastr.error("Please select Employee!");
            e.preventDefault();
            return false;
        }
        return true;
    }
    function HasFilterStored() {
    $.ajax({
        type: "POST",
        url: '@_webapiurl' + "/Report/HasFilterStoredems" ,
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        beforeSend: function (xhr) {
            xhr.setRequestHeader("Authorization", '@_tokan');
        },
        success: function (data) {
            let storedCompany = sessionStorage.getItem("selectedCompany_${'@_UserId'}`");
            if (data != null && data.length > 0) {
                $("#modal_recall").addClass('active');
                FlagForFilter = 1;
                let empIdArray = data[0].EmpId ? data[0].EmpId.split(",").map(id => id.trim()) : [];
                sessionStorage.setItem("selectedCompany_${'@_UserId'}`", data[0].CompanyId);
                sessionStorage.setItem("selectedBranch", data[0].BranchId);
                sessionStorage.setItem("selectedDepartment", data[0].DepartmentId);
                sessionStorage.setItem("selectEmployee", JSON.stringify(empIdArray))
                sessionStorage.setItem("isActiveEmployeeChecked", data[0].IsActive);
            }
            else if (storedCompany) {
                FlagForFilter = 1;
            }
            else {
                FlagForFilter = 0;
            }
        },
        error: function () {
            console.log("Error in Filter Get");
        }
    });
