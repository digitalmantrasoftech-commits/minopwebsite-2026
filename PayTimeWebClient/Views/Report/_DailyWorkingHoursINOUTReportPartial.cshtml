@model IEnumerable<PayTimeWebClient.Models.DailyWorkingHoursINOUTReport>
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Daily Working Hours IN/OUT Report";
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
}
<style>
    .report_header_box {
        color: #2196f3;
        background-color: #fff;
        margin: 20px 0;
        padding: 10px;
        font-size: 16px;
        font-weight: 500;
        text-align: center;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {
        if ($('#tbldailyworkinghoursinoutDetails').length) {
            $('#tbldailyworkinghoursinoutDetails').DataTable({
                dom: 'lBfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        title: 'Daily Working Hours IN/OUT Report',
                        text: 'Excel'
                    }
                ]
            });
        }
     $(".previewclass").click(function () {

        var $row = $(this).closest("tr");

        var empId = $row.find("td:eq(0)").text().trim();
        var fromDate = $row.find("td:eq(5)").text().trim();
        var toDate = $row.find("td:eq(6)").text().trim();

        // Show the modal
        $("#working_hours_detail").modal("show");

        var reqobj = {
            Empid: empId,
            FromDate: fromDate,
            Todate: toDate
        };

        var _url = '@_webapiurl' + 'Report/GetDailyInOutReportDetails';

        $('#tbl_Working_hours_details').DataTable({
            destroy: true,
            processing: true, 
            serverSide: false, 
            ajax: {
                url: _url,
                type: "POST",
                headers: { 'Authorization': '@_tokan' }, 
                data: function () {
                    return reqobj; 
                },
                dataSrc: '' 
            },
            dom: 'lBfrtip',
            buttons: [
                {
                    extend: 'excelHtml5',
                    title: 'Daily Working Hours  IN OUT Report',
                    text: 'Excel'
                }
            ],
            columns: [
                { data: "Attn_Dt", title: "Attendance Date" },                
                { data: "INTime", title: "In Time" },
                { data: "OutTime", title: "Out Time" },
                { data: "Duration", title: "Duration" }
            ]
        });
    });
    });
</script>
<div class="report_header_box">
    <span id="customcaption">Daily Working Hours  IN/OUT Report</span>
</div>
<div class="portlet">
    <div class="portlet-body">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                @if (Model != null && Model.Any())
                {
                <table id="tbldailyworkinghoursinoutDetails" class="table table-striped table-bordered table-hover table-checkable order-column">
                    <thead>
                        <tr>
                            <th hidden>EmpID</th>
                            <th>Emp Code</th>
                            <th>Emp Name</th>
                            <th>Department Name</th>
                            <th>Branch Name</th>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th>Working Days</th>
                            <th>Allocated Hrs</th>
                            <th>Working Hrs</th>
                            <th>Difference</th>
                            <th>OD/Leave Days</th>
                            <th>OD hrs</th>
                            <th>View</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                            {
                        <tr>
                            <td hidden>@item.EmpID</td>
                            <td>@item.EmpCode</td>
                            <td>@item.EmpName</td>
                            <td>@item.DepartmentName</td>
                            <td>@item.BranchName</td>
                            <td>@item.FromDate</td>
                            <td>@item.ToDate</td>
                            <td>@item.WorkingDays</td>
                            <td>@item.AllocatedHrs</td>
                            <td>@item.WorkingHrs</td>
                            <td>@item.Difference</td>
                            <td>@item.ODleavedays</td>
                            <td>@item.ODHours</td>
                            <td><a class='previewclass btn btn-xs blue'><i class='fa-regular fa-eye'></i></a></td>
                        </tr>
                            }
                    </tbody>
                </table>
                }
                else
                {
                <div class="nodata_block no_recoed" style=" text-align: center;" id="no_data">
                    <img src="/assets/images/Data_not_found.jpg" height="200" width="200" alt="No Data Icon">
                </div>
                }
            </div>
            <!-- Working Hours Detail Modal Modal : Begin -->
            <div id="working_hours_detail" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                <div class="modal-dialog w-1080">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                            <h4 class="modal-title">Working Hours Details</h4>
                        </div>
                        <div class="modal-body">
                            <fieldset>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <table id="tbl_Working_hours_details" class="table table-striped table-bordered table-hover table-checkable order-column">
                                            <thead>
                                                <tr>
                                                    <th style="min-width: 100px;">Attn Date</th>                                                    
                                                    <th style="min-width: 60px;">In Time</th>
                                                    <th style="min-width: 100px;">Out Time</th>
                                                    <th style="min-width: 60px;">Duration</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        <div class="modal-footer" style="visibility: hidden;">
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                                    <button type="button" class="btn save_btn" id=""><i class="fa-light fa-floppy-disk"></i> Save</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Working Hours Detail Modal : End -->
        </div>
    </div>
</div>




