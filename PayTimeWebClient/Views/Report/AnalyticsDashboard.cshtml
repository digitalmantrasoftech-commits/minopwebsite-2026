                    success: function (json) {
                        $("#ajax_loader").hide();

                        if (!json.data || json.data.length === 0) {
                            $("#no_datas").attr("style", "display: flex !important;");
                            $("#accordion_container").hide();
                            toastr.success("No data available to show.");
                            hasMoreData = false;
                            return;
                        }
                        else {
                            $("#no_datas").attr("style", "display: none !important;");
                            $("#accordion_container").show();
                           $(".reportblock_table").css("display", "block");

                            // Process and group data for Report ID 20 (7 rows per employee)
                            const groupedData = groupDataByEmployeeForReport20(json.data);
                            renderAccordionViewForReport20(groupedData);

                            // Update pagination info
                            totalRecords = json.recordsTotal;
                            currentPage = 2; // Next page to fetch
                            hasMoreData = json.data.length >= 10; // Check if more data available
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        $("#ajax_loader").hide();
                        console.error('Error fetching data:', textStatus, errorThrown);
                        toastr.error("Error loading data. Please try again.");
                    }
                });
            }

            function groupDataByEmployeeForReport20(data) {
                const grouped = {};

                data.forEach(item => {
                    const key = `${item.EmpId}_${item.EmpCode}`;

                    if (!grouped[key]) {
                        grouped[key] = {
                            employee: {
                                EmpId: item.EmpId,
                                EmpCode: item.EmpCode,
                                EmployeeName: item.EmployeeName || item.EmpName,
                                Designation: item.Designation || item.DesignationName,
                                CompanyName: item.CompanyName,
                                BranchName: item.BranchName,
                                DepartmentName: item.DepartmentName,
                                // Report ID 20 summary with OT Hours and Total Hours
                                TotalRows: 0,
                                OTHours: '0:00:00',
                                TotalHours: '0:00:00'
                            },
                            details: []
                        };
                    }

                    // Add detail row and increment count
                    grouped[key].details.push(item);
                    grouped[key].employee.TotalRows += 1;
                });

                // After processing all rows for each employee, extract OT Hours and Total Hours from Status rows
                Object.keys(grouped).forEach(key => {
                    const employeeDetails = grouped[key].details;

                    // Find the row where Status column contains "OTHr" and extract its Total value
                    const otHourRow = employeeDetails.find(row => row.Status === 'OTHr');
                    if (otHourRow && otHourRow.Total) {
                        grouped[key].employee.OTHours = otHourRow.Total.toString();
                    }

                    // Find the row where Status column contains "Tot Hour" or "TotHour" and extract its Total value
                    const totalHourRow = employeeDetails.find(row => row.Status === 'Tot Hour' || row.Status === 'TotHour');
                    if (totalHourRow && totalHourRow.Total) {
                        grouped[key].employee.TotalHours = totalHourRow.Total.toString();
                    }
                });

                return grouped;
            }

            function renderAccordionViewForReport20(groupedData) {
                globalGroupedData = groupedData;
                accordionKeys = Object.keys(groupedData);
                currentIndex = 0;
                isLoadingAccordions = false;

                $("#accordion_container").html(""); // reset
                appendMoreAccordionsForReport20(); // load first batch

                // attach scroll event for SERVER-SIDE loading
                $("#accordion_container").off("scroll").on("scroll", function () {
                    const container = this;
                    const scrollTop = container.scrollTop;
                    const scrollHeight = container.scrollHeight;
                    const clientHeight = container.clientHeight;

                    // Trigger server request when user is close to bottom (within 100px)
                    if (scrollTop + clientHeight >= scrollHeight - 100 && hasMoreData && !isLoadingAccordions) {
                        fetchNextPageFromServerForReport20();
                    }
                });
            }

