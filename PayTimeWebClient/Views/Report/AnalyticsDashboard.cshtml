            function generateDetailTableHtml(logs) {
                if (!logs || logs.length === 0) {
                    return '<div class="alert alert-warning" style="margin:10px;">No attendance records found.</div>';
                }

                let html = `
                    <div class="table-responsive-rpt">
                        <table class="table table-bordered table-striped table-hover table-sm">
                            <thead class="thead-light">
                                <tr>
                                    <th class="text-center">Date</th>
                                    <th class="text-center">Shift</th>
                                    <th class="text-center">In Time</th>
                                    <th class="text-center">Out Time</th>
                                    <th class="text-center">Hours Worked</th>
                                    <th class="text-center">OT Duration</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>`;

                logs.forEach(row => {
                    let statusColor = "";
                    let status = (row.FinalStatus || "").trim();

                    if (status === 'A') statusColor = "color:red; font-weight:bold;";
                    else if (status === 'P') statusColor = "color:green; font-weight:bold;";
                    else if (status === 'WO') statusColor = "color:#007bff; font-weight:bold;";
                    else if (status === 'HLD' || status === 'H') statusColor = "color:#6f42c1; font-weight:bold;";

                    html += `
                    <tr>
                        <td class="text-center">${row.Attn_Dt}</td>
                        <td class="text-center">${row.ShiftName}</td>
                        <td class="text-center">${row.FirstIn}</td>
                        <td class="text-center">${row.LastOut}</td>
                        <td class="text-center">${row.TotHour}</td>
                        <td class="text-center">${row.OTHr}</td>
                        <td class="text-center" style="${statusColor}">${row.FinalStatus}</td>
                    </tr>`;
                });

                html += `</tbody></table></div>`;
                return html;
