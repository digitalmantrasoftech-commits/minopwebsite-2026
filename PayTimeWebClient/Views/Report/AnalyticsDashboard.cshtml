            function loadEmployeeDataTableForReport20(employeeKey, empId, empCode, dataKey) {
                try {
                    const tableId = "table_" + employeeKey;
                    const dtId = "dt_" + employeeKey;

                    const employeeData = globalGroupedData[dataKey];

                    if (!employeeData || !employeeData.details || employeeData.details.length === 0) {
                        $("#" + tableId).html('<div class="alert alert-info">No detailed data available for this employee.</div>');
                        return;
                    }

                    const detailsData = employeeData.details;

                    // Destroy existing DataTable if it exists
                    if ($.fn.DataTable.isDataTable("#" + dtId)) {
                        $("#" + dtId).DataTable().destroy();
                    }

                    // Create table for Report ID 20 with 7 rows structure
                    if (detailsData.length > 0) {
                        const firstRow = detailsData[0];
                        const excludeColumns = ['EmpName', 'EmpCode', 'EmployeeName'];
                        const columns = Object.keys(firstRow).filter(key => !excludeColumns.includes(key));


                        // Check if we're on mobile or desktop
                        const isMobile = window.innerWidth <= 768;
                        const isTablet = window.innerWidth > 768 && window.innerWidth <= 1024;

                        // Build single table with responsive columns for Report ID 20

                        let tableHtml = '<div class="table-responsive-rpt" id="table-wrapper-' + employeeKey + '" style="overflow-x: auto; position: relative;">';
                        tableHtml += '<table id="' + dtId + '" class="table-rpt table table-striped table-bordered table-hover report20-natural-width">';

                        // Create header row with conditional sticky positioning
                        tableHtml += '<thead><tr>';

                        // Adjust column widths based on screen size
                        let estimatedWidths = [120, 120, 120, 100, 80]; // Desktop widths
                        if (isTablet) {
                            estimatedWidths = [100, 100, 100, 85, 70]; // Tablet widths
                        }

                        let cumulativeLeft = 0;

                        columns.forEach(function (column, index) {
                            const headerText = column.replace(/([a-z])([A-Z])/g, '$1 $2').trim();

                            // Apply sticky positioning only on desktop/tablet, not on mobile
                            if (index < 5 && !isMobile) {  // First 5 columns are fixed on desktop/tablet
                                tableHtml += '<th class="text-center sticky-col" style="position: sticky; left: ' + cumulativeLeft + 'px; z-index: 10; background-color: #f8f9fa; min-width: ' + estimatedWidths[index] + 'px;">' + headerText + '</th>';
                                cumulativeLeft += estimatedWidths[index];
                            } else {  // Rest are scrollable or all columns on mobile
                                tableHtml += '<th class="text-center">' + headerText + '</th>';
                            }
                        });
                        tableHtml += '</tr></thead>';

                        // Create body rows with conditional sticky positioning
                        tableHtml += '<tbody>';
                        detailsData.forEach(function (row) {
                            tableHtml += '<tr>';
                            let bodyCumulativeLeft = 0;

                            columns.forEach(function (column, index) {
                                const cellValue = row[column] || '--';

                                // Apply sticky positioning only on desktop/tablet, not on mobile
                                if (index < 5 && !isMobile) {  // First 5 columns are fixed on desktop/tablet
                                    tableHtml += '<td class="text-center sticky-col" style="position: sticky; left: ' + bodyCumulativeLeft + 'px; z-index: 9; background-color: white; min-width: ' + estimatedWidths[index] + 'px;">' + cellValue + '</td>';
                                    bodyCumulativeLeft += estimatedWidths[index];
                                } else {  // Rest are scrollable or all columns on mobile
                                    tableHtml += '<td class="text-center">' + cellValue + '</td>';
                                }
                            });
                            tableHtml += '</tr>';
                        });
                        tableHtml += '</tbody></table></div>';


                        $("#" + tableId).html(tableHtml);

                        // Add scroll indicator class if table is wider than container
                        setTimeout(function() {
                            const wrapper = document.getElementById('table-wrapper-' + employeeKey);
                            if (wrapper && wrapper.scrollWidth > wrapper.clientWidth) {
                                wrapper.classList.add('has-scroll');
                            }

                            // Add scroll event listener to show/hide scroll indicators
                            if (wrapper && isMobile) {
                                wrapper.addEventListener('scroll', function() {
                                    if (this.scrollLeft > 0) {
                                        this.classList.add('scrolled-left');
                                    } else {
                                        this.classList.remove('scrolled-left');
                                    }

                                    if (this.scrollLeft + this.clientWidth >= this.scrollWidth - 1) {
                                        this.classList.add('scrolled-right');
                                    } else {
                                        this.classList.remove('scrolled-right');
                                    }
                                });
                            }
                        }, 100);
                    }

                } catch (error) {
                    console.error("Error in loadEmployeeDataTableForReport20:", error);
                    const tableId = "table_" + employeeKey;
                    $("#" + tableId).html('<div class="alert alert-danger">Error loading data.</div>');
                }
            }

