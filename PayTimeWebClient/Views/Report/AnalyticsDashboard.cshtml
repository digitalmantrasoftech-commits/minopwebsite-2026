    function AllCheckedEmp(checkbox) {

        var table = $('#tblemp').DataTable();
        var searchtext = $("#tblemp_filter input").val();
        if (searchtext != "") {
            table.rows({ search: 'applied' }).nodes().to$().find('.ClsChkEmp').each(function () {
                this.checked = true;
                selectedEmpIds.add(this.id);
            });
            isSelectAllChecked = false;
            return;
        }
        if (checkbox.checked) {
            selectedEmpIds.clear();
            table.$('.ClsChkEmp').each(function () {
                this.checked = true;
                selectedEmpIds.add(this.id);
            });
            isSelectAllChecked = true;
        } else {
            table.$('.ClsChkEmp').each(function () {
                this.checked = false;
                selectedEmpIds.delete(this.id);
            });
            selectedEmpIds.delete("0");
            isSelectAllChecked = false;
        }

        $("#EmpID").val(Array.from(selectedEmpIds));
    }
    function SelectedEmp() {


