        function normalizeDate(input) {

            if (!input) return "";
            var parsed = new Date(input);
            if (isNaN(parsed)) {

                return moment(input, [
                    "DD-MMM-YYYY",
                    "DD-MM-YYYY",
                    "MMM-DD-YYYY",
                    "MM-DD-YYYY",
                    "YYYY-MMM-DD",
                    "YYYY-MM-DD"
                ], true).format("YYYY-MM-DD");
            }

            return parsed.getFullYear() + "-" +
                String(parsed.getMonth() + 1).padStart(2, "0") + "-" +
                String(parsed.getDate()).padStart(2, "0");
        }

