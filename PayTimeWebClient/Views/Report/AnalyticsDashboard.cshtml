            window.toggleAccordionForReport20 = function (employeeKey, empId, empCode, dataKey) {
                try {
                    const content = $("#content_" + employeeKey);
                    const toggle = $('[data-employee="' + employeeKey + '"] .accordion-toggle i');

                    if (content.length === 0) {
                        console.error("Accordion content not found for key:", employeeKey);
                        return;
                    }

                    if (content.is(':visible')) {
                        content.slideUp();
                        toggle.removeClass('fa-chevron-up').addClass('fa-chevron-down');
                    } else {
                        // Close other accordions
                        $('.accordion-content').slideUp();
                        $('.accordion-toggle i').removeClass('fa-chevron-up').addClass('fa-chevron-down');

                        // Open this accordion and load DataTable
                        content.slideDown();
                        toggle.removeClass('fa-chevron-down').addClass('fa-chevron-up');
                        loadEmployeeDataTableForReport20(employeeKey, empId, empCode, dataKey);

                        // Store current accordion data for resize event
                        window.currentReport20Accordion = {
                            employeeKey: employeeKey,
                            empId: empId,
                            empCode: empCode,
                            dataKey: dataKey
                        };
                    }
                } catch (error) {
                    console.error("Error in toggleAccordionForReport20:", error);
                    toastr.error("Error opening accordion");
                }
            }

