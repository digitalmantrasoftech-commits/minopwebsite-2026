        function checkEmpCheckboxesByIds(empIdArray, isSelectAllChecked) {

            if (!Array.isArray(empIdArray) || empIdArray.length === 0) {
                console.warn('Invalid or empty EmpId array provided.');
                return;
            }
            if (isSelectAllChecked) {
                // Iterate through each EmpId in the array
                empIdArray.forEach(empId => {
                    const checkbox = $(`#tblEmp .ClsChkEmp[id="${empId}"]`);
                    if (checkbox.length > 0) {
                        selectedEmpIds.add(empId);
                        checkbox.prop('checked', true);
                        checkedDept(checkbox[0]); // Trigger associated logic
                    }
                });
            }
            else {
                if (selectedEmpIds.size > 0) {
                    for (let empId of selectedEmpIds) {
                        const checkbox = $(`#tblEmp .ClsChkEmp[id="${empId}"]`);
                        if (checkbox.length > 0) {
                            checkbox.prop('checked', true);
                            checkedDept(checkbox[0]); // Trigger associated logic
                        }
                    }
                }
            }
        }
        $(document).on('input', '#tblemp_filter input', function () {

            let searchText = $(this).val();
            if (_isServerSide) {
                if (searchText.length >= 3) {

                    totalLoadedRecords = 0;
                    startIndex = 0;
                    fetchedEmpIds.clear();
                    fetchNextRecords(0, 1, function (records, requestId) {
                        tableInstance.clear().rows.add(records).draw();
                        totalLoadedRecords = records.length;
                        startIndex = records.length;
                        records.forEach(row => fetchedEmpIds.add(row.EmpId));
                    }, searchText);

                    $('.ClsChkEmp').each(function () {
                        if (selectedEmpIds.has(this.id)) {
                            this.checked = true;
                        }
                    });
                    $('.ClsChkAllDept').prop('checked', false);
                    if (isSelectAllChecked) {
                       selectedEmpIds.clear();
                        isSelectAllChecked = false;
                    }

                }
                else {
                    if (searchText.length == "") {

                        totalLoadedRecords = 0;
                        startIndex = 0;
                        fetchedEmpIds.clear();
                        fetchNextRecords(0, 1, function (records, requestId) {
                            tableInstance.clear().rows.add(records).draw();
                            totalLoadedRecords = records.length;
                            startIndex = records.length;
                            records.forEach(row => fetchedEmpIds.add(row.EmpId));
                        }, ""); // Send empty search param
                        $('.ClsChkEmp').each(function () {
                            if (selectedEmpIds.has(this.id)) {
                                this.checked = true;
                            }
                        });
                        $('.ClsChkAllDept').prop('checked', false);
                        if (isSelectAllChecked) {
                            selectedEmpIds.clear();
                            isSelectAllChecked = false;
                        }
                    }
                }
            }
            else {
                tableInstance.search(searchText).draw();
            }
        });
        var bid;
        function validation(e) {

            // first check all validations
            var department = $("#DepartmentID").val();
            bid = $("#BranchID").val();
            if ($("#CompanyID").val() == null || $("#CompanyID").val() == "") {
                toastr.error("Please select Company!");
                e.preventDefault();
                return false;
            }
            if ((bid == "") || (bid == null)) {
                $("#DepartmentID").prop("disabled", true);
            }
            else {
                $("#DepartmentID").prop("disabled", false);
            }
            if ((bid == "") || (bid == null)) {
                toastr.error("Please select Branch!");
                e.preventDefault();
                return false;
            }
            if (department == null || department == "") {
                toastr.error("Please select Department!");
                e.preventDefault();
                return false;
            }
            if (selectedEmpIds.size == 0) {
                toastr.error("Please select Employee!");
                e.preventDefault();
                return false;
            }

            // select all logic for the department

            var allOptions = $("#DepartmentID option").map(function () {
                return $(this).val();
            }).get(); // array of all option values


            if (department && department.length === allOptions.length) {
                departmentGlobal = 0;
            } else {
                departmentGlobal = department ? department.join(',') : '';
            }

            //select all logic for the branch

            var allOptionsbid = $("#BranchID option").map(function () {
                return $(this).val();
            }).get(); // array of all option values


            if (bid && bid.length === allOptionsbid.length) {
                bid = 0;
            } else {
                bid = bid ? bid.join(',') : '';
            }
            if (isSelectAllChecked == true) {
                selectedEmpIds.clear();
                selectedEmpIds.add("0");
            }
            return true;

        }
