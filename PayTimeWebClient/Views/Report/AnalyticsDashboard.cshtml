            }

            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '/DataGridOptimize/GetLazyLoadingGetEmployeeLeaveSanction',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify({
                    start: startIndex,
                    length: 50,
                    RoleId: "@_RoleId",
                    CompanyIds: $("#CompanyID").val(),
                    BranchId: BranchIdlst,
                    DepartmentId: DeptIdlst,
                    DatagridThresold:"@_DatagridEmpListThsold",
