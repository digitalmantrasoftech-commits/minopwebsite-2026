            function fetchNextPageFromServerForReport20() {
                if (isLoadingAccordions || !hasMoreData) return;
                isLoadingAccordions = true;

                $.ajax({
                    url: '/DataGridOptimize/tmptableforReports',
                    type: "POST",
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({
                        draw: currentPage,
                        page: currentPage,
                        pageSize: 10,
                        searchTerm: "",
                        sortColumn: "",
                        sortOrder: "asc",
                        ...serverFilters
                    }),
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("Authorization", '@_tokan');
                        $("#accordion_container").append(`
                            <div id="loading-more-accordions" class="accordion-loading">
                                <i class="fa fa-spinner fa-spin"></i>Loading more employees from server...
                            </div>
                        `);
                    },
                    success: function (json) {
                        $("#loading-more-accordions").remove();

                        if (!json.data || json.data.length === 0) {
                            hasMoreData = false;
                            $("#accordion_container").append(`
                                <div class="accordion-loading" style="color: #888;">
                                    <i class="fa fa-check-circle"></i>All employees loaded
                                </div>
                            `);
                            isLoadingAccordions = false;
                            return;
                        }

                        // Group new data
                        const newGroupedData = groupDataByEmployeeForReport20(json.data);

                        // Merge with existing data
                        Object.keys(newGroupedData).forEach(key => {
                            if (globalGroupedData[key]) {
                                globalGroupedData[key].details = globalGroupedData[key].details.concat(newGroupedData[key].details);
                                // Update summary stats - total rows for Report ID 20
                                globalGroupedData[key].employee.TotalRows += newGroupedData[key].employee.TotalRows;

                                // Re-extract OT Hours and Total Hours from the merged details (Status column method)
                                const mergedDetails = globalGroupedData[key].details;

                                // Find OTHr row and extract Total value
                                const otHourRow = mergedDetails.find(row => row.Status === 'OTHr');
                                if (otHourRow && otHourRow.Total) {
                                    globalGroupedData[key].employee.OTHours = otHourRow.Total.toString();
                                }

                                // Find Tot Hour row and extract Total value
                                const totalHourRow = mergedDetails.find(row => row.Status === 'Tot Hour' || row.Status === 'TotHour');
                                if (totalHourRow && totalHourRow.Total) {
                                    globalGroupedData[key].employee.TotalHours = totalHourRow.Total.toString();
                                }
                            } else {
                                globalGroupedData[key] = newGroupedData[key];
                            }
                        });

                        // Append new accordion items
                        appendNewAccordionItemsForReport20(newGroupedData);

                        currentPage++;
                        hasMoreData = json.data.length >= 10;
                        isLoadingAccordions = false;
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.error('Error fetching next page:', textStatus, errorThrown);
                        $("#loading-more-accordions").remove();
                        $("#accordion_container").append(`
                            <div class="alert alert-danger" style="margin: 10px;">
                                Error loading more employees. Please try scrolling again.
                            </div>
                        `);
                        isLoadingAccordions = false;
                    }
                });
            }

