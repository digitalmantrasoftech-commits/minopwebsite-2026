        // Function to update column visibility based on checkboxes
        function updateColumnFilters(table) {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: '@_webapiurl' + "Report/HasColumnSaved",
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ ReportId: reportid }),
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("Authorization", '@_tokan');
                    },
                    success: function (response) {

                        let selectedColumnsStr = response[0]?.SelectedReports || "";
                        let selectedColumns = selectedColumnsStr ? selectedColumnsStr.split(',').map(Number) : [];

                        if (selectedColumns.length === 0) {
                            table.columns().every(function (index) {
                                if (this.visible()) {
                                    selectedColumns.push(index);
                                }
                            });
                        }

                        $("#column-filter-container input[type='checkbox']").each(function () {
                            let columnName = $(this).attr("name");
                            let dataKey = columnMapping[columnName];
                            if (dataKey) {
                                let columnIndex = table.columns().dataSrc().indexOf(dataKey);
                                if (columnIndex !== -1) {
                                    let column = table.column(columnIndex);
                                    let isSelected = selectedColumns.includes(columnIndex);
                                    $(this).prop("checked", isSelected);
                                    column.visible(isSelected); // <-- this needs table fully initialized
                                }
                            }
                        });

                        resolve();
                    },
                    error: function (err) {
                        console.error('Error fetching column settings:', err);
                        reject(err);
                    }
                });
            });
}
