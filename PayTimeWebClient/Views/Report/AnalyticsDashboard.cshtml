@using PayTimeWebClient.Helper;
@{
    ViewBag.Title = "AnalyticsDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string IsSchool = HttpContext.Current.Session["IsSchool"].ToString();
    string IsOffice = HttpContext.Current.Session["IsOffice"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _ChunkSize = Convert.ToInt32(HttpContext.Current.Session["DataDropDownThreShold"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _companyid = string.Empty;
    string _branchid = string.Empty;
    int _departmentid = 0;
    int _empid = 0;
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    //RoleRightsMapping obj = new RoleRightsMapping();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    if (_RoleId == 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        if (!string.IsNullOrEmpty(HttpContext.Current.Session["EmpId"].ToString()))
        {
            _empid = Convert.ToInt32(HttpContext.Current.Session["EmpId"].ToString());
        }
    }
    if (_RoleId > 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
        _departmentid = Convert.ToInt32(HttpContext.Current.Session["DepartmentId"].ToString());
        _empid = Convert.ToInt32(HttpContext.Current.Session["EmpId"].ToString());
    }
    string _accountcd = HttpContext.Current.Session["cmpcode"].ToString();
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    var canViewDailyInOut = selectedUserMenu.Any(r => r.OperationId == 500 && r.CanView);
    bool hasLeaveReportAccess = selectedUserMenu.Any(r => (r.OperationId == 208 || r.OperationId == 209 || r.OperationId == 210 || r.OperationId == 223) && r.CanView);
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false";
    string _dbName = HttpContext.Current.Session["DbName"].ToString();

    var reportOperationIds = new List<int> { 211, 212, 213, 214, 215, 216, 217, 218, 220, 221, 222 };
    bool showCustomizedReports = selectedUserMenu.Any(r => reportOperationIds.Contains(r.OperationId) && r.CanView);

    if (_RoleId == 6810)
    {
        _RoleId = 1;
    }
    Int64 _DatagridEmpListThsold = 0;
    _DatagridEmpListThsold = Convert.ToInt64(HttpContext.Current.Session["DataEmpListThreShold"]);
}
