        function formatDropdown(option) {
            if (!option.id) return option.text;

            let selectedValue = $('#workflowDropdown').val();
            let checkmark = (option.id === selectedValue)
                ? `<i class="fa-solid fa-check" style="color: #1383dd;"></i>`
                : "";

            // Create DOM element and strip all title attributes inside it
                    const $container = $(`
                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                            <span>${option.text}</span>
                            <span>${checkmark}</span>
                        </div>
                    `);

            $container.find('[title]').removeAttr('title');
            $container.removeAttr('title');

            return $container;
        }


