        function fillDeptTable(BranchId, selectedDept) {

            $("#DepartmentID").empty();
            let branchStr = "";
            let SelectAll = 0;
            let selectAllSearchTerm = "";


            const selectedBranches = $("#BranchID").val();
            const totalBranchOptions = $("#BranchID option").length;

            //if (selectedBranches && selectedBranches.length > 0 && selectedBranches.includes("0")) {
            //    SelectAll = 1;
            //    selectAllSearchTerm = $("#BranchIdsContainer li .multiselect-search").val()?.trim().toLowerCase() || "";
            //    BranchId = null;
            if (selectedBranches && selectedBranches.length === totalBranchOptions) {
                SelectAll = 1;
                selectAllSearchTerm = $("#BranchIdsContainer li .multiselect-search").val()?.trim().toLowerCase() || "";
                branchStr = null;
            }
            else {
                SelectAll = 0;
                BranchId = selectedBranches;
            }

            if (Array.isArray(BranchId) && selectedDept === "") {
                branchStr = BranchId.join(",");
            } else if (typeof BranchId === "string") {
                branchStr = BranchId;
            }

            if (BranchId != null || SelectAll === 1) {
                $select.data = {
                    CompanyID: $("#CompanyID").val(),
                    BranchID: branchStr,
                    SelectAll: SelectAll,
                    SelectAllSearchTerm: selectAllSearchTerm
                };
                $select.loadInitialData();
            } else {
                $("#DepartmentID").multiselect("rebuild");
            }
        }

