            function fetchOverviewData() {
                if (isLoadingAccordions) return;

                isLoadingAccordions = true;
                $("#ajax_loader").show();

                $.ajax({
                    url: '/DataGridOptimize/tmptableforReportstable',
                    type: 'POST',
                    dataType: 'json',
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({
                        draw: 1,
                        page: 1,
                        pageSize: 0, // Gets all records (or up to limit set in SP)
                        ...serverFilters
                    }),
                    beforeSend: function (xhr) {
                         xhr.setRequestHeader("Authorization", '@_tokan');
                    },
                    success: function (json) {
                        $("#ajax_loader").hide();
                        isLoadingAccordions = false;
                        $(".reportblock_table").attr("style", "display: block !important;");
