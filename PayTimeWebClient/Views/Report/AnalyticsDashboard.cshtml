        var departmentGlobal;
        var table;

        // Custom Date Range code ===========================================
        var predefinedRanges = {
            'Today': [moment(), moment()],
            'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
            'Last 7 Days': [moment().subtract(6, 'days'), moment()],
            'Last 15 Days': [moment().subtract(14, 'days'), moment()],
            'Last 30 Days': [moment().subtract(29, 'days'), moment()],
            'Current Month': [moment().startOf('month'), moment().endOf('month')],
            'Previous Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
        };

        // Set default value to 'Current Month'
        $('#daterange').val('Current Month');

        $('#daterange').daterangepicker({
            locale: { format: 'DD/MM/YYYY' },
            opens: 'right',
            drops: 'down',
            ranges: predefinedRanges,
            autoUpdateInput: false,
            startDate: moment(),
            endDate: moment(),
            alwaysShowCalendars: false,


        });
        const picker = $('#daterange').data('daterangepicker');
        picker.leftCalendar.month = moment().subtract(1, 'month');
        picker.rightCalendar.month = moment();
        picker.updateCalendars();
        $('#daterange').on('apply.daterangepicker', function (ev, picker) {
            var selectedRange = Object.keys(predefinedRanges).find(key =>
                picker.startDate.isSame(predefinedRanges[key][0], 'day') &&
                picker.endDate.isSame(predefinedRanges[key][1], 'day')
            );
            if (selectedRange) {
                // If predefined range is selected
                $(this).val(selectedRange);
                $('#custom_date_input').hide();
            } else {
                // If a custom range is selected
                var formattedStart = picker.startDate.format('DD/MM/YYYY');
                var formattedEnd = picker.endDate.format('DD/MM/YYYY');
                var customRangeText = formattedStart + ' - ' + formattedEnd;

                $('#daterange').val("Custom Range"); // Show "Custom Range" in the first input
                $('#custom_daterange').val(customRangeText);
                $('#custom_date_input').show(); // Show the custom input
            }
        });

