                                            <span class="stat-item">A: <strong class="red_font">${empData.A}</strong></span>
                                            <span class="stat-item">WO: <strong style="color:#007bff;">${empData.WeekOffs}</strong></span>
                                            <span class="stat-item">H: <strong style="color:#6f42c1">${empData.H}</strong></span>
                                            <span class="stat-item">E: <strong style="color:#343a40">${empData.Error_Case}</strong></span>
                                            <span class="stat-item">HD: <strong style="color:#ffc107">${empData.Half_Day}</strong></span>
                                            <span class="stat-item">LH: <strong style="color:#fd7e14">${empData.Less_Hrs}</strong></span>
                                            <span class="stat-item">PL: <strong class="red_font"">${empData.Paid_Leaves}</strong></span>
                                            <span class="stat-item">Total Hrs: <strong style="color:#333">${empData.TotalHrs}</strong></span>
                                        </div>
                                    </div>
                                    <div class="accordion-toggle">
                                        <i class="fa fa-chevron-down"></i>
                                    </div>
                                </div>
                                <div class="accordion-content" id="content_${safeKey}" style="display:none;">
                                    <div id="table_${safeKey}"></div>
                                </div>
                            </div>`;
                });

                // Append initial accordion items
                container.append(html);
                currentIndex = accordionKeys.length; // Set current index to loaded count


            }

            window.toggleAccordion = function (employeeKey, empId, empCode, dataKey) {
                try {
                    const content = $("#content_" + employeeKey);
                    const toggle = $('[data-employee="' + employeeKey + '"] .accordion-toggle i');

                    if (content.length === 0) {
                        console.error("Accordion content not found for key:", employeeKey);
                        return;
                    }

                    if (content.is(':visible')) {
                        content.slideUp();
                        toggle.removeClass('fa-chevron-up').addClass('fa-chevron-down');
                    } else {
                        // Close other accordions
                        $('.accordion-content').slideUp();
                        $('.accordion-toggle i').removeClass('fa-chevron-up').addClass('fa-chevron-down');

                        // Open this accordion and load DataTable
                        content.slideDown();
                        toggle.removeClass('fa-chevron-down').addClass('fa-chevron-up');
                        loadEmployeeDataTable(employeeKey, empId, empCode, dataKey);
                    }
                } catch (error) {
                    console.error("Error in toggleAccordion:", error);
                    toastr.error("Error opening accordion");
                }
            }

            function loadEmployeeDataTable(employeeKey, empId, empCode, dataKey) {

                try {
                    const tableId = "table_" + employeeKey;
                    const dtId = "dt_" + employeeKey;

                    const employeeData = globalGroupedData[dataKey];

                    if (!employeeData || !employeeData.details || employeeData.details.length === 0) {

                        $("#" + tableId).html('<div class="alert alert-info">No detailed data available for this employee.</div>');
                        return;
                    }

                    const detailsData = employeeData.details;


                    // Destroy existing DataTable if it exists
                    if ($.fn.DataTable.isDataTable("#" + dtId)) {
                        $("#" + dtId).DataTable().destroy();
                    }

                    // Create simple HTML table like in your screenshot
                    if (detailsData.length > 0) {
                        const firstRow = detailsData[0];

                        // Define columns to exclude from the DataTable
                        const excludeColumns = [
                            'P', 'A', 'EmployeeName', 'EmpCode', 'Total_Hrs',
                            'TotalHours', 'Paid_Leave',
                            'TotalHrs','H','Error_Case','Less_Hrs','Half_Day',
                            'Week Off',

                        ];

                        // Get all columns and filter out the excluded ones
                        const allColumns = Object.keys(firstRow);
                        const columns = allColumns.filter(column => {
                            // Case-insensitive matching for column exclusion
                            const columnLower = column.toLowerCase().replace(/[_\s]/g, '');
                            return !excludeColumns.some(excludeCol =>
                                excludeCol.toLowerCase().replace(/[_\s]/g, '') === columnLower
                            );
                        });



                        // Build HTML table
                        let tableHtml = '<div class="table-responsive-rpt"><table id="' + dtId + '" class="table-rpt table new_datatbl table-striped table-bordered table-hover table-checkable order-column dataTable">';

                        // Create header row
                        tableHtml += '<thead><tr>';
                        columns.forEach(function (column,index) {
                            const headerText = column.replace(/([a-z])([A-Z])/g, '$1 $2').trim(); // Add spaces between camelCase words only
                            if (index === 0) {
                                tableHtml += '<th style="min-width: 150px; max-width: 200px; white-space: nowrap;">' + headerText + '</th>'; // CompanyName column with width constraints
                            } else {
                                tableHtml += '<th class="text-center">' + headerText + '</th>';
                            }
                        });
                        tableHtml += '</tr></thead>';

                        // Create data rows
                        tableHtml += '<tbody>';
                        detailsData.forEach(function (row) {
                            tableHtml += '<tr>';
                            columns.forEach(function (column,index) {
                                const cellValue = row[column] || '--';
                                if (index === 0) {
                                    tableHtml += '<td style="min-width: 150px; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="' + cellValue + '">' + cellValue + '</td>'; // CompanyName column with width constraints and tooltip
                                } else {
                                    tableHtml += '<td class="text-center">' + cellValue + '</td>';
                                }
                            });
                            tableHtml += '</tr>';
                        });
                        tableHtml += '</tbody></table></div>';

                        $("#" + tableId).html(tableHtml);
                    } else {
                        $("#" + tableId).html('<div class="alert alert-info">No detailed data available for this employee.</div>');
                    }

                } catch (error) {
                    console.error("Error in loadEmployeeDataTable:", error);
                    const tableId = "table_" + employeeKey;
                    $("#" + tableId).html('<div class="alert alert-danger">Error loading data.</div>');
                }
            }

