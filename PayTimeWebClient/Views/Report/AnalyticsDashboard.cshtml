                            return;
                        }
                        $("#no_datas").hide();
                        $("#accordion_container").show();
                        $("#no_datas").attr("style", "display: none !important;");
                        window.employeeLogsMap = {};
                        if (json.details && Array.isArray(json.details)) {
                            json.details.forEach(log => {
                                if (!window.employeeLogsMap[log.EmpId]) {
                                    window.employeeLogsMap[log.EmpId] = [];
