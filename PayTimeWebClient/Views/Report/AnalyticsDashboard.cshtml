    /* Report 20 Table Styles - Fix column gaps and improve mobile responsiveness */
    .report20-natural-width {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        table-layout: auto;
    }

        .report20-natural-width th,
        .report20-natural-width td {
            border-right: 1px solid #dee2e6;
            border-bottom: 1px solid #dee2e6;
        }

            .report20-natural-width th:first-child,
            .report20-natural-width td:first-child {
                border-left: 1px solid #dee2e6;
            }

        .report20-natural-width thead tr th {
            border-top: 1px solid #dee2e6;
        }

        /* Remove gaps between sticky columns */
        .report20-natural-width th[style*="position: sticky"],
        .report20-natural-width td[style*="position: sticky"] {
            border-right: none;
        }

            .report20-natural-width th[style*="position: sticky"] + th:not([style*="position: sticky"]),
            .report20-natural-width td[style*="position: sticky"] + td:not([style*="position: sticky"]) {
