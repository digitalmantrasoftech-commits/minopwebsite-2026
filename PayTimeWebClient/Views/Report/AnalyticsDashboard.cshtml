            function toggleAccordion(uniqueKey) {
                const contentDiv = $("#content_" + uniqueKey);
                const tableContainer = $("#table_container_" + uniqueKey);
                const toggleIcon = $("#item_" + uniqueKey + " .accordion-toggle i");

                if (!contentDiv.is(':visible')) {

                    if (tableContainer.is(':empty')) {
                        let empId = uniqueKey.replace("emp_", "");
                        let logs = window.employeeLogsMap[empId] || [];
                        let tableHtml = generateDetailTableHtml(logs);
                        tableContainer.html(tableHtml);
                    }
                    $(".accordion-content").not(contentDiv).slideUp();

                    $(".accordion-toggle i").not(toggleIcon).removeClass('fa-chevron-up').addClass('fa-chevron-down');

                    contentDiv.slideDown();
                    toggleIcon.removeClass('fa-chevron-down').addClass('fa-chevron-up');
                }
                else {
                    contentDiv.slideUp();
                    toggleIcon.removeClass('fa-chevron-up').addClass('fa-chevron-down');
                }
            }
            function bindAccordionEvents() {
                $("#accordion_container").off("click", ".accordion-header");

                $("#accordion_container").on("click", ".accordion-header", function () {
                    let uniqueKey = $(this).data("key");
