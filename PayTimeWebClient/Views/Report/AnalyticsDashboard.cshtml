                                            <span class="stat-item">H: <strong style="color:#6f42c1">${empData.H}</strong></span>
                                            <span class="stat-item">E: <strong style="color:#343a40">${empData.Error_Case}</strong></span>
                                            <span class="stat-item">HD: <strong style="color:#ffc107">${empData.Half_Day}</strong></span>
                                            <span class="stat-item">LH: <strong style="color:#fd7e14">${empData.Less_Hrs}</strong></span>
                                            <span class="stat-item">PL: <strong class="red_font">${empData.Paid_Leaves}</strong></span>
                                            <span class="stat-item">Total Hrs: <strong style="color:#333">${empData.TotalHrs}</strong></span>
                                        </div>
                                    </div>
                                    <div class="accordion-toggle">
                                        <i class="fa fa-chevron-down"></i>
                                    </div>
                                </div>
                                <div class="accordion-content" id="content_${safeKey}" style="display:none;">
                                    <div id="table_${safeKey}"></div>
                                </div>
                            </div>`;

                    currentIndex++;
                });

                // Append new items to container
                container.append(html);

                // Update accordionKeys with new keys
                accordionKeys = accordionKeys.concat(newKeys);
            }

            function renderAccordionView(groupedData) {

                globalGroupedData = groupedData;
                accordionKeys = Object.keys(groupedData);
                currentIndex = 0;
                isLoadingAccordions = false; // Reset loading flag

                $("#accordion_container").html(""); // reset

                appendMoreAccordions(); // load first 10

                // attach scroll event once with debouncing for SERVER-SIDE loading
                $("#accordion_container").off("scroll").on("scroll", function () {
                    const container = this;
                    const scrollTop = container.scrollTop;
                    const scrollHeight = container.scrollHeight;
                    const clientHeight = container.clientHeight;

                    // Trigger server request when user is close to bottom (within 100px)
                    if (scrollTop + clientHeight >= scrollHeight - 100 && hasMoreData && !isLoadingAccordions) {
                        fetchNextPageFromServer();
                    }
                });
            }

            function appendMoreAccordions() {

                // This function now only handles the INITIAL load from first server response
                // Subsequent loads are handled by fetchNextPageFromServer()

                let container = $("#accordion_container");
                let html = "";

                accordionKeys.forEach((key, index) => {
                    const empData = globalGroupedData[key].employee;
                    const safeKey = "emp_" + index;

