                    search:
                    {
                        value: searchValue || ''
                    }
                }),
                beforeSend: function () {
                    $("#loader_tblEmployee").show();
                },
                success: function (response) {

                    if (response && response.data && response.data.length > 0) {
                        callback(response.data, requestId);

                        setTimeout(() => {
                            response.data.forEach(emp => {

                                const checkbox = $(`#chk_${emp.EmpId}`);
                                const row = $(`#row_${emp.EmpId}`);

                                if (isSelectAllChecked) {
                                    checkbox.prop("checked", true);
                                    row.addClass("selected-row");
                                    selectedEmpIds.add(`${emp.EmpId}`);
                                } else {
                                    if (selectedEmpIds.has(`${emp.EmpId}`)) {
                                        checkbox.prop("checked", true);
                                        row.addClass("selected-row");
                                    } else {
                                        checkbox.prop("checked", false);
                                        row.removeClass("selected-row");
                                    }
                                }
                            });

                            $("#EmpID").val(Array.from(selectedEmpIds));
                        }, 100);


                    } else {
                        callback([], requestId);
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.error('Error fetching records for request ID:', requestId, textStatus, errorThrown);
                    callback([], requestId);
                },
                complete: function () {
                    $("#loader_tblEmployee").hide();
                }
            });
    }
