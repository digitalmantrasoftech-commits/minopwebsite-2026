        function generateMonthlyFlexiColumns() {
            let Dates = FetchDates();
            let fromDate = new Date(Dates.fromDate);
            let month = fromDate.getMonth() + 1;
            let year = fromDate.getFullYear();

            const columns = [
                { data: "EmpCode", title: "EmpCode" },
                { data: "EmployeeName", title: "EmployeeName" },
                { data: "CompanyName", title: "CompanyName", orderable: false },
                { data: "BranchName", title: "BranchName" },
                { data: "DepartmentName", title: "DepartmentName" },
                { data: "Month-Year", title: "Month-Year",orderable:false },
                { data: "Status", title: "Status", orderable:false }
            ];


            const totalDays = new Date(year, month, 0).getDate();

            for (let i = 1; i <= totalDays; i++) {
                columns.push({
                    data: `D${i}`,
                    title: `D${i}`,
                    orderable:false
                });
            }

            columns.push(
                { data: "Total", title: "Total",orderable:false }
            );

            return columns;
        }
            // Accordion Functions for Report ID 19
            function initializeAccordion() {
                // Reset pagination variables for new request
                currentPage = 1;
                totalRecords = 0;
                hasMoreData = true;
                globalGroupedData = {};
                accordionKeys = [];
                currentIndex = 0;
                isLoadingAccordions = false;

                $("#ajax_loader").show();
               // $("#initial-accordion-loading").show(); // Show initial loading indicator
                let Dates = FetchDates();
                var storedCompanyID = sessionStorage.getItem("selectedCompany_${'@_UserId'}`");
                var storedEmpid1 = sessionStorage.getItem("selectEmployee");
                var storedFilo = parseInt(sessionStorage.getItem("isFiloChecked"), 10);
                var storedBranchid = sessionStorage.getItem("selectedBranch");
                var storedDepartmentId = sessionStorage.getItem("selectedDepartment");
                var storedisActive = sessionStorage.getItem("isActiveEmployeeChecked");
                var storedEmpid = storedEmpid1.replace(/[\[\]"]+/g, '').trim();

                // Store filters for subsequent requests
                serverFilters = {
                    RptID: 19,
                    EmpID: storedEmpid,
                    CompanyID: storedCompanyID,
                    FromDate: Dates.fromDate,
                    Todate: Dates.toDate,
                    IsFilo: storedFilo,
                    DepId: storedDepartmentId,
                    BranchId: storedBranchid,
                    Isactive: storedisActive,
                    sortOrder: "asc",
                    columnFilters: []
                };

                $.ajax({
                    url: '/DataGridOptimize/tmptableforReports',
                    type: 'POST',
                    async: true,
                    dataType: 'json',
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({
                        draw: 1,
                        page: currentPage,
                        pageSize: pageSize,
                        ...serverFilters
                    }),
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("Authorization", '@_tokan');
                    },
                    success: function (json) {

                        $("#ajax_loader").hide();
                        if (!json.data || json.data.length === 0) {
                            $("#no_datas").attr("style", "display: flex !important;");
                            $("#accordion_container").hide();
                            toastr.success("No data available to show.");
                            hasMoreData = false;
                            return;
                        }
                        else {
                            $(".reportblock_table").css("display", "block");
                            $("#no_datas").attr("style", "display: none !important;");
                        }

                        // Store total records for pagination tracking
                        totalRecords = json.recordsTotal || json.totalRecords || 0;

                        // Check if we have more data available
                        hasMoreData = json.data.length === pageSize && (currentPage * pageSize) < totalRecords;

                        // Group data by employee
                        const groupedData = groupDataByEmployee(json.data);
                        renderAccordionView(groupedData);
                    },
                    error: function () {
                        $("#ajax_loader").hide();
                        //$("#initial-accordion-loading").hide(); // Hide initial loading indicator
                        toastr.error("Failed to fetch data.");
                    }
                });
            }

