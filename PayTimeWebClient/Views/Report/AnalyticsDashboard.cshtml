            // Function to fetch next page of data from server
            function fetchNextPageFromServer() {

                if (!hasMoreData || isLoadingAccordions) {
                    return;
                }

                isLoadingAccordions = true;
                const nextPage = currentPage + 1;


                $.ajax({
                    url: '/DataGridOptimize/tmptableforReports',
                    type: 'POST',
                    async: true,
                    dataType: 'json',
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({
                        draw: nextPage,
                        page: nextPage,
                        pageSize: pageSize,
                        ...serverFilters
                    }),
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("Authorization", '@_tokan');
                        // Show loading indicator
                        $("#accordion_container").append(`
                                        <div id="loading-more-accordions" class="accordion-loading">
                                            <i class="fa fa-spinner fa-spin"></i>Loading more employees from server...
                                        </div>
                                    `);
                    },
                    success: function (json) {

                        $("#loading-more-accordions").remove(); // Remove loading indicator

                        if (!json.data || json.data.length === 0) {
                            hasMoreData = false;
                            $("#accordion_container").append(`
                                            <div class="accordion-loading" style="color: #888;">
                                                <i class="fa fa-check-circle"></i>All employees loaded
                                            </div>
                                        `);
                            isLoadingAccordions = false;
                            return;
                        }

                        // Update pagination tracking
                        currentPage = nextPage;
                        hasMoreData = json.data.length === pageSize && (currentPage * pageSize) < totalRecords;


                        // Group the new data and append to existing
                        const newGroupedData = groupDataByEmployee(json.data);

                        // Merge new grouped data with existing
                        Object.keys(newGroupedData).forEach(key => {
                            if (globalGroupedData[key]) {
                                // Employee already exists, merge details
                                globalGroupedData[key].details = globalGroupedData[key].details.concat(newGroupedData[key].details);
                                // Update employee summary stats
                                globalGroupedData[key].employee.P += newGroupedData[key].employee.P;
                                globalGroupedData[key].employee.A += newGroupedData[key].employee.A;
                                globalGroupedData[key].employee.WeekOffs += newGroupedData[key].employee.WeekOffs;
                                globalGroupedData[key].employee.H += newGroupedData[key].employee.H;
                                globalGroupedData[key].employee.Less_Hrs += newGroupedData[key].employee.Less_Hrs;
                                globalGroupedData[key].employee.Half_Day += newGroupedData[key].employee.Half_Day;
                                globalGroupedData[key].employee.Error_Case += newGroupedData[key].employee.Error_Case;
                                globalGroupedData[key].employee.Paid_Leaves += newGroupedData[key].employee.Paid_Leaves;
                                globalGroupedData[key].employee.TotalHrs += newGroupedData[key].employee.TotalHrs;
                            } else {
                                // New employee
                                globalGroupedData[key] = newGroupedData[key];
                            }
                        });

                        // Append new accordion items
                        appendNewAccordionItems(newGroupedData);

                        isLoadingAccordions = false;
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.error('Error fetching next page:', textStatus, errorThrown);
                        $("#loading-more-accordions").remove();
                        $("#accordion_container").append(`
                                        <div class="alert alert-danger" style="margin: 10px;">
                                            Error loading more employees. Please try scrolling again.
                                        </div>
                                    `);
                        isLoadingAccordions = false;
                    }
                });
            }

            function groupDataByEmployee(data) {
                const grouped = {};
                data.forEach(function (row) {
                    const key = row.EmpCode + "_" + row.EmployeeName;
                    if (!grouped[key]) {
                        grouped[key] = {
                            employee: {
                                EmpId: row.EmpId || row.EmpID || row.EmployeeId || row.EmployeeID || '--',
                                EmpCode: row.EmpCode || '--',
                                EmployeeName: row.EmployeeName || '--',
                                Designation: row.Designation || '--',
                                P: 0,
                                A: 0,
                                WeekOffs: 0,
                                H: 0,
                                Less_Hrs: 0,
                                Half_Day: 0,
                                Error_Case:0,
                                Paid_Leaves: 0,
                                TotalHrs: 0
                            },
                            details: []
                        };
                    }

                    // Accumulate summary data
                    grouped[key].employee.P += parseFloat(row.P || 0);
                    grouped[key].employee.A += parseFloat(row.A || 0);
                    grouped[key].employee.WeekOffs += parseFloat(row['Week Off'] || 0);
                    grouped[key].employee.H += parseFloat(row.H || 0);
                    grouped[key].employee.Less_Hrs += parseFloat(row.Less_Hrs || 0);
                    grouped[key].employee.Half_Day += parseFloat(row.Half_Day || 0);
                    grouped[key].employee.Error_Case += parseFloat(row.Error_Case || 0);
                    grouped[key].employee.Paid_Leaves += parseFloat(row.Paid_Leave || 0);
                    grouped[key].employee.TotalHrs = row['TotalHrs'] || '0:00:00';

                    grouped[key].details.push(row);
                });

                return grouped;
            }

            let globalGroupedData = {}; // Store grouped data globally
            let accordionKeys = []; // Global array to store all accordion keys
            let currentIndex = 0; // Global index to track current position for lazy loading
            let isLoadingAccordions = false; // Prevent multiple simultaneous loads

            // Server-side pagination variables
            let currentPage = 1; // Track current page for server requests
            let totalRecords = 0; // Total records available on server
            let hasMoreData = true; // Flag to check if more data available
            let serverFilters = {}; // Store current filters for subsequent requests

            const pageSize = 10;

            // Function to append new accordion items from server data
            function appendNewAccordionItems(newGroupedData) {
                let container = $("#accordion_container");
                let html = "";

                const newKeys = Object.keys(newGroupedData);

