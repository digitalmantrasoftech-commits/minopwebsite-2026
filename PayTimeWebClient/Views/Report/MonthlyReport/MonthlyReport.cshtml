@model PayTimeWebClient.Models.ReportsModel.reqMonthlyReport


@{
    ViewBag.Title = "PayTimeWebReports";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //string _ReportName = HttpContext.Current.Request.["name"].ToString();
    string selectedOption = ViewBag.SelectedOption;
}

<script>
    var selectedEmpArray = new Array();
    $(document).ready(function () {
        var dtc = $.datepicker.formatDate('yy-mm-dd', new Date());
        //alert(date);
        //var firstDay = new Date(date.getFullYear(), date.getMonth(), 1);
        //var lastDay = new Date(date.getFullYear(), date.getMonth() + 1, 0);

        //var lastDayWithSlashes = (lastDay.getDate()) + '/' + (lastDay.getMonth() + 1) + '/' + lastDay.getFullYear();
        //alert(lastDayWithSlashes);

        //alert('hi');
        //var dtc = $.datepicker.formatDate('yy-mm-dd', new Date());
        //alert(dtc.getFullYear());
        ////var dt = new Date(document.getElementById('FromDate').value);
        //var firstDay = new Date(dtc.getFullYear(), dtc.getMonth(), 1);
        //var lastDay = new Date(dtc.getFullYear(), dtc.getMonth() + 1, 0);
        //var lastDayWithSlashes = (lastDay.getDate()) + '/' + (lastDay.getMonth() + 1) + '/' + lastDay.getFullYear();
        //alert(lastDayWithSlashes);
       

        //var CompanyId = $('#CompanyId').val();
        //alert(CompanyId);
        //$('#CompanyId').val(s);
        var fromdate = $('#FromDate').val();
        
        $('#FromDate').val(dtc);
        $('#Todate').val(dtc);
        $('#CompanyID').change(function () {
            var s = $('#CompanyID').val();
            fillBranchbycompnyid(s, "");
        });
        $('#BranchId').change(function () {
            var s = $('#BranchId').val();
            fillDeptTable(s, "");
        });

        function fillBranchbycompnyid(companyid, selectbranch) {
            $('#BranchId').empty();
            $.ajax(
             {
                 type: "GET",
                 url: "/MasterData/GetBranchbycomapny",
                 data: { comapanyid: companyid },
                 contentType: "application/json; charset=utf-8",
                 dataType: "json",

                 success: function (data) {
                     //alert(data[0].BranchId);
                     var markup = '';

                     for (var x = 0; x < data.length; x++) {
                         markup += "<option value=" + data[x].BranchId + ">" + data[x].BranchName + "</option>";
                     }
                     var newOption = '<option selected="selected"  value="">Select Branch</option>';

                     $('#BranchId').html(newOption);
                     $('#BranchId').append(markup);
                     $('#BranchId').val(selectbranch);
                 },
                 error: function (jqXHR, ajaxOptions, thrownError) {
                     $('.loading').hide();

                     if (jqXHR.status == 500) { //InternalServerError = 500,
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) { //BadRequest = 400,
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                 },
             });
        }
        function fillDeptTable(BranchId, selectedDept) {
            $('#DepartmentIdTbl').empty();
            $.ajax(
             {
                 type: "GET",
                 url: "/MasterData/GetDeptbyBranch",
                 data: { BranchId: BranchId },
                 contentType: "application/json; charset=utf-8",
                 dataType: "json",
                 success: function (data) {

                     var n = 1;
                     var markup = '';

                     for (var x = 0; x < data.length; x++) {
                         //  markup += "<option value=" + data[x].Value + ">" + data[x].Text + "</option>";
                         markup += " <tr> <td>" + data[x].Text + "</td> "
                         markup += "<td id=Col_" + data[x].Value + "><input type=checkbox value='" + data[x].Value + "' id='ChkDept' onchange=fillEmpTable('" + data[x].Value + "',checked); /></td></tr>"
                         n++;

                     }
                     //var newOption = '<option selected="selected"  value="">Select Branch</option>';

                     //$('#DepartmentId').html(newOption);
                     $('#DepartmentIdTbl').append(markup);



                     // $('#DepartmentId').val(selectedDept);



                 },
                 error: function (jqXHR, ajaxOptions, thrownError) {
                     $('.loading').hide();

                     if (jqXHR.status == 500) { //InternalServerError = 500,
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) { //BadRequest = 400,
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                 },
             });
        }
        $('#ChkAll').click(function (e) {
            $('#EmpIdTbl tr').remove();
            var table = $(e.target).closest('table');
            $('td input:checkbox', table).prop('checked', this.checked);
            for (i = 0; i < $('td input:checkbox', table).length; i++) {

                if ($('td input:checkbox', table)[i].checked == true) {
                    var DeptCode = $('td input:checkbox', table)[i].value;
                    fillEmpTable(DeptCode, true)
                }
                else {
                    $('#EmpIdTbl tr').remove();
                }
            }
        });



    });
    function fillEmpTable(DepartmentId, selectedEmp) {

        if (DepartmentId != 0 && selectedEmp != false) {
            $.ajax(
             {
                 type: "GET",
                 url: "/MasterData/GetEmpByDept",
                 data: { DepartmentId: DepartmentId },
                 contentType: "application/json; charset=utf-8",
                 dataType: "json",
                 success: function (data) {

                     var markup = '';
                     var tmpDepartmentId;


                     $('#EmpIdTbl tr').each(function () {
                         var customerId = $(this).find(".PunchID").html();
                     });


                     for (var x = 0; x < data.length; x++) {
                         markup += " <tr class='row_" + data[x].DepartmentId + "' > <td>" + data[x].EmpName + "</td> "
                         markup += " <td class=PunchID>" + data[x].EmpPunchID + "</td> "
                         markup += "<td id=Col_" + data[x].EmpId + "><input type='checkbox' onchange=EmpIdArray('" + data[x].EmpId + "',checked);   value='" + data[x].DepartmentId + "' id='ChkEmp' /></td></tr>"
                         tmpDepartmentId = data[x].DepartmentId;
                     }

                     if (selectedEmp == true) {

                         $('#EmpIdTbl').append(markup);


                     }
                     if (selectedEmp == false) {
                         var CheckBoxChkEmp = $("input[name=ChkEmp]");
                         for (var i = 0; i < CheckBoxChkEmp.length; i++) {
                             var vv = CheckBoxChkEmp[i].value;
                             if (vv == tmpDepartmentId) {
                                 CheckBoxChkEmp[i].closest('tr').remove();
                             }
                         }
                     }
                 },
                 error: function (jqXHR, ajaxOptions, thrownError) {
                     $('.loading').hide();

                     if (jqXHR.status == 500) { //InternalServerError = 500,
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) { //BadRequest = 400,
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                 },
             });
        }
        else {
            $('#EmpIdTbl .row_' + DepartmentId + '').remove();
        }
    };
    function EmpIdArray(selectedEmpId, selection) {

        if (selection == true) {
            selectedEmpArray.push(selectedEmpId)
        }
        if (selection == false) {
            selectedEmpArray = jQuery.grep(selectedEmpArray, function (value) {
                return value != selectedEmpId;
            });

        }

        $("#EmpID").val(JSON.stringify(selectedEmpArray));
        //alert($("#EmpID").val());
    };
</script>
<h1 class="page-title">
    Report 
</h1>
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("MonthlyReports", "Report", FormMethod.Post))
        {
            <div class="portlet light portlet-fit bordered">
                <div class="portlet-body well">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label">Company</label>
                                @if (ViewBag.Companyslist != null)
                                {
                                    @Html.DropDownList("CompanyID", new SelectList(ViewBag.Companyslist, "CompanyID", "CompanyName"), "Select Company", new { @class = "form-control" })
                                }
                                else
                                {
                                    @Html.DropDownList("CompanyID", new SelectList(new[] { "" }), "Select Company", new { @class = "form-control" })
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label">Branch</label>
                                @Html.DropDownList("BranchId", new SelectList(new[] { "" }), "Select Branch", new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label">From</label>

                                <div class="input-group  date date-picker" data-date-format="yyyy-mm-dd" data-date-viewmode="years">
                                    <span class="input-group-btn">
                                        <button class="btn default btn-sm" type="button">
                                            <i class="fa-light fa-calendar-days"></i>
                                        </button>
                                    </span>
                                    @Html.TextBoxFor(model => model.FromDate, new { @class = "form-control input-sm" })
                                    @*<input type="text" id="FromDate" class="form-control input-sm">*@
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                            <div class="portlet">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label>Department</label>
                                        <table id="tbldept" class="table table-striped table-bordered table-hover table-scrollable table-checkable order-column ">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th width="40px"><input type="checkbox" id="ChkAll" /></th>
                                                </tr>
                                            </thead>
                                            <tbody id="DepartmentIdTbl"></tbody>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <label>Employee</label>
                                        @Html.HiddenFor(model => model.EmpID)
                                        @Html.HiddenFor(model => model.CompanyId)


                                        <table id="tblemp" class="table-scrollable table table-striped table-bordered table-hover table-checkable order-column ">
                                            <thead>
                                                <tr>
                                                    <th>Employee Name</th>
                                                    <th>Punch Id</th>
                                                    <th width="40px"><input type="checkbox" id="ChkAllEmp" /></th>
                                                </tr>
                                            </thead>
                                            <tbody id="EmpIdTbl"></tbody>
                                        </table>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-actions text-right margin-top-30">
                                            <button type="submit" id="BtnSave" class="btn blue btn-block">Show Report</button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
    <div class="col-md-12">


    </div>

</div>
