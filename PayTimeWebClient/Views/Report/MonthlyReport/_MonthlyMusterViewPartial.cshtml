@model IEnumerable<PayTimeWebClient.Models.ReportsModel.MonthlyMuster>
@{
    var startday = Convert.ToInt32(ViewBag.startday);
    var lastday = Convert.ToInt32(ViewBag.lastday);
    var _isdateformat = "mm-yyyy";
    var Leavetype = ViewBag.Leavetype;
    var Leavecnt = Convert.ToInt32(ViewBag.Leavecnt);
    var Levlst = ViewBag.Levlst;
}

@{var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "GridView";
        settings.CallbackRouteValues = new { Controller = "Report", Action = "MonthlyMusterViewPartial" };
        settings.SettingsBehavior.ConfirmDelete = true;
        settings.KeyFieldName = "EmpId";
        settings.SettingsPager.Visible = true;
        settings.Settings.ShowGroupPanel = true;
        settings.Settings.ShowFilterRow = true;
        settings.SettingsBehavior.AllowSelectByRowClick = true;
        settings.SettingsBehavior.EnableCustomizationWindow = true;
        settings.ClientSideEvents.CustomizationWindowCloseUp = "grid_CustomizationWindowCloseUp";
        settings.SettingsAdaptivity.AdaptivityMode = GridViewAdaptivityMode.HideDataCellsWindowLimit;
        settings.SettingsAdaptivity.AdaptiveColumnPosition = GridViewAdaptiveColumnPosition.Right;
        settings.SettingsAdaptivity.AdaptiveDetailColumnCount = 1;
        settings.SettingsAdaptivity.AllowOnlyOneAdaptiveDetailExpanded = true;
        settings.SettingsAdaptivity.HideDataCellsAtWindowInnerWidth = 0;
        settings.SettingsResizing.ColumnResizeMode = ColumnResizeMode.Control;
        settings.SettingsResizing.Visualization = ResizingMode.Postponed;
        settings.SettingsBehavior.AllowEllipsisInText = true;
        settings.Settings.ShowTitlePanel = true;
        settings.SettingsPager.Mode = GridViewPagerMode.ShowPager;
        settings.SettingsPager.FirstPageButton.Visible = true;
        settings.SettingsPager.LastPageButton.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Items = new string[] { "10", "20", "50", "100" };
        settings.SettingsPager.PageSize = 20;
        settings.Columns.Add("BranchName", "Branch").GroupIndex = 1;
        settings.Columns.Add("DepartmentName", "Department").GroupIndex = 2;
        settings.Settings.HorizontalScrollBarMode = ScrollBarMode.Visible;
        settings.Styles.Header.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        settings.Styles.Header.Font.Bold = true;
        settings.Styles.Cell.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);


        settings.SettingsExport.Landscape = true;
        settings.SettingsExport.LeftMargin = 170;
        settings.SettingsExport.TopMargin = 15;
        settings.SettingsExport.RightMargin = 15;
        settings.SettingsExport.BottomMargin = 15;
        settings.SettingsExport.PaperKind = System.Drawing.Printing.PaperKind.Legal;

        settings.Columns.Add(column =>
        {
            column.FieldName = "PFromDate";
            column.Caption = "Att_Month";
            column.UnboundType = DevExpress.Data.UnboundColumnType.DateTime;
            column.PropertiesEdit.DisplayFormatString = "MM-yyyy";
            column.ExportWidth = 80;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "EmpCode";
            column.Width = 80;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;

        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "EmpName";
            column.Width = 300;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Left;
        });


        int j = startday;
        for (int i = 1; i <= lastday; i++)
        {
            string colname = string.Empty;
            colname = "D" + j.ToString();


            settings.Columns.Add(column =>
            {
                column.FieldName = colname;
                column.Caption = j.ToString();
                column.Width = 40;
            });

            if (j == lastday)
            {
                j = 1;
            }
            else
            {
                j++;
            }
        }

        int Acnt = 0;
        settings.HtmlDataCellPrepared = (s, e) =>
         {

             if (e.DataColumn.FieldName.IndexOf("D", 0) == 0)
             {
                 string Fs = (string)e.GetValue(e.DataColumn.FieldName);
                 if (string.IsNullOrEmpty(Fs))
                 {
                     e.Cell.Text = "A";
                     Acnt++;
                 }
             }



             if (e.DataColumn.FieldName == "A")
             {
                 decimal Fcnt = (decimal)e.GetValue(e.DataColumn.FieldName);
                 //int Newctn = Convert.ToInt32(Fcnt) + Acnt;
                 var Newctn = Convert.ToString(Fcnt);
                 e.Cell.Text = Newctn.ToString();
                 Acnt = 0;
             }

         };

        settings.Columns.Add("P").Width = 50;
        settings.Columns.Add("A").Width = 50;
        settings.Columns.Add("WO").Width = 50;
        settings.Columns.Add("H").Width = 50;
        settings.Columns.Add("PL").Width = 50;
        settings.Columns.Add("TotHour", "TH").Width = 50;
        settings.Columns.Add("P_day", "Present days").Width = 100;
        settings.Columns.Add("OTHr", "OT Hrs").Width = 80;
        //settings.Columns.Add("Levlst", "Levlst").Width = 80;

        settings.Columns.Add(column =>
        {
            column.FieldName = "Levlst";
            column.Caption = "Levlst";
            column.Visible = false;
            column.UnboundType = DevExpress.Data.UnboundColumnType.Integer;
            column.CellStyle.HorizontalAlign = System.Web.UI.WebControls.HorizontalAlign.Center;
            column.ExportWidth = 80;
        });

        //---------------------- Add leave balance
        string _Leavetypespl = Leavetype;

        if (!string.IsNullOrEmpty(_Leavetypespl))
        {
            string[] _Leavetype = _Leavetypespl.Split(',');

            for (int i = 0; i < _Leavetype.Count(); i++)
            {
                if (i <= 59)
                {
                    var _Leavetypename = _Leavetype[i];
                    var _Leavename = _Leavetype[i].Split('_');
                    settings.Columns.Add(_Leavename[0], _Leavename[1]).Width = 40;                    
                }
            }
        }


        settings.HtmlDataCellPrepared = (s, e) =>
         {
             if (e.DataColumn.FieldName.IndexOf("L", 0) == 0)
             {
                 var _fldnm = e.DataColumn.FieldName + '_' + e.DataColumn;
                 var _col = e.DataColumn.ToString();
                 if (e.DataColumn.FieldName != "Levlst")
                 {
                     var _lvlst = (string)e.GetValue("Levlst");
                     if (!string.IsNullOrEmpty(_lvlst))
                     {
                         var _lvlstsp = _lvlst.Split(',');

                         for (int i = 0; i < _lvlstsp.Count(); i++)
                         {
                             var _lvlstspcol = _lvlstsp[i].Split('_');
                             var _levval = _lvlstspcol[1].Split(':');
                             if (_levval[0].ToString().Trim() == _col.ToString())
                             {
                                 e.Cell.Text = _levval[1].ToString();
                                 break;
                             }
                             else
                             {
                                 e.Cell.Text = "0";
                             }
                         }
                     }
                     else
                     {
                         e.Cell.Text = "0";
                     }
                 }
             }

         };

        //---------------------- Add leave balance

        settings.SettingsBehavior.AutoExpandAllGroups = true;
        settings.SettingsText.Title = " Monthly Muster Report ";

        settings.SettingsExport.EnableClientSideExportAPI = true;

        settings.SettingsExport.ExcelExportMode = DevExpress.Export.ExportType.WYSIWYG;
        settings.SettingsExport.FileName = settings.SettingsText.Title;
        settings.SettingsLoadingPanel.Mode = GridViewLoadingPanelMode.Disabled;
        settings.Toolbars.Add(t =>
        {
            t.Items.Add(GridViewToolbarCommand.ExportToPdf);
            t.Items.Add(GridViewToolbarCommand.ExportToXls);            
        });
        
    }).Bind(Model).GetHtml();
}
