<script>
    var selectedEmpArray = new Array();
    var crptid = '@ViewBag.crptid';
    var reporthead = '@ViewBag.Title';

    $(document).ready(function () {
        $("#btShowCustomizationWindow").show();
        if (crptid == 0) {
            //GridView.ExpandAll();
        }
        else {
            $("#btnshowcoloum").hide();
            $("#tdprintreport").hide();
        }

        $("#btShowCustomizationWindow").click(
            function () {
                UpdateCustomizationWindowVisibility();
            }
        );
        $("#btnback").click(
            function () {
                window.location.href = "/Report/ReportDashboard";
                //window.history.back();
            }
        );

        $("#btnexcel").click(function () {
            
            // Show the loader when the request starts
            $("#ajax_loader").show();

            var xhr = new XMLHttpRequest();
            xhr.open('POST', '/Report/MonthlyReportsExcel', true); // Change the URL to match your API endpoint
            xhr.setRequestHeader('Content-Type', 'application/json'); // Set content type for JSON

            var requestData = {
            };

            xhr.responseType = 'blob';

            xhr.onload = function () {
                $("#ajax_loader").hide();

                if (xhr.status === 200) {
                    var blob = xhr.response;
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        console.log(e.target.result); // Use this for debugging, if needed
                    };
                    reader.readAsDataURL(blob); // Use readAsDataURL for base64 encoded data

                    // Create a link to download the blob
                    var url = window.URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = 'MonthlyMusterReport.xlsx'; // Set the default file name
                    document.body.appendChild(a);
                    a.click(); // Trigger the download
                    a.remove(); // Clean up

                    // Revoke the object URL after the download
                    window.URL.revokeObjectURL(url);
                } else {
                    console.error('Error downloading the Excel file:', xhr.statusText);
                }
            };

            xhr.onerror = function () {
                console.error('Request failed:', xhr.statusText);
            };

            xhr.send(JSON.stringify(requestData));
        });


    });


    function grid_CustomizationWindowCloseUp(s, e) {
        UpdateButtonText();
    }
    function UpdateCustomizationWindowVisibility() {
        if (GridView.IsCustomizationWindowVisible())
            GridView.HideCustomizationWindow();
        else
            GridView.ShowCustomizationWindow();
        UpdateButtonText();
    }
    function UpdateButtonText() {
        var text = GridView.IsCustomizationWindowVisible() ? "Hide" : "Show";
        text += " Columns Window";
        $("#btShowCustomizationWindow").val(text);
    }
    function OnClick(s, e) {
        var actionParams = $("Gridexport").attr("action").split("?OutputFormat=");
        actionParams[1] = s.GetMainElement().getAttribute("OutputFormatAttribute");
        $("Gridexport").attr("action", actionParams.join("?OutputFormat="));
    }
</script>

