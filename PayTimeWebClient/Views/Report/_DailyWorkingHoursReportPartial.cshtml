@model IEnumerable<PayTimeWebClient.Models.DailyWorkingHoursReport>
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Daily Working Hours Report";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
}
<style>
    .report_header_box {
        color: #2196f3;
        background-color: #fff;
        margin: 20px 0;
        padding: 10px;
        font-size: 16px;
        font-weight: 500;
        text-align: center;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {
        if ($('#tbldailyworkinghours').length) {
            $('#tbldailyworkinghours').DataTable({
                dom: 'lBfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        title: 'Daily Working Hours Report',
                        text: 'Excel'
                    }
                ]
            });
        }
    });
</script>
<div class="report_header_box">
    <span id="customcaption">Daily Working Hours Report</span>
</div>
<div class="portlet">
    <div class="portlet-body">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                @if (Model != null && Model.Any())
                {
                    <table id="tbldailyworkinghours" class="table table-striped table-bordered table-hover table-checkable order-column">
                        <thead>
                            <tr>

                                <th>Emp Code</th>
                                <th>Emp PunchID</th>
                                <th>Emp Name</th>
                                <th>Department Name</th>
                                <th>Attn Date</th>
                                <th>IN Time</th>
                                <th>OUT Time</th>
                                <th>Working Hours</th>
                                <th>Total Hours</th>
                                <th>Final Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.empcode</td>
                                    <td>@item.Emppunchid</td>
                                    <td>@item.Empname</td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.Attn_Dt</td>
                                    <td>@item.In_Time</td>
                                    <td>@item.Out_Time</td>
                                    <td>@item.Duration_HHMMSS</td>
                                    <td>@item.TotHour</td>
                                    <td>@item.finalstatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="nodata_block no_recoed" style=" text-align: center;" id="no_data">
                        <img src="/assets/images/Data_not_found.jpg" height="200" width="200" alt="No Data Icon">
                    </div>
                }
            </div>
        </div>
    </div>
</div>

