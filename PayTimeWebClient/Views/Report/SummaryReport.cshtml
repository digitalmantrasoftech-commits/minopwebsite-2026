@Html.DevExpress().GetStyleSheets(
    new StyleSheet { ExtensionSuite = ExtensionSuite.Editors },
        new StyleSheet { ExtensionSuite = ExtensionSuite.GridView }

    )
@Html.DevExpress().GetScripts(
    new Script { ExtensionSuite = ExtensionSuite.Editors },
        new Script { ExtensionSuite = ExtensionSuite.GridView }
    )
@{
    string selectedreport = ViewBag.selectedreport;
    string Actname = string.Empty;
    if (selectedreport == "DepartmentSummaryReport")
    {
        Actname = "DepartmentSummaryPivotePartial";
    }
    if (selectedreport == "EarlyInSummaryReport")
    {
        Actname = "EarlyInSummaryReportPartial";
    }
}
<script type="text/javascript">
    $(document).ready(function () {
        PrepareShowPointLabelStyles();
        $("#ChartType").change(function () {
            PrepareShowPointLabelStyles();
        });
        GridView.ExpandAll();
        $("#btShowCustomizationWindow").click(
            function () {
                UpdateCustomizationWindowVisibility();
            }
        );
        $("#btnback").click(
            function () {
                window.history.back();
            }
        );
    });

    function UpdateChart() {
        webChart.PerformCallback();
    }
    function OnBeginChartCallback(s, e) {
        pivotGrid.FillStateObject(e.customArgs);
    }
    function PrepareShowPointLabelStyles() {
        if ($("#ChartType option:selected").text() == "SwiftPlot") {
            $("#ShowPointLabels").attr("disabled", "disabled");
            $("label[for='ShowPointLabels']").css("color", "#aaa");
        } else {
            $("#ShowPointLabels").removeAttr("disabled");
            $("label[for='ShowPointLabels']").css("color", "");
        }
    }

    function grid_CustomizationWindowCloseUp(s, e) {
        UpdateButtonText();
    }
    function UpdateCustomizationWindowVisibility() {
        if (GridView.IsCustomizationWindowVisible())
            GridView.HideCustomizationWindow();
        else
            GridView.ShowCustomizationWindow();
        UpdateButtonText();
    }
    function UpdateButtonText() {
        var text = GridView.IsCustomizationWindowVisible() ? "Hide" : "Show";
        text += " Columns Window";
        $("#btShowCustomizationWindow").val(text);
    }
    function OnClick(s, e) {
        var actionParams = $("form").attr("action").split("?OutputFormat=");
        actionParams[1] = s.GetMainElement().getAttribute("OutputFormatAttribute");
        $("form").attr("action", actionParams.join("?OutputFormat="));
    }

</script>


<br />

<div class="row">
    <div class="col-md-10">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <input type="button" id="btShowCustomizationWindow" value="Show Columns Window" style="width: 200px;" title="Show Custom Columns Window" class="btn  blue" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <input type="button" id="btnback" value="Go to DashBoard" style="width: 200px;" title="For go to Report Dashboard." class="btn  blue" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <select id="dllexport" class="form-control " title="For Report Export">
                        <option value="">Export To</option>
                        <option value="CSV">CSV</option>
                        <option value="PDF">PDF</option>
                        <option value="RTF">RTF</option>
                        <option value="XLS">XLS</option>
                        <option value="XLSX">XLSX</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-2"></div>
</div>

<div class="row">
        @if (selectedreport == "DepartmentSummaryReport")
        {
            @Html.Partial("_DepartmentSummaryChartPartial")
        }
        @Html.Action(Actname)
</div>

