@using System.Data
@using System
@model DataTable
@{
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
}

<script type="text/javascript">
    var isDateFormat = '@_isdateformat';
    $(document).ready(function () {
        var table = $('#crpttbl').DataTable({
            "responsive": true,
            "colReorder": true,
            "processing": true,
            //"dom": 'lBfrtip',
            dom: _domCommon,
            language: _languageCommon,
            "ordering": true,
            "buttons": [{
                extend: 'excelHtml5',
                text: 'Excel',
                titleAttr: 'Export to excel'
            },
            {
                extend: 'csvHtml5',
                text: 'CSV',
                titleAttr: 'Export to csv'
                }],
            initComplete: function () {
                const visibleTable = $('table:visible').attr('id');
                $("#buttons").append(`
                 <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                     <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                 </div>
              `);
            }
        });
        setTimeout(function () {
            $("#" + "crpttbl" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        new $.fn.dataTable.ColReorder(table, {
        });

        //$('#crpttbl_filter').append('<div id="crFilter"><i><b>Note:</b> Custom reports export only excel format.</i></div>');
        $('#customcaption').text(reporthead);
       
    });

    function showload() {
        $(".loading").show();
    }

    function Getload() {
        $(".loading").hide();
    }
</script>
<div>

    <div class="portlet">

        <div id='ajax_loader' class="modal_bg loading" aria-hidden="true" hidden>
            <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
        </div>
        <div class="header-full-width" style="text-align:center"><span id="customcaption" class="h2"></span></div>

        <div class="table-scrollable">
            @if (Model != null && Model.Rows.Count != 0)
            {

                @*if (Model.Rows.Count > 60000)
            {
                <table class="display" style="width:100%">
                    <tr>
                        <td colspan="8" style="text-align:center; font-size:18px;"> <b>Report sent on login E-mail.</b></td>
                    </tr>
                </table>
            }
            else
            {*@
                <div class="table-responsive" id="tableResponsive">
                    <table id="crpttbl" class="display nowrap table new_datatbl table-striped table-bordered table-hover table-checkable order-column  dataTable no-footer">
                        <thead>
                            <tr>
                                @foreach (DataColumn col in Model.Columns)
                                {
                                    <th>
                                        @if (col.ColumnName.Contains("file-"))
                                        {
                                            @col.ColumnName.Replace("file-", "")
                                        }
                                        @if (col.ColumnName.Contains("date-"))
                                        {
                                            @col.ColumnName.Replace("date-", "")
                                        }
                                        else
                                        {
                                            @col.ColumnName
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <script>
                                showload();
                            </script>
                            @{ int i = 1; }
                            @foreach (DataRow row in Model.Rows)
                            {

                                <tr>

                                    @foreach (DataColumn col in Model.Columns)
                                    {

                                        if (col.ColumnName == "Attn Date")
                                        {
                                            if (row[col.ColumnName].ToString().Length <= 10)
                                            {
                                                <td></td>
                                            }
                                            else
                                            {
                                                if (@_isdateformat == "dd-M-yyyy" || @_isdateformat == "M-dd-yyyy" || @_isdateformat == "yyyy-M-dd")
                                                {
                                                    <td>@System.DateTime.Parse(row[col.ColumnName].ToString()).ToString(_isdateformat.Replace("M", "MMM"))</td>
                                                }
                                                else
                                                {
                                                    <td>@System.DateTime.Parse(row[col.ColumnName].ToString()).ToString(_isdateformat.Replace("mm", "MM"))</td>
                                                }
                                            }
                                        }
                                        else if (col.ColumnName == "Employee DOB")
                                        {
                                            if (row[col.ColumnName].ToString().Length <= 10)
                                            {
                                                <td></td>
                                            }
                                            else
                                            {
                                                if (@_isdateformat == "dd-M-yyyy" || @_isdateformat == "M-dd-yyyy" || @_isdateformat == "yyyy-M-dd")
                                                {
                                                    <td>@System.DateTime.Parse(row[col.ColumnName].ToString()).ToString(_isdateformat.Replace("M", "MMM"))</td>
                                                }
                                                else
                                                {
                                                    <td>@System.DateTime.Parse(row[col.ColumnName].ToString()).ToString(_isdateformat.Replace("mm", "MM"))</td>
                                                }
                                            }

                                        }
                                        else if (col.ColumnName == "Employee Join Date")
                                        {
                                            if (row[col.ColumnName].ToString().Length <= 10)
                                            {
                                                <td></td>
                                            }
                                            else
                                            {
                                                if (@_isdateformat == "dd-M-yyyy" || @_isdateformat == "M-dd-yyyy" || @_isdateformat == "yyyy-M-dd")
                                                {
                                                    <td>@System.DateTime.Parse(row[col.ColumnName].ToString()).ToString(_isdateformat.Replace("M", "MMM"))</td>
                                                }
                                                else
                                                {
                                                    <td>@System.DateTime.Parse(row[col.ColumnName].ToString()).ToString(_isdateformat.Replace("mm", "MM"))</td>
                                                }
                                            }
                                        }

                                        else if (col.ColumnName == "Employee Resign. Date")
                                        {

                                            if (row[col.ColumnName].ToString().Length <= 10)
                                            {
                                                <td></td>
                                            }
                                            else
                                            {
                                                if (@_isdateformat == "dd-M-yyyy" || @_isdateformat == "M-dd-yyyy" || @_isdateformat == "yyyy-M-dd")
                                                {
                                                    <td>@System.DateTime.Parse(row[col.ColumnName].ToString()).ToString(_isdateformat.Replace("M", "MMM"))</td>
                                                }
                                                else
                                                {
                                                    <td>@System.DateTime.Parse(row[col.ColumnName].ToString()).ToString(_isdateformat.Replace("mm", "MM"))</td>
                                                }
                                            }
                                        }
                                        else if (col.ColumnName.Contains("file-"))
                                        {
                                            <td>
                                                <a href='/FileuploadControlData/@Session["cmpcode"]/@row[col.ColumnName]' target=" _blank" download>
                                                    @row[col.ColumnName]
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>@row[col.ColumnName]</td>
                                        }
                                    }
                                    <span style="display:none;">@i++</span>
                                </tr>

                            }
                            @if (Model.Rows.Count == i)
                            {
                                <script>
                                    Getload();
                                </script>
                            }

                        </tbody>
                    </table>
                    </div>
                    //}
                    }
                    else
                    {
                    <table class="display" style="width:100%">
                        <tr>
                            <td colspan="8" style="text-align:center; font-size:18px;"> <b>No matching records found</b></td>
                        </tr>
                    </table>
                    }

                </div>
            </div>

</div>
