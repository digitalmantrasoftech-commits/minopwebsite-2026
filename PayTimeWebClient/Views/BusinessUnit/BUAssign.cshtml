    /* ViewAll BU Modal Styles */
    .viewall-search-box {
        position: relative;
        margin-bottom: 15px;
    }

        .viewall-search-box input {
            width: 100%;
            padding: 8px 14px 8px 38px;
            border: 1px solid #dce1e8;
            border-radius: 8px !important;
            font-size: 13px;
            color: #333;
            background: #ffffff;
            outline: none;
            transition: all 0.25s ease;
        }

            .viewall-search-box input:focus {
                border-color: #4a90d9;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(74, 144, 217, 0.1);
            }

            .viewall-search-box input::placeholder {
                color: #aab2bd;
            }

        .viewall-search-box .search-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #aab2bd;
            font-size: 13px;
            pointer-events: none;
        }

    .viewall-bu-count {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
        padding: 0 2px;
    }

        .viewall-bu-count .count-label {
            font-size: 12px;
            color: #333333;
            font-weight: 500;
        }

        .viewall-bu-count .count-num {
            font-size: 11px;
            font-weight: 500;
            color: #295097;
            border-radius: 12px !important;
        }

    .viewall-bu-list {
        background: #fff;
        list-style: none;
        padding: 0;
        margin: 0;
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid #eef0f3;
        border-radius: 8px !important;
    }

        .viewall-bu-list::-webkit-scrollbar {
            width: 4px;
        }

        .viewall-bu-list::-webkit-scrollbar-track {
            background: transparent;
        }

        .viewall-bu-list::-webkit-scrollbar-thumb {
            background: #d0d5dd;
