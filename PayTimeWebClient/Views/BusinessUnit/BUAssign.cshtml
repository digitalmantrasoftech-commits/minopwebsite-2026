</style>

<script>
    $(document).ready(function () {

        // ========== 1. Global Variables ==========
        var _webapiurl = '@_webapiurl';
        var _tokan = '@_tokan';
        var _loginEmpId = '@_empid';
        var _RoleId = '@_RoleId';

        // ========== 2. DataTable Initialisation ==========
        var table = $("#tblBuHead").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            ordering: true,
            columnDefs: [
                { orderable: false, targets: [7] }
            ],
        });

        setTimeout(function () {
            $("#tblBuHead_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        // ========== 3. Multiselect Initialisation ==========
        // Assign Modal
        $("#BuID_Modal").multiselect({
            selectAllValue: 'multiselect-all', enableCaseInsensitiveFiltering: true, includeSelectAllOption: true,
            allSelectedText: 'All Select', enableFiltering: true, maxHeight: '300', buttonWidth: '100%',
            enableClickableOptGroups: true, nonSelectedText: 'Select BU'
        });
        $("#SubbuID_Modal").multiselect({
            selectAllValue: 'multiselect-all', enableCaseInsensitiveFiltering: true, includeSelectAllOption: true,
            allSelectedText: 'All Select', enableFiltering: true, maxHeight: '300', buttonWidth: '100%',
            enableClickableOptGroups: true, nonSelectedText: 'Select Sub Bu'
        });
        // Filter Panel
        $("#ddlBuID").multiselect({
            selectAllValue: 'multiselect-all', enableCaseInsensitiveFiltering: true, includeSelectAllOption: true,
            allSelectedText: 'All Select', enableFiltering: true, maxHeight: '300', buttonWidth: '100%',
            enableClickableOptGroups: true, nonSelectedText: 'Select BU'
        });
        $("#SubbuID").multiselect({
            selectAllValue: 'multiselect-all', enableCaseInsensitiveFiltering: true, includeSelectAllOption: true,
            allSelectedText: 'All Select', enableFiltering: true, maxHeight: '300', buttonWidth: '100%',
            enableClickableOptGroups: true, nonSelectedText: 'Select Sub Bu'
        });
        // Edit Modal
        $("#BuID_Edit").multiselect({
            selectAllValue: 'multiselect-all', enableCaseInsensitiveFiltering: true, includeSelectAllOption: true,
            allSelectedText: 'All Select', enableFiltering: true, maxHeight: '300', buttonWidth: '100%',
            enableClickableOptGroups: true, nonSelectedText: 'Select BU'
        });
        $("#SubbuID_Edit").multiselect({
            selectAllValue: 'multiselect-all', enableCaseInsensitiveFiltering: true, includeSelectAllOption: true,
            allSelectedText: 'All Select', enableFiltering: true, maxHeight: '300', buttonWidth: '100%',
            enableClickableOptGroups: true, nonSelectedText: 'Select Sub Bu'
        });

        // ========== 4. Page Load API Calls ==========
        RoleGetAll(_RoleId);
        LoadBUList();
        LoadBUHeadData();

        // ========== 5. Common Functions ==========

        // 5.1 Load BU Head Data (GetAll & Search)
        function LoadBUHeadData(filterData) {
            var isSearch = (filterData != null && filterData != undefined);
            var apiUrl = _webapiurl + (isSearch ? 'Master/BUHeadSearch' : 'Master/BUHeadGetAll');

            $.ajax({
                type: isSearch ? "POST" : "GET",
                url: apiUrl,
                headers: { 'Authorization': _tokan },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: isSearch ? JSON.stringify(filterData) : null,
                beforeSend: function () { $(".loading").show(); },
                success: function (response) {
                    if (response.isRedirect) { window.location.href = response.redirectUrl; }
                    table.clear();
                    if (response != null && response.length > 0) {
                        $("#NotificationGrid-empty").hide();
                        $("#tableResponsive").show();
                        for (var i = 0; i < response.length; i++) {
                            var item = response[i];
                            var statusClass = (item.IsActive == true || item.IsActive == 1) ? 'green_font' : 'red_font';
                            var statusText = (item.IsActive == true || item.IsActive == 1) ? 'Active' : 'Inactive';
                            var buIdsStr = (item.BUIds || '').toString();
                            var subBuIdsStr = (item.SubBUIds || '').toString();

                            var actionHtml = '<a href="javascript:;" class="btn blue_btnnew tooltips btnEdit" data-id="' + item.BUHeadId + '" data-roleid="' + (item.RoleId || 0) + '" data-empid="' + (item.EmpId || 0) + '" data-empname="' + (item.EmpName || '') + '" data-buids="' + buIdsStr + '" data-subbuids="' + subBuIdsStr + '" data-placement="left" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>';
                            if (item.IsActive == true || item.IsActive == 1) {
                                actionHtml += ' <a href="javascript:;" class="btn blue_btnnew tooltips btnInactive" data-id="' + item.BUHeadId + '" data-empname="' + (item.EmpName || '') + '" data-placement="left" data-original-title="Inactive"><i class="fa-solid fa-xmark"></i></a>';
                            } else {
                                actionHtml += ' <a href="javascript:;" class="btn blue_btnnew tooltips btnActive" data-id="' + item.BUHeadId + '" data-empname="' + (item.EmpName || '') + '" data-placement="left" data-original-title="Active"><i class="fa-solid fa-check"></i></a>';
                            }

                            var buNames = (item.BUNames || '').toString();
                            var subBuNames = (item.SubBUNames || '').toString();
                            var buViewHtml = '<span class="Bu_viewall navyblue_font" style="cursor: pointer; font-weight: 500;" data-bunames="' + encodeURIComponent(buNames) + '">View All <i class="fa-regular fa-eye" style="margin-left: 6px;"></i></span>';
                            var subBuViewHtml = '<span class="SubBu_viewall navyblue_font" style="cursor: pointer; font-weight: 500;" data-subbunames="' + encodeURIComponent(subBuNames) + '">View All <i class="fa-regular fa-eye" style="margin-left: 6px;"></i></span>';

                            table.row.add([
                                item.EmpName || '',
                                item.Empcode || '',
                                item.RoleName || '',
                                buViewHtml,
                                subBuViewHtml,
                                item.AssignDate || '',
                                '<span class="' + statusClass + '">' + statusText + '</span>',
                                actionHtml
                            ]);
                        }
                        table.draw();
                        $('.tooltips').tooltip();
                    } else {
                        table.draw();
                        $("#tableResponsive").hide();
                        $("#NotificationGrid-empty").show();
                    }
                },
                error: function (jqXHR) {
                    if (jqXHR.status == 401) { window.location.href = "/PayTime/LoginPage"; }
                    else { toastr.error("Failed to load BU Head data."); }
                },
                complete: function () { $(".loading").hide(); }
            });
        }

        // 5.2 Role Get All
        function RoleGetAll(roleId) {
            $('#ddlRoleID').empty();
            $('#ddlRoleAasign').empty();
            $('#ddlRoleEdit').empty();
            var rId = roleId || 0;
            $.ajax({
                type: "GET",
                url: _webapiurl + 'Master/RoleMasterGetAllBU',
                headers: { 'Authorization': _tokan },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                beforeSend: function () { $(".loading").show(); },
                success: function (response) {
                    if (response.isRedirect) { window.location.href = response.redirectUrl; }
                    if (response != null) {
                        $("#ddlRoleID").append("<option value='0' selected>Select Role</option>");
                        $("#ddlRoleAasign").append("<option value='0' selected>Select Role</option>");
                        $("#ddlRoleEdit").append("<option value='0' selected>Select Role</option>");

                        response.sort(function (a, b) { return a.RoleName.localeCompare(b.RoleName); });

                        for (var i = 0; i < response.length; i++) {
                            if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806) {
                                if (_RoleId == 6805) {
                                    if (response[i].RoleId != 1 && response[i].RoleId != 6807 && response[i].RoleId != 6805) {
                                        if (response[i].RoleId != 6000) {
                                            $("#ddlRoleID").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                            $("#ddlRoleAasign").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                            $("#ddlRoleEdit").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                        }
                                    }
                                }
                                else if (_RoleId == 6806) {
                                    if (response[i].RoleId != 1 && response[i].RoleId != 6807 && response[i].RoleId != 6806) {
                                        if (response[i].RoleId != 6000) {
                                            $("#ddlRoleID").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                            $("#ddlRoleAasign").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                            $("#ddlRoleEdit").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                        }
                                    }
                                }
                                else {
                                    if (response[i].RoleId != 1) {
                                        if (response[i].RoleId != 6000) {
                                            $("#ddlRoleID").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                            $("#ddlRoleAasign").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                            $("#ddlRoleEdit").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                        }
                                    }
                                }
                            }
                            else {
                                if (response[i].RoleId == _RoleId) {
                                    if (response[i].RoleId != 6000) {
                                        $("#ddlRoleID").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                        $("#ddlRoleAasign").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                        $("#ddlRoleEdit").append("<option value='" + response[i].RoleId + "'>" + response[i].RoleName + "</option>");
                                    }
                                }
                            }
                        }
                    }
                    if (rId != null && rId != 0) {
                        $("#ddlRoleID option[value ='" + rId + "']").prop('selected', true);
                        $('#ddlRoleID').trigger('change.select2');
                        $("#ddlRoleAasign option[value ='" + rId + "']").prop('selected', true);
                        $('#ddlRoleAasign').trigger('change.select2');
                    }
                    $(".loading").hide();
                },
                error: function () { $(".loading").hide(); }
            });
        }

        // 5.3 Load Employee List by Role ID
        function LoadEmployeeByRole(roleId, targetSelector) {
            $(targetSelector).empty();
            $(targetSelector).append('<option value="0" selected>Select Employee</option>');
            $.ajax({
                type: "POST",
                url: _webapiurl + 'Master/EmployeeGetAllBU?roleid=' + roleId + '&loginempid=' + _loginEmpId,
                headers: { 'Authorization': _tokan },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () { $(".loading").show(); },
                success: function (response) {
                    if (response != null && response.length > 0) {
                        response.sort(function (a, b) { return a.EmpName.localeCompare(b.EmpName); });
                        for (var i = 0; i < response.length; i++) {
                            $(targetSelector).append('<option value="' + response[i].EmpId + '">' + response[i].EmpName + ' (' + response[i].Empcode + ')' + '</option>');
                        }
                    }
                },
                error: function (jqXHR) {
                    if (jqXHR.status == 401) { window.location.href = "/PayTime/LoginPage"; }
                    else { toastr.error("Failed to load Employee list."); }
                },
                complete: function () { $(".loading").hide(); }
            });
        }

        // 5.4 Load BU List
        function LoadBUList() {
            $('#BuID_Modal').empty();
            $('#ddlBuID').empty();
            $('#BuID_Edit').empty();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': _tokan },
                url: _webapiurl + 'Master/BUGetAll',
                success: function (response) {
                    let options = "";
                    (response || []).filter(x => x.IsActive == 1)
                        .forEach(x => { options += `<option value="${x.BUId}">${x.BUName}</option>`; });
                    $("#BuID_Modal").html(options).multiselect('rebuild');
                    $("#ddlBuID").html(options).multiselect('rebuild');
                    $("#BuID_Edit").html(options).multiselect('rebuild');
                },
                error: function () { toastr.error("Failed to load BU list."); }
            });
        }

        // 5.5 Load Sub BU List by Selected BU IDs
        function LoadSubBUListByBU(buIds, targetSelector) {
            $(targetSelector).empty();
            var selectedBU = (buIds || []).filter(x => x != '0');
            if (!selectedBU || selectedBU.length === 0) {
                $(targetSelector).html("<option value='0'>Select Sub Business Unit</option>").multiselect('rebuild');
                return;
            }
            $.ajax({
                type: "POST",
                headers: { 'Authorization': _tokan },
                url: _webapiurl + "Master/SubBUDropdown_multiselect",
                contentType: "application/json",
                data: JSON.stringify(selectedBU),
                success: function (response) {
                    let options = "";
                    if (!response || response.length === 0) {
                        options = "<option value='0'>Select Sub Business Unit</option>";
                    } else {
                        $.each(response, function (i, subbu) {
                            options += `<option value="${subbu.SubBUId}">${subbu.SubBUName}</option>`;
                        });
                    }
                    $(targetSelector).html(options).multiselect('rebuild');
                },
                error: function () { toastr.error("Failed to load Sub BU list."); }
            });
        }

        // 5.6 BU Head Status Change (Active/Inactive)
        function BUHeadStatusChange(buHeadId, isActive) {
            $.ajax({
                type: "POST",
                url: _webapiurl + 'Master/BUHeadStatusChange',
                headers: { 'Authorization': _tokan },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify({ BUHeadId: buHeadId, IsActive: isActive, CreatedBy: parseInt(_loginEmpId) }),
                beforeSend: function () { $(".loading").show(); },
                success: function (response) {
                    if (response.isRedirect) { window.location.href = response.redirectUrl; }
                    if (response != null && response.Status == true) {
                        toastr.success(response.Message || (isActive ? "Activated successfully." : "Deactivated successfully."));
                        LoadBUHeadData();
                    } else {
                        toastr.error(response.Message || "Failed to change status.");
                    }
                },
                error: function (jqXHR) {
                    if (jqXHR.status == 401) { window.location.href = "/PayTime/LoginPage"; }
                    else { toastr.error("Something went wrong. Please try again."); }
                },
                complete: function () { $(".loading").hide(); }
            });
        }

        // ========== 6. Filter Panel Events ==========

        // Filter Toggle
        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Filter Close
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        // Filter Panel - Role Change
        $('#ddlRoleID').on('change', function () {
            var selectedRoleId = $(this).val();
            if (selectedRoleId != null && selectedRoleId != '0') {
                LoadEmployeeByRole(selectedRoleId, '#EmployeeID');
            } else {
                $('#EmployeeID').empty().append('<option value="0" selected>Select Employee</option>');
            }
        });

        // Filter Panel - BU Change
        $('#ddlBuID').on('change', function () {
            var selectedBuIds = $(this).val() || [];
            LoadSubBUListByBU(selectedBuIds, '#SubbuID');
        });

        // Filter Search Button
        $('#btnSearchFilter').on('click', function () {
            var filterData = {
                RoleId: parseInt($('#ddlRoleID').val()) || 0,
                EmpId: parseInt($('#EmployeeID').val()) || 0,
                BUIds: ($('#ddlBuID').val() || []).map(Number),
                SubBUIds: ($('#SubbuID').val() || []).map(Number)
            };
            LoadBUHeadData(filterData);
        });

        // Filter Clear Button
        $('#btnClearFilter').on('click', function () {
            $('#ddlRoleID').val('0').trigger('change.select2');
            $('#EmployeeID').empty().append('<option value="0" selected>Select Employee</option>');
            $('#ddlBuID').multiselect('deselectAll', false).multiselect('updateButtonText');
            $('#SubbuID').multiselect('deselectAll', false).multiselect('updateButtonText');
            LoadBUHeadData();
        });

        // ========== 7. Assign Modal Events ==========

        // Assign Button Open Modal
        $("#Assign_Btn").on('click', function () {
            $("#Assign_Btn").attr("data-toggle", "modal");
            $("#Assign_Btn").attr("data-target", "#Assign_modal");
        });

        // Assign Modal - Role Change
        $('#ddlRoleAasign').on('change', function () {
            var selectedRoleId = $(this).val();
            if (selectedRoleId != null && selectedRoleId != '0') {
                LoadEmployeeByRole(selectedRoleId, '#EmployeeID_Modal');
            } else {
                $('#EmployeeID_Modal').empty().append('<option value="0" selected>Select Employee</option>');
            }
        });

        // Assign Modal - BU Change
        $('#BuID_Modal').on('change', function () {
            var selectedBuIds = $(this).val() || [];
            LoadSubBUListByBU(selectedBuIds, '#SubbuID_Modal');
        });

        // Assign Modal - Clear Button
        $('#clear_btn').on('click', function () {
            $('#ddlRoleAasign').val('0').trigger('change.select2');
            $('#EmployeeID_Modal').empty().append('<option value="0" selected>Select Employee</option>');
            $('#BuID_Modal').multiselect('deselectAll', false).multiselect('updateButtonText');
            $('#SubbuID_Modal').multiselect('deselectAll', false).multiselect('updateButtonText');
        });

        // Assign Modal - Save Button
        $('#AssignBtn').on('click', function () {
            var roleId = $('#ddlRoleAasign').val();
            var empId = $('#EmployeeID_Modal').val();
            var buIds = $('#BuID_Modal').val() || [];
            var subBuIds = $('#SubbuID_Modal').val() || [];

            if (roleId == null || roleId == '0') { toastr.warning("Please select Role."); return false; }
            if (empId == null || empId == '0') { toastr.warning("Please select Employee."); return false; }
            if (buIds.length == 0) { toastr.warning("Please select at least one BU."); return false; }

            var assignData = {
                RoleId: parseInt(roleId), EmpId: parseInt(empId),
                BUIds: buIds.map(Number), SubBUIds: subBuIds.length > 0 ? subBuIds.map(Number) : [0],
                CreatedBy: parseInt(_loginEmpId)
            };

            $.ajax({
                type: "POST",
                url: _webapiurl + 'Master/BUHeadAssign',
                headers: { 'Authorization': _tokan },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(assignData),
                beforeSend: function () { $(".loading").show(); },
                success: function (response) {
                    if (response.isRedirect) { window.location.href = response.redirectUrl; }
                    if (response != null && response.Status == true) {
                        toastr.success(response.Message || "BU & Sub BU assigned successfully.");
                        $('#Assign_modal').modal('hide');
                        $('#ddlRoleAasign').val('0').trigger('change');
                        $('#EmployeeID_Modal').empty().append('<option value="0" selected>Select Employee</option>');
                        $('#BuID_Modal').multiselect('deselectAll', false).multiselect('updateButtonText');
                        $('#SubbuID_Modal').multiselect('deselectAll', false).multiselect('updateButtonText');
                        LoadBUHeadData();
                    } else {
                        toastr.error(response.Message || "Failed to assign BU details.");
                    }
                },
                error: function (jqXHR) {
                    if (jqXHR.status == 401) { window.location.href = "/PayTime/LoginPage"; }
                    else { toastr.error("Something went wrong. Please try again."); }
                },
                complete: function () { $(".loading").hide(); }
            });
        });

        // ========== 8. Edit Modal Events ==========

        // Edit Button Click
        $(document).on('click', '.btnEdit', function () {
            var buHeadId = $(this).data('id');
            var roleId = $(this).data('roleid');
            var empId = $(this).data('empid');
            var buIds = ($(this).data('buids') || '').toString().split(',').filter(function (x) { return x.trim() !== '' && x.trim() !== '0'; });
            var subBuIds = ($(this).data('subbuids') || '').toString().split(',').filter(function (x) { return x.trim() !== '' && x.trim() !== '0'; });

            $('#EditBUHeadId').val(buHeadId);
            $('#ddlRoleEdit').val(roleId).trigger('change.select2');

            // Load Employee dropdown and select
            if (roleId != null && roleId != '0') {
                $('#EmployeeID_Edit').empty().append('<option value="0" selected>Select Employee</option>');
                $.ajax({
                    type: "POST",
                    url: _webapiurl + 'Master/EmployeeGetAllBU?roleid=' + roleId + '&loginempid=' + _loginEmpId,
                    headers: { 'Authorization': _tokan },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        if (response != null && response.length > 0) {
                            response.sort(function (a, b) { return a.EmpName.localeCompare(b.EmpName); });
                            for (var i = 0; i < response.length; i++) {
                                $('#EmployeeID_Edit').append('<option value="' + response[i].EmpId + '">' + response[i].EmpName + ' (' + response[i].Empcode + ')' + '</option>');
                            }
                            $('#EmployeeID_Edit').val(empId).trigger('change.select2');
                        }
                    }
                });
            }

            // Set BU multiselect
            $('#BuID_Edit').multiselect('deselectAll', false);
            for (var i = 0; i < buIds.length; i++) { $('#BuID_Edit').multiselect('select', buIds[i].trim()); }

            // Load SubBU and select
            if (buIds.length > 0) {
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': _tokan },
                    url: _webapiurl + "Master/SubBUDropdown_multiselect",
                    contentType: "application/json",
                    data: JSON.stringify(buIds),
                    success: function (response) {
                        var options = "";
                        if (response && response.length > 0) {
                            $.each(response, function (i, subbu) {
                                options += '<option value="' + subbu.SubBUId + '">' + subbu.SubBUName + '</option>';
                            });
                        }
                        $('#SubbuID_Edit').html(options).multiselect('rebuild');
                        for (var j = 0; j < subBuIds.length; j++) { $('#SubbuID_Edit').multiselect('select', subBuIds[j].trim()); }
                    }
                });
            }

            $('#Edit_modal').modal('show');
        });

        // Edit Modal - Role Change
        $('#ddlRoleEdit').on('change', function () {
            var selectedRoleId = $(this).val();
            if (selectedRoleId != null && selectedRoleId != '0') {
                LoadEmployeeByRole(selectedRoleId, '#EmployeeID_Edit');
            } else {
                $('#EmployeeID_Edit').empty().append('<option value="0" selected>Select Employee</option>');
            }
        });

        // Edit Modal - BU Change
        $('#BuID_Edit').on('change', function () {
            var selectedBuIds = $(this).val() || [];
            LoadSubBUListByBU(selectedBuIds, '#SubbuID_Edit');
        });

        // Edit Modal - Update Button
        $('#UpdateBtn').on('click', function () {
            var buHeadId = $('#EditBUHeadId').val();
            var roleId = $('#ddlRoleEdit').val();
            var empId = $('#EmployeeID_Edit').val();
            var buIds = $('#BuID_Edit').val() || [];
            var subBuIds = $('#SubbuID_Edit').val() || [];

            if (roleId == null || roleId == '0') { toastr.warning("Please select Role."); return false; }
            if (empId == null || empId == '0') { toastr.warning("Please select Employee."); return false; }
            if (buIds.length == 0) { toastr.warning("Please select at least one BU."); return false; }

            var updateData = {
                BUHeadId: parseInt(buHeadId), RoleId: parseInt(roleId), EmpId: parseInt(empId),
                BUIds: buIds.map(Number), SubBUIds: subBuIds.length > 0 ? subBuIds.map(Number) : [0],
                CreatedBy: parseInt(_loginEmpId)
            };

            $.ajax({
                type: "POST",
                url: _webapiurl + 'Master/BUHeadAssign',
                headers: { 'Authorization': _tokan },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(updateData),
                beforeSend: function () { $(".loading").show(); },
                success: function (response) {
                    if (response.isRedirect) { window.location.href = response.redirectUrl; }
                    if (response != null && response.Status == true) {
                        toastr.success(response.Message || "BU Head updated successfully.");
                        $('#Edit_modal').modal('hide');
                        LoadBUHeadData();
                    } else {
                        toastr.error(response.Message || "Failed to update BU Head.");
                    }
                },
                error: function (jqXHR) {
                    if (jqXHR.status == 401) { window.location.href = "/PayTime/LoginPage"; }
                    else { toastr.error("Something went wrong. Please try again."); }
                },
                complete: function () { $(".loading").hide(); }
            });
        });

        // ========== 9. Table Action Button Events ==========

        // Active Button
        $(document).on('click', '.btnActive', function () {
            var buHeadId = $(this).data('id');
            var empName = $(this).data('empname');
            Swal.fire({
                title: `<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_info.svg' alt=''> Activate BU`,                
                html: '<div class="swal_subtitle"><p>Are you sure you want to activate BU Head for <strong>"' + empName + '"</strong>?</p></div>',
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No, Cancel',
                confirmButtonText: 'Yes, Continue',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    BUHeadStatusChange(buHeadId, true);
                } else {
                    return false;
                }
            });            
        });

        // Inactive Button
        $(document).on('click', '.btnInactive', function () {
            var buHeadId = $(this).data('id');
            var empName = $(this).data('empname');
            Swal.fire({
                title: `<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_info.svg' alt=''> Deactivate BU`,
                html: '<div class="swal_subtitle"><p>Are you sure you want to deactivate BU Head for <strong>"' + empName + '"</strong>?</p></div>',
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No, Cancel',
                confirmButtonText: 'Yes, Continue',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    BUHeadStatusChange(buHeadId, false);
                } else {
                    return false;
                }
            });
        });

        // ========== 10. ViewAll Modal Events ==========

        // BU ViewAll Click
        $(document).on('click', '.Bu_viewall', function () {
            var buNames = decodeURIComponent($(this).data('bunames') || '');
            var buList = buNames.split(',').filter(function (x) { return x.trim() !== ''; });
            var listHtml = '';
            for (var i = 0; i < buList.length; i++) {
                listHtml += '<li><span class="bu-dot"></span><span class="bu-text">' + buList[i].trim() + '</span></li>';
            }
            listHtml += '<li class="no-result"><i class="fa-light fa-face-thinking"></i> No BU found</li>';
            $('#buViewAllList').html(listHtml);
            $('#buListCount').text(buList.length + ' Found');
            $('#buSearchInput').val('');
            if (buList.length === 0) { $('#buViewAllList .no-result').show(); }
            $('#Bu_viewall_modal').modal('show');
        });

        // SubBU ViewAll Click
        $(document).on('click', '.SubBu_viewall', function () {
            var subBuNames = decodeURIComponent($(this).data('subbunames') || '');
            var subBuList = subBuNames.split(',').filter(function (x) { return x.trim() !== ''; });
            var listHtml = '';
            for (var i = 0; i < subBuList.length; i++) {
                listHtml += '<li><span class="bu-dot"></span><span class="bu-text">' + subBuList[i].trim() + '</span></li>';
            }
            listHtml += '<li class="no-result"><i class="fa-light fa-face-thinking"></i> No Sub BU found</li>';
            $('#subBuViewAllList').html(listHtml);
            $('#subBuListCount').text(subBuList.length + ' Found');
            $('#subBuSearchInput').val('');
            if (subBuList.length === 0) { $('#subBuViewAllList .no-result').show(); }
            $('#SubBu_viewall_modal').modal('show');
        });

    });

    // ========== 11. ViewAll Modal Search Functions ==========
    function filterBuList() {
        var filter = $("#buSearchInput").val().toUpperCase();
        var items = $("#buViewAllList li:not(.no-result)");
        var visibleCount = 0;
        items.each(function () {
            var text = $(this).find(".bu-text").text().toUpperCase();
            if (text.indexOf(filter) > -1) { $(this).show(); visibleCount++; }
            else { $(this).hide(); }
        });
        $("#buListCount").text(visibleCount + " Found");
        if (visibleCount === 0) { $("#buViewAllList .no-result").show(); }
        else { $("#buViewAllList .no-result").hide(); }
    }

    function filterSubBuList() {
        var filter = $("#subBuSearchInput").val().toUpperCase();
        var items = $("#subBuViewAllList li:not(.no-result)");
        var visibleCount = 0;
        items.each(function () {
            var text = $(this).find(".bu-text").text().toUpperCase();
            if (text.indexOf(filter) > -1) { $(this).show(); visibleCount++; }
            else { $(this).hide(); }
        });
        $("#subBuListCount").text(visibleCount + " Found");
        if (visibleCount === 0) { $("#subBuViewAllList .no-result").show(); }
        else { $("#subBuViewAllList .no-result").hide(); }
    }

    // ========== 12. Custom Confirm Popup ==========
    function showConfirm(options) {
        var iconHtml = '';
        if (options.icon === 'warning') {
            iconHtml = '<i class="fa-light fa-triangle-exclamation"></i>';
            $('#confirmIcon').removeClass('success').addClass('warning');
        } else if (options.icon === 'success') {
            iconHtml = '<i class="fa-light fa-circle-check"></i>';
            $('#confirmIcon').removeClass('warning').addClass('success');
        }
        $('#confirmIcon').html(iconHtml);
        $('#confirmTitle').text(options.title || 'Are you sure?');
        $('#confirmMessage').html(options.message || '');
        $('#confirmYes').text(options.btnText || 'Yes, Confirm');
        $('#confirmYes').removeClass('yes danger').addClass(options.btnClass || 'yes');

        $('#confirmModal').modal('show');

        $('#confirmYes').off('click').on('click', function () {
            $('#confirmModal').modal('hide');
            if (typeof options.onConfirm === 'function') { options.onConfirm(); }
        });

        $('#confirmNo').off('click').on('click', function () {
            $('#confirmModal').modal('hide');
        });
    }
</script>

