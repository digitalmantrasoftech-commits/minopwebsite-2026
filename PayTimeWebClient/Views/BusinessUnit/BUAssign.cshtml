        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0 auto;
    }

    #confirmModal .modal-content {
        border: none;
        border-radius: 12px !important;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        padding: 30px 28px 24px;
        width: 380px;
        max-width: 90vw;
        text-align: center;
    }

    .confirm-icon {
        width: 56px;
        height: 56px;
        border-radius: 50% !important;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-size: 24px;
    }

    .confirm-icon.warning {
        background: #fff3e0;
        color: #e65100;
    }

    .confirm-icon.success {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .confirm-title {
        font-size: 17px;
        font-weight: 600;
        color: #1a1a2e;
        margin-bottom: 8px;
    }

    .confirm-message {
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 24px;
        line-height: 1.5;
    }

    .confirm-buttons {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .confirm-btn {
        padding: 9px 28px;
        border-radius: 8px !important;
        font-size: 13px;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .confirm-btn.cancel {
        background: #f3f4f6;
