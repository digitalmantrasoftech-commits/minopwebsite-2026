        }

        .viewall-bu-list li {
            padding: 10px 16px;
            font-size: 13px;
            color: #3b4a5a;
            border-bottom: 1px solid #f2f3f5;
            transition: all 0.2s ease;
            cursor: default;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .viewall-bu-list li:last-child {
                border-bottom: none;
