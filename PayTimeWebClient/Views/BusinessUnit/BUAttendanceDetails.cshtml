<script src="~/AssetsNew/js/introjs.js"></script>
<script>
    var uniqueid = '@_EmpId';
    var UserId1 = '@_UserId';
    document.addEventListener('DOMContentLoaded', (event) => {
        const tourState = sessionStorage.getItem('introJsState');

        if (tourState === 'Holiday') {
            const waitForElement = setInterval(() => {
                const headerElement = document.querySelector('#element_dataTables_tbl_header');


                if (headerElement && headerElement.offsetHeight > 0 && headerElement.offsetWidth > 0) {
                    clearInterval(waitForElement);

                    introJs().setOptions({
                        steps: [
                            {
                                title: "Enhanced Data View",
                                element: headerElement,
                                intro: `<div class='wel_icon text-center'><img src='/assets/images/tour/Gridshow.gif' height='211' width='430' style='border: 1px solid #b5b5b5; border-radius: 6px !important;'><p class='header'>All-in-One. Effortless. Efficient.</p></div>Access all table features in a single view—no more switching pages. Work faster with improved functionality and a seamless experience.`,
                            },
                            {
                                title: "Feedback",
                                element: document.querySelector("#tour-feedback-anchor"),
                                intro: "<div class='feedback-container'><h2>Thank You for Exploring!</h2> <p>We value your input—share your thoughts on the new feature below.</p> <div class='emoji-row'> <div class='emoji tooltips' id='emoji_1' data-placement='top' data-original-title='Angry'> <img src='/assets/images/tour/emoji_1.svg' alt='Angry'> </div> <div class='emoji tooltips'  id='emoji_2'  data-placement='top' data-original-title='Sad'> <img src='/assets/images/tour/emoji_2.svg' alt='Sad'> </div> <div class='emoji tooltips'  id='emoji_3'  data-placement='top' data-original-title='Neutral'> <img src='/assets/images/tour/emoji_3.svg' alt='Neutral'> </div> <div class='emoji tooltips'  id='emoji_4'  data-placement='top' data-original-title='Happy'> <img src='/assets/images/tour/emoji_4.svg' alt='Happy'> </div> <div class='emoji tooltips'  id='emoji_5'  data-placement='top' data-original-title='Awesome'> <img src='/assets/images/tour/emoji_5.svg' alt='Awesome'> </div> </div> <p>Your feedback helps us improve.</p><textarea placeholder='Share your thoughts...' id ='Comment' maxlength='100'></textarea><p id='SpecialChar' style='display: none; color: red; margin-top:0; font-size: 10px; margin-bottom:6px;'>*Error: Special characters are not allowed in the comment!</p><p id='Validation' style='display: none; color: red; margin-top:0;font-size: 10px;'>*Please provide your rating to help us improve your experience!</p> <div class='buttons'> <button class='submit-btn' id='btnSubmit'>Submit Feedback</button> </div></div>",
                                showButtons: false
                            }
                        ],
                        doneLabel: " ",
                        exitOnOverlayClick: false,
                        exitOnEsc: false,
                        keyboardNavigation: false,

                    }).onchange(function (targetElement) {
                        setTimeout(() => {
                            $('.tooltips').tooltip();
                        }, 500);

                        if (this._currentStep === 1) {
                            rating = 0;
                            $('.emoji').removeClass('active');
                            $('#Comment').val('');
                            $('#Validation').hide();
                            $("#SpecialChar").hide();
                        }
                    }).oncomplete(function () {
                        GetFeedback();
                        updateTourFlag();
                    }).start();
                }
            }, 100); // Checks every 100ms for element and visibility
        }
    });



        $('body').on('click', '#emoji_1', function () {
            rating = 1;
        });
        $('body').on('click', '#emoji_2', function () {
            rating = 2;
        });
        $('body').on('click', '#emoji_3', function () {
            rating = 3;
        });
        $('body').on('click', '#emoji_4', function () {
            rating = 4;
        });
        $('body').on('click', '#emoji_5', function () {
            rating = 5;
        });
        $('body').on('click', '#btnSubmit', function () {
            GetFeedback();



        });
        $('body').on('click', '.emoji', function () {
            $('.emoji').removeClass('active');
            $(this).addClass('active');
        });


        function GetFeedback() {

            let title = 'Menu Reformation';
            let Ratings = rating;
            let comments = $("#Comment").val();
            let specialCharPattern = /[!`'#$%^&*()?":{}|<>]/;
            function validation() {

                let isValid = true;

                if (rating == 0) {
                    $('#Validation').show();
                    isValid = false;
                } else {
                    $('#Validation').hide();
                }

                if (specialCharPattern.test(comments)) {
                    $("#SpecialChar").show();
                    isValid = false;
                } else {
                    $("#SpecialChar").hide();
                }

                return isValid;
            }
                if (validation()) {
                $.ajax({
                    url: '@_webapiurl' + 'Master/TourFeedBack',
                    headers: { 'Authorization': '@_tokan' },
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        title: title,
                        UserId: '@_UserId',
                        rating: Ratings,
                        comments: comments
                    }),
                    success: function (response) {
                        if (response.MegSts == null) {
                            console.log("Your Feedback saved successfully");

                        } else {
                            console.error("Error during save feedback.");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error during API call:', error);
                    }
                });
                updateTourFlag();
            }


        }
        function updateTourFlag() {

            $.ajax({
                url: '@_webapiurl' + 'Master/UpdateTourFlag',
                headers: { 'Authorization': '@_tokan' },
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    EmpId: '@_EmpId',
                    UserId: '@_UserId',
                    RoleId:'@_RoleId',
                    HasTourCompletes: false
                }),
                success: function (response) {
                    introJs().exit();
                    Swal.fire({
                        html: '<div class="swal_subtitle"><b>Thank you.!</b><p>We Saved Your Valuable Feedback. </p></div>',
                        title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Success",
                        closeOnConfirm: true,
                        showCloseButton: true,
                        showCancelButton: false,
                        focusConfirm: false,
                        cancelButtonText: 'No',
                        confirmButtonText: 'Done',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        customClass: {
                            confirmButton: 'swal-confirm-button-class',
                            cancelButton: 'swal-cancel-button-class'
                        }
                    });
                    $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');

                    if (response.MegSts == null) {
                        console.log("Tour flag updated successfully.");
                        sessionStorage.removeItem('introJsState');
                        sessionStorage.setItem('hasTourCompleted_' + uniqueid + '_' + UserId1, 'False');
                    } else {
                        console.error("Error updating tour flag.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error during API call:', error);
                }
            });
        }


</script>
