        $("#tblAttndancelist").on('click', '.ChangeReq', function () {

            var datetime = new Date();
            var hours = datetime.getHours(); //returns 0-23
            var minutes = datetime.getMinutes(); //returns 0-59
            if (minutes < 10)
                minutesString = 0 + "" + minutes + ""; //+""casts minutes to a string.
            else
                minutesString = minutes;

            //var Enpid = jQuery(this).closest('tr').attr('ID');
            var Enpid = tblAttndancelist.row($(this).parent('td').parent('tr')).data()["EmpID"]
            //tblAttndancelist
            var currentRow = $(this).closest("tr");

            $("#fromdate").val(currentRow.find("td:eq(0)").text());
            var _InTime = currentRow.find("td:eq(3)").text();
            if (_InTime == "" || _InTime == null || _InTime == "00:00") {
                $("#InPunchTime").val(hours + ":" + minutesString);
            }
            else {
                $("#InPunchTime").val(_InTime.substring(0, _InTime.length - 3));
            }
            var _OutTime = currentRow.find("td:eq(4)").text();
            if (_OutTime == "" || _OutTime == null || _OutTime == '<span style="color: red;">MISS PUNCH</span>' || _OutTime == 'MISS PUNCH' || _OutTime == "00:00") {
                $("#OutPunchTime").val(hours + ":" + minutesString);
            }
            else {
                $("#OutPunchTime").val(_OutTime.substring(0, _OutTime.length - 3));
            }

            $("#EmpID").val(Enpid);
            // ISflageNight = 1 night shift
            $("#isNight").val(currentRow.find("td:eq(9)").text());

            $("#ApplyReason").val('');

            $(".ChangeReq").attr("data-toggle", "modal");
            $(".ChangeReq").attr("data-target", "#frmpopup");

        });
        $("#Clear_OPration").click(function () {
            $("#Select_month").val('0');
            $("#Select_year").val('0');
            $("#Select_status").val('0');
            // Select all BUs and reload SubBU + employees
            $('#Select_BU').multiselect('selectAll', false);
            $('#Select_BU').multiselect('updateButtonText');
            selectedBUId = getSelectedBUIds();
            // Clear SubBU
            $('#Select_SubBU').empty();
            $('#Select_SubBU').multiselect('rebuild');
            var msSubBU = $('#Select_SubBU').data('multiselect');
            if (msSubBU) {
                msSubBU.options.onChange = function (option, checked) { onSubBUSelectionChange(); };
                msSubBU.options.onSelectAll = function () { onSubBUSelectionChange(); };
                msSubBU.options.onDeselectAll = function () { onSubBUSelectionChange(); };
