        function generateExcelFile() {
            selectedBUId = getSelectedBUIds();
            var totalOptions = $('#Select_Employee option').length;
            var selectedOptions = $('#Select_Employee :selected').length;
            var _arrstatus = '0';
            var _status = $("#Select_status").val();
            if (_status == "" || _status == null) {
                _status = '0';
            }
            var _arrEmployee = ['0'];
            var _Employee = $("#Select_Employee").val();

            if (('@_RoleId' == '1') || ('@_RoleId' == '6806') || ('@_RoleId' == '6805')) {

                if (selectedOptions === totalOptions) {
                    _Employee = ['0'];
                } else {

                    if (_Employee === "" || _Employee === null) {
                        _Employee = ['0'];
                    } else {
                        _Employee = _Employee;
                    }
                }
            } else {
                if (_Employee === "" || _Employee === null) {
                    _Employee = ['0'];
                } else {
                    _Employee = _Employee;
                }
            }
            _arrEmployee = _Employee.join(",");
            let isSelectedAll = $("#Select_EmployeeContainer li").hasClass("multiselect-item multiselect-all active") == true ? 1 : 0;

            let searchTerm = "";
            if ($("#Select_EmployeeContainer li input").hasClass("multiselect-search")) {
                searchTerm = $("#Select_EmployeeContainer li .multiselect-search").val().trim();
                if (isSelectedAll == 1 && searchTerm.length > 0) _arrEmployee = "";
            }
            var Employeeid = _arrEmployee;
            _arrstatus = _status;


            $.ajax({
                type: "POST",
                url: "/BusinessUnit/GetAttendanceDetailsBU",
                data: {
                    BUId: selectedBUId,
                    loginemployeeid: pkloginemployeeid,
                    Month: $("#Select_month").val(),
                    Year: $("#Select_year").val(),
                    status: _arrstatus,
                    Employee: Employeeid,
                    SelectAll: isSelectedAll,
                    SelectAllSearchTerm: searchTerm
                },
                headers: { 'Authorization': '@_tokan' },
                dataType: "json",
                success: function (data) {


                    if (typeof data === "string") {
                        try {
                            data = JSON.parse(data);
                        } catch (error) {
                            toastr.error("No entry! This is a restricted area.");
                            window.setTimeout(function () {
                                window.location.href = "/PayTime/LoginPage";
                            }, 2000);
                            $(".loading1").hide();
                            return;
                        }
                    }

                    if (!Array.isArray(data)) {
                        toastr.error("Unexpected data format received.");
                        $("#Export2").prop('disabled', false);
                        $(".loading1").hide();
                        return;
                    }

                    if (data.length === 0) {
                        $(".loading1").hide();
                            toastr.error("Nothing to export. Try refining your search criteria.");
                            $("#Export2").prop('disabled', false);
                            $(".loading1").hide();
                            return;
                    } else if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                        $(".loading1").hide();
                    } else {
                        try {
                            function stripHtmlTags(input) {
                                if (typeof input === 'string') {
                                    return input.replace(/<[^>]+>/g, '').trim();
                                }
                                return input;
                            }

                            const formattedData = data.map(item => ({
                                Date: item.Att_dt,
                                Shift: item.Shift,
                                Name: item.EmpName,
                                EmpCode: item.Empcode,
                                'In Time':  item.InTime || '00:00',
                                'Out Time': stripHtmlTags(item.OutTime) || '00:00',
                                'Total Hrs': stripHtmlTags(item.TotHour) || '00:00',
                                OTHour: item.OTHr || '00:00',
                                Status: item.Status,
                                Day: item.Day,
                                Branch: item.Branchname,
                                Department: item.Departmentname
                            }));


                            var worksheet = XLSX.utils.json_to_sheet(formattedData);
                            var workbook = XLSX.utils.book_new();
                            XLSX.utils.book_append_sheet(workbook, worksheet, "AttendanceDetails");


                            XLSX.writeFile(workbook, 'AttendanceDetails.xlsx');
                            $("#Export2").prop('disabled', false);

                            $(".loading1").hide();
                        } catch (error) {
                            toastr.error("Error in processing the data.");
                            $("#Export2").prop('disabled', false);
                            $(".loading1").hide();
                        }
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {

                    $(".loading1").hide();
                    swal(thrownError + ' - GetAttendanceDetails');
                    $("#Export2").prop('disabled', false);
                }
            });
        }

