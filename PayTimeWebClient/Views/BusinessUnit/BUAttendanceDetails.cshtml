    $(document).ready(function () {
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        //var $SelectEmployee = $("#Select_Employee").multiselect({
        //    selectAllValue: 'multiselect-all',
        //    enableCaseInsensitiveFiltering: true,
        //    includeSelectAllOption: true,
        //    allSelectedText: 'All Select',
        //    enableFiltering: true,
        //    maxHeight: '300',
        //    buttonWidth: '100%',
        //    enableClickableOptGroups: true,
        //    nonSelectedText: 'Select Employee',
        //});
            var selectedBUId = "0";
            var $SelectBU = null;
            var $SelectEmployee = null;

            // Function to reload SubBU and employees when BU selection changes
            function onBUSelectionChange() {
                selectedBUId = getSelectedBUIds();
                loadSubBU();
                if (selectedBUId && selectedBUId != "") {
                    loadEmployeesByBU();
                } else {
                    $("#Select_Employee").empty();
                    $('#Select_Employee').multiselect('rebuild');
                }
            }

            // Function to reload employees when SubBU selection changes
            function onSubBUSelectionChange() {
                loadEmployeesByBU();
            }

            // Load Sub BU dropdown based on selected BU IDs
            function loadSubBU() {
                var selectedBUs = $("#Select_BU").val() || [];
                if (selectedBUs.length === 0) {
                    $('#Select_SubBU').empty();
                    $('#Select_SubBU').multiselect('rebuild');
                    var msSubBU = $('#Select_SubBU').data('multiselect');
                    if (msSubBU) {
                        msSubBU.options.onChange = function (option, checked) { onSubBUSelectionChange(); };
                        msSubBU.options.onSelectAll = function () { onSubBUSelectionChange(); };
                        msSubBU.options.onDeselectAll = function () { onSubBUSelectionChange(); };
                    }
                    return;
                }
                $.ajax({
                    type: "POST",
                    url: '@_webapiurl' + "Master/SubBUDropdown_multiselect",
                    data: JSON.stringify(selectedBUs),
                    contentType: "application/json; charset=utf-8",
                    headers: { 'Authorization': '@_tokan' },
                    dataType: "json",
                    success: function (response) {
                        $("#Select_SubBU").empty();
                        if (response != null && response.length > 0) {
                            $.each(response, function (i, subbu) {
                                $("#Select_SubBU").append('<option value="' + subbu.SubBUId + '">' + subbu.SubBUName + '</option>');
                            });
                        }
                        $('#Select_SubBU').multiselect('rebuild');
                        var msSubBU = $('#Select_SubBU').data('multiselect');
                        if (msSubBU) {
                            msSubBU.options.onChange = function (option, checked) { onSubBUSelectionChange(); };
                            msSubBU.options.onSelectAll = function () { onSubBUSelectionChange(); };
                            msSubBU.options.onDeselectAll = function () { onSubBUSelectionChange(); };
                        }
                    },
                    error: function () {
                        toastr.error("Failed to load Sub BU list.");
                    }
                });
            }

            // Init BU multiselect upfront (empty) — same pattern that was working
            $SelectBU = $("#Select_BU").multiselect({
                selectAllValue: 'multiselect-all',
                enableCaseInsensitiveFiltering: true,
                includeSelectAllOption: true,
                allSelectedText: 'All Select',
                enableFiltering: true,
                maxHeight: '300',
                buttonWidth: '100%',
                enableClickableOptGroups: true,
                nonSelectedText: 'Select BU',
                onChange: function (option, checked) {
                    onBUSelectionChange();
                },
                onSelectAll: function () {
                    onBUSelectionChange();
                },
                onDeselectAll: function () {
                    onBUSelectionChange();
                }
            });

            // Init Sub BU multiselect upfront (empty)
            $("#Select_SubBU").multiselect({
                selectAllValue: 'multiselect-all',
                enableCaseInsensitiveFiltering: true,
                includeSelectAllOption: true,
                allSelectedText: 'All Select',
                enableFiltering: true,
                maxHeight: '300',
                buttonWidth: '100%',
                enableClickableOptGroups: true,
                nonSelectedText: 'Select Sub BU',
                onChange: function (option, checked) { onSubBUSelectionChange(); },
                onSelectAll: function () { onSubBUSelectionChange(); },
                onDeselectAll: function () { onSubBUSelectionChange(); }
            });

            // Init Employee multiselect upfront (empty)
            $SelectEmployee = $("#Select_Employee").multiselect({
                selectAllValue: 'multiselect-all',
                enableCaseInsensitiveFiltering: true,
                includeSelectAllOption: true,
                allSelectedText: 'All Select',
                enableFiltering: true,
                maxHeight: '300',
                buttonWidth: '100%',
                enableClickableOptGroups: true,
                nonSelectedText: 'Select Employee'
            });

            // Load assigned BUs on page load
            loadBUDropdown();

            function loadBUDropdown() {
                $.ajax({
                    type: "POST",
                    url: '@_webapiurl' + "BU/GetAssignedBUs",
                    data: JSON.stringify({ loginemployeeid: pkloginemployeeid, RoleID: emprole }),
                    contentType: "application/json; charset=utf-8",
                    headers: { 'Authorization': '@_tokan' },
                    dataType: "json",
                    success: function (response) {
                        if (typeof response === "string") {
                            try { response = JSON.parse(response); } catch (e) { response = null; }
                        }
                        var buList = null;
                        if (response != null) {
                            if (Array.isArray(response)) {
                                buList = response;
                            } else if (response.Table && Array.isArray(response.Table)) {
                                buList = response.Table;
                            } else if (response.data && Array.isArray(response.data)) {
                                buList = response.data;
                            }
                        }
                        if (buList != null && buList.length > 0) {
                            var buDropdown = $("#Select_BU");
                            buDropdown.empty();
                            for (var i = 0; i < buList.length; i++) {
                                buDropdown.append('<option value="' + buList[i].BUId + '">' + buList[i].BUName + '</option>');
                            }
                            // Rebuild to show new options (keeps multiselect clickable)
                            $('#Select_BU').multiselect('rebuild');
                            // Re-set onChange callbacks after rebuild (rebuild can lose them)
                            var msInstance = $('#Select_BU').data('multiselect');
                            if (msInstance) {
                                msInstance.options.onChange = function (option, checked) { onBUSelectionChange(); };
                                msInstance.options.onSelectAll = function () { onBUSelectionChange(); };
                                msInstance.options.onDeselectAll = function () { onBUSelectionChange(); };
                            }
                            // Auto-load grid with ALL assigned BU IDs on page load
                            var allBUIds = buList.map(function (b) { return b.BUId; }).join(",");
                            GetAttendenceSummary(allBUIds);
                        } else {
                            toastr.error("No BU assigned to your account.");
                        }
                    },
                    error: function () {
                        toastr.error("Failed to load BU list.");
                    }
                });
            }

            function getSelectedBUIds() {
                var selected = $("#Select_BU").val();
                if (selected == null || selected.length == 0) return "";
                return selected.join(",");
            }

            function loadEmployeesByBU() {
                var selectedBUs = $("#Select_BU").val() || [];
                // Save previously selected employees
                var prevSelectedEmps = $("#Select_Employee").val() || [];
                $("#Select_Employee").empty();
                $.ajax({
                    type: "POST",
                    url: '@_webapiurl' + "Master/GetEmployeesByBUAndSubBU",
                    data: JSON.stringify({ BUIds: selectedBUs, SubBUIds: $("#Select_SubBU").val() || [] }),
                    contentType: "application/json; charset=utf-8",
                    headers: { 'Authorization': '@_tokan' },
                    dataType: "json",
                    success: function (response) {
                        if (response != null && response.length > 0) {
                            for (var i = 0; i < response.length; i++) {
                                var isSelected = prevSelectedEmps.indexOf(response[i].EmpId.toString()) > -1;
                                $('#Select_Employee').append('<option value="' + response[i].EmpId + '"' + (isSelected ? ' selected' : '') + '>' + response[i].EmpName + ' (' + response[i].Empcode + ')</option>');
                            }
                        }
                        $('#Select_Employee').multiselect('rebuild');
                    },
                    error: function () {
                        toastr.error("Failed to load employees for selected BU.");
                    }
                });
            }
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Attendance Details";
