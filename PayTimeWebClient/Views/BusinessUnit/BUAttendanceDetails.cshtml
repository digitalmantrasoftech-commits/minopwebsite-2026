        function GetAttendenceSummary(buIdOverride) {
            if ($.fn.dataTable.isDataTable('#tblAttendanceSummary')) {
                $('#tblAttendanceSummary').DataTable().clear().destroy();
            }
            $("#tblAttndancelist").empty();

            $("#tblAttendanceSummary").show();


            var totalOptions = $('#Select_Employee option').length;
            var selectedOptions = $('#Select_Employee :selected').length;
            var _arrstatus = '0';
            var _status = $("#Select_status").val();
            if (_status == "" || _status == null) {
                _status = '0';
            }

            var _arrEmployee = ['0'];
            var _Employee = $("#Select_Employee").val();
            if (('@_RoleId' == '1') || ('@_RoleId' == '6806') || ('@_RoleId' == '6805')) {
                if (selectedOptions === totalOptions) {
                    _Employee = ['0'];
                } else {
                    if (_Employee === "" || _Employee === null) {
                        _Employee = ['0'];
                    } else {
                        _Employee = _Employee;
                    }
                }
            } else {
                if (_Employee === "" || _Employee === null) {
                    _Employee = ['0'];
                } else {
                    _Employee = _Employee;
                }
            }
            _arrEmployee = _Employee.join(",");
            let isSelectedAll = $("#Select_EmployeeContainer li").hasClass("multiselect-item multiselect-all active") == true ? 1 : 0;

            let searchTerm = "";
            if ($("#Select_EmployeeContainer li input").hasClass("multiselect-search")) {
                searchTerm = $("#Select_EmployeeContainer li .multiselect-search").val().trim();
                if (isSelectedAll == 1 && searchTerm.length > 0) _arrEmployee = "";
            }
            var Employeeid = _arrEmployee;
            _arrstatus = _status;

            // Use override (page load = all BUs) or read from dropdown (Search click)
            if (buIdOverride) {
                selectedBUId = buIdOverride;
            } else {
                selectedBUId = getSelectedBUIds();
                if (!selectedBUId || selectedBUId == "") {
                    toastr.error("Please select a BU first.");
                    return;
                }
            }

            $('#no_data').hide();
                var mainObj =
                {
                    BUId: selectedBUId,
                    loginemployeeid: pkloginemployeeid,
                    Month: $("#Select_month").val() == "0" ? (new Date().getMonth() + 1).toString() : $("#Select_month").val(),
                    Year: $("#Select_year").val() == "0" ? (new Date().getFullYear()).toString() : $("#Select_year").val(),
                    status: _arrstatus,
                    Employee: Employeeid,
                    SelectAll: isSelectedAll,
                    SelectAllSearchTerm: searchTerm,
                    DataGridValues: '@_DatagridThsold',
                    webapiurl : '@_webapiurl',
                    tokan: '@_tokan',
                    pageSize: "100",
                    page : "1"
            };
            LoadAttendanceDetialsGridData(mainObj);
    }

        $("#Search_OPration").click(function (event) {


            //$("#tblAttendanceSummary").show();
