        <div class="portlet">
            <div class="portlet-body">
                <!-- DataTable -->
                <div id="tblempty">
                    <div class="table-responsive" id="BUtableResponsive">
                        <table id="BUtblEmployee" class="new_datatbl table table-striped table-bordered tbl_middle table-hover order-column serch_datatable">
                            <thead>
                                <tr>
                                    <th style="min-width:160px;">EmpName</th>
                                    <th>Empcode</th>
                                    <th>EmpPunchID</th>
                                    <th>BU</th>
                                    <th>SubBU</th>
