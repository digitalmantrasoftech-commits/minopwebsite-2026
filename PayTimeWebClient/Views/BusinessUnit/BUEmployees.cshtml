            <a href="javascript:;" class="btn icon_transparent_btn margin-right-5 tooltips" id="Filter_search" data-placement="left" data-original-title="Filter" data-toggle="tooltip"><i class="fa-light fa-filter" aria-hidden="true"></i></a>
        </div>
