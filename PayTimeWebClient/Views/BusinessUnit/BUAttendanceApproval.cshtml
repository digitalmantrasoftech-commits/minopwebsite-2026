@using System.Configuration;
@{
    Layout = null;
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _EmpId = Convert.ToInt32(HttpContext.Current.Session["EmpId"]);
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _PlanId = HttpContext.Current.Session["planId"].ToString();
    string _lockAttendanceDay = HttpContext.Current.Session["lockAttendanceDay"].ToString();
}

<link href="~/assets/global/plugins/bootstrap-multiselect/css/bootstrap-multiselect.css" rel="stylesheet" />

<style>
    .left-fixed-column {
        width: 60px !important;
        min-width: 30px !important;
        left: 1px;
        position: sticky !important;
        background-color: #fff !important;
        z-index: 1;
    }

    .left-fixed-column-1 {
        width: 200px !important;
        min-width: 200px !important;
        left: 38px;
        position: sticky !important;
        background-color: #fff !important;
        box-shadow: 1px 1px 4px 0px rgba(0, 0, 0, 0.20);
        z-index: 1;
    }

    .right-fixed-column {
        width: 128px !important;
        min-width: 128px !important;
        right: 1px;
        position: sticky !important;
        background-color: #fff !important;
        box-shadow: -1px 1px 4px 0px rgba(0, 0, 0, 0.20);
        z-index: 1;
    }

    .appoval_actionbtn .icon_btn, .appoval_actionbtn .clear_btn {
        height: 26px;
        width: 26px;
        line-height: 26px !important;
        padding: 0;
    }

    .emp-avatar {
        display: inline-block;
        min-width: 30px;
        height: 30px;
        line-height: 30px;
        text-align: center;
        background-color: #ecf3ff;
        color: #295097;
        border-radius: 50% !important;
        border: 1px solid #8ab1f7;
        margin-right: 8px;
        font-size: 13px;
        font-weight: 500;
    }

    .emp-name-cell {
        display: flex;
        align-items: center;
    }

    table.dataTable td.sorting_1 {
        background-color: #fff !important;
    }
</style>

<a id="Filter_search" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Filter" style="position: absolute; top: 6px; right: 16px;"><i class="fa-light fa-filter"></i></a>

<div class="filter_portlet_wrapper full-width">

    <!-- Datatable Block : Begin -->
    <div class="portlet filter_portlet_tbl">
        <div class="portlet-body">
            <div id="divtblBUAttendanceApproval">

                <div class="text-center">
                    <div>
                        <p id="allnoteid" style="color: red; font-size: 12px; font-weight: 400; margin: 0;">Note:This option is exclusively intended for viewing purposes and does not involve any operations or actions.</p>
                        <span id="prv_Date" style="display:none; color:red; font-size:12px; font-weight:400"></span>
                    </div>
                </div>
                <div class="appoval_actionbtn" id="appactionbtn" style="display:none">
                    <button type="button" id="btnactive" class="btn icon_btn tooltips" data-placement="top" data-original-title="Approve"><i class="fa-solid fa-check"></i></button>
                    <button type="button" id="btnDeactive" class="btn clear_btn margin-left-5 tooltips" data-placement="top" data-original-title="Reject"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div id="tblempty">
                    <div class="table-responsive" id="tableResponsiveAtt">
                        <table id="tblBUAttendanceApproval" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column no-footer dataTable">
                            <thead>
                                <tr>
                                    <th style="align-content:center" class="left-fixed-column"><input type="checkbox" id="selectall"></th>
                                    <th class="left-fixed-column-1">Employee</th>
                                    <th>Request Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : DD-MMM-YYYY' style='color: #295097;'></i></th>
                                    <th>Correction Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : DD-MMM-YYYY' style='color: #295097;'></i></th>
                                    <th>In Time</th>
                                    <th>Out Time</th>
                                    <th>Apply Reason</th>
                                    <th>Approval Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : DD-MMM-YYYY' style='color: #295097;'></i></th>
                                    <th>Reason</th>
                                    <th>Action By</th>
                                    <th>Created By</th>
                                    <th>Created Date</th>
                                    <th>Status</th>
                                    <th>EmpCode</th>
                                    <th>Reporting Person</th>
                                    <th class="right-fixed-column">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="NotificationGrid-empty" style="display: none">
                    <div class="datanotfound">
                        <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="Nodata Found Icon">
                        <p class="datanotfound_title">No data found</p>
                        <p class="datanotfound_subtitle">No matching records found for the selected filters.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Datatable Block : End -->
    <!-- Filter Block : Begin -->
    <div class="portlet filter_boxModal">
        <div class="filterbox_header">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="filter-title">Filters</h4>
                <button type="button" class="filterclose_btn"><i class="fa-light fa-xmark"></i></button>
            </div>
        </div>
        <div class="filterbox_body">
            <div class="col-lg-12">
                <div class="form-group">
                    <label class="control-label">Business Unit <span class="required" aria-required="true">*</span></label>
                    <select id="selectBusinessUnit" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%"></select>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group">
                    <label class="control-label">Sub Business Unit</label>
                    <select id="selectSubBusinessUnit" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%"></select>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group data_picker_box">
                    <label class="control-label">From Date <span class="required" aria-required="true">*</span></label>
                    <div class="input-group input-group-sm date date-picker" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                        <span class="input-group-btn">
                            <button class="btn default" type="button">
                                <i class="fa-light fa-calendar-days"></i>
                            </button>
                        </span>
                        <input type="text" class="form-control" id="FilterFromDate" value="" data-date-format="@_isdateformat" placeholder="" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group data_picker_box">
                    <label class="control-label">To Date <span class="required" aria-required="true">*</span></label>
                    <div class="input-group input-group-sm date date-picker" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                        <span class="input-group-btn">
                            <button class="btn default" type="button">
                                <i class="fa-light fa-calendar-days"></i>
                            </button>
                        </span>
                        <input type="text" class="form-control" id="FilterToDate" value="" data-date-format="@_isdateformat" placeholder="" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group">
                    <label>Status <span class="required" aria-required="true"> * </span></label>
                    <select class="form-control input-sm" id="selectstatus" name="selectstatus">
                        <option value="0">All</option>
                        <option value="1">Approved</option>
                        <option value="3" selected>Pending</option>
                        <option value="2">Rejected</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-12" id="Select_Atn_EmployeeContainer">
                <div class="form-group">
                    <label class="control-label">Employee</label>
                    <select id="Select_Atn_Employee" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%"></select>
                </div>
            </div>
        </div>
        <div class="filterbox_footer">
            <div class="text-right">
                <button type="button" id="SearchFilter" class="btn icon_btn tooltips" data-placement="top" data-original-title="Search Filters"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
        </div>
    </div>
    <!-- Filter Block : End -->

</div>

<script>
    $(document).ready(function () {

        var pkloginemployeeid = '@_EmpId';
        var emprole = '@_RoleId';

        // ===== Hide allnoteid by default (only show when status = All) =====
        $("#allnoteid").hide();
        $("#selectstatus").on("change", function () {
            if ($(this).val() == "0") {
                $("#allnoteid").show();
            } else {
                $("#allnoteid").hide();
            }
        });

        // ===== Helper: Convert displayed date to yyyy-MM-dd for API =====
        function formatDateForAPI(dateStr) {
            if (!dateStr) return '';
            var months = { 'jan': '01', 'feb': '02', 'mar': '03', 'apr': '04', 'may': '05', 'jun': '06', 'jul': '07', 'aug': '08', 'sep': '09', 'oct': '10', 'nov': '11', 'dec': '12' };
            var parts = dateStr.split(/[-\/]/);
            if (parts.length === 3) {
                var monthKey = parts[1].toLowerCase().substring(0, 3);
                if (months[monthKey]) {
                    return parts[2] + '-' + months[monthKey] + '-' + ('0' + parseInt(parts[0])).slice(-2);
                }
                if (parts[0].length <= 2 && parts[2].length === 4) {
                    return parts[2] + '-' + ('0' + parseInt(parts[1])).slice(-2) + '-' + ('0' + parseInt(parts[0])).slice(-2);
                }
            }
            return dateStr;
        }

        // ===== DataTable initialisation =====
        var table = $("#tblBUAttendanceApproval").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            data: [],
            columns: [
                { data: null, defaultContent: '' },
                { data: "EmpName", defaultContent: '' },
                { data: "CreatedDate", defaultContent: '' },
                { data: "CorrectionDate", defaultContent: '' },
                { data: "InTime", defaultContent: '' },
                { data: "OutTime", defaultContent: '' },
                { data: "Reason", defaultContent: '' },
                { data: "ApprovalDate", defaultContent: '' },
                { data: "ApprovalReason", defaultContent: '' },
                { data: "ActionBy", defaultContent: '' },
                { data: "Created", defaultContent: '' },
                { data: "CreatedDate", defaultContent: '' },
                { data: "StatusName", defaultContent: '' },
                { data: "EmpCode", defaultContent: '' },
                { data: "ReportingName", defaultContent: '' },
                { data: null, defaultContent: '' }
            ],
            columnDefs: [
                {
                    orderable: false, className: 'no-sort left-fixed-column', targets: 0,
                    render: function (data, type, row) {
                        if (row.Status == 3) {
                            return '<input type="checkbox" class="ClsChkEmp" data-id="' + row.AttendanceCorrectionId + '" data-empid="' + row.EmpId + '" />';
                        }
                        return '';
                    }
                },
                {
                    className: 'left-fixed-column-1', targets: 1,
                    render: function (data, type, row) {
                        var name = row.EmpName || '';
                        var code = row.EmpCode || '';
                        var initials = name.split(' ').map(function (n) { return n.charAt(0).toUpperCase(); }).join('').substring(0, 2);
                        var avatarHtml = '<span class="emp-avatar tooltips" data-placement="right" data-original-title="Empcode : ' + code + '">' + initials + '</span>';
                        return '<div class="emp-name-cell">' + avatarHtml + ' ' + name + '</div>';
                    }
                },
                {
                    orderable: false, className: 'no-sort right-fixed-column', targets: 15,
                    render: function (data, type, row) {
                        var html = '';
                        if (row.Status == 3) {
                            html += '<a href="javascript:;" class="btn green_btnnew tooltips" data-placement="left" data-original-title="Approve"><i class="fa-solid fa-check"></i></a> ';
                            html += '<a href="javascript:;" class="btn red_btnnew tooltips" data-placement="left" data-original-title="Reject"><i class="fa-solid fa-xmark"></i></a>';
                        } else if (row.Status == 1) {
                            html += '<a href="javascript:;" class="btn green_btnnew tooltips" data-placement="left" data-original-title="Approve" style="pointer-events:none;opacity:0.5;"><i class="fa-solid fa-check"></i></a> ';
                            html += '<a href="javascript:;" class="btn red_btnnew tooltips" data-placement="left" data-original-title="Reject" style="pointer-events:none;opacity:0.5;"><i class="fa-solid fa-xmark"></i></a> ';
                            html += '<a href="javascript:;" class="btn red_btnnew tooltips" data-placement="left" data-original-title="Cancel Attendance"><i class="fa-regular fa-ban"></i></a>';
                        } else {
                            html += '<a href="javascript:;" class="btn green_btnnew tooltips" data-placement="left" data-original-title="Approve" style="pointer-events:none;opacity:0.5;"><i class="fa-solid fa-check"></i></a> ';
                            html += '<a href="javascript:;" class="btn red_btnnew tooltips" data-placement="left" data-original-title="Reject" style="pointer-events:none;opacity:0.5;"><i class="fa-solid fa-xmark"></i></a>';
                        }
                        return html;
                    }
                }
            ],
            order: [[1, 'asc']],
            initComplete: function () {
                const visibleTable = $('table:visible').attr('id');
                $("#buttons").append(
                    `<div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                        <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                    </div>`
                );
            },
        });
        setTimeout(function () {
            $("#" + "tblBUAttendanceApproval" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsiveAtt"));
            $('.tooltips').tooltip();
        }, 100);

        // Apply the column Search
        $("#tblBUAttendanceApproval thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });

        table.on('draw.dt', function () {
            $('.tooltips').tooltip();
        });

        // ===== Date helper =====
        Date.prototype.toInputFormat = function () {
            var yyyy = this.getFullYear().toString();
            var mm = (this.getMonth() + 1).toString();
            var dd = this.getDate().toString();
            return yyyy + "-" + (mm[1] ? mm : "0" + mm[0]) + "-" + (dd[1] ? dd : "0" + dd[0]);
        };

        // ===== Set Default Dates (1st to last day of current month) =====
        var currentDate = new Date();
        var firstDay = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
        var lastDay = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
        $('#FilterFromDate').val(firstDay.toInputFormat());
        $('#FilterToDate').val(lastDay.toInputFormat());

        // ===== SearchFilter Click Handler =====
        $("#SearchFilter").click(function () {
            var fromDate = $("#FilterFromDate").val();
            var toDate = $("#FilterToDate").val();
            if (!fromDate) { toastr.warning("Please select From Date."); return; }
            if (!toDate) { toastr.warning("Please select To Date."); return; }
            var fd = new Date(formatDateForAPI(fromDate));
            var td = new Date(formatDateForAPI(toDate));
            if (fd > td) { toastr.warning("From Date cannot be greater than To Date."); return; }
            checkPrevReq();
        });

        // ===== Check Previous Pending Approval =====
        function checkPrevReq() {
            var selectedBUs = $("#selectBusinessUnit").val() || [];
            if (selectedBUs.length === 0) {
                toastr.warning("Please select at least one Business Unit.");
                return;
            }

            // If status is not Pending, skip prev check and load data directly
            if ($("#selectstatus").val() != "3") {
                Search_filter();
                return;
            }

            var selectedSubBUs = $("#selectSubBusinessUnit").val() || [];
            var totalOptions = $('#Select_Atn_Employee option').length;
            var selectedOptions = $('#Select_Atn_Employee option:selected').length;
            var _Employee = $('#Select_Atn_Employee').val();
            var _arrEmployee = "0";
            if (_Employee && _Employee.length > 0 && totalOptions != selectedOptions) {
                _arrEmployee = _Employee.join(",");
            }

            $("#prv_Date").empty().hide();

            var obj = {
                BUIds: selectedBUs,
                SubBUIds: selectedSubBUs,
                Employeeids: _arrEmployee,
                FilterFromDate: formatDateForAPI($("#FilterFromDate").val()),
                FilterToDate: formatDateForAPI($("#FilterToDate").val()),
                _IsStatus: 3,
                EmpId: parseInt(pkloginemployeeid),
                roleid: parseInt(emprole),
                planid: '@_PlanId',
                _lockAttendanceDay: '@_lockAttendanceDay'
            };

            $.ajax({
                type: "POST",
                url: '@_webapiurl' + "BU/BUCheckPrevAttendanceReq",
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                headers: { 'Authorization': '@_tokan' },
                dataType: "json",
                beforeSend: function () { $('#ajax_loader').show(); },
                success: function (data) {
                    $('#ajax_loader').hide();
                    if (data && data.length > 0 && data[0]["cnt"] > 0) {
                        var LastDate = data[0]["Mindt"];
                        var _LastDate = LastDate.split('T');
                        $("#prv_Date").show();
                        $("#prv_Date").append("Your previous attendance is pending on date: " + _LastDate[0]);
                        $('#tblempty').hide();
                        $('#NotificationGrid-empty').show();
                    } else {
                        $("#prv_Date").hide();
                        Search_filter();
                    }
                },
                error: function () {
                    $('#ajax_loader').hide();
                    $("#prv_Date").hide();
                    Search_filter();
                }
            });
        }

        // ===== Search Filter API Call =====
        function Search_filter() {
            // Show/hide allnoteid based on status
            if ($("#selectstatus").val() == "0") {
                $("#allnoteid").show();
            } else {
                $("#allnoteid").hide();
            }

            var selectedBUs = $("#selectBusinessUnit").val() || [];
            var selectedSubBUs = $("#selectSubBusinessUnit").val() || [];
            if (selectedBUs.length === 0) {
                toastr.warning("Please select at least one Business Unit.");
                return;
            }
            var totalOptions = $('#Select_Atn_Employee option').length;
            var selectedOptions = $('#Select_Atn_Employee option:selected').length;
            var _Employee = $('#Select_Atn_Employee').val();
            var _arrEmployee = "0";
            if (_Employee && _Employee.length > 0 && totalOptions != selectedOptions) {
                _arrEmployee = _Employee.join(",");
            }

            var obj = {
                BUIds: selectedBUs,
                SubBUIds: selectedSubBUs,
                Employeeids: _arrEmployee,
                FilterFromDate: formatDateForAPI($("#FilterFromDate").val()),
                FilterToDate: formatDateForAPI($("#FilterToDate").val()),
                _IsStatus: parseInt($("#selectstatus").val()),
                EmpId: parseInt(pkloginemployeeid),
                roleid: parseInt(emprole),
                planid: '@_PlanId',
                _lockAttendanceDay: '@_lockAttendanceDay'
            };

            $.ajax({
                type: "POST",
                url: '@_webapiurl' + "BU/BUAttendanceCorrectionFilter",
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                headers: { 'Authorization': '@_tokan' },
                dataType: "json",
                beforeSend: function () { $('#ajax_loader').show(); },
                success: function (response) {
                    $('#ajax_loader').hide();
                    var data = response.data || response || [];
                    if (data.length > 0) {
                        $('#tblempty').show();
                        $('#NotificationGrid-empty').hide();
                        table.clear().rows.add(data).draw();
                    } else {
                        table.clear().draw();
                        $('#tblempty').hide();
                        $('#NotificationGrid-empty').show();
                    }
                    $("#selectall").prop('checked', false);
                    $("#appactionbtn").hide();
                },
                error: function (jqXHR) {
                    $('#ajax_loader').hide();
                    if (jqXHR.status == 404) {
                        table.clear().draw();
                        $('#tblempty').hide();
                        $('#NotificationGrid-empty').show();
                    } else {
                        toastr.error("Failed to load data.");
                    }
                }
            });
        }

        // ===== Filter Panel Toggle =====
        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        // ===== Select All checkbox =====
        $("#selectall").on("change", function () {
            $("#appactionbtn").show();
            if ($(this).is(":checked")) {
                $("#tblBUAttendanceApproval .ClsChkEmp").each(function () {
                    $(this).prop('checked', true);
                });
            } else {
                $("#tblBUAttendanceApproval .ClsChkEmp").each(function () {
                    $(this).prop('checked', false);
                    $("#appactionbtn").hide();
                });
            }
        });

        $(document).on("change", ".ClsChkEmp", function () {
            var anyChecked = $(".ClsChkEmp:checked").length > 0;
            if (anyChecked) {
                $("#appactionbtn").show();
            } else {
                $("#appactionbtn").hide();
            }
        });

        // ===== checkSession =====
        function checkSession() {
            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.isRedirect) { window.top.location.href = data.redirectUrl; }
                },
                error: function (data) { window.top.location.href = data; }
            });
        }

        // ===== Bulk Approve (btnactive) =====
        $("#btnactive").click(function () {
            checkSession();
            var objCorrection = [];
            $("#tblBUAttendanceApproval .ClsChkEmp").each(function () {
                if ($(this).is(':checked')) {
                    var rowData = table.row($(this).closest('tr')).data();
                    var _ApprovalReason = "";
                    if ('@_RoleId' == 1) _ApprovalReason = "Approved by admin";
                    if ('@_RoleId' == 6805) _ApprovalReason = "Approved by companyadmin";
                    if ('@_RoleId' == 6806) _ApprovalReason = "Approved by branchadmin";
                    objCorrection.push({
                        AttCorrectionId: rowData.AttendanceCorrectionId,
                        EmpId: rowData.EmpId,
                        attn_dt: formatDateForAPI(rowData.CorrectionDate),
                        InPunchTime: rowData.InTime,
                        OutPunchTime: rowData.OutTime,
                        ApplyReason: rowData.Reason,
                        ApprovalReason: _ApprovalReason,
                        Status: "1"
                    });
                }
            });
            if (objCorrection.length == 0) { toastr.error("Please select attendance."); return false; }
            $.ajax({
                type: 'POST',
                url: '/ESS/AttendanceCorrectionUpdatereq',
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ 'objCorrection': objCorrection }),
                headers: { 'Authorization': '@_tokan' },
                dataType: "json",
                beforeSend: function () { $(".loading").show(); },
                success: function (data) {
                    $(".loading").hide();
                    if (data.isRedirect) { window.location.href = data.redirectUrl; }
                    if (data.ad == "ok") {
                        $("#selectall").prop('checked', false);
                        toastr.success("Attendance approved successfully.");
                        $("#appactionbtn").hide();
                        Search_filter();
                    } else {
                        toastr.error("Error in approving Attendance.");
                    }
                },
                error: function (jqXHR) {
                    $(".loading").hide();
                    if (jqXHR.status == 401) window.location.href = "/PayTime/LoginPage";
                    else toastr.error("Failed to approve attendance.");
                }
            });
        });

        // ===== Bulk Reject (btnDeactive) =====
        $("#btnDeactive").click(function () {
            checkSession();
            var objCorrection = [];
            $("#tblBUAttendanceApproval .ClsChkEmp").each(function () {
                if ($(this).is(':checked')) {
                    var rowData = table.row($(this).closest('tr')).data();
                    var _ApprovalReason = "";
                    if ('@_RoleId' == 1) _ApprovalReason = "Rejected by admin";
                    if ('@_RoleId' == 6805) _ApprovalReason = "Rejected by companyadmin";
                    if ('@_RoleId' == 6806) _ApprovalReason = "Rejected by branchadmin";
                    objCorrection.push({
                        AttCorrectionId: rowData.AttendanceCorrectionId,
                        EmpId: rowData.EmpId,
                        attn_dt: formatDateForAPI(rowData.CorrectionDate),
                        InPunchTime: rowData.InTime,
                        OutPunchTime: rowData.OutTime,
                        ApplyReason: rowData.Reason,
                        ApprovalReason: _ApprovalReason,
                        Status: "2"
                    });
                }
            });
            if (objCorrection.length == 0) { toastr.error("Please select attendance."); return false; }
            $.ajax({
                type: 'POST',
                url: '/ESS/AttendanceCorrectionUpdatereq',
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ 'objCorrection': objCorrection }),
                headers: { 'Authorization': '@_tokan' },
                dataType: "json",
                beforeSend: function () { $(".loading").show(); },
                success: function (data) {
                    $(".loading").hide();
                    if (data.isRedirect) { window.location.href = data.redirectUrl; }
                    if (data.ad == "ok") {
                        $("#selectall").prop('checked', false);
                        toastr.success("Attendance rejected successfully.");
                        $("#appactionbtn").hide();
                        Search_filter();
                    } else {
                        toastr.error("Error in rejecting Attendance.");
                    }
                },
                error: function (jqXHR) {
                    $(".loading").hide();
                    if (jqXHR.status == 401) window.location.href = "/PayTime/LoginPage";
                    else toastr.error("Failed to reject attendance.");
                }
            });
        });

