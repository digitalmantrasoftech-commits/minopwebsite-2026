        // ===== BU / SubBU / Employee dynamic loading =====
        function onBUChange() {
            loadSubBU();
            loadEmployeesByBU();
        }
        function onSubBUChange() {
            loadEmployeesByBU();
        }

        $("#selectBusinessUnit").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Business Unit',
            onChange: function () { onBUChange(); },
            onSelectAll: function () { onBUChange(); },
            onDeselectAll: function () { onBUChange(); }
        });
        $("#selectSubBusinessUnit").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Sub Business Unit',
            onChange: function () { onSubBUChange(); },
            onSelectAll: function () { onSubBUChange(); },
            onDeselectAll: function () { onSubBUChange(); }
        });
        $("#Select_Atn_Employee").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Employee'
        });

        loadBUDropdown();

        function loadBUDropdown() {
            $.ajax({
                type: "POST",
                url: '@_webapiurl' + "BU/GetAssignedBUs",
                data: JSON.stringify({ loginemployeeid: pkloginemployeeid, RoleID: emprole }),
                contentType: "application/json; charset=utf-8",
                headers: { 'Authorization': '@_tokan' },
                dataType: "json",
                success: function (response) {
                    if (typeof response === "string") {
                        try { response = JSON.parse(response); } catch (e) { response = null; }
                    }
                    var buList = null;
                    if (response != null) {
                        if (Array.isArray(response)) buList = response;
                        else if (response.Table && Array.isArray(response.Table)) buList = response.Table;
                        else if (response.data && Array.isArray(response.data)) buList = response.data;
                    }
                    if (buList != null && buList.length > 0) {
                        var dd = $("#selectBusinessUnit");
                        dd.empty();
                        for (var i = 0; i < buList.length; i++) {
                            dd.append('<option value="' + buList[i].BUId + '">' + buList[i].BUName + '</option>');
                        }
                        $('#selectBusinessUnit').multiselect('rebuild');
                        var ms = $('#selectBusinessUnit').data('multiselect');
                        if (ms) {
                            ms.options.onChange = function () { onBUChange(); };
                            ms.options.onSelectAll = function () { onBUChange(); };
                            ms.options.onDeselectAll = function () { onBUChange(); };
                        }
                        // Auto-select all BUs and load data on page load
                        $('#selectBusinessUnit').multiselect('selectAll', false);
                        $('#selectBusinessUnit').multiselect('updateButtonText');
                        onBUChange();
                        checkPrevReq();
                    }
                },
                error: function () { toastr.error("Failed to load BU list."); }
            });
        }

        function loadSubBU() {
            var selectedBUs = $("#selectBusinessUnit").val() || [];
            if (selectedBUs.length === 0) {
                $('#selectSubBusinessUnit').empty();
                $('#selectSubBusinessUnit').multiselect('rebuild');
                var ms = $('#selectSubBusinessUnit').data('multiselect');
                if (ms) {
                    ms.options.onChange = function () { onSubBUChange(); };
                    ms.options.onSelectAll = function () { onSubBUChange(); };
                    ms.options.onDeselectAll = function () { onSubBUChange(); };
                }
                return;
            }
            $.ajax({
                type: "POST",
                url: '@_webapiurl' + "Master/SubBUDropdown_multiselect",
                data: JSON.stringify(selectedBUs),
                contentType: "application/json; charset=utf-8",
                headers: { 'Authorization': '@_tokan' },
                dataType: "json",
                success: function (response) {
                    $("#selectSubBusinessUnit").empty();
                    if (response != null && response.length > 0) {
                        $.each(response, function (i, subbu) {
                            $("#selectSubBusinessUnit").append('<option value="' + subbu.SubBUId + '">' + subbu.SubBUName + '</option>');
                        });
                    }
                    $('#selectSubBusinessUnit').multiselect('rebuild');
                    var ms = $('#selectSubBusinessUnit').data('multiselect');
                    if (ms) {
                        ms.options.onChange = function () { onSubBUChange(); };
                        ms.options.onSelectAll = function () { onSubBUChange(); };
                        ms.options.onDeselectAll = function () { onSubBUChange(); };
                    }
                },
                error: function () { toastr.error("Failed to load Sub BU list."); }
            });
        }

        function loadEmployeesByBU() {
            var selectedBUs = $("#selectBusinessUnit").val() || [];
            var selectedSubBUs = $("#selectSubBusinessUnit").val() || [];
            var prevSelectedEmps = $("#Select_Atn_Employee").val() || [];
            $("#Select_Atn_Employee").empty();
            if (selectedBUs.length === 0) {
                $('#Select_Atn_Employee').multiselect('rebuild');
                return;
            }
            $.ajax({
                type: "POST",
                url: '@_webapiurl' + "Master/GetEmployeesByBUAndSubBU",
                data: JSON.stringify({ BUIds: selectedBUs, SubBUIds: selectedSubBUs }),
                contentType: "application/json; charset=utf-8",
                headers: { 'Authorization': '@_tokan' },
                dataType: "json",
                success: function (response) {
                    if (response != null && response.length > 0) {
                        for (var i = 0; i < response.length; i++) {
                            var isSelected = prevSelectedEmps.indexOf(response[i].EmpId.toString()) > -1;
                            $('#Select_Atn_Employee').append('<option value="' + response[i].EmpId + '"' + (isSelected ? ' selected' : '') + '>' + response[i].EmpName + ' (' + response[i].Empcode + ')</option>');
                        }
                    }
                    $('#Select_Atn_Employee').multiselect('rebuild');
                },
                error: function () { toastr.error("Failed to load employees."); }
            });
        }

    });
