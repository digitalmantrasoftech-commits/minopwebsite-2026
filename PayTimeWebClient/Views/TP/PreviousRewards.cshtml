@{
    ViewBag.Title = "Previous Rewards";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">

<style type="text/css">
    .fixed-column {
        width: 80px !important;
        min-width: 80px !important;
        right: 0px;
        position: sticky !important;
        background-color: #fff !important;
        box-shadow: -1px 0px 3px 0px rgba(0, 0, 0, 0.20);
    }
</style>

<script>
    $(document).ready(function () {

        // Table Traine Request Block : Begin ===============================================
        // Create search inputs in footer
        $("#tblrewards tfoot th").each(function () {
            var title = $(this).text();
            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
        });

        // DataTable initialisation
        var table = $("#tblrewards").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            ordering: true,
            columnDefs: [
                { orderable: false, targets: [10] } // disable ordering on 9th and 10th columns
            ],
        });
        setTimeout(function () {
            $("#" + "tblrewards" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        // Apply the column Search
        $("#tblrewards thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });
        // Table Traine Request Block : End ===============================================

        // ================= Table Kaizen Code : Begin =========================
        // Create search inputs in footer
        $("#tblKaizen tfoot th").each(function () {
            var title = $(this).text();
            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
        });

        // DataTable initialisation
        var table = $("#tblKaizen").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            ordering: true,
            columnDefs: [
                { orderable: false, targets: [2] } // disable ordering on 9th and 10th columns
            ],
        });
        setTimeout(function () {
            $("#" + "tblKaizen" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsiveKaizen"));
            $('.tooltips').tooltip();
        }, 100);

        // Apply the column Search
        $("#tblKaizen thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });
        // ================= Table Kaizen Code : End =========================


        // ================= Table Safety Code : Begin =========================
        // Create search inputs in footer
        $("#tblSafety tfoot th").each(function () {
            var title = $(this).text();
            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
        });

        // DataTable initialisation
        var table = $("#tblSafety").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            ordering: true,
            columnDefs: [
                { orderable: false, targets: [2] } // disable ordering on 9th and 10th columns
            ],
        });
        setTimeout(function () {
            $("#" + "tblSafety" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsiveSafety"));
            $('.tooltips').tooltip();
        }, 100);

        // Apply the column Search
        $("#tblSafety thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });
        // ================= Table Safety Code : End =========================

        // Filter Click Open Modal Code =========================
        $(".ViewDetail").on('click', function () {
            $(".ViewDetail").attr("data-toggle", "modal");
            $(".ViewDetail").attr("data-target", "#ViewDetail_modal");
        });

        // Dropdown tab switch
        $("#ddlRewardType").on("change", function () {
            var selectedTab = $(this).val();
            $(".tab-content .tab-pane").removeClass("active in");
            $("#" + selectedTab).addClass("active in");
        });

        // Filter Click Hide/Show Code ===============================
        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click ===============================
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        // Dropdown Multiselect code ===============================
        var $Branchselect = $("#BranchID").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Branch'
        });
        var $Employeeselect = $("#EmployeeID").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Employee'
        });


    });
</script>
