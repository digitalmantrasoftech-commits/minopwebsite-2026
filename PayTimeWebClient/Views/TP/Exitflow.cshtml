                    'Authorization': token
                },
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (res) {
                    if (res.status) {
                        toastr.success("Trainee Document Released Successfully.");    
                        loadFandFData();
                    }
                },
                error: function (err) {
                    console.log("Error in Retain Trainee", err);        
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });

        $("#Downloadall").click(function () {
            data = {
                RoleId: Roleid,
                CompanyId: Companyid
            }
            $.ajax({
                type: 'POST',
                url: webapiuri + "TPOnboarding/GetAllActiveInactiveData",
                headers: {
                    'Authorization': token
                },
                data: data,
                dataType: 'json',
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (res) {
                    if (!res || res.length === 0) {
                        toastr.error("No data found to download.");
                        return;
                    }

                    const headers = [
                        "Name", "Trainee ID", "Type of Discountinuation", "Reason for Discountinuation", "Description", "Business Unit", "Department Name", "Branch Name","Workstation Name","LastWorking Date","Remarks"              
                    ];

                    const sheetData = [
                        headers,
                        ...res.map(item => [
                            item["name"],
                            item["punchid"],
                            item["type"],                            
                            item["reason"],
                            item["Description"],
                            item["Company"],                           
                            item["Department"],
                            item["Branch"],
                            item["workstationname"],
                            item["Lastworkingday"],
                            item["remark"],
                        ])
                    ];

                    exportCompanyRecordToExcel(sheetData, "Active/Inactive Report");
                },
                error: function (error) {
                    console.log(error);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            })
        })
    });
    function checkSession() {

        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
    function triggerTabLoad(activeTabId) {        
        switch (activeTabId) {
            case "#Request":
                loadVoluntarydiscontinuationtData();
                break;
            case "#OnNoticePeriod":
                loadNoticePeriodData();
                break;
            case "#FandF":
                loadFandFData();
                break;
        }
    }

    function loadVoluntarydiscontinuationtData() {
        data = {
            RoleId: Roleid,
            CompanyId: Companyid 
        }
        $.ajax({
            url: webapiurl + "TPOnboarding/loadVoluntarydiscontinuationtData",
            type: 'POST',
            headers: {
                'Authorization': token
            },
            data: JSON.stringify(data),
            dataType: 'json',
            contentType: "application/json; charset=utf-8",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (res) {
                console.log(res);
                if (!res || res.length === 0 || res == 0) {
                    $("#NotificationGrid-empty").show();
                    $("#tableResponsive_Request").hide();
                    $("#dataTables_tbl_header").hide();
                }
                else {
                    $("#NotificationGrid-empty").hide();
                    loadDatatableForRequest(res);
                }
            },
            error: function () {
                toastr.error('Failed to load Request Data');
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }
    function loadDatatableForRequest(data) {
        $("#dataTables_tbl_header").remove();
        var table = $("#tblRequest").DataTable({
            destroy: true,
            dom: _domCommon,
            language: _languageCommon,
            data: data,
            order: [],
            columns: [
                { title: "Empid", data: "Empid", visible: false },
                { title: "Emp Code", data: "EmpCode" },
                { title: "Name", data: "EmpName" },
                { title: "Email", data: "useremail" },
                { title: "Company", data: "CompanyName" },
                { title: "Reason for discontinuation", data: "reason" },
                { title: "Last Working Day", data: "Lastworkingday" },
                { title: "Description", data: "Description" },
                { title: "Remarks", data: "remark" },
                {
                    title: "Status", data: "StatusText",
                    render: function (data, type, row) {
                        var status = row.status;
                        if (status == 0) return '<div class="orange_font">' + (data || 'Manager Approval Pending') + '</div>';
                        if (status == 1) return '<div class="red_font">' + (data || 'Manager Rejected') + '</div>';
                        if (status == 2) return '<div class="">' + (data || 'Pending') + '</div>';
                        if (status == 3) return '<div class="red_font">' + (data || 'Rejected') + '</div>';
                        if (status == 4) return '<div class="green_font">' + (data || 'Approved') + '</div>';
                        return data || status;
                    }
                },
                {
                    title: "Action", data: null, orderable: false,
                    render: function (data, type, row) {
                        var isSuperAdmin = ('@_RoleId' == '1');
                        var canApprove = (row.status == 2) || (isSuperAdmin && row.status == 4);
                        var approveAttr = canApprove ? '' : 'style="pointer-events: none; opacity: 0.6;"';

                        var canReject = (row.status == 2);
                        var rejectAttr = canReject ? '' : 'style="pointer-events: none; opacity: 0.6;"';
                        return `
                             <a id="" class="btn blue_btnnew tooltips ApproveBtn" data-placement="left" data-original-title="Approve" ${approveAttr}><i class="fa-solid fa-check"></i></a>
                             <a id="" class="btn blue_btnnew tooltips RejectBtn" data-placement="left" data-original-title="Reject" ${rejectAttr}><i class="fa-solid fa-xmark"></i></a>
                        `;
                    }
                },
            ],
            initComplete: function () {
                const visibleTable = $('table:visible').attr('id');
                $("#buttons").append(`
                  <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                      <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                  </div>
            `);
            },
            drawCallback: function () {
                $('.tooltips').tooltip();
            },
        });
        setTimeout(function () {
            $("#" + "tblRequest" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive_Request"));
            $('.tooltips').tooltip();
        }, 100);
    }
    function loadNoticePeriodData() {
        data = {
            RoleId: Roleid,
            CompanyId: Companyid
        }
        $.ajax({
            url: webapiurl + "TPOnboarding/loadNoticePeriodData",
            type: 'POST',
            headers: {
                'Authorization': token
            },
            data: JSON.stringify(data),
            dataType: 'json',
            contentType: "application/json; charset=utf-8",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (res) {                
                if (!res || res.length === 0 || res == 0) {
                    $("#NotificationGrid-emptyNotice").show();
                    $("#tableResponsive_Notice").hide();
                    $("#dataTables_tbl_header").hide();
                }
                else {
                    $("#NotificationGrid-emptyNotice").hide();
                    loadDatatableForNoticePeriod(res);
                }
            },
            error: function () {
                toastr.error('Failed to load Notice Period Data');
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }
    function loadDatatableForNoticePeriod(data) {
        $("#dataTables_tbl_header").remove();
        var table = $("#tblNotice").DataTable({
            destroy: true,
            dom: _domCommon,
            language: _languageCommon,            
            data: data,
            order: [],
            columns: [
                { title: "Empid", data: "Empid", visible: false },
                { title: "Name", data: "EmpName" },
                { title: "Role", data: "Emprole" },
                { title: "Last Working Day", data: "Lastworkingday" },
                { title: "Reason", data: "Description" },                
                {
                    title: "Status", data: "noticeperiod",
                    render: function (data) {
                        if (data == 0) return '<div class="">Pending</div>';
                        if (data == 1) return '<div class="green_font">Releave</div>';
                        if (data == 2) return '<div class="green_font">Retain</div>';
                        return data;
                    }
                },
                {
                    title: "Action", data: null, orderable: false,
                    render: function (data, type, row) {
                        var isPending = (row.noticeperiod == 0);
                        var disabledAttr = isPending ? '' : 'disabled style="pointer-events: none; opacity: 0.6;"';
                        return `   
                        <a href="javascript:;" id="" class="btn blue_btnnew tooltips EmpReleaveBtn" data-placement="left" data-original-title="Releave Now" ${disabledAttr}><i class="fa-solid fa-arrow-left-from-arc"></i></a>
                        <a href="javascript:;" id="" class="btn blue_btnnew tooltips EmpRetainBtn" data-placement="left" data-original-title="Retain Now" ${disabledAttr}><i class="fa-regular fa-person-walking-arrow-loop-left"></i></a>                            
                        `;
                    }
                }
            ],
            initComplete: function () {
