        // Onboarding Block : End ===============================================


        // Filter Click Open Modal Code =========================
        $("#AddRules").on('click', function () {
            $("#AddRules").attr("data-toggle", "modal");
            $("#AddRules").attr("data-target", "#AddRules_modal");
        });

        $("#tblRequest").on('click', '.ApproveBtn', function () {
            var table = $('#tblRequest').DataTable();
            var rowData = table.row($(this).closest('tr')).data();
            $("#mdlEmpid").text(rowData.Empid);
            $("#mdlEmpEmail").val(rowData.useremail || "");
            $("#mdlStatus").text(rowData.status);
            $("#mdlEmpName").text(rowData.EmpName);
            $("#mdlReasonType").text(rowData.reason);
            $("#mdlDescription").text(rowData.Description);
            $("#mdlGW").text(rowData.DepartmentName || rowData.DepartmentNam);
            $("#mdlWorkstation").text(rowData.workstationname);
            $("#mdlLastWorkingDay2").text(rowData.Lastworkingday);
            $("#mdlLastWorkingDayConfirm").text(rowData.Lastworkingdaybymanager);
            $("#mdlLastWorkingDayByHR").text(rowData.LastworkingdaybyHR || "-");
            $("#mdlManagerRemark").text(rowData.mremark || "No remarks");
            $("#lastdaybyBHR").val("");
            $("#remark").val("");

            $(".ApproveBtn").attr("data-toggle", "modal");
            $(".ApproveBtn").attr("data-target", "#ApproveBtn_modal");
        });

        $("#SubmitRequest").click(function () {
            var Empid = $("#mdlEmpid").text();
            var lastday = $("#lastdaybyBHR").val();
            var remark = $("#remark").val();
            var status = $("#mdlStatus").text();

            if ('@_RoleId' == '1' || '@_RoleId' == '6805') {
                if (!lastday || lastday == "") {
                    toastr.remove();
                    toastr.error("Please Select Last Working Date");
                    return false;
                }
            }

          
            var EmpEmail = $("#mdlEmpEmail").val();
            var approvedata = {
                Empid: Empid,
                Lastday: lastday,
                remark: remark,
                Flag: 1,
                Email: EmpEmail
            };
            $.ajax({
                url: webapiuri + "/TPOnboarding/ApproveVoluntarydiscontinuation",
                method: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                headers: { 'Authorization': token },
                data: JSON.stringify(approvedata),
                beforeSend: function () {
                    $("#ajax_loader").show();
                    $("#SubmitRequest").prop("disabled", true);
                },
                success: function (data) {
                    if (data.status) {
                        toastr.success("Voluntary Discontinuation Request Approved Successfully. Employee will be deactivated automatically after their Last Working Day.");
                        $("#ApproveBtn_modal").modal('hide');
                        $("#lastdaybyBHR").val("");
                        $("#remark").val("");
                        loadVoluntarydiscontinuationtData();
                    } else {
                        toastr.warning(data.Message || "This request has already been processed or you are not authorized to perform this action.");
                        $("#ApproveBtn_modal").modal('hide');
                        loadVoluntarydiscontinuationtData();
                    }
                },
                error: function (err) {
                    toastr.error("Error occurred while processing the request.");
                    console.error("Error occur in save requst", err);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                    $("#SubmitRequest").prop("disabled", false);
                }
            });
        });

        $("#CancelRequest").click(function () {
            $("#lastdaybyBHR").val("");
            $("#remark").val("");
            $("#ApproveBtn_modal").modal('hide');
        });

        // Reject Button Swal Modal code : Begin ======================================
        $(document).on("click", ".RejectBtn", function (e) {
            e.preventDefault();
            var table = $('#tblRequest').DataTable();
            var rowData = table.row($(this).closest('tr')).data();
            var Empid = rowData.Empid;
            var EmpEmail = rowData.useremail || "";
            Swal.fire({
                html: '<div class="swal_subtitle"><b>Are you sure you want to reject this request?</b><div class="margin-top-20"><div class="form-group margin-bottom-0"> <label class="control-label">Please mention the reason <span class="required" aria-required="true">*</span></label> <input type="text" id="rejectreason" placeholder="Enter Reason" class="form-control" name="" maxlength="100" /> </div></div></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Reject request",
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'Cancel',
                confirmButtonText: 'Reject Request',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                },
                preConfirm: () => {
                    const reason = Swal.getPopup().querySelector('#rejectreason').value.trim();
                    if (!reason) {
                        Swal.showValidationMessage(`Please Enter Reason`);
                        return false;
                    }
                    return { reason: reason };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    var reason = $("#rejectreason").val();
                    var rejectdata = {
                        Empid: Empid,
                        Rejectreason: reason,
                        Flag: 1,
                        Email: EmpEmail
                    }
                    $.ajax({
                        url: webapiurl + "TPOnboarding/RejectDiscontinuationRequest",
                        type: 'POST',
                        data: JSON.stringify(rejectdata),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        headers: {
                            'Authorization': token
                        },
                        beforeSend: function () {
                            $("#ajax_loader").show();
                        },
                        success: function (res) {
                            if (res.status) {
                                toastr.success("Discontinuation Request Rejected Successfully.");
                                loadVoluntarydiscontinuationtData();
                            } else {
                                toastr.warning(res.Message || "This request has already been processed or is not in the correct status for rejection.");
                                loadVoluntarydiscontinuationtData();
                            }
                        },
                        error: function () {
                            //Swal.fire('Error!', 'Something went wrong on the server.', 'error');
                        },
                        complete: function () {
                            $("#ajax_loader").hide();
                        }
                    });
                }
            });

            // add custom class to swal for styling
            setTimeout(function () {
                $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]')
                    .closest('.swal2-popup')
                    .addClass('swal_error');
            }, 50);
        });
        // Reject Button Swal Modal code : End ======================================

        // Releave Now Swal Modal code : Begin ======================================
        $(document).on("click", ".EmpReleaveBtn", function (e) {
            e.preventDefault();
            var table = $('#tblNotice').DataTable();
            var rowData = table.row($(this).closest('tr')).data();
            var Empid = rowData.Empid; 
            Swal.fire({
                html: '<div class="swal_subtitle"><b>Are you sure you want to release it now ?</b><div class="margin-top-10"><label class="margin-right-10"><input value="False" name="Yes" id="YESA" type="radio" checked=""> Yes <span></span> </label><label class=""><input value="True" name="Yes" id="NOA" type="radio"> No <span></span> </label></div></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_info.svg' alt=''>Releave now",
                //closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No',
                confirmButtonText: 'Yes',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {                
                if (result.isConfirmed) {
                    if ($('#YESA').is(':checked')) {
                        $.ajax({
                            url: webapiurl + "TPOnboarding/ReleaveNowTrainee?Empid=" + Empid,
                            type: 'POST',
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            headers: {
                                'Authorization': token
                            },
                            beforeSend: function () {
                                $("#ajax_loader").show();
                            },
                            success: function (res) {                                
                                if (res.status) {
                                    toastr.success("Trainee Releave now Successfully.");
                                    loadNoticePeriodData();
                                }
                            },
                            error: function (err) {
                                console.log("Error in Releave Trainee", err);
                                //Swal.fire('Error!', 'Something went wrong on the server.', 'error');
                            },
                            complete: function () {
                                $("#ajax_loader").hide();
                            }
                        });
                    }
                }
            });

            // add custom class to swal for styling
            setTimeout(function () {
                $('img[src="/assets/images/icons/swal_icon/icon_info.svg"]')
                    .closest('.swal2-popup')
                    .addClass('swal_info');
            }, 50);
        });
        // Releave Now Swal Modal code : End ======================================

        // Retain Now Swal Modal code : Begin ======================================
        $(document).on("click", ".EmpRetainBtn", function (e) {
            var table = $('#tblNotice').DataTable();
            var rowData = table.row($(this).closest('tr')).data();
            var Empid = rowData.Empid; 
            e.preventDefault();
            Swal.fire({
                html: '<div class="swal_subtitle"><b>Are you sure you want to retain this employee?</b><div class="margin-top-10"><label class="margin-right-10"><input value="False" name="Yes" id="YESA" type="radio" checked=""> Yes <span></span> </label><label class=""><input value="True" name="Yes" id="NOA" type="radio"> No <span></span> </label></div></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Retain now",
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No',
                confirmButtonText: 'Yes',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    if ($('#YESA').is(':checked')) {
                        $.ajax({
                            url: webapiurl + "TPOnboarding/RetainTrainee?Empid=" + Empid,
                            type: 'POST',
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            headers: {
                                'Authorization': token
                            },
                            beforeSend: function () {
                                $("#ajax_loader").show();
                            },
                            success: function (res) {                                
                                if (res.status) {
                                    toastr.success("Trainee Retain Successfully.")
                                    loadNoticePeriodData();
                                }
                            },
                            error: function (err) {
                                console.log("Error in Retain Trainee", err);
                                //Swal.fire('Error!', 'Something went wrong on the server.', 'error');
                            },
                            complete: function () {
                                $("#ajax_loader").hide();
                            }
                        });
                    }
                }
            });

            // add custom class to swal for styling
            setTimeout(function () {
                $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]')
                    .closest('.swal2-popup')
                    .addClass('swal_success');
            }, 50);
        });
        // Retain Now Swal Modal code : End ======================================

        $("#tblFandF").on('click', '.releasedoc', function () {
            var table = $('#tblFandF').DataTable();
            var rowData = table.row($(this).closest('tr')).data();
            var Empid = rowData.Empid; 
            $.ajax({
                url: webapiurl + "TPOnboarding/ReleaseDocumentOftrainee?Empid=" + Empid,
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
