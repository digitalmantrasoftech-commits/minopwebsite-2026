                                                <a href="javascript:;" id="" class="btn blue_btnnew tooltips" data-placement="left" data-original-title="Release Document" disabled><i class="fa-regular fa-file-check"></i></a>
                                            </td>
                                        </tr>*@
                                    </tbody>
                                </table>
                            </div>

                            <!-- NoDataFound Block : End -->
                            <div id="NotificationGrid-emptyFF" style="display: none;">
                                <div class="datanotfound">
                                    <img src="~/assets/images/emptyscreen_1.png" height="148" width="280" alt="Nodata Found Icon">
                                    <p class="datanotfound_title">No data found</p> <!-- titleText -->
                                    <p class="">No entries found. Please add a record to get started.</p><!-- subText -->
                                </div>
                            </div>
                            <!-- NoDataFound Block : End -->

                        </div>
                    </div>
                </div>
            </div>
            <!-- Datatable Block : End -->
        </div>
    </div>
</div>
<!-- Body Block : End -->
<!-- HR Approval Modal : Begin -->
<div id="ApproveBtn_modal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog w-500">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Voluntary Discontinuation Request</h4>
            </div>
            <div class="modal-body">
                <div class="modal-card">
                    <div class="row empresign_card">
                        <div class="manager_block">Approved by manager</div>
                        <div class="border-bottom">
                            <div class="col-lg-6 col-md-6" style="display:none">
                                <div class="r_title">Employee name</div>
                                <div class="r_subtitle" id="mdlEmpid"></div>
                                <input type="hidden" id="mdlEmpEmail" />
                            </div>
                            <div class="col-lg-6 col-md-6" style="display:none">
                                <div class="r_title">Employee name</div>
                                <div class="r_subtitle" id="mdlStatus"></div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="r_title">Employee name</div>
                                <div class="r_subtitle" id="mdlEmpName"></div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="r_title">Reason type</div>
                                <div class="r_subtitle" id="mdlReasonType"></div>
                            </div>
                            <div class="col-lg-12">
                                <div class="r_title">Description</div>
                                <div class="r_subtitle" id="mdlDescription"></div>
                            </div>
                            <div class="col-lg-4 col-md-4">
                                <div class="r_title">GW</div>
                                <div class="r_subtitle" id="mdlGW"></div>
                            </div>
                            <div class="col-lg-4 col-md-4">
                                <div class="r_title">Workstation</div>
                                <div class="r_subtitle" id="mdlWorkstation"></div>
                            </div>
                        </div>
                        <div class="border-bottom">
                            <div class="col-lg-4 col-md-4">
                                <div class="r_title">Last working day (Employee)</div>
                                <div class="r_subtitle" id="mdlLastWorkingDay2"></div>
                            </div>
                            <div class="col-lg-4 col-md-4">
                                <div class="r_title">Last working day (Manager)</div>
                                <div class="r_subtitle" id="mdlLastWorkingDayConfirm"></div>
                            </div>
                            <div class="col-lg-4 col-md-4">
                                <div class="r_title">Last working day (HR)</div>
                                <div class="r_subtitle" id="mdlLastWorkingDayByHR"></div>
                            </div>
                        </div>
                        <div>
                            <div class="col-lg-12">
                                <div class="r_title">Manager’s remarks</div>
                                <div class="r_subtitle" id="mdlManagerRemark"></div>
                            </div>
                        </div>
                    </div>
                </div>
                @if (_RoleId == 1 || _RoleId == 6805)
                {
                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="form-group data_picker_box">
                                <label class="control-label">Set Last working day <span class="required" aria-required="true">*</span></label>
                                <div class="input-group input-group-sm date date-picker" id="" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                                    <span class="input-group-btn">
                                        <button class="btn default" type="button">
                                            <i class="fa-light fa-calendar-days"></i>
                                        </button>
                                    </span>
                                    <input type="text" class="form-control" id="lastdaybyBHR" value="" onkeydown="return false" data-date-format="@_isdateformat" placeholder="@_isdateformat.Replace(" M","MMM")" autocomplete="off">
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="col-md-12">
