@using System.Configuration;
@{
    ViewBag.Title = "Exitflow";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _cmpid = 0;
    if (_RoleId == 6805 || _RoleId == 1)
    {
        _cmpid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"]);
    }
}

<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">
<link href="/Newlayout/css/CustomDesign/mysubscription.css" rel="stylesheet">

<style type="text/css">
    .page-content-white .page-bar {
        min-height: auto;
    }

    .fixed-column {
        width: 90px !important;
        min-width: 90px !important;
        right: 0px;
        position: sticky !important;
        background-color: #fff !important;
        box-shadow: -1px 0px 3px 0px rgba(0, 0, 0, 0.20);
    }

    .stepwizard_vertical .stepwizard_vertical_content_list .stepwizard_content_wrapper {
        height: auto;
        padding: 0;
    }

    .fileinput {
        width: 100%;
    }

    #ajax_loader {
        z-index: 11111;
    }
</style>

<script>    
    const token = '@_tokan';
    const webapiurl = '@_webapiurl';
    const Roleid = '@_RoleId';
    const Companyid = '@_cmpid';
    $(document).ready(function () {
        checkSession();
        var $firstTab = $('.nav-tabs .nav-item:first-child a');

        if ($firstTab.length > 0) {
