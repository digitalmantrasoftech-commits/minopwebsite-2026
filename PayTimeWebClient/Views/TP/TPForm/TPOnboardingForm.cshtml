                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Emergency Contact Person Name</label>
                            <input type="text" id="EName" class="form-input" placeholder="Enter Contact Person Name">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Emergency Contact Person Relation</label>
                            <select class="form-select Relation" id="ERelation">
                                <option value="">Select</option>
                                <option value="Father">Father</option>
                                <option value="Mother">Mother</option>
                                <option value="Spouse">Spouse</option>
                                <option value="Guardian">Guardian</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Emergency Contact Person Number</label>
                            <input type="text" id="ENumber" class="form-input" placeholder="Enter Contact Person Number" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Transport Nodal Pick‑Up Point</label>
                            <select class="form-control js-states" id="Pickup">
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Any blood relation working in TP Solar(Mandatory)</label>
                        <div class="radio-group">
                            <div class="radio-item">
                                <input type="checkbox" id="relation-yes" name="relation">
                                <label for="relation-yes">Yes</label>
                            </div>
                            <div class="radio-item">
                                <input type="checkbox" id="relation-no" name="relation">
                                <label for="relation-no">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" style="display:none" id="detail-section">
                        <label class="form-label">Please provide the details.</label>
                        <input type="text" id="detail" class="form-input" placeholder="Provide details">
                    </div>
                </div>
            </div>

            <div class="form-footer">
                <button type="button" id="resetform" class="btn-secondary">Reset</button>
                <button type="submit" id="btnSubmit" class="btn-primary">Submit</button>
            </div>
        </form>

        <!-- Success Block -->
        <div class="success-card" style="display:none" id="successblock">
            <div class="success-card-body">
                <div class="success-message">
                    <div class="success-icon">
                        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13.3333 4L6 11.3333L2.66667 8" stroke="white" stroke-width="2"
                                  stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </div>
                    <span class="success-title">We've Captured your details and will get back to you soon.</span>
                </div>
            </div>
            @*<div class="success-card-footer">
                <button class="btn-primary">Back to home</button>
            </div>*@
        </div>
    </div>
</main>

