            $("label[for='filePhoto']").text("Upload photo");
            $(".custom-file-label, .file-name, .upload-text").css({
                "color": "",
                "font-weight": ""
            });
        });

        $('#RejectBtn').on('click', function () {
            $.ajax({
                type: "POST",
                url: "your-url-here",
                data: { id: 1 },
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
