                        timer: 2000
                    });
                }
            });
        });

        $("#addblock").click(function () {
            let newBlock = $(".education-block:first").clone();

            newBlock.addClass("block1");
            newBlock.find("input").val("");
            newBlock.find("select").prop("selectedIndex", 0);
            newBlock.find(".closeBlock").show();

