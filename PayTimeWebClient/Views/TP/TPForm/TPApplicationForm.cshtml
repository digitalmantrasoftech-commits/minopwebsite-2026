@using System.Configuration;
@{
    ViewBag.Title = "TPApplicationForm";
    Layout = "";
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
}
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1" name="viewport" />
</head>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/AssetsNew/plugins/toastr/toastr.js"></script>
<link href="~/Content/toastr.min.css" rel="stylesheet" />
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Roboto', sans-serif;
        background-color: #f5f5f7;
        min-height: 100vh;
        font-size: 13px;
    }

    /* Header Styles */
    .header {
        background-color: #ffffff;
        border-bottom: 2px solid #1b69b2;
        padding: 8px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
    }

    .header-left {
        display: flex;
        flex-direction: column;
    }

    .company-name {
        font-family: 'Segoe UI', sans-serif;
        font-weight: 700;
        font-size: 24px;
        color: #1b69b2;
        line-height: 1.2;
    }

    .company-subtitle {
        font-family: 'Segoe UI', sans-serif;
        font-size: 12px;
        color: #333;
        font-weight: 500;
    }

    .company-subtitle .tata-bold {
        font-weight: 700;
        color: #1b69b2;
    }

    .header-right img {
        height: 40px;
        width: auto;
    }

    /* Main Content */
    .main-content {
        padding: 16px 86px;
    }

    /* Hero Section */
    .hero-section {
        background-color: #e8e8ed;
        border-radius: 8px !important;
        padding: 8px 40px 0px 40px;
        display: flex;
        gap: 16px;
        align-items: center;
        margin-bottom: 24px;
    }

    .hero-content {
        flex: 1;
        color: #333333;
    }

    .hero-logo {
        height: auto;
        width: auto;
        margin-bottom: 12px;
    }

    .hero-welcome {
        font-family: 'Segoe UI', sans-serif;
        font-weight: 600;
        font-size: 16px;
        color: #295097;
    }

    .hero-image {
        width: 400px;
        height: auto;
        object-fit: contain;
    }

    /* Track Request Section */
    .track-section {
        display: flex;
        justify-content: center;
        margin-bottom: 24px;
    }

    .track-container {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .track-input {
        width: 350px;
        height: 40px;
        border: 1px solid #c4c4c4;
        border-radius: 4px !important;
        padding: 11px 12px;
        font-size: 14px;
        color: #555555;
        background-color: #ffffff;
    }

        .track-input::placeholder {
            color: #555555;
            opacity: 0.5;
        }

    .btn-submit {
        background-color: #2196f3;
        color: #ffffff;
        border: 2px solid #2196f3;
        border-radius: 4px !important;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        height: 40px;
    }

        .btn-submit:hover {
            background-color: #1976d2;
            border-color: #1976d2;
        }

    /* Application Form Section */
    .form-section-title {
        text-align: center;
        font-size: 16px;
        font-weight: 500;
        color: #1b69b2;
        margin-bottom: 16px;
    }

    .application-form {
        background-color: #ffffff;
        border: 1px solid #c9c9c9;
        border-radius: 8px !important;
        max-width: 750px;
        margin: 0 auto;
        overflow: hidden;
    }

    .form-header {
        background-color: #f7f8fa;
        border-bottom: 1px solid #c9c9c9;
        padding: 10px 16px;
    }

    .form-header-text {
        font-size: 16px;
        font-weight: 500;
        color: #252525;
    }

    .form-body {
        padding: 16px;
        flex: 1;
        overflow-y: auto;
        max-height: calc(100vh - 160px);
    }

    .form-section {
        margin-bottom: 20px;
    }

    .section-title {
        font-size: 14px;
        font-weight: 700;
        color: #034694;
        padding-bottom: 12px;
        border-bottom: 1px solid #e0e0e0;
        margin-bottom: 10px;
    }

    .form-row {
        display: flex;
        gap: 16px;
        margin-bottom: 12px;
    }

    .form-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .form-group.half {
            flex: 0 0 calc(50% - 8px);
        }

        .form-group.quarter {
            flex: 1;
        }

    .form-label {
        font-size: 14px;
        font-weight: 400;
        color: #333333;
    }

    .form-input,
    .form-select {
        height: 40px;
        border: 1px solid #c4c4c4;
        border-radius: 4px !important;
        padding: 8px 12px;
        font-size: 14px;
        color: #555555;
        background-color: #ffffff;
        width: 100%;
    }

        .form-input::placeholder {
            color: #555555;
            opacity: 0.5;
        }

    .form-select {
        appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M5 7.5L10 12.5L15 7.5' stroke='%23555555' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 12px center;
        padding-right: 40px;
        cursor: pointer;
    }

        .form-select option[value=""] {
            color: #555555;
            opacity: 0.5;
        }

    /* Upload Field */
    .upload-field {
        border: 1px dashed #ccc;
        padding: 12px;
        width: 100%;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        border-radius: 6px !important;
    }

        .upload-field:hover {
            background: #f5f5f5;
        }

    .upload-icon {
        width: 20px;
        height: 20px;
    }

    .upload-text {
        color: #888;
        font-size: 14px;
    }

    /* Add Button */
    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background-color: #ffffff;
        border: 1px solid #1077da;
        border-radius: 4px !important;
        padding: 8px 16px 8px 12px;
        font-size: 14px;
        font-weight: 500;
        color: #1077da;
        cursor: pointer;
        margin-bottom: 10px;
    }

        .btn-add:hover {
            background-color: #f0f7ff;
        }

        .btn-add svg {
            width: 20px;
            height: 20px;
        }

    /* Form Footer */
    .form-footer {
        background-color: #f7f8fa;
        border-top: 1px solid #c9c9c9;
        padding: 10px 16px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-reset {
        background-color: #ffffff;
        border: 1px solid #c9c9c9;
        border-radius: 4px !important;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #252525;
        cursor: pointer;
        font-family: 'Roboto', sans-serif;
    }

        .btn-reset:hover {
            background-color: #f5f5f5;
        }

    .btn-primary {
        background-color: #2196f3;
        border: 2px solid #2196f3;
        border-radius: 4px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #ffffff;
        cursor: pointer;
        font-family: 'Roboto', sans-serif;
    }

        .btn-primary:hover {
            background-color: #1976d2;
            border-color: #1976d2;
        }

    /* ID Proofs Row with Input and Upload */
    .id-proof-row {
        display: flex;
        gap: 16px;
    }

        .id-proof-row .form-input {
            flex: 1;
        }

        .id-proof-row .upload-field {
            flex: 1;
        }

    /* Extra Css */
    .education-block.block1 {
        border: 1px solid #686868;
        padding: 16px;
        border-radius: 4px !important;
        margin-bottom: 16px;
        position: relative;
    }

        .education-block.block1 .mb-0 {
            margin-bottom: 0;
        }

    .closeicon {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 11;
    }

    /* Success Card */
    .success-card {
        background-color: #ffffff;
        border: 1px solid #c9c9c9;
        border-radius: 8px;
        max-width: 750px;
        margin: 0 auto;
        overflow: hidden;
    }

    .success-card-body {
        padding: 16px;
    }

    .success-message {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 16px;
    }

    .success-icon {
        width: 20px;
        height: 20px;
        background-color: #34c759;
        border-radius: 50% !important;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .success-icon svg {
            width: 16px;
            height: 16px;
        }

    .success-title {
        font-size: 16px;
        font-weight: 500;
        color: #034694;
        flex: 1;
    }

    .success-description {
        font-size: 14px;
        color: #252525;
        line-height: 1.4;
        margin: 0;
    }

    .success-card-footer {
        background-color: #f7f8fa;
        border-top: 1px solid #c9c9c9;
        padding: 16px;
        display: flex;
        justify-content: flex-end;
    }

    /* Track Request Card */
    .track-card {
        background-color: #ffffff;
        border: 1px solid #c9c9c9;
        border-radius: 8px;
        max-width: 750px;
        margin: 0 auto;
        overflow: hidden;
    }

    .track-card-header {
        border-bottom: 1px solid #c9c9c9;
        padding: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .track-card-title {
        font-size: 16px;
        font-weight: 500;
        color: #252525;
    }

    .track-card-body {
        padding: 16px;
    }

    /* Timeline Styles */
    .timeline {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .timeline-item {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
    }

    .timeline-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .timeline-icon.completed {
            background-color: #34c759;
        }

        .timeline-icon.pending {
            background-color: #f0f0f0;
        }

        .timeline-icon.rejected {
            background-color: #c34242;
        }

        .timeline-icon svg {
            width: 16px;
            height: 16px;
        }

    .timeline-content {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .timeline-text {
        font-size: 14px;
        color: #333333;
    }

    .timeline-badge {
        background-color: #f0f0f0;
        padding: 4px 6px;
        border-radius: 4px;
        font-size: 12px;
        color: #252525;
    }

    .timeline-line {
        width: 4px;
        height: 24px;
        background-color: #f0f0f0;
        position: relative;
    }

        .timeline-line.partial {
            background: linear-gradient(to bottom, #34c759 50%, #f0f0f0 50%);
        }

    /* Action Message Box */
    .action-message {
        display: flex;
        align-items: center;
        gap: 10px;
        background-color: #f0f0f0;
        padding: 8px;
        border-radius: 8px;
        margin-left: 32px;
        margin-top: -8px;
        margin-bottom: 8px;
    }

    .action-message-text {
        font-size: 14px;
        color: #295097;
        flex: 1;
    }

    .action-message-arrow {
        font-weight: 500;
    }

    .btn-secondary {
        background-color: #ffffff;
        border: 1px solid #c9c9c9;
        border-radius: 4px;
        padding: 6px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #252525;
        cursor: pointer;
    }

        .btn-secondary:hover {
            background-color: #f5f5f5;
        }

    /* Loading Style */
    .loading {
        z-index: 10000000000;
        padding-top: 250px;
    }

    .modal_bg {
        position: fixed;
        background: rgb(0 0 0 / .65);
        top: 0;
        right: 0;
        left: 0;
        z-index: 9999999;
        text-align: center;
        width: 100%;
        height: 100%;
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .main-content {
            padding: 24px 40px;
        }

        .hero-image {
            width: 300px;
        }
    }

    @@media (max-width: 992px) {
        .hero-section {
            flex-direction: column;
        }

        .hero-image {
            width: 100%;
            max-width: 400px;
        }

        .form-row {
            flex-direction: column;
        }

        .form-group.half,
        .form-group.quarter {
            flex: 1;
        }
    }

    @@media (max-width: 768px) {
        .main-content {
            padding: 10px;
        }

        .track-container {
            flex-direction: column;
            width: 100%;
        }

        .track-input {
            width: 100%;
        }

        .btn-submit {
            width: 100%;
        }

        .id-proof-row {
            flex-direction: column;
        }

        .form-header {
            padding: 8px;
        }

        .form-footer {
            padding: 8px;
        }
    }
</style>
<script>
     var token = '@_tokan';
     var webapiurl = '@_webapiurl';
    $(document).ready(function () {
        // Set DOB max date to 18 years ago
        var maxDOB = new Date();
        maxDOB.setFullYear(maxDOB.getFullYear() - 18);
        var maxDOBStr = maxDOB.toISOString().split('T')[0];
        $("#DOB").attr("max", maxDOBStr);

        var appId = sessionStorage.getItem("currentAppId");
        //appId ='987456321456_36';
        console.log(appId);
        if (!appId || appId === "0") {
            console.log("New application");
        } else {
            loadApplicationData(appId);
        }
        loadStates();
        loadReligion();
        $("#Email").on("blur", function () {
            var email = $(this).val().trim();
            var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            if (email === "" || !emailPattern.test(email)) {
                return;
            }

            $.ajax({
                type: "GET",
                url: webapiurl + "TPOnboarding/CheckEmailExists",
                headers: {
                    "Authorization": token
                },
                data: { email: email },
                success: function (res) {
                    if (res[0].EmailCount > 0) {
                        toastr.error("Email already exists. Please use another.");
                        $("#Email").val("").focus();
                    }
                }
            });
        });
        $('#Disabilities').change(function () {
            if ($(this).val() == "1") {
                $('#disabilityDetailContainer').fadeIn();
            } else {
                $('#disabilityDetailContainer').fadeOut();
                $('#DesablitiesDetail').val('');
            }
        });
        $("#mobileno").on("blur", function () {
            var mobile = $(this).val().trim();
            if (mobile === "") return;

            $.ajax({
                type: "GET",
                url: webapiurl + "TPOnboarding/CheckMobileExists",
                headers: {
                    "Authorization": token
                },
                data: { mobile: mobile },
                success: function (res) {
                    if (res[0].MobileCount > 0) {
                        toastr.error("Mobile number already exists. Please use another.");
                        $("#mobileno").val("").focus();
                    }
                }
            });
        });



        var isSubmitting = false;
        $("#btnSubmit").click(async function (e) {
         
            e.preventDefault();
            if (isSubmitting) return false;
            toastr.remove();
            var appId = sessionStorage.getItem("currentAppId");
            var isUpdate = (appId && appId !== "0" && appId !== "null");
            var TName = $("#TName").val().trim();
            var FatherName = $("#fatherName").val().trim();
            var FIncome = $("#FIncome").val();
            var DOB = $("#DOB").val();
            var Mobileno = $("#mobileno").val().trim();
            var Email = $("#Email").val().trim();
            var Category = $("#Category").val();
            var Religion = $("#Religion").val();
            var Gender = $("#Gender").val();
            var Address1 = $("#address1").val().trim();
            var Address2 = $("#address2").val().trim();
            var Distance = $("#distance").val().trim();
            var Aadharno = $("#Aadharno").val().trim();
            var Panno = $("#Panno").val().trim();
            var State = $("#State").val();
            var District = $("#District").val().trim();
            var City = $("#City").val().trim();
            var Pincode = $("#Pincode").val().trim();
            var MaritalStatus = $("#MaritalStatus").val();
            var Hostel = $("#Hostel").val();
            var disability = $("#Disabilities").val();
            var disabilitydetail = $("#DesablitiesDetail").val().trim();

            var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            var mobilePattern = /^[6-9]\d{9}$/;
            var aadharPattern = /^\d{12}$/;
            var panPattern = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;
            var pincodeRegex = /^[1-9][0-9]{5}$/;
            var gradeRegex = /^\d+(\.\d{2})?$/;

            if (TName === "") {
                $("#TName").focus();
                toastr.remove();
                toastr.error("Please Enter Name As per Aadhar Card.");
                return false;
            }

            if (FatherName === "") {
                $("#fatherName").focus();
                toastr.remove();
                toastr.error("Please Enter Father Name.");
                return false;
            }

            if (FIncome === "") {
                $("#FIncome").focus();
                toastr.remove();
                toastr.error("Please Select Income.");
                return false;
            }

            if (DOB === "") {
                $("#DOB").focus();
                toastr.remove();
                toastr.error("Please Enter Date of Birth.");
                return false;
            }

            // Age validation - must be at least 18 years old
            var dobDate = new Date(DOB);
            var today = new Date();
            var age = today.getFullYear() - dobDate.getFullYear();
            var monthDiff = today.getMonth() - dobDate.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dobDate.getDate())) {
                age--;
            }
            if (age < 18) {
                $("#DOB").focus();
                toastr.remove();
                toastr.error("Employee must be at least 18 years old.");
                return false;
            }

            if (Mobileno === "") {
                $("#mobileno").focus();
                toastr.remove();
                toastr.error("Please Enter Mobile Number.");
                return false;
            }
            else if (!mobilePattern.test(Mobileno)) {
                $("#mobileno").focus();
                toastr.remove();
                toastr.error("Please Enter a Valid 10-digit Mobile Number.");
                return false;
            }

            if (Email === "") {
                $("#Email").focus();
                toastr.remove();
                toastr.error("Please Enter Email.");
                return false;
            }
            else if (!emailPattern.test(Email)) {
                $("#Email").focus();
                toastr.remove();
                toastr.error("Please Enter a Valid Email.");
                return false;
            }

            if (Category === "") {
                $("#Category").focus();
                toastr.remove();
                toastr.error("Please Select Category.");
                return false;
            }

            if (Religion === "") {
                $("#Religion").focus();
                toastr.remove();
                toastr.error("Please Select Religion.");
                return false;
            }
            if (MaritalStatus === "") {
                $("#MaritalStatus").focus();
                toastr.remove();
                toastr.error("Please Select Marital Status.");
                return false;
            }
            if (Hostel === "") {
                $("#Hostel").focus();
                toastr.remove();
                toastr.error("Please Select Hostel Status.");
                return false;
            }
            if (disability === "") {
                $("#Disabilities").focus();
                toastr.remove();
                toastr.error("Please Select Disabilities Yes or No.");
                return false;
            }
            if (disability === "1" && disabilitydetail === "") {
                $("#DesablitiesDetail").focus();
                toastr.remove();
                toastr.error("Please Provide The Detail of Disabilities.");
                return false;
            }

            if (Gender === "") {
                $("#Gender").focus();
                toastr.remove();
                toastr.error("Please Select Gender.");
                return false;
            }

            if (Address1 === "") {
                $("#address1").focus();
                toastr.remove();
                toastr.error("Please Enter Address.");
                return false;
            }

            if (Distance === "") {
                $("#distance").focus();
                toastr.remove();
                toastr.error("Please Enter Distance of TPSolar.");
                return false;
            }
            else if (isNaN(Distance) || parseFloat(Distance) <= 0) {
                $("#distance").focus();
                toastr.remove();
                toastr.error("Please Enter a valid numeric Distance.");
                return false;
            }
            if (State == "") {
                $("#State").focus();
                toastr.remove();
                toastr.error("Please Select State.");
                return false;
            }
            if (District == "") {
                $("#District").focus();
                toastr.remove();
                toastr.error("Please Enter District.");
                return false;
            }
            if (City == "") {
                $("#City").focus();
                toastr.remove();
                toastr.error("Please Enter City.");
                return false;
            }
            if (Pincode == "") {
                $("#Pincode").focus();
                toastr.remove();
                toastr.error("Please Enter Pincode.");
                return false;
            } else if (!pincodeRegex.test(Pincode)) {
                $("#Pincode").focus();
                toastr.remove();
                toastr.error("Please Enter Valid 6 Digit Pincode.");
                return false;
            }

            var isValid = true;
            var educationArray = [];

            $('.education-block').each(function (index) {
                var qualification = $(this).find('.qualification').val();
                var stream = $(this).find('.stream').val();
                var specialization = $(this).find('.specialization').val();
                var month = $(this).find('.month').val();
                var year = $(this).find('.year').val();
                var grade = $(this).find('.grade').val().trim();
                var university = $(this).find('.university').val().trim();

                if (!qualification) {
                    $(".qualification").focus();
                    toastr.remove();
                    toastr.error('Please Select Education Qualification.');
                    isValid = false;
                    return false; // break loop
                }
                if (!stream) {
                    $(".stream").focus();
                    toastr.remove();
                    toastr.error('Please Select Education Stream,');
                    isValid = false;
                    return false;
                }
                if (!month) {
                    $(".month").focus();
                    toastr.remove();
                    toastr.error('Please Select Education Passing Month.');
                    isValid = false;
                    return false;
                }
                if (!year || isNaN(year)) {
                    $(".year").focus();
                    toastr.remove();
                    toastr.error('Please Select Education Passing Year.');
                    isValid = false;
                    return false;
                }
                if (!specialization) {
                    $(".specialization").focus();
                    toastr.remove();
                    toastr.error('Please Enter Education Specilization.' );
                    isValid = false;
                    return false;
                }
                if (!grade) {
                    $(".grade").focus();
                    toastr.remove();
                    toastr.error('Please Enter Education Percentage/CGPA.');
                    isValid = false;
                    return false;
                } else if (!gradeRegex.test(grade)) {
                    $(".grade").focus();
                    toastr.remove();
                    toastr.error('Please Enter a numeric value with 2 decimal places (e.g.90.00).');
                    isValid = false;
                    return false;
                }
                var numericGrade = parseFloat(grade);
                if (numericGrade > 100 || numericGrade < 0) {
                    $(".grade").focus();
                    toastr.remove();
                    toastr.error('Percentage/CGPA cannot exceed 100 in entry.');
                    isValid = false;
                    return false;
                }
                if (!university) {
                    $(".university").focus();
                    toastr.remove();
                    toastr.error('Please Enter University/Institution Name.');
                    isValid = false;
                    return false;
                }

                // If valid, push to educationArray
                educationArray.push({
                    qualification: qualification,
                    stream: stream,
                    specialization: specialization,
                    month: month,
                    year: year,
                    grade: grade,
                    university: university
                });
            });
            if (!isValid) return false;
            if (Aadharno === "") {
                $("#Aadharno").focus();
                toastr.remove();
                toastr.error("Please Enter Aadhar Number.");
                return false;
            }
            else if (!aadharPattern.test(Aadharno)) {
                $("#Aadharno").focus();
                toastr.remove();
                toastr.error("Invalid Aadhar! Please enter 12 digits.");
                return false;
            }

            if (Panno === "") {
                $("#Panno").focus();
                toastr.remove();
                toastr.error("Please Enter PAN Number.");
                return false;
            }
            else if (!panPattern.test(Panno)) {
                $("#Panno").focus();
                toastr.remove();
                toastr.error("Invalid PAN Format! (Ex: ABCDE1234F)");
                return false;
            }
            var fileData = new FormData();

            var aadharFile = $("#fileAadhar")[0].files[0];
            var panFile = $("#filePan")[0].files[0];
            var photoFile = $("#filePhoto")[0].files[0];
            if (!aadharFile && !existingAadharPath) {
                $("#fileAadhar").focus();
                toastr.error("Please upload Aadhar Document.");
                return false;
            }
            if (aadharFile && aadharFile.size > 1 * 1024 * 1024) {
                $("#fileAadhar").focus();
                toastr.error(`${aadharFile.name} is over 1 MB.`);
                return;
            }
            if (!panFile && !existingPanPath) {
                $("#filePan").focus();
                toastr.error("Please upload PAN Document.");
                return false;
            }
            if (panFile && panFile.size > 1 * 1024 * 1024) {
                $("#filePan").focus();
                toastr.error(`${panFile.name} is over 1 MB.`);
                return;
            }
            if (!photoFile && !existingPhotoPath) {
                $("#filePhoto").focus();
                toastr.error("Please upload Photo.");
                return false;
            }
            if (photoFile && photoFile.size > 1 * 1024 * 1024) {
                $("#filePhoto").focus();
                toastr.error(`${photoFile.name} is over 1 MB.`);
                return;
            }

            isSubmitting = true;
            $("#btnSubmit").prop("disabled", true);

            var uploadResult = null;

            if (aadharFile || panFile || photoFile) {

                var fileData = new FormData();
                if (aadharFile) fileData.append("AadharFile", aadharFile);
                if (panFile) fileData.append("PanFile", panFile);
                if (photoFile) fileData.append("PhotoFile", photoFile);

                try {
                    uploadResult = await $.ajax({
                        type: "POST",
                        url: "/TP/UploadEmployeeDocuments",
                        data: fileData,
                        contentType: false,
                        processData: false
                    });
                } catch (uploadErr) {
                    toastr.error("Error uploading documents.");
                    isSubmitting = false;
                    $("#btnSubmit").prop("disabled", false);
                    return;
                }

                if (typeof uploadResult === "string") {
                    toastr.error(uploadResult);
                    isSubmitting = false;
                    $("#btnSubmit").prop("disabled", false);
                    return;
                }
            }
            var finalAadharPath = uploadResult?.AadharPath || existingAadharPath;
            var finalPanPath = uploadResult?.PanPath || existingPanPath;
            var finalPhotoPath = uploadResult?.PhotoPath || existingPhotoPath;

            var finalAadharName = uploadResult?.AadharName || existingAadharName;
            var finalPanName = uploadResult?.PanName || existingPanName;
            var finalPhotoName = uploadResult?.PhotoName || existingPhotoName;

            var applicationdata = {
                trackingId: isUpdate ? appId : "",
                TName: TName,
                FatherName: FatherName,
                FIncome: FIncome,
                DOB: DOB,
                Mobileno: Mobileno,
                Email: Email,
                Category: Category,
                Religion: Religion,
                MaritalStatus: MaritalStatus,
                Hostel: Hostel,
                Isdisablity:disability,
                Disabilitydetail:disabilitydetail,
                Gender: Gender,
                Address1: Address1,
                Distance: Distance,
                Address2: Address2,
                Aadharno: Aadharno,
                Panno: Panno,
                State: State,
                District: District,
                City: City,
                Pincode: Pincode,
                eduid:Eduid,
                education: educationArray,
                AadharPath: finalAadharPath,
                PanPath: finalPanPath,
                PhotoPath: finalPhotoPath,
                AadharOriginalName: finalAadharName,
                PanOriginalName: finalPanName,
                PhotoOriginalName: finalPhotoName
            };
            $("#ajax_loader").show();
            var targetUrl = isUpdate
                ? webapiurl + "TPOnboarding/TPApplicationDataUpdate"
                : webapiurl + "TPOnboarding/TPApplicationDataAdd";
            $.ajax({
                type: "POST",
                url: targetUrl,
                contentType: "application/json; charset=utf-8",
                headers: {
                    "Authorization": token
                },
                dataType: "json",
                data: JSON.stringify(applicationdata),
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (res) {
                    $("#ajax_loader").hide();
                    if (isUpdate) {
                        $("#applicatioform").hide();
                        $("#applicationname").hide();
                        $("#succesmessage").show();
                        $("#applicatioid").text("Your Information Update Successfully. Your Application ID is: " + appId);
                        ChangeStatus(appId);
                    }
                    else {
                        $("#applicatioform").hide();
                        $("#applicationname").hide();
                        $("#succesmessage").show();
                        $("#applicatioid").text("Your Application ID is: " + res.TrackingId);
                    }
                },
                error: function (error) {
                    console.log(error);
                    toastr.error("Error Occur In Submit The Form.");
                    isSubmitting = false;
                    $("#btnSubmit").prop("disabled", false);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });

        });
        $("#trackapplication").click(function () {
            var applicationid = $("#applicationid").val().trim();
            if (applicationid === "") {
                toastr.remove();
                toastr.error("Please enter Application ID");
                return;
            }
            $.ajax({
                url: webapiurl +'/TPOnboarding/TrackApplication',
                type: 'GET',
                headers: {
                    "Authorization": token
                },
                data: { applicationId: applicationid },
                success: function (res) {
                    if (!res || !res.data || res.data.length === 0) {
                        toastr.error("Application not found.");
                        return;
                    }

                    $("#succesmessage").hide();
                    $("#applicatioform").hide();
                    $("#trackrequest").show();

                    var data = res.data[0];
                    var container = $("#timeline-container");
                    container.empty();

                    var appStatus = data.ApplicationStatus;
                    var medStatus = data.MedicalStatus || 'Pending';
                    var eduStatus = data.EducationStatus || 'Pending';

                    var appDate = data.ApplicationDate;
                    var medDate = data.MedicalDate || "";
                    var eduDate = data.EducationDate || "";

                    // Building the Timeline
                    container.append(getTimelineRow("Application Form Fillup", appStatus, appDate));
                    container.append(getTimelineRow("Medical Verification", medStatus, medDate));
                    container.append(getTimelineRow("Education Document Process", eduStatus, eduDate));
                },
                error: function (err) {

                    console.error(err);
                }
            });
        });

        $("#resetForm").click(function () {
            $("#TName, #fatherName, #FIncome, #DOB, #mobileno, #Email, #address1, #address2, #distance, #Aadharno, #Panno, #District, #City, #Pincode").val("");
