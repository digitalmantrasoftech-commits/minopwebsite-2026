                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Marital Status</label>
                        <select class="form-select" id="MaritalStatus">
                            <option value="">Select</option>
                            <option value="1">Married</option>
                            <option value="0">Single</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Hostel Required?</label>
                        <select class="form-select" id="Hostel">
                            <option value="">Select</option>
                            <option value="1">Yes</option>
                            <option value="0">No</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Do you have any disabilities?</label>
                        <select class="form-select" id="Disabilities">
                            <option value="">Select</option>
                            <option value="1">Yes</option>
                            <option value="0">No</option>
                        </select>
                    </div>
                    <div class="form-group" id="disabilityDetailContainer" style="display: none;">
                        <label class="form-label">If yes, please specify the disability type</label>
                        <input id="DesablitiesDetail" type="text" class="form-input" placeholder="Enter Disabilities">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Gender</label>
                        <select class="form-select" id="Gender">
                            <option value="">Select</option>
                            <option value="0">Male</option>
                            <option value="1">Female</option>
                            <option value="2">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Address</label>
                        <input id="address1" type="text" class="form-input" placeholder="Address Line 1">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Distance (in kms) from your home location to TP Solar?</label>
                        <input id="distance" type="text" class="form-input" placeholder="Enter distance" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Address</label>
                        <input id="address2" type="text" class="form-input" placeholder="Address Line 2">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group quarter">
                        <label class="form-label">State</label>
                        <select class="form-select" id="State">
                            <option value="">Select State</option>
                        </select>
                    </div>
                    <div class="form-group quarter">
                        <label class="form-label">District</label>
                        <input id="District" type="text" class="form-input" placeholder="Enter District" oninput="this.value = this.value.replace(/[^A-Za-z\s]/g, '')">
                    </div>
                    <div class="form-group quarter">
                        <label class="form-label">City</label>
                        <input id="City" type="text" class="form-input" placeholder="Enter City" oninput="this.value = this.value.replace(/[^A-Za-z\s]/g, '')">
                    </div>
                    <div class="form-group quarter">
                        <label class="form-label">Pincode</label>
                        <input id="Pincode" type="text" class="form-input" placeholder="Pincode" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                    </div>
                </div>
            </div>

            <!-- Educational Details Section -->
            <div class="form-section educationEntry" id="education_block" style="">
                <h3 class="section-title">Educational Details</h3>
                <div class="education-block">
                    <div class="closeicon closeBlock" style="display:none;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 6L6 18M6 6L18 18" stroke="#e53935" stroke-width="2.5" stroke-linecap="round"></path>
                        </svg>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Highest Education Qualification</label>
                            <select class="form-select qualification">
                                <option value="">Select</option>
                                @*<option value="10th">10th</option>*@
                                @*<option value="12th">12th</option>*@
                                <option value="Graduate">Graduate</option>
                                <option value="ITI">ITI</option>
                                <option value="Diploma">Diploma</option>
                                <option value="Post-Graduate">Post Graduate</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Stream</label>
                            <select class="form-select stream">
                                <option value="">Select</option>
                                <option value="Science">Science</option>
                                <option value="Commerce">Commerce</option>
                                <option value="Arts">Arts</option>
                                <option value="Engineering">Engineering</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Month & Year of Passing</label>
                            <div style="display: flex; gap: 8px;">
                                <select class="form-select month" style="width: 100px;">
                                    <option value="Jan">Jan</option>
                                    <option value="Feb">Feb</option>
                                    <option value="Mar">Mar</option>
                                    <option value="Apr">Apr</option>
                                    <option value="May">May</option>
                                    <option value="Jun">Jun</option>
                                    <option value="Jul">Jul</option>
                                    <option value="Aug">Aug</option>
                                    <option value="Sep">Sep</option>
                                    <option value="Oct">Oct</option>
                                    <option value="Nov">Nov</option>
                                    <option value="Dec">Dec</option>
                                </select>
                                @{
                                    int currentYear = DateTime.Now.Year;
                                }

                                <select class="form-select year" style="flex: 1;">
                                    <option value="">Year</option>

                                    @for (int i = 0; i < 50; i++)
                                    {
                                        var year = currentYear - i;
                                        <option value="@year">@year</option>
                                    }
                                </select>

                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Specialization</label>
                            <input type="text" class="form-input specialization" placeholder="Enter Specialization" oninput="this.value = this.value.replace(/[^A-Za-z\s]/g, '')">
                        </div>
                    </div>

                    <div class="form-row mb-0">
                        <div class="form-group">
                            <label class="form-label">Percentage/CGPA Scored</label>
                            <input type="text" class="form-input grade" placeholder="Percentage/CGPA" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1').replace(/(\.\d{2})./g, '$1'); if(parseFloat(this.value) > 100) this.value = '100';">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label">University/Institution Name</label>
                            <input type="text" class="form-input university" placeholder="Select" oninput="this.value = this.value.replace(/[^A-Za-z\s]/g, '')">
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-add" id="addblock" style="display:none">
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 4V16M4 10H16" stroke="#1077da" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    Add new educational detail
                </button>
            </div>

            <!-- ID Proofs Section -->
            <div class="form-section">
                <h3 class="section-title">ID Proofs</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Aadhar Card Number</label>
                        <div class="id-proof-row">
                            <input id="Aadharno" type="text" class="form-input" placeholder="Enter Aadhar card number" maxlength="12" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">
                            <div style=" display: flex; align-items: center; justify-content: space-between; ">
                                <div>Aadhar Card Photo </div>
                                <span style="font-size: 12px">Size limit to 1 MB</span>
                            </div>
                        </label>
                        <div class="upload-field" onclick="$('#fileAadhar').click();">
                            <svg class="upload-icon" viewBox="0 0 24 24" fill="none" width="24" height="24" stroke="currentColor" stroke-width="2">
                                <path d="M21 15V19C21 19.5304 20.7893 20.0391 20.4142 20.4142C20.0391 20.7893 19.5304 21 19 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V15" />
                                <polyline points="17,8 12,3 7,8" />
                                <line x1="12" y1="3" x2="12" y2="15" />
                            </svg>
                            <span class="upload-text" id="lblAadhar">Upload file (jpg/pdf)</span>
                        </div>
                        <input type="file" id="fileAadhar" style="display:none;" onchange="updateFileName(this, 'lblAadhar')">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">PAN Card Number</label>
                        <div class="id-proof-row">
                            <input id="Panno" type="text" class="form-input" placeholder="Enter PAN Card number">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">
                            <div style=" display: flex; align-items: center; justify-content: space-between; ">
                                <div>PAN Card Photo </div>
                                <span style="font-size: 12px">Size limit to 1 MB</span>
                            </div>
                        </label>
                        <div class="upload-field" onclick="$('#filePan').click();">
                            <svg class="upload-icon" viewBox="0 0 24 24" fill="none" width="24" height="24" stroke="currentColor" stroke-width="2">
                                <path d="M21 15V19C21 19.5304 20.7893 20.0391 20.4142 20.4142C20.0391 20.7893 19.5304 21 19 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V15" />
                                <polyline points="17,8 12,3 7,8" />
                                <line x1="12" y1="3" x2="12" y2="15" />
                            </svg>
                            <span class="upload-text" id="lblPan">Upload file (jpg/pdf)</span>
                        </div>

                        <input type="file" id="filePan" style="display:none;" onchange="updateFileName(this, 'lblPan')">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">
                            <div style=" display: flex; align-items: center; justify-content: space-between; ">
                                <div>Upload your recent passport size photo with white background </div>
                                <span style="font-size: 12px">Size limit to 1 MB</span>
                            </div>
                        </label>
                        <div class="id-proof-row">
                            <div class="upload-field" onclick="$('#filePhoto').click();">
                                <svg class="upload-icon" viewBox="0 0 24 24" fill="none" width="24" height="24" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15V19C21 19.5304 20.7893 20.0391 20.4142 20.4142C20.0391 20.7893 19.5304 21 19 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V15" />
                                    <polyline points="17,8 12,3 7,8" />
                                    <line x1="12" y1="3" x2="12" y2="15" />
                                </svg>
                                <span class="upload-text" id="lblPhoto">Upload file (jpg/pdf)</span>
                            </div>

                            <input type="file" id="filePhoto" style="display:none;" onchange="updateFileName(this, 'lblPhoto')">
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="form-footer">
            <button id="resetForm" type="button" class="btn-reset">Reset</button>
            <button id="btnSubmit" type="submit" class="btn-primary">Submit</button>
        </div>
    </form>
    <div class="success-card" id="succesmessage" style="display:none">
        <div class="success-card-body">
            <div class="success-message">
                <div class="success-icon">
                    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M13.3333 4L6 11.3333L2.66667 8" stroke="white" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <span class="success-title">We've Captured your details and will get back to you soon.</span>
            </div>
            @*<p class="success-description">
                    You'll receive an acknowledgment email with Application ID mentioned in
                    it.
                </p>*@
            <p id="applicatioid" class="success-description"></p>
        </div>
        <div class="success-card-footer" style="display:none">
            <button class="btn-primary">Track Status</button>
        </div>
    </div>

    <div class="track-card" style="display:none" id="trackrequest">
        <div class="track-card-header">
            <span class="track-card-title">Track request</span>
            @*<button class="btn-secondary" onclick="closeTracking()">Close</button>*@
        </div>

        <div class="track-card-body">
            <div class="timeline" id="timeline-container">
            </div>
        </div>
    </div>
</main>

