                },
                error: function (xhr, ajaxOptions, thrownError) {
                    $("#ajax_loader").hide();

                    Swal.fire({
                        html: '<div class="swal_subtitle"><b>Error on punching</b></div>',
                        title: "<img src='error.png' class='swal_img' />",
