    function loadApplicationData(appId)
    {
        $.ajax({
            type: "POST",
            url: webapiurl+"/TPOnboarding/getApplicationDataById",
            headers: {
                "Authorization": token
            },
            data: { appId: appId },
            dataType: 'json',
            success: function (res) {
                if (res.status && res.data) {
                    $("#resetForm").hide();
                    fillApplicationForm(res.data);
                }
            },
            error: function () {
                toastr.error("Failed to load application data");
            }
        });
    }
        var existingAadharName = "";
        var existingAadharPath = "";
        var existingPanName = "";
        var existingPanPath = "";
        var existingPhotoName = "";
        var existingPhotoPath = "";
        var Eduid = "";
        function fillApplicationForm(data) {
            var d = Array.isArray(data) ? data[0] : data;

            const getValue = (obj, key) => {
                if (!obj) return "";
                const value = obj[key]
                    ?? obj[key.charAt(0).toUpperCase() + key.slice(1)]
                    ?? obj[key.toLowerCase()]
                    ?? "";

                return value;
            };

            $("#TName").val(getValue(d, "name"));
            $("#fatherName").val(getValue(d, "fathername"));

            var dateVal = getValue(d, "dob1");

            if (dateVal) {
                var formattedDate = dateVal.split("T")[0];
                $("#DOB").val(formattedDate);
            }
            $("#mobileno").val(getValue(d, "mobileno"));
            $("#Email").val(getValue(d, "emailid"));
            $("#DesablitiesDetail").val(getValue(d, "disabilitydetail"));

            $("#FIncome").val(getValue(d, "familyincome"));
            $("#Category").val(getValue(d, "Category"));
            $("#Religion").val(getValue(d, "ReligionName"));
            $("#MaritalStatus").val(getValue(d, "maritalstatus"));
            $("#Hostel").val(getValue(d, "hostel"));
            $("#Disabilities").val(getValue(d, "IsDisability"));
            var genderValue = d.gender;
            if (genderValue !== null && typeof genderValue !== 'undefined') {
                $("#Gender").val(genderValue.toString()).trigger('change');
            } else {
                $("#Gender").val("").trigger('change');
            }
            $("#address1").val(getValue(d, "address1"));
            $("#address2").val(getValue(d, "address2"));
            $("#distance").val(getValue(d, "distance"));
            $("#District").val(getValue(d, "district"));
            $("#City").val(getValue(d, "city"));
            $("#Pincode").val(getValue(d, "pincode"));
            var religion = getValue(d, "religion");
            var state = getValue(d, "state");
            loadStatesForEdit(state)
            loadReligionForEdit(religion);
            $("#Aadharno").val(getValue(d, "aadharno"));
            $("#Panno").val(getValue(d, "panno"));
            Eduid = d.eduid;
            if (d.aadharfilename) {
                $("#lblAadhar").text(d.aadharfilename);
                existingAadharName = d.aadharfilename;
                existingAadharPath = d.aadharfilepath;
            }

            if (d.panfilename) {
                $("#lblPan").text(d.panfilename);
                existingPanName = d.panfilename;
                existingPanPath = d.panfilepath;
            }

            if (d.photoname) {
                $("#lblPhoto").text(d.photoname);
                existingPhotoName = d.photoname;
                existingPhotoPath = d.photofilepath;
            }

            $(".qualification").val(getValue(d, "qualification"));
            $(".stream").val(getValue(d, "stream"));
            $(".grade").val(getValue(d, "percentage"));
            $(".month").val(getValue(d, "passing_month"));
            $(".year").val(getValue(d, "passing_year"));
            $(".university").val(getValue(d, "universityname"));
            $(".specialization").val(getValue(d, "Specialization"));
        }

    function ChangeStatus(appId) {
        $.ajax({
            url: webapiurl + "TPOnboarding/ChangeStatusOfTrainne",
            type: 'POST',
            headers: { "Authorization": token },
            data: { appId: appId },
            dataType: 'json',
            success: function (response) {
                console.log(response);
            }
        });
    }
    function loadStatesForEdit(selectedId) {
        $.ajax({
            url: webapiurl + "TPOnboarding/GetStates",
            type: 'GET',
            success: function (response) {
                var $el = $('#State');
                $el.empty().append('<option value="">-- Select State --</option>');
                $.each(response, function (i, state) {
                    $el.append(new Option(state.StateName, state.StateId));
                });
                if (selectedId) $el.val(selectedId).trigger('change');
            }
        });
    }
    function loadReligionForEdit(selectedId) {
        $.ajax({
            url: webapiurl + "Master/ReligionGetAll",
            type: 'GET',
            headers: { "Authorization": token },
            success: function (response) {
                var $el = $('#Religion');
                $el.empty().append('<option value="">Select religion</option>');
                $.each(response, function (i, row) {
                    $el.append(new Option(row.ReligionName, row.ReligionId));
                });
                // Set the value after loading all options
                if (selectedId) $el.val(selectedId).trigger('change');
            }
        });
    }

    function loadStates() {
        $.ajax({
            url: webapiurl + "TPOnboarding/GetStates",
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                $('#State').empty();
                $('#State').append('<option value="">-- Select State --</option>');

                $.each(response, function (i, state) {
                    $('#State').append(
                        '<option value="' + state.StateId + '">' + state.StateName + '</option>'
                    );
                });
            },
            error: function () {
                toastr.error('Failed to load states');
            }
        });
    }
    function loadReligion() {
        $.ajax({
            url: webapiurl + "Master/ReligionGetAll",
            type: 'GET',
            headers: {
                "Authorization": token
            },
            success: function (response) {

                $('#Religion').empty();
                $('#Religion').append('<option value="">Select religion</option>');

                $.each(response, function (i, row) {
                    $('#Religion').append(
                        '<option value="' + row.ReligionId + '">' + row.ReligionName + '</option>'
                    );
                });
            },
            error: function () {
                toastr.error('Failed to load religion');
            }
        });
    }
    function updateFileName(input, labelId) {
        if (input.files && input.files[0]) {
            var filename = input.files[0].name;
            $("#" + labelId).text(filename);
        }
    }

    const iconSuccess = `
    <div class="timeline-icon completed">
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13.3333 4L6 11.3333L2.66667 8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </div>`;

    const iconRejected = `
    <div class="timeline-icon rejected">
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 4L4 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M4 4L12 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </div>`;

    const iconPending = `<div class="timeline-icon pending"></div>`;

    function getTimelineRow(baseTitle, status, dateOrRemark) {
        let iconHtml = "";
        let badgeHtml = "";
        let finalTitle = baseTitle;
        let titleColor = "#333";

        if (status == 1) {
            iconHtml = `<div class="timeline-icon completed"><svg viewBox="0 0 16 16" fill="none" stroke="white" stroke-width="2"><path d="M13.3333 4L6 11.3333L2.66667 8" /></svg></div>`;
            titleColor = "green";
            if (dateOrRemark) {
                badgeHtml = `<span class="timeline-badge" style="color:green;">Completed on: ${dateOrRemark}</span>`;
            }
        }
        else if (status == 2) {
            iconHtml = `<div class="timeline-icon rejected"><svg viewBox="0 0 16 16" fill="none" stroke="white" stroke-width="2"><path d="M12 4L4 12" /><path d="M4 4L12 12" /></svg></div>`;
            finalTitle = baseTitle + " (Rejected)";
            titleColor = "red";
            if (dateOrRemark) {
                badgeHtml = `<span class="timeline-badge" style="color:red;">Rejected On: ${dateOrRemark}</span>`;
            }
        }
        else if (status == 3) {
            iconHtml = `<div class="timeline-icon completed"><svg viewBox="0 0 16 16" fill="none" stroke="white" stroke-width="2"><path d="M13.3333 4L6 11.3333L2.66667 8" /></svg></div>`;
            finalTitle = baseTitle + " (Accepted)";
            titleColor = "green";
            if (dateOrRemark) {
                badgeHtml = `<span class="timeline-badge" style="color:green;">Accepted On: ${dateOrRemark}</span>`;
            }
        }
        else {
            iconHtml = `<div class="timeline-icon pending"></div>`;
            finalTitle = baseTitle;

            if (dateOrRemark) {
                badgeHtml = `<span class="timeline-badge" style="color:gray;">Submitted on: ${dateOrRemark}</span>`;
            } else {
                badgeHtml = `<span class="timeline-badge" style="color:gray;">Status: Pending</span>`;
            }
        }

        return `
    <div class="timeline-item">
        ${iconHtml}
        <div class="timeline-content">
            <span class="timeline-text" style="color:${titleColor}; font-weight:bold;">${finalTitle}</span>
            ${badgeHtml}
        </div>
    </div>`;
    }
</script>

