<script>
        var token = '@_tokan';
        var webapiurl = '@_webapiurl';
    $(document).ready(function () {
        var appId = sessionStorage.getItem("currentAppId");
        loadTraineeLetter(appId);
        // Set E Signature Code : Begin ===============================================
        const canvas = document.getElementById("sig-canvas");
        const ctx = canvas.getContext("2d");

        const img = document.getElementById("sig-image");
        const clearBtn = document.getElementById("clearBtn");
        const hiddenInput = document.getElementById("sig-dataUrl");

        /*  FIX: Set proper canvas size  */
        function resizeCanvas() {
            canvas.style.display = "block";

            let w = canvas.offsetWidth;
            let h = canvas.offsetHeight;

            if (w === 0 || h === 0) {
                w = 600;
                h = 200;
            }

            // preserve existing drawing
            const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);

            canvas.width = w;
            canvas.height = h;

            ctx.putImageData(imgData, 0, 0);

            ctx.lineWidth = 2;
            ctx.lineJoin = "round";
            ctx.lineCap = "round";
            ctx.strokeStyle = "#000";
        }

        resizeCanvas();

        /*  Draw Signature  */
        let drawing = false;
        let isSaved = false; // flag to prevent drawing after save

        function getPos(e) {
            const r = canvas.getBoundingClientRect();
            // Correct for canvas scaling
            const scaleX = canvas.width / r.width;
            const scaleY = canvas.height / r.height;
            return {
                x: (e.clientX - r.left) * scaleX,
                y: (e.clientY - r.top) * scaleY
            };
        }

        canvas.addEventListener("pointerdown", e => {
            if (isSaved) return;
            drawing = true;
            const p = getPos(e);
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
        });

        canvas.addEventListener("pointermove", e => {
            if (!drawing || isSaved) return;
            const p = getPos(e);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
        });

        canvas.addEventListener("pointerup", () => {
            if (isSaved) return;
            drawing = false;
            ctx.closePath();
        });

        canvas.addEventListener("pointerleave", () => {
            drawing = false; // stop drawing if cursor leaves canvas
        });

        /*  CLEAR */
        clearBtn.addEventListener("click", () => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            canvas.style.display = "block";
            img.style.display = "none";
            isSaved = false; // allow drawing again after clearing
        });
        // Set E Signature Code : End ===============================================
        var tcocPath = "/UploadTPDoc/Tata Code Of Conduct.pdf";
        var tcocName = "Tata Code Of Conduct.pdf";

        // Set View button to open the fixed PDF
        $("#tcoc-document-item .btn-view").on("click", function () {
            window.open(tcocPath, '_blank');
        });

        // Set Download button to trigger download for fixed PDF
        $("#tcoc-document-item .btn-download").on("click", function () {
            // Using your existing download helper
            downloadFile(tcocPath, tcocName);
        });

        $("#btnsubmit").click(async function () {
            var trackId = appId;
            var acknowledgeTrainee = $("#acknowledge-trainee").is(':checked') ? 1 : 0;
            var acknowledgeTcoc = $("#acknowledge-tcoc").is(':checked') ? 1 : 0;
            var nightShift = $("#night-yes").is(':checked') ? 1 : 0;
            var sign = $("#signtext").val();
            toastr.remove();
            if (acknowledgeTrainee === 0) {
                toastr.error("Please acknowledge the Trainee Document.");
                return false;
            }

            if (acknowledgeTcoc === 0) {
                toastr.error("Please agree with the TCOC document.");
                return false;
            }
            if (sign === "") {
                toastr.error("Please Sign this.");
                $("#signtext").focus();
                return false;
            }
            //var canvas = document.getElementById("sig-canvas");
            //var signatureImage = canvas.toDataURL("image/png");
            //var formData = new FormData();
            //var signatureBlob = dataURItoBlob(signatureImage);
            //formData.append("SignatureFile", signatureBlob, "Signature.png");
            //var uploadResult = await $.ajax({
            //    type: "POST",
            //    url: "/TP/UploadTraineeDocuments",
            //    data: formData,
            //    contentType: false,
            //    processData: false
            //});
            var downloaddocdata = {
                trackId: trackId,
                isAcknowledge: acknowledgeTrainee,
                isAgreeTcoc: acknowledgeTcoc,
                isNightShift: nightShift,
                signname: sign,
                //signpath: uploadResult.SignaturePath
            }
            $.ajax({
                type: "POST",
                url: webapiurl + "TPOnboarding/SaveTrainneDocumentAcknowledge",
                contentType: "application/json; charset=utf-8",
                headers: {
                    "Authorization": token
                },
                dataType: "json",
                data: JSON.stringify(downloaddocdata),
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (res) {
                    if (res.Message == "Acknowledgments saved successfully!") {
                        $("#successmessage").show();
                        $("#acknowledgeform").hide();
                        $("#downloadDoc").hide();
                        SaveTraineeToEmployee(trackId);
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                },
                error: function (error) {
                    toastr.error("An error occurred during Approve.");
                },
            });
        });
        $("#fillForm").click(function () {
            $("#downloadDoc").hide();
            $("#successmessage").hide();
            $("#friendsuggestion").show();
        });
        $("#SubmitData").click(function (e) {
            e.preventDefault();
            trackId = appId
            var Fname = $("#FName").val().trim();
            var Fmobile = $("#FMobile").val().trim();
            var FEmail = $("#FEmail").val().trim();
            var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            var mobilePattern = /^[6-9]\d{9}$/;
            if (Fname === "") {
                toastr.remove();
                toastr.error("Please Enter Name.");
                return false;
            }
            if (Fmobile === "") {
                toastr.remove();
                toastr.error("Please Enter Mobile Number.");
                return false;
            }
            else if (!mobilePattern.test(Fmobile)) {
                toastr.remove();
                toastr.error("Please Enter a Valid 10-digit Mobile Number.");
                return false;
            }
            if (FEmail === "") {
                toastr.remove();
                toastr.error("Please Enter Email.");
                return false;
            }
            else if (!emailPattern.test(FEmail)) {
                toastr.remove();
                toastr.error("Please Enter a Valid Email.");
                return false;
            }
            var friendData = {
                Name: Fname,
                Mobileno: Fmobile,
                Email: FEmail,
                ReferredBy: trackId
            };
            $.ajax({
                type: "POST",
                url: webapiurl + "TPOnboarding/FriendSuggestion",
                headers: { "Authorization": token },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(friendData),
                success: function (res) {
                    if (res.Message == "Suggestion submitted successfully!") {
                        $("#friendsuggestion").hide();
                        $("#friendsuggestionsucees").show();
                    }
                }
            });
        })
    });
    function loadTraineeLetter(trackId) {
        $.ajax({
            type: "GET",
            url: webapiurl + "TPOnboarding/GetTraineeLetterPath?trackId=" + trackId,
            headers: { "Authorization": token },
            success: function (res) {
                if (res && res.FilePath) {
                    var container = $("#trainee-letter-item");
                    container.find(".btn-secondary:contains('View')")
                        .attr("onclick", "window.open('" + res.FilePath + "', '_blank')");

                    container.find(".btn-secondary:contains('Download')")
                        .attr("onclick", "downloadFile('" + res.FilePath + "', '" + res.FileName + "')");
                }
            }
        });
    }
    function SaveTraineeToEmployee(appId) {
        $.ajax({
            type: "POST",
            url: webapiurl + "TPOnboarding/ConvertTraineeToEmployee",
            headers: { "Authorization": token },
            dataType: "json",
            data: { appId: appId },
            success: function (res) {
                if (res) {
                    console.log("Employee Created Successfully.")
                }
            },
            error: function (error) {
                console.log("An error occurred during employee create.");
            },
        });
    }

    function downloadFile(path, name) {
        var link = document.createElement("a");
        link.href = path;
        link.download = name;
        link.click();
    }
    function dataURItoBlob(dataURI) {
        var byteString = atob(dataURI.split(',')[1]);
        var mimeString = dataURI.split(',')[0].split(':')[1].split(';')[0];
        var ab = new ArrayBuffer(byteString.length);
        var ia = new Uint8Array(ab);
        for (var i = 0; i < byteString.length; i++) {
            ia[i] = byteString.charCodeAt(i);
        }
        return new Blob([ab], { type: mimeString });
    }
</script>

