@using System.Configuration;
@{
    ViewBag.Title = "Reward Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    int empid = Convert.ToInt32(HttpContext.Current.Session["EmpId"]);
}

<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">

<style type="text/css">
    .page-content-white .page-bar {
        min-height: auto;
    }
</style>

<script>
    const token = '@_tokan';
    const webapiurl = '@_webapiurl';
    var empid = '@empid';
    $(document).ready(function () {
        var $firstTab = $('.nav-tabs .nav-item:first-child a');

        if ($firstTab.length > 0) {
            $firstTab.tab('show');
            var initialTabId = $firstTab.attr("href");
            triggerTabLoad(initialTabId);
        }

        $(document).on('shown.bs.tab', 'a[data-toggle="tab"]', function (e) {
            var tabId = $(e.target).attr("href");
            triggerTabLoad(tabId);
        });

        $("#Submit_btn").click(function () {            
            toastr.remove();
            var month = $("#Month").val();
            var feedback = $("#Feedback").val();
            var observation = $("#Observation").val();
            var date = $("#Date").val();
            var reason = $("#reason").val().trim();
            var isAction = $("#IsApprove").prop("checked") ? 1 : 0;
            var suggestion = $("#Suggestion").val().trim();
            if (!month) {
                toastr.error("Please select month");
                return;
            }
            if (!feedback) {
                toastr.error("Please select feedback");
                return;
            }
            if (!observation) {
                toastr.error("Please select observation");
                return;
            }
            if (!date) {
                toastr.error("Please select date");
                return;
            }
            if (!reason) {
                toastr.error("Please enter reason");
                return;
            }
            if (!suggestion) {
                toastr.error("Please enter suggestion");
                return;
            }
            var data = {
                Empid: empid,
                Month: month,
                Feedback: feedback,
                Observation: observation,
                Date: date,
                Reason: reason,
                IsApprove: isAction,
                Suggestion: suggestion
            }
            $.ajax({
                type: 'POST',
                url: webapiuri + "TPOnboarding/AddRewardRequestofEmployee",
                contentType: "application/json; charset=utf-8",
                headers: {
                    'Authorization': token
                },
                data: JSON.stringify(data),
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (res) {
                    console.log(res);
                    if (res.status) {
                        toastr.success("Reward Request Add Successfully.");
                        loadRewardRequestData(0);
                        $("#Addrequest_modal").modal('hide');
                        $("#Month").val("").trigger("change");
                        $("#Feedback").val("").trigger("change");
                        $("#Observation").val("").trigger("change");
                        $("#Date,#reason,#Suggestion").val("");
                        $("#IsApprove").prop("checked", false);
                    }
                },
                error: function (error) {
                    toastr.error(error);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });

        $("#Clear_btn").click(function () {
            $("#Month").val("").trigger("change");
            $("#Feedback").val("").trigger("change");
            $("#Observation").val("").trigger("change");
            $("#Date").val("");
            $("#reason").val("");
            $("#Suggestion").val("");
            $("#IsApprove").prop("checked", false);
        });

        $("#tblRPending").on('click', '.editbtn', function () {
            var table = $('#tblRPending').DataTable();
            var rowData = table.row($(this).closest('tr')).data();
            
            $("#Rewardid").text(rowData.rewardid);
            $("#Month_update").val(rowData.month).trigger('change');
            $("#Feedback_update").val(rowData.feedbacktype).trigger('change');
            $("#Observation_update").val(rowData.typeofobservation).trigger('change');
            $("#Date_update").val(rowData.Date || ""); 
            $("#reason_update").val(rowData.reason || "");
            $("#Suggestion_update").val(rowData.suggestion || "");
            $("#IsApprove_update").prop("checked", rowData.actionbymanager == 1);

            $("#Addrequest_modal_update").modal('show');
        });
        $("#SubmitUpdate_btn").click(function () {
            toastr.remove();
            var rewardid = $("#Rewardid").text();
            var month = $("#Month_update").val();
            var feedback = $("#Feedback_update").val();
            var observation = $("#Observation_update").val();
            var date = $("#Date_update").val();
            var reason = $("#reason_update").val().trim();
            var isAction = $("#IsApprove_update").prop("checked") ? 1 : 0;
            var suggestion = $("#Suggestion_update").val().trim();
            if (!month) {
                toastr.error("Please select month");
                return;
            }
            if (!feedback) {
                toastr.error("Please select feedback");
                return;
            }
            if (!observation) {
                toastr.error("Please select observation");
                return;
            }
            if (!date) {
                toastr.error("Please select date");
                return;
            }
            if (!reason) {
                toastr.error("Please enter reason");
                return;
            }
            if (!suggestion) {
                toastr.error("Please enter suggestion");
                return;
            }
            var data = {
                RewardId: rewardid,
                Empid: empid,
                Month: month,
                Feedback: feedback,
                Observation: observation,
                Date: date,
                Reason: reason,
                IsApprove: isAction,
                Suggestion: suggestion
            }
            $.ajax({
                type: 'POST',
                url: webapiuri + "TPOnboarding/UpdateRewardRequest",
                contentType: "application/json; charset=utf-8",
                headers: {
                    'Authorization': token
                },
                data: JSON.stringify(data),
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (res) {
                    console.log(res);
                    if (res.status) {
                        toastr.success("Reward Request Update Successfully.");
                        loadRewardRequestData(0);
                        $("#Addrequest_modal_update").modal('hide');                        
                    }
                },
                error: function (error) {
                    toastr.error(error);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        })

        // Reject Button click Swal Code =========================
        $(document).on("click", ".DeleteBtn", function (e) {
            e.preventDefault();
            var table = $('#tblRPending').DataTable();
            var rowData = table.row($(this).closest('tr')).data();
            var rewardid = rowData.rewardid;

            Swal.fire({
                html: '<div class="swal_subtitle"><b>Are you sure you want to Delete this request?</b></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Delete Request",
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'Cancel',
                confirmButtonText: 'Delete Request',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {
                if (result.isConfirmed) {                    
                    var dataa = {
                        Rewardid:rewardid
                    };
                    $.ajax({
                        url: webapiurl + "TPOnboarding/DeleteRewardRequest",
                        type: 'POST',
                        data: JSON.stringify(dataa),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        headers: { 'Authorization': token },
                        beforeSend: function () {
                            $("#ajax_loader").show();
                        },
                        success: function (res) {                            
                            if (res.status) {
                                toastr.success("Reward Request Delete Successfully.");
                                loadRewardRequestData(0);
                            }
                        },
                        error: function () {
                            //Swal.fire('Error!', 'Something went wrong on the server.', 'error');
                        },
                        complete: function () {
                            $("#ajax_loader").hide();
                        }
                    });
                }
            });

            // add custom class to swal for styling
            setTimeout(function () {
                $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]')
                    .closest('.swal2-popup')
                    .addClass('swal_error');
            }, 50);
        });


        // Filter Click Open Modal Code =========================
        $("#Addrequest").on('click', function () {
            $("#Addrequest").attr("data-toggle", "modal");
            $("#Addrequest").attr("data-target", "#Addrequest_modal");
        });

    });
    function triggerTabLoad(activeTabId) {
        switch (activeTabId) {
            case "#RPending":
                loadRewardRequestData(0);
                break;
            case "#RApproved":
                loadRewardRequestData(1);
                break;
            case "#RRejected":
                loadRewardRequestData(2);
                break;
        }
    }
    function toggleNoData(data, tableId, emptyId) {
        if (!data || data.length === 0) {
            $(tableId).hide();
            $(emptyId).show();
            $("#dataTables_tbl_header").hide();
        } 
    }
    function loadRewardRequestData(status) {
        var data = {
            Empid: empid,
            Status:status
        }
        $.ajax({
            type: 'POST',
            url: webapiuri + "TPOnboarding/GetRewardRequestDatOfEmployee",
            contentType: "application/json; charset=utf-8",
            headers: {
                'Authorization': token
            },
            data: JSON.stringify(data),
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (res) {                
                if (status == 0) {
                    loadPendingData(res);
                    toggleNoData(res, "#tableResponsivePending", "#NotificationGrid-empty");                    
                } else if (status == 1) {
                    loadApprovedData(res);
                    toggleNoData(res, "#tableResponsiveApproved", "#NotificationGrid-emptyapprove");                   
                } else {
                    loadRejectedData(res);
                    toggleNoData(res, "#tableResponsiveRejected", "#NotificationGrid-emptyreject");                    
                }
            },
            error: function (error) {
                toastr.error("Error Occur in Get Data.");
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        })
    }
    function loadPendingData(data) {
        $("#dataTables_tbl_header").remove();
        var table = $("#tblRPending").DataTable({
            data: data,
            dom: _domCommon,
            language: _languageCommon,
            order: [],
            destroy: true,
            columns: [
                { title: "rewardid", data: "rewardid", visible: false },
                { title: "Type", data: "feedbacktype",
                    render: function (data) {
                        if (data == 1) return "Safety Observation";
                        if (data == 0) return "Kaizen / 5S";
                        return "";
                    }
                },
                { title: "Month", data: "month",
                    render: function (data) {
                        const months = [
                            "January", "February", "March", "April","May", "June", "July", "August",
                            "September", "October", "November", "December"
                        ];
                        return months[data - 1] || "";
                    }
                },
                { title: "Description", data: "reason"},
                { title: "Status", data: null, className: "orange_font",
                    render: function () {
                        return "Pending";
                    }
                },
                { title: "Action",data: null, orderable: false,
                    render: function (data, type, row) {                       
                        return `
                             <a id="" class="btn blue_btnnew tooltips editbtn" data-placement="left" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>
                             <a id="" class="btn blue_btnnew tooltips DeleteBtn" data-placement="left" data-original-title="Delete"><i class="fa-solid fa-xmark"></i></a>
                        `;
                    }
                }
            ],
            initComplete: function () {
                const visibleTable = $('table:visible').attr('id');
                $("#buttons").append(`
                  <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                      <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                  </div>
            `);
            },
            drawCallback: function () {
                $('.tooltips').tooltip();
            },
        });
        setTimeout(function () {
            $("#" + "tblRPending" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsivePending"));
            $('.tooltips').tooltip();
        }, 100);
    }
    function loadApprovedData(data) {
        $("#dataTables_tbl_header").remove();
        var table = $("#tblRApproved").DataTable({
            data: data,
            dom: _domCommon,
            language: _languageCommon,
