                        if (data == 1) return "Safety Observation";
                        if (data == 0) return "Kaizen / 5S";
                        return "";
                    }
                },
                {
                    title: "Month", data: "month",
                    render: function (data) {
                        const months = [
                            "January", "February", "March", "April","May", "June", "July", "August",
                            "September", "October", "November", "December"
                        ];
                        return months[data - 1] || "";
                    }
                },
                { title: "Description", data: "reason" },
                {
                    title: "Status", data: null, className: "green_font",
                    render: function () {
                        return "Approve";
                    }
                },
                {
                    title: "Action", data: null, orderable: false,
                    render: function (data, type, row) {
                        return `
                         <a id="" class="btn blue_btnnew tooltips" data-placement="left" data-original-title="Edit" disabled><i class="fa-regular fa-pen-to-square"></i></a>
                         <a id="" class="btn blue_btnnew tooltips DeleteBtn" data-placement="left" data-original-title="Delete" disabled><i class="fa-solid fa-xmark"></i></a>
                    `;
                    }
                }
            ],
            initComplete: function () {
                const visibleTable = $('table:visible').attr('id');
                $("#buttons").append(`
                      <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                          <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                      </div>
                `);
            },
            drawCallback: function () {
                $('.tooltips').tooltip();
            },
        });
        setTimeout(function () {
            $("#" + "tblRApproved" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsiveApproved"));
            $('.tooltips').tooltip();
        }, 100);
    }
    function loadRejectedData(data) {
        $("#dataTables_tbl_header").remove();
        var table = $("#tblRRejected").DataTable({
            data: data,
            dom: _domCommon,
            language: _languageCommon,
            order: [],
            destroy: true,
            columns: [
                { title: "rewardid", data: "rewardid", visible: false },
                {
                    title: "Type", data: "feedbacktype",
                    render: function (data) {
                        if (data == 1) return "Safety Observation";
                        if (data == 0) return "Kaizen / 5S";
                        return "";
                    }
                },
                {
                    title: "Month", data: "month",
                    render: function (data) {
                        const months = [
                            "January", "February", "March", "April","May", "June", "July", "August",
                            "September", "October", "November", "December"
                        ];
                        return months[data - 1] || "";
                    }
                },
                { title: "Description", data: "reason" },
                {
                    title: "Status", data: null, className: "red_font",
                    render: function () {
                        return "Rejected";
                    }
                },
                {
                    title: "Action", data: null, orderable: false,
                    render: function (data, type, row) {
                        return `
                         <a id="" class="btn blue_btnnew tooltips" data-placement="left" data-original-title="Edit" disabled><i class="fa-regular fa-pen-to-square"></i></a>
                         <a id="" class="btn blue_btnnew tooltips DeleteBtn" data-placement="left" data-original-title="Delete" disabled><i class="fa-solid fa-xmark"></i></a>
                    `;
                    }
                }
            ],
            initComplete: function () {
                const visibleTable = $('table:visible').attr('id');
                $("#buttons").append(`
                      <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                          <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                      </div>
                `);
            },
            drawCallback: function () {
                $('.tooltips').tooltip();
            },
        });
        setTimeout(function () {
            $("#" + "tblRRejected" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsiveRejected"));
            $('.tooltips').tooltip();
        }, 100);
    }
</script>

