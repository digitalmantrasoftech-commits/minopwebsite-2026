                                    <option value="10">Oct</option>
                                    <option value="11">Nov</option>
                                    <option value="12">Dec</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">Feedback <span class="required" aria-required="true">*</span></label>
                                <select class="form-control input-sm select2" id="Feedback">
                                    <option value="">Please Select</option>
                                    <option value="1">Safety Observation</option>
                                    <option value="0">Kaizen / 5S</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">Type of observation <span class="required" aria-required="true">*</span></label>
                                <select class="form-control input-sm select2" id="Observation">
                                    <option value="">Please Select</option>
                                    <option value="1">Unsafe act</option>
                                    <option value="2">Unsafe Condition</option>
                                    <option value="3">Near miss</option>
                                    <option value="4">Incident/Injury</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group data_picker_box">
                                <label class="control-label">Date<span class="required" aria-required="true">*</span></label>
                                <div class="input-group input-group-sm date date-picker" id="" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                                    <span class="input-group-btn">
                                        <button class="btn default" type="button">
                                            <i class="fa-light fa-calendar-days"></i>
                                        </button>
                                    </span>
                                    <input type="text" class="form-control" id="Date" value="" data-date-format="@_isdateformat" placeholder="" autocomplete="off">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">Brief the reason</label>
                                <textarea class="form-control" id="reason" rows="3" name="" placeholder="Enter Reason"></textarea>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="check mt-checkbox mt-checkbox-outline">
                                <input name="" id="IsApprove" type="checkbox">Action taken by reporting manager<span></span>
                            </label>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group margin-bottom-0">
                                <label class="control-label">Suggestion</label>
                                <textarea class="form-control" id="Suggestion" rows="3" name="" placeholder="Enter Suggestion"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
