        $("#tblhseview tfoot th").each(function () {
            var title = $(this).text();
            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
        });

        // DataTable initialisation
        //var table = $("#tblhseview").DataTable({
        //    dom: _domCommon,
        //    language: _languageCommon,
        //    ordering: true,
        //    columnDefs: [
        //        { orderable: false, targets: [10] } // disable ordering on 9th and 10th columns
        //    ],
        //});
        //setTimeout(function () {
        //    $("#" + "tblhseview" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
        //    $('.tooltips').tooltip();
        //}, 100);

        // Apply the column Search
        $("#tblhseview thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });

    });
    function LoadRewardDataForHSE() {
        $.ajax({
            type: 'GET',
            url: webapiuri + "TPOnboarding/GetRewardDataForHSE",
            contentType: "application/json; charset=utf-8",
            headers: {
                'Authorization': token
            },
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (res) {
                console.log(res)
                loadDatatable(res);
                if (!res || res.length === 0 || res == 0) {
                    $("#NotificationGrid-empty").show();
                    $("#tableResponsive_medical").hide();
                    $("#dataTables_tbl_header").hide();
                }
                else {
                    $("#NotificationGrid-empty").hide();
                    loadDatatable(res);
                }
            },
            error: function (error) {
                toastr.error("Error Occur in Get Data.");
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        })
    }
    function loadDatatable(data) {
        $("#dataTables_tbl_header").remove();
        var table = $("#tblhseview").DataTable({
            data: data,
            dom: _domCommon,
            language: _languageCommon,
            ordering: true,
            destroy: true,
            columns: [
                { title: "rewardid", data: "rewardid", visible: false },
                { title: "Employee", data: "EmpName", createdCell: function (td) { $(td).css("min-width", "120px") } },
                { title: "Employee Code", data: "Empcode" },
                {
                    title: "Month",
                    data: "month",
                    render: function (data) {
                        const months = ["January", "February", "March", "April", "May", "June", "July", "August",
                            "September", "October", "November", "December"];
                        return months[data - 1] || data;
                    }
                },
                {
                    title: "Type",
                    data: "feedbacktype", createdCell: function (td) { $(td).css("min-width", "120px"); },
                    render: function (data) {
                        if (data == 1 || data == "1") return "Safety Observation";
                        if (data == 0 || data == "0") return "Kaizen / 5S";
                        return "";
                    }
                },
                {
                    title: "Type of Observation",
                    data: "typeofobservation",
                    render: function (data) {
                        switch (data) {
                            case 1:
                            case "1": return "Unsafe Act";
                            case 2:
                            case "2": return "Unsafe Condition";
                            case 3:
                            case "3": return "Near Miss";
                            case 4:
                            case "4": return "Incident/Injury";
                            default: return "";
                        }
                    }
                },
                { title: "Date", data: "Date", createdCell: function (td) { $(td).css("min-width", "120px"); } },
                { title: "Observation", data: "reason", createdCell: function (td) { $(td).css("min-width", "120px"); } },
                {
                    title: "Action taken by reporting manager",
                    data: "actionbymanager",
                    render: function (data) {
                        if (data == 1) return "Yes";
                        if (data == 0) return "No";
                        return "";
                    }
                },
                { title: "Suggestions for improvement", data: "suggestion", createdCell: function (td) { $(td).css("min-width", "120px"); } },
                { title: "Date of completion", data: "CompletionDate" },
                {
                    title: "Status",
                    data: "status", className:"fixed-column",
                    render: function (data) {
                        if (data == 0) return '<span class="orange_font">Open</span>';
                        if (data == 1) return '<span class="green_font">Closed</span>';
                        if (data == 2) return '<span class="green_font">In Progress</span>';
                        return "";
                    }
                }
            ],
            initComplete: function () {
                const visibleTable = $('table:visible').attr('id');
                $("#buttons").append(`
                      <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                          <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                      </div>
                `);
            },
        });
        setTimeout(function () {
            $("#" + "tblhseview" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
    }
</script>

