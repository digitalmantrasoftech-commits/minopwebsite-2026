@{
    ViewBag.Title = "Head Approval";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">

<style type="text/css">
    .fixed-column {
        width: 90px !important;
        min-width: 90px !important;
        right: 0px;
        position: sticky !important;
        background-color: #fff !important;
        box-shadow: -1px 0px 3px 0px rgba(0, 0, 0, 0.20);
    }
</style>

<script>
    $(document).ready(function () {

        // Create search inputs in footer
        $("#tblheadapproval tfoot th").each(function () {
            var title = $(this).text();
            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
        });

        // DataTable initialisation
        var table = $("#tblheadapproval").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            ordering: true,
            columnDefs: [
                { orderable: false, targets: [12] } // disable ordering on 9th and 10th columns
            ],
        });
        setTimeout(function () {
            $("#" + "tblheadapproval" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        // Apply the column Search
        $("#tblheadapproval thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });

        // Approv Button click Swal Code =========================
        $(document).on("click", ".ApproveBtn", function (e) {
            e.preventDefault();
            Swal.fire({
                html: '<div class="swal_subtitle"><b>Are you sure you want to approve this request?</b><div class="margin-top-10"><label class="margin-right-10"><input value="False" name="Yes" id="YESA" type="radio" checked=""> Yes <span></span> </label><label class=""><input value="True" name="Yes" id="NOA" type="radio"> No <span></span> </label></div></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Approve Request",
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No',
                confirmButtonText: 'Yes',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            });

            // add custom class to swal for styling
            setTimeout(function () {
                $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]')
                    .closest('.swal2-popup')
                    .addClass('swal_success');
            }, 50);
        });

        // Reject Button click Swal Code =========================
        $(document).on("click", ".RejectBtn", function (e) {
            e.preventDefault();

            Swal.fire({
                html: '<div class="swal_subtitle"><b>Are you sure you want to reject this request?</b><div class="margin-top-20"><div class="form-group margin-bottom-0"> <label class="control-label">Please mention the reason <span class="required" aria-required="true">*</span></label> <input type="text" id="" placeholder="Enter Reason" class="form-control" name="" /> </div></div></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Reject Request",
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'Cancel',
                confirmButtonText: 'Reject Request',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            });

            // add custom class to swal for styling
            setTimeout(function () {
                $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]')
                    .closest('.swal2-popup')
                    .addClass('swal_error');
            }, 50);
        });


    });
</script>

