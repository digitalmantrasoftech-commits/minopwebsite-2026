    function GetDescriptionData(dataa) {
        $.ajax({
            type: 'POST',
            url: webapiuri + "TPOnboarding/GetRewardRequestDescription",
            contentType: "application/json; charset=utf-8",
            headers: {
                'Authorization': token
            },
            data: JSON.stringify(dataa),
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (res) {
                console.log(res)
                if (res && res.length > 0) {
                    $("#NotificationGrid-empty_Modal").hide();
                    $("#tableResponsiveKaizen").show();
                    LoadDescriptionData(res);
                } else {
                    $("#NotificationGrid-empty_Modal").show();
                    $("#tableResponsiveKaizen").hide();
                    $("#tblKaizen_wrapper #dataTables_tbl_header").hide();
                    $("#ViewDetail_modal #dataTables_tbl_header").hide()
                }
            },
            error: function (error) {
                toastr.error("Error Occur in Get Data.");
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        })
    }
    function LoadDescriptionData(data) {
        $("#Kaizen #dataTables_tbl_header").remove();
        $("#tblKaizen_wrapper #dataTables_tbl_header").remove();
        var table = $("#tblKaizen").DataTable({
            data: data,
            dom: _domCommon,
            language: _languageCommon,
            destroy: true,
            order: [],
            columns: [
                {
                    title: '<input type="checkbox" id="checkAll">',
                    data: "status",
                    orderable: false,
                    render: function (data, type, row) {
                        if (data === 0) {
                            return `<input type="checkbox" class="chkItem" value="${row.rewardid}">`;
                        } else {
                            return `<input type="checkbox" disabled>`;
                        }
                    }
                },
                {
                    title: "Description",
                    data: "reason"
                },
                {
                    title: "Status",
                    data: "status",
                    render: function (data) {
                        if (data === 1) return '<span class="green_font">Approved</span>';
                        if (data === 2) return '<span class="red_font">Rejected</span>';
                        return '<span class="orange_font">Pending</span>';
                    }
                }
            ],
            drawCallback: function () {
                $('.tooltips').tooltip();
            }
        });
        $("#checkAll").on('change', function () {
            $(".chkItem").prop('checked', $(this).prop('checked'));
        });
    }
    function loadRewardRequestData() {
        var dataa = {
            Empid: empid,
        }
        $.ajax({
            type: 'POST',
            url: webapiuri + "TPOnboarding/GetRewardRequestDataforManager",
            contentType: "application/json; charset=utf-8",
            headers: {
                'Authorization': token
            },
            data: JSON.stringify(dataa),
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (res) {
                console.log(res)
                if (!res || res.length === 0 || res == 0) {
                    $("#NotificationGrid-empty").show();
                    $("#tableResponsiveRequest").hide();
                    $("#dataTables_tbl_header").hide();
                } else {
                    $("#NotificationGrid-empty").hide();
                    LoadRewardRequestDataForManager(res);
                }
            },
            error: function (error) {
                toastr.error("Error Occur in Get Data.");
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        })
    }
    function LoadRewardRequestDataForManager(data) {
        $("#dataTables_tbl_header").remove();
        var table = $("#tblrrequest").DataTable({
            data: data,
            dom: _domCommon,
            language: _languageCommon,
            order: [],
            destroy: true,
            columns: [
                { title: "empid", data: "EmpId", visible: false },
                { title: "Employee", data: "EmpName"},
                {
                    title: "Month", data: "month",
                    render: function (data) {
                        const months = [
                            "January", "February", "March", "April", "May", "June", "July", "August",
                            "September", "October", "November", "December"
                        ];
                        return months[data - 1] || "";
                    }
                },
                {
                    title: "Kaizen Details",
                    data: null,
                    render: function (data, type, row) {
                        return `
                        <div style="display: flex;">
                            <div class="margin-right-5">Approve: <b class="green_font">${row.Kaizen_Approved}</b> | </div>
                            <div class="margin-right-5">Reject: <b class="red_font">${row.Kaizen_Rejected}</b> | </div>
                            <div class="margin-right-5">Pending: <b class="orange_font">${row.Kaizen_Pending}</b></div>
                        </div>`;
                    }
                },
                {
                    title: "Safety Observation",
                    data: null,
                    render: function (data, type, row) {
                        return `
                        <div style="display: flex;">
                            <div class="margin-right-5">Approve: <b class="green_font">${row.Safety_Approved}</b> | </div>
                            <div class="margin-right-5">Reject: <b class="red_font">${row.Safety_Rejected}</b> | </div>
                            <div class="margin-right-5">Pending: <b class="orange_font">${row.Safety_Pending}</b></div>
                        </div>`;
                    }
                },
                {
                    title: "Action", data: null, orderable: false, className: "fixed-column",
                    render: function (data, type, row) {
                        return `
                        <a href="javascript:;" class="btn blue_btnnew tooltips ViewDetail" data-placement="left" data-original-title="View Detail"><i class="fa-regular fa-eye"></i></a>
                    `;
                    }
                }
            ],
            initComplete: function () {
                const visibleTable = $('table:visible').attr('id');
                $("#buttons").empty().append(`
                       <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                           <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                       </div>
                 `);
            },
            drawCallback: function () {
                $('.tooltips').tooltip();
            },
        });
        setTimeout(function () {
            $("#" + "tblrrequest" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsiveRequest"));
            $('.tooltips').tooltip();
        }, 100);
    }
</script>

