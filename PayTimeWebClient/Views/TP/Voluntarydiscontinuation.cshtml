@using System.Configuration;
@{
    ViewBag.Title = "Voluntarydiscontinuation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    int empid = Convert.ToInt32(HttpContext.Current.Session["EmpId"]);
}

<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">

<style type="text/css">
    .swal2-container {
        z-index: 11111;
    }

    .fixed-column {
        width: 90px !important;
        min-width: 90px !important;
        right: 0px;
        position: sticky !important;
        background-color: #fff !important;
        box-shadow: -1px 0px 3px 0px rgba(0, 0, 0, 0.20);
    }
</style>

<script>
     var token = '@_tokan';
     var webapiurl = '@_webapiurl';
     var empid = '@empid'
    $(document).ready(function () {        
        LoadVoluntarydiscontinuationData(empid);

        // Table Traine Request Block : Begin ===============================================
        // Create search inputs in footer
        //$("#tblTraineReq tfoot th").each(function () {
        //    var title = $(this).text();
        //    $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
        //});

        // DataTable initialisation
        //var table = $("#tblVoluntarydiscontinuationReq").DataTable({
        //    dom: _domCommon,
        //    language: _languageCommon,
        //    ordering: true,
        //    columnDefs: [
        //        { orderable: false, targets: [6] } // disable ordering on 9th and 10th columns
        //    ],
        //});
        //setTimeout(function () {
        //    $("#" + "tblVoluntarydiscontinuationReq" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
        //    $('.tooltips').tooltip();
        //}, 100);

        // Apply the column Search
        $("#tblTraineReq thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });
        // Table Traine Request Block : End ===============================================


        // Filter Click Open Modal Code =========================
        $("#Discontinu_btn").on('click', function () {            
            $("#Discontinu_btn").attr("data-toggle", "modal");
            $("#Discontinu_btn").attr("data-target", "#Discontinu_btn_modal");
        });        

        $("#Discontinu_Track").on('click', function () {            
            $.ajax({
                type: "GET",
                url: webapiurl + "TPOnboarding/VoluntaryDiscontinuationRequestTrack?Empid=" + empid,
                headers: {
                    "Authorization": token
                },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {                    
                    var data = response && response.length > 0 ? response[0] : null;
                    $(".status-circle").removeClass("check-circle close-circle").addClass("pending-circle");
                    $(".r_subtitle").text("");
                    if (data) {
                        $("#submitCircle").addClass("check-circle");
                        $("#submittedDate").text(data.CreateDate || "");
                        $("#submittedReason").text(data.Description || "");
                        $("#employeeRequestedLWD").text(data.EmployeeRequestedLWD ? data.EmployeeRequestedLWD.split('T')[0] : (data.lastday ? data.lastday.split('T')[0] : ""));

                        var status = parseInt(data.status);

                        if (status === 0) {
                            $("#managerStatusText").text("Manager Approval (Pending)");
                        }
                        else if (status === 1) {
                            $("#managerCircle").addClass("close-circle");
                            $("#managerStatusText").text("Rejected by Manager");
                            $("#managerRemarks").text(data.manager_remark || "No remarks");
                            $("#managerAcceptedDate").text(data.Managerapprovedate || "");
                        }
                        else if (status >= 2) {
                            $("#managerCircle").addClass("check-circle");
                            $("#managerStatusText").text("Manager Approved");
                            $("#lastWorkingDay").text(data.Lastworkingday ? data.Lastworkingday.split('T')[0] : "");
                            $("#managerAcceptedDate").text(data.Managerapprovedate || "");
                            $("#managerRemarks").text(data.manager_remark || "");

                            if (status === 2) {
                                $("#bhrStatusText").text("BHR Approval (Pending)");
                            }
                            else if (status === 3) {
                                $("#bhrCircle").addClass("close-circle");
                                $("#bhrStatusText").text("Rejected by BHR");
                                $("#bhrLabel").text("Rejected on");
                                $("#bhrRemarks").text(data.hr_remark || data.rejectreason || "");
                                $("#bhrDate").text(data.BHRapprovedate || "");
                            }
                            else if (status === 4) {
                                $("#bhrCircle").addClass("check-circle");
                                $("#bhrStatusText").text("BHR Approved");
                                $("#bhrLabel").text("Approved on");
                                $("#bhrDate").text(data.BHRapprovedate || "");
                                $("#bhrRemarks").text(data.hr_remark || "");
                            }
                        }
                    } else {                        
                        console.log("No request found for this employee.");
                        $("#managerStatusText").text("Manager Approval");
                        $("#bhrStatusText").text("BHR Approval");                        
                    }
                },
                error: function (err) {
                    toastr.error("Error in Get the Tracking data.")
                }
            });

            $("#Discontinu_Track").attr("data-toggle", "modal");
            $("#Discontinu_Track").attr("data-target", "#Discontinu_Track_modal");
        });

        $(document).on("click", "#SubmitBtn", function (e) {            
            e.preventDefault();

            toastr.remove();

            var role = $("#roleofemp").val();
            var description = $("#discountinuationreason").val().trim();
            var businessUnit = $("#bunit").val();
            var gw = $("#GW").val();
            var workstation = $("#workstation").val();
            var lastWorkingDay = $("#Lastday").val();

            if (role === "" || role === null) {
                toastr.error("Please select a Reason for discontinuation.");
                $("#roleofemp").focus();
                return false;
            }
            if (description === "" || description === null) {
                toastr.error("Please Enter Description.");
                $("#discountinuationreason").focus();
                return false;
            }
            if (businessUnit === "" || businessUnit === null) {
                toastr.error("Please select a Business unit.");
                $("#bunit").focus();
                return false;
            }
            if (gw === "" || gw === "0") {
                toastr.error("Please select a GW.");
                $("#GW").focus();
                return false;
            }
            if (workstation === "" || workstation === null) {
                toastr.error("Please select a Workstation.");
                $("#workstation").focus();
                return false;
            }
            if (lastWorkingDay === "") {
                toastr.error("Please select the Last working day.");
                $("#Lastday").focus();
                return false;
            }

            Swal.fire({
                html: '<div class="swal_subtitle"><b>Are you sure you want to proceed?</b><div class="margin-top-10"><label class="margin-right-10"><input value="False" name="Yes" id="YESA" type="radio" checked=""> Yes <span></span> </label><label class=""><input value="True" name="Yes" id="NOA" type="radio"> No <span></span> </label></div></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_info.svg' alt=''>111 Voluntary Discontinuation of training",
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No',
                confirmButtonText: 'Yes',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    if ($('#YESA').is(':checked')) {

                        var formData = {
                            EmpId: empid,
                            Role: role,
                            Description: description,
                            Bunit: businessUnit,
                            GW: gw,
                            Workstation: workstation,
                            Lastday: lastWorkingDay,                            
                        };

                        $.ajax({
                            url: webapiurl + "TPOnboarding/VoluntaryDiscontinuationRequest",
                            type: 'POST',
                            contentType: "application/json; charset=utf-8",
                            headers: {
                                "Authorization": token
                            },
                            dataType: "json",
                            data: JSON.stringify(formData),
                            beforeSend: function () {
                                $("#ajax_loader").show();
                            },
                            success: function (res) {
                                if (res.status) {
                                    toastr.success("Discontinuation request saved successfully!");
                                    $("#Discontinu_btn_modal").modal('hide');
                                    $("#roleofemp, #workstation, #bunit, #discountinuationreason").val("").trigger('change');
                                    $("#GW").val("0").trigger('change');
                                    $("#Lastday").val("");
                                    SendEmailToReportingManager();
                                } else {
                                    toastr.error(res.Message || "Failed to save discontinuation request.");
                                }
                            },
                            error: function (err) {
                                toastr.error("Something went wrong while saving.");
                            },
                            complete: function () {
                                $("#ajax_loader").hide();
                            }
                        });

                    } else {
                        //toastr.warning("You selected 'No' in the options. Action cancelled.");
                    }
                }
            })

            // add custom class to swal for styling
            setTimeout(function () {
                $('img[src="/assets/images/icons/swal_icon/icon_info.svg"]')
                    .closest('.swal2-popup')
                    .addClass('swal_info');
            }, 50);
        });

        $("#clearForm").click(function () {
            $("#roleofemp, #workstation, #bunit, #discountinuationreason").val("").trigger('change');
            $("#GW").val("0").trigger('change');            
            $("#Lastday").val("");                                   
        })

        $(document).on("click", ".RejectBtn", function (e) {
            e.preventDefault();
            var table = $('#tblVoluntarydiscontinuationReq').DataTable();
            var rowData = table.row($(this).closest('tr')).data();
            var Empid = rowData.Empid;
            var EmpEmail = rowData.useremail || "";
            Swal.fire({
                html: '<div class="swal_subtitle"><b>Are you sure you want to reject this request?</b><div class="margin-top-20"><div class="form-group margin-bottom-0"> <label class="control-label">Please enter reason <span class="required" aria-required="true">*</span></label> <input type="text" id="rejectreason" placeholder="Enter Reason" class="form-control" name="" /> </div></div></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Discontinuation request",
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'Cancel',
                confirmButtonText: 'Reject Request',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                },
                preConfirm: () => {
                    const reason = Swal.getPopup().querySelector('#rejectreason').value.trim();
                    if (!reason) {
                        Swal.showValidationMessage(`Please Enter Reason`);
                        return false;
                    }
                    return { reason: reason };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    var reason = $("#rejectreason").val();
                    var rejectdata = {
                        Empid: Empid,
                        Rejectreason: reason,
                        Flag:0,
                        Email: EmpEmail
                    }
                    $.ajax({
                        url: webapiurl + "TPOnboarding/RejectDiscontinuationRequest",
                        type: 'POST',
                        data: JSON.stringify(rejectdata),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        headers: {
                            'Authorization': token
                        },
                        beforeSend: function () {
                            $("#ajax_loader").show();
                        },
                        success: function (res) {
                            console.log(res)
                            if (res) {
                                toastr.success("Discontinuation Request Reject Successfully.")
                                LoadVoluntarydiscontinuationData(empid);
                            }
                        },
                        error: function () {
                            //Swal.fire('Error!', 'Something went wrong on the server.', 'error');
                        },
                        complete: function () {
                            $("#ajax_loader").hide();
                        }
                    });
                }
            });

            // add custom class to swal for styling
            setTimeout(function () {
                $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]')
                    .closest('.swal2-popup')
                    .addClass('swal_error');
            }, 50);
        });

        $("#tblVoluntarydiscontinuationReq").on('click', '.ApproveBtn', function () {
            var table = $('#tblVoluntarydiscontinuationReq').DataTable();
            var rowData = table.row($(this).closest('tr')).data();             
            $("#empid").val(rowData.Empid);
            $("#empemail").val(rowData.useremail || "");
            $("#empname").text(rowData.EmpName);
            $("#reasontype").text(rowData.reason);            
            $("#Branchmodal").text(rowData.BranchName);
            $("#discription").text(rowData.Description);
            $("#gwmodal").text(rowData.DepartmentName);
            $("#workstationmodal").text(rowData.workstationname);
            $("#lastworkingdaymodal").text(rowData.Lastworkingday);            
            $("#lastdaybyreporting").val("");
            $("#remark").val("");

            $(".ApproveBtn").attr("data-toggle", "modal");
            $(".ApproveBtn").attr("data-target", "#ApproveBtn_modal");
        });

        $("#submitrequest").click(function () {
            toastr.remove();
            var Empid = $("#empid").val();
            var lastday = $("#lastdaybyreporting").val();
            var remark = $("#remark").val();
            if (!lastday || lastday == "") {
                toastr.error("Please Select Last Working Date");
                return false;
            }
            if (!remark || remark == "") {
                toastr.error("Please Add Remark.");
                return false;
            }
            //var calculatedDate = new Date();
            //switch (lastday) {
            //    case "1":
            //        calculatedDate.setDate(calculatedDate.getDate() + 15);
            //        break;
            //    case "2":
            //        calculatedDate.setMonth(calculatedDate.getMonth() + 1);
            //        break;
            //    case "3":
            //        calculatedDate.setMonth(calculatedDate.getMonth() + 2);
            //        break;
            //    default:
            //        console.log("No duration selected");
            //        return;
            //}
            //var formattedDate = calculatedDate.toISOString().split('T')[0];
            var EmpEmail = $("#empemail").val();
            var reuestdata = {
                Empid:Empid,
                Lastday: lastday,
                remark: remark,
                Flag:0,
                Email: EmpEmail
            }
            $.ajax({
                url: webapiuri + "/TPOnboarding/ApproveVoluntarydiscontinuation",
                method: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                headers: { 'Authorization': token },
                data: JSON.stringify(reuestdata),
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (data) {
                    if (data.status) {
                        toastr.success("Voluntary Discontinuation Request Approve Successfully.")
                        $("#ApproveBtn_modal").modal('hide');
                        $("#lastdaybyreporting").val("");
                        $("#remark").val("");
                        LoadVoluntarydiscontinuationData(empid);
                    }
                },
                error: function (err) {
                    console.error("Error occur in save requst", err);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });
        $("#cancelrequest").click(function () {
            $("#ApproveBtn_modal").modal('hide');
            $("#lastdaybyreporting").val("");
            $("#remark").val("");
        })
    });
    function GetCompanyandBranchofEmployee(empid) {
        $.ajax({
            url: webapiuri + "/TPOnboarding/GetCompanyandBranch?Empid="+empid,
            method: "GET",
            contentType: "application/json; charset=utf-8",
            headers: { 'Authorization': token },
            success: function (response) {                
                $("#bunit").html('<option value="">Please Select</option>');
                $("#workstation").html('<option value="">Please Select</option>');
                $("#GW").html('<option value="">Please Select</option>');

                $.each(response, function (index, item) {
                    $("#bunit").append(`<option value="${item.CompanyId}">${item.CompanyName}</option>`);
                    $("#workstation").append(`<option value="${item.BranchId}">${item.BranchName}</option>`);
                    $("#GW").append(`<option value="${item.DepartmentId}">${item.DepartmentName}</option>`);
                });

                var currentData = response[0];
                var autoSelectCompany = currentData.CompanyId;
                var autoSelectBranch = currentData.BranchId;
                var autoSelectDepartment = currentData.DepartmentId;

                $("#bunit").val(autoSelectCompany).trigger('change');
                $("#workstation").val(autoSelectBranch).trigger('change');
                $("#GW").val(autoSelectDepartment).trigger('change');
            },
            error: function (err) {
                console.error("Error loading Data", err);
            }
        });
    }    
    function LoadVoluntarydiscontinuationData(empid) {
        $.ajax({
            url: webapiurl + "TPOnboarding/GetVoluntarydiscontinuationData?EmpId=" + empid,
            type: 'POST',
            headers: {
                'Authorization': token
            },            
            dataType: 'json',
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (res) {                
                if (!res || res.length === 0) {
                    $("#NotificationGrid-empty").show();
                    $("#tableResponsive").hide();
                    $("#dataTables_tbl_header").hide();
                }
                else {
                    $("#NotificationGrid-empty").hide();
                    LoadDataTable(res);
                }                
            },
            error: function () {
                toastr.error('Failed to load Voluntary discontinuation Data');
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }
    function LoadDataTable(data) {
        $("#dataTables_tbl_header").remove();
        var table = $("#tblVoluntarydiscontinuationReq").DataTable({
            destroy: true,
            dom: _domCommon,
            language: _languageCommon,
            data: data,
            order: [],
            columns: [
                { title: "Empid", data: "Empid", visible: false },
                { title: "Name", data: "EmpName" },
                { title: "Email", data: "useremail" },
                { title: "Reason for discontinuation", data: "reason" },
                { title: "Last Working Day", data: "Lastworkingday" },  
                { title: "Description", data: "Description" },  
                { title: "Remarks", data: "remark" },
                {
                    title: "Status", data: "status",
                    render: function (data) {
                        if (data == 0) return '<div>Pending</div>';
                        if (data == 1) return '<div class="red_font">Rejected by you</div>';
                        if (data == 2) return '<div class="orange_font">HR Approval Pending</div>';
                        if (data == 3) return '<div class="red_font">Rejected by HR</div>';
                        if (data == 4) return '<div class="green_font">Approved</div>';
                        return data;
                    }
                },  
                {
                    title: "Action", data: null,
                    render: function (data, type, row) {
                        var isPending = (row.status == 0);
                        var disabledAttr = isPending ? '' : 'disabled style="pointer-events: none; opacity: 0.6;"';
                        return `                        
                         <a id="" class="btn blue_btnnew tooltips ApproveBtn" data-placement="left" data-original-title="Approve" ${disabledAttr}><i class="fa-solid fa-check"></i></a>
                         <a id="" class="btn blue_btnnew tooltips RejectBtn" data-placement="left" data-original-title="Reject" ${disabledAttr}><i class="fa-solid fa-xmark"></i></a>
                         `;
                    }
                },  
            ],   
            initComplete: function () {
                const visibleTable = $('table:visible').attr('id');
                $("#buttons").append(`
                      <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                          <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                      </div>
                `);
            },
            drawCallback: function () {
                $('.tooltips').tooltip();
            },
        });
        setTimeout(function () {
            $("#" + "tblVoluntarydiscontinuationReq" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
    }
    function SendEmailToReportingManager() {
        $.ajax({
            url: webapiurl + "TPOnboarding/SendEmailToManagerOfDiscountinuation",
            type: 'POST',
            headers: {
                'Authorization': token
            },
            dataType: 'json',
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (res) {
                console.log("Email send successfully to manager.");
            },
            error: function () {
                console.log('Failed to send Manager Email.');
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }
</script>

