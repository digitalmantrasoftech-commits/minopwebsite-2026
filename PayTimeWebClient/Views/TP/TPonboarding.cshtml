                            item["Hemoglobin"],
                            item["Father Name"],
                            item["Mobile Number"],
                            item["Email ID"],
                            item["Date of Birth"],
                            item["Gender"],
                            item["Date of Joining"],
                            item["Aadhar Number"],
                            item["PAN Number"],
                            item["Annual Family Income"],
                            item["Religion"],
                            item["Category"],
                            item["Marital Status"],
                            item["Hostel Required"],
                            item["Distance (KM)"],
                            item["Address Line 1"],
                            item["Address Line 2"],
                            item["State"],
                            item["District"],
                            item["City"],
                            item["Pincode"],
                            item["Qualification"],
                            item["Stream"],
                            item["Specialization"],
                            item["Passing Month"],
                            item["Passing Year"],
                            item["Percentage/Grade"],
                            item["University/Institute"],
                            item["Blood Group"],
                            item["Any Blood Relation"],
                            item["Relation Detail"],
                            item["Emergency Contact Person"],
                            item["Emergency Contact Number"],
                            item["Emergency Relation"],
                            item["Pick-Up Point"],
                            item["bankaccountno"],
                            item["bankname"],
                            item["ifsccode"],
                            item["Lastworkingday"],
                            item["Status"],
