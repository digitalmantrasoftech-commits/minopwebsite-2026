        if ($firstTab.length > 0) {
            $firstTab.tab('show');
            var initialTabId = $firstTab.attr("href");
            triggerTabLoad(initialTabId);
        }
        // Set E Signature Code : Begin ===============================================
        const canvas = document.getElementById("sig-canvas");
        const ctx = canvas.getContext("2d");

        const img = document.getElementById("sig-image");
        const clearBtn = document.getElementById("clearBtn");
        const hiddenInput = document.getElementById("sig-dataUrl");

        /*  FIX: Set proper canvas size  */
        function resizeCanvas() {
            canvas.style.display = "block";

            let w = canvas.offsetWidth;
            let h = canvas.offsetHeight;

            if (w === 0 || h === 0) {
                w = 600;
                h = 200;
            }

            // preserve existing drawing
            const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);

            canvas.width = w;
            canvas.height = h;

            ctx.putImageData(imgData, 0, 0);

            ctx.lineWidth = 2;
            ctx.lineJoin = "round";
            ctx.lineCap = "round";
            ctx.strokeStyle = "#000";
        }

        resizeCanvas();

        /*  Draw Signature  */
        let drawing = false;
        let isSaved = false; // flag to prevent drawing after save

        function getPos(e) {
            const r = canvas.getBoundingClientRect();
            // Correct for canvas scaling
            const scaleX = canvas.width / r.width;
            const scaleY = canvas.height / r.height;
            return {
                x: (e.clientX - r.left) * scaleX,
                y: (e.clientY - r.top) * scaleY
            };
        }

        canvas.addEventListener("pointerdown", e => {
            if (isSaved) return;
            drawing = true;
            const p = getPos(e);
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
        });

        canvas.addEventListener("pointermove", e => {
            if (!drawing || isSaved) return;
            const p = getPos(e);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
        });

        canvas.addEventListener("pointerup", () => {
            if (isSaved) return;
            drawing = false;
            ctx.closePath();
        });

        canvas.addEventListener("pointerleave", () => {
            drawing = false; // stop drawing if cursor leaves canvas
        });

        /*  CLEAR */
        clearBtn.addEventListener("click", () => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            canvas.style.display = "block";
            img.style.display = "none";
            isSaved = false; // allow drawing again after clearing
        });
        // Set E Signature Code : End ===============================================

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var activeTabId = $(e.target).attr("href");
