                }
            })
        })

        $("#tblTraineReq").on('click', '.ApproveBtn', function () {
            var table = $('#tblTraineReq').DataTable();
            var rowData = table.row($(this).closest('tr')).data();
            $("#req_appid").val(rowData.trackingid);
            $('#req_name').val(rowData.name);
            $('#req_fathername').val(rowData.fathername);
            const getValue = (obj, key) => {
                if (!obj) return "";
                return obj[key] || obj[key.charAt(0).toUpperCase() + key.slice(1)] || obj[key.toLowerCase()] || "";
            };
            var dateVal = getValue(rowData, "dob1");
            if (dateVal) {
                var parts = dateVal.split(/[-/]/);

                if (parts.length === 3) {
                    var day, month, year;
                    var monthMap = {
                        "Jan": "01", "Feb": "02", "Mar": "03", "Apr": "04",
                        "May": "05", "Jun": "06", "Jul": "07", "Aug": "08",
                        "Sep": "09", "Oct": "10", "Nov": "11", "Dec": "12"
                    };
                    var yearIndex = parts.findIndex(p => p.length === 4);
                    year = parts[yearIndex];
                    var remainingParts = parts.filter((_, index) => index !== yearIndex);

                    var textMonthIndex = remainingParts.findIndex(p => isNaN(p));

                    if (textMonthIndex !== -1) {
                        month = monthMap[remainingParts[textMonthIndex]];
                        day = remainingParts[textMonthIndex === 0 ? 1 : 0].padStart(2, '0');
                    } else {
                        if (yearIndex === 0) {
                            month = remainingParts[0].padStart(2, '0');
                            day = remainingParts[1].padStart(2, '0');
                        } else if (parseInt(remainingParts[0]) > 12) {
                            day = remainingParts[0].padStart(2, '0');
                            month = remainingParts[1].padStart(2, '0');
                        } else {
                            month = remainingParts[0].padStart(2, '0');
                            day = remainingParts[1].padStart(2, '0');
                        }
                    }

                    if (year && month && day) {
                        var formattedDate = year + "-" + month + "-" + day;
                        $("#req_dob").val(formattedDate);
                    }
                }
            }
            $('#req_mobile').val(rowData.mobileno);
            $('#req_email').val(rowData.emailid);
            $('#req_distance').val(rowData.distance);
            $('#req_address').val(rowData.address1);
            $('#req_address1').val(rowData.address2);
            $('#req_pincode').val(rowData.pincode);
            $('#req_specialization').val(rowData.Specialization);
            $('#req_grade').val(rowData.percentage);
            $('#req_university').val(rowData.universityname);
            $('#req_aadhar_no').val(rowData.aadharno);
            $('#req_pan_no').val(rowData.panno);
            $('#req_district').val(rowData.district);
            $('#req_city').val(rowData.city);
            $("#req_disabilitydetail").val(rowData.disabilitydetail);
            $("#eduid").val(rowData.eduid);

            loadStatesForEdit(rowData.state);
            loadReligionForEdit(rowData.religion);
            if (rowData.IsDisability !== undefined && rowData.IsDisability !== null) {
                var disabilityValue = rowData.IsDisability.toString();
                $('#req_IsDisability').val(disabilityValue).trigger('change');
            }
            if (rowData.Category) $('#req_category').val(rowData.Category.trim()).trigger('change');
            if (rowData.gender !== undefined) $('#req_gender').val(rowData.gender).trigger('change');
            if (rowData.qualification) $('#req_education').val(rowData.qualification.trim()).trigger('change');
            if (rowData.stream) $('#req_stream').val(rowData.stream).trigger('change');
            if (rowData.passing_month) $('#req_pass_month').val(rowData.passing_month.trim()).trigger('change');
            if (rowData.passing_year) $('#req_pass_year').val(rowData.passing_year).trigger('change');

            if (rowData.maritalstatus !== undefined) $('#req_marital_status').val(rowData.maritalstatus).trigger('change');
            if (rowData.familyincome) $('#req_fincome').val(rowData.familyincome.trim()).trigger('change');

            var hostelVal = rowData.hostel !== undefined ? rowData.hostel : rowData.hostel_req;
            $('#req_hostel').val(hostelVal).trigger('change');

            $('#link_aadhar_download').attr('href', rowData.aadharfilepath || 'javascript:;').attr('target', rowData.aadharfilepath ? '_blank' : '');
            $('#link_pan_download').attr('href', rowData.panfilepath || 'javascript:;').attr('target', rowData.panfilepath ? '_blank' : '');

            if (rowData.Status == 0) {
                $("#updateBtn").show();
                $("#RejectBtn").show().prop('disabled', false);
                $("#SendReqBtn").show().prop('disabled', false);
            } else if (rowData.Status == 1 || rowData.Status == 2) {
                $("#SendReqBtn").hide();
                $("#RejectBtn").hide();
            }
            $(".ApproveBtn").attr("data-toggle", "modal");
            $(".ApproveBtn").attr("data-target", "#ApproveReq_modal");
        });

