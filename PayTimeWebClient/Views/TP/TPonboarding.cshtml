            var v_streams = (rowData.stream || "").split('|').map(s => s.trim());
            var v_months = (rowData.passing_month || "").split('|').map(s => s.trim());
            var v_years = (rowData.passing_year || "").split('|').map(s => s.trim());
            var v_specs = (rowData.Specialization || "").split('|').map(s => s.trim());
            var v_unis = (rowData.universityname || "").split('|').map(s => s.trim());
            var v_grades = (rowData.percentage || "").split('|').map(s => s.trim());

            var $eduContainer = $("#education_dynamic_container");
            $eduContainer.empty();

            v_quals.forEach(function (qual, i) {
                var eduHtml = `
                    <div class="education-block mb-3">

                        <input type="hidden" class="edu-id" value="${v_eduids[i] || ""}">

                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="control-label">Qualification</label>
                                    <select class="form-control select2 edu-qual" data-val="${qual}">
                                        <option value="">Select</option>
                                        <option value="10th/ITI">10th/ITI</option>
                                        <option value="12th/Diploma">12th/Diploma</option>
                                        <option value="Graduate">Graduate</option>
                                        <option value="Additional Qualification.">Additional Qualification.</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="control-label">Stream</label>
                                    <select class="form-control select2 edu-stream" data-val="${v_streams[i] || ""}">
                                        <option value="">Select</option>
                                        <option value="Science">Science</option>
                                        <option value="Commerce">Commerce</option>
                                        <option value="Arts">Arts</option>
                                        <option value="Engineering">Engineering</option>
                                        <option value="NA">NA</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group mb-3">
                                    <label class="control-label">Month</label>
                                    <select class="form-control select2 edu-month" data-val="${v_months[i] || ""}">
                                        <option value="Jan">Jan</option><option value="Feb">Feb</option><option value="Mar">Mar</option>
                                        <option value="Apr">Apr</option><option value="May">May</option><option value="Jun">Jun</option>
                                        <option value="Jul">Jul</option><option value="Aug">Aug</option><option value="Sep">Sep</option>
                                        <option value="Oct">Oct</option><option value="Nov">Nov</option><option value="Dec">Dec</option>
                                    </select>
                                </div>
                            </div>
                           <div class="col-sm-3">
                                <div class="form-group mb-3">
                                    <label class="control-label">Year</label>
                                    <select class="form-control select2 edu-year" data-val="${v_years[i] || ""}">
                                        ${(() => {
                                              let options = '<option value="">Year</option>';
                                              let currentYear = new Date().getFullYear();
                                              for (let y = 0; y < 50; y++) {
                                                  let year = currentYear - y;
                                                  let selected = (year == (v_years[i] || "")) ? 'selected' : '';
                                                     options += `<option value="${year}" ${selected}>${year}</option>`;
                                              }
                                              return options;
                                            })()
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group mb-3">
                                    <label class="control-label">Specialization</label>
                                    <input type="text" class="form-control edu-spec" value="${v_specs[i] || ""}" placeholder="" oninput="this.value = this.value.replace(/[^A-Za-z\s]/g, '')">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group mb-0">
                                    <label class="control-label">University/Institute</label>
                                    <input type="text" class="form-control edu-uni" value="${v_unis[i] || ""}" placeholder="Enter University Name">
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group mb-0">
                                    <label class="control-label">Grade/Percentage</label>
                                    <input type="text" class="form-control edu-grade" value="${v_grades[i] || ""}" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\\..*)\\./g, '$1').replace(/(\\.\\d{2})./g, '$1'); if(this.value !== '' && parseFloat(this.value) > 100) this.value = '100';">
                                </div>
                            </div>
                        </div>
                    </div>`;
                $eduContainer.append(eduHtml);
            });

            $eduContainer.find('.select2').select2({ width: '100%' });

            $eduContainer.find('select').each(function () {
                var val = $(this).data('val');
                if (val) {
                    $(this).val(val).trigger('change');
                }
