                return;
            }
            var filenames = rowData.edufilename.split('|').map(s => s.trim());
            var filepaths = rowData.edufilepathname.split('|').map(s => s.trim());
            if (filenames.length === 0 || (filenames.length === 1 && filenames[0] === "")) {
                toastr.error("Documents are missing.");
                return;
            }
