    <script>
        // Custom trigger
        document.getElementById("uploadTrigger").addEventListener("click", function () {
            document.getElementById("uploadFileMed").click();
        });

        document.getElementById("uploadTriggerEdu").addEventListener("click", function () {
            document.getElementById("uploadFile").click();
        });

        let selectedFiles = [];

        document.getElementById("uploadFile").addEventListener("change", function () {
            let newFiles = Array.from(this.files);

            selectedFiles = selectedFiles.concat(newFiles);

            renderFileList();
            this.val = "";
        });
        document.getElementById("uploadFileMed").addEventListener("change", function () {
            let newFiles = Array.from(this.files);

            selectedFiles = selectedFiles.concat(newFiles);

            renderFileListMed();
            this.val = "";
        });

        function renderFileList() {
            let listDiv = document.getElementById("fileList_hr");
            listDiv.innerHTML = "";

            if (selectedFiles.length > 0) {
                listDiv.style.display = "block";
            } else {
                listDiv.style.display = "none";
            }

            selectedFiles.forEach((file, index) => {
                if (file.type === "application/pdf") {
                    let item = document.createElement("div");
                    item.style.display = "flex";
                    item.style.alignItems = "center";
                    item.style.marginBottom = "5px";
                    item.style.justifyContent = "space-between";

                    let fileInfo = `
                                    <div style="display:flex; align-items:center;">
                                        <img src='/assets/images/icons/reports/ir_dw_pdf.svg' alt='PDF Icon' width='20' style='margin-right:5px;'>
                                        <span>${file.name}</span>
                                    </div>`;

                    let removeBtn = `
                                    <button type="button" onclick="removeFile(${index})" style="background:none; border:none; color:red; cursor:pointer; font-size:16px; margin-left:10px;">
                                        &times;
                                    </button>`;

                    item.innerHTML = fileInfo + removeBtn;
                    listDiv.appendChild(item);
                }
            });
        }
        function renderFileListMed() {
            let listDiv = document.getElementById("fileList_hrMed");
            listDiv.innerHTML = "";

            if (selectedFiles.length > 0) {
                listDiv.style.display = "block";
            } else {
                listDiv.style.display = "none";
            }

            selectedFiles.forEach((file, index) => {
                if (file.type === "application/pdf") {
                    let item = document.createElement("div");
                    item.style.display = "flex";
                    item.style.alignItems = "center";
                    item.style.marginBottom = "5px";
                    item.style.justifyContent = "space-between";

                    let fileInfo = `
                            <div style="display:flex; align-items:center;">
                                <img src='/assets/images/icons/reports/ir_dw_pdf.svg' alt='PDF Icon' width='20' style='margin-right:5px;'>
                                <span>${file.name}</span>
                            </div>`;

                    let removeBtn = `
                            <button type="button" onclick="removeFileMed(${index})" style="background:none; border:none; color:red; cursor:pointer; font-size:16px; margin-left:10px;">
                                &times;
                            </button>`;

                    item.innerHTML = fileInfo + removeBtn;
                    listDiv.appendChild(item);
                }
            });
        }

        function removeFile(index) {
            selectedFiles.splice(index, 1);
            renderFileList();
        }
        function removeFileMed(index) {
            selectedFiles.splice(index, 1);
            renderFileListMed();
        }
    </script>
