            var email = $("#TrainneEmail").val().trim();
            const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!email) {
                toastr.remove();
                toastr.error("Please Enter Email.");
                return false;
            }
            if (!emailPattern.test(email)) {
                toastr.remove();
                toastr.error("Please Enter Valid Email.");
                return false;
            }
            $.ajax({
                type: 'POST',
                url: webapiuri + "TPOnboarding/SendEmailToEmployee",
                contentType: "application/json; charset=utf-8",
                headers: {
                    'Authorization': token
                },
                data: JSON.stringify({ Email: email }),
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (res) {
                    if (res) {
                        toastr.success("Check your email to fill the application form");
                        $("#ajax_loader").hide();
