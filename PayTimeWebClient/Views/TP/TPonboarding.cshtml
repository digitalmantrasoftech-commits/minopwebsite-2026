    $(document).on('click', '.UploadBtnn', function () {
        var applicationID = $(this).data('applicationid');
        var record = medicalDocsData.find(x => x.ApplicationID === applicationID);
        if (!record) return;
        $('#appname').text(record.name);
        $('#appID').text(record.ApplicationID);

        // Reset all checkboxes
        $('.checkbox-input')
            .prop('checked', false)
            .closest('.checkbox-item')
            .removeClass('active');

        $('.checkbox-input').each(function () {
            var type = $(this).data('type');
            var value = record[type];

            if (value && value.includes('1')) {
                $(this).prop('checked', true);
                $(this).closest('.checkbox-item').addClass('active');
            }
        });

        $("#UploadBtn_modal").modal('show');
    });

    $(document).on("click", "#btnSubmit", async function (e) {
        e.preventDefault();

        let selectedDocs = {};
        let hasSelection = false;

        $(".checkbox-input").each(function () {
            const type = $(this).data("type");
            const checked = $(this).is(":checked");
            selectedDocs[type] = checked;
            if (checked) hasSelection = true;
        });

        if (!hasSelection) {
            toastr.error("Please select at least one medical document.");
            return;
        }

        const files = $("#uploadFileMed")[0].files;
        if (files.length === 0) {
            toastr.error("Please upload medical documents.");
            return;
        }

        const fileData = new FormData();
        for (let i = 0; i < files.length; i++) {
            if (files[i].size > 2 * 1024 * 1024) {
                toastr.error("Each file must be under 2 MB.");
                return;
            }
            fileData.append("files", files[i]);
        }

        let uploadResult;
        try {
            uploadResult = await $.ajax({
                type: "POST",
                url: "/TP/MedicalDocuments",
                data: fileData,
                contentType: false,
                processData: false
            });
        } catch (err) {
            toastr.error("File upload failed.");
            return;
        }

        const medicalFiles = uploadResult.UploadedFiles.map(f => ({
            FileName: f.OriginalName,
            FilePath: f.SavedPath
        }));

        const medicalData = {
            ApplicantId: $("#appID").text(),
            BloodTest: selectedDocs.Blood,
            UrineTest: selectedDocs.Urine,
            EcgReport: selectedDocs.ECG,
            XrayReport: selectedDocs.XRay,
            VisionReport: selectedDocs.Vision,
            //DoctorFitness: selectedDocs.Doctor,
            MedicalFiles: medicalFiles
        };

        $.ajax({
            type: "POST",
            url: webapiurl + "TPOnboarding/SaveMedicalDocuments",
            contentType: "application/json; charset=utf-8",
            headers: {
                "Authorization": token
            },
            data: JSON.stringify(medicalData),
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function () {
                toastr.success("Medical documents uploaded successfully");
                loadMedicalDocsData();
                let selectedFiles = [];
                $("#uploadFileMed").val("");
                $("#fileList_hrMed").empty();
                $("#UploadBtn_modal").modal("hide");
            },
            error: function () {
                toastr.error("Error while saving medical documents");
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    });
</script>

