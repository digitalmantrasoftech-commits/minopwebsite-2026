@using System.Configuration;
@{
    ViewBag.Title = "TP SOLAR LTD - Medical Form";
    Layout = "";
    //string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
}
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1" name="viewport" />
</head>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&display=swap" rel="stylesheet">
<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">
<link href="/Newlayout/css/CustomDesign/mysubscription.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Roboto', sans-serif;
        background-color: #e7e8eb;
        min-height: 100vh;
    }

    /* Header Styles */
    .header {
        background-color: #ffffff;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        padding: 4px 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 56px;
        gap: 16px;
    }

    .logo-section {
        display: flex;
        align-items: flex-end;
        gap: 4px;
    }

    .logo-text {
        width: 130px;
        height: auto;
    }

    .header-divider {
        width: 1px;
        height: 24px;
        background-color: rgba(0, 0, 0, 0.2);
    }

    .company-name {
        font-family: 'Segoe UI', sans-serif;
        font-weight: 700;
        font-size: 20px;
        color: #1b69b2;
    }

    /* Main Content */
    .main-content {
        padding: 24px 86px;
        overflow-y: auto;
    }

    /* Page Title */
    .page-title {
        text-align: center;
        font-size: 24px;
        font-weight: 500;
        color: #034694;
        margin-bottom: 24px;
    }

    /* Form Card */
    .form-card {
        background-color: #ffffff;
        border: 1px solid #c9c9c9;
        border-radius: 8px;
        max-width: 750px;
        margin: 0 auto;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        margin-bottom: 16px;
    }

    .form-header {
        background-color: #f7f8fa;
        border-bottom: 1px solid #c9c9c9;
        padding: 10px 16px;
    }

    .form-header-text {
        font-size: 16px;
        font-weight: 500;
        color: #252525;
    }

    .form-body {
        padding: 16px;
        flex: 1;
        overflow-y: auto;
    }

    .section-title {
        font-size: 14px;
        font-weight: 700;
        color: #034694;
        padding-bottom: 12px;
        border-bottom: 1px solid #e0e0e0;
        margin-bottom: 12px;
    }

    .form-label {
        font-size: 14px;
        font-weight: 400;
        color: #333333;
        margin-bottom: 8px;
        display: block;
    }

    /* Checkbox Options */
    .checkbox-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 12px;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 12px 8px;
        border: 1px solid #dbdbdb;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .checkbox-item.active {
            border: 1px solid #295097;
        }

        .checkbox-item:hover {
            background-color: #f5f8ff;
        }

        .checkbox-item input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #295097;
        }

        .checkbox-item label {
            font-size: 14px;
            color: #252525;
            cursor: pointer;
            flex: 1;
        }

    /* Upload Field */
    .upload-field {
        border: 1px dashed #c4c4c4;
        padding: 12px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        border-radius: 4px;
        height: 64px;
        margin-bottom: 12px;
    }

        .upload-field:hover {
            background: #f5f5f5;
        }

    .upload-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .upload-icon {
        width: 24px;
        height: 24px;
    }

    .upload-text {
        color: #757575;
        font-size: 14px;
    }

    .upload-hint {
        color: #757575;
        font-size: 12px;
    }

    /* Uploaded Files */
    .uploaded-files {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
    }

    .uploaded-file {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 8px 12px;
        background: #fff;
        border: 1px solid #c4c4c4;
        border-radius: 4px;
        height: 44px;
    }

    .uploaded-file-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .file-icon {
        width: 18px;
        height: 18px;
    }

    .file-name {
        font-size: 12px;
        color: #333;
    }

    .uploaded-file-actions {
        display: flex;
        gap: 8px;
    }

        .uploaded-file-actions button {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            width: 20px;
            height: 20px;
        }

            .uploaded-file-actions button svg {
                width: 100%;
                height: 100%;
            }

    /* Form Footer */
    .form-footer {
        background-color: #f7f8fa;
        border-top: 1px solid #c9c9c9;
        padding: 10px 16px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-primary {
        background-color: #2196f3;
        border: 2px solid #2196f3;
        border-radius: 4px;
        padding: 6px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #ffffff;
        cursor: pointer;
        font-family: 'Roboto', sans-serif;
    }

        .btn-primary:hover {
            background-color: #1976d2;
            border-color: #1976d2;
        }

    .btn-secondary {
        background-color: #ffffff;
        border: 1px solid #c9c9c9;
        border-radius: 4px;
        padding: 6px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #252525;
        cursor: pointer;
        font-family: 'Roboto', sans-serif;
    }

        .btn-secondary:hover {
            background-color: #f5f5f5;
        }

    /* Success Card */
    .success-card {
        background-color: #ffffff;
        border: 1px solid #c9c9c9;
        border-radius: 8px;
        max-width: 750px;
        margin: 0 auto;
        overflow: hidden;
    }

    .success-card-body {
        padding: 16px;
    }

    .success-message {
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .success-icon {
        width: 20px;
        height: 20px;
        background-color: #34c759;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .success-icon svg {
            width: 16px;
            height: 16px;
        }

    .success-title {
        font-size: 16px;
        font-weight: 500;
        color: #034694;
        flex: 1;
    }

    .success-card-footer {
        background-color: #f7f8fa;
        border-top: 1px solid #c9c9c9;
        padding: 16px;
        display: flex;
        justify-content: flex-end;
    }

    .uploaded-files {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .file-chip {
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 5px;
        padding: 8px 12px;
    }

    /* Loading Style */
    .loading {
        z-index: 10000000000;
        padding-top: 250px;
    }

    .modal_bg {
        position: fixed;
        background: rgb(0 0 0 / .65);
        top: 0;
        right: 0;
        left: 0;
        z-index: 9999999;
        text-align: center;
        width: 100%;
        height: 100%;
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .main-content {
            padding: 24px 40px;
        }
    }

    @@media (max-width: 768px) {
        .main-content {
            padding: 10px;
        }

        .upload-field {
            flex-direction: column;
            height: auto;
            align-items: flex-start;
            gap: 8px;
        }

        .page-title {
            font-size: 16px;
            margin-bottom: 10px;
        }

        .form-header {
            padding: 8px;
        }

        .form-footer {
            padding: 8px;
        }
       
    }
</style>

<link href="~/Content/toastr.min.css" rel="stylesheet" />
<script src="~/Scripts/toastr.min.js"></script>
<script>
    var webapiurl = '@_webapiurl';
         var token = '@_tokan';
    $(document).ready(function () {
        var appId = sessionStorage.getItem("currentAppId");
        console.log(appId);        
        CheckMedicalDataExit(appId);
        let allSelectedFiles = [];

        $("#medical-upload").on("change", function () {
            allSelectedFiles = [];

            if (this.files.length > 0) {
                existingMedicalFile = null;
                allSelectedFiles.push(this.files[this.files.length - 1]);
            }
        });
        
            $("#btnSubmit").click(async function (e) {
                e.preventDefault();
                toastr.remove();
                var model = {
                    bloodtest: $("#bloodtest").is(":checked"),
                    urinetest: $("#urinetest").is(":checked"),
                    ecgreport: $("#ecgreport").is(":checked"),
                    xrayreport: $("#xrayreport").is(":checked"),
                    visionreport: $("#visionreport").is(":checked"),
                    //doctorfitness: $("#doctorfitness").is(":checked")
                };
                var allChecked = Object.values(model).every(value => value === true);

                if (!allChecked) {
                    toastr.error("Please Select All Report.");
                    return false;
                }
                if (!model.bloodtest && !model.urinetest && !model.ecgreport &&
                    !model.xrayreport && !model.visionreport && !model.doctorfitness) {
                    toastr.error("Please select at least one medical document.");
                    return;
                }
                let medicalFiles = [];
                                

                //let medicalFiles = [...existingFiles];
                var files = $("#medical-upload")[0].files;
                if (allSelectedFiles.length === 0 && !existingMedicalFile) {
                    toastr.error("Please upload medical documents.");
                    return;
                }
                //var fileData = new FormData();
                //for (let i = 0; i < allSelectedFiles.length; i++) {
                //    if (allSelectedFiles[i].size > 2 * 1024 * 1024) {
                //        toastr.error("Each file must be under 2 MB.");
                //        return;
                //    }
                //    fileData.append("files", allSelectedFiles[i]);
                //}
                //let uploadResult;
                //try {
                //    uploadResult = await $.ajax({
                //        type: "POST",
                //        url: "/TP/MedicalDocuments",
                //        data: fileData,
                //        contentType: false,
                //        processData: false
                //    });
                //} catch (err) {
                //    toastr.error("File upload failed");
                //    return;
                //}
                if (allSelectedFiles.length > 0) {
                    var fileData = new FormData();
                    for (let file of allSelectedFiles) {
                        if (file.type !== "application/pdf") {
                            toastr.error(`${file.name} is not a PDF file. Please upload PDF file.`);
                            return;
                        }
                        if (file.size > 5 * 1024 * 1024) {
                            toastr.error(`${file.name} is over 5 MB.`);
                            return;
                        }
                        fileData.append("files", file);
                    }

                    try {
                        let uploadResult = await $.ajax({
                            type: "POST",
                            url: "/TP/MedicalDocuments",
                            data: fileData,
                            contentType: false,
                            processData: false
                        });

                        var newFiles = uploadResult.UploadedFiles.map(f => ({
                            FileName: f.OriginalName,
                            FilePath: f.SavedPath
                        }));
                        medicalFiles = medicalFiles.concat(newFiles);
                    } catch (err) {
                        toastr.error("File upload failed");
                        return;
                    }
                }
                else if (existingMedicalFile) {                    
                    medicalFiles.push(existingMedicalFile);
                }
                var medicalData = {
                    ApplicantId: appId,
                    BloodTest: model.bloodtest,
                    UrineTest: model.urinetest,
                    EcgReport: model.ecgreport,
                    XrayReport: model.xrayreport,
                    VisionReport: model.visionreport,
                    //DoctorFitness: model.doctorfitness,
                    MedicalFiles: medicalFiles
                };
                $("#ajax_loader").show();
                var targetUrl = updateFlag
                    ? webapiurl + "TPOnboarding/TPMedicalDataUpdate"
                    : webapiurl + "TPOnboarding/SaveMedicalDocuments";
                $.ajax({
                    type: "POST",
                    url: targetUrl,
                    contentType: "application/json; charset=utf-8",
                    headers: {
                        "Authorization": token
                    },
                    data: JSON.stringify(medicalData),
                    beforeSend: function () {
                        $("#ajax_loader").show();
                    },
                    success: function () {
                        $("#ajax_loader").hide();
                        $("#medicalform").hide();
                        $("#successcard").show();
                        allSelectedFiles = [];
                        $("#medical-upload").val("");
                    },
                    error: function () {
                        toastr.error("Error while saving medical documents");
                    },
                    complete: function () {
                        $("#ajax_loader").hide();
                    }
                });
            });
        $("#resetForm").click(function () {
            $(".checkbox-list input[type='checkbox']").prop("checked", false);
            $("#medical-upload").val("");
            $("#selectedFilesContainer").empty();
            allSelectedFiles = [];
            if (toastr.clear) {
                toastr.clear();
            }
        });
        $("#selectedFilesContainer").on("click", ".remove-file", function () {
            $(this).closest(".file-chip").remove();
        });
    });
    var updateFlag = 0;
    let existingMedicalFile = null;
    function CheckMedicalDataExit(appId) {
        $.ajax({
            type: "POST",
            url: webapiurl + "/TPOnboarding/CheckMediaclDataExist",
            headers: {
                "Authorization": token
            },
            data: { appId: appId },
            dataType: 'json',
            success: function (res) {                
                if (res.status && res.data.length > 0) {
                    $("#resetForm").hide();
                    updateFlag = 1;
                    var medicalData = res.data[0];
                    const setCheckbox = (id, reportString) => {
                        if (reportString) {
                            var isActive = reportString.split(',').includes("1");
                            $(`#${id}`).prop('checked', isActive);
                        }
                    };

                    setCheckbox('bloodtest', medicalData.BloodReports);
                    setCheckbox('urinetest', medicalData.UrineReports);
                    setCheckbox('ecgreport', medicalData.ECGReports);
                    setCheckbox('xrayreport', medicalData.XRayReports);
                    setCheckbox('visionreport', medicalData.VisionReports);
                    //setCheckbox('doctorfitness', medicalData.Doctorsfitness);

                    var fileContainer = $("#selectedFilesContainer");
                    fileContainer.empty();

                    if (medicalData.FileNames && medicalData.FilePaths) {
                        var names = medicalData.FileNames.split(',');
                        var paths = medicalData.FilePaths.split(',');

                        if (names.length > 0 && names[0].trim() !== "") {                            
                            existingMedicalFile = {
                                FileName: names[0].trim(),
                                FilePath: paths[0]
                            };
                        } 

                        names.forEach((name, index) => {
                            if (name.trim() !== "") {
                                var fileItem = document.createElement('div');
                                fileItem.className = 'uploaded-file';

                                fileItem.innerHTML = `
                                    <div class="uploaded-file-info">
                                        <svg class="file-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:18px; height:18px;">
                                            <path d="M14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8L14 2Z" stroke="#1b60ab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <polyline points="14,2 14,8 20,8" stroke="#1b60ab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <a href="${paths[index]}" target="_blank" class="file-name" style="text-decoration:none; color:inherit; font-size:13px; margin-left:8px;">
                                            ${name}
                                        </a>
                                    </div>
                                    <div class="uploaded-file-actions">
                                        <button type="button" title="Remove" onclick="this.closest('.uploaded-file').remove()">
                                            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:14px; height:14px;">
                                                <path d="M15 5L5 15M5 5L15 15" stroke="#757575" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>
                                    </div>
                                `;
                                fileContainer.append(fileItem);
                            }
                        });
                    }
                } else {
                    $(".checkbox-list input[type='checkbox']").prop('checked', false);
                    $("#selectedFilesContainer").empty();
                }
            },
            error: function () {
                toastr.error("Failed to load Meidcal data");
            }
        });
    }
    function updateFileName(input, labelId) {
        if (input.files && input.files[0]) {
            var filename = input.files[0].name;
            $("#" + labelId).text(filename);
        }
    }
</script>

<div id='ajax_loader' class="modal_bg loading" aria-hidden="true" style="display:none">
    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
</div>
<!-- Header -->
<header class="header">
    <div class="logo-section">
        <img class="logo-text" src="https://app.minopcloud.com/AssetsNew/images/logo.png" alt="logo" />
    </div>
    <div class="header-divider"></div>
    <span class="company-name">TP SOLAR LTD</span>
</header>

<!-- Main Content -->
<main class="main-content">

    <!-- Page Title -->
    <h2 class="page-title">Medical Assessment</h2>

    <!-- Medical Form -->
    @*<form class="form-card">*@
    <form action="/Medical/UploadDocuments" method="post" id="medicalform" enctype="multipart/form-data" class="form-card">
        <div class="form-header">
            <span class="form-header-text">Mandatorily upload all the medical documents mentioned below.</span>
        </div>

        <div class="form-body">
            <div class="form-section">
                <h3 class="section-title">To be uploaded by you</h3>

                <label class="form-label">Select document(s) to upload</label>

                <div class="checkbox-list" style="margin-bottom:10px">
                    <div class="checkbox-item">
                        <input type="checkbox" id="bloodtest" name="documents" value="bloodtest">
                        <label for="blood-test">Blood test</label>
                    </div>
                    <div class="checkbox-item">
                        <input type="checkbox" id="urinetest" name="documents" value="urinetest">
                        <label for="urine-test">Urine test</label>
                    </div>
                    <div class="checkbox-item">
                        <input type="checkbox" id="ecgreport" name="documents" value="ecgreport">
                        <label for="ecg-report">ECG Report</label>
                    </div>
                    <div class="checkbox-item">
                        <input type="checkbox" id="xrayreport" name="documents" value="xrayreport">
                        <label for="xray-report">X-Ray Report</label>
                    </div>
                    <div class="checkbox-item">
                        <input type="checkbox" id="visionreport" name="documents" value="visionreport">
                        <label for="vision-report">Vision Report</label>
                    </div>
                    <div class="checkbox-item" style="display:none">
                        <input type="checkbox" id="doctorfitness" name="documents" value="doctorfitness">
                        <label for="doctor-fitness">Doctor fitness report</label>
                    </div>
                </div>
                <label class="form-label">Scan all the documents and upload as Single PDF.</label>
                <label class="upload-field" for="medical-upload">
                    <input type="file" id="medical-upload" accept=".pdf" style="display:none;">
                    <div class="upload-left">
                        <svg class="upload-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M21 15V19C21 19.5304 20.7893 20.0391 20.4142 20.4142C20.0391 20.7893 19.5304 21 19 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V15"
                                  stroke="#555555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <polyline points="17,8 12,3 7,8" stroke="#555555" stroke-width="2"
                                      stroke-linecap="round" stroke-linejoin="round" />
                            <line x1="12" y1="3" x2="12" y2="15" stroke="#555555" stroke-width="2"
                                  stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="upload-text" id="lblmedical">Upload file in pdf</span>
                    </div>
                    <span class="upload-hint">upload size limit to 5 MB</span>
                </label>

                <label class="form-label" style="display:none">Uploaded documents</label>
                <div class="uploaded-files" id="selectedFilesContainer">
                </div>
            </div>
        </div>
        <div class="form-footer">
            <button id="resetForm" type="button" class="btn-secondary">Reset</button>
            <button id="btnSubmit" type="submit" class="btn-primary">Submit</button>
        </div>
    </form>

    <!-- Success Block -->
    <div class="success-card" id="successcard" style="display:none">
        <div class="success-card-body">
            <div class="success-message">
                <div class="success-icon">
                    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M13.3333 4L6 11.3333L2.66667 8" stroke="white" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </div>
                <span class="success-title">We've Captured your details and will get back to you soon.</span>
            </div>
        </div>
        @*<div class="success-card-footer">
                <button class="btn-primary">Back to home</button>
            </div>*@
    </div>

</main>

<script>
    // File upload handler

    document.getElementById('medical-upload').addEventListener('change', function () {
        const files = this.files;
        const container = document.querySelector('.uploaded-files');

        if (files.length > 0) {
            const file = files[0];

            if (file.type !== "application/pdf") {
                toastr.error("Only PDF files are allowed. Please upload a PDF file.");
                this.value = "";
                return;
            }

            container.innerHTML = "";

            const fileItem = document.createElement('div');
            fileItem.className = 'uploaded-file';
            fileItem.innerHTML = `
                <div class="uploaded-file-info">
                    <svg class="file-icon" viewBox="0 0 24 24" fill="none">
                        <path d="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2Z"
                              stroke="#1b60ab" stroke-width="2"/>
                        <polyline points="14,2 14,8 20,8"
                                  stroke="#1b60ab" stroke-width="2"/>
                    </svg>
                    <span class="file-name">${file.name}</span>
                </div>
                <div class="uploaded-file-actions">
                    <button type="button" title="Remove">
                        <svg viewBox="0 0 20 20" fill="none">
                            <path d="M15 5L5 15M5 5L15 15"
                                  stroke="#757575" stroke-width="1.5"/>
                        </svg>
                    </button>
                </div>
            `;

            fileItem.querySelector('button').addEventListener('click', () => {
                fileItem.remove();
                this.value = "";
            });

            container.appendChild(fileItem);
        }
    });

</script>



