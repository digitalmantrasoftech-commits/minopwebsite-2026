        // Form submission via AJAX - Updated for MVP
        $("#btnSubmit").click(function (event) {
            event.preventDefault();

            if (!validateForm()) {
                return false;
            }

            // Prepare data object - MVP version with defaults for Employee/Overtime fields
            var policyData = {
                PolicyId: parseInt($("#PolicyId").val()) || 0,
                PolicyName: $("#ConfigurationName").val(),  // Use ConfigurationName field

                // Employee fields - Send defaults (commented out in UI)
                EmpWeekOff: 0,
                EmpSecondWeekOff: 0,
                EmpSecondWeekOffRule: "",
                EmpHalfDay: 0,
                EmpHalfDayRule: "",

                // Overtime fields - Send defaults (commented out in UI)
                OTMinHour: 0,
                OTAllowWO: false,
                WeekOffOTHour: 0,
                OTAllowHO: false,
                HolidayOffOTHour: 0,

                // Field Configuration - Active fields
                DefaultRadius: parseInt($("#DefaultRadius").val()) || 100,
                LocationUpdateFrequency: parseInt($("#LocationUpdateFrequency").val()) || 5,
                EmpCanCreateTask: $("#EmpCanCreateTask").is(':checked'),
                AutoCheckIn: $("#AutoCheckIn").is(':checked'),
                ProofOfWork: parseInt($("#ProofOfWork").val()) || 0
            };


            // Add create-specific fields for new policies
            if (policyData.PolicyId === 0) {
                policyData.CreatedBy = parseInt(_UserId);
                policyData.CreatedDate = new Date().toISOString();
                policyData.IsActive = true;
            }

            // Determine API endpoint and method
            var apiUrl = policyData.PolicyId === 0
                ? _webapiurl + "workpolicy/add"
                : _webapiurl + "workpolicy/update/" + policyData.PolicyId;

            var httpMethod = policyData.PolicyId === 0 ? "POST" : "PUT";

            // Show loading
            $("#btnSubmit").prop('disabled', true).html('<i class="fa-thin fa-spinner fa-spin"></i> Saving...');

            // Make AJAX call to save policy
            $.ajax({
                url: apiUrl,
                type: httpMethod,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(policyData),
                headers: {
                    "Authorization": _tokan
                },
                success: function(response) {
                    if (response && response.success) {
                        toastr.success(response.message || "Configuration saved successfully.");
                        $("#frmWorkPolicyPopup").modal('hide');
                        clearForm();
                        loadWorkPolicies(); // Reload the table
                    } else {
                        toastr.error(response.Message || "Failed to save configuration.");
                    }
                    $("#btnSubmit").prop('disabled', false).html('<i class="fa-light fa-floppy-disk"></i> Save Configuration');
                },
                error: function(xhr, status, error) {
                    console.error("Error saving configuration:", error);
                    if (xhr.status === 401) {
                        toastr.error("Session expired. Please login again.");
                        window.location.href = "/PayTime/LoginPage";
                    } else {
                        toastr.error("An error occurred while saving the configuration.");
                    }
                    $("#btnSubmit").prop('disabled', false).html('<i class="fa-light fa-floppy-disk"></i> Save Configuration');
                }
            });
        });

