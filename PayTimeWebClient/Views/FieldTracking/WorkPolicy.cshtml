        if ("@_Message" != "") {
            toastr.remove();
            toastr.success("@_Message");
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
        }

        // Create Configuration button click - Updated for MVP
        $("#btnCreateWorkPolicy").on('click', function () {
            count++;
            operation = "Add Form";
            clearForm();
            $("#step-3").show(); // Just show the form directly
            $("#btnCreateWorkPolicy").attr("data-toggle", "modal");
            $("#btnCreateWorkPolicy").attr("data-target", "#frmWorkPolicyPopup");
        });

        // Step navigation and Next/Prev buttons - Commented out for MVP
        /*$("#s1").on("click", function (event) {
            if (!$(this).hasClass('disabled')) {
                showStep1();
            }
        });

        $("#s2").on("click", function (event) {
            if (!$(this).hasClass('disabled')) {
