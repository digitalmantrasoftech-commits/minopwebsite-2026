        var _webapiurl = '@_webapifieldtrackingurl';
        var _tokan = '@_tokan';
        var _UserId = '@_UserId';
        var _CompanyId = '@_cmpid';
        var _BranchId = '@_branchid';
    $(document).ready(function () {


        // Function to load all work policies

        // Load policies on page load

        loadWorkPolicies();

