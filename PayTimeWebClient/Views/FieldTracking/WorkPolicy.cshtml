            if (!$(this).hasClass('disabled')) {
                if (validateStep1() && validateStep2()) {
                    showStep3();
                }
            }
        });

        // Next/Previous button handlers
        $("#btnNext1").click(function () {
            if (validateStep1()) {
                showStep2();
            }
        });

        $("#btnNext2").click(function () {
            if (validateStep2()) {
