    // Validation functions - Updated for MVP (single form validation)
    function validateForm() {
        var isValid = true;

        // Validate Policy Name
        if ($("#ConfigurationName").val().trim() == "") {
            $("#ConfigurationName").addClass('field_error');
            toastr.error("Please enter Policy Name");
            isValid = false;
        } else {
            $("#ConfigurationName").removeClass('field_error');
        }

        // Validate Default Radius
        var radius = parseInt($("#DefaultRadius").val());
        if (isNaN(radius) || radius < 50 || radius > 1000) {
            $("#DefaultRadius").addClass('field_error');
            toastr.error("Please enter a valid radius between 50 and 1000 meters");
            isValid = false;
        } else {
            $("#DefaultRadius").removeClass('field_error');
        }

        return isValid;
    }

