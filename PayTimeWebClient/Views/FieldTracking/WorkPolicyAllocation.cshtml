<script type="text/javascript">
        var form = "Work Policy Allocation";
        var operation = "";
        var count = 0;
        var _webapiurl = '@_webapiurl';
        var _webapifieldtrackingurl = '@_webapifieldtrackingurl';
        var _tokan = '@_tokan';
        var _UserId = '@_UserId';
        var _CompanyId = '@_cmpid';
        var _BranchId = '@_branchid';
        var _RoleId = '@_RoleId';

        // Global variables for filter values
        var comidlst = 0;
        var branchidlst = 0;
        var deptidlst = 0;
        var desigidlst = 0;
        var roleidlst = 0;
        var empidlst = 0;

        // Global variables for edit functionality
        var workPoliciesCache = [];
        var currentEditingRow = null;

   
    $(document).ready(function () {



        // Work Policy change handler
        $("#WorkPolicyId").change(function () {
            var selectedOption = $(this).find('option:selected');
            if (selectedOption.val() !== '') {
                var radius = selectedOption.data('radius');
                var frequency = selectedOption.data('frequency');
                var taskCreation = selectedOption.data('task-creation');

                var infoText = 'Default Radius: ' + radius + 'm, Location Update: Every ' + frequency + ' min, Task Creation: ' + (taskCreation ? 'Allowed' : 'Not Allowed');
                $("#workPolicyInfo").text(infoText).show();
                $("#spvalidation").hide();
            } else {
                $("#workPolicyInfo").hide();
            }
        });

        // Company change handler
        $("#companyID").change(function () {
            var selectedCompanyId = $(this).val();
            clearDependentDropdowns();
            if (selectedCompanyId && selectedCompanyId !== '') {
                comidlst = selectedCompanyId;
                loadBranches(comidlst);
            } else {
                comidlst = 0;           
            }
        });

        // Branch change handler
        $(document).on('change', '#BranchId', function () {
            branchidlst = getMultiselectValues('BranchId');
            $("#txt2").val(branchidlst);
            updateCascadingDropdowns();
        });

        // Department change handler
        $(document).on('change', '#DepartmentID', function () {
            deptidlst = getMultiselectValues('DepartmentID');
            $("#txt3").val(deptidlst);

            // Reload field employees with updated filters
            var companyId = $("#companyID").val();
            var branchIds = getMultiselectValues('BranchId');
            var designationIds = getMultiselectValues('DesignationId');
            var roleIds = getMultiselectValues('RoleId');

            loadFieldEmployees(companyId, branchIds, deptidlst, designationIds, roleIds);
        });

        // Designation change handler
        $(document).on('change', '#DesignationId', function () {
            desigidlst = getMultiselectValues('DesignationId');
            $("#txt4").val(desigidlst);

            // Reload field employees with updated filters
            var companyId = $("#companyID").val();
            var branchIds = getMultiselectValues('BranchId');
            var departmentIds = getMultiselectValues('DepartmentID');
            var roleIds = getMultiselectValues('RoleId');

            loadFieldEmployees(companyId, branchIds, departmentIds, desigidlst, roleIds);
        });

        // Role change handler
        $(document).on('change', '#RoleId', function () {
            roleidlst = getMultiselectValues('RoleId');
            $("#txt5").val(roleidlst);

            // Reload field employees with updated filters
            var companyId = $("#companyID").val();
            var branchIds = getMultiselectValues('BranchId');
            var departmentIds = getMultiselectValues('DepartmentID');
            var designationIds = getMultiselectValues('DesignationId');

            loadFieldEmployees(companyId, branchIds, departmentIds, designationIds, roleidlst);
        });

        // Field Employee change handler
        $(document).on('change', '#FieldEmpId', function () {
            empidlst = getMultiselectValues('FieldEmpId');
            $("#txt6").val(empidlst);
        });



        // Clear all filters
        $("#BtnClear").click(function () {
            $("#WorkPolicyId").val('').trigger('change');
            $("#workPolicyInfo").hide();

            // Clear company dropdown
            $("#companyID").val('').trigger('change');

            clearDependentDropdowns();

            // Reset hidden values
            $("#txt2, #txt3, #txt4, #txt5, #txt6").val(0);
            comidlst = branchidlst = deptidlst = desigidlst = roleidlst = empidlst = 0;

            $("#spvalidation").hide();
            toastr.success("Filters cleared successfully");
        });

        // View allocations
        $("#BtnView").click(function () {
            count++;
            operation = "View Allocations";

            var workPolicyId = $('#WorkPolicyId').val();
            var companyId = $("#companyID").val();
            var branchIds = getMultiselectValues('BranchId');
            var departmentIds = getMultiselectValues('DepartmentID');
            var designationIds = getMultiselectValues('DesignationId');
            var roleIds = getMultiselectValues('RoleId');

            if ((!companyId || companyId === '') && '@_RoleId' != 1) {
                toastr.error("Please select a company.");
                return false;
            }

            // Show table wrapper
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            // Load actual data via AJAX with filters
            var filters = {
                companyId: companyId,
                branchIds: branchIds,
                departmentIds: departmentIds,
                designationIds: designationIds,
                roleIds: roleIds
            };

            // Add work policy filter if selected
            if (workPolicyId && workPolicyId !== '') {
                filters.workPolicyId = workPolicyId;
            }

            loadWorkPolicyAllocations(filters);
        });

        // Apply work policy
        $("#BtnApply").click(function () {
            count++;
            operation = "Apply Work Policy";

            var workPolicyId = $('#WorkPolicyId').val();
            var companyId = $("#companyID").val();
            var branchIds = getMultiselectValues('BranchId');
            var departmentIds = getMultiselectValues('DepartmentID');
            var designationIds = getMultiselectValues('DesignationId');
            var roleIds = getMultiselectValues('RoleId');
            var employeeIds = getMultiselectValues('FieldEmpId');

            // Validation
            if (!workPolicyId) {
                toastr.error("Please select a work policy.");
                return false;
            }

            if (!companyId || companyId === '') {
                toastr.error("Please select a company.");
                return false;
            }

            if (employeeIds === '0' || employeeIds === '') {
                toastr.error("Please select at least one field employee.");
                return false;
            }

            // Prepare data for API
            var allocationData = {
                workPolicyId: parseInt(workPolicyId),
                companyId: parseInt(companyId),
                employeeIds: employeeIds, // Comma-separated string
                createdBy: parseInt(_UserId)
            };


            // Apply work policy via AJAX
            $.ajax({
                url: _webapifieldtrackingurl + "workpolicy/allocate",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(allocationData),
                headers: {
                    "Authorization": _tokan
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (response) {
                    $(".loading").hide();
                    if (response && response.success) {
                        // Show success message with allocation details
                        var successMsg = response.message || "Work policy allocated successfully";
                        if (response.data) {
                            if (response.data.successfulAllocations > 0) {
                                successMsg += " (" + response.data.successfulAllocations + " of " + response.data.totalEmployees + " employees)";
                            }
                        }
                        toastr.success(successMsg);

                        // Show error details if there were any failures
                        if (response.data && response.data.errors && response.data.errors.length > 0) {
                            var errorMsg = "Failed allocations:\n";
                            $.each(response.data.errors, function (index, err) {
                                errorMsg += err.employeeName + ": " + err.reason + "\n";
                            });
                            toastr.warning(errorMsg);
                        }

                        // Clear the form selections
                        $("#FieldEmpId").multiselect('deselectAll', false).multiselect('updateButtonText');
                        $("#txt6").val(0);
                        empidlst = 0;

                        // Refresh the allocations table
                        loadWorkPolicyAllocations();

                        // Show the table view
                        const wrapper = $(".filter_portlet_wrapper");
                        wrapper.addClass("full-width");
                        wrapper.addClass("full-width");
                    } else {
                        toastr.error(response.message || "Failed to allocate work policy");
                    }
                },
                error: function (xhr, status, error) {
                    $(".loading").hide();
                    if (xhr.status === 401) {
                        toastr.error("Session expired. Please login again.");
                        setTimeout(function () {
                            window.location.href = "/PayTime/LoginPage";
                        }, 2000);
                    } else if (xhr.status === 400) {
                        var errorResponse = xhr.responseJSON;
                        toastr.error(errorResponse && errorResponse.message ? errorResponse.message : "Invalid request. Please check your inputs.");
                    } else if (xhr.status === 422) {
                        var errorResponse = xhr.responseJSON;
                        toastr.error(errorResponse && errorResponse.message ? errorResponse.message : "Validation failed. Please check the selected employees.");
                    } else {
                        toastr.error("Failed to allocate work policy. Please try again.");
                    }
                }
            });
        });

        // Bulk Remove work policy
        $("#BtnRemove").click(function () {
            count++;
            operation = "Remove Work Policy";

            var companyId = $("#companyID").val();
            var employeeIds = getMultiselectValues('FieldEmpId');

            // Validation
            if (!companyId || companyId === '') {
                toastr.error("Please select a company.");
                return false;
            }

            if (employeeIds === '0' || employeeIds === '') {
                toastr.error("Please select at least one field employee to remove allocation.");
                return false;
            }

            // Count selected employees
            var empCount = employeeIds.split(',').length;

            // Show confirmation dialog
            Swal.fire({
                html: '<div class="swal_subtitle"><b>Are you sure you want to remove work policy allocation from ' + empCount + ' employee(s)?</b><p>This will also remove their field employee status.</p></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Remove Work Policy",
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No, cancel',
                confirmButtonText: 'Yes, remove it!',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Prepare data for API
                    var removalData = {
                        employeeIds: employeeIds, // Comma-separated string
                        modifiedBy: parseInt(_UserId)
                    };

                    // Remove work policy via AJAX
                    $.ajax({
                        url: _webapifieldtrackingurl + "workpolicy/deallocate",
                        type: "POST",
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        data: JSON.stringify(removalData),
                        headers: {
                            "Authorization": _tokan
                        },
                        beforeSend: function () {
                            $(".loading").show();
                        },
                        success: function (response) {
                            $(".loading").hide();
                            if (response && response.success) {
                                // Show success message
                                var successMsg = response.message || "Work policy removed successfully";
                                if (response.data) {
                                    if (response.data.successfulRemovals > 0) {
                                        successMsg += " (" + response.data.successfulRemovals + " of " + response.data.totalEmployees + " employees)";
                                    }
                                }
                                Swal.fire({
                                    html: '<div class="swal_subtitle"><b>' + successMsg + '</b></div>',
                                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Removed!",
                                    showCloseButton: true,
                                    showCancelButton: false,
                                    confirmButtonText: 'OK',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: {
                                        confirmButton: 'swal-confirm-button-class'
                                    }
                                });
                                $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');

                                // Show error details if there were any failures
                                if (response.data && response.data.errors && response.data.errors.length > 0) {
                                    var errorMsg = "Failed removals:\n";
                                    $.each(response.data.errors, function (index, err) {
                                        errorMsg += err.employeeName + ": " + err.reason + "\n";
                                    });
                                    toastr.warning(errorMsg);
                                }

                                // Clear the form selections
                                $("#FieldEmpId").multiselect('deselectAll', false).multiselect('updateButtonText');
                                $("#txt6").val(0);
                                empidlst = 0;

                                // Refresh the allocations table
                                loadWorkPolicyAllocations();

                                // Show the table view
                                const wrapper = $(".filter_portlet_wrapper");
                                wrapper.addClass("full-width");
                            } else {
                                Swal.fire({
                                    html: '<div class="swal_subtitle"><b>' + (response.message || "Failed to remove work policy") + '</b></div>',
                                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error",
                                    showCloseButton: true,
                                    confirmButtonText: 'OK',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: {
                                        confirmButton: 'swal-confirm-button-class'
                                    }
                                });
                                $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                            }
                        },
                        error: function (xhr, status, error) {
                            $(".loading").hide();
                            if (xhr.status === 401) {
                                Swal.fire({
                                    html: '<div class="swal_subtitle"><b>Please login again.</b></div>',
                                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Session Expired",
                                    showCloseButton: true,
                                    confirmButtonText: 'OK',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: {
                                        confirmButton: 'swal-confirm-button-class'
                                    }
                                });
                                $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                                setTimeout(function () {
                                    window.location.href = "/PayTime/LoginPage";
                                }, 2000);
                            } else if (xhr.status === 400) {
                                var errorResponse = xhr.responseJSON;
                                Swal.fire({
                                    html: '<div class="swal_subtitle"><b>' + (errorResponse && errorResponse.message ? errorResponse.message : "Invalid request. Please check your inputs.") + '</b></div>',
                                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error",
                                    showCloseButton: true,
                                    confirmButtonText: 'OK',
                                    allowOutsideClick: false,
