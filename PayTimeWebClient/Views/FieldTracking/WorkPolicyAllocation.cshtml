                                        <!-- Data will be loaded dynamically via AJAX -->
                                    </tbody>
                                </table>
                            </div>

                            <div id="NotificationGrid-empty" style="display:none;">
                                <div class="datanotfound">
                                    <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="Nodata Found Icon">
                                    <p class="datanotfound_title">No work policy allocations found</p>
                                    <p class="">No matching records found for the selected filters. Please adjust your filters or assign work policies to field employees.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Data Table Block : End -->
        <!-- Filter Block : Begin -->
        <div class="portlet filter_boxModal">
            <div class="filterbox_header">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="filter-title">Work Policy Assignment</h4>
                    <button type="button" class="filterclose_btn"><i class="fa-light fa-xmark"></i></button>
                </div>
            </div>
            <div class="filterbox_body">
                <form id="frmWorkPolicyAllocation">
                    <div class="col-lg-12">
                        <div class="alert alert-danger popMsg" hidden>
                            <a href="#" class="close" data-dismiss="alert">&times;</a>
                            <strong id="strstg"></strong>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                    </div>

                    <!-- Work Policy Selection -->
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label class="control-label">Work Policy<span class="required" aria-required="true"> * </span></label>
                            <select id="WorkPolicyId" class="form-control select2">
                                <option value="">Select Work Policy</option>
                            </select>
                            <div id="workPolicyInfo" class="work-policy-config" style="display:none;">
                                <i class="fa-regular fa-info-circle"></i> Policy details will be displayed here
