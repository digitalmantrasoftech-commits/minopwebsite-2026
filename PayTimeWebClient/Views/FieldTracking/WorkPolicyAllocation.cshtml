    @if (obj.CanView)
    {
        <div class="page-toolbar">
            <a href="javascript:;" class="btn icon_transparent_btn tooltips" id="Filter_search" data-original-title="Assign work policy to field employees" data-placement="bottom"><i class="fa-regular fa-user-gear" aria-hidden="true"></i></a>
        </div>
    }
</div>

@if (obj.CanView)
{
    <div class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>

    <div class="filter_portlet_wrapper full-width">
        <!-- Data Table Block : Begin -->
        <div class="portlet filter_portlet_tbl">
            <div class="portlet-body">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <!-- Loading indicator -->
                        <div id="workPolicyAllocationLoading" style="text-align: center; padding: 40px;">
                            <i class="fa-thin fa-spinner fa-spin fa-3x"></i>
                            <p>Loading work policy allocations...</p>
                        </div>

                        <div id="tblempty">
                            <div class="table-responsive" id="tableResponsive" style="display:none;">
                                <table id="tblWorkPolicyAllocation" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column">
                                    <thead>
                                        <!--<tr>
                                            <th style="display:none;">Sr. No</th>
                                            <th>Employee Name</th>
                                            <th>Employee Code</th>
                                            <th>Work Policy</th>-->
                                            @*<th>Company</th>*@
                                            <!--<th>Branch</th>
                                            <th>Department</th>-->
                                            @*<th>Designation</th>*@
                                        <!--</tr>-->
                                    </thead>
