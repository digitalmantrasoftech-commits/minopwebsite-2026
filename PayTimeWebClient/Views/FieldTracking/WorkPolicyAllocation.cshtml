        // Load work policy allocations
    function loadWorkPolicyAllocations(filters) {
        $('#workPolicyAllocationLoading').show();
        $('#tableResponsive').hide();
        $('#NotificationGrid-empty').hide();

        // Prepare filter data
        var requestData = {};

        if (filters) {
            if (filters.companyId) requestData.companyId = parseInt(filters.companyId);
            if (filters.branchIds && filters.branchIds !== '0') requestData.branchIds = filters.branchIds;
            if (filters.departmentIds && filters.departmentIds !== '0') requestData.departmentIds = filters.departmentIds;
            if (filters.designationIds && filters.designationIds !== '0') requestData.designationIds = filters.designationIds;
            if (filters.roleIds && filters.roleIds !== '0') requestData.roleIds = filters.roleIds;
            if (filters.workPolicyId) requestData.workPolicyId = parseInt(filters.workPolicyId);
        } else {
            // Load all allocations without filters
            //var companyId = $("#companyID").val();
            //if (companyId) requestData.companyId = parseInt(companyId);
        }

        $.ajax({
            url: _webapifieldtrackingurl + "workpolicy/allocations",
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(requestData),
            headers: {
                "Authorization": _tokan
            },
            beforeSend: function () {
                $('#workPolicyAllocationLoading').show();
            },
            success: function (response) {
                if (response && response.success && response.data && response.data.length > 0) {
                    $('#tableResponsive').show();
                    $('#NotificationGrid-empty').hide();

                    // Destroy existing DataTable if it exists
                    if ($.fn.DataTable.isDataTable('#tblWorkPolicyAllocation')) {
                        $('#tblWorkPolicyAllocation').DataTable().destroy();
                    }
                    $("#dataTables_tbl_header").remove();
                    // Initialize DataTable with data (similar to Room.cshtml pattern)
                    $('#tblWorkPolicyAllocation').DataTable({
                        dom: _domCommon || 'Bfrtip',
                        language: _languageCommon || {
                            search: "_INPUT_",
                            searchPlaceholder: "Search..."
                        },
                        deferRender: true,
                        data: response.data,
                        order: [],
                        destroy: true,
                        columns: [
                            {
                                title: "Sr No",
                                data: null,
                                visible: false,
                                render: function (data, type, row, meta) {
                                    return meta.row + 1;
                                }
                            },
                            { title: "empId", data: "empId", visible: false },
                            { title: "Employee Name", data: "empName" },
                            { title: "Employee Code", data: "empCode" },
                            { title: "workPolicyId", data: "workPolicyId", visible: false },
                            {
                                title: "Work Policy",
                                data: "workPolicyName",
                                render: function (data, type, row, meta) {
                                    // Add custom ID to cell for inline editing
                                    return '<span class="work-policy-cell" id="workPolicyCell_' + row.empId + '" data-emp-id="' + row.empId + '" data-policy-id="' + row.workPolicyId + '" data-policy-name="' + data + '">' + data + '</span>';
                                }
                            },
                            /*{ title: "Company", data: "companyName" },*/
                            { title: "branchId", data: "branchId", visible:false },
                            { title: "Branch", data: "branchName" },
                            { title: "departmentId", data: "departmentId", visible: false },
                            { title: "Department", data: "departmentName" },
                            { title: "is FieldEmployee", data: "isFieldEmployee", visible: false },
                            { title: "is Active", data: "isActive", visible:false },
                            /* { title: "Designation", data: "designationName" }*/
                            {
                                title: "Action",
                                data: null,
                                orderable: false,
                                searchable: false,
                                render: function (data, type, row) {
                                    var editBtn = "<a class='editclass btn blue_btnnew tooltips' data-placement='top' " +
                                        "onclick=\"editWorkPolicy('" + row.empId + "', '" + row.workPolicyId + "', '" + row.workPolicyName.replace(/'/g, "\\'") + "')\" " +
                                        "data-original-title='Edit work policy'>" +
                                        "<i class='fa-regular fa-pen-to-square'></i></a> ";

                                    var deleteBtn = "<a class='deleteclass btn blue_btnnew tooltips' data-placement='top' " +
                                        "onclick=\"removeSingleAllocation('" + row.empId + "','" +
                                        row.empName.replace(/'/g, "\\'") + "')\" " +
                                        "data-original-title='Remove work policy'>" +
                                        "<i class='fa-solid fa-xmark'></i></a>";

                                    return editBtn + deleteBtn;
                                }
                            }
                        ],
                        "preDrawCallback": function (settings) {
                            $('#workPolicyAllocationLoading').hide();
                        },
                        initComplete: function () {
                            const visibleTable = 'tblWorkPolicyAllocation';

                            // Safety check: only append if buttons container exists and is empty
                            if ($('#buttons').length && $('#buttons').children().length === 0 && visibleTable) {
                                $("#buttons").append(`
                                    <div id="export-button1" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                                        <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                                    </div>
                                `);
                            }
                        },
                        drawCallback: function () {
                            $('.tooltips').tooltip();
                        }
                    });
                    setTimeout(function () {
                        $("#" + "tblWorkPolicyAllocation" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                        $('.tooltips').tooltip();
                    }, 100);
                } else {
                    $('#workPolicyAllocationLoading').hide();
                    $('#tableResponsive').hide();
                    $('#NotificationGrid-empty').show();

                    // Update empty state message based on whether filters were applied
                    if (filters && Object.keys(filters).length > 0) {
                        $('#NotificationGrid-empty .datanotfound_title').text('No work policy allocations found');
                        $('#NotificationGrid-empty p:last').text('No matching records found for the selected filters. Please adjust your filters or assign work policies to field employees.');
                    } else {
                        $('#NotificationGrid-empty .datanotfound_title').text('No work policy allocations yet');
                        $('#NotificationGrid-empty p:last').text('No field employees have been assigned work policies. Use the filter panel to assign policies to field employees.');
                    }
                }
            },
            error: function (xhr, status, error) {
                $('#workPolicyAllocationLoading').hide();
                $('#tableResponsive').hide();
                $('#NotificationGrid-empty').show();

                console.error("Error loading work policy allocations:", error);

                if (xhr.status === 401) {
                    toastr.error("Session expired. Please login again.");
                    setTimeout(function () {
                        window.location.href = "/PayTime/LoginPage";
                    }, 2000);
                } else if (xhr.status === 403) {
                    toastr.error("You don't have permission to view work policy allocations.");
                    $('#NotificationGrid-empty .datanotfound_title').text('Access Denied');
                    $('#NotificationGrid-empty p:last').text('You do not have permission to view work policy allocations.');
                } else {
                    toastr.error("Failed to load work policy allocations");
                }
            }
        });
    }

