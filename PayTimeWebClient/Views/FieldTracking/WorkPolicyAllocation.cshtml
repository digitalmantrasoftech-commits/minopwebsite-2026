    }

        // Helper function to get multiselect values as comma-separated string
    function getMultiselectValues(elementId) {
        var selected = $('#' + elementId + ' option:selected');
        var values = [];
        selected.each(function () {
            values.push($(this).val());
        });
        return values.length > 0 ? values.join(',') : '0';
    }

        // Update cascading dropdowns and load data
    function updateCascadingDropdowns() {
        var companyId = $("#companyID").val();
        var branchIds = getMultiselectValues('BranchId');

        if (companyId) {
            if (branchIds === '0' || branchIds === '') {
                $("#DepartmentID").empty().multiselect('rebuild').multiselect('disable');
                $("#DesignationId").empty().multiselect('rebuild').multiselect('disable');
                $("#RoleId").empty().multiselect('rebuild').multiselect('disable');
                $("#FieldEmpId").empty().multiselect('rebuild').multiselect('disable');
            }
            else {
                // Load departments, designations, and roles based on company and branches
                loadDepartments(companyId, branchIds);
                loadDesignations(companyId, branchIds);
                loadRoles(companyId, branchIds);

                // Load field employees with all filters
                var departmentIds = getMultiselectValues('DepartmentID');
                var designationIds = getMultiselectValues('DesignationId');
                var roleIds = getMultiselectValues('RoleId');

                loadFieldEmployees(companyId, branchIds, departmentIds, designationIds, roleIds);
            }
        }
    }

        // Enable dependent dropdowns
    function enableDependentDropdowns() {
        $("#DepartmentID").multiselect('enable');
        $("#DesignationId").multiselect('enable');
        $("#RoleId").multiselect('enable');
        $("#FieldEmpId").multiselect('enable');

        // Load initial data for these dropdowns
        var companyId = $("#companyID").val();
        if (companyId) {
            loadDepartments(companyId, '0');
            loadDesignations(companyId, '0');
            loadRoles(companyId, '0');
        }
    }

        // Clear dependent dropdowns
    function clearDependentDropdowns() {
        $("#BranchId").empty().multiselect('rebuild').multiselect('disable');
        $("#DepartmentID").empty().multiselect('rebuild').multiselect('disable');
        $("#DesignationId").empty().multiselect('rebuild').multiselect('disable');
        $("#RoleId").empty().multiselect('rebuild').multiselect('disable');
        $("#FieldEmpId").empty().multiselect('rebuild').multiselect('disable');
    }

    // Cancel work policy edit - Revert cell to original state
    function cancelWorkPolicyEdit(empId, originalPolicyName) {
        // Get the cell element
        var cellElement = $('#workPolicyCell_' + empId);
        if (cellElement.length === 0) {
            console.error("Unable to find cell to revert.");
            return;
        }

        // Revert cell content to original text
        cellElement.html(originalPolicyName);

        // Reset editing state
        currentEditingRow = null;
    }

    // Save work policy edit - API call to update allocation
    // NOTE FOR BACKEND TEAM: This function expects the following API endpoint:
    // PUT /api/workpolicy/update-allocation
    // Request body: { empId: number, workPolicyId: number, modifiedBy: number }
    // Response format: { success: true, message: "...", data: { empId, workPolicyId, workPolicyName } }
    // Database updates required:
    //   - Update tblemployeemaster.WorkPolicyId with new policy ID
    //   - Update tblemployeemaster.ModifyBy and ModifyDate
    function saveWorkPolicyEdit(empId, newPolicyId, newPolicyName, originalPolicyName) {
        // Prepare data for API
        var updateData = {
            empId: parseInt(empId),
            workPolicyId: parseInt(newPolicyId)
        };

        // Make API call to update allocation
        $.ajax({
            url: _webapifieldtrackingurl + "workpolicy/update-allocation",
            type: "PUT",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(updateData),
            headers: {
                "Authorization": _tokan
            },
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                $(".loading").hide();
                if (response && response.success) {
                    // Show success message
                    var successMsg = response.message || "Work policy updated successfully to " + newPolicyName;
                    toastr.success(successMsg);

                    // Reset editing state
                    currentEditingRow = null;

                    // Refresh the allocations table to show updated data
                    loadWorkPolicyAllocations();
                } else {
                    toastr.error(response.message || "Failed to update work policy");
                    // Revert to original value
                    cancelWorkPolicyEdit(empId, originalPolicyName);
                }
            },
            error: function (xhr, status, error) {
                $(".loading").hide();

                // Handle different error scenarios
                if (xhr.status === 401) {
                    toastr.error("Session expired. Please login again.");
                    setTimeout(function () {
                        window.location.href = "/PayTime/LoginPage";
                    }, 2000);
                } else if (xhr.status === 400) {
                    var errorResponse = xhr.responseJSON;
                    toastr.error(errorResponse && errorResponse.message ? errorResponse.message : "Invalid request. Please check your inputs.");
                } else if (xhr.status === 422) {
                    var errorResponse = xhr.responseJSON;
                    toastr.error(errorResponse && errorResponse.message ? errorResponse.message : "Validation failed. Please check the selected work policy.");
                } else if (xhr.status === 403) {
                    toastr.error("You don't have permission to update work policy allocations.");
                } else if (xhr.status === 404) {
                    toastr.error("Employee or work policy not found.");
                } else {
                    toastr.error("Failed to update work policy. Please try again.");
                }

                // Revert to original value
                cancelWorkPolicyEdit(empId, originalPolicyName);
            }
        });
    }

    // Edit work policy function - Inline dropdown editing
    function editWorkPolicy(empId, currentPolicyId, currentPolicyName) {
        // Prevent multiple edits at once
        if (currentEditingRow !== null && currentEditingRow !== empId) {
            toastr.warning("Please complete or cancel the current edit first.");
            return;
        }

        // Check if work policies are loaded
        if (workPoliciesCache.length === 0) {
            toastr.error("Work policies not loaded. Please refresh the page.");
            return;
        }

        // Set current editing row
        currentEditingRow = empId;

        // Get the cell element
        var cellElement = $('#workPolicyCell_' + empId);
        if (cellElement.length === 0) {
            toastr.error("Unable to find cell to edit.");
            currentEditingRow = null;
            return;
        }

        // Build dropdown options
        var dropdownHtml = '<select class="form-control select2" id="editDropdown_' + empId + '" style="display:inline-block; width:auto; min-width:200px;">';
        $.each(workPoliciesCache, function (index, policy) {
            var selected = (policy.policyId == currentPolicyId) ? ' selected' : '';
            dropdownHtml += '<option value="' + policy.policyId + '"' + selected + '>' + policy.policyName + '</option>';
        });
        dropdownHtml += '</select> ';
        dropdownHtml += '<a href="javascript:void(0);" class="deleteclass btn blue_btnnew tooltips" onclick="cancelWorkPolicyEdit(\'' + empId + '\', \'' + currentPolicyName.replace(/'/g, "\\'") + '\')" data-placement="top" data-original-title="Cancel"><i class="fa-solid fa-xmark"></i></a>';

        // Replace cell content with dropdown
        cellElement.html(dropdownHtml);

        // Initialize tooltip
        $('.tooltips').tooltip();

        // Auto-focus dropdown
        $('#editDropdown_' + empId).focus();

        // Attach change event to save
        $('#editDropdown_' + empId).on('change', function () {
            var newPolicyId = $(this).val();
            var newPolicyName = $(this).find('option:selected').text();
            saveWorkPolicyEdit(empId, newPolicyId, newPolicyName, currentPolicyName);
        });
    }

    // Remove single allocation function
    // NOTE FOR BACKEND TEAM: This function expects the following API endpoint:
    // DELETE /api/workpolicy/deallocate/{empId}
    // Response format: { success: true, message: "...", data: {...} }
    // Database updates required:
    //   - Set tblemployeemaster.WorkPolicyId = NULL
    //   - Set tblemployeemaster.IsFieldEmployee = 0
    //   - Update tblemployeemaster.ModifyBy and ModifyDate
    function removeSingleAllocation(empId, empName) {
        // Show confirmation dialog
        Swal.fire({
            html: '<div class="swal_subtitle"><b>Are you sure you want to remove work policy allocation for ' + empName + '?</b><p>This will also remove their field employee status.</p></div>',
            title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Remove Work Policy",
            showCloseButton: true,
            showCancelButton: true,
            focusConfirm: false,
            cancelButtonText: 'No, cancel',
            confirmButtonText: 'Yes, remove it!',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                // Remove work policy via AJAX
                $.ajax({
                    url: _webapifieldtrackingurl + "workpolicy/deallocate/" + empId,
                    type: "DELETE",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    headers: {
                        "Authorization": _tokan
                    },
                    beforeSend: function () {
                        $(".loading").show();
                    },
                    success: function (response) {
                        $(".loading").hide();
                        if (response && response.success) {
                            Swal.fire({
                                html: '<div class="swal_subtitle"><b>' + (response.message || "Work policy removed successfully for " + empName) + '</b></div>',
                                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Removed!",
                                showCloseButton: true,
                                confirmButtonText: 'OK',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                customClass: {
                                    confirmButton: 'swal-confirm-button-class'
                                }
                            });
                            $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');

                            // Refresh the allocations table
                            loadWorkPolicyAllocations();
                        } else {
                            Swal.fire({
                                html: '<div class="swal_subtitle"><b>' + (response.message || "Failed to remove work policy") + '</b></div>',
                                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error",
                                showCloseButton: true,
                                confirmButtonText: 'OK',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                customClass: {
                                    confirmButton: 'swal-confirm-button-class'
                                }
                            });
                            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                        }
                    },
                    error: function (xhr, status, error) {
                        $(".loading").hide();
                        if (xhr.status === 401) {
                            Swal.fire({
                                html: '<div class="swal_subtitle"><b>Please login again.</b></div>',
                                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Session Expired",
                                showCloseButton: true,
                                confirmButtonText: 'OK',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                customClass: {
                                    confirmButton: 'swal-confirm-button-class'
                                }
                            });
                            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                            setTimeout(function () {
                                window.location.href = "/PayTime/LoginPage";
                            }, 2000);
                        } else if (xhr.status === 400) {
                            var errorResponse = xhr.responseJSON;
                            Swal.fire({
                                html: '<div class="swal_subtitle"><b>' + (errorResponse && errorResponse.message ? errorResponse.message : "Invalid request.") + '</b></div>',
                                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error",
                                showCloseButton: true,
                                confirmButtonText: 'OK',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                customClass: {
                                    confirmButton: 'swal-confirm-button-class'
                                }
                            });
                            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                        } else if (xhr.status === 404) {
                            Swal.fire({
                                html: '<div class="swal_subtitle"><b>Employee allocation not found or already removed.</b></div>',
                                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_warning.svg' alt=''>Not Found",
                                showCloseButton: true,
                                confirmButtonText: 'OK',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                customClass: {
                                    confirmButton: 'swal-confirm-button-class'
                                }
                            });
                            $('img[src="/assets/images/icons/swal_icon/icon_warning.svg"]').parent().parent().parent().addClass('swal_warning');
                            // Refresh table anyway
                            loadWorkPolicyAllocations();
                        } else if (xhr.status === 403) {
                            Swal.fire({
                                html: '<div class="swal_subtitle"><b>You don\'t have permission to remove work policy allocations.</b></div>',
                                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Access Denied",
                                showCloseButton: true,
                                confirmButtonText: 'OK',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                customClass: {
                                    confirmButton: 'swal-confirm-button-class'
                                }
                            });
                            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                        } else {
                            Swal.fire({
                                html: '<div class="swal_subtitle"><b>Failed to remove work policy. Please try again.</b></div>',
                                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error",
                                showCloseButton: true,
                                confirmButtonText: 'OK',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                customClass: {
                                    confirmButton: 'swal-confirm-button-class'
                                }
                            });
                            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                        }
                    }
                });
            }
        });
        $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
    }
</script>

<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>
