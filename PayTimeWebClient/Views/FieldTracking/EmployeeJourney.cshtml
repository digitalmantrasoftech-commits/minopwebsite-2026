    <script src="~/Scripts/FieldSense/Location/Models/LocationModels.js"></script>
    <script src="~/Scripts/FieldSense/Location/Utils/CoordinateValidator.js"></script>
    <script src="~/Scripts/FieldSense/Location/Utils/LocationUtils.js"></script>
    <script src="~/Scripts/FieldSense/Location/Providers/GoogleMapsLocationProvider.js"></script>
    <script src="~/Scripts/FieldSense/Location/Core/FieldSenseLocationService.js"></script>
}
else
