    // Setup location-related event handlers
    function setupLocationEventHandlers() {
        // Map picker button
        $('#btnPickLocation').on('click', function() {
            openLocationPicker();
        });

        // Address input with auto-suggestions
        $('#manualAddress').on('input', function() {
            clearTimeout(addressSearchTimeout);
            var query = $(this).val();

            if (query.length > 2) {
                addressSearchTimeout = setTimeout(function() {
                    searchAddressSuggestions(query);
                }, 500);
            } else {
                $('#addressSuggestions').hide();
            }
        });

        // Hide suggestions when clicking outside
        $(document).on('click', function(e) {
            if (!$(e.target).closest('#manualAddressContainer').length) {
                $('#addressSuggestions').hide();
            }
        });

        // Validate coordinates button
        $('#btnValidateCoordinates').on('click', function() {
            validateAndGeocodeCoordinates();
        });

        // View on map button
        $('#btnViewOnMap').on('click', function() {
            viewCoordinatesOnMap();
        });

        // Auto-validate coordinates on input
        $('#coordLatitude, #coordLongitude').on('input', function() {
            var lat = $('#coordLatitude').val();
            var lng = $('#coordLongitude').val();

            if (lat && lng && isValidCoordinate(lat, lng)) {
                $('#btnValidateCoordinates').removeClass('btn-default').addClass('btn-primary');
            } else {
                $('#btnValidateCoordinates').removeClass('btn-primary').addClass('btn-default');
                $('#resolvedAddress').val('');
            }
        });
    }

