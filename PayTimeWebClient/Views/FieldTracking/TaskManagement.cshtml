    // Check Out from task (with proof of work if required)
    function clockOutTask(taskId) {
        // Fetch task details and work policy to check proof requirements
        $.ajax({
            url: _webapifieldtrackingurl + 'taskmanagement/' + taskId,
            type: 'GET',
            headers: {
                'Authorization': 'Bearer ' + _tokan,
                'Content-Type': 'application/json'
            },
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            complete: function () {
                $('#ajax_loader').hide();
            },
            success: function(response) {
                if (response.success && response.data) {
                    var task = response.data;

                    // Set task details in modal
                    $('#clockOutTaskId').val(taskId);
                    $('#clockOutTaskTitle').text(task.taskTitle);

                    // Calculate duration
                    if (task.startTime) {
                        var startTime = parseUTCDate(task.startTime);
                        var now = new Date();
                        var durationMinutes = Math.floor((now - startTime) / 60000);
                        var hours = Math.floor(durationMinutes / 60);
                        var minutes = durationMinutes % 60;
                        $('#clockOutDuration').text(hours + 'h ' + minutes + 'm');
                        $('#clockOutStartTime').text(formatLocalDateTime(task.startTime));
                    } else {
                        $('#clockOutDuration').text('N/A');
                        $('#clockOutStartTime').text('N/A');
                    }

                    $('#clockOutExpectedDuration').text(task.expectedDurationDisplay || 'N/A');

                    // Fetch work policy to check proof of work requirement
                    $.ajax({
                        url: _webapifieldtrackingurl + 'workpolicy/employee/' + _EmpId,
                        type: 'GET',
                        headers: {
                            'Authorization': 'Bearer ' + _tokan,
                            'Content-Type': 'application/json'
                        },
                        success: function (policyResponse) {
                            console.log(policyResponse);
                            var proofRequired = 0; // Default: no proof required

                            if (policyResponse.success && policyResponse.data) {
                                proofRequired = policyResponse.data.proofOfWork || 0;
                            }

                            $('#clockOutProofRequired').val(proofRequired);

                            // Show/hide proof sections based on policy
                            if (proofRequired > 0) {
                                $('#clockOutProofSection').show();

                                // proofOfWork: 0=None, 1=Photo, 2=Signature, 3=Photo+Signature, 4=OTP
                                if (proofRequired === 1 || proofRequired === 3) {
                                    $('#photoProofSection').show();
                                } else {
                                    $('#photoProofSection').hide();
                                }

                                if (proofRequired === 2 || proofRequired === 3) {
                                    $('#signatureProofSection').show();
                                    initializeSignatureCanvas();
                                } else {
                                    $('#signatureProofSection').hide();
                                }
                            } else {
                                $('#clockOutProofSection').hide();
                            }

                            // Show modal
                            $('#clockOutModal').modal('show');
                        },
                        error: function() {
                            // If work policy fetch fails, default to no proof required
                            $('#clockOutProofRequired').val(0);
                            $('#clockOutProofSection').hide();
                            $('#clockOutModal').modal('show');
                        }
                    });
                } else {
                    toastr.error('Failed to load task details');
                }
            },
            error: function(xhr, status, error) {
                console.error('Error loading task:', error);
                toastr.error(xhr.responseJSON.message);
            }
        });
    }

    // Initialize signature canvas
    function initializeSignatureCanvas() {
        signatureCanvas = document.getElementById('signatureCanvas');
        if (signatureCanvas) {
            signatureContext = signatureCanvas.getContext('2d');
            signatureContext.strokeStyle = '#000';
            signatureContext.lineWidth = 2;

            // Only attach event listeners once to prevent duplicates
            if (signatureCanvasInitialized) {
                return;
            }
            signatureCanvasInitialized = true;

            var isDrawing = false;
            var lastX = 0;
            var lastY = 0;

            signatureCanvas.addEventListener('mousedown', function(e) {
                isDrawing = true;
                var rect = signatureCanvas.getBoundingClientRect();
                lastX = e.clientX - rect.left;
                lastY = e.clientY - rect.top;
            });

            signatureCanvas.addEventListener('mousemove', function(e) {
                if (isDrawing) {
                    var rect = signatureCanvas.getBoundingClientRect();
                    var x = e.clientX - rect.left;
                    var y = e.clientY - rect.top;
                    signatureContext.beginPath();
                    signatureContext.moveTo(lastX, lastY);
                    signatureContext.lineTo(x, y);
                    signatureContext.stroke();
                    lastX = x;
                    lastY = y;
                }
            });

            signatureCanvas.addEventListener('mouseup', function() {
                isDrawing = false;
            });

            signatureCanvas.addEventListener('mouseleave', function() {
                isDrawing = false;
            });

            // Touch support for mobile
            signatureCanvas.addEventListener('touchstart', function(e) {
                e.preventDefault();
                isDrawing = true;
                var rect = signatureCanvas.getBoundingClientRect();
                var touch = e.touches[0];
                lastX = touch.clientX - rect.left;
                lastY = touch.clientY - rect.top;
            });

            signatureCanvas.addEventListener('touchmove', function(e) {
                e.preventDefault();
                if (isDrawing) {
                    var rect = signatureCanvas.getBoundingClientRect();
                    var touch = e.touches[0];
                    var x = touch.clientX - rect.left;
                    var y = touch.clientY - rect.top;
                    signatureContext.beginPath();
                    signatureContext.moveTo(lastX, lastY);
                    signatureContext.lineTo(x, y);
                    signatureContext.stroke();
                    lastX = x;
                    lastY = y;
                }
            });

            signatureCanvas.addEventListener('touchend', function() {
                isDrawing = false;
            });
        }
    }

    // Clear signature canvas
    function clearSignature() {
        if (signatureCanvas && signatureContext) {
            signatureContext.clearRect(0, 0, signatureCanvas.width, signatureCanvas.height);
        }
    }

    // Reset clock out modal - Clear all form fields
    function resetClockOutModal() {
        // Clear hidden inputs
        $('#clockOutTaskId').val('');
        $('#clockOutProofRequired').val('');

        // Clear display fields
        $('#clockOutTaskTitle').text('');
        $('#clockOutStartTime').text('');
        $('#clockOutDuration').text('');
        $('#clockOutExpectedDuration').text('');

        // Clear file input and preview
        $('#proofPhotos').val('');
        $('#photoPreview').empty();

        // Clear signature canvas
        clearSignature();

        // Clear notes textarea
        $('#clockOutNotes').val('');

        // Hide proof sections
        $('#photoProofSection').hide();
        $('#signatureProofSection').hide();
        $('#clockOutProofSection').hide();
    }

    // Confirm check out
    function confirmClockOut() {
        var taskId = parseInt($('#clockOutTaskId').val());
        var proofRequired = parseInt($('#clockOutProofRequired').val());
        var notes = $('#clockOutNotes').val();

        // Validate proof if required
        if (proofRequired > 0) {
            if ((proofRequired === 1 || proofRequired === 3) && $('#proofPhotos')[0].files.length === 0) {
                toastr.error('Please upload at least one photo as proof of work');
                return;
            }

            if ((proofRequired === 2 || proofRequired === 3) && isSignatureEmpty()) {
                toastr.error('Please provide customer signature');
                return;
            }
        }

        // Get current location for check out
        getCurrentLocation(
            function(location) {
                // Reverse geocode
                var checkOutAddress = 'Lat: ' + location.lat.toFixed(6) + ', Lng: ' + location.lng.toFixed(6);

                if (typeof FieldSenseLocationService !== 'undefined') {
                    FieldSenseLocationService.reverseGeocode(location.lat, location.lng, function(result) {
                        if (result && !result.error) {
                            performClockOut(taskId, location, result.formatted_address || result.address || checkOutAddress, notes, proofRequired);
                        } else {
                            performClockOut(taskId, location, checkOutAddress, notes, proofRequired);
                        }
                    });
                } else {
                    performClockOut(taskId, location, checkOutAddress, notes, proofRequired);
                }
            },
            function(error) {
                toastr.error('Unable to get your location for check out');
            }
        );
    }

    // Check if signature canvas is empty
    function isSignatureEmpty() {
        if (!signatureCanvas || !signatureContext) return true;
        var pixelBuffer = new Uint32Array(
            signatureContext.getImageData(0, 0, signatureCanvas.width, signatureCanvas.height).data.buffer
        );
        return !pixelBuffer.some(color => color !== 0);
    }

    // Upload photos to server
    function uploadPhotos(taskId) {
        return new Promise(function(resolve, reject) {
            var fileInput = document.getElementById('proofPhotos');
            var files = fileInput.files;

            if (!files || files.length === 0) {
                resolve([]);
                return;
            }

            var formData = new FormData();
            formData.append('taskId', taskId);

            for (var i = 0; i < files.length; i++) {
                formData.append('file' + i, files[i]);
            }

            $.ajax({
                url: '@Url.Action("UploadTaskPhotos", "FieldTracking")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        resolve(response.filenames);
                    } else {
                        toastr.error(response.message || 'Failed to upload photos');
                        reject(new Error(response.message || 'Failed to upload photos'));
                    }
                },
                error: function(xhr, status, error) {
                    toastr.error('Error uploading photos');
                    reject(error);
                }
            });
        });
    }

    // Upload signature to server
    function uploadSignature(taskId) {
        return new Promise(function(resolve, reject) {
            if (!signatureCanvas) {
                resolve('');
                return;
            }

            signatureCanvas.toBlob(function(blob) {
                if (!blob) {
                    reject(new Error('Failed to convert signature to blob'));
                    return;
                }

                var formData = new FormData();
                formData.append('taskId', taskId);
                formData.append('file0', blob, 'signature.png');

                $.ajax({
                    url: '@Url.Action("UploadTaskSignature", "FieldTracking")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if (response.success) {
                            resolve(response.filename);
                        } else {
                            toastr.error(response.message || 'Failed to upload signature');
                            reject(new Error(response.message || 'Failed to upload signature'));
                        }
                    },
                    error: function(xhr, status, error) {
                        toastr.error('Error uploading signature');
                        reject(error);
                    }
                });
            }, 'image/png');
        });
    }

    // Perform the actual check out API call
    function performClockOut(taskId, location, address, notes, proofRequired) {
        // Upload photos and signature first if required
        var uploadPromises = [];

        if (proofRequired === 1 || proofRequired === 3) {
            // Photos required
            uploadPromises.push(uploadPhotos(taskId));
        }

        if (proofRequired === 2 || proofRequired === 3) {
            // Signature required
            uploadPromises.push(uploadSignature(taskId));
        }

        // Wait for all uploads to complete
        Promise.all(uploadPromises)
            .then(function(results) {
                var checkOutData = {
                    taskId: taskId,
                    checkOutTime: new Date().toISOString(),
                    checkOutLatitude: location.lat,
                    checkOutLongitude: location.lng,
                    checkOutAddress: address,
                    completionNotes: notes || '',
                    deviceInfo: JSON.stringify({
                        accuracy: location.accuracy,
                        timestamp: new Date().toISOString()
                    })
                };

                // Add uploaded file references to checkout data
                var resultIndex = 0;
                if (proofRequired === 1 || proofRequired === 3) {
                    checkOutData.proofPhotoUrls = results[resultIndex] || [];
                    resultIndex++;
                }

                if (proofRequired === 2 || proofRequired === 3) {
                    checkOutData.signatureUrl = results[resultIndex] || '';
                }

                // Proceed with checkout API call
                performCheckOutAPICall(taskId, checkOutData);
            })
            .catch(function(error) {
                console.error('Error uploading files:', error);
                toastr.error('Failed to upload proof files. Please try again.');
            });
    }

    // Separate function to make the checkout API call
    // IMPORTANT: Calls attendance API FIRST, then task API
    function performCheckOutAPICall(taskId, checkOutData) {
        console.log('Starting check-out process for task:', taskId);

        // Get location from checkOutData (it should have latitude/longitude)
        // Update userCurrentLocation temporarily for the attendance API call
        var checkOutLocation = {
            lat: checkOutData.checkOutLatitude,
            lng: checkOutData.checkOutLongitude,
            accuracy: 0
        };
        var previousLocation = userCurrentLocation;
        userCurrentLocation = checkOutLocation;

        // Step 1: Record attendance FIRST
        callAttendanceClockOut(taskId, checkOutData.checkOutAddress, function(attendanceSuccess) {
            // Restore previous location
            userCurrentLocation = previousLocation;

            if (attendanceSuccess) {
                console.log('Attendance recorded successfully, proceeding with task check-out');

                // Step 2: ONLY IF attendance succeeded, update task status
                callTaskCheckOut(taskId, checkOutData);
            } else {
                // Attendance failed - stop here, don't call task API
                console.error('Attendance recording failed, aborting task check-out');
                toastr.error('Failed to record attendance. Task check-out aborted.');
            }
        });
    }

    // Helper function to call task check-out API (called after attendance is recorded)
    function callTaskCheckOut(taskId, checkOutData) {
        $.ajax({
            url: _webapifieldtrackingurl + 'taskmanagement/checkout',
            type: 'POST',
            headers: {
                'Authorization': 'Bearer ' + _tokan,
                'Content-Type': 'application/json'
            },
            data: JSON.stringify(checkOutData),
            success: function(response) {
                if (response.success) {
                    toastr.success('Task completed successfully');

                    // Reset the form before hiding modal
                    resetClockOutModal();

                    $('#clockOutModal').modal('hide');

                    // Remove the task from the active table (it's now completed)
                    var prefix = getActiveTablePrefix();
                    $('#' + prefix + 'task-row-' + taskId).fadeOut(400, function() {
                        $(this).remove();

                        // Check if there are any tasks left (only for My Today's Tasks)
                        if (prefix === 'my-' && $('#myTodaysTasksBody tr').length === 0) {
                            $('#myTodaysTasksBody').html('<tr><td colspan="8" style="text-align: center;">All tasks completed! Great job!</td></tr>');
                        }
                    });

                    // Clear the current active task
                    currentActiveTaskId = null;

                    // Re-enable all start buttons
                    $('.task-start-btn').prop('disabled', false);
                } else {
                    toastr.error(response.message || 'Failed to check out');
                }
            },
            error: function(xhr, status, error) {
                console.error('Error checking out:', error);
                var errorMsg = 'Failed to check out';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMsg = xhr.responseJSON.message;
                }
                toastr.error(errorMsg);
            }
        });
    }

    // ========== ROUTE NAVIGATION FUNCTIONS ==========

    // Global variable for route map instance
    var routeMapInstance = null;
    var routeTaskData = null;

    // Show task route on map
    function showTaskRoute(taskId) {
        // Fetch task details first
        $.ajax({
            url: _webapifieldtrackingurl + 'taskmanagement/' + taskId,
            type: 'GET',
            headers: {
                'Authorization': 'Bearer ' + _tokan,
                'Content-Type': 'application/json'
            },
            success: function(response) {
                if (response.success && response.data) {
                    routeTaskData = response.data;

                    // Show modal
                    $('#routeModal').modal('show');

                    // Set task info
                    $('#routeTaskTitle').text(routeTaskData.taskTitle);
                    $('#routeTaskLocation').text(routeTaskData.locationAddress || 'Task Location');

                    // Get current location and render map
                    getCurrentLocation(
                        function(location) {
                            // Calculate distance
                            if (routeTaskData.latitude && routeTaskData.longitude) {
                                var distance = calculateDistance(
                                    location.lat,
                                    location.lng,
                                    routeTaskData.latitude,
                                    routeTaskData.longitude
                                );

                                $('#routeDistance').text(formatDistance(distance));

                                // Estimate time (assume 30 km/h average speed = 500 meters/minute)
                                var timeMinutes = Math.ceil(distance / 500);
                                var timeDisplay = timeMinutes < 60
                                    ? timeMinutes + ' min'
                                    : Math.floor(timeMinutes / 60) + 'h ' + (timeMinutes % 60) + 'm';
                                $('#routeEstTime').text(timeDisplay);

                                // Initialize map
                                initializeRouteMap(location, routeTaskData);
                            } else {
                                toastr.error('Task location coordinates not available');
                                $('#routeModal').modal('hide');
                            }
                        },
                        function(error) {
                            toastr.error('Unable to get your current location');
                            $('#routeModal').modal('hide');
                        }
                    );
                } else {
                    toastr.error('Failed to load task details');
                }
            },
            error: function(xhr, status, error) {
                console.error('Error loading task details:', error);
                toastr.error(xhr.responseJSON.message);
            }
        });
    }

    // Get Google Directions route between two points
    function getGoogleDirectionsRoute(origin, destination, callback) {
        // Check if Google Maps is available
        if (typeof google === 'undefined' || !google.maps || !google.maps.DirectionsService) {
            console.error('Google Maps DirectionsService not available');
            callback(null);
            return;
        }

        var directionsService = new google.maps.DirectionsService();

        var request = {
            origin: new google.maps.LatLng(origin.lat, origin.lng),
            destination: new google.maps.LatLng(destination.lat, destination.lng),
            travelMode: google.maps.TravelMode.DRIVING,
            optimizeWaypoints: true,
            provideRouteAlternatives: false
        };

        directionsService.route(request, function(result, status) {
            if (status === google.maps.DirectionsStatus.OK) {
                var route = result.routes[0];
                var leg = route.legs[0];

                // Decode polyline to array of coordinates
                var path = [];
                var steps = leg.steps;

                for (var i = 0; i < steps.length; i++) {
                    var stepPath = steps[i].path;
                    for (var j = 0; j < stepPath.length; j++) {
                        path.push({
                            lat: stepPath[j].lat(),
                            lng: stepPath[j].lng()
                        });
                    }
                }

                // Return route data
                callback({
                    path: path,
                    distance: leg.distance.value, // in meters
                    duration: leg.duration.value, // in seconds
                    distanceText: leg.distance.text,
                    durationText: leg.duration.text
                });
            } else {
                console.error('Directions request failed:', status);
                callback(null);
            }
        });
    }

    // Get OSRM route between two points (for OpenSource provider)
    function getOSRMRoute(origin, destination, callback) {
        // Check if OpenSource provider with OSRM routing is available
        if (!FieldSenseLocationService.provider ||
            typeof FieldSenseLocationService.provider.getOSRMRoute !== 'function') {
            console.error('OSRM routing not available in current provider');
            callback(null);
            return;
        }

        // Call provider's OSRM routing method
        FieldSenseLocationService.provider.getOSRMRoute(origin, destination, function(result) {
            if (result && result.success) {
                callback({
                    path: result.path,
                    distance: result.distance, // in meters
                    duration: result.duration, // in seconds
                    distanceText: result.distanceText,
                    durationText: result.durationText
                });
            } else {
                console.error('OSRM routing failed:', result ? result.error : 'Unknown error');
                callback(null);
            }
        });
    }

    // Initialize route map using FieldSenseLocationService (provider-agnostic)
    function initializeRouteMap(userLocation, task) {
        // Check if FieldSenseLocationService is available
        if (typeof FieldSenseLocationService === 'undefined' || !FieldSenseLocationService.isInitialized) {
            console.error('FieldSenseLocationService not available or not initialized');
            $('#routeMapLoading').html('<p style="color: red;">Map service not available. Please refresh the page.</p>');
            toastr.error('Map service not available');
            return;
        }

        // Show loading
        $('#routeMapLoading').show();

        // Clear and prepare container
        $('#routeMapContainer').html('');
        $('#routeMapContainer').append('<div id="routeMapLoading" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;"><i class="fa-regular fa-spinner fa-spin fa-3x" style="color: #295097;"></i><p style="margin-top: 10px; color: #666;">Loading map...</p></div>');

        setTimeout(function() {
            // Initialize map using FieldSenseLocationService
            var mapConfig = {
                containerId: 'routeMapContainer',
                center: { lat: userLocation.lat, lng: userLocation.lng },
                zoom: 13
            };

            FieldSenseLocationService.initializeMap(mapConfig, function(map) {
                // Success callback
                routeMapInstance = map;
                console.log('Route map initialized successfully');

                $('#routeMapLoading').hide();

                // Add user location marker (blue circle)
                FieldSenseLocationService.addMarker({
                    position: { lat: userLocation.lat, lng: userLocation.lng },
                    title: 'Your Location',
                    color: 'blue',
                    label: 'U'
                }, function(userMarker) {
                    // Add popup/click listener for user marker
                    FieldSenseLocationService.addMarkerClickListener(userMarker, function() {
                        FieldSenseLocationService.showPopup(userMarker, '<div style="padding: 8px;"><strong>Your Location</strong></div>');
                    });
                });

                // Add task location marker (red pin)
                FieldSenseLocationService.addMarker({
                    position: { lat: task.latitude, lng: task.longitude },
                    title: task.taskTitle,
                    color: 'red',
                    label: 'T'
                }, function(taskMarker) {
                    // Add popup/click listener for task marker
                    var popupContent = '<div style="padding: 8px;">' +
                        '<strong>' + task.taskTitle + '</strong><br>' +
                        '<small>' + (task.locationAddress || '') + '</small>' +
                        '</div>';
                    FieldSenseLocationService.addMarkerClickListener(taskMarker, function() {
                        FieldSenseLocationService.showPopup(taskMarker, popupContent);
                    });
                });

                // Add geofence circle
                var radius = task.geofenceRadius || 100;
                var geofence = FieldSenseLocationService.createGeofence(
                    { lat: task.latitude, lng: task.longitude },
                    radius,
                    {
                        strokeColor: '#ea4335',
                        fillColor: '#ea4335',
                        fillOpacity: 0.2,
                        strokeWeight: 2
                    }
                );

                // Draw route line - use appropriate routing based on provider
                var drawRouteLine = function(routePath) {
                    FieldSenseLocationService.drawPolyline({
                        path: routePath,
                        strokeColor: '#4285f4',
                        strokeWeight: 3,
                        strokeOpacity: 0.8,
                        strokeDashArray: routePath.length > 2 ? null : '10, 5' // Solid line for actual route, dashed for straight line
                    }, function(polyline) {
                        console.log('Route line drawn with ' + routePath.length + ' points');
                    });
                };

                // Detect current location provider
                var locationProvider = '';
                if (FieldSenseLocationService.config && FieldSenseLocationService.config.LocationProvider) {
                    locationProvider = FieldSenseLocationService.config.LocationProvider.toLowerCase();
                }

                if (locationProvider === 'google') {
                    // Use Google Directions API for actual driving route
                    getGoogleDirectionsRoute(
                        { lat: userLocation.lat, lng: userLocation.lng },
                        { lat: task.latitude, lng: task.longitude },
                        function(directionsResult) {
                            if (directionsResult && directionsResult.path && directionsResult.path.length > 0) {
                                // Draw actual route
                                drawRouteLine(directionsResult.path);

                                // Update distance and duration with actual route data
                                $('#routeDistance').text(directionsResult.distanceText);
                                $('#routeEstTime').text(directionsResult.durationText);

                                console.log('Google Directions route drawn successfully');
                            } else {
                                // Fallback to straight line if directions failed
                                console.warn('Google Directions API failed, using straight line');
                                drawRouteLine([
                                    { lat: userLocation.lat, lng: userLocation.lng },
                                    { lat: task.latitude, lng: task.longitude }
                                ]);
                            }
                        }
                    );
                } else if (locationProvider === 'opensource') {
                    // Use OSRM for actual driving route with OpenSource provider
                    getOSRMRoute(
                        { lat: userLocation.lat, lng: userLocation.lng },
                        { lat: task.latitude, lng: task.longitude },
                        function(osrmResult) {
                            if (osrmResult && osrmResult.path && osrmResult.path.length > 0) {
                                // Draw actual OSRM route
                                drawRouteLine(osrmResult.path);

                                // Update distance and duration with actual route data
                                $('#routeDistance').text(osrmResult.distanceText);
                                $('#routeEstTime').text(osrmResult.durationText);

                                console.log('OSRM route drawn successfully with ' + osrmResult.path.length + ' points');
                            } else {
                                // Fallback to straight line if OSRM failed
                                console.warn('OSRM routing failed, using straight line');
                                drawRouteLine([
                                    { lat: userLocation.lat, lng: userLocation.lng },
                                    { lat: task.latitude, lng: task.longitude }
                                ]);
                            }
                        }
                    );
                } else {
                    // Fallback to straight line for unknown providers
                    console.warn('Unknown location provider, using straight line');
                    drawRouteLine([
                        { lat: userLocation.lat, lng: userLocation.lng },
                        { lat: task.latitude, lng: task.longitude }
                    ]);
                }

                // Fit map to show both markers with padding
                var bounds = [
                    { lat: userLocation.lat, lng: userLocation.lng },
                    { lat: task.latitude, lng: task.longitude }
                ];
                FieldSenseLocationService.fitBounds(bounds);

                // Setup external navigation button
                $('#btnNavigateExternal').off('click').on('click', function() {
                    var origin = userLocation.lat + ',' + userLocation.lng;
                    var destination = task.latitude + ',' + task.longitude;
                    var googleMapsUrl = 'https://www.google.com/maps/dir/?api=1&origin=' + origin +
                                        '&destination=' + destination + '&travelmode=driving';
                    window.open(googleMapsUrl, '_blank');
                });

            }, function(error) {
                // Error callback
                console.error('Error initializing route map:', error);
                $('#routeMapLoading').html('<p style="color: red;">Failed to load map. Please try again.</p>');
                toastr.error('Failed to load route map');
            });
        }, 300); // Small delay to ensure modal is fully visible
    }

    // Clean up map when modal is closed
    $('#routeModal').on('hidden.bs.modal', function() {
        if (routeMapInstance) {
            // Provider-agnostic cleanup
            // The map instance will be cleaned up by the browser when the container is cleared
            // For Google Maps: map = null is sufficient
            // For MapLibre: map.remove() is called automatically if available
            try {
                if (typeof routeMapInstance.remove === 'function') {
                    routeMapInstance.remove();
                }
            } catch (e) {
                console.warn('Error cleaning up map:', e);
            }
            routeMapInstance = null;
        }
        routeTaskData = null;
        // Clear the container to ensure cleanup
        $('#routeMapContainer').empty();
    });
</script>
