                                        <div style="padding: 15px; background: #e8f4f8; border-radius: 4px; border-left: 4px solid #295097;">
                                            <h5 style="margin-top: 0; color: #295097; font-weight: 500;"><i class="fa-regular fa-building"></i> Client Details</h5>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="ttl"><div>Client Name:</div> <span id="detailClientName"></span></div>
                                                    <div class="ttl"><div>Category:</div> <span id="detailClientCategory"></span></div>
                                                    <div class="ttl"><div>Address:</div> <span id="detailClientAddress"></span></div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="ttl"><div>Contact:</div> <span id="detailClientContact"></span></div>
                                                    <div class="ttl"><div>Contact Person:</div> <span id="detailClientPerson"></span></div>
                                                    @*<div class="ttl"><div>Total Visits:</strong> <span id="detailClientVisits"></span></p>*@
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Location Details -->
                                    <div style="margin-top: 15px;">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="ttl"><div>Address:</div> <span id="detailLocationAddress"></span></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="ttl"><div>Geofence Radius:</div> <span id="detailGeofenceRadius"></span></div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="ttl"><div>GPS Coordinates:</div> <span id="detailCoordinates"></span></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Execution Tab -->
                            <div id="executionTab" class="tab-pane">
                                <!-- Task Execution Details -->
                                <div id="executionDetailsContainer" class="modal-card">
                                    <h5 style="margin-top: 0;"><i class="fa-regular fa-circle-play"></i> Task Execution</h5>

                                    <!-- Check-In Details -->
                                    <div id="checkInDetailsSection" style="margin-bottom: 20px;">
                                        <div class="checkinblock">
                                            <h5 style="margin-top: 0; color: #155724; font-weight: 500;"><i class="fa-regular fa-right-to-bracket"></i> Check-In Details</h5>
