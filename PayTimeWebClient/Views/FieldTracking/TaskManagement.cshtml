                                    <p class="datanotfound_title">No tasks found</p>
                                    <p class="">No tasks have been created yet. Click the + button above to create your first task.</p>
                                </div>
                            </div>
                            <!-- Empty State: No Results After Filtering -->
                            <div id="allTasksEmptyFiltered" style="display:none;">
                                <div class="datanotfound">
                                    <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="No matching tasks">
                                    <p class="datanotfound_title">No matching tasks found</p>
