    // ========== TASK CHECK-IN/CHECK-OUT FUNCTIONS ==========

    // Perform the actual check in API call
    // IMPORTANT: Calls attendance API FIRST, then task API
    function performClockIn(taskId, address) {
        console.log('Starting check-in process for task:', taskId);

        // Step 1: Record attendance FIRST
        callAttendanceClockIn(taskId, address, function(attendanceSuccess) {
            if (attendanceSuccess) {
                console.log('Attendance recorded successfully, proceeding with task check-in');

                // Step 2: ONLY IF attendance succeeded, update task status
                callTaskCheckIn(taskId, address);
            } else {
                // Attendance failed - stop here, don't call task API
                console.error('Attendance recording failed, aborting task check-in');
                toastr.error('Failed to record attendance. Task check-in aborted.');
            }
        });
    }

