                                    <h5 style="margin-top: 0;"><i class="fa-light fa-location-dot"></i> Location & Client Information</h5>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="ttl"><div>Location Type:</div> <span id="detailLocationType"></span></div>
                                        </div>
                                    </div>

                                    <!-- Client Details Container (shown only for client location type) -->
