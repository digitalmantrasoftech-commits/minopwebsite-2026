    // Check In to task (with geofence validation)
    function clockInTask(taskId) {
        // First, fetch task details to get location and geofence radius
        $.ajax({
            url: _webapifieldtrackingurl + 'taskmanagement/' + taskId,
            type: 'GET',
            headers: {
                'Authorization': 'Bearer ' + _tokan,
                'Content-Type': 'application/json'
            },
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            complete: function () {
                $('#ajax_loader').hide();
            },
            success: function(response) {
                if (response.success && response.data) {
                    var task = response.data;
                    $('#clockInTaskId').val(taskId);
                    $('#clockInTaskTitle').text(task.taskTitle);
                    $('#clockInTaskLocation').text(task.locationAddress || 'Task Location');

                    // Get current location and validate geofence BEFORE showing modal
                    getCurrentLocation(
                        function(location) {
                            if (task.latitude && task.longitude) {
                                var geofenceCheck = checkGeofenceProximity(
                                    location.lat,
                                    location.lng,
                                    task.latitude,
                                    task.longitude,
                                    task.geofenceRadius || 100
                                );

                                if (geofenceCheck.isWithinGeofence) {
                                    // Within geofence - show modal and allow check in
                                    $('#clockInUserLocation').text('Lat: ' + location.lat.toFixed(6) + ', Lng: ' + location.lng.toFixed(6));
                                    $('#clockInDistance').text(geofenceCheck.distanceFormatted);

                                    $('#geofenceValidationStatus').hide();
                                    $('#clockInDetails').show();
                                    $('#geofenceError').hide();
                                    $('#btnConfirmClockIn').prop('disabled', false);

                                    // Show modal only if within geofence
                                    $('#clockInModal').modal('show');
                                } else {
                                    // Outside geofence - show toastr error, don't show modal
                                    toastr.warning(
                                        'You are ' + geofenceCheck.distanceFormatted + ' away from the task location. ' +
                                        'You must be within ' + formatDistance(task.geofenceRadius || 100) + ' to check in.',
                                        'Outside Geofence',
                                        { timeOut: 5000 }
                                    );
                                }
                            } else {
                                // No task location - shouldn't happen, but handle gracefully
                                toastr.warning('This task has no location set');
                            }
                        },
                        function(error) {
                            /*toastr.warning(error.message);*/
                        }
                    );
                } else {
                    toastr.error('Failed to load task details');
                }
            },
            error: function(xhr, status, error) {
                console.error('Error loading task:', error);
                toastr.error(xhr.responseJSON.message);
            }
        });
    }

    // Confirm check in
    function confirmClockIn() {
        var taskId = parseInt($('#clockInTaskId').val());

        if (!userCurrentLocation) {
            toastr.error('Unable to get your current location');
            return;
        }

        // Reverse geocode to get address (optional)
        var checkInAddress = 'Lat: ' + userCurrentLocation.lat.toFixed(6) + ', Lng: ' + userCurrentLocation.lng.toFixed(6);

        if (typeof FieldSenseLocationService !== 'undefined') {
            FieldSenseLocationService.reverseGeocode(userCurrentLocation.lat, userCurrentLocation.lng, function(result) {
                if (result && !result.error) {
                    performClockIn(taskId, result.formatted_address || result.address || checkInAddress);
                } else {
                    performClockIn(taskId, checkInAddress);
                }
            });
        } else {
            performClockIn(taskId, checkInAddress);
        }
    }

