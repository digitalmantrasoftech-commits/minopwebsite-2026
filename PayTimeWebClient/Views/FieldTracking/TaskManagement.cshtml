            <a href="javascript:;" class="btn icon_transparent_btn tooltips" id="AddEmployee" data-placement="bottom" data-original-title="Create Task" onclick="openTaskModal()"><i class="fa-solid fa-plus"></i></a>
        </div>
        <ul class="nav nav-tabs nav-tabs-custom" role="tablist">
            <li class="nav-item active">
                <a class="nav-link" data-toggle="tab" href="#allTasks" role="tab" aria-selected="true">
                    <i class="fa-light fa-clipboard-user"></i>
                    <span class="">All Tasks</span>
                </a>
            </li>
            @if (_RoleId != 1 && _RoleId != 6805 && _RoleId != 6806)
            {
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#myTodaysTasks" role="tab" aria-selected="false">
                        <i class="fa-light fa-person-to-door"></i>
                        <span class="">My Today's Tasks</span>
                    </a>
                </li>
            }
        </ul>
        <div class="tab-content text-muted tab_content_box">
            <div class="tab-pane active" id="allTasks" role="tabpanel">
                <div class="filter_portlet_wrapper full-width">
                    <!-- Datatable Block : Begin -->
                    <div class="portlet filter_portlet_tbl">
                        <div class="portlet-body">
                            <div id="divTable">
                                <div class="appoval_actionbtn">
                                    <select id="statusFilter" class="form-control" style="width: 200px; display: inline-block;">
                                        <option value="">All Status</option>
                                        <option value="Pending">Pending</option>
                                        <option value="InProgress">In Progress</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Overdue">Overdue</option>
                                    </select>
                                </div>
                                <div class="table-responsive" id="tableResponsive">
                                    <table id="tasksTable" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column">
                                        <thead>
                                            <tr>
                                                <th style="min-width: 80px;">Task ID</th>
                                                <th style="min-width: 140px;">Employee</th>
                                                <th>Client/Site</th>
                                                <th>Task Title</th>
                                                <th style="min-width: 90px;">Date & Time</th>
                                                <th>Priority</th>
                                                <th style="min-width: 110px;">Status</th>
                                                <th style="min-width: 90px;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tasksTableBody">
                                            <!-- Tasks will be loaded here dynamically -->
