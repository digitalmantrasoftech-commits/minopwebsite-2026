    // Save task
    function saveTask() {
        // Validate required fields
        if ($('#taskTitle').val() === '') {
            toastr.error('Please enter task title');
            return;
        }
        if ($('#assignedTo').val() === '') {
            toastr.error('Please assign the task to an employee');
            return;
        }

        // Validate location type
        var locationType = $('#locationType').val();
        if (locationType === '') {
            toastr.error('Please select location type');
            return;
        }

        // Build API request based on location type
        var apiData = {
            taskTitle: $('#taskTitle').val(),
            taskDescription: $('#taskDescription').val() || '',
            priority: $('#taskPriority').val() || 'Medium',
            assignedToEmpId: parseInt($('#assignedTo').val()),
            locationType: locationType,
            taskDate: $('#taskDate').val()
        };

        if (locationType === 'client') {
            if ($('#clientSelect').val() === '') {
                toastr.error('Please select a client');
                return;
            }
            apiData.clientId = parseInt($('#clientSelect').val());

        } else if (locationType === 'manual') {
            // Validate manual address with location selection
            if (!selectedLocation || !selectedLocation.lat || !selectedLocation.lng) {
                if ($('#manualAddress').val().trim() === '') {
                    toastr.error('Please select a location using the map or enter an address');
                    return;
                }
                toastr.error('Please select a valid location from suggestions or use the map picker');
                return;
            }

            var geofenceRadius = parseInt($('#geofenceRadius').val());
            if (isNaN(geofenceRadius) || geofenceRadius < 50 || geofenceRadius > 1000) {
                toastr.error('Geofence radius must be between 50 and 1000 meters');
                return;
            }

            apiData.locationAddress = $('#manualAddress').val() || selectedLocation.address;
            apiData.latitude = selectedLocation.lat;
            apiData.longitude = selectedLocation.lng;
            apiData.geofenceRadius = geofenceRadius;

        } else if (locationType === 'coordinates') {
            // Validate coordinates
            var lat = $('#coordLatitude').val();
            var lng = $('#coordLongitude').val();

            if (!isValidCoordinate(lat, lng)) {
                toastr.error('Please enter valid coordinates');
                return;
            }

            var coordRadius = parseInt($('#coordGeofenceRadius').val());
            if (isNaN(coordRadius) || coordRadius < 50 || coordRadius > 1000) {
                toastr.error('Geofence radius must be between 50 and 1000 meters');
                return;
            }

            apiData.locationAddress = $('#resolvedAddress').val() || ('Lat: ' + lat + ', Long: ' + lng);
            apiData.latitude = parseFloat(lat);
            apiData.longitude = parseFloat(lng);
            apiData.geofenceRadius = coordRadius;
        }

        // Validate schedule
        if ($('#taskDate').val() === '') {
            toastr.error('Please select task date');
            return;
        }

        // Validate duration
        var hours = parseInt($('#durationHours').val()) || 0;
        var minutes = parseInt($('#durationMinutes').val()) || 0;

        if (hours === 0 && minutes === 0) {
            toastr.error('Please enter a valid duration');
            return;
        }

        if (hours > 12) {
            toastr.error('Duration cannot exceed 12 hours');
            return;
        }

        // Convert to total minutes for API
        apiData.expectedDurationMinutes = (hours * 60) + minutes;

        // Determine if creating or updating
        var taskId = $('#taskId').val();
        var isEdit = taskId && taskId !== '0';
        var apiUrl = isEdit
            ? _webapifieldtrackingurl + 'taskmanagement/update/' + taskId
            : _webapifieldtrackingurl + 'taskmanagement/create';
        var apiMethod = isEdit ? 'PUT' : 'POST';

        // Make API call
        $.ajax({
            url: apiUrl,
            type: apiMethod,
            headers: {
                'Authorization': 'Bearer ' + _tokan,
                'Content-Type': 'application/json'
            },
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            complete: function () {
                $('#ajax_loader').hide();
            },
            data: JSON.stringify(apiData),
            success: function(response) {
                if (response.success) {
                    toastr.success(isEdit ? 'Task updated successfully' : 'Task created successfully');
                    $('#taskModal').modal('hide');

                    // Reload tasks based on current active tab
                    var activeTabId = $('.tab-pane.active').attr('id');
                    if (activeTabId === 'allTasks') {
                        // Use DataTable ajax reload for better UX (stays on current page)
                        if (allTasksDataTable !== null) {
                            allTasksDataTable.ajax.reload(null, false);
                        } else {
                            loadAllTasks();
                        }
                    } else if (activeTabId === 'myTodaysTasks') {
                        loadMyTodaysTasks();
                    }
                } else {
                    toastr.error(response.message || 'Failed to save task');
                }
            },
            error: function(xhr, status, error) {
                console.error('Error saving task:', error);
                var errorMsg = 'Failed to save task';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMsg = xhr.responseJSON.message;
                }
                toastr.error(errorMsg);
            }
        });
    }

