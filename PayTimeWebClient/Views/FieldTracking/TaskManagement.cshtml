                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Check In Modal : Begin -->
    <div id="clockInModal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog w-500">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"><i class="fa-regular fa-location-check"></i> Check In to Task</h4>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="clockInTaskId" value="">
                    <div id="geofenceValidationStatus" style="margin-bottom: 15px;">
