                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Body Block : End -->

    <!-- Create/Edit Task Modal : Begin -->
    <div id="taskModal" class="modal fade bs-modal-lg" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog w-500">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title" id="taskModalTitle">Create New Task</h4>
                </div>
                <div class="modal-body">
                    <form id="taskForm">
                        <input type="hidden" id="taskId" value="0">

                        <!-- Basic Details -->
                        <div class="modal-card">
                            <h5 style="margin-top: 0px; margin-bottom: 15px; font-size: 14px; font-weight: 500; color: #333;">Basic Details</h5>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>Task Title <span style="color: red;">*</span></label>
                                        <input type="text" class="form-control" id="taskTitle" required>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>Description</label>
                                        <textarea class="form-control" id="taskDescription" rows="3"></textarea>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>Priority</label>
                                        <select class="form-control" id="taskPriority">
                                            <option value="low">Low</option>
                                            <option value="medium" selected>Medium</option>
                                            <option value="high">High</option>
                                            <option value="urgent">Urgent</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Assignment & Location -->
                        <div class="modal-card">
                            <h5 style="margin-top: 0px; margin-bottom: 15px; font-size: 14px; font-weight: 500; color: #333;">Assignment & Location</h5>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>Assign To <span style="color: red;">*</span></label>
                                        <select class="form-control" id="assignedTo" required>
                                            <option value="">Select Employee</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>Location Type <span style="color: red;">*</span></label>
                                        <select class="form-control" id="locationType" required onchange="handleLocationTypeChange()">
                                            <option value="">Select Location Type</option>
                                            <option value="client">Client Location</option>
                                            <option value="manual">Custom Address</option>
                                            <option value="coordinates">Coordinates (Lat/Long)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-12">
                                    <!-- Client Dropdown (hidden by default) -->
                                    <div class="form-group" id="clientDropdownContainer" style="display: none;">
                                        <label>Select Client <span style="color: red;">*</span></label>
                                        <select class="form-control" id="clientSelect">
                                            <option value="">Select Client</option>
                                            <option value="1">ABC Corporation</option>
                                            <option value="2">XYZ Limited</option>
                                            <option value="3">Tech Solutions Inc</option>
                                            <option value="4">Global Services Ltd</option>
                                            <option value="5">Prime Industries</option>
                                        </select>
                                    </div>

                                    <!-- Manual Address Input with Map (hidden by default) -->
                                    <div id="manualAddressContainer" style="display: none;">
                                        <div class="form-group">
                                            <label>Location Address <span style="color: red;">*</span></label>
                                            <div class="input-group">
                                                <input type="text" class="form-control" id="manualAddress"
                                                       placeholder="Start typing an address or click map icon to pick location"
                                                       autocomplete="off" readonly>
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn save_btn" id="btnPickLocation" title="Pick from Map">
                                                        <i class="fa-light fa-location-dot"></i> Pick
                                                    </button>
                                                </span>
                                            </div>
                                            <div id="addressSuggestions" class="search-suggestions" style="display: none; position: absolute; z-index: 1000; width: 100%; background: white; border: 1px solid #ddd; max-height: 200px; overflow-y: auto;"></div>
                                        </div>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    <label>Latitude</label>
                                                    <input type="text" class="form-control" id="latitude" readonly>
                                                </div>
                                            </div>
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    <label>Longitude</label>
                                                    <input type="text" class="form-control" id="longitude" readonly>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row">
                                            <div class="col-sm-12">
                                                @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
                                                {
                                                    <div class="form-group">
                                                        <label>Geofence Radius: <span id="radiusValue" style="font-weight: bold;">100</span> meters <span style="color: red;">*</span></label>
                                                        <input type="range" class="form-control" id="geofenceRadius" value="100" min="50" max="1000" step="50" required
                                                               oninput="document.getElementById('radiusValue').textContent = this.value;"
                                                               style="padding: 0; height: 20px;">
                                                        <small class="text-muted">50m - 1000m</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <!-- Non-admin users: Use default radius from Work Policy -->
                                                    <input type="hidden" id="geofenceRadius" value="100">
                                                    <div class="form-group">

                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Coordinates Input (hidden by default) -->
                                    <div id="coordinatesContainer" style="display: none;">
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    <label>Latitude <span style="color: red;">*</span></label>
                                                    <input type="text" class="form-control" id="coordLatitude"
                                                           placeholder="e.g. 28.6139"
                                                           pattern="^[-]?([1-8]?[0-9]\.{1}[0-9]{1,6}|90\.{1}0{1,6})$">
                                                </div>
                                            </div>
                                            <div class="col-sm-6">
                                                <div class="form-group">
                                                    <label>Longitude <span style="color: red;">*</span></label>
                                                    <input type="text" class="form-control" id="coordLongitude"
                                                           placeholder="e.g. 77.2090"
                                                           pattern="^[-]?((1[0-7][0-9]|[1-9]?[0-9])\.{1}[0-9]{1,6}|180\.{1}0{1,6})$">
                                                </div>
                                            </div>
                                            <div class="col-sm-12">
                                                @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
                                                {
                                                    <div class="form-group">
                                                        <label>Geofence Radius: <span id="coordRadiusValue" style="font-weight: bold;">100</span> meters <span style="color: red;">*</span></label>
                                                        <input type="range" class="form-control" id="coordGeofenceRadius" value="100" min="50" max="1000" step="50" required
                                                               oninput="document.getElementById('coordRadiusValue').textContent = this.value;"
                                                               style="padding: 0; height: 20px;">
                                                        <small class="text-muted">50m - 1000m</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <!-- Non-admin users: Use default radius from Work Policy -->
                                                    <input type="hidden" id="coordGeofenceRadius" value="100">
                                                    <div class="form-group">

                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <button type="button" class="btn btn-default btn-sm" id="btnValidateCoordinates">
                                                <i class="fa-regular fa-circle-check"></i> Validate & Get Address
                                            </button>
                                            <button type="button" class="btn btn-default btn-sm" id="btnViewOnMap">
                                                <i class="fa-regular fa-map-location-dot"></i> View on Map
                                            </button>
                                        </div>
                                        <div class="form-group">
                                            <label>Resolved Address</label>
                                            <input type="text" class="form-control" id="resolvedAddress" readonly>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Schedule -->
                        <div class="modal-card">
                            <h5 style="margin-top: 0px; margin-bottom: 15px; font-size: 14px; font-weight: 500; color: #333;">Schedule</h5>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>Task Date <span style="color: red;">*</span></label>
                                        <input type="date" class="form-control" id="taskDate" required>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>Expected Duration <span style="color: red;">*</span></label>
                                        <div class="row">
                                            <div class="col-xs-6">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" id="durationHours" min="0" max="12" value="1" required>
                                                    <span class="input-group-addon">Hours</span>
                                                </div>
                                            </div>
                                            <div class="col-xs-6">
                                                <div class="input-group">
                                                    <input type="number" class="form-control" id="durationMinutes" min="0" max="59" value="0" step="15">
                                                    <span class="input-group-addon">Minutes</span>
                                                </div>
                                            </div>
                                        </div>
                                        <small class="text-muted">Enter expected task duration (e.g., 2 hours 30 minutes)</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn clear_btn" data-dismiss="modal"><i class="fa-regular fa-xmark"></i> Cancel</button>
                    <button type="button" class="btn btn-minop btn-minop-primary save_btn" onclick="saveTask()"><i class="fa-light fa-floppy-disk"></i> Save Task</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Comprehensive Task Details Modal : Begin -->
