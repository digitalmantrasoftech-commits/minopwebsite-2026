    // Initialize location services
    function initializeLocationServices() {
        // Initialize FieldSenseLocationService
        if (typeof FieldSenseLocationService !== 'undefined') {
            FieldSenseLocationService.init();
        }

        // Setup event handlers for location features
        setupLocationEventHandlers();
