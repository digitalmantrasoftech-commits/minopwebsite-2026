    // Search for address suggestions
    function searchAddressSuggestions(query) {
        if (typeof FieldSenseLocationService !== 'undefined') {
            $('#addressSuggestions').html('<div style="padding: 10px;"><i class="fa-regular fa-spinner fa-spin"></i> Searching...</div>').show();

            FieldSenseLocationService.geocodeAddress(query, function(result) {
                if (result && !result.error) {
                    showAddressSuggestions([result]);
                } else {
                    $('#addressSuggestions').html('<div style="padding: 10px; color: #999;">No suggestions found</div>').show();
                    setTimeout(function() {
                        $('#addressSuggestions').hide();
                    }, 3000);
                }
            });
        }
    }

    // Display address suggestions
    function showAddressSuggestions(suggestions) {
        if (suggestions && suggestions.length > 0) {
            var html = '';
            suggestions.forEach(function(item) {
                html += '<div class="suggestion-item" style="padding: 10px; cursor: pointer; border-bottom: 1px solid #eee;" ';
                html += 'data-lat="' + item.lat + '" data-lng="' + item.lng + '" ';
                html += 'data-address="' + (item.formatted_address || item.address || '') + '">';
                html += '<i class="fa-regular fa-location-dot"></i> ' + (item.formatted_address || item.address || 'Unknown location');
                html += '</div>';
            });

            $('#addressSuggestions').html(html).show();

            // Bind click events to suggestions
            $('.suggestion-item').on('click', function() {
                var lat = $(this).data('lat');
                var lng = $(this).data('lng');
                var address = $(this).data('address');

                selectedLocation = {
                    lat: parseFloat(lat),
                    lng: parseFloat(lng),
                    address: address
                };

                $('#manualAddress').val(address);
                $('#latitude').val(parseFloat(lat).toFixed(6));
                $('#longitude').val(parseFloat(lng).toFixed(6));
                $('#addressSuggestions').hide();
            });
        } else {
            $('#addressSuggestions').hide();
        }
    }

    // Validate coordinates
    function isValidCoordinate(lat, lng) {
        lat = parseFloat(lat);
        lng = parseFloat(lng);

        if (isNaN(lat) || isNaN(lng)) {
            return false;
        }

        // Validate latitude range (-90 to 90)
        if (lat < -90 || lat > 90) {
            return false;
        }

        // Validate longitude range (-180 to 180)
        if (lng < -180 || lng > 180) {
            return false;
        }

        return true;
    }

    // Validate and reverse geocode coordinates
    function validateAndGeocodeCoordinates() {
        var lat = $('#coordLatitude').val();
        var lng = $('#coordLongitude').val();

        if (!isValidCoordinate(lat, lng)) {
            toastr.error('Please enter valid coordinates');
            return;
        }

        lat = parseFloat(lat);
        lng = parseFloat(lng);

        // Update resolved address field
        $('#resolvedAddress').val('Fetching address...');

        if (typeof FieldSenseLocationService !== 'undefined') {
            FieldSenseLocationService.reverseGeocode(lat, lng, function(result) {
                if (result && !result.error) {
                    $('#resolvedAddress').val(result.formatted_address || result.address || 'Address not available');
                    selectedLocation = {
                        lat: lat,
                        lng: lng,
                        address: result.formatted_address || result.address,
                        radius: parseInt($('#coordGeofenceRadius').val()) || 100
                    };
                    toastr.success('Coordinates validated successfully');
                } else {
                    $('#resolvedAddress').val('Unable to fetch address for these coordinates');
                    selectedLocation = {
                        lat: lat,
                        lng: lng,
                        address: 'Coordinates: ' + lat.toFixed(6) + ', ' + lng.toFixed(6),
                        radius: parseInt($('#coordGeofenceRadius').val()) || 100
                    };
                    toastr.warning('Coordinates are valid but address could not be fetched');
                }
            });
        } else {
            // Fallback if location service is not available
            selectedLocation = {
                lat: lat,
                lng: lng,
                address: 'Coordinates: ' + lat.toFixed(6) + ', ' + lng.toFixed(6),
                radius: parseInt($('#coordGeofenceRadius').val()) || 100
            };
            $('#resolvedAddress').val(selectedLocation.address);
            toastr.info('Coordinates validated');
        }
    }

    // View coordinates on map
    function viewCoordinatesOnMap() {
        var lat = $('#coordLatitude').val();
        var lng = $('#coordLongitude').val();

        if (!isValidCoordinate(lat, lng)) {
            toastr.error('Please enter valid coordinates first');
            return;
        }

        lat = parseFloat(lat);
        lng = parseFloat(lng);

        if (typeof LocationPickerModal !== 'undefined') {
            LocationPickerModal.show({
                title: 'View Location on Map',
                currentLocation: { lat: lat, lng: lng },
                radius: parseInt($('#coordGeofenceRadius').val()) || 100,
                showRadius: true,
                showSearch: false,
                showCurrentLocation: false,
                confirmText: 'Use This Location',
                cancelText: 'Close'
            }, function(result) {
                if (result) {
                    // Update coordinates if user moved the marker
                    $('#coordLatitude').val(result.lat.toFixed(6));
                    $('#coordLongitude').val(result.lng.toFixed(6));
                    $('#coordGeofenceRadius').val(result.radius || 100);

                    // Re-validate to get new address
                    validateAndGeocodeCoordinates();
                }
            });
        } else {
            toastr.error('Map viewer not available');
        }
    }

