                'Content-Type': 'application/json'
            },
            success: function(response) {
                if (response.success && response.data) {
                    var task = response.data;

                    // If task has client, fetch client details
                    if (task.locationType === 'client' && task.clientId) {
                        fetchClientDetailsByTaskId(taskId, function(client) {
                            populateTaskDetailsModal(task, client);
                        });
                    } else {
                        populateTaskDetailsModal(task, null);
                    }
                } else {
                    toastr.error('Failed to load task details');
                    $('#taskDetailsModal').modal('hide');
                }
            },
            error: function(xhr, status, error) {
                console.error('Error loading task details:', error);
                toastr.error('Failed to load task details');
                $('#taskDetailsModal').modal('hide');
            }
        });
    }

