                                <div class="table-responsive" id="tableResponsivetask">
                                    <table id="myTodaysTasksTable" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column">
                                        <thead>
                                            <tr>
                                                <th>Task ID</th>
                                                <th>Client/Site</th>
                                                <th>Task Title</th>
