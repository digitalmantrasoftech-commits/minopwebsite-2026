                                        <div class="col-md-6">
                                            <div class="ttl"><div>Task ID:</div> <span id="detailTaskCode"></span></div>
                                            <div class="ttl"><div>Priority:</div> <span id="detailPriority"></span></div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="ttl"><div>Title:</div> <span id="detailTaskTitle"></span></div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="ttl"><div>Description:</div></div>
                                            <div id="detailTaskDescription" style="margin-bottom: 0;"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Assignment & Timeline Section -->
                                <div class="modal-card">
                                    <h5 style="margin-top: 0;"><i class="fa-light fa-user-clock"></i> Assignment & Timeline</h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="ttl"><div>Assigned To:</div> <span id="detailAssignedTo"></span></div>
                                            <div class="ttl"><div>Assigned By:</div> <span id="detailAssignedBy"></span></div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="ttl"><div>Task Date:</div> <span id="detailTaskDate"></span></div>
                                            <div class="ttl"><div>Expected Duration:</div> <span id="detailExpectedDuration"></span></div>
                                        </div>
                                    </div>
                                    <div id="detailTimeline" style="margin-top: 10px;"></div>
                                </div>

                                <!-- Location & Client Section -->
