    // Populate task details modal
    function populateTaskDetailsModal(task, client) {
        // Hide loading, show content
        $('#taskDetailsLoading').hide();
        $('#taskDetailsContent').show();

        // Status badge
        var statusClass = task.status.toLowerCase().replace(' ', '');
        var statusBadge = '<span class="task-status status-' + statusClass + '">' + task.status + '</span>';
        $('#taskDetailStatusBadge').html(statusBadge);

        // Task Overview
        $('#detailTaskCode').text(task.taskCode || 'N/A');
        $('#detailTaskTitle').text(task.taskTitle || 'N/A');
        $('#detailTaskDescription').text(task.taskDescription || 'No description provided');

        // Priority with color
        var priorityColor = getPriorityColor(task.priority || 'Medium');
        $('#detailPriority').html('<span style="color: ' + priorityColor + '; font-weight: 500;">' + (task.priority || 'Medium') + '</span>');

        // Assignment & Timeline
        $('#detailAssignedTo').text(task.assignedToEmpName || 'N/A');
        $('#detailAssignedBy').text(task.assignedByUserName || 'Admin');
        $('#detailTaskDate').text(formatLocalDate(task.taskDate) || 'N/A');
        $('#detailExpectedDuration').text(task.expectedDurationDisplay || 'N/A');

        // Timeline visualization
        renderTaskTimeline(task);

        // Location Type
        var locationTypeDisplay = task.locationType === 'client' ? 'Client Location' :
                                  task.locationType === 'manual' ? 'Custom Address' :
                                  task.locationType === 'coordinates' ? 'GPS Coordinates' : 'N/A';
        $('#detailLocationType').text(locationTypeDisplay);

        // Client Details (if applicable)
        if (client) {
            $('#clientDetailsContainer').show();
            $('#detailClientName').text(client.clientName || 'N/A');
            $('#detailClientCategory').text(client.clientCategory || 'N/A');
            $('#detailClientAddress').text(client.address || 'N/A');

            var clientContact = (client.email || '') + (client.phone ? ' | ' + client.phone : '');
            $('#detailClientContact').text(clientContact || 'N/A');

            var clientPerson = (client.contactPerson || '') + (client.contactPersonPhone ? ' (' + client.contactPersonPhone + ')' : '');
            $('#detailClientPerson').text(clientPerson || 'N/A');

            var lastVisit = client.lastVisitDate ? formatLocalDate(client.lastVisitDate) : 'Never';
            /*$('#detailClientVisits').text((client.totalVisits || 0) + ' | Last: ' + lastVisit);*/
        } else {
            $('#clientDetailsContainer').hide();
        }

        // Location Details
        $('#detailLocationAddress').text(task.locationAddress || 'N/A');
        $('#detailGeofenceRadius').text(task.geofenceRadius ? task.geofenceRadius + ' meters' : 'N/A');

        if (task.latitude && task.longitude) {
            $('#detailCoordinates').text(task.latitude.toFixed(6) + ', ' + task.longitude.toFixed(6));
        } else {
            $('#detailCoordinates').text('N/A');
        }

        // Show/Hide tabs based on task status
        if (task.status === 'InProgress' || task.status === 'Completed') {
            $('#executionTabLink').show();

            // Parse check-in data
            if (task.checkInData) {
                var checkInData = typeof task.checkInData === 'string' ? JSON.parse(task.checkInData) : task.checkInData;
                $('#detailCheckInTime').text(formatLocalDateTime(checkInData.time || checkInData.checkInTime) || 'N/A');
                $('#detailCheckInLocation').text(checkInData.address || checkInData.checkInAddress || 'N/A');

                if (checkInData.latitude && checkInData.longitude) {
                    $('#detailCheckInCoords').text(checkInData.latitude.toFixed(6) + ', ' + checkInData.longitude.toFixed(6));
                } else {
                    $('#detailCheckInCoords').text('N/A');
                }

                var deviceInfo = 'N/A';
                if (checkInData.deviceInfo) {
                    try {
                        var device = typeof checkInData.deviceInfo === 'string' ? JSON.parse(checkInData.deviceInfo) : checkInData.deviceInfo;
                        deviceInfo = 'Accuracy: ' + (device.accuracy ? Math.round(device.accuracy) + 'm' : 'N/A');
                    } catch (e) {
                        deviceInfo = checkInData.deviceInfo;
                    }
                }
                $('#detailCheckInDevice').text(deviceInfo);
            } else {
                $('#checkInDetailsSection').hide();
            }

            // Check-out details (only for completed)
            if (task.status === 'Completed' && task.checkOutData) {
                $('#checkOutDetailsSection').show();
                var checkOutData = typeof task.checkOutData === 'string' ? JSON.parse(task.checkOutData) : task.checkOutData;

                $('#detailCheckOutTime').text(formatLocalDateTime(checkOutData.time || checkOutData.checkOutTime) || 'N/A');
                $('#detailCheckOutLocation').text(checkOutData.address || checkOutData.checkOutAddress || 'N/A');

                if (checkOutData.latitude && checkOutData.longitude) {
                    $('#detailCheckOutCoords').text(checkOutData.latitude.toFixed(6) + ', ' + checkOutData.longitude.toFixed(6));
                } else {
                    $('#detailCheckOutCoords').text('N/A');
                }

                // Calculate actual duration
                var actualDuration = 'N/A';
                if (task.startTime && task.endTime) {
                    var start = new Date(task.startTime);
                    var end = new Date(task.endTime);
                    var durationMinutes = Math.floor((end - start) / 60000);
                    var hours = Math.floor(durationMinutes / 60);
                    var minutes = durationMinutes % 60;
                    actualDuration = hours + 'h ' + minutes + 'm';
                }
                $('#detailActualDuration').text(actualDuration);
            } else {
                $('#checkOutDetailsSection').hide();
            }

            // Proof of Work (only for completed)
            if (task.status === 'Completed' && task.proofOfWork) {
                $('#proofOfWorkSection').show();
                var proofData = typeof task.proofOfWork === 'string' ? JSON.parse(task.proofOfWork) : task.proofOfWork;
                renderProofOfWork(proofData);
            } else {
                $('#proofOfWorkSection').hide();
            }

            //// Route Map tab (only for completed with location data)
            //if (task.status === 'Completed' && task.checkInData && task.checkOutData) {
            //    $('#routeTabLink').show();
            //} else {
            //    $('#routeTabLink').hide();
            //}
        } else {
            $('#executionTabLink').hide();
            $('#routeTabLink').hide();
        }

        // Action buttons based on status and permissions
        renderTaskDetailActions(task);
    }

    // Render task timeline
    function renderTaskTimeline(task) {
        var html = '';
        var status = task.status.toLowerCase().replace(' ', '');

        if (status === 'pending') {
            html = '<div style="padding: 10px; background: #fff3cd; border-left: 4px solid #FE7A00; border-radius: 4px;">';
            html += '<i class="fa-regular fa-clock"></i> Task scheduled for ' + formatLocalDate(task.taskDate);
            html += '<br><small>Expected to take ' + (task.expectedDurationDisplay || 'N/A') + '</small>';
            html += '</div>';
        } else if (status === 'inprogress') {
            html = '<div style="padding: 10px; background: #dde8f7; border-left: 4px solid #295097; border-radius: 4px;">';
            html += '<i class="fa-regular fa-circle-play"></i> Task started ';
            if (task.startTime) {
                html += 'at ' + formatLocalTime(task.startTime);
                var elapsed = calculateElapsedTime(task.startTime);
                html += '<br><small>Elapsed: <strong>' + elapsed + '</strong> / Expected: ' + (task.expectedDurationDisplay || 'N/A') + '</small>';
            }
            html += '</div>';
        } else if (status === 'completed') {
            html = '<div style="padding: 10px; background: #d1e7dd; border-left: 4px solid #28a745; border-radius: 4px;">';
            html += '<i class="fa-light fa-circle-check"></i> Task completed ';
            if (task.endTime) {
                html += 'at ' + formatLocalTime(task.endTime);
            }
            html += '</div>';
        } else if (status === 'cancelled') {
            html = '<div style="padding: 10px; background: #f8d7da; border-left: 4px solid #dc3545; border-radius: 4px;">';
            html += '<i class="fa-regular fa-circle-xmark"></i> Task cancelled';
            html += '</div>';
        } else if (status === 'overdue') {
            var overdueDays = calculateOverdueDays(task.taskDate);
            var overdueText = overdueDays === 1 ? '1 day' : overdueDays + ' days';
            html = '<div style="padding: 10px; background: #fff5f5; border-left: 4px solid #dc3545; border-radius: 4px;">';
            html += '<i class="fa-regular fa-clock" style="color: #dc3545; animation: pulse 2s infinite;"></i> <strong style="color: #dc3545;">Task Overdue</strong>';
            html += '<br><small>Scheduled for ' + formatLocalDate(task.taskDate) + ' (' + overdueText + ' overdue)</small>';
            html += '<br><small>Expected duration: ' + (task.expectedDurationDisplay || 'N/A') + '</small>';
            html += '</div>';
        }

        $('#detailTimeline').html(html);
    }

    // Calculate elapsed time from start
    function calculateElapsedTime(startTime) {
        if (!startTime) return 'N/A';
        var start = new Date(startTime);
        var now = new Date();
        var elapsedMinutes = Math.floor((now - start) / 60000);
        var hours = Math.floor(elapsedMinutes / 60);
        var minutes = elapsedMinutes % 60;
        return hours + 'h ' + minutes + 'm';
    }

    // Render proof of work
    function renderProofOfWork(proofData) {
        // Photos
        var photoCount = proofData.photoUrls ? proofData.photoUrls.length : 0;
        $('#detailPhotoCount').text(photoCount);

        var photosHtml = '';
        if (photoCount > 0) {
            proofData.photoUrls.forEach(function(filename, index) {
                var imagePath = '/assets/images/FieldTracking/Photos/' + filename;
                photosHtml += '<div style="width: 100px; height: 100px; background: #e9ecef; border-radius: 4px; overflow: hidden; cursor: pointer; position: relative;" onclick="viewTaskPhoto(\'' + imagePath + '\')">';
                photosHtml += '<img src="' + imagePath + '" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.parentElement.innerHTML=\'<div style=\\\'display:flex;align-items:center;justify-content:center;height:100%;\\\'><i class=\\\'fa-regular fa-image fa-2x text-muted\\\'></i></div>\';" />';
                photosHtml += '<div style="position: absolute; bottom: 5px; right: 5px; background: rgba(0,0,0,0.5); color: white; padding: 2px 5px; border-radius: 3px; font-size: 11px;">Photo ' + (index + 1) + '</div>';
                photosHtml += '</div>';
            });
        } else {
            photosHtml = '<p class="text-muted">No photos uploaded</p>';
        }
        $('#detailProofPhotos').html(photosHtml);

        // Signature
        if (proofData.signatureUrl) {
            var signaturePath = '/assets/images/FieldTracking/Signature/' + proofData.signatureUrl;
            $('#detailProofSignature').html('<img src="' + signaturePath + '" style="max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 4px;" onerror="this.outerHTML=\'<div class=\\\'text-center text-muted\\\'><i class=\\\'fas fa-signature fa-2x\\\'></i><p>Signature not available</p></div>\';" />');
        } else {
            $('#detailProofSignature').html('<div class="text-center text-muted"><i class="fa-regular fa-signature fa-2x "></i><p>No signature captured</p></div>');
        }

        // Notes
        $('#detailCompletionNotes').html('<p>' + (proofData.completionNotes || 'No notes provided') + '</p>');
    }

