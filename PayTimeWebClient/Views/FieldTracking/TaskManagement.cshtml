    // Edit task
    function editTask(taskId) {
        // Fetch task details from API
        $.ajax({
            url: _webapifieldtrackingurl + 'taskmanagement/' + taskId,
            type: 'GET',
            headers: {
                'Authorization': 'Bearer ' + _tokan,
                'Content-Type': 'application/json'
            },
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            complete: function () {
                $('#ajax_loader').hide();
            },
            success: function(response) {
                if (response.success && response.data) {
                    var task = response.data;

                    // Set modal title and task ID
                    $('#taskId').val(task.taskId);
                    $('#taskModalTitle').text('Edit Task');
                    const priority = String(task?.priority || "").toLowerCase();

                    // Populate basic details
                    $('#taskTitle').val(task.taskTitle);
                    $('#taskDescription').val(task.taskDescription || '');
                    $('#taskPriority').val(priority);
                    $('#assignedTo').val(task.assignedToEmpId);

                    // Set location type and related fields
                    $('#locationType').val(task.locationType);
                    handleLocationTypeChange();

                    if (task.locationType === 'client' && task.clientId) {
                        $('#clientSelect').val(task.clientId);
                    } else if (task.locationType === 'manual' || task.locationType === 'coordinates') {
                        if (task.latitude && task.longitude) {
                            if (task.locationType === 'manual') {
                                $('#manualAddress').val(task.locationAddress || '');
                                $('#latitude').val(task.latitude);
                                $('#longitude').val(task.longitude);
                                $('#geofenceRadius').val(task.geofenceRadius || 100);
                                $('#radiusValue').text(task.geofenceRadius || 100);
                                selectedLocation = {
                                    lat: task.latitude,
                                    lng: task.longitude,
                                    address: task.locationAddress,
                                    radius: task.geofenceRadius
                                };
                            } else {
                                $('#coordLatitude').val(task.latitude);
                                $('#coordLongitude').val(task.longitude);
                                $('#coordGeofenceRadius').val(task.geofenceRadius || 100);
                                $('#coordRadiusValue').text(task.geofenceRadius || 100);
                                $('#resolvedAddress').val(task.locationAddress || '');
                            }
                        }
                    }

                    // Set schedule
                    $('#taskDate').val(task.taskDate.split('T')[0]);

                    // Convert duration from minutes to hours and minutes
                    var totalMinutes = task.expectedDurationMinutes || 0;
                    var hours = Math.floor(totalMinutes / 60);
                    var minutes = totalMinutes % 60;
                    $('#durationHours').val(hours);
                    $('#durationMinutes').val(minutes);

                    // Show modal
                    $('#taskModal').modal('show');
                } else {
                    toastr.error('Failed to load task details');
                }
            },
            error: function(xhr, status, error) {
                console.error('Error loading task details:', error);
                toastr.error(xhr.responseJSON.message);
            }
        });
    }

    // Delete task
    function deleteTask(taskId) {
        // Use SweetAlert if available, otherwise use a custom modal
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                html: '<div class="swal_subtitle"><b>Are you sure you want to delete this task?</b><p>This action cannot be undone.</p></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Delete Task",
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'Cancel',
                confirmButtonText: 'Yes, delete it!',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Make API call to delete task
                    $.ajax({
                        url: _webapifieldtrackingurl + 'taskmanagement/' + taskId,
                        type: 'DELETE',
                        headers: {
                            'Authorization': 'Bearer ' + _tokan,
                            'Content-Type': 'application/json'
                        },
                        beforeSend: function () {
                            $("#ajax_loader").show();
                        },
                        complete: function () {
                            $('#ajax_loader').hide();
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    html: '<div class="swal_subtitle"><b>Task has been deleted successfully.</b></div>',
                                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Deleted!",
                                    timer: 2000,
                                    showConfirmButton: false,
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]').parent().parent().parent().addClass('swal_success');

                                // Reload tasks based on current active tab
                                var activeTabId = $('.tab-pane.active').attr('id');
                                if (activeTabId === 'allTasks') {
                                    // Use DataTable ajax reload for better UX (stays on current page)
                                    if (allTasksDataTable !== null) {
                                        allTasksDataTable.ajax.reload(null, false);
                                    } else {
                                        loadAllTasks();
                                    }
                                } else if (activeTabId === 'myTodaysTasks') {
                                    loadMyTodaysTasks();
                                }
                            } else {
                                Swal.fire({
                                    html: '<div class="swal_subtitle"><b>' + (response.message || "Failed to delete task") + '</b></div>',
                                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error",
                                    showCloseButton: true,
                                    confirmButtonText: 'OK',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: {
                                        confirmButton: 'swal-confirm-button-class'
                                    }
                                });
                                $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                            }
                        },
                        error: function(xhr, status, error) {
                            Swal.fire({
                                html: '<div class="swal_subtitle"><b>Failed to delete task. Please try again.</b></div>',
                                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error",
                                showCloseButton: true,
                                confirmButtonText: 'OK',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                customClass: {
                                    confirmButton: 'swal-confirm-button-class'
                                }
                            });
                            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
                        }
                    });
                }
            });
            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
        } else {
            // Fallback to custom confirmation modal if SweetAlert is not available
            showDeleteConfirmationModal(taskId);
        }
    }

    // Custom delete confirmation modal function (fallback)
    function showDeleteConfirmationModal(taskId) {
        // Create a simple confirmation using toastr with callback
        var confirmHtml = '<div style="margin-bottom: 15px;">Are you sure you want to delete this task?</div>';
        confirmHtml += '<button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete(\'' + taskId + '\')">Delete</button> ';
        confirmHtml += '<button type="button" class="btn btn-sm btn-default" onclick="toastr.clear()">Cancel</button>';

        toastr.warning(confirmHtml, 'Confirm Delete', {
            closeButton: false,
            allowHtml: true,
            timeOut: 0,
            extendedTimeOut: 0,
            tapToDismiss: false
        });
    }

