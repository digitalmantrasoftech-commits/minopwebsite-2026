    // Get action buttons for My Today's Tasks with enhanced logic
    function getMyTaskActionButtons(task, currentEmployeeId) {
        var buttons = '';
        var status = task.status.toLowerCase().replace(' ', '');

        if (status === 'pending') {
            // Show Start button - but check if another task is already started
            buttons += '<a class="btn seagreen_btnnew tooltips' + (currentActiveTaskId !== null && currentActiveTaskId !== task.taskId ? ' disabled' : '') + '" data-task-id="' + task.taskId + '" data-placement="left" data-original-title="Start Task" onclick="' + (currentActiveTaskId === null || currentActiveTaskId === task.taskId ? 'startTask(' + task.taskId + ')' : 'return false;') + '">';
            buttons += '<i class="fa-regular fa-play"></i></a> ';

        } else if (status === 'inprogress') {
            // Check if task has been checked in
            var hasCheckedIn = task.checkInData.time !== null && task.checkInData.time !== undefined;

            if (!hasCheckedIn) {
                // Show Stop, Route, and Check In buttons
                buttons += '<a class="btn red_btnnew tooltips" data-placement="left" data-original-title="Stop Task" onclick="stopTask(' + task.taskId + ')">';
                buttons += '<i class="fa-regular fa-stop"></i></a> ';

                buttons += '<a class="btn seagreen_btnnew tooltips" data-placement="left" data-original-title="View Route" onclick="showTaskRoute(' + task.taskId + ')">';
                buttons += '<i class="fa-regular fa-route"></i></a> ';

                buttons += '<a class="btn seagreen_btnnew tooltips" data-placement="left" data-original-title="Check In" onclick="clockInTask(' + task.taskId + ')">';
                buttons += '<i class="fa-regular fa-sign-in-alt"></i></a>';

            } else {
                // Show Check Out button only
                buttons += '<a class="btn seagreen_btnnew tooltips" data-placement="left" data-original-title="Check Out" onclick="clockOutTask(' + task.taskId + ')">';
                buttons += '<i class="fa-regular fa-sign-out-alt"></i></a>';
            }

        } else if (status === 'completed') {
            // Show view details button
            buttons += '<a class="btn seagreen_btnnew tooltips" data-placement="left" data-original-title="View Details" onclick="viewTaskDetails(' + task.taskId + ')">';
            buttons += '<i class="fa-regular fa-eye"></i></a>';
        }

        return buttons;
    }

    // Format task date for display (user's local timezone)
    function formatTaskDate(utcDate) {
        if (!utcDate) return 'N/A';

        var date = parseUTCDate(utcDate);
        if (!date) return 'N/A';

        // Get today and tomorrow in user's local timezone
        var now = new Date();
        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        var tomorrow = new Date(today);
        tomorrow.setDate(today.getDate() + 1);

        // Compare dates in local timezone
        var taskDateOnly = new Date(date.getFullYear(), date.getMonth(), date.getDate());

        if (taskDateOnly.getTime() === today.getTime()) {
            return 'Today';
        } else if (taskDateOnly.getTime() === tomorrow.getTime()) {
            return 'Tomorrow';
        } else {
            return formatLocalDate(utcDate);
        }
    }

    // Calculate how many days a task is overdue
    function calculateOverdueDays(taskDate) {
        var task = new Date(taskDate);
        var now = new Date();

        task.setHours(0, 0, 0, 0);
        now.setHours(0, 0, 0, 0);

        var diffTime = now - task;
        var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

        return diffDays > 0 ? diffDays : 0;
    }

