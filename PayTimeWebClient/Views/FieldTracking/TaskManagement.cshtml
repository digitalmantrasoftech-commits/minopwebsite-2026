    // Filter tasks by date range
    function filterTasksByDateRange(tasks, fromDate, toDate) {
        return tasks.filter(function(task) {
            var taskDate = new Date(task.taskDate);
            return taskDate >= fromDate && taskDate <= toDate;
        });
    }


