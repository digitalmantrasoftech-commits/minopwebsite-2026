                                        <div class="col-sm-4">
                                            <div style="margin-bottom: 15px;">
                                                <h6>Photos (<span id="detailPhotoCount">0</span>)</h6>
                                                <div id="detailProofPhotos" style="display: flex; gap: 10px; flex-wrap: wrap;"></div>
                                            </div>
                                        </div>
                                        <!-- Signature -->
                                        <div class="col-sm-8">
                                            <div style="margin-bottom: 15px;">
                                                <h6>Customer Signature</h6>
                                                <div id="detailProofSignature" style="border: 1px solid #ddd; padding: 10px; background: white; min-height: 80px; border-radius: 4px;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-12">
                                            <!-- Completion Notes -->
                                            <div>
                                                <h6>Task Completion Notes</h6>
