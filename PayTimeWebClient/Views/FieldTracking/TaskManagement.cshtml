        var cmpId = parseInt(_CmpId);
        var branchId = parseInt(_BranchId);
        // Status-specific actions only (no common view button for all)
        switch(task.status) {
            case 'pending':
            case 'overdue':
            case 'Overdue':
                // Start button: Show if assigned to me AND task date is today
                //if (task.assignedToEmpId === currentEmployeeId && isToday(task.taskDate)) {
                //    buttons += '<a class="btn seagreen_btnnew tooltips" data-placement="left" data-original-title="Start Task" onclick="startTask(\'' + task.id + '\')">';
