    // Load My Today's Tasks with route optimization
    function loadMyTodaysTasks() {
        var today = new Date().toISOString().split('T')[0];
        var currentEmployeeId = parseInt(_EmpId);

        // Show loading message
        $('#myTodaysTasksBody').html('<tr><td colspan="8" style="text-align: center;"><i class="fa-regular fa-spinner fa-spin"></i> Loading your tasks...</td></tr>');

        // Get user's current location first
        getCurrentLocation(
            function(location) {
                // Make API call to get tasks assigned to me for today
                $.ajax({
                    url: _webapifieldtrackingurl + 'taskmanagement/all',
                    type: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + _tokan,
                        'Content-Type': 'application/json'
                    },
                    data: {
                        fromDate: today,
                        toDate: today,
                        assignedToEmpId: currentEmployeeId,
                        pageSize: 1000
                    },
                    success: function(response) {
                        if (response.success && response.data && response.data.length > 0) {
                            // Calculate distances and sort by proximity
                            var tasksWithDistance = response.data.map(function(task) {
                                if (task.latitude && task.longitude) {
                                    var distance = calculateDistance(
                                        location.lat,
                                        location.lng,
                                        task.latitude,
                                        task.longitude
                                    );
                                    task.distanceMeters = distance;
                                    task.distanceFormatted = formatDistance(distance);
                                } else {
                                    task.distanceMeters = Number.MAX_VALUE; // Put tasks without location at the end
                                    task.distanceFormatted = 'N/A';
                                }
                                return task;
                            });

                            // Sort by distance (nearest first)
                            tasksWithDistance.sort(function(a, b) {
                                return a.distanceMeters - b.distanceMeters;
                            });

                            // Show table, hide empty state
                            $('#tableResponsivetask').show();
                            $('#myTodaysTasksEmpty').hide();
                            displayMyTodaysTasks(tasksWithDistance);
                        } else {
                            // Hide table, show empty state
                            $('#tableResponsivetask').hide();
                            $('#myTodaysTasksEmpty').show();
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error loading my today\'s tasks:', error);
                        // Hide table, show empty state
                        $('#tableResponsivetask').hide();
                        $('#myTodaysTasksEmpty').show();
                        toastr.error('Failed to load your tasks');
                    }
                });
            },
            function(error) {
                // If location fails, still load tasks but without distance sorting
                $.ajax({
                    url: _webapifieldtrackingurl + 'taskmanagement/all',
                    type: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + _tokan,
                        'Content-Type': 'application/json'
                    },
                    data: {
                        fromDate: today,
                        toDate: today,
                        assignedToEmpId: currentEmployeeId,
                        pageSize: 100
                    },
                    success: function(response) {
                        if (response.success && response.data && response.data.length > 0) {
                            var tasksWithoutDistance = response.data.map(function(task) {
                                task.distanceFormatted = 'Location unavailable';
                                return task;
                            });
                            // Show table, hide empty state
                            $('#tableResponsivetask').show();
                            $('#myTodaysTasksEmpty').hide();
                            displayMyTodaysTasks(tasksWithoutDistance);
                        } else {
                            // Hide table, show empty state
                            $('#tableResponsivetask').hide();
                            $('#myTodaysTasksEmpty').show();
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error loading tasks:', error);
                        // Hide table, show empty state
                        $('#tableResponsivetask').hide();
                        $('#myTodaysTasksEmpty').show();
                    }
                });
            }
        );
    }

