                                            <div class="ttl"><div>Time:</div> <span id="detailCheckOutTime"></span></div>
                                            <div class="ttl"><div>Location:</div> <span id="detailCheckOutLocation"></span></div>
                                            <div class="ttl"><div>Coordinates:</div> <span id="detailCheckOutCoords"></span></div>
                                            <div class="ttl" style="margin-bottom: 0;"><div>Actual Duration:</div> <span id="detailActualDuration"></span></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Proof of Work (only for completed tasks) -->
                                <div id="proofOfWorkSection" class="modal-card">
