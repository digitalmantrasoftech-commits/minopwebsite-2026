    // Render action buttons in modal footer
    function renderTaskDetailActions(task) {
        var html = '';
        var currentUserId = parseInt(_UserId);
        var currentEmployeeId = parseInt(_EmpId);
        var roleId = parseInt(_RoleId);

        // Edit button (if pending and user created it or is admin)
        if (task.status === 'Pending' && ((task.assignedByUserId === currentUserId) || roleId === 1 || roleId === 6805 || roleId === 6806)) {
            html += '<button type="button" class="btn btn-minop btn-minop-primary" onclick="editTaskFromDetails(' + task.taskId + ')">';
            html += '<i class="fa-regular fa-pen-to-square"></i> Edit Task</button> ';
        }

        // Overdue task actions (Admin/Manager/Creator can Edit and Delete)
        if (task.status === 'Overdue') {
            var isAuthorized = (roleId === 1 || roleId === 6805 || roleId === 6806 || task.assignedByUserId === currentUserId);

            if (isAuthorized) {
                html += '<button type="button" class="btn btn-minop orange_btnnew" onclick="editTaskFromDetails(' + task.taskId + ')" title="Edit Overdue Task - Reassign, Reschedule or Adjust">';
                html += '<i class="fa-regular fa-pen-to-square"></i> Edit Task</button> ';

                html += '<button type="button" class="btn btn-minop red_btnnew" onclick="deleteTaskFromDetails(' + task.taskId + ')" title="Cancel/Delete Task">';
                html += '<i class="fa-regular fa-trash-can"></i> Delete Task</button> ';
            }
        }

        // Start button (if pending and assigned to me)
        if (task.status === 'Pending' && task.assignedToEmpId === currentEmployeeId && isToday(task.taskDate)) {
            html += '<button type="button" class="btn btn-minop btn-minop-success" onclick="startTaskFromDetails(' + task.taskId + ')">';
            html += '<i class="fa-regular fa-play"></i> Start Task</button> ';
        }

        $('#taskDetailActions').html(html);
    }

