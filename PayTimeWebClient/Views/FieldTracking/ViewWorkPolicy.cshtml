<script>
        var policyId = null;
        var _webapiurl = '@_webapifieldtrackingurl';
        var _tokan = '@_tokan';

        $(document).ready(function() {
            // Get policy ID from URL
            var urlParams = new URLSearchParams(window.location.search);
            policyId = urlParams.get('id') || window.location.pathname.split('/').pop();

            if (policyId) {
                loadPolicyDetails(policyId);
            } else {
                alert('No policy ID provided');
                window.location.href = '/FieldTracking/WorkPolicy';
            }
        });

        function loadPolicyDetails(id) {
            // Show loading state
            $('#policyNameHeader').html('<i class="fa-thin fa-spinner fa-spin"></i> Loading...');

            // Make direct API call
            $.ajax({
                url: _webapiurl + "workpolicy/" + id,
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                headers: {
                    "Authorization": _tokan
                },
                success: function(response) {
                    if (response && response.success && response.data) {
                        populatePolicyDetails(response.data);
                    } else if (response && response.data) {
                        // Handle case where success flag might be missing
                        populatePolicyDetails(response.data);
                    } else {
                        alert('Policy not found');
                        window.location.href = '/FieldTracking/WorkPolicy';
                    }
                },
                error: function(xhr, status, error) {
                    console.error("Error loading policy:", error);
                    if (xhr.status === 401) {
                        alert('Session expired. Please login again.');
                        window.location.href = '/PayTime/LoginPage';
                    } else {
                        alert('Error loading policy details');
                        window.location.href = '/FieldTracking/WorkPolicy';
                    }
                }
            });
        }

        function populatePolicyDetails(policy) {
            // Header - using camelCase property names to match API response
            $('#policyNameHeader').text(policy.policyName || 'Unnamed Policy');

            // Employment Settings
            //$('#viewEmpWeekOff').text(getDayName(policy.empWeekOff));
            //$('#viewEmpSecondWeekOff').text(getDayName(policy.empSecondWeekOff));
            //$('#viewEmpSecondWeekOffRule').text(formatWeekRules(policy.empSecondWeekOffRule));
            //$('#viewEmpHalfDay').text(getDayName(policy.empHalfDay));
            //$('#viewEmpHalfDayRule').text(formatWeekRules(policy.empHalfDayRule));

            //// Overtime Settings
            //$('#viewOTMinHour').text(policy.otMinHour || 0);
            //$('#viewOTAllowWO').html(policy.otAllowWO === true || policy.otAllowWO === 1 ?
            //    '<span class="badge badge-success">Yes</span>' :
            //    '<span class="badge badge-danger">No</span>');
            //$('#viewWeekOffOTHour').text(policy.weekOffOTHour || 0);
            //$('#viewOTAllowHO').html(policy.otAllowHO === true || policy.otAllowHO === 1 ?
            //    '<span class="badge badge-success">Yes</span>' :
            //    '<span class="badge badge-danger">No</span>');
            //$('#viewHolidayOffOTHour').text(policy.holidayOffOTHour || 0);

            // Field Sense Configuration
            $('#viewDefaultRadius').text(policy.defaultRadius || 100);
            $('#viewLocationUpdateFrequency').text(policy.locationUpdateFrequency || 5);
            $('#viewEmpCanCreateTask').html(policy.empCanCreateTask ?
                '<span class="badge badge-success">Enabled</span>' :
                '<span class="badge badge-danger">Disabled</span>');
            $('#viewAutoCheckIn').html(policy.autoCheckIn ?
                '<span class="badge badge-success">Enabled</span>' :
                '<span class="badge badge-danger">Disabled</span>');
            $('#viewProofOfWork').text(getProofOfWorkText(policy.proofOfWork));

            // Status
            if (policy.isActive) {
                $('#viewIsActive').text('Active');
                $('#statusIndicator').addClass('active');
            } else {
                $('#viewIsActive').text('Inactive');
                $('#statusIndicator').addClass('inactive');
            }
        }

        function formatWeekRules(ruleString) {
            if (!ruleString || ruleString === '0') {
                return 'Not Set';
            }
            var rules = ruleString.split(',');
            var weekNames = [];
            rules.forEach(function(rule) {
                switch(rule) {
                    case '1': weekNames.push('1st Week'); break;
                    case '2': weekNames.push('2nd Week'); break;
                    case '3': weekNames.push('3rd Week'); break;
                    case '4': weekNames.push('4th Week'); break;
                    case '5': weekNames.push('5th Week'); break;
                }
            });
            return weekNames.length > 0 ? weekNames.join(', ') : 'Not Set';
        }

        function getDayName(dayValue) {
            var days = {
                0: 'None',
                1: 'Sunday',
                2: 'Monday',
                3: 'Tuesday',
                4: 'Wednesday',
                5: 'Thursday',
                6: 'Friday',
                7: 'Saturday'
            };
            return days[dayValue] || 'Not Set';
        }

        function getProofOfWorkText(value) {
            switch(value) {
                case 0: return 'None';
                case 1: return 'Photo Required';
                case 2: return 'Signature Required';
                case 3: return 'Photo + Signature Required';
                case 4: return 'OTP Verification';
                default: return 'Not Configured';
            }
        }

        function editPolicy() {
            if (policyId) {
                window.location.href = '/FieldTracking/WorkPolicy?edit=' + policyId;
            }
        }

        function goBack() {
            window.location.href = '/FieldTracking/WorkPolicy';
        }
</script>