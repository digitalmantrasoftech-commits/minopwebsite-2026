            font-weight: 500;
        }

        .policy-header .policy-name {
            font-size: 16px;
            margin-top: 5px;
        }

    .policy-section {
        padding: 16px;
        border-bottom: 1px solid #e0e0e0;
    }

        .policy-section:last-child {
            border-bottom: none;
        }

    .section-title {
        font-size: 18px;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #667eea;
    }

    .field-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .field-row:last-child {
            border-bottom: none;
        }

    .field-label {
        font-weight: 500;
        color: #666;
        flex: 1;
    }

    .field-value {
        color: #333;
        flex: 1;
        text-align: right;
    }

        .field-value.active {
            color: #4caf50;
            font-weight: 500;
        }

        .field-value.inactive {
            color: #f44336;
            font-weight: 500;
        }

    .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-success {
        background: #d4edda;
        color: #155724;
    }

    .badge-danger {
        background: #f8d7da;
        color: #721c24;
    }

    .badge-primary {
        background: #d1ecf1;
        color: #0c5460;
    }

    .action-buttons {
        padding: 10px;
        text-align: center;
        background: #f8f9fa;
        border-radius: 0 0 8px 8px;
    }

    .status-indicator {
        display: inline-flex;
        align-items: center;
    }

        .status-indicator .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-right: 8px;
        }

        .status-indicator.active .dot {
            background: #4caf50;
        }

        .status-indicator.inactive .dot {
            background: #f44336;
        }
</style>

