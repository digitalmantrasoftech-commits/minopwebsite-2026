
@model PayTimeWebClient.Models.Notifications_Module.NotificationDetailsViewModel
@{
    Layout = null;
}
<html>
<head>
    <meta charset="utf-8" />
    <title>Notification Details</title>
    <style>
        /*   body {
            font-family: 'Roboto', sans-serif !important;
            font-weight: 400;
            letter-spacing: 0.2px;
        }

        .table-bordered th, .table-bordered td {
            border: 1px solid #ddd !important;
        }

        .section-title {
            font-weight: 600;
            font-size: 18px;
            margin: 20px 0 10px;
            color: #2c3e50;
        }*/
    </style>
</head>


<body>
    <div>
        <!-- HEADER: Logo and Title -->
        <div class="d-flex justify-content-between align-items-center margin-bottom-15">
            <img src="~/AssetsNew/images/logo.png" alt="Logo" style="width: 180px; height: auto;">
            <img src="~/Newlayout/images/NofificationImage.png" alt="Header" style="height: 50px;">
        </div>

        <!-- NOTIFICATION RULE DETAILS -->
        @if (Model.Table1 != null && Model.Table1.Any())
        {
            var rule = Model.Table1.First();
            <div class="d-flex justify-content-between margin-bottom-20">
                <div class="">
                    <div><strong>Rule Name:</strong> @rule.RuleName</div>
                    <div><strong>Event Name:</strong> @rule.EventName</div>
                    <div><strong>Recipient Type:</strong> @rule.Recipients</div>
                </div>
                <div class="">
                    <div><strong>Description:</strong> @rule.Description</div>
                    <div><strong>Template Name:</strong> @rule.TemplateName</div>
                    <div><strong>Recipient Name:</strong> @rule.Recipients</div>
                </div>

                @*<div class="row mb-2">
                        <div class="col-md-6"><strong>Rule Name:</strong> @rule.RuleName</div>
                        <div class="col-md-6"><strong>Description:</strong> @rule.Description</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6"><strong>Event Name:</strong> @rule.EventName</div>
                        <div class="col-md-6"><strong>Template Name:</strong> @rule.TemplateName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6"><strong>Recipient Type:</strong> @rule.Recipients</div>
                        <div class="col-md-6"><strong>Recipient Name:</strong> @rule.Recipients</div>
                    </div>*@
            </div>
        }

        <!-- CONDITION RULE TABLE -->
        @if (Model.Table2 != null && Model.Table2.Any())
        {
            <div>
                <h5>Condition Rule Details</h5>
                <table class="table table-bordered table-striped table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Field Name</th>
                            <th>Operator</th>
                            <th>Value</th>
                           
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cond in Model.Table2)
                        {
                        <tr>
                            <td>@cond.FieldName</td>
                            <td>@cond.OperatorName</td>
                            <td>@cond.FieldValue</td>
                           
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- ESCALATE RULE TABLE -->
        @if (Model.Table3 != null && Model.Table3.Any())
        {
            <div>
                <h5>Escalate Rule Details</h5>
                <table class="table table-bordered table-striped table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Escalate Hours</th>
                            <th>Escalate To Role Type</th>
                            <th>Escalate Role Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var esc in Model.Table3)
                        {
                            <tr>
                                <td>@esc.EscalateHours</td>
                                <td>@esc.EscalateToRoleType</td>
                                <td>@esc.EscalateRoleName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</body>
</html>
