
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@model PayTimeWebClient.Models.Notifications_Module.NotificationTemplateModel
@{
    ViewBag.Title = "Template Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = string.Empty;
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    string _branchid = string.Empty;
    if (_RoleId == 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
    }
    if (_RoleId > 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    string _CountryCode = HttpContext.Current.Session["CountryCode"].ToString();
    string _AreaCode = HttpContext.Current.Session["AreaCode"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();

    Int64 _DatagridThsold = 0;

    _DatagridThsold = Convert.ToInt64(HttpContext.Current.Session["DataGridThresold"]);
    string _empid = "0";
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
 ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
 : "false"; // Default to "false" if the session is null

}
<script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<script>
    $(document).ready(function () {
        // TinyMCE Initialization
        tinymce.init({
            selector: '.wysiwyg-editor',
            height: 300,
            menubar: false,
            plugins: 'lists link image table code preview',
            toolbar: 'undo redo | formatselect | bold italic underline | alignleft aligncenter alignright | bullist numlist outdent indent | link image | code preview',
            branding: false
        });

        // Modal trigger
        $("#TemplateMaster_btn").on('click', function () {
            $("#TemplateMaster_btn").attr("data-toggle", "modal");
            $("#TemplateMaster_btn").attr("data-target", "#frmpopupTemplate");
        });
    });
</script>
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {

        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Template Master</span>
            </li>
        </ul>
        <div class="page-toolbar">
            <a href="javascript:void(0)" id="TemplateMaster_btn" class="btn icon_btn tooltips" data-placement="left" data-original-title="Template Master"><i class="fa-solid fa-plus"></i></a>
        </div>
    }
</div>
<div class="row">
    <div id='ajax_loaderNotificationRule' class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" />
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="portlet">
            <div class="row">
                <div class="portlet-body">
                    <div class="res_table_box">
                        <table id="tblTemplateMasterDetails" class="table table-striped table-bordered table-hover serch_datatable table-checkable order-column"></table>
                    </div>
                    <div id="frmpopupTemplate" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                        <div class="modal-dialog">
                            <!-- Modal content-->
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Template Rule</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="modal-card">
                                        <fieldset>
                                            @using (Html.BeginForm("TemplateEditor", "Notification", FormMethod.Post, new { id = "frmpopupTemplate" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <div style="border: 1px dashed gray; padding: 10px;">
                                                    <div>
                                                        <label>Placeholders:</label>
                                                        @foreach (var placeholder in Model.Placeholders)
                                                        {
                                                            <span>@placeholder</span>
                                                        }
                                                        <span> | </span>

                                                        <label>Language:</label>
                                                        @Html.DropDownListFor(m => m.Language, Model.LanguageOptions, "-- Select --", new { @class = "form-control d-inline w-auto" })
                                                        <button type="button" class="btn btn-link">[+ Add]</button>
                                                        @Html.ValidationMessageFor(m => m.Language, "", new { @class = "text-danger" })
                                                    </div>
                                                    <br />
                                                    <div>
                                                        <label>Subject:</label><br />
                                                        @Html.TextBoxFor(m => m.Subject, new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(m => m.Subject, "", new { @class = "text-danger" })
                                                    </div>
                                                    <br />
                                                    <div>
                                                        <label>Body:</label><br />
                                                        @Html.TextAreaFor(m => m.Body, new { @class = "form-control wysiwyg-editor", rows = 8 })
                                                        @Html.ValidationMessageFor(m => m.Body, "", new { @class = "text-danger" })
                                                    </div>
                                                    <br />
                                                </div>
                                            }
                                        </fieldset>
                                        @if (ViewBag.PreviewHtml != null)
                                        {
                                            <hr />
                                            <h4>Preview:</h4>
                                            <div class="preview-box" style="border: 1px solid #ccc; padding: 15px;">
                                                @Html.Raw(ViewBag.PreviewHtml)
                                            </div>

                                            <script>
                                                $(document).ready(function () {
                                                    $('#frmpopupTemplate').modal('show');
                                                });
                                            </script>
                                        }
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <div class="text-right">
                                        <button type="submit" name="action" value="preview" class="btn btn-secondary">Preview</button>
                                        <button type="submit" name="action" value="sendtest" class="btn btn-info">Send Test</button>
                                        <button type="submit" name="action" value="save" class="btn btn-success">Save</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
