            //}
            var _notifyID = $("#NotificationRuleID").val();
            var _mode = "Add";
            if (_notifyID != 0)
            {
                _mode="Update";
            }
            var objNoti =
            {

                NotifiId:$("#NotificationRuleID").val(),
                Mode: _mode,
                RuleName: $("#RuleName").val(),
                Description: $("#RuleDescription").val(),
                EventID: parseInt($("#EventID").val()),
                TemplateID: parseInt($("#TemplateID").val()),
                RecipientRoleType: $("#RecipientToRoleID").val(),
                RecipientRoleId: $("#RecipientRoleName").val(),
                ChannelInAppID: $("#channelInApp").prop("checked"),
                ChannelsEmailID: $("#channelEmail").prop("checked"),
                ChannelPushID: $("#channelPush").prop("checked"),
                IsActive: $("#IsActive").prop("checked"),
                CreatedByID: 1,
                IsMandatory: true,
                NotificationConRule: [], // Fixed typo
                NotificationEscalateRule: [] // Placeholder for escalation rules
            };
           

            // Loop through all possible containers
            const maxContainers = 3; // If you have 3 containers (0, 1, 2)

            for (let i = 0; i < maxContainers; i++)
            {
                let containerId = i === 0 ? "#conditionsContainer" : `#conditionsContainer_${i}`;
                let $container = $(containerId);

                if ($container.length && $container.find(".condition-group").length > 0)
                {

                    $container.find(".condition-group").each(function (groupIndex)
                    {

                        let $group = $(this);

                        // Use index-based ID selectors
                        var field = $group.find(`#ConditionField_${i}`).val();
                        var operator = $group.find(`#ConditionOperator_${i}`).val();
                        var value = $group.find(`#ConditionValue_${i}`).val(); // or input field
                        var leaveType = $group.find(`#ConditionLeaveType_${i}`).val() || 0;
                        var status = $group.find(`#Status_${i}`).val() || 0;

                        //if (field && operator && value)
                        if (objNoti.NotificationConRule != null && objNoti.NotificationConRule != [] && (field != null && operator != null))
                        {
                            objNoti.NotificationConRule.push(
                            {
                                Index: i,
                                Field: field,
                                Operator: operator,
                                Value: value,
                                LeaveTypeID: leaveType,
                                StatusID: status
                            });
                        }
                    });
                }
            }

            $("#EscalateContainer .condition-group").each(function ()
            {
                var selectedRoles = $(this).find("select[name='EscalateRoleName']").val() || [];
                var escalateToRoleIDs = selectedRoles.join(',');

                var escalate =
                {
                    EscalateHours: $(this).find("select[name='EscalateHoursID']").val(),
                    EscalateToRoleID: $(this).find("select[name='EscalateToRoleID']").val(),
                    //EscalateRoleName: $(this).find("select[name='EscalateRoleName']").val()
                    EscalateRoleName: escalateToRoleIDs,
