    function updateNotiFicationStatus(flag, _notificationId)
    {

        var annouceid = _notificationId;

        const params = new URLSearchParams({
            flag: flag,
            notificationruleid: annouceid
        });
        const urlWithQuery = `${'@_webapiurl'}Alert/UpdateStatus?${params.toString()}`;
        $.ajax({
            type: "POST",
            url: urlWithQuery,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function (xhr) {
                xhr.setRequestHeader("Authorization",'@_tokan');
            },
            success: function (data)
            {
                if (data.isRedirect)
                {
                    window.location.href = data.redirectUrl;
                } else {
                    if (flag == 0) {
                        toastr.error("Notification Inactive Successfully.")
                    } else {
                        toastr.success("Notification Active Successfully.")
                    }
                }
            },
            error: function ()
            {
                console.log("Error in Fillactivity_Checkin.");
            }
        });
    }

