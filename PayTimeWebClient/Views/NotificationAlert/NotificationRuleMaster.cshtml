        $('#addRecipientBtn').on('click', function ()
        {
            function isGroupFilled(containerSelector)
            {
                let isFilled = true;
                $(`${containerSelector} :input`).each(function () {
                    const type = $(this).attr('type');
                    if ((type !== 'hidden') && ($(this).val() === '' || $(this).val() === '0')) {
                        isFilled = false;
                        return false; // exit loop
                    }
                });
                return isFilled;
            }

            if ($('#conditionsContainer_1').css('display') === 'none') {
                if (isGroupFilled('#conditionsContainer')) {
                    $('#conditionsContainer_1').show();

                    // Bind data
                    ConditionFieldDataBindForEventMasterwise(1, 'Leave', 1, 1);
                    GetBindLeaveStatusDetails(1, 1);
                }
                else
                {
                    alert("Please fill all the fields in the first condition before adding a new one.");
                }
            } else if ($('#conditionsContainer_2').css('display') === 'none') {
                if (isGroupFilled('#conditionsContainer') && isGroupFilled('#conditionsContainer_1')) {
                    $('#conditionsContainer_2').show();

                    // Bind data
                    ConditionFieldDataBindForEventMasterwise(1, 'Leave', 1, 2);
                    GetBindLeaveStatusDetails(1, 2);

                    // Disable the add button
                    $('#addRecipientBtn').prop('disabled', true);
                } else {
                    alert("Please fill all the fields in both previous conditions before adding a new one.");
                }
            }

            // Show remove button if at least one extra condition is visible
            if ($('#conditionsContainer_1').is(':visible') || $('#conditionsContainer_2').is(':visible')) {
                $('#removeConditionBtn').show();
            }
        });

        // Remove last condition group

        $('#removeConditionBtn').on('click', function ()
