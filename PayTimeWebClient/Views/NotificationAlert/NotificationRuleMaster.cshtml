        $("#btnnotificationRule").click(function ()
        {
            checkSession();
            event.stopPropagation();
            event.preventDefault();

            if ($("#RuleName").val().trim() == "") {
                $("#RuleName").addClass('field_error');
                $("#RuleName").focus();
                event.preventDefault();
