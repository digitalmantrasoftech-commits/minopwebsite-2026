            }
            if ($("#EventID").val().trim() == "0")
            {
                toastr.remove();
                toastr.error("Please select Event.");
                $("#EventID").focus();
                event.preventDefault();
                return false;
            }
            if ($("#TemplateID").val().trim() == "0") {
                toastr.remove();
