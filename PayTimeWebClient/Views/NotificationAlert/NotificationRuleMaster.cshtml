        var maxEscalate = 3;


        $('#addEscalateBtn').click(function ()
        {

            var maxConditions = 3;
            var currentConditions = $('#EscalateContainer .condition-group');
            var currentCount = currentConditions.length;

            var isAnyEmpty = false;

            currentConditions.each(function () {
                $(this).find('input, select').each(function () {
                    if (!$(this).val()) {
                        isAnyEmpty = true;
                        $(this).addClass('input-error');
                    } else {
                        $(this).removeClass('input-error');
                    }
                });
            });

            if (isAnyEmpty) {
                alert('Please fill all fields in existing Escalate before adding a new one.');
                return;
            }

            if (currentCount < maxConditions) {
                // Clone raw HTML (not with Select2 DOM)
                var rawHTML = $('#EscalateContainer .condition-group:first')[0].outerHTML;
                var $clone = $(rawHTML);

                // Clear values
                $clone.find('input').val('');
                $clone.find('select').val('');
                $clone.find('.input-error').removeClass('input-error');

                // Remove Select2 DOM and attributes
                $clone.find('select.select2').each(function () {
                    $(this).removeAttr('data-select2-id tabindex aria-hidden')
                        .removeClass('select2-hidden-accessible')
                        .next('.select2').remove(); // Remove appended Select2 HTML
                });

                // Append clone
                $('#EscalateContainer').append($clone);

                // Reinitialize Select2 for new selects
                $clone.find('select.select2').select2();
                $('#removeEscalateBtn').css('display', 'block');
            }
            else
            {
                alert('You can add up to 3 Escalate only.');
            }
        });





        $('#removeEscalateBtn').click(function ()
        {
            var currentCount = $('#EscalateContainer .condition-group').length;
            if (currentCount > 1) {
                $('#EscalateContainer .condition-group').last().remove();
            }
            $('#removeEscalateBtn').css('display', 'none');
