        $("#RuleName").keypress(function (e)
        {
            $("#RuleName").removeClass('field_error');
            // Get the ASCII code of the key pressed
            var charCode = e.which;

            // Allow: Backspace (8), Space (32), 0-9 (48–57), A-Z (65–90), a-z (97–122)
            if (
                charCode === 8 ||
                charCode === 32 ||
                (charCode >= 48 && charCode <= 57) ||
                (charCode >= 65 && charCode <= 90) ||
                (charCode >= 97 && charCode <= 122)
            )
            {
                return true;
            }
            else
            {
                return false;
            }
        });

