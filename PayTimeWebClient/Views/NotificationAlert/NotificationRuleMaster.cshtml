    function GetAllNotificatioConditinalRuleDetails(notifyID,EventIDTem,_ModuleName)
    {

        var _URL = '@_webapiurl' + 'Alert/GetAllNotificationRulesDetailsData?NotifyID=' + notifyID;
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: _URL,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify({ NotifyID: notifyID }),
            beforeSend: function () {
                $("#ajax_loaderbranch").show();
            },
            success: function (response)
            {
                $("#ajax_loaderbranch").hide();
                // First container
                if (response.Table1 && response.Table1.length > 0)
                {
                    $('#conditionsContainer .condition-group:gt(0)').remove(); // remove all except the first
                    var firstGroup = $('#conditionsContainer .condition-group:first');



                    var $conditionOperator = "";
                    var $ddlLeaveType = "";
                    var $ddlStatus = "";
                    var $ConditionValue = "";
                    var $ConditionOperatorField = "";



                    $.each(response.Table1, function (index, item)
                    {
                        var containerIndex = item.Index || index;
                        let containerId = index === 0 ? "#conditionsContainer" : `#conditionsContainer_${index}`;
                        let $container = $(containerId);

                        // If container does not exist in DOM, clone from a base hidden template
                        if ($container.length === 0) {
                            let $clone = $('#conditionsContainer_1').clone();
                            $clone.prop('id', `conditionsContainer_${index}`);
                            $clone.find('.condition-group').attr('data-index', index);
                            $container.removeAttr("style"); // removes inline style like display:none
                            $container.show(); // ensures it’s visible
                            $('#conditionsContainer').after($clone);
                            $container = $clone;
                            $container.css('display', 'block');

                        } else {
                            $container.show(); // Make it visible
                        }

                        let $group = $container.find(".condition-group").first();

                        // Clear any old data
                        $group.find('input, select').val('');

                        // Set IDs and names dynamically
                        $group.find('[id^="ConditionField_"]').attr("id", `ConditionField_${index}`).attr("name", `ConditionField_${index}`).val(item.FieldName).trigger('change.select2');
                        $group.find('[id^="ConditionOperator_"]').attr("id", `ConditionOperator_${index}`).attr("name", `ConditionOperator_${index}`).val(item.Operator);
                        $group.find('[id^="ConditionValue_"]').attr("id", `ConditionValue_${index}`).attr("name", `ConditionValue_${index}`).val(item.FieldValue);
                        $group.find('[id^="ConditionLeaveType_"]').attr("id", `ConditionLeaveType_${index}`).attr("name", `ConditionLeaveType_${index}`).val(item.LeaveTypeID).trigger('change.select2');
                        $group.find('[id^="Status_"]').attr("id", `Status_${index}`).attr("name", `Status_${index}`).val(item.StatusID);


                        // Set visibility based on your logic (example below)
                        $(`#ddlConditionOperator_${containerIndex}`).show();
                        $(`#ddlConditionValue_${containerIndex}`).show();
                        $(`#ddlConditionLeaveType_${containerIndex}`).toggle(!!item.LeaveTypeID);
                        $(`#ddlStatus_${containerIndex}`).toggle(!!item.StatusID);

                        ConditionFieldDataBindForEventMasterwise(EventIDTem, _ModuleName, 1, containerIndex, item.FieldName);
                        GetBindLeaveStatusDetails(item.LeaveTypeID, containerIndex);

                    });                   

                    // Optional: show remove button if more than 1 condition
                    if (response.Table1.length > 1)
                    {
                        $('#removeConditionBtn').show();
                    }
                    else
                    {
                        $('#removeConditionBtn').hide();
                    }
                }


                if (response.Table2 && response.Table2.length > 0)
                {
                    $('#EscalateContainer .condition-group:gt(0)').remove(); // Remove all except first
                    var firstEscalateGroup = $('#EscalateContainer .condition-group:first');


                    $.each(response.Table2, function (index, item) {
                        var groupnew;

                        $("#EscalationRuleID").val(item.EscalationRuleID);

                        if (index === 0) {
                            groupnew = firstEscalateGroup;
                        } else {
                            groupnew = firstEscalateGroup.clone();
                            groupnew.find('select').val('');
                            $('#EscalateContainer').append(groupnew);
                        }

                        // Set values
                        groupnew.find('[name="EscalateHoursID"]').val(item.EscalateHours || '');
                        groupnew.find('[name="EscalateToRoleID"]').val(item.EscalateToRoleTypeID || '');
                        groupnew.find('[name="EscalateRoleName"]').val(item.EscalateRoleNameID || '');
                        groupnew.find('[name="EMaxattemptsID"]').val(item.MaxAttempts || '');



                        $("#EscalateToRoleID option[value ='" + item.EscalateToRoleTypeID + "']").prop('selected', true);
                        $('#EscalateToRoleID').trigger('change.select2');

                        EmployeeBindRoleWiseData(item.EscalateToRoleTypeID, 2, item.EscalateRoleNameID)

                        //$("#EscalateRoleName option[value ='" + item.EscalateRoleNameID + "']").prop('selected', true);
                        //$('#EscalateRoleName').trigger('change.select2');
                    });
                }

            },
            error: function (err) {
                $("#ajax_loaderbranch").hide();
                console.error("Error fetching details", err);
            }
        });
    }

    function GetBindLeaveStatusDetails(LeaveTypeID,index)
    {
        //$('#ConditionLeaveType').empty();
        const $select = $(`#ConditionLeaveType_${index}`);
        $select.empty();

            var rId = 0;
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + "Master/LeaveTypeMasterGetAll",
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                beforeSend: function ()
                {
                    $("#ajax_loaderNotificationRule").show();
                },
                success: function (response)
                {
                    if (response.isRedirect)
                    {
                        window.location.href = response.redirectUrl;
                    }
                    if (response != null)
                    {
                        //$("#ConditionLeaveType").append("<option value='0' selected>Select Leave</option>");
                        $select.append("<option value='0' selected>Select Leave</option>");
                        response.sort(function (a, b)
                        {
                            return a.LeaveTypeName.localeCompare(b.LeaveTypeName);
                        });
                        //for (var i = 0; i < response.length; i++)
                        //{
                        //    if (RoleId == 1 || RoleId == 6805 || RoleId == 6806)
                        //    {
                        //        $("#ConditionLeaveType").append("<option value='" + response[i].LeaveTypeId + "'>" + response[i].LeaveTypeName + "</option>");
                        //    }
                        //}
                        for (var i = 0; i < response.length; i++)
                        {
                            $select.append("<option value='" + response[i].LeaveTypeId + "'>" + response[i].LeaveTypeName + "</option>");
                        }
                        // Reinitialize Select2 to reflect new options
                        //$select.select2({
                        //    width: '100%',
                        //    placeholder: 'Select an option'
                        //});
                        $select.select2({ width: '100%', placeholder: 'Select an option' });

                    }
                    if (LeaveTypeID != null & LeaveTypeID != 0)
                    {
                        //$("#ConditionLeaveType option[value ='" + LeaveTypeID + "']").prop('selected', true);
                        //$('#ConditionLeaveType').trigger('change.select');
                        $select.val(LeaveTypeID).trigger('change');
                    }
                    else
                    {
                        $select.val('0').trigger('change');
                    }
                    $("#ajax_loaderNotificationRule").hide();
                },
                error: function ()
                {
                    $("#ajax_loaderNotificationRule").hide();
                }
            });
    }

