    function SavenotificationRuleConfig()
    {
        checkSession();
        if ($("#RuleTitle").val().trim() == "")
        {
            $("#RuleTitle").addClass('field_error');
            $("#RuleTitle").focus();
            event.preventDefault();
            return false;
        }
        else
        {
            $("#RuleTitle").removeClass('field_error');
        }
        if ($("#Description").val().trim() == "" || $("#Description").val() == 0) {
            $("#Description").addClass('field_error');
            $("#Description").focus();
            event.preventDefault();
            return false;
        }
        else
        {
            $("#Description").removeClass('field_error');
        }
        if ($("#ddleventmodulewise").val().trim() == "" || $("#ddleventmodulewise").val() == 0)
        {
            toastr.remove();
            toastr.error("Please select Event.");
            $("#ddleventmodulewise").focus();
            event.preventDefault();
            return false;
        }
        else
        {
            $("#ddleventmodulewise").removeClass('field_error');
        }

        if ($("#Operator").val().trim() == "" || $("#Operator").val() == 0)
        {
            toastr.remove();
            toastr.error("Please select Operator.");
            $("#Operator").focus();
            event.preventDefault();
            return false;
        }
        else
        {
            $("#Operator").removeClass('field_error');
        }
        if ($("#Value").val().trim() == "" || $("#Value").val() == 0) {
            $("#Value").addClass('field_error');
            $("#Value").focus();
            event.preventDefault();
            return false;
        }
        else {
            $("#Value").removeClass('field_error');
        }
        var _RuleConfigID = $("#RuleConfigID").val();
        var _mode = "INSERT";
        if (_RuleConfigID != 0)
        {
            _mode = "UPDATE";
        }
        var ruleData =
        {
            RuleID:$("#RuleConfigID").val(),
            Mode: _mode,
            RuleTitle: $("#RuleTitle").val(),
            Description: $("#Description").val(),
            Event: $("#ddleventmodulewise").val(),
            Operator: $("#Operator").val(),
            Value: $("#Value").val(),

            // In-App Notification
            InAppNotification: $("#inAppCheck").is(":checked"),
            InAppDay: $("#InAppDay").val(),
            InAppRepeat: $("#InAppRepeat").val(),
            InAppReminderFrequency: $("#InAppReminder").val(),
            InAppReportingTo: $("#InAppReporting").val(),
            InAppCC: $("#InAppReportingCC").val(),
            InAppStartTime: $("#InAppStartTime").val(),

            // Email Notification
            EmailNotification: $("#emailCheck").is(":checked"),
            EmailDay: $("#EmailDay").val(),
            EmailRepeat: $("#EmailRepeat").val(),
            EmailReminderFrequency: $("#EmailReminder").val(),
            EmailReportingTo: $("#EmailReporting").val(),
            EmailCC: $("#EmailCC").val(),
            EmailStartTime: $("#EmailStartTime").val(),

            // Push Notification
            PushNotification: $("#pushCheck").is(":checked"),
            PushDay: $("#PushDay").val(),
            PushRepeat: $("#PushRepeat").val(),
            PushReminderFrequency: $("#PushReminder").val(),
            PushReportingTo: $("#PushReporting").val(),
            PushStartTime: $("#PushStartTime").val(),

            // Sms Notification
            SmsNotification: $("#SmsCheck").is(":checked"),
            SmsDay: $("#SmsDay").val(),
            SmsRepeat: $("#SmsRepeat").val(),
            SmsReminderFrequency: $("#SmsReminder").val(),
            SmsReportingTo: $("#SmsReporting").val(),
            SmsCC: $("#SmsCC").val(),
            SmsStartTime: $("#SmsStartTime").val(),
            ModuleID: _NewModuleIDType,
            CompCode: _companyCodeNew,
            CompanyID: _cmpidNew,
        };

        var _urlcmp = '@_webapiurl' + "Alert/AddNotificationRuleConfig";

        $.ajax({
                headers: { 'Authorization': '@_tokan' },
                url: _urlcmp,
                type: 'POST',
                contentType: 'application/json',
                dataType: "json",
                data: JSON.stringify(ruleData),
                success: function (response)
                {
                    $("#ajax_loader").hide();
                    if (response != null)
                    {
                        toastr.remove();
                        toastr.success("NotificationRuleConfig Add SuccessFully.");
                        $('#AddRules_modal').modal('toggle');
                        clearRuleDetails();``
                        setTimeout(function () {
                            window.location.reload(true);
                        }, 100);

                    }
                    else
                    {
                        toastr.remove();
                        toastr.success(response.Meg);
                        $('#AddRules_modal').modal('toggle');
                        clearRuleDetails();
                        setTimeout(function () {
                            window.location.reload(true);
                        }, 100);

                    }
                },
                error: function (response)
                {
                    $("#ajax_loader").hide();
                    if (response != null)
                    {
                        var obj = JSON.parse(response.responseText);
                        if (obj.MegSts == 'error') {
                            toastr.remove();
                            toastr.error(obj.Meg);
                            $('#AddRules_modal').modal('toggle');
                            clearRuleDetails();
                            setTimeout(function ()
                            {
                                window.location.reload(true);
                            }, 100);
                        }
                    }
                }
        });

    }
