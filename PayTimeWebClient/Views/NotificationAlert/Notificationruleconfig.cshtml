    // Common function to build reporting dropdown options
    function bindReportingDropdowns(selectedEventName) {
        var reportingDropdowns = ["#InAppReporting", "#EmailReporting", "#PushReporting", "#SmsReporting"];

        // Clear all
        reportingDropdowns.forEach(function (id) {
            $(id).empty();
        });

        // Prepare options
        var options = '';
        if (selectedEventName.includes('request')) {
            options += '<option value="1">None</option>';
            options += '<option value="3">Approval Person</option>';
        }
        else if (selectedEventName.includes('approval')) {
            options += '<option value="1">None</option>';
            options += '<option value="2">Request Person</option>';
        }
        else {
            options += '<option value="1">None</option>';
            options += '<option value="2">Request Person</option>';
            options += '<option value="3">Approval Person</option>';
        }

        // Append to all
        reportingDropdowns.forEach(function (id) {
            $(id).append(options);
        });

        // Refresh select2
        if ($.fn.select2) {
            reportingDropdowns.forEach(function (id) {
                $(id).trigger('change.select2');
            });
        }
    }




