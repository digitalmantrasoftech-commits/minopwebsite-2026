    function LoadDyanamicsTabModule(RoleID)
    {
        checkSession();

        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Alert/NtoficationTabModuleGetAll?RoleID=' + RoleID,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            timeout: 30000,
            data: JSON.stringify({ RoleID: RoleID }),
            beforeSend: function ()
            {
                $("#ajax_loaderNotificationRuleConfig").show();
            },
            success: function (response)
            {
                $("#ajax_loaderNotificationRuleConfig").hide();
                // Handle data found
                if (response != null && response.length > 0) {
                    let tabHtml = '';
                    let tabContentHtml = '';

                    response.forEach((module, index) => {
                        const isActive = index === 0 ? 'active' : '';
                        const ariaSelected = index === 0 ? 'true' : 'false';

                        // Generate Tab Header
                        tabHtml += `
                            <li class="nav-item ${isActive}">
                                <a class="nav-link" data-toggle="tab"
                                   href="#noticonfig_${module.ModuleId}" role="tab"
                                    data-moduleid="${module.ModuleId}"
                                   aria-selected="${ariaSelected}">
                                    <i class="${module.IconPath}"></i>
                                    <span>${module.ModuleName}</span>
                                </a>
                            </li>
                        `;

                        // Generate Tab Content Panel
                        tabContentHtml += `
                            <div class="tab-pane fade ${isActive ? 'show active' : ''}"
                                 id="noticonfig_${module.ModuleId}" role="tabpanel">
                                <div id="gridContainer_${module.ModuleId}">Loading ${module.ModuleName} Grid...</div>
                            </div>
                        `;
                    });

                    // Inject into DOM

                    $("#tabModuleContainer").html(tabHtml);
                    // ✅ Set ActiveTabModuleID initially for the first tab
                    const firstModule = response[0];
                    $("#_ActiveTabModuleID").val(firstModule.ModuleId);

                    // ✅ Listen for tab clicks and update value dynamically
                    $(document).on("click", ".nav-link", function () {
                        const moduleId = $(this).data("moduleid");
                        $("#_ActiveTabModuleID").val(moduleId);
                        //console.log("Active Tab Module ID:", moduleId);
                    });
                    //$("#tabContentContainer").html(tabContentHtml);

                    // Optionally trigger grid load for the first module                   
                    //if (firstModule) {
                    //    loadGridForModule(firstModule.ModuleId, firstModule.ModuleCode);
                    //}
                }
                else
                {

                }
            },
            error: function (jqXHR)
            {
                $('.loading').hide();
                if (jqXHR.status == 500) {
                    toastr.error("Internal Server Error");
                } else if (jqXHR.status == 400) {
                    toastr.error("Bad Request");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            }
        });
    }

    function LoadDyanamicsEventModuleWise(ModuleID)
    {
        checkSession();
        $('#ddleventmodulewise').empty();

        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Alert/GetNotificationEventsByModule?ModuleID=' + ModuleID,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            timeout: 30000,
            data: JSON.stringify({ ModuleID: ModuleID }),
            beforeSend: function ()
            {
                $("#ajax_loaderNotificationRuleConfig").show();
            },
            success: function (response)
            {
                $("#ajax_loaderNotificationRuleConfig").hide();

                //#ddleventmodulewise
                if (response.isRedirect)
                {
                    window.location.href = response.redirectUrl;
                }
                if (response != null)
                {
                    $("#ddleventmodulewise").append("<option value='0' selected>Select Event</option>");
                    response.sort(function (a, b) {
                        return a.EventName.localeCompare(b.EventName);
                    });
                    for (var i = 0; i < response.length; i++) {
                        if (_RoleID == 1 || _RoleID == 6805 || _RoleID  == 6806) {
                            $("#ddleventmodulewise").append("<option value='" + response[i].EventID + "'>" + response[i].EventName + "</option>");
                        }
                    }
                }
                $("#ajax_loaderNotificationRule").hide();
            },
            error: function (jqXHR)
            {
                $('.loading').hide();
                if (jqXHR.status == 500) {
                    toastr.error("Internal Server Error");
                } else if (jqXHR.status == 400) {
                    toastr.error("Bad Request");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            }
        });
    }


    function updateNotiFicationRuleConfigStatus(flag, _notificationId)
    {

        var annouceid = _notificationId;
        const params = new URLSearchParams({
            flag: flag,
            notificationruleid: annouceid
        });
        const urlWithQuery = `${'@_webapiurl'}Alert/UpdateStatusRuleConfig?${params.toString()}`;
        $.ajax({
            type: "POST",
            url: urlWithQuery,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function (xhr) {
                xhr.setRequestHeader("Authorization",'@_tokan');
            },
            success: function (data)
            {
                if (data.isRedirect)
                {
                    window.location.href = data.redirectUrl;
                } else
                {
                    if (flag == 0)
                    {
                        toastr.error("NotificationRuleConfig Inactive Successfully.")
                    } else
                    {
                        toastr.success("NotificationRuleConfig Active Successfully.")
                    }
                    var _moduleID = $("#_ActiveTabModuleID").val();
                    GetAllNotificationRuleConfigDetails(_moduleID);
                }
            },
            error: function (jqXHR, ajaxOptions, thrownError)
            {
                $('.loading').hide();
                if (jqXHR.status == 500) { //InternalServerError = 500,
                    toastr.error("InternalServerError");
                } else if (jqXHR.status == 400) { //BadRequest = 400,
                    toastr.error("BadRequest");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            },
        });
    }

    function GetAllNotificationRuleConfigDetails(ModuleIDTab)
    {
        checkSession();

        var RuleGetparam =
        {
            RuleID: 0,
            ModuleID: ModuleIDTab,
            EventID: 0,
            RoleID: 0,
            FromDate: 0,
            ChannelVia: ''
        }

        $('#tblNotificationruleConfigDetails').empty();
        var _urlcmp = '@_webapiurl' + "Alert/NotificationRuleConfiGetAll";

        $.ajax({
            type: "POST",
            headers: { 'Authorization':'@_tokan'},
            url: _urlcmp,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            timeout: 30000,
            data: JSON.stringify(RuleGetparam),
            beforeSend: function () {
                $("#ajax_loaderbranch").show();
            },
            success: function (response)
            {
                if (response != null)
                {
                    const sift = response;
                    handleGridVisibility("tblempty", "NotificationGrid-empty", sift,
                    {
                        imageUrl: "emptyscreen_1.png",
                        subText: "No entries found. Please add a record to get started."
                    });
                }

                if (response != null && response.length > 0)
                {
                    if ($.fn.DataTable.isDataTable('#tblNotificationruleConfigDetails'))
                    {
                        $('#tblNotificationruleConfigDetails').DataTable().destroy();
                        $('#dataTables_tbl_header').remove();
                    }

                    var tablestrenght = "";
                    _notificationRuleConfigData = response;
                    $("#tblNotificationruleConfigDetails").empty();

                    for (var i = 0; i < response.length; i++)
                    {

                        let item = response[i];
                        tablestrenght += "<tr>";
                        tablestrenght += "<td>" + item.RuleTitle + "</td>";
                        tablestrenght += "<td>" + item.Description + "</td>";
                        tablestrenght += "<td>" + item.EventName + "</td>";
                        tablestrenght += "<td>" + item.Operator + "</td>";
                        tablestrenght += "<td>" + item.Value + "</td>";
                        tablestrenght += "<td>" + item.InApp + "</td>";
                        tablestrenght += "<td>" + item.InPush + "</td>";
                        tablestrenght += "<td>" + item.InEmail + "</td>";
                        tablestrenght += "<td>" + (item.InSms || '-') + "</td>";


                        //var IsMandatory = "";
                        //IsMandatory = item.IsMandatory;

                        var IsMandatory = item.IsMandatory === 1 ? "checked" : "";

                        tablestrenght += "<td>";
                        tablestrenght += ` <div><input type="checkbox" data-size="small" class="make-switch abc" data-id="${item.RuleId}" ${IsMandatory}
                                                data-info="${item.RuleId}" data-on-text="<i class='fa-solid fa-check'></i>" data-off-text="<i class='fa-solid fa-xmark'></i> " /></div>`;
                        tablestrenght += "</td>";

                        tablestrenght += "<td>";
                        if (item.IsMandatory === 1)
                        {
                            tablestrenght += "<a class='editclass btn seagreen_btnnew tooltips' data-placement='top' data-original-title='Edit' data-notifyid='" + item.RuleId + "'>";
                            tablestrenght += "<i class='fa-regular fa-pen-to-square'></i></a>";
                        }
                        tablestrenght += "<a class='quickviewclass btn blue_btnnew tooltips' data-placement='top' data-original-title='View' data-notifyid='" + item.RuleId + "'>";
                        tablestrenght += "<i class='fa-regular fa-eye'></i></a>";
                        tablestrenght += "</td>";

                        tablestrenght += "</tr>";
                    }

                    $('#tblNotificationruleConfigDetails').html(tablestrenght);
                    $(".make-switch").bootstrapSwitch();

                    t = $('#tblNotificationruleConfigDetails').DataTable(
                    {
                        destroy: true,
                        dom: _domCommon,
                        language: _languageCommon,
                        order: [],
                        columnDefs: [
                            { orderable: false, targets: [7, 8, 9] } // disable ordering on InEmail, InSMS, Action
                        ],
