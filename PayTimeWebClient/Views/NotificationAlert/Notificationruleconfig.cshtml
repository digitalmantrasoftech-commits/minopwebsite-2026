    // Updated Utility
    function resetAndToggleFields(fields, isEnabled, shouldReset = true) {
        fields.forEach(field => {
            const $el = $(`#${field.id}`);
            if (shouldReset && !isEditMode && field.reset !== undefined) {
                $el.val(field.reset).trigger('change');
            }
            $el.prop('disabled', !isEnabled);
        });
    }

