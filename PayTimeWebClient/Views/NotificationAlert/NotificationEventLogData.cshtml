
@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Notification EventLogData";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = string.Empty;
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    string _branchid = string.Empty;
    if (_RoleId == 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
    }
    if (_RoleId > 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    string _CountryCode = HttpContext.Current.Session["CountryCode"].ToString();
    string _AreaCode = HttpContext.Current.Session["AreaCode"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();

    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    Int64 _DatagridThsold = 0;

    _DatagridThsold = Convert.ToInt64(HttpContext.Current.Session["DataGridThresold"]);
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null

}
<script src="~/Scripts/Helpers/noDataHandler.js"></script>

<script>
    var _RoleID = '@_RoleId';

    $(document).ready(function ()
    {
        var today = moment().format("YYYY-MM-DD");
        var obj =
        {
            "EmpID": "",
            "RoleID": _RoleID,
            "Fromdate": today,
            "ToDate": today,
            "Channel": "",
            "Status": ""
        };
        loadNotificationEventLog(obj,0);

        $("#closedatten").click(function ()
        {
            $("#messageContentModal").modal('hide');
        });

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600)
            {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        $("#search_btn").click(function (event)
        {
        //$("#NotificationGrid-empty1").hide();

        if ($("#from_date").val() == "")
        {
            $("#from_date").addClass('field_error');
            event.preventDefault();//or return false
            return false;
        }
        if ($("#to_date").val() == "") {
            $("#to_date").addClass('field_error');
            event.preventDefault();//or return false
            return false;
        }
        var filFrmDate = $("#from_date").val();
        var filToDate = $("#to_date").val();

        var isDateFormat = "@_isdateformat";

        if ("@_isdateformat" == "dd-mm-yyyy") {
            isDateFormat = "DD-MM-YYYY"
        }
        else if ("@_isdateformat" == "mm-dd-yyyy") {
            isDateFormat = "MM-DD-YYYY"
        }
        else if ("@_isdateformat" == "yyyy-mm-dd") {
            isDateFormat = "YYYY-MM-DD"
        }
        else if ("@_isdateformat" == "yyyy-M-dd") {
            isDateFormat = "YYYY-MMM-DD"
        }
        else if ("@_isdateformat" == "M-dd-yyyy") {
            isDateFormat = "MMM-DD-YYYY"
        }
        else if ("@_isdateformat" == "dd-M-yyyy") {
            isDateFormat = "DD-MMM-YYYY"
        }

        var frmDateMoment =moment(filFrmDate,isDateFormat);
        var toDateMoment =moment(filToDate,isDateFormat);


        if (frmDateMoment > toDateMoment)
        {
            toastr.remove("");
            toastr.error("From date should be greater than to date.");
            return false;
        }
        var FromDate = moment(filFrmDate,isDateFormat).format("YYYY-MM-DD");
        var ToDate = moment(filToDate, isDateFormat).format("YYYY-MM-DD");

        var obj =
        {
            "EmpID": "",
            "RoleID":_RoleID,
            "Fromdate": FromDate,
            "ToDate": ToDate,
            "Channel": $("#ChannelVia_Status").val(),
            "Status": $("#message_status").val()
        }
        const wrapper = $(".filter_portlet_wrapper");
        wrapper.addClass("full-width");
        loadNotificationEventLog(obj,1);

        });

        $("#clear_opration").click(function ()
        {
            window.location.href = "/NotificationAlert/NotificationEventLogData";
        });

    });
    function loadNotificationEventLog(obj,_flagecheck)
    {
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Alert/NotificationEventLogGetData',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            timeout: 30000,
            //data: JSON.stringify({ NotifyID: notifyID }),
            data: JSON.stringify(obj),
            beforeSend: function () {
                $("#ajax_loaderNotificationErrroLog").show();
            },
            success: function (response)
            {
                $("#ajax_loaderNotificationErrroLog").hide();
                // Handle no data response
                if (response != null && response.length === 0)
                {
                    if (_flagecheck === 0) {
                        $('#NotificationGrid-empty1').show();
                        $('#NotificationGrid-empty').hide();
                    } else if (_flagecheck === 1) {
                        $('#NotificationGrid-empty').show();
                        $('#NotificationGrid-empty1').hide();
                    }
                    $('#tblempty').hide();
                    return;
                }
                // Handle data found
                if (response != null && response.length > 0)
                {
                    if ($.fn.DataTable.isDataTable('#tblNotificationEventLogData'))
                    {
                        $('#tblNotificationEventLogData').DataTable().destroy();
                        $('#dataTables_tbl_header').remove();
                    }
                    bindNotificationGrid(response);

                    $('#tblempty').show();
                    $('#NotificationGrid-empty').hide();
                    $('#NotificationGrid-empty1').hide();
                    return;
                }
                // Fallback if response is null
                $('#tableResponsive').hide();
                $('#NotificationGrid-empty').hide();
                $('#NotificationGrid-empty1').hide();
                $('#tblempty').hide();
            },
            error: function (jqXHR)
            {
                $('.loading').hide();
                if (jqXHR.status == 500) {
                    toastr.error("Internal Server Error");
                } else if (jqXHR.status == 400) {
                    toastr.error("Bad Request");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            }
        });
    }
    function groupNotificationData(rawData)
    {
        const grouped = {};

        rawData.forEach(item =>
        {
            const key = item.AuditID;

            if (!grouped[key])
            {
                grouped[key] = {
                    AuditID: item.AuditID,
                    empname: item.empname,
                    Channels: new Set(),
                    MessageContent: item.MessageContent,
                    TargetIdentifier: item.TargetIdentifier,
                    ErrorMessage: item.ErrorMessage,
                    IsRead: item.IsRead,
                    Status: item.Status,
                    CreatedDate: item.CreatedDate
                };
            }

            const channelSplit = item.Channel?.split(',') || [];
            channelSplit.forEach(ch => grouped[key].Channels.add(ch.trim()));
        });

        // Finalize data array
        return Object.values(grouped).map(item =>
        {
            return {
                AuditID: item.AuditID,
                empname: item.empname,                
                Channel: Array.from(item.Channels).join(','),
                TargetIdentifier: item.TargetIdentifier,
                ErrorMessage: item.ErrorMessage,
                IsRead: item.IsRead,
                Status: item.Status,
                MessageContent: item.MessageContent,
                CreatedDate: item.CreatedDate
            };
        });
    }

    function bindNotificationGrid(rawResponse) {
        const processedData = groupNotificationData(rawResponse);

        // Injected server-side date format
        const _dateFormat = "@_isdateformat".toLowerCase();
        let momentFormat = "YYYY-MM-DD"; // default

        switch (_dateFormat) {
            case "dd-mm-yyyy": momentFormat = "DD-MM-YYYY"; break;
            case "mm-dd-yyyy": momentFormat = "MM-DD-YYYY"; break;
            case "yyyy-mm-dd": momentFormat = "YYYY-MM-DD"; break;
            case "yyyy-m-dd": momentFormat = "YYYY-MMM-DD"; break;
            case "m-dd-yyyy": momentFormat = "MMM-DD-YYYY"; break;
            case "dd-m-yyyy": momentFormat = "DD-MMM-YYYY"; break;
        }

        $('#tblNotificationEventLogData').DataTable({
            destroy: true,
            data: processedData,
            dom: _domCommon,
            language: _languageCommon,
            columns: [
                { data: 'empname', title: "Emp Name" },                
                {
                    data: 'CreatedDate',
                    title: `Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is: ${momentFormat}' style='color: #295097;'></i>`,
                    render: function (data) {
                        return data ? moment(data).format(momentFormat) : "-";
                    },
                    createdCell: function (td) {
                        $(td).css('color', '#295097');
                    }
                 },
                {
                    data: 'Channel',
                    title: "Channel",
                    render: function (data) {
                        let icons = '';
                        const channels = data?.split(',') || [];

                        channels.forEach(ch => {
                            ch = ch.trim().toLowerCase();
                            if (ch === "email") {
                                icons += `<div class="d-inline-block me-2">
                            <i class="fa-solid fa-globe text-info" title="Email"></i>
                            <span class="ms-1">Email</span>
                          </div>`;
                            }
                            if (ch === "inapp") {
                                icons += `<div class="d-inline-block me-2">
                            <i class="fa-solid fa-bell text-warning" title="In-App"></i>
                            <span class="ms-1">In-App</span>
                          </div>`;
                            }
                            if (ch === "push") {
                                icons += `<div class="d-inline-block me-2">
                            <i class="fa-solid fa-mobile-screen-button text-success" title="Push"></i>
                            <span class="ms-1">Push</span>
                          </div>`;
                            }
                            if (ch === "sms") {
                                icons += `<div class="d-inline-block me-2">
                                <i class="fa-solid fa-message text-primary tooltips" title="SMS"></i>
                                <span class="ms-1">SMS</span>
                              </div>`;
                            }
                        });

                        return icons || "-";
                    }
                },
                { data: 'TargetIdentifier', title: "Target" },
                {
                    data: 'ErrorMessage',
                    title: "Error Message",
                    render: function (data)
                    {
                        return data || "-";
                    }
                },
                { data: 'IsRead', title: "Is Read" },
                { data: 'Status', title: "Status" },
                {
                    data: 'MessageContent',
                    title: "Content",
                    render: function (data) {
                        return `<a href='#' class='message-popup text-primary' data-msg="${data.replace(/'/g, "&apos;")}">
                                <i class="fa fa-envelope-open-text"></i> View
                            </a>`;
                    }
                }
            ]
        });

        // Handle modal click
        $(document).off('click', '.message-popup').on('click', '.message-popup', function (e)
        {
            e.preventDefault();
            const msg = $(this).data('msg');

            $("#messageModalBody").html(`
                <div>
                    ${msg}
                </div>
            `);

            $("#messageContentModal").modal('show');
        });

        // Reinitialize tooltips on draw (pagination, sort, etc.)
        $('#tblNotificationEventLogData').on('draw.dt', function ()
        {
            $('.tooltips').tooltip();
        });

        // Initial tooltip setup
        $('.tooltips').tooltip();

        // Move the header section before your responsive wrapper (if needed)
        setTimeout(function () {
            $("#tblNotificationEventLogData_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        // Inject Export Buttons
        injectExportButtonsForDataTables(false, function () {
            // Optional callback after export buttons loaded
        });

    }



</script>
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {

    <ul class="page-breadcrumb">
        <li>
            <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
        </li>
        <li>
            <span><i class="fa-light fa-angle-right"></i> Notification Rule</span>
        </li>
    </ul>
    <div class="page-toolbar text-right">
        <a href="javascript:;" class="btn icon_transparent_btn tooltips" id="Filter_search" data-placement="left" data-original-title="Filter" data-toggle="tooltip"><i class="fa-light fa-filter" aria-hidden="true"></i> </a>
    </div>
    }
</div>

<div class="row">
    <div id='ajax_loaderNotificationErrroLog' class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>
</div>


<div class="filter_portlet_wrapper full-width">

    <!-- Datatable Block : Begin -->
    <div class="portlet filter_portlet_tbl">
        <div class="portlet-body">

            <div id="tblempty" style="display:none;">
                <div class="table-responsive" id="tableResponsive">
                    <table id="tblNotificationEventLogData" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column">
                    </table>
                </div>
            </div>
            <div id="NotificationGrid-empty" style="display: none">
                <div class="datanotfound">
                    <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="No Data Found Icon">
                    <p class="datanotfound_title">No data found</p>
                    <p class="datanotfound_subtitle">No matching records found for the selected filters.</p>
                    @*//---First Time///*@
                </div>
            </div>

            <div id="NotificationGrid-empty1" style="display: none">
                <div class="datanotfound">
                    <img src="~/assets/images/emptyscreen_3.png" height="148" width="280" alt="No Data Found Icon">
                    <p class="datanotfound_title">No data show</p>
                    <p class="datanotfound_subtitle">Start by applying a filter to view relevant data.</p>
                    @*//---After filter Time///*@
                </div>
            </div>


        </div>
    </div>
    <!-- Datatable Block : End -->
    <!-- Filter Block : Begin -->
    <div class="portlet filter_boxModal">
        <div class="filterbox_header">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="filter-title">Filters</h4>
                <button type="button" class="filterclose_btn"><i class="fa-light fa-xmark"></i></button>
            </div>
        </div>
        <div class="filterbox_body">

            <div class="col-lg-12">
                <div class="form-group">
                    <label for="ChannelVia_Status" class="control-label">Channel<span class="required" aria-required="true"> * </span></label>
                    <!-- Add a dropdown or input field if necessary -->
                    <select id="ChannelVia_Status" class="form-control">
                        <option value="">Select Channel</option>
                        <option value="InApp">InApp</option>
                        <option value="Email">Email</option>
                        <option value="Push">Push</option>
                        <option value="SMS">SMS</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group">
                    <label for="messagestatus" class="control-label">Status<span class="required" aria-required="true"> * </span></label>
                    <!-- Add a dropdown or input field if necessary -->
                    <select id="message_status" class="form-control">
                        <option value="">Select status</option>
                        <option value="Failed">Failed</option>
                        <option value="Success">Success</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group data_picker_box">
                    <label class="control-label">From Date<span class="required" aria-required="true"> * </span></label>
                    <div class="input-group input-group-sm date date-picker" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-end-date="0d" data-date-viewmode="years">
                        <span class="input-group-btn">
                            <button class="btn default btn-sm" type="button">
                                <i class="fa-light fa-calendar-days"></i>
                            </button>
                        </span>
                        @if (@_isdateformat == "dd-M-yyyy" || @_isdateformat == "M-dd-yyyy" || @_isdateformat == "yyyy-M-dd")
                        {
                        <input class="form-control" id="from_date" name="from_date" type="text" placeholder="@_isdateformat.Replace("M", "MMM")" autocomplete="off">
                        }
                        else
                        {
                        <input class="form-control" id="from_date" name="from_date" type="text" placeholder="@_isdateformat" autocomplete="off">
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group data_picker_box">
                    <label class="control-label">To Date<span class="required" aria-required="true"> * </span></label>
                    <div class="input-group input-group-sm date date-picker" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-end-date="0d" data-date-viewmode="years">
                        <span class="input-group-btn">
                            <button class="btn default btn-sm" type="button">
                                <i class="fa-light fa-calendar-days"></i>
                            </button>
                        </span>
                        @if (@_isdateformat == "dd-M-yyyy" || @_isdateformat == "M-dd-yyyy" || @_isdateformat == "yyyy-M-dd")
                        {
                        <input class="form-control" id="to_date" name="to_date" type="text" placeholder="@_isdateformat.Replace("M", "MMM")" autocomplete="off">
                        }
                        else
                        {
                        <input class="form-control" id="to_date" name="to_date" type="text" placeholder="@_isdateformat" autocomplete="off">
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="filterbox_footer">
            <div class="text-right">
                <button type="button" id="clear_opration" class="clear_btn tooltips" data-placement="top" data-original-title="Clear Filters" style="display: inline-block;"><i class="fa-regular fa-eraser"></i></button>
                <button type="button" id="search_btn" class="icon_btn margin-left-5 tooltips" data-placement="top" data-original-title="Search Filters" style="display: inline-block;"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
        </div>
    </div>
    <!-- Filter Block : End -->

</div>


