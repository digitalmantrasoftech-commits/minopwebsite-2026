    function register() {
        var CompanyName = $('#txtCompanyName').val();
        var Email = $('#txtEmail').val();
        var strcmp = CompanyName.replace(/\s/g, '');
        var Password = strcmp.slice(0, 4) + "#123";
        var planid = 1; //pass temp static value
        var domain = strcmp.slice(0, 5);
        var school = 0;
        var Office = 1;
        var DealerCode = '@_dealercode';
        var Userquantity = $('#txtnoofemployee').val();

        $.ajax({
            contentType: 'application/json',
            dataType: 'json',
            type: 'post',
            data: '{"CompanyName": "' +
                CompanyName +
                '", "Email":"' +
                Email +
                '", "Password":"' +
                Password +
                '","PlanId":' +
                planid +
                ',"Domain": "' +
                domain +
                '","IsSchool":' +
                school +
                ',"IsOffice":' +
                Office +
                ',"DealerCode":"' +
                DealerCode +
                '","Userquantity":' +
                Userquantity +
                '}',
            url: '@_webapiurl' + '/Registration/Registerbypartner',
            beforeSend: function () {
                loadingAjax('ajax_loaderallemp');
                $("#btnregistersubmit").attr('disable')
                $("#btnregistersubmit").attr('disabled', 'disabled');

            },
            success: function (result) {
                $('#ajax_loaderallemp').hide();
                toastr.remove();
                toastr.success('@PayTimeWebClient.Resource.Resource.RegistrationSucessfull');
                $('#exampleModal').modal('hide').data('bs.modal', null);
                getCompanyCount(1);
                getCompanyData(1);
                clearform();

            },
            error: function (result) {
                $('#ajax_loaderallemp').hide();
                toastr.error("Oops! " + result.responseJSON.Meg);
                $("#txtCompanyName").removeClass('field_error');
                $("#txtEmail").removeClass('field_error');
                $("#password").removeClass('field_error');
                $('#txtnoofemployee').val(0);
            },

        });

    }
    function blockSpecialCharAllowSpace(evt) {
        var k;
        if (evt.keyCode > 0) {
            k = evt.keyCode;
        } else if (typeof (evt.charCode) != "undefined") {
            k = evt.charCode;
        }
        return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
    }
    function blockSpecialChar(evt) {
        var k;
        if (evt.keyCode > 0) {
            k = evt.keyCode;
        } else if (typeof (evt.charCode) != "undefined") {
            k = evt.charCode;
        }
        return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57));
    }
