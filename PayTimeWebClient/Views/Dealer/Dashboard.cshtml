@{
    ViewBag.Title = "Dashboard";
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _UserImg = HttpContext.Current.Session["photo"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _dealercode = HttpContext.Current.Session["cmpcode"].ToString();
    string strmsg = string.Empty;
    string msgsts = "";
    if (TempData["Msgstatus"] != null)
    {
        msgsts = TempData["Msgstatus"].ToString();

        strmsg = TempData["Msg"].ToString();
    }


    // Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .card_box {
        display: block;
        padding: 0px;
        border: 1px solid #F5F5F5;
        border-radius: 6px !important;
        background-color: #F5F5F5;
        box-shadow: 2px 2px 5px #BDBDBD;
    }

        .card_box .card-header {
            color: #3598dc;
            font-size: 17px;
            font-weight: bolder;
            padding: 15px;
            border-bottom: 1px solid #3598dc;
        }

        .card_box .card-body {
            display: block;
            padding: 15px;
            display: -ms-flexbox;
            display: flex;
            -ms-flex-wrap: wrap;
            flex-wrap: wrap;
            -ms-flex-align: center !important;
            align-items: center !important;
            min-height: 160px;
        }

            .card_box .card-body p {
                margin: 0px;
                color: #757575;
                font-size: 14px;
                margin-bottom: 5px;
            }

                .card_box .card-body p b {
                    margin-right: 10px;
                }

        .card_box .card-header.date_header {
            padding-right: 200px;
            position: relative;
        }

    .date_box_card {
        padding: 0px;
        display: inline-block;
        float: right;
        width: 155px;
        line-height: 15px;
        margin-top: -7px;
        position: absolute;
        right: 10px;
    }

        .date_box_card p {
            margin: 0px;
            color: #364150;
            font-size: 12px;
            margin-bottom: 0px;
            width: 100%;
            display: inline-block;
        }

            .date_box_card p span {
                float: right;
            }

            .date_box_card p b {
                margin-right: 10px;
                color: #3598dc;
            }

    .Price_label {
        color: #364150;
        font-size: 20px;
        display: inline-block;
        width: 50%;
        text-align: right;
    }

        .Price_label b {
            display: block;
        }

        .Price_label span {
            display: block;
            font-size: 30px;
        }

            .Price_label span i {
                font-size: 25px;
                margin-right: 7px;
                color: #3598dc;
            }

    .account_plan_details {
        margin: 0px;
        width: 50%;
        display: inline-block;
    }

    .card-footer {
        color: #2b8dd9;
        font-size: 17px;
        font-weight: bolder;
        padding: 10px 0px;
        text-align: right;
        width: 100%;
    }

    .btn_select_new_plan {
        display: inline-block;
        padding: 6px 20px;
        background-color: #3598dc;
        border-radius: 5px !important;
        font-size: 14px;
        color: #ffffff;
        border: 1px solid #3598dc;
        box-shadow: 1px 1px 5px #9E9E9E;
        font-weight: 500;
        margin: 0px 0px 0px 10px;
    }

        .btn_select_new_plan i {
            margin-right: 10px;
        }

        .btn_select_new_plan:hover, .btn_select_new_plan:focus, .btn_select_new_plan:active {
            outline: none;
            text-decoration: none;
            color: #ffffff;
        }

    .btn_Renew_Plan {
        display: inline-block;
        padding: 6px 20px;
        background-color: #364150;
        border-radius: 5px !important;
        font-size: 14px;
        color: #f5f5f5;
        border: 1px solid #364150;
        box-shadow: 1px 1px 5px #9E9E9E;
        margin: 0px 0px 0px 10px;
        font-weight: 500;
    }

        .btn_Renew_Plan i {
            margin-right: 10px;
        }

        .btn_Renew_Plan:hover, .btn_Renew_Plan:focus, .btn_Renew_Plan:active {
            outline: none;
            text-decoration: none;
            color: #f5f5f5;
        }


    .modal_payment_status {
    }

    .payment_Status_data {
        text-align: left;
    }

        .payment_Status_data .form-group {
            margin-bottom: 10px;
        }

    .successpay {
        padding: 10px;
        border: 1px solid #c3e6cb;
        color: #155724;
        background-color: #d4edda;
    }

        .successpay .psuccess {
            font-size: 20px;
            margin-bottom: 20px;
        }

    .payment_Status_data .successpay h1 {
        margin: 0px;
        margin-bottom: 5px;
        font-size: 30px;
        color: #155724;
        font-weight: 500;
        text-align: center;
    }

    .failpay {
        padding: 10px;
        border: 1px solid #f8d7da;
        color: #721c24;
        background-color: #f8d7da;
    }

        .failpay .pfaild {
            font-size: 20px;
            margin-bottom: 20px;
        }

    .payment_Status_data .failpay h1 {
        margin: 0px;
        margin-bottom: 5px;
        font-size: 30px;
        color: #721c24;
        font-weight: 500;
        text-align: center;
    }

    .payment_Status_data p {
        margin: 5px 0px;
    }

    .btn_ok_payment {
        display: inline-block;
        height: 35px;
        line-height: 35px;
        text-align: center;
        padding: 0px 10px;
        background-color: #364150;
        border: 1px solid #364150;
        box-shadow: 1px 1px 5px #9E9E9E;
        color: white;
        font-weight: 500;
        margin-left: 15px;
        border-radius: 4px !important;
    }

        .btn_ok_payment i {
            margin-right: 10px;
        }

        .btn_ok_payment:hover, .btn_ok_payment:focus, .btn_ok_payment:active {
            outline: none;
            text-decoration: none;
            color: white;
        }

    .btn_print_Status {
        display: inline-block;
        height: 35px;
        line-height: 35px;
        text-align: center;
        padding: 0px 10px;
        background-color: #3598dc;
        border: 1px solid #3598dc;
        box-shadow: 1px 1px 5px #9E9E9E;
        color: white;
        font-weight: 500;
        margin-left: 15px;
        border-radius: 4px !important;
    }

        .btn_print_Status i {
            margin-right: 10px;
        }

        .btn_print_Status:hover, .btn_print_Status:focus, .btn_print_Status:active {
            outline: none;
            text-decoration: none;
            color: white;
        }


    .modal_payment_status table {
        width: 100%;
        height: 100vh;
    }

        .modal_payment_status table tr td {
            vertical-align: middle;
            text-align: center;
        }

    .status-box {
        max-width: 600px;
        display: inline-block;
        background-color: white;
        padding: 20px;
        position: relative;
        min-width: 280px;
    }

        .status-box .modal-title {
            color: #3598dc;
            text-align: left;
            font-size: 20px;
        }

        .status-box button.close {
            position: absolute;
            right: 20px;
            top: 20px;
            height: 30px;
            width: 30px;
            background-color: #E0E0E0;
        }
</style>
