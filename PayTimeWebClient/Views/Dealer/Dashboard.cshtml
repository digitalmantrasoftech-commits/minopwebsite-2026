    $(".assignPlan").click(function () {
        var sThisVal;
        var companyId = "";
        var status = false;
        var planId;
        var liccount = 0;
        sThisVal = $('input[name = companyPlanId]:checked');
        if (sThisVal.length > 0) {

            companyId = $(sThisVal).map(function (index, value) {
                return value.id;
            }).get().join(',');

        } else {
            toastr.remove();
            toastr.error("Please select company.");
        }

        if ($("#dealerPlanid option:selected").val() == "-1") {
            toastr.remove();
            toastr.error("Please select plan.");
            status = false;
        } else {
            planId = $("#dealerPlanid option:selected").val();
            var pname = $("#dealerPlanid option:selected").text();
            var regExp = /\(([^)]+)\)/;
            var matches = regExp.exec(pname);
            liccount = matches[1];
            status = true;
        }

        //var totalLicense = parseInt($(".No_of_Lincence_box").children("h2").text());
        var totalLength = 0;
        totalLength = sThisVal.length;

        if (totalLength <= liccount && totalLength != 0) {
            status = true;
        } else {
            if ($("#dealerPlanid option:selected").val() != "-1") {
                toastr.remove();
                toastr.error("Please select company as per available licenses is " + liccount + ".!");
            }
            status = false;
        }

        if (status == true) {
            assignDealerLicense(companyId, planId);
        }
        return false;
    });



