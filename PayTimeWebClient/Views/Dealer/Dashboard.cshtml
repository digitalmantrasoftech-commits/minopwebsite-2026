<div class="modal fade page-header" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="width:300px">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Company Registration</h5>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("Index", "PayTime", FormMethod.Post))
                {
                    <div class="form_group">
                        <span class="help-block" style="color: red;" hidden id="spvalidation"></span>
                    </div>
                    <div class="form_group">
                        <div class="form-group">
                            <label>Company Name <span class="required" aria-required="true"> * </span></label>
                            <div class="input-group">
                                <input type="text" name="txtCompanyName" id="txtCompanyName" required="" maxlength="50" onkeypress="return blockSpecialCharAllowSpace(event);" />
                                <span class="highlight"></span>
                                <span class="bar" id="sp1"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>@PayTimeWebClient.Resource.Resource.Email <span class="required" aria-required="true"> * </span></label>
                            <div class="input-group">
                                <input type="text" name="txtEmail" id="txtEmail" required>
                                <span class="highlight"></span>
                                <span class="bar" id="sp2"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>No Of Employee <span class="required" aria-required="true"> * </span></label>
                            <div class="input-group">
                                <input type="number" min="1"  name="txtnoofemployee" id="txtnoofemployee" required="" maxlength="50" onkeypress="return blockSpecialChar(event)" />
                                <span class="highlight"></span>
                                <span class="bar" id="sp3"></span>
                            </div>
                        </div>

                    </div>
                    <div class="bar">
                        <div id="ajax_loaderallemp" aria-hidden="true">
                        </div>
                        <br />
                    </div>
                    <div class="form-group">
                        <button type="button" class="Register_btn Active_btn" id="btnregistersubmit"><i class="fa fa-paper-plane-o"></i> @PayTimeWebClient.Resource.Resource.Register</button>
                        <button class="Register_btn" type="button" id="registerCancel"> <i class="fa fa-close"></i> Cancel</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/toastr.min.js"></script>
<script>

    $(window).load(function () {
        if ('@msgsts' != "") {
            $("#frmpopup").modal('show');
        }
    });
    function loadingAjax(div_id) {
        $("#" + div_id).show();
        $("#" + div_id).html('<img src="/LandingAssets/images/loading.gif" style="cursor: auto; width:30px;" alt="loading" title="loading"/>');
    }

    $(document).ready(function () {


        getAccountManager()
        //1 for company count
        getCompanyCount(1)
        //2 total employee count
        getEmployeeCount(2)
        ////3 total device count
        getTotalDevice(3)

        ////5 total pendig Assing licence count
        getLicenseCount(5)

        ////Total licence No
        Getpartnerlicence()


        //Get Company Detail
        getCompanyData(1)


        $("#btnok").on('click', function () {
            $("#btnok").attr("data-toggle", "modal");
            $("#btnok").attr("data-target", "#frmpopup");
        });



    });


    function getAccountManager() {
        var obj = getAccountPara();
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data:JSON.stringify(obj),
             //{ "Typeid": 4, "DealerId": 0, "Isctn": 0, "p_planid": 0 },  //para 2 means getActiveDealer
            type: 'post',
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Dealers/GetDealerDashBoardCount',
            async: false,
            success: function (response) {
                if (response.length > 0) {

                    var d = response[0].MangerName;
                    $(".Account_Manager_details").children("span").text(d);
                }
            }
        });
    }
    function getAccountPara() {

        return {
            Typeid : 4,
            DealerId : 0,
            Isctn : 0,
            p_planid : 0
        }
    }

    function getCompanyCount(typeId) {
        
        var obj = getCompanyPara(typeId);
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: JSON.stringify(obj),
             //{ "typeId": typeId, "DealerId": '@Convert.ToInt32(Session["DealerId"])', "Isctn": 1, "p_planid": 0 },
            type: 'post',
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Dealers/GetDealerDashBoardCount',
            async: false,
            success: function (response) {
                if (response.length > 0) {
                    $(".Total_Company_box").children('h2').text(response[0].TotalNocompany);
                } else {
                    $(".Total_Company_box").children('h2').text('0');
                }
            }
        });


    }

    function getCompanyPara(typeId) {

        return {
            Typeid: typeId,
            DealerId: '@Convert.ToInt32(Session["DealerId"])',
            Isctn: 1,
            p_planid: 0
        }
    }
    function getEmployeeCount(typeId) {
        var obj = getEmployeeCountPara(typeId);
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data:JSON.stringify(obj),
             //{ "typeId": typeId, "DealerId": '@Convert.ToInt32(Session["DealerId"])', "Isctn": 1, "p_planid": 0 },
            type: 'post',
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Dealers/GetDealerDashBoardCount',
            async: false,
            success: function (response) {
                if (response.length > 0) {
                    $(".Total_Employee_box").children('h2').text(response[0].TotalEmpCount);
                } else {
                    $(".Total_Employee_box").children('h2').text('0');
                }
            }
        });
    }

    function getEmployeeCountPara(typeId) {
        return {
            Typeid: typeId,
            DealerId: '@Convert.ToInt32(Session["DealerId"])',
            Isctn: 1,
            p_planid: 0
        }

    }


    function getTotalDevice(typeId) {
        var obj = getTotalDevicePara(typeId);

        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: JSON.stringify(obj),
             //{ "typeId": typeId, "DealerId": '@Convert.ToInt32(Session["DealerId"])', "Isctn": 1, "p_planid": 0 },
            type: 'post',
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Dealers/GetDealerDashBoardCount',
            async: false,
            success: function (response) {
                
                if (response.length > 0) {
                    $(".No_of_Device_box").children('h2').text(response[0].TotalDeviceCount);
                } else {
                    $(".No_of_Device_box").children('h2').text('0');
                }
            }
        });
    }

    function getTotalDevicePara(typeId) {
        return {
            Typeid: typeId,
            DealerId: '@Convert.ToInt32(Session["DealerId"])',
            Isctn: 1,
            p_planid: 0
        }
    }

    function getLicenseCount(typeId) {
        var obj = getLicenseCountPara(typeId);
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: JSON.stringify(obj),
            //{ "typeId": typeId, "DealerId": '@Convert.ToInt32(Session["DealerId"])', "Isctn": 1, "p_planid": 0 },
            type: 'post',
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Dealers/GetDealerDashBoardCount',
            async: false,
            success: function (response) {
                if (response.length > 0) {
                    $(".No_assigned_Lincence_box").children('h2').text(response[0].Ctn);
                } else {
                    $(".No_assigned_Lincence_box").children('h2').text('0');
                }
            }
        });
    }


    function getLicenseCountPara(typeId) {
        return {
            Typeid: typeId,
            DealerId: '@Convert.ToInt32(Session["DealerId"])',
            Isctn: 1,
            p_planid: 0
        }
    }

    function getCompanyData(typeId) {
        boxHideshow("Total_Company_box");
        var obj = {
            'Typeid': typeId,
            'DealerId': '@Convert.ToInt32(Session["DealerId"])',
            'Isctn': 0,
            'p_planid' : 0   
        }

        var t = $('#Dealer_Dashboard_data').DataTable({
            "destroy": true,
            "ajax": {
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: function(d){
                   return JSON.stringify(obj)
                },
                    //{ "typeId": typeId, "DealerId": Convert.ToInt32(Session["DealerId"])', "Isctn": 0, "p_planid": 0 },
                type: 'post',
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + 'Dealers/GetDealerDashBoardCount',
                async: false,
                dataSrc: ""
            },
            "columns": [

                   { "data": null },
