
@{
    ViewBag.Title = "FinancialSetting";
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _userid = HttpContext.Current.Session["UserId"].ToString();
    string _roleid = HttpContext.Current.Session["RoleId"].ToString();
    Layout = "~/Views/Shared/_PartnerLayout.cshtml";
 }

<style>
    .card_box {
        display: block;
        padding: 0px;
        border: 1px solid #F5F5F5;
        border-radius: 10px !important;
        background-color: #F5F5F5;
        box-shadow: 2px 2px 5px #BDBDBD;
        height: 200px;
    }

        .card_box .card-header {
            color: #3598dc;
            font-size: 17px;
            font-weight: bolder;
            padding: 15px;
            border-bottom: 1px solid #3598dc;
        }

        .card_box .card-body {
            display: block;
            padding: 15px;
            display: -ms-flexbox;
            display: flex;
            -ms-flex-wrap: wrap;
            flex-wrap: wrap;
            -ms-flex-align: center !important;
            align-items: center !important;
            min-height: 160px;
        }

            .card_box .card-body p {
                margin: 0px;
                color: #757575;
                font-size: 14px;
                margin-bottom: 5px;
            }

                .card_box .card-body p b {
                    margin-right: 10px;
                }

        .card_box .card-header.date_header {
            padding-right: 200px;
            position: relative;
        }

    .date_box_card {
        padding: 0px;
        display: inline-block;
        float: right;
        width: 155px;
        line-height: 15px;
        margin-top: -7px;
        position: absolute;
        right: 10px;
    }

        .date_box_card p {
            margin: 0px;
            color: #364150;
            font-size: 12px;
            margin-bottom: 0px;
            width: 100%;
            display: inline-block;
        }

            .date_box_card p span {
                float: right;
            }

            .date_box_card p b {
                margin-right: 10px;
                color: #3598dc;
            }

    .card-footer {
        color: #2b8dd9;
        font-size: 17px;
        font-weight: bolder;
        padding: 10px 0px;
        text-align: right;
        width: 100%;
    }

    .add-partner {
        display: inline-block;
        padding: 0px 10px;
        background-color: #1c96cd;
        height: 30px;
        line-height: 28px;
        color: white;
        border-radius: 5px !important;
        box-shadow: 1px 1px 5px #ababab;
        border: 1px solid #1c96cd;
        margin: 0px 5px;
        font-weight: normal !important;
        font-family: sans-serif !important;
        font-size: 13px !important;
    }
</style>
<link href="~/Content/toastr.min.css" rel="stylesheet" />
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            @if (Convert.ToInt32(Session["RoleId"]) != 21) //for dealers
            {
                <a href="/dealer/dashboard">@PayTimeWebClient.Resource.Resource.mnuHome</a>
            }
            else
            {
                <a href="/dealer/managerdashboard">@PayTimeWebClient.Resource.Resource.Dashboard</a>
            }
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>
                Financial Setting
            </span>
        </li>
    </ul>
</div>
<div class="portlet-body">
    <div class="row">
        <div class="col-lg-5 col-md-6 col-sm-6 col-xs-12" style="margin-bottom: 10px;width: 100%;margin-left: 5px;">
            <div class="card_box" style="height:auto;margin-top:10px;">

                <div class="card-header">
                    Tax Master
                    <div class="actions_box" style="float: right;">
                        <button type="button" class="add-partner edittax"><i class="fa fa-pencil"></i> Edit Tax</button>
                        <button type="button" class="add-partner addtax" data-toggle="modal"><i class="fa fa-plus"></i> Add Tax</button>
                    </div>


                </div>


                <div class="clearfix"></div>
                <div class="card-body">
                    <label>Financial Year</label>
                    <input type="datetime"  />
                </div>
            </div>
        </div>
    </div>
</div>


