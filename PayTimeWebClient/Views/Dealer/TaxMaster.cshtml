@{
    ViewBag.Title = "Tax Master";
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _userid = HttpContext.Current.Session["UserId"].ToString();
    string _roleid = HttpContext.Current.Session["RoleId"].ToString();
       Layout = "~/Views/Shared/_PartnerLayout.cshtml";
}

<style>
    .card_box {
        display: block;
        padding: 0px;
        border: 1px solid #F5F5F5;
        border-radius: 10px !important;
        background-color: #F5F5F5;
        box-shadow: 2px 2px 5px #BDBDBD;
        height: 200px;
    }

        .card_box .card-header {
            color: #3598dc;
            font-size: 17px;
            font-weight: bolder;
            padding: 15px;
            border-bottom: 1px solid #3598dc;
        }

        .card_box .card-body {
            display: block;
            padding: 15px;
            display: -ms-flexbox;
            display: flex;
            -ms-flex-wrap: wrap;
            flex-wrap: wrap;
            -ms-flex-align: center !important;
            align-items: center !important;
            min-height: 160px;
        }

            .card_box .card-body p {
                margin: 0px;
                color: #757575;
                font-size: 14px;
                margin-bottom: 5px;
            }

                .card_box .card-body p b {
                    margin-right: 10px;
                }

        .card_box .card-header.date_header {
            padding-right: 200px;
            position: relative;
        }

    .date_box_card {
        padding: 0px;
        display: inline-block;
        float: right;
        width: 155px;
        line-height: 15px;
        margin-top: -7px;
        position: absolute;
        right: 10px;
    }

        .date_box_card p {
            margin: 0px;
            color: #364150;
            font-size: 12px;
            margin-bottom: 0px;
            width: 100%;
            display: inline-block;
        }

            .date_box_card p span {
                float: right;
            }

            .date_box_card p b {
                margin-right: 10px;
                color: #3598dc;
            }

    .card-footer {
        color: #2b8dd9;
        font-size: 17px;
        font-weight: bolder;
        padding: 10px 0px;
        text-align: right;
        width: 100%;
    }

    .add-partner {
        display: inline-block;
        padding: 0px 10px;
        background-color: #1c96cd;
        height: 30px;
        line-height: 28px;
        color: white;
        border-radius: 5px !important;
        box-shadow: 1px 1px 5px #ababab;
        border: 1px solid #1c96cd;
        margin: 0px 5px;
        font-weight: normal !important;
        font-family: sans-serif !important;
        font-size: 13px !important;
    }
</style>

<link href="~/Content/toastr.min.css" rel="stylesheet" />
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            @if (Convert.ToInt32(Session["RoleId"]) != 21) //for dealers
            {
            <a href="/dealer/dashboard">@PayTimeWebClient.Resource.Resource.mnuHome</a>
            }
            else
            {
            <a href="/dealer/managerdashboard">@PayTimeWebClient.Resource.Resource.Dashboard</a>
            }
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>
                Tax Master
            </span>
        </li>
    </ul>
</div>

<div class="portlet-body">
    <div class="row">
        <div class="col-lg-5 col-md-6 col-sm-6 col-xs-12" style="margin-bottom: 10px;width: 100%;margin-left: 5px;">
            <div class="card_box" style="height:auto;margin-top:10px;">

                <div class="card-header">
                    Tax Master
                    <div class="actions_box" style="float: right;">
                        <button type="button" class="add-partner edittax"><i class="fa fa-pencil"></i> Edit Tax</button>
                        <button type="button" class="add-partner addtax" data-toggle="modal" onclick="showModal()"><i class="fa fa-plus"></i> Add Tax</button>
                    </div>


                </div>


                <div class="clearfix"></div>
                <div class="card-body">
                    <div class="account_tax_details" style="width: 100% !important">
                        <table class="table table_Dashboard_data" id="tblTaxDashboard">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Tax Name</th>
                                    <th>Tax Value</th>
                                    <th>Tax Value In</th>
                                    <th>Is Applicable?</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade page-header" id="taxationModal" tabindex="-1" role="dialog" aria-labelledby="taxationModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="width:300px">
            <div id="ajax_loadertax" class="modal_bg loading" aria-hidden="true" style="z-index:100;display:none">
                <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
            </div>

            <div class="modal-header">
                <h5 class="modal-title" id="textModalLabel">Tax Master</h5>
            </div>
            <div class="modal-body" style="margin-left:40px">
                @using (Html.BeginForm("AddTaxation", "Dealer", FormMethod.Post))
                {
                <div class="form_group">
                    <span class="help-block" style="color: red;" hidden id="spvalidation"></span>
                </div>
                <div class="form_group">
                    <div class="form-group">
                        <label>Tax Name<span class="required" aria-required="true"> * </span></label>
                        <div class="input-group">
                            <input type="hidden" id="hdntaxid" />
                            <input type="text" name="txtname" id="txtname" maxlength="50" onkeypress="return blockSpecialCharAllowSpace(event);" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Tax Value In<span class="required" aria-required="true"> * </span></label>
                        <div class="input-group">
                            <select name="taxtype" id="taxtype">
                                <option value="0">--Select Type--</option>
                                <option value="1">Amount</option>
                                <option value="2">Percentage</option>
                            </select>

                        </div>
                    </div>
                    <div class="form-group">
                        <label>Tax Value<span class="required" aria-required="true"> * </span></label>
                        <div class="input-group">
                            <input type="text" name="txtamount" id="txtamount" maxlength="5" required>
                        </div>
                    </div>

                    <div class="form-group" style="display:none;" id="taxActiveBlock">
                        <label>Is Applicable ?<span class="required" aria-required="true"> * </span></label>
                        <div class="input-group">
                            <input type="checkbox" class="make-switch" data-size="small" id="taxActive" data-on-text="Yes" data-off-text="No" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <button type="button" class="add-partner" id="btnsavetax"><i class="fa fa-paper-plane-o"></i>Save</button>
                    <button type="button" class="add-partner" id="btncanceltax"> <i class="fa fa-close"></i>Cancel</button>
                </div>
                }
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/toastr.min.js"></script>
<script type="text/javascript">

    var checkAmount = 0;
    $(document).ready(function () {
        getTaxationData(6);

    })


    $("#taxtype").change(function () {
        var dValue = $("#taxtype option:selected").val();

        if (dValue === "1") {
            checkAmount = 1;

        } else if (dValue === "2") {
            checkAmount = 2;
        }
    })

    $("#btnsavetax").click(function () {
        var flg = true;
        flg = validatetaxform();
        if (flg == true) {
            taxsave();
        }
        else {
            return false;
        }
    });


    function validatetaxform() {
        var ret = true;

        if ($("#txtname").val().trim() == "") {
            $("#txtname").css("border-color", "red");
            ret = false;
        } else {
            $("#txtname").css("border-color", "");
        }

        if ($("#txtamount").val().trim() == "") {
            $("#txtamount").css("border-color", "red");
            ret = false;
        } else {
            $("#txtamount").css("border-color", "");
        }
        if ($("#taxtype option:selected").val() === "0") {
            $("#taxtype").css("border-color", "red");
            ret = false;
        } else if ($("#taxtype option:selected").val() === "2") {
            var valueofAm = parseInt($("#txtamount").val());
            if (valueofAm > 100) {
                toastr.error("Percentage should be between 0 to 99");
                ret = false;
            }
        }
        else {
            $("#taxtype").css("border-color", "");
        }

        return ret;
    }


    function taxsave() {
        var obj = taxsaveParam();
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'post',
            data: JSON.stringify(obj),
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Dealers/Taxregistrer',
            async: false,
            beforeSend: function () {
                $("#ajax_loadertax").show();
            },
            success: function (result) {
                if (result.MsgSts == "ok") {
                    frmtaxclear();

                    $('#taxationModal').modal('hide');
                    $("#ajax_loadertax").hide();
                    toastr.success(result.Msg);
                    getTaxationData(6);

                } else {
                    frmtaxclear();
                    $('#taxationModal').modal('hide');
                    $("#ajax_loadertax").hide();
                    toastr.error(result.Msg);

                }
            }
        });


    }


    function taxsaveParam() {


        var dd = $('#taxActive').prop('checked');
        var d = "";
        if ($("#hdntaxid").val() == "") {
            d = 1;
        } else {
            if ($('#taxActive').prop('checked')) {
                d = 1;
            } else {
                d = 0;
            }

        }



        return {
            taxparaid: $("#hdntaxid").val(),
            taxpara: $("#txtname").val(),
            taxparavalue: $("#txtamount").val(),
            taxparatype: $("#taxtype option:selected").val(),
            IsApplicable: d
        }
    }

    $("#btncanceltax").click(function () {

        frmtaxclear();
        //$("#taxActiveBlock").css("display", "none");
        $('#taxationModal').modal('hide');
    });


    function getTaxationData(para) {

        var obj = {
            "para": para,
            "dealerId": '@_userid',
            "iscount" : 0
        }

        
        var tblDealertax = $('#tblTaxDashboard').DataTable({
            "destroy": true,
            "processing": true,
            "ajax": {
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: function(d)
                {
                    return JSON.stringify(obj);
                },
                //{ "para": para, "dealerId": '@_userid', "iscount": iscount },  //para 2 means getActiveDealer & iscount 1 means get all active dealer.
                type: 'post',
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + 'Dealers/GetregisterDealers',
                async: false,
                dataSrc: ""

            },
            "columns": [
                         {
                             "data": "taxparaid",
                             "render": function (data, raw, full) {
                                 return '<input  type="checkbox" name="chkplanedit" id="' + full.taxparaid + '">';
                             }
                         },

                   { "data": "taxpara" },
                   { "data": "taxparavalue" },
                   {
                       "data": "taxparatype",
                       "render": function (data, raw, full) {

                           var str = "";
                           if (full.taxparatype == 1) {
                               str = '<span    id=' + full.taxparatype + '  ><i class="fa fa-rupee"></i></span>';
                           } else {
                               str = '<span  id=' + full.taxparatype + '>%</span>';
                           }

                           return str;
                       }
                   },

                   {
                       "data": "IsApplicable",
                       "render": function (data, raw, full) {

                           var str = "";
                           if (full.IsApplicable == 1) {
                               str = '<span>Applicable</span>';
                           } else {
                               str = '<span>Not Applicable</span>';
                           }

                           return str;
                       }
                   }
            ],
            'columnDefs': [
              {
                  "targets": 0, // your case first column
                  "className": "text-center",
              }
            ]
        });


    }

    $(".edittax").click(function () {

        if ($('input[name = chkplanedit]:checked').length == 0 || $('input[name = chkplanedit]:checked').length > 1) {
            toastr.error('Please select one tax for edit');
        }
        else {
            $("#taxActiveBlock").show();
            frmtaxclear();
            frmtaxfill();
        }
    });


    function frmtaxfill() {
        $("#tblTaxDashboard tbody tr").each(function () {

            var rows = $(this);
            if ($(this)[0].cells[0].firstChild.checked) {


                var dd = $(this)[0].cells[0].firstChild.id;
                $("#hdntaxid").val($(this)[0].cells[0].firstChild.id);
                $("#txtname").val($(this)[0].cells[1].innerText),
                $("#txtamount").val($(this)[0].cells[2].innerText)

                if ($(this)[0].cells[4].innerText == "Not Applicable") {
                    $('#taxActive').prop('checked', false).change();
                }
                else {
                    $('#taxActive').prop('checked', true).change();
                }
                
                var key = parseInt($(this)[0].cells[3].firstChild.id);

                $("#taxtype").val(key);


                $("#taxationModal").modal("show");

            }
        });
    }

    function frmtaxclear() {
        $("#hdntaxid").val(0);
        $("#txtname").val('');
        $("#txtamount").val(0);
        $("#taxtype").val(0);
        $('#taxActive').prop('checked', true).change();
        $("#txtname").css("border-color", "");
        $("#txtamount").css("border-color", "");
        $("#taxtype").css("border-color", "");

    }

    $("#txtname").blur(function () {
        if ($("#txtname").val().trim() == "") {
            $("#txtname").css("border-color", "red");
        } else {
            $("#txtname").css("border-color", "");
        }
    })

    $("#txtamount").blur(function () {
        if ($("#txtamount").val().trim() == "") {
            $("#txtamount").css("border-color", "red");
        } else {

            $("#txtamount").css("border-color", "");
        }
    })

    $("#taxtype").blur(function () {
        var d = $("#taxtype option:selected").val();
        if ($("#taxtype option:selected").val() === "0") {
            $("#taxtype").css("border-color", "red");
            status = false;
        } else {
            $("#taxtype").css("border-color", "");
        }
    })


    function blockSpecialCharAllowSpace(evt) {
        var k;
        if (evt.keyCode > 0) {
            k = evt.keyCode;
        } else if (typeof (evt.charCode) != "undefined") {
            k = evt.charCode;
        }
        return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
    }


    $('#txtamount').keypress(function (eve) {
        if (checkAmount == 1) {
            if ((eve.which != 46 || $(this).val().indexOf('.') == -1) && (eve.which < 48 || eve.which > 57) || (eve.which == 46 && $(this).caret().start == 0)) {
                eve.preventDefault();
            }
        }
        else if (checkAmount == 2) {

            if ((eve.which != 46 || $(this).val().indexOf('.') != -1) && (eve.which < 48 || eve.which > 57) || (eve.which == 46 && $(this).caret().start == 0)) {
                eve.preventDefault();
            }

            // this part is when left part of number is deleted and leaves a . in the leftmost position. For example, 33.25, then 33 is deleted
            $('#txtamount').keyup(function (eve) {
                if ($(this).val().indexOf('.') == 0) {
                    $(this).val($(this).val().substring(1));
                }
            });
        }
    });

    function showModal() {
        
        $("#taxActiveBlock").hide();
        $("#taxationModal").modal("show");
    }





</script>
<style>
    @@import url("../assets/Dealer/dealerdashboard.css");
</style>