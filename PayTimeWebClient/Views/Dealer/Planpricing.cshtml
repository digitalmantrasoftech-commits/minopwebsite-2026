@*<script src="~/Scripts/jquery-1.12.4.js"></script>*@
<script type='text/javascript'>
    var cmpuser = '@_cmpuser';
    var addOnIdCalculator = 0;
    var addonCount = 0;
    $(document).ready(function () {


        $("#Companyid").val(@_cmpid);


        var Addonddl = $("#ddladdonmaster").multiselect({
            selectallvalue: 'multiselect-all',
            enablecaseinsensitivefiltering: true,
            //includeSelectAllOption: true,
            allselectedtext: 'all select',
            enablefiltering: true,
            buttonwidth: '100%',
            enableclickableoptgroups: true,
            numberDisplayed: 10,
            maxHeight: 150,
            onChange: function (option, checked) {

                var selcount = $("#ddladdonmaster :selected").length;

                var addrow = selcount + 1;
                if (checked) {
                    addOnIdCalculator = option[0].value;
                    var strrow = '<tr id="row_' + option[0].value + '" > <td>' + option[0].label + '</td><td><select data-attr="dropdown"  id="ddlpackage_' + option[0].value + '"  onchange="fillvalue(' + option[0].value + ')"  ></select></td><td nowrap> Rate(Per Unit) : <span id="spnpackagerate_' + option[0].value + '"></span></td> <td nowrap>Quantity : <input type="number" min="0"  id="packqty_' + option[0].value + '" value="0"   onchange="calculateaddonrate(' + option[0].value + ');"   onkeyup="calculateaddonrate(' + option[0].value + ');"  /> </td> <td></td> <td></td> <td  style="font-weight: bold; text-align: left"  ></td> <td id="lblamt_' + option[0].value + '" style="font-weight: bold;" class="clspackamt">0</td> <td></td> <td></td> <td></td> </tr>';
                    $('#tbllicence > tfoot > tr').eq(2).after(strrow);
                    Filladdonpackage(option[0].value);
                }
                else {
                    $('#row_' + option[0].value).remove();
                    Showtotalprice()
                }
            },
        });


        document.getElementById("Duration").value = 30;
        $(".qnum").bind('keyup mouseup', function () {
            var _price = $(this).parent('td').parent('tr')[0].cells[5].innerText;
            var _qty = $(this).parent('td').parent('tr')[0].cells[6].firstChild.value;
            var _total = _price * _qty;
            $(this).parent('td').parent('tr')[0].cells[7].innerText = _total;
            var _discper = $(this).parent('td').parent('tr')[0].cells[10].innerText;
            var disctxt = "Discount : ";//+_disc+" %";
            var discamt = parseFloat(_total * _discper / 100);
            document.getElementById("lbldisc").innerText = disctxt + _discper + "%";
            document.getElementById("lbldiscamt").innerText = discamt.toFixed(2);
            var _pid = $(this).parent('td').parent('tr')[0].cells[8].innerText;
            document.getElementById("PlanId").value = _pid;
            document.getElementById("Disccount").value = discamt.toFixed(2);
            document.getElementById("DisccountPer").value = _discper;

            Showtotalprice();
        });

        //$(".qnum").keypress(function (evt) {
        //    evt.preventDefault();
        //});

        $(".qnum").on('change blur', function (event) {
            var inputval = parseInt($(this).val());
            //var maxvalue = parseInt($(this).attr('max'));
            var minvalue = parseInt($(this).attr('min'));
            //if (inputval > maxvalue) {
            //    $(this).val(maxvalue);
            //}
            if (inputval < minvalue) {
                $(this).val(minvalue);
            }
            $(this).keyup();
        });



        $("input[name=planmaster][value=3]").attr('checked', 'checked');

        Resetall(3);

        Bindaddonlist();


        $('title').replaceWith('<title>Minop | Buy Plan Subscription</title>');
        //$('#canonical').attr("href", 'http://minopcloud.com/pricing');
        $('meta[name=keywords]').replaceWith('<meta name="keywords" content="Cloud-based time and attendance software systems">');
        $('meta[name=description]').replaceWith('<meta name="description" content="Whether you are just starting out or ready to take you’re your attendance system to next level, we have got pricing plans that fit any budget. Upgrade your plan at anytime as per your need.">');
    });


    function Bindaddonlist() {
        $("#ddladdonmaster").empty();

        var obj = {
            'pkid': 0,
            'iscount': 0,
            'para': 2
        }

        //$("#ddladdonmaster").append("<option value='0'>--Select Add-On--</option>");
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'post',
            data: JSON.stringify(obj),
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Dealers/Getpartnerplan',
            async: false,
            success: function (response) {
                if (response.length > 0 && response != "") {
                    $(response).each(function (index, value) {
                        $("#ddladdonmaster").append("<option value='" + value["Addonid"] + "'>" + value["Addonshortname"] + "</option>");
                    })
                    $('#ddladdonmaster').multiselect('rebuild');
                }
            }
        });
    }


    function Filladdonpackage(adonid) {
        //addOnIdCalculator = addonid;
        var dllname = "#ddlpackage_" + adonid + "";

        $(dllname).empty();

        var obj = {
            'pkid': adonid,
            'iscount': 0,
            'para': 0
        }

        $(dllname).append("<option value='0' Packrate='0' Pmin='0' Pmax='0'>--Select Package--</option>");
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'post',
            data: JSON.stringify(obj),
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Dealers/GetAddonpackages',
            async: false,
            success: function (response) {
                if (response.length > 0 && response != "") {
                    $(response).each(function (index, value) {
                        $(dllname).append("<option value='" + value["Addonpackgeid"] + "' Packrate='" + value["Addonpackagerate"] + "' Pmin='" + value["Addonpackageminvalue"] + "' Pmax= '" + value["Addonpackgemaxvalue"] + "'   >" + value["Addonpackagesname"] + "</option>");
                    })
                }
            }
        });
    }

    function fillvalue(addonid) {
        addOnIdCalculator = addonid;
        var dllpack = "#ddlpackage_" + addonid + "";
        var lblrate = "#spnpackagerate_" + addonid + "";
        var pkqty = "#packqty_" + addonid + "";
        var selval = $(dllpack).val();
        var rate = parseFloat($(dllpack + ' option:selected').attr("Packrate"));
        var packmin = $(dllpack + ' option:selected').attr("Pmin") != null ? parseInt($(dllpack + ' option:selected').attr("Pmin")) : 0;
        var packmax = $(dllpack + ' option:selected').attr("Pmax") != null ? parseInt($(dllpack + ' option:selected').attr("Pmax")) : 0;

        $(lblrate).text(rate);
        $(pkqty).attr("min", packmin);
        //$(pkqty).attr("max", packmax);
        $(pkqty).val(packmin);

        //  $('.make-switch').change();
        //alert(rate);
        calculateaddonrate(addOnIdCalculator);
    }

    function calculateaddonrate(addonid) {
        addOnIdCalculator = addonid;
        var lblrate = "#spnpackagerate_" + addonid + "";
        var pkqty = "#packqty_" + addonid + "";
        var lblamt = "#lblamt_" + addonid + "";

        var packrate = parseFloat($(lblrate).text());
        var packqty = parseInt($(pkqty).val());

        var packamt = packrate * packqty;
        $(lblamt).text(packamt.toFixed(2));

        $('.make-switch').change();

    }

    function Resetall(planid) {
        var tpr = "tprice_" + planid;
        var uqty = "#qty_" + planid;
        //var rdid = "#Hasyearly_" + planid;
        //$(".make-switch").attr('disabled', 'disabled');
        //$('' + rdid + '').removeAttr("disabled");
        $(".qnum").attr('disabled', 'disabled');
        $('' + uqty + '').removeAttr("disabled");
        $(".qnum").val(0);
        $('' + uqty + '').attr("min", cmpuser);
        $('' + uqty + '').val(cmpuser);
        $("#PlanId").val(planid);
        $("#Quantity").val(0);
        $("#TotalAmount").val(0.00);
        $("#CGST").val(0.00);
        $("#SGST").val(0.00);
        $("#Disccount").val(0.00);
        $("#Duration").val(0);
        $("#Price").val(0.00);



        $("#tbllicence tbody tr").each(function () {
            $(this).find(".tprice").html(0);
            $('.make-switch').prop('checked', false).change();
        });
        var resetval = 0;
        document.getElementById("lbldiscamt").innerText = resetval;
        // document.getElementById("lblcgstamt").innerText = resetval;
        //  document.getElementById("lblsgstamt").innerText = resetval;
        document.getElementById("lblftotal").innerText = resetval;
        document.getElementById("TotalAmount").value = resetval;
        document.getElementById("lbltotalqty").innerText = resetval;
        document.getElementById("lbltotalprice").innerText = resetval;

        //Showtotalprice();

        $('' + uqty + '').keyup();
        calculateaddonrate(addOnIdCalculator);
    }
    function Getprice(planid, ppupm, ppupy) {
        var chkid = "#Hasyearly_" + planid;
        var prlblid = "pr_" + planid;
        var sprlblid = "spr_" + planid;
        var uqty = "#qty_" + planid;
        var tpr = "tprice_" + planid;
        var Hasyearly = $('' + chkid + '').is(":checked");
        var qty = $('' + uqty + '').val();
        var tpramt = 0.00;
        var caltprqt = 0.00;
        var daydur = 0;
        if (Hasyearly) {
            daydur = 365;
            tpramt = ppupy * daydur;
            document.getElementById(prlblid).innerHTML = ppupy;
        }
        else {
            daydur = 30;
            tpramt = ppupm * daydur;
            document.getElementById(prlblid).innerHTML = ppupm;
        }
        document.getElementById(sprlblid).innerHTML = tpramt.toFixed(2);
        if (qty > 0) {
            caltprqt = qty * tpramt;
            document.getElementById(tpr).innerHTML = caltprqt.toFixed(2);
            Recalculate(caltprqt);
        }
        document.getElementById("Duration").value = daydur;


        Showtotalprice();
    }
    function Recalculate(caltprqt) {
        document.getElementById("lbltotalprice").innerText = caltprqt.toFixed(2);
        var _discp = document.getElementById("DisccountPer").value;
        var _discamt = parseFloat(caltprqt * _discp / 100);
        document.getElementById("lbldiscamt").innerText = _discamt.toFixed(2);
        document.getElementById("Disccount").value = _discamt.toFixed(2);
        var _rfamtwd = caltprqt - _discamt;

        var famoutaddon = 0;
        $('.clspackamt').each(function () {
            var amtaddon = parseFloat($(this).text());
            famoutaddon = famoutaddon + amtaddon;

        });
        _rfamtwd = _rfamtwd + famoutaddon;

        var _rcgstamt = 0.00;
        var _rsgstamt = 0.00;

        var _cgst = document.getElementById("cgstper").value;
        var _sgst = document.getElementById("sgstper").value;

        if (_cgst > 0 || _sgst > 0) {
            if (_cgst > 0) {
                _rcgstamt = _rfamtwd * _cgst / 100;
            }
            if (_sgst > 0) {
                _rsgstamt = _rfamtwd * _sgst / 100;
            }
        }

        var _rfgstamt = _rfamtwd + _rcgstamt + _rsgstamt;
        document.getElementById("lblftotal").innerText = _rfgstamt.toFixed(2);
        document.getElementById("TotalAmount").value = _rfgstamt.toFixed(2);
        document.getElementById("CGST").value = _rcgstamt.toFixed(2);
        document.getElementById("SGST").value = _rsgstamt.toFixed(2);




    }
    var arraylst = [];
    function Showtotalprice() {
        var sumq = 0;
        var sumtp = 0;
        var _cgst = 0;
        var _sgst = 0;
        var _amout = 0.00;
        var _per = 0.00;
        var Taxamout = 0;
        var totalTaxAmount = 0.00;
        var taxstring = "";
        var sumtpwdis = 0.00;
        var amtaddon = 0.00;
        var total = 0.00;

        $("#tbllicence tbody tr").each(function () {
            var rows = $(this);
            if ($(this)[0].cells[0].firstChild.checked) {
                var _pq = parseInt($(this).find('td:eq(6)').find('.qnum').val(), 10);
                sumq = sumq + _pq;
                var _pp = parseInt($(this).find(".tprice").html(), 10);
                sumtp = sumtp + _pp;

                var _taxpara = $(this).find(".Taxrate").html();
                var _taxarr = _taxpara.split(',');

                var sumtpwdis = 0.00;
                var amtaddon = 0.00;
                var disamt = document.getElementById("lbldiscamt").innerText;

                sumtpwdis = sumtp - disamt;

                $('.clspackamt').each(function (index,value) {

                    amtaddon = amtaddon + parseFloat($(this).text());
                });

                total = sumtpwdis + amtaddon;


                if (_taxarr.length > 0) {
                    for (var i = 0; i < _taxarr.length; i++) {
                        $('#row' + i).remove();

                    }
                }

                if (_taxarr.length > 0) {
                    for (var i = 0; i < _taxarr.length; i++) {

                        _cgst = _taxarr[i].split(':')[0];
                        _amout = _taxarr[i].split(':')[1];
                        _per = _taxarr[i].split(':')[2];
                        var persymbol = "";

                        if (_per == 1) {
                            Taxamout = _amout;

                        } else {
                            Taxamout = parseFloat(total * _per / 100).toFixed(2);
                            persymbol = _per + "%";
                        }

                        var strrow1 =
                                     '<tr id="row' + i + '" ><td></td>' +
                                     '<td></td>' +
                                     '<td></td>' +
                                     '<td></td>' +
                                     '<td></td>' +
                                     '<td></td>' +
                                     '<td id="lblcgst_' + _cgst + '" style="font-weight: bold; text-align: left">' + _cgst + ':' + persymbol + '</td>' +
                                     '<td id="lblcgstamt" class="clstaxamt" style="font-weight: bold;">' + Taxamout + '</td>' +
                                     '<td></td>' +
                                     '<td></td>' +
                                     '<td></td></tr>';
                        $('#tbllicence > tfoot > tr').eq(-3).after(strrow1);



                        taxstring += "TaxName : " + _cgst + " TaxAmount: " + Taxamout + " TaxPer: " + _per + " TaxVtype :" + _per + ",";
                        totalTaxAmount = totalTaxAmount + parseFloat(Taxamout);

                    }

                }
            }
            if (addOnIdCalculator != undefined && addOnIdCalculator != 0 &&  addOnIdCalculator != "") {
                var dd = parseInt($("#ddlpackage_"+parseInt(addOnIdCalculator) +" option:selected").val());

                if( dd != "" && dd != 0)
                {
                    var obj = {
                        Addonid: parseInt(addOnIdCalculator),
                        AddonPackgeid: parseInt($("#ddlpackage_"+parseInt(addOnIdCalculator) +" option:selected").val()),
                        Packageunitrate: parseFloat($("#spnpackagerate_" + parseInt(addOnIdCalculator)).text()),
                        Unitquantity: parseFloat($("#packqty_" + parseInt(addOnIdCalculator)).val()),
                        Packagetotalamt: parseFloat($("#lblamt_" + parseInt(addOnIdCalculator)).text())

                    }
                    if (arraylst.length > 0) {

                        $.each(arraylst, function (index, value) {

                            if(arraylst.filter(m => m.Addonid == addOnIdCalculator).length > 0)
                            {
                                if(value.Addonid ==addOnIdCalculator )
                                {
                                    arraylst.splice(index,1);
                                }
                            }
                        })

                    }

                    arraylst.push(obj);
                    addOnIdCalculator = 0;
                }

