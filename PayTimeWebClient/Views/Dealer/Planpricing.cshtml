                                    <td id="lbltotalqty" style="font-weight: bold;">0</td>
                                    <td id="lbltotalprice" style="font-weight: bold;">0</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td id="lbldisc" style="font-weight: bold; text-align: left"></td>
                                    <td id="lbldiscamt" style="font-weight: bold;">0</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                                <tr id="traddon">
                                    <td style="font-weight: bold; text-align: left;" nowrap>Add-On</td>
                                    <td><select style='width: 150px; float: left; margin-right: 10px; height: 30px; border-radius: 5px !important;' aria-haspopup="true" aria-expanded="false" multiple="multiple" name="ddladdonmaster" id='ddladdonmaster'></select></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                                @*<tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td style="font-weight: bold; text-align: left">Tax :</td>
                                        <td style="font-weight: bold; text-align: left"></td>
                                        <td style="font-weight: bold;"></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>*@
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td style="font-weight: bold; text-align: left">Total :</td>
                                    <td id="lblftotal" style="font-weight: bold;">0</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td colspan="11" align="right">
                                        <form method="post" id="frmForm" action="Planpricing">
                                            <input type="hidden" id="PlanId" name="PlanId" />
                                            <input type="hidden" id="Companyid" name="Companyid" />
                                            @*<input type="hidden" id="Addonid" name="lstcmpaddonpack.Addonid" />
                                                    <input type="hidden" id="AddonPackgeid" name="lstcmpaddonpack.AddonPackgeid" />
                                                <input type="hidden" id="Packageunitrate" name="lstcmpaddonpack[0].Packageunitrate" />
                                                <input type="hidden" id="Unitquantity" name="lstcmpaddonpack[0].Unitquantity" />
                                                <input type="hidden" id="Packagestartdate" name="lstcmpaddonpack[0].Packagestartdate" />
                                                <input type="hidden" id="Packageenddate" name="lstcmpaddonpack[0].Packageenddate" />
                                                <input type="hidden" id="Packagetotalamt" name="lstcmpaddonpack[0].Packagetotalamt" />*@
