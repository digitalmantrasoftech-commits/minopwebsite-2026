<script type="text/javascript">
    $(document).ready(function () {

       
        WizardReset();
        $("#fnFinishModalById").hide();
        getAddOnPackage(7);
    });

    function WizardReset() {

        $('#smartwizard').smartWizard({

            selected: 0,  // Initial selected step, 0 = first step
            keyNavigation: true, // Enable/Disable keyboard navigation(left and right keys are used if enabled)
            enableAllSteps: true,
            autoAdjustHeight: true, // Automatically adjust content height
            cycleSteps: false, // Allows to cycle the navigation of steps
            backButtonSupport: true, // Enable the back button support
            useURLhash: false, // Enable selection of the step based on url hash
            lang: {  // Language variables
                next: 'Next',
                previous: 'Previous'
            },
            toolbarSettings: {
                toolbarPosition: 'bottom', // none, top, bottom, both
                toolbarButtonPosition: 'right', // left, right
                showNextButton: true, // show/hide a Next button
                showPreviousButton: true, // show/hide a Previous button
                toolbarExtraButtons: [
          $('<button></button>').text('Finish')
                        .addClass('btn btn-info')
                        .on('click', function () {
                            fnFinishModalById();
                        }).attr("Id", "fnFinishModalById"),
          $('<button></button>').text('Cancel')
                    .addClass('btn btn-danger')
                    .on('click', function () {
                        fnCloseAddonModal();
                    }).attr("Id", "fnCloseModalById")
                ]
            },
            anchorSettings: {
                anchorClickable: true, // Enable/Disable anchor navigation
                enableAllAnchors: false, // Activates all anchors clickable all times
                markDoneStep: true, // add done css
                enableAnchorOnDoneStep: true // Enable/Disable the done steps navigation
            },
            contentURL: null, // content url, Enables Ajax content loading. can set as data data-content-url on anchor
            disabledSteps: [],    // Array Steps disabled
            errorSteps: [],    // Highlight step with errors
            theme: 'dots',
            transitionEffect: 'fade', // Effect on navigation, none/slide/fade
            transitionSpeed: '400'
        });



    }
    //$("#smartwizard").on("showStep", function (e, anchorObject, stepNumber, stepDirection, stepPosition) {
    

    //    if (stepPosition === 'first') {
    //        $("#prev-btn").addClass('disabled');
    //        $("#btnfin").hide();
    //    } else if (stepPosition === 'final') {
    //        $("#next-btn").addClass('disabled');
    //        $("#btnfin").show();
    //    } else {
    //        $("#btnfin").hide();
    //        $("#prev-btn").removeClass('disabled');
    //        $("#next-btn").removeClass('disabled');
    //    }
    //});

    $("#smartwizard").on("leaveStep", function (e, anchorObject, stepNumber, stepDirection) {
        
        if (stepNumber == 0) {
            var res = validateSteps(stepNumber);
            if (res == true) {
                //SaveCompanyInfo();
                moveNext = fnSaveAddOnByFinish();

                if (moveNext == true) {
                    res = true;
                } else {
                    res = false;
                }
            }
            return res;
        }

        //else {
        //    return false;
        //}
    });

    function validateSteps(stepnumber) {
        var isStepValid = true;
        
        if (stepnumber == 0) {

            if ($("#txtaddonshortname").val().trim() == "") {
                $("#txtaddonshortname").css("border-color", "red");
                isStepValid = false;
            } 

            if ($("#txtadonname").val().trim() == "") {
                $("#txtadonname").css("border-color", "red");
                isStepValid = false;
            }
        }
        return isStepValid;
    }
    var tblDealertax;
    function getAddOnPackage(para) {
        var obj = {
            "para": 7,
            "dealerId": '@_userid',
            "iscount" : 0
        }
        tblDealertax = $('#tblAddOnDashboard').DataTable({
            "destroy": true,
            "processing": true,
            "ajax": {
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data:function(d){
                    return JSON.stringify(obj);
                },
                 //{ "para": 7, "dealerId": '@_userid', "iscount": iscount },  //para 2 means getActiveDealer & onseiscount 1 means get all active dealer.
                type: 'post',
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + 'Dealers/GetregisterDealers',
                async: false,
                dataSrc: ""

            },
            "columns": [
                         {
                             "class": "details-control",
                             "orderable": false,
                             "data": null,
                             "defaultContent": "",
                             "render": function (full,data,raw) {
                                 return '<span   id=faArraw_' + full.Addonid + ' class="fa fa-arrow-right" ></span>'
                             }
                         },
                         {
                             "data": "Addonid",
                             "render": function (data, raw, full) {
                                 return '<input  type="checkbox" name="chkaddonedit" id="' + full.Addonid + '">';
                             }
                         },
                   { "data": "Addonname" },
                   { "data": "Addonshortname" },
                   {
                       "data": "IsActive",
                       "render": function (data, raw, full) {

                           var str = "";
                           if (full.IsActive == 1) {
                               str = '<span>Applicable</span>';
                           } else {
                               str = '<span>Not Applicable</span>';
                           }

                           return str;
                       }
                   }
            ],
            'columnDefs': [
              {
                  "targets": 1, // your case first column
                  "className": "text-center",
              }
            ]
        }).on('click', 'td.details-control', function () {
            
            var tr = $(this).closest('tr');
            var row = $('#tblAddOnDashboard').DataTable().row(tr);
            var pkid = parseInt($($($(tr).children()[1]).html())[0].id);

            if (row.child.isShown()) {
                // This row is already open - close it

                setArrow(pkid);
                row.child.hide();
                tr.removeClass('shown');
            }
            else {
                setArrow(pkid);
                format(row.child, pkid);  // create new if not exist
                tr.addClass('shown');
            }
        });

        function setArrow(pkid) {
            
            
            //var dd = $("#faArraw_" + pkid).removeClass("fa fa-arrow-right");

            var className = $("#faArraw_" + pkid).attr('class');

            if (className === "fa fa-arrow-right") {
                $("#faArraw_" + pkid).removeClass("fa fa-arrow-right");
                $("#faArraw_" + pkid).addClass("fa fa-arrow-down");

            } else {
                $("#faArraw_" + pkid).removeClass("fa fa-arrow-down");
                $("#faArraw_" + pkid).addClass("fa fa-arrow-right");
                
            }
                        
        }

        function format(callback, pkid) {
            $.ajax({
                contenttype: 'application/json; charset=utf-8',
                datatype: 'json',
                data: { "para": 0, "pkid": pkid, "iscount": 0 },  //para 2 means getactivedealer & onseiscount 1 means get all active dealer.
                type: 'post',
                headers: { 'authorization': '@_tokan' },
                url: '@_webapiurl' + 'dealers/getaddonpackages',
                async: false,
                complete: function (response) {
                    
                    var data = JSON.parse(response.responseText);
                    var thead = '', tbody = '';

                    thead += '<th>Package Name</th>' +
                            '<th>Package Rate</th>' +
                            '<th>Package Minvalue</th>' +
                            '<th>Packge Maxvalue</th>' +
                            '<th>Package Applicable?</th>' +
                            '<th hidden>addonPackageid</th>' +
                            '<th hidden>addonId</th>'+
                            '<th></th>';

                    
                    $.each(data, function (i, d) {
                        var packapplicable = "";
                        if (d.Addonpackageisactive == 1) {
                            packapplicable = "Applicable";
                        } else if (d.Addonpackageisactive == 0) {
                            packapplicable = "Not Applicable";
                        }

                        tbody += '<tr    class=appendEdit_' + d.Addonpackgeid + ' ><td  class=appendEdit_' + d.Addonpackagesname + ' >' + d.Addonpackagesname + '</td>' +
                                            '<td class=appendEdit_' + d.Addonpackagerate + ' >' + d.Addonpackagerate + '</td>' +
                                            '<td class=appendEdit_' + d.Addonpackageminvalue + '>' + d.Addonpackageminvalue + '</td>' +
                                            '<td class=appendEdit_' + d.Addonpackgemaxvalue + '>' + d.Addonpackgemaxvalue + '</td>' +
                                            '<td class=appendEdit_' + packapplicable + '>' + packapplicable + '</td>' +
                                            '<td class=appendEdit_' + d.Addonpackgeid + '  hidden>' + d.Addonpackgeid + '</td>' +
                                            '<td class=appendEdit_' + d.Addonid + ' hidden>' + d.Addonid + '</td>' +
