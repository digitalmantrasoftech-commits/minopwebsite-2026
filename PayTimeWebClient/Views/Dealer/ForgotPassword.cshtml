
@{
    ViewBag.Title = "ForgotPassword";
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    var strmsg = "";
    var strmegsts = "";
    if (TempData["meg"] != null)
    {
        strmsg = TempData["meg"].ToString();
    }
    if (TempData["MegSts"] != null)
    {
        strmegsts = TempData["MegSts"].ToString();
    }
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
