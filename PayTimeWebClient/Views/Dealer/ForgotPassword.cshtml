<body class="dealerlogin_body">
    <table class="layout_body">
        <tbody>
            <tr class="logo_tr">
                <td>
                    <a href="~/Dealer/login" class="logo">
                        <img src="~/LandingAssets/images/minop-logo.png" />
                        <span class="logo_tag_line">Attendance on the Cloud</span>
                    </a>
                </td>
            </tr>
            <tr class="main_box">
                <td>
                    <div class="Forgot_Password_box">
                        <div id="divlogin" style="display:none;">
                            <div class="col-md-12">
                                <p id="lblsuccess"> Password updated successfully !</p>
                                <p> <a href="/Dealer/Login">Click here To Login!</a> </p>
                                <div style="clear: both;"></div>
                            </div>
                        </div>
                        <div class="Send_OTP_box">
                            <h1 style="white-space:nowrap">Partner Forgot Password</h1>
                            <form>
                                <div class="form-group">
                                    <label for="UserEmail">Email<span class="required" aria-required="true"> * </span></label>
                                    <input type="Email" name="UserEmail" class="form-control" id="UserEmail" placeholder="Please enter email">
                                </div>
                                <button class="Send_OTP_btn" name="Send_OTP_btn" type="button" onclick="return getOtp();"><i class="fa fa-paper-plane-o"></i>Send OTP</button>
                            </form>
                        </div>
                        <div class="get_OTP_box" style="display:none;">
                            <div id="ajax_loaderbranch" class="modal_bg loading" aria-hidden="true" style="display:none">
                                <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
                            </div>
                            <h1 style="white-space:nowrap" >Partner Forgot Password</h1>
                            @using (Html.BeginForm("ResetDealerPassword", "Dealer", FormMethod.Post, new { @id = "btnForgotPassword" }))
                            {
                                 <input type="text" name="enotp"   style="display:none;" class="form-control" id="encryptedOpt">                                                                  
                                <div class="form-group">
                                    <label for="OTP">Enter OTP<span class="required" aria-required="true"> * </span></label>
                                    <input type="text" name="OTP" class="form-control" id="OTP" placeholder="Please enter otp">
                                    <span class="help-block" style="color:red;" hidden id="otpVal"></span>
                                </div>
                                <div class="form-group">
                                    <label for="Password">Password<span class="required" aria-required="true"> * </span></label>
                                    <input type="password" name="Password" class="form-control" id="Password" placeholder="Please enter password">
                                    <span class="help-block" style="color:red;" hidden id="pasVal"></span>
                                </div>
                                <div class="form-group">
                                    <label for="Confirm_Password">Confirm Password<span class="required" aria-required="true"> * </span></label>
                                    <input type="password" name="Confirm_Password" class="form-control" id="Confirm_Password" placeholder="Please enter confirm password">
                                    <span class="help-block" style="color:red;" hidden id="conPasVal"></span>
                                </div>
                                <button class="OTP_Verification_btn" onclick="return loginValidate();" name="OTP_Verification_btn" type="button">
                                <i class="fa fa-check-square-o"></i>Submit
                                </button>  
                            }
                        </div>
                        @*<div class="Confirm_Password_box" style="display:none;">
                            <h1>Dealer Forgot Password</h1>
                            <form>
                                
                                <button class="Confirm_Password_btn" name="Confirm_Password_btn" type="button"><i class="fa fa-key"></i>Confirm Password</button>
                            </form>
                        </div>*@
                        <div class="other_part_url_box">
                            @*<a class="register_box_btn" href="~/Dealer/login">Register Now !</a>*@
                            <a class="forgot_password_login_btn" href="~/Dealer/login">Login ?</a>
                        </div>
                        @*<div class="social_icon_box">
                            <a class="facebook_icon" target="_blank" href="https://www.facebook.com/Mantra-Softech-India-Pvt-Ltd-197999890258174/info/?tab=page_info"><i class="fa fa-facebook"></i></a>
                            <a class="google_plus_icon" target="_blank" href="https://plus.google.com/105269249509614442444"><i class="fa fa-google-plus"></i></a>
                            <a class="twitter_icon" target="_blank" href="https://twitter.com/mantratec"><i class="fa fa-twitter"></i></a>
                            <a class="linkedin_icon" target="_blank" href="https://www.linkedin.com/company/mantra-softech-india-pvt-ltd/"><i class="fa fa-linkedin"></i></a>
                        </div>*@
                    </div>
                </td>
            </tr>
            <tr class="copright_line_tr">
                <td>
                    <div class="copright_line">Copyright © <script>document.write(new Date().getFullYear())</script> <a href="https://www.mantratec.com/" target="_blank">Mantra Softech (India) Pvt. Ltd.</a> All Rights Reserved.</div>
                </td>
            </tr>
        </tbody>
    </table>

    <!-- BEGIN VENDOR JS-->

    <!-- all -->
    <script src="~/LandingAssets/js/jquery.min.js"></script>
    <script src="~/LandingAssets/js/bootstrap.min.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>

    
    @*<script src="~/assets/Dealer/dealercustom.js"></script>*@
    <!-- all -->
    <script type="text/javascript">

        $(document).ready(function () {
            var stsmsg='@strmegsts';
            if(stsmsg =='ok'){
                $(".Send_OTP_box").hide();
                $(".Confirm_Password_box").hide();
                $(".get_OTP_box").hide();
                $("#divlogin").show();
                $(".other_part_url_box").hide();
                $(".social_icon_box").hide();
            }
            else {
                $("#divlogin").hide();
            }

        })

        function getOtp() {
            
            $(".loading").show();
            if ($("#UserEmail").val() != "") {
                var email = $("#UserEmail").val();
                        $.ajax({
                            contentType: 'application/json',
                            dataType: 'json',
                            type: 'post',
                            url: '@_webapiurl' + 'Dealers/DealerforgotPassword?Email='+email,
                            async: false,
                            success: function (response) {
                                
                                if (response.MsgSts == 'ok') {
                                    $(".Send_OTP_box").hide();
                                    $(".Confirm_Password_box").hide();
                                    $(".get_OTP_box").show();
                                    $("#OTP").val("");
                                    $("#Confirm_Password").val("");
                                    $("#Password").val("");
                                    $("#encryptedOpt").val(response.Msg);
                                    toastr.info("Otp has been sent to your registered email.");
                                    $(".loading").hide();

                                } else {
                                    toastr.remove();
                                    toastr.error(response.Msg);
                                    $(".loading").hide();
                                }
                            }
                           
                        });
            } else {
                $("#UserEmail").css("border-color", "red");
                return false;
            }
        }
        function loginValidate() {
            var frmStatus = true;
            if ($("#Password").val().trim() != $("#Confirm_Password").val().trim()) {
                toastr.remove();
                toastr.error("Password & confirm password should be match.");
                frmStatus = false;
            }
            if ($("#OTP").val() == "") {
                $("#OTP").css("border-color", "red");
                frmStatus = false;
            }
            if ($("#Confirm_Password").val() == "") {
                $("#Confirm_Password").css("border-color", "red");
                frmStatus = false;
            }
            if ($("#Password").val().trim() == "") {
                $("#Password").css("border-color", "red");
                frmStatus = false;
            }

            if (!frmStatus) { return false; } else { $("#btnForgotPassword").submit(); }
        }
    </script>
</body>
</html>


