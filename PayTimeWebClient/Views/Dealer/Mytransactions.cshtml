@{

    ViewBag.Title = "My Transactions";
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _dealerid = HttpContext.Current.Session["DealerId"].ToString();
    Layout = "~/Views/Shared/_PartnerLayout.cshtml";
}


<style>
    .card_box {
        display: block;
        padding: 0px;
        border: 1px solid #F5F5F5;
        border-radius: 10px !important;
        background-color: #F5F5F5;
        box-shadow: 2px 2px 5px #BDBDBD;
        height: 200px;
    }

        .card_box .card-header {
            color: #3598dc;
            font-size: 17px;
            font-weight: bolder;
            padding: 15px;
            border-bottom: 1px solid #3598dc;
        }

        .card_box .card-body {
            display: block;
            padding: 15px;
            display: -ms-flexbox;
            display: flex;
            -ms-flex-wrap: wrap;
            flex-wrap: wrap;
            -ms-flex-align: center !important;
            align-items: center !important;
            min-height: 160px;
        }

            .card_box .card-body p {
                margin: 0px;
                color: #757575;
                font-size: 14px;
                margin-bottom: 5px;
            }

                .card_box .card-body p b {
                    margin-right: 10px;
                }

        .card_box .card-header.date_header {
            padding-right: 200px;
            position: relative;
        }

    .date_box_card {
        padding: 0px;
        display: inline-block;
        float: right;
        width: 155px;
        line-height: 15px;
        margin-top: -7px;
        position: absolute;
        right: 10px;
    }

        .date_box_card p {
            margin: 0px;
            color: #364150;
            font-size: 12px;
            margin-bottom: 0px;
            width: 100%;
            display: inline-block;
        }

            .date_box_card p span {
                float: right;
            }

            .date_box_card p b {
                margin-right: 10px;
                color: #3598dc;
            }

    .card-footer {
        color: #2b8dd9;
        font-size: 17px;
        font-weight: bolder;
        padding: 10px 0px;
        text-align: right;
        width: 100%;
    }
</style>


<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            @if (Convert.ToInt32(Session["RoleId"]) != 21) //For Dealers
            {
            <a href="/Dealer/Dashboard">@PayTimeWebClient.Resource.Resource.mnuHome</a>
            }
            else
            {
            <a href="/Dealer/Managerdashboard">@PayTimeWebClient.Resource.Resource.Dashboard</a>
            }
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>
                My Transactions
            </span>
        </li>
    </ul>
</div>
<div class="portlet-body">
    <div class="row">
        <div class="col-lg-5 col-md-6 col-sm-6 col-xs-12" style="margin-bottom: 10px;width: 100%;margin-left: 5px;">
            <div class="card_box" style="height:auto">
                <div class="card-header">
                    My Commission  
                </div>
                <div >
                    <span id="totalcommition"></span>
                </div>
                <div class="card-body">
                    <div class="account_plan_details" style="width: 100% !important">
                        <table class="table table_Dashboard_data" id="tblpaymencommission">
                            <thead>
                                <tr>
                                    <th>Sr.No</th>
                                    <th>Company Name</th>
                                    <th>PaymentID</th>
                                    <th>Payment Amount (<i class="fa fa-rupee"></i>)</th>
                                    <th>Commission Amount (<i class="fa fa-rupee"></i>)</th>
                                    <th>Payment Date</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var _did = parseInt('@_dealerid');
    $(document).ready(function () {
        var _urltblpay = '@_webapiurl' + 'Dealers/Getmycommission';
        var obj = {
            'iscount': 0,
            'para': 0,
            'pkid': _did
        }
        var t = $('#tblpaymencommission').DataTable(
            {
                "processing": true,
                "ajax": {
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: function (d) {
                        return JSON.stringify(obj);
                    },
                    type: 'post',
                    url:_urltblpay,
                    headers: { 'Authorization': '@_tokan' },
                    dataSrc: ''

                },
                "columns": [
                    { "data": null },
                    { "data": "CompanyName" },
                    { "data": "PaymentID" },
                    { "data": "PaymentAmount" },
                    { "data": "Commission" },
                    { "data": "PaymentDate" },
                ],
                "columnDefs": [
                    //{
                        
                    //    "data": null,
                    //    "render": function (data, type, full, meta) {
                    //        document.getElementById('totalcommition').innerText = full.TotalCommission;
                    //        return data;
                    //    }
                    //},
                    {
                        "searchable": true,
                        "orderable": false,
                        "targets": 0
                    }
                ],

            }
        );
        t.on('order.dt search.dt', function () {
            t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();


    });
</script>
<style>
    @@import url("../assets/Dealer/dealerdashboard.css");
</style>
