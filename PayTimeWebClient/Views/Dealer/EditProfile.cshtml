@model PayTimeWebClient.Models.ReqUpdateAdminInfo
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "DealerEditProfile";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _flag = ViewBag.flag;
    //string _AdminImg = HttpContext.Current.Session["photo"].ToString();
    string strsuccess = "";
    string strerror = "";
    string strflag = "";
    if (TempData["msg"] != null)
    {
        strsuccess = TempData.Peek("msg").ToString();
    }
    if (TempData["error"] != null)
    {
        strerror = TempData.Peek("error").ToString();
    }
    if (TempData["flag"] != null)
    {
        strflag = TempData.Peek("flag").ToString();
    }
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _UserImg = HttpContext.Current.Session["photo"].ToString();

}

<script src="~/Scripts/toastr.min.js"></script>
<script type="text/javascript">

    var useremail = '@Session["UserEmail"]';
    $(document).ready(function () {


        $('#MobileNo').bind('cut copy paste', function (e) {
            e.preventDefault(); //disable cut,copy,paste
        });
        $('#PhoneNo').bind('cut copy paste', function (e) {
            e.preventDefault(); //disable cut,copy,paste
        });


        $('#MobileNo').keypress(function (e) {
            if (this.value.length == 0 && e.which == 48) {
                return false;
            }
        });

        $(".alert").hide();
        if ("@_Message" != "") {
            $("#viewbagerrdiv").hide();
            $("#viewbagdiv").show();
        }
        if ('@_error' != "") {
            $("#viewbagerrdiv").show();
            $("#viewbagdiv").hide();
        }
        if ("@strsuccess" != "") {
            $(".cancel").hide();
            $(".done").show();
        }
        if ('@strerror' != "") {
            $(".cancel").show();
            $(".done").hide();
        }

        if ("@strflag" == "1") {
            $("#tab_1-1").removeClass("active");
            $("#tab_2-2").addClass("active");
            $("#li1").removeClass("active");
            $("#li2").addClass("active");
        }

        $("#btncancelperinfo").click(function () {
            location.reload();
        });

        $("#RePassword").change(function () {
            var newpass = $("#NewPassword").val();
            if (newpass != $("#RePassword").val()) {
                $("#spPasswordnotmatch").html("New Password and Confirm Password not match").show();
                return false;
            }
            else {
                $("#spPasswordnotmatch").hide();
            }
        });

        var id = '@Session["UserId"]';
        //   alert(id);
        $.ajax({
            type: 'GET',
            async: false,
            url: "/Dealer/GetDealerInfoById",
            data: { id: id },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (result) {


                if (result.isRedirect) {
                    window.location.href = result.redirectUrl;
                }
                var obj = JSON.parse(result);
                $("#Name").val(obj[0].Name);
                $("#Address").val(obj[0].Address);
                $("#DealerCode").val(obj[0].DealerCode);

                if (obj[0].MobileNo == 0) {
                    $("#MobileNo").val("");
                }
                else {
                    $("#MobileNo").val(obj[0].MobileNo);
                }
                if (obj[0].PhoneNo == 0) {
                    $("#PhoneNo").val("");
                }
                else {
                    $("#PhoneNo").val(obj[0].PhoneNo);
                }
                //var date = new Date(obj[0].DateOfBirth);
                // $("#DateOfBirth").val(date.getFullYear() + '-' + (date.getMonth() +1) + '-' + date.getDate());


                var empdob = moment(obj[0].DateOfBirth, "YYYY-MM-DDhh:mm:ss").format("YYYY-MM-DD");
                $("#DateOfBirth").val(empdob);
                $("#DateOfBirth").datepicker('setDate', new Date(empdob));
                $("#EmpAddress").text(obj[0].EmpAddress);
                var gender = obj[0].Gender;
                if (gender == 1) {
                    $("#GenderM").prop('checked', true);
                }
                if (gender == 0) {
                    $("#GenderF").prop('checked', true);
                }
                var married = obj[0].IsMarried;
                if (married == false) {
                    $("#Empsingle").prop('checked', true);
                }
                if (married == true) {
                    $("#EmpMarried").prop('checked', true);
                }

                if (obj[0].Photo != "") {
                    $("#Photo").val(obj[0].Photo);
                    $("#empimg").attr("src", "/DealerLogo/" + obj[0].Photo);
                }
                else {
                    $("#Photo").val(obj[0].Photo);
                    $("#empimg").attr("src", "/assets/images/avtar.png");
                }


            },
            error: function (xhr, ajaxOptions, thrownError) {
                toastr.error("Something wrong. Please try again.");

            }
        });


        $("#btnsubmit").click(function (event) {

            if ($("#Name").val().trim() == "") {
                $("#Name").attr('required', true);
                $("#Name").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#Name").removeClass('field_error');
            }
            if ($("#DateOfBirth").val() == "") {
                $("#DateOfBirth").attr('required', true);
                $("#DateOfBirth").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#DateOfBirth").removeClass('field_error');
            }
            if ($("#MobileNo").val().length != 10) {
                $("#MobileNo").addClass('field_error');
                $("#spEmpMNo").html("required 10 digits, match requested format!").show();
                event.preventDefault();
                return false;

            }
            else {
                $("#MobileNo").removeClass('field_error');
                $("#spEmpMNo").hide();

            }
            //if ($("#PhoneNo").val() != "") {
            //    if ($("#PhoneNo").val().length != 10) {
            //        $("#PhoneNo").addClass('field_error');
            //        $("#spPhono").html("required 10 digits, match requested format!").show();
            //        event.preventDefault();
            //        return false;
            //    }
            //    else {
            //        $("#PhoneNo").removeClass('field_error');
            //        $("#spPhono").hide();
            //    }
            //}

        });

        $("#PhoneNo").keypress(function (e) {
            $("#PhoneNo").removeClass('field_error');
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {

                return false;
            }

        });
        $("#PhoneNo").change(function () {
            if ($("#PhoneNo").val().length >= 10) {
                //$("#spPhono").hide();
                $("#PhoneNo").removeClass('field_error');
                return false;
            }
        });

        $("#MobileNo").keypress(function (e) {
            $("#MobileNo").removeClass('field_error');
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {

                return false;
            }
        });
        $("#MobileNo").change(function () {
            if ($("#MobileNo").val().length >= 10) {
                $("#spEmpMNo").hide();
                $("#MobileNo").removeClass('field_error');
                return false;
            }
        });

        $("#Name").keypress(function (e) {
            $("#Name").removeClass('field_error');
        });
        $("#DateOfBirth").change(function () {
            $("#DateOfBirth").removeClass('field_error');
        });

        $("#EmpPhotoFile").change(function () {
            var GetfileName = document.getElementById('EmpPhotoFile');
            var selectedfile = GetfileName.files[0].size;
            var filename = GetfileName.files[0].name;
            var validFileSize = 1000 * 1024;
            if (selectedfile > validFileSize) {
                toastr.remove();
                toastr.error('Select file Between 0 to 1 MB.');
                $(this).val("");
                return false;
            }
            var allowedFiles = [".bmp", ".png", ".jpg", ".jpeg"];
            var fileUpload = $("#EmpPhotoFile");
            var regex = new RegExp("([a-zA-Z0-9\s_\\.\-:])+(" + allowedFiles.join('|') + ")$");
            if (!regex.test(fileUpload.val().toLowerCase())) {
                toastr.remove();
                toastr.error("Please upload files having extensions:" + allowedFiles.join(', ') + " only.");
                $(this).val("");
                return false;
            }
        });

        $("#btncancel").click(function () {
            $("#spPasswordnotmatch").hide();
            $("#Password").val("");
            $("#NewPassword").val("");
            $("#RePassword").val("");

            $("#Password").removeClass('field_error');
            $("#NewPassword").removeClass('field_error');
            $("#RePassword").removeClass('field_error');
        });

        $("#btnchangepassword").click(function (event) {
            if ($("#Password").val().trim() == "" && $("#NewPassword").val().trim() == "" && $("#RePassword").val().trim() == "") {
                $("#Password").addClass('field_error');
                $("#NewPassword").addClass('field_error');
                $("#RePassword").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#Password").removeClass('field_error');
                $("#NewPassword").removeClass('field_error');
                $("#RePassword").removeClass('field_error');
            }
            if ($("#NewPassword").val().trim() == "") {
                $("#NewPassword").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#NewPassword").removeClass('field_error');
            }
            if ($("#RePassword").val().trim() == "") {
                $("#RePassword").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#RePassword").removeClass('field_error');
            }


            var newpass = $("#NewPassword").val().trim();
            if (newpass != $("#RePassword").val().trim()) {
                $("#spPasswordnotmatch").html("New password and confirm password not match").show();
                event.preventDefault();
                return false;
            }
            else {
                $("#spPasswordnotmatch").hide();
            }
        });

        $("#Password").keypress(function (e) {
            $("#Password").removeClass('field_error');
        });
        $("#NewPassword").keypress(function (e) {
            $("#NewPassword").removeClass('field_error');
        });
        $("#RePassword").keypress(function (e) {
            $("#RePassword").removeClass('field_error');
        });
    });

    $("#EmpPhotoFile").change(function () {

        var GetfileName = document.getElementById('EmpPhotoFile');
        var selectedfile = GetfileName.files[0].size;
        var filename = GetfileName.files[0].name;
        $("#EmpPhoto").val(filename);
        var validFileSize = 1000 * 1024;
        if (selectedfile > validFileSize) {
            toastr.error("Select file between 0 to 1 MB.")
            $(this).val("");
            return false;
        }
        var allowedFiles = [".bmp", ".png", ".jpg", ".jpeg"];
        var fileUpload = $("#EmpPhotoFile");
        var regex = new RegExp("([a-zA-Z0-9\s_\\.\-:])+(" + allowedFiles.join('|') + ")$");
        if (!regex.test(fileUpload.val().toLowerCase())) {
            toastr.error("Please upload files having extensions:" + allowedFiles.join(', ') + " only.");
            $(this).val("");
            return false;
        }
    });

    function CheckDealerCode() {
        var dearlCode = $("#DealerCode").val();
        var url = '@_webapiurl' + 'Dealers/CheckDealer';
        $.get(url, { DearlerCode: dearlCode }, function (data) {
            if (data != null && data.length > 0) {
                $("#DealerId").val(data[0].DealerId);
                $("#DealerCode").val(data[0].DealerCode);
            } else {
                $("#DealerCode").insertAfter("dsfdsafdf");

            }
        });
    }
</script>

<link href="~/Content/toastr.min.css" rel="stylesheet" />

<div class="page-bar">

    <ul class="page-breadcrumb">
        <li>
            @if (Convert.ToInt32(Session["RoleId"]) != 21) //For Dealers
            {
                <a href="/Dealer/Dashboard">@PayTimeWebClient.Resource.Resource.mnuHome</a>
            }
            else
            {
                <a href="/Dealer/Managerdashboard">@PayTimeWebClient.Resource.Resource.Dashboard</a>
            }
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>
                EditProfile
            </span>
        </li>
    </ul>
</div>
<div class="col-md-12">
    <div class="portlet light bordered portlet-fit ">
        <div class="portlet-title tabbable-line">
            <div class="caption caption-md">

                <span class="caption-subject font-blue-madison bold uppercase">Profile Account</span>
            </div>

        </div>
        <div class="portlet-body">
            <div class="profile-content">
                <div class="row">
                    <div class="profile-account">
                        <div class="col-md-3">
                            <ul class="ver-inline-menu tabbable margin-bottom-10">
                                <li class="active" id="li1">
                                    <a data-toggle="tab" href="#tab_1-1">
                                        <i class="fa fa-cog"></i> Personal info
                                    </a>
                                    <span class="after"> </span>
                                </li>
                                <li id="li2">
                                    <a data-toggle="tab" href="#tab_2-2" aria-expanded="false">
                                        <i class="fa fa-lock"></i> Change Password
                                    </a>
                                </li>


                            </ul>
                        </div>
                        <div class="col-md-9">
                            <div class="tab-content">
                                <div id="tab_1-1" class="tab-pane active">
                                    @using (Html.BeginForm("EditProfile", "Dealer", FormMethod.Post, new { @enctype = "multipart/form-data", @id = "form1" }))
                                    {
                                        <div class="col-md-4">
                                            <div class="form-group" hidden>
                                                <input type="text" class="form-control" id="UserId" name="UserId" value="@Session["UserId"] " />
                                            </div>
                                            <div class="form-group" hidden>
                                                <input type="text" class="form-control" id="DealerId" name="DealerId" value="" />
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label">Name <span class="required" aria-required="true"> * </span></label>
                                                @*<input type="text" id="Name" name="Name" class="form-control" />*@
                                                <input class="form-control" id="Name" maxlength="50"
                                                       name="Name" type="text" value="" placeholder="Enter Name" required="required" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')">
                                            </div>
                                            <div class="form-group">
                                                <label>Date of Birth <span class="required" aria-required="true"> * </span></label>
                                                <div class="input-group  date date-picker" data-date-format="yyyy-mm-dd" data-date-end-date="0d" data-date-viewmode="years" id="joindate">
                                                    <span class="input-group-btn">
                                                        <button class="btn default" type="button">
                                                            <i class="fa fa-calendar"></i>
                                                        </button>
                                                    </span>
                                                    <input type="text" class="form-control" id="DateOfBirth" data-date-format="yyyy-mm-dd" name="DateOfBirth">
                                                </div>
                                                <span class="help-block" style="color:red;" hidden id="spEmpDOBDate"></span>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label">Address</label>
                                                <textarea id="Address" name="Address" rows="4" class="form-control" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')"></textarea>
                                            </div>

                                            @if (_RoleId == 1)
                                            {
                                                <div class="form-group">
                                                    <label class="control-label">Partner Code <span aria-required="true"></span></label>
                                                    <input readonly="readonly" class="form-control" id="DealerCode" maxlength="50" name="DealerCode" type="text" value="" placeholder="Enter Partner Code" onblur="CheckDealerCode()" />
                                                </div>
                                                @*<div class="form-group">
                                                        <label class="control-label">Merchant Key<span aria-required="true"></span></label>
                                                        <input class="form-control" id="merchantkey" maxlength="50" name="merchantkey" type="text" value="" placeholder="Enter Merchantkey"/>
                                                    </div>*@


                                            }

                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="control-label col-md-12 row margin-bottom-10">Gender </label>
                                                <label class="mt-radio mt-radio-outline">
                                                    Male
                                                    <input value="1" name="Gender" id="GenderM" type="radio">
                                                    <span></span>
                                                </label>
                                                <label class="mt-radio mt-radio-outline">
                                                    Female
                                                    <input value="0" name="Gender" id="GenderF" type="radio">
                                                    <span></span>
                                                </label>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label col-md-12 row margin-bottom-10">Marital Status </label>
                                                <label class="mt-radio mt-radio-outline">
                                                    Single
                                                    <input value="False" name="IsMarried" id="Empsingle" type="radio">
                                                    <span></span>
                                                </label>
                                                <label class="mt-radio mt-radio-outline">
                                                    Married
                                                    <input value="True" name="IsMarried" id="EmpMarried" type="radio">
                                                    <span></span>
                                                </label>
                                            </div>
                                            <div class="form-group">
                                                <label>Mobile No <span class="required" aria-required="true"> * </span> </label>
                                                <input type="text" multiple class="form-control" name="MobileNo" id="MobileNo" placeholder="Mobile No" maxlength="10">
                                                <span class="help-block" style="color:red;" hidden id="spEmpMNo"></span>
                                            </div>
                                            <div class="form-group">
                                                <label>Phone No</label>
                                                <input type="text" multiple class="form-control" name="PhoneNo" id="PhoneNo" placeholder="Phone No" maxlength="15">
                                                <span class="help-block" style="color:red;" hidden id="spPhono"></span>

                                            </div>
                                            @*<div class="form-group">
                                                    <br /><br/>
                                                    <lable>Payment Gatway Details<lable>

                                                </div>
                                                    <div class="form-group">
                                                        <label class="control-label">Salt<span aria-required="true"></span></label>
                                                        <input class="form-control" id="salt" maxlength="50" name="salt" type="text" value="" placeholder="Enter Salt" />
                                                    </div>*@
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group text-center">
                                                <div class="fileinput fileinput-new text-center" data-provides="fileinput">
                                                    <div class="fileinput-new profile_img ">
                                                        <img src="~/assets/images/avtar.png" alt="" id="empimg" />
                                                    </div>
                                                    <div class="profile_img fileinput-preview fileinput-exists profile_img"> </div>
                                                    <div>
                                                        <span class="btn blue btn-sm btn-file margin-top-10">
                                                            <span class="fileinput-new btn-block"> Select image </span>
                                                            <span class="fileinput-exists "> Change </span>
                                                            <input type="file" name="EmpPhotoFile" id="EmpPhotoFile" value="">
                                                            <input type="hidden" id="Photo" name="Photo">
                                                        </span>
                                                        <a href="javascript:;" class="btn btn-sm  red fileinput-exists margin-top-10" data-dismiss="fileinput"> Remove </a>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-md-12">
                                            <div>
                                                @*<a href="javascript:;" class="btn default"> <i class="fa fa-close"></i> Cancel </a>*@
                                                <button type="button" class=" btn btn-sm  default" id="btncancelperinfo"> <i class="fa fa-close"></i> Cancel</button>
                                                <button type="submit" class=" btn btn-sm  blue" id="btnsubmit"> <i class="fa fa-floppy-o"></i> Save</button>
                                            </div>
                                        </div>
                                    }

                                </div>

                                <div id="tab_2-2" class="tab-pane">
                                    @using (Html.BeginForm("AdminChangePassword", "Dealer", FormMethod.Post))
                                    {
                                        <div class="col-md-4">
                                            <div class="form-group" hidden>
                                                <input type="text" class="form-control" id="UserId" name="UserId" value="@Session["UserId"]" />
                                                <input type="text" class="form-control" id="UserEmail" name="UserEmail" value="@Session["UserEmail"]" />
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label">Current Password<span class="required" aria-required="true"> * </span></label>
                                                <input type="password" class="form-control" id="Password" name="Password" required="" />
                                            </div>
                                            <div class="form-group  password-strength">
                                                <label class="control-label">New Password<span class="required" aria-required="true"> * </span></label>
                                                <input type="password" class="form-control password_strength" id="NewPassword" name="NewPassword" required="" />
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label">Confirm New Password<span class="required" aria-required="true"> * </span></label>
                                                <input type="password" class="form-control" id="RePassword" name="RePassword" required="" />
                                                <span class="help-block" style="color:red;" hidden id="spPasswordnotmatch"></span>
                                            </div>
                                            <div class="margin-top-10">
                                                <input type="button" id="btncancel" class="btn default btn-sm" value="Cancel" />
                                                <input type="submit" id="btnchangepassword" class="btn blue btn-sm" value="Change Password" />
                                            </div>
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>
                        <!--end col-md-9-->
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/global/plugins/bootstrap-pwstrength/pwstrength-bootstrap.min.js"></script>
