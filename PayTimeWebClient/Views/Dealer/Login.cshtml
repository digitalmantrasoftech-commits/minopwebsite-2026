        function loginValidate() {
            var frmStatus = true;
            if ($("#UserEmail").val() == "") {
                $("#UserEmail").css("border-color", "red");
                frmStatus = false;
            }
            if ($("#Password").val().trim() == "") {
                $("#Password").css("border-color","red");
                frmStatus = false;
            }
            if (!frmStatus) { return false;} else { $("#btnfrmSubmit").submit();}
        }
        function blockSpecialChar(evt) {
            var k;
            if (evt.keyCode > 0) {
                k = evt.keyCode;
            }
            else if (typeof (evt.charCode) != "undefined") {
                k = evt.charCode;
            }
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57));
        }

        function blockSpecialCharAllowSpace(evt) {
            var k;
            if (evt.keyCode > 0) {
                k = evt.keyCode;
            }
            else if (typeof (evt.charCode) != "undefined") {
                k = evt.charCode;
            }
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
        }

        // Update the count down every 1 second
        let timerOn = true;
        function timer(remaining) {
            var m = Math.floor(remaining / 60);
            var s = remaining % 60;

            m = m < 10 ? '0' + m : m;
            s = s < 10 ? '0' + s : s;
            $("#counter").text("Wait for resend otp "+ m + ':' + s);
            remaining -= 1;

            if (remaining >= 0 && timerOn) {
                setTimeout(function () {
                    timer(remaining);
                }, 1000);
                return;
            }
            if (!timerOn) {
                return;
            }
            $("#counter").css("display", "none");
            $("#resendNumber").css("display", "block");
        }
        
    </script>
