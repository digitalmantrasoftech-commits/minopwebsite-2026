<body class="dealerlogin_body">
    <table class="layout_body">
        <tbody>
            <tr class="logo_tr">
                <td>
                    <a href="~/" class="logo">
                        <img src="~/LandingAssets/images/minop-logo.png" />
                        <span class="logo_tag_line">Attendance on the Cloud</span>
                    </a>
                </td>
            </tr>

            <tr class="main_box">
                <td>
                    @*For Loging*@
                    <div class="login_box">
                        <div class="Dealer_Login_box">
                            <h1>Partner Login</h1>
                            @if (strmsg != "")
                            {
                                <div class="col-md-12 text-center red">
                                    @if (strmegsts == "error")
                                    {
                                        <strong id="strstg1" style="color:red">Error !</strong>
                                        <span style="color:red">@strmsg</span>
                                    }
                                    else
                                    {
                                        <strong id="strstg2" style="color:blue">Info !</strong>
                                        <span style="color: blue">@strmsg</span>

                                    }
                                </div>
                            }
                            @using (Html.BeginForm("Login", "Dealer", FormMethod.Post, new { @id="btnfrmSubmit" }))
                            {
                                <div class="form-group">
                                    <label for="UserEmail">Email</label>
                                    <input type="Email" name="UserEmail" class="form-control" id="UserEmail" placeholder="Please enter email">
                                    <span class="help-block" style="color:red;" hidden id="emailVal"></span>
                                </div>
                                <div class="form-group">
                                    <label for="Password">Password</label>
                                    <input type="password" name="Password" class="form-control" id="Password" placeholder="Please enter password">
                                    <span class="help-block" style="color:red;" hidden id="passVal"></span>
                                </div>
                                @*<div class="Remember_me_box">
                                    <input type="checkbox" value="" id="rememberme" name="rememberme">
                                    <label class="form_check_label" for="rememberme">Remember me</label>
                                </div>*@
                                
                                <button class="login_btn" type="button"  onclick="return loginValidate();"><i class="fa fa-sign-in"></i>Login</button>
                                
                            }

                        </div>
                        <div class="other_part_url_box">
                            <a class="register_box_btn" href="javascript:void(0)">Register Now !</a>
                            <a class="forgot_password_box_btn" href="~/Dealer/ForgotPassword">Forgot password ?</a>
                        </div>
                        @*<div class="social_icon_box">
                            <a class="facebook_icon" target="_blank" href="https://www.facebook.com/Mantra-Softech-India-Pvt-Ltd-197999890258174/info/?tab=page_info"><i class="fa fa-facebook"></i></a>
                            <a class="google_plus_icon" target="_blank" href="https://plus.google.com/105269249509614442444"><i class="fa fa-google-plus"></i></a>
                            <a class="twitter_icon" target="_blank" href="https://twitter.com/mantratec"><i class="fa fa-twitter"></i></a>
                            <a class="linkedin_icon" target="_blank" href="https://www.linkedin.com/company/mantra-softech-india-pvt-ltd/"><i class="fa fa-linkedin"></i></a>
                        </div>*@
                    </div>

                    @*For Registration *@
                    <div id="ajax_loaderbranch" class="modal_bg loading" aria-hidden="true" style="z-index:100;display:none">
                        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
                    </div>
                    <div class="Register_box" style="display:none;">
                        
                        <div class="Dealer_Register_box">
                            @if (ViewBag.error != null || ViewBag.error != "")
                            {
                                <span class="error">@ViewBag.error</span>
                            }
                            <h1>Partner Register</h1>
                            @using (Html.BeginForm("Registration", "Dealer", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                <div class="row">
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label for="DealersName">Partner Company Name<span class="required" aria-required="true"> * </span></label>
                                            <input type="text" name="DealersName" class="form-control" id="DealersName" maxlength="100" placeholder="Please enter partner name">
                                            <span class="error_span" id="delVal" style="display: none;"></span>
                                        </div>
                                    </div>
                                    @*<div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label for="LogoName">Dealer Company Logo</label>
                                            <input type="file" class="form-control" name="LogoName" id="LogoName">
                                        </div>
                                    </div>*@
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label for="ContactPerson">Partner Name<span class="required" aria-required="true"> * </span></label>
                                            <input type="text" name="ContactPerson" class="form-control" id="ContactPerson" maxlength="50" placeholder="Please enter partner name">
                                            <span class="error_span" id="conVal" style="display: none;"></span>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label for="MobileNo">Mobile<span class="required" aria-required="true"> * </span></label>
                                            <input type="text" name="MobileNo" class="form-control" id="MobileNo" maxlength="10" placeholder="Please enter mobile no">
                                            <span class="error_span" id="mobVal" style="display: none;"></span>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label for="Email">Email<span class="required" aria-required="true"> * </span></label>
                                            <input type="email" name="Email" class="form-control" id="Email" maxlength="30" placeholder="Please enter email">
                                            <span class="error_span" id="emlVal" style="display: none;"></span>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label for="Password">Password<span class="required" aria-required="true"> * </span></label>
                                            <input type="password" class="form-control" id="registerPassword" name="Password" maxlength="30" placeholder="Please enter password">
                                            <span class="error_span" id="pasVal" style="display: none;"></span>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label for="ConformPassword">Confirm Password<span class="required" aria-required="true"> * </span></label>
                                            <input type="password" name="Conform_Password" class="form-control" id="ConformPassword" maxlength="50" placeholder="Please enter confirm password">
                                            <span class="error_span" id="conPasVal" style="display: none;"></span>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label for="Website">Website</label>
                                            <input type="text" name="Website" class="form-control" id="Website" maxlength="50" placeholder="Please enter website">
                                            <span class="error_span" id="webVal" style="display: none;"></span>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                        <div class="form-group">
                                            <label for="Address">Address</label>
                                            <textarea type="text" name="Address" class="form-control" id="Address"  maxlength="200" placeholder="Please enter address"></textarea>
                                            <span class="error_span" id="adsVal" style="display: none;"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <hr />
                                    </div>
                                </div>
                                <button class="Register_btn" type="button" id="registerDealer"  onclick="Dealer()"> <i class="fa fa-paper-plane-o"></i>Register</button>
                            }
                        </div>
                        <div class="other_part_url_box">
                            <a class="Login_box_btn" href="javascript:void(0)">Already account ? Login</a>
                            <a href="javascript:void(0)" class="otpVerification">OTP Verification!</a>
                            <a class="forgot_password_box_btn" href="~/Dealer/ForgotPassword">Forgot password ?</a>

                        </div>
                        @*<div class="social_icon_box">
                            <a class="facebook_icon" target="_blank" href="https://www.facebook.com/Mantra-Softech-India-Pvt-Ltd-197999890258174/info/?tab=page_info"><i class="fa fa-facebook"></i></a>
                            <a class="google_plus_icon" target="_blank" href="https://plus.google.com/105269249509614442444"><i class="fa fa-google-plus"></i></a>
                            <a class="twitter_icon" target="_blank" href="https://twitter.com/mantratec"><i class="fa fa-twitter"></i></a>
                            <a class="linkedin_icon" target="_blank" href="https://www.linkedin.com/company/mantra-softech-india-pvt-ltd/"><i class="fa fa-linkedin"></i></a>
                        </div>*@
                    </div>
                </td>
            </tr>
            <tr class="copright_line_tr">
                <td>
                    <div class="copright_line">Copyright © <script>document.write(new Date().getFullYear())</script> <a href="https://www.mantratec.com/" target="_blank">Mantra Softech (India) Pvt. Ltd.</a> All Rights Reserved.</div>
                </td>
            </tr>
        </tbody>
    </table>
    <div class="modal fade page-header" id="otpModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <input type="hidden" name="dealerId" class="form-control" id="dealerId" maxlength="100">
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="DealersName">Enter OTP<span class="required" aria-required="true"> * </span></label>
                                <input type="text" name="Otp" class="form-control" id="idOtp" maxlength="100" placeholder="Please enter otp">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <button class="Register_btn" type="button" id="otpSubmit" onclick="OtpVerification()"> <i class="fa fa-paper-plane-o"></i>Submit</button>

                        </div>
                    </div>
                    <a id="changeNumber" style="margin-top:20px;cursor:pointer">Do you want to change you number?</a>
                    <br>
                    <span style="display:none">OR</span>
                    <span id="counter" style="display:none"></span>
                    <a id="resendNumber" onclick="otpResend()" style="margin-top: 20px; cursor:pointer;display:none;">Resend OTP? Click here!</a>

                </div>
            </div>
        </div>
    </div>
    <div class="modal fade page-header" id="changeNumberModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <input type="hidden" name="newDealerId" class="form-control" id="newDealerId" maxlength="100">
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="OldNumber">Old Number<span class="required" aria-required="true"> * </span></label>
                                <input type="text" name="OldNumber" class="form-control" id="OldNumber" maxlength="10">
                            </div>
                            <div class="form-group">
                                <label for="EnterNumber">Enter Number<span class="required" aria-required="true"> * </span></label>
                                <input type="text" name="NewNumber" class="form-control" id="NewNumber" maxlength="10" placeholder="Please enter new mobile no">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <button class="btn btn-default" type="button" id="newSubmit" onclick="NewNumberVerification()"> <i class="fa fa-paper-plane-o"></i>Get OTP</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade page-header" id="otpWithNumber" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="EnterotpNumber">Enter Number<span class="required" aria-required="true"> * </span></label>
                                <input type="text" name="NewNumber" class="form-control" id="NewotpNumber" maxlength="10" placeholder="Please enter mobile no">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <button class="btn btn-default" type="button" id="otpSubmit" onclick="OptwithNumberVerification()"> <i class="fa fa-paper-plane-o"></i>Get OTP</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- BEGIN VENDOR JS-->
    <!-- all -->
    <script src="~/LandingAssets/js/jquery.min.js"></script>
    <script src="~/LandingAssets/js/bootstrap.min.js"></script>
    <script src="~/assets/Dealer/dealercustom.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <!-- all -->
    <script type="text/javascript">
        var oldMobileNumber = "";
        var timerValue = 60;
        var status = true;


        $(".otpVerification").click(function () {
            $("#otpWithNumber").modal("show");
            $(".layout_body").css("display", "none");
        })
        function OptwithNumberVerification() {
            if ($("#NewotpNumber").val().trim() != "" && $("#NewotpNumber").val().length == 10) {
                $.ajax({
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: JSON.stringify({ 'mobileNo': $("#NewotpNumber").val() }),
                    type: 'post',
                    url: '@Url.Content("/Dealer/OptwithNumberVerification")',
                    success: function (result) {
                        
                        if (result.isSuccess) {
                            toastr.remove();
                            toastr.success("OTP has been sent into your Mobile no.");
                            $("#dealerId").val(result.pm.Msg);
                            $("#counter").css("display", "none");
                            $("#resendNumber").css("display", "none");
                            timerOn = true;
                            timer(timerValue)
                            $("#otpWithNumber").modal('hide').data('bs.modal', null);
                            $("#otpModal").modal("show");
                        } else {
                            toastr.remove();
                            toastr.error(result.pm.Msg);
                        }
                    }, error: function (result) {
                        toastr.remove();
                        toastr.error(result.pm.Msg);
                    }
                });
            } else {
                toastr.remove();
                toastr.error("Please enter valid number.");
                return false;
            }
        }
        function OtpVerification() {
            if ($("#idOtp").val().trim() != "") {
                var obj = otpParam()
                $.ajax({
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: JSON.stringify({ 'obj': obj }),
                    type: 'post',
                    url: '@Url.Content("/Dealer/RegistrationOtpVarification")',
                    success: function (result) {
                        if (result.isSuccess) {
                            $("#otpModal").modal('hide').data('bs.modal', null);
                            toastr.remove();
                            toastr.success("OTP verified successfully.Registration completed.");
                            setTimeout(function () {
                                window.location.href = "/Dealer/login";
                            }, 3000)
                        } else {
                            toastr.error(result.pm.Msg);
                        }
                    }, error: function (result) {
                        toastr.remove();
                        toastr.error(result.pm.Msg);
                    }
                });
            } else {
                toastr.remove();
                toastr.error("Please enter otp.");
                return false;
            }
        }
        function otpParam() {
            return {
                Otp: $("#idOtp").val(),
                dealerId: $("#dealerId").val()
            }
        }
        $("#changeNumber").click(function () {
            timerOn = false;
            $("#counter").text("");
            $("#newDealerId").val($("#dealerId").val());
            $("#OldNumber").val(oldMobileNumber);
            $('#otpModal').modal('hide').data('bs.modal', null);
            $("#changeNumberModal").modal("show");
        });

        function NewNumberVerification() {
            if ($("#NewNumber").val().trim() != "" && $("#NewNumber").val().length == 10) {
                var obj = otpnewParam()
                $.ajax({
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: JSON.stringify({ 'obj': obj }),
                    type: 'post',
                    url: '@Url.Content("/Dealer/NewNumberVerification")',
                    success: function (result) {
                        if (result.isSuccess) {
                            toastr.remove();
                            toastr.success(result.pm.Msg);
                            oldMobileNumber = $("#NewNumber").val();
                            $("#OldNumber").val(oldMobileNumber);
                            $("#NewNumber").val("");
                            $("#dealerId").val($("#newDealerId").val());
                            $("#changeNumberModal").modal("hide");
                            $("#counter").css("display", "none");
                            $("#resendNumber").css("display", "none");
                            timerOn = true;
                            timer(timerValue)
                            $("#otpModal").modal("show");
                            
                        } else {
                            toastr.remove();
                            toastr.error(result.pm.Msg);
                        }
                    }, error: function (result) {
                        toastr.remove();
                        toastr.error(result.pm.Msg);
                    }
                });
            } else {
                toastr.remove();
                toastr.error("Please enter valid number.");
                return false;
            }
        }
        function otpnewParam()
        {
            return {
                NewNumber: $("#NewNumber").val(),
                newDealerId: $("#newDealerId").val()
            }
        }
        function otpResend() {
            var d = oldMobileNumber;
            $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: { "MobileNo": oldMobileNumber },
                type: 'get',
                url: '@_webapiurl' + 'Dealers/OtpResend',
                async: false,
                success: function (response) {
                    if (response.MsgSts == "Ok" || response.MsgSts == "ok") {
                        $("#counter").css("display", "none");
                        $("#resendNumber").css("display", "none");
                        timerOn = true;
                        timer(timerValue);
                        toastr.remove();
                        toastr.success(response.Msg);
                    } else {
                        toastr.remove();
                        toastr.error(response.Msg);
                    }
                }
            });
        }
        function Dealer() {
            $(".loading").show();
            status = registrationValidate();
            if (status == "true") {
                var obj = registerParam()
                oldMobileNumber = $("#MobileNo").val();
                $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: JSON.stringify({ 'obj': obj }),
                type: 'post',
                url: '@Url.Content("/Dealer/Registration")',
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (result) {
                    if (result.IsSuccess) {
                        toastr.remove();
                        toastr.success("OTP has been sent into your Mobile no.");
                        $("#dealerId").val(result.Resp.Meg);
                        $("#otpModal").modal("show");
                        $(".layout_body").css("display", "none");
                        timer(timerValue);
                    } else {
                        //clearParam();
                        toastr.remove();
                        toastr.error(result.Resp.Meg);
                        $(".loading").hide();
                    }
                }, error: function (result) {
                    toastr.remove();
                    toastr.error(result.Resp.Meg);
                    $(".loading").hide();
                }
            });
            } else {
                $(".loading").hide();
                return false;
            }
        }
        function registrationValidate() {

            if ($("#registerPassword").val().trim != $("#ConformPassword").val().trim) {
                toastr.error("Password & confirm password should be match.");
                status = false;
            }

            if ($("#registerPassword").val().trim() == "") {
                $("#registerPassword").css("border-color", "red");
                //$("#pasVal").show().text("Password cannot be blank.")
                status = false;
            }
            if ($("#ConformPassword").val().trim() == "") {
                $("#ConformPassword").css("border-color", "red");
                status = false;
            }

            if ($("#DealersName").val().trim() == "") {
                $("#DealersName").css("border-color", "red");
                status = false;
            }

            if ($("#ContactPerson").val().trim() == "") {
                $("#ContactPerson").css("border-color", "red");
                status = false;
            }
            if ($("#MobileNo").val() == "") {
                $("#MobileNo").css("border-color", "red");
                status = false;
            }

            if ($("#MobileNo").val().length != 10) {
                $("#MobileNo").css("border-color", "red");
                status = false;
            } else {
                $("#mobVal").hide().text("");
                $("#MobileNo").css("border-color", "");
                status = true;
            }

            if ($("#Email").val() == "") {
                $("#Email").css("border-color", "red");
                status = false;
            }

            //if ($("#Website").val().trim() == "") {
            //    $("#Website").css("border-color", "red");
            //    status = false;
            //}

            //if ($("#Address").val().trim() == "") {
            //    $("#Address").css("border-color", "red");
            //    status = false;
            //}
            if ($("#NewExisting option:selected").val() == 0)
            {
                $("#NewExisting").css("border-color", "red");
                status = false;
            }
            //if ($("#PartnerName").val().trim() == "") {
            //    $("#PartnerName").css("border-color", "red");
            //    status = false;
            //}
            if ($("#Refrencefrom option:selected").val() == 0) {
                $("#Refrencefrom").css("border-color", "red");
                status = false;
            }
            if ($("#Refrencefrom option:selected").val() == 2) {
                if ($("#ReferenceName").val().trim() == "") {
                    $("#ReferenceName").css("border-color", "red");
                    status = false;
                }
            }

            if ($("#Email").val() != "") {
                var filter = new RegExp(/^[_A-Za-z0-9-]+(\.[_A-Za-z0-9-]+)*@@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*(\.[A-Za-z]{2,4})$/);
                if (!filter.test($("#Email").val())) {
                    $("#emlVal").html("Please Enter Valid Email ID.").show();
                    return false;
                }
                else {
                    $("#emlVal").hide();
                }
            }

            return status
        }

        $("#NewExisting").change(function () {
            $("#NewExisting").css("border-color", "");
        });
