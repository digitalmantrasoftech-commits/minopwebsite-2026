                            {
                                <th>
                                    <input class="all_checkbox" type="checkbox" name="rememberme">
                                </th>
                            }
                            else { 
                            <th hidden></th>
                            }
                            
                            <th>Partner Code</th>
                            <th>Company Name</th>
                            <th>Contact Person</th>
                            <th>Email</th>
                            <th>Contact No</th>
                            <th>Address</th>
                            <th>Verification</th>
                            <th>Account Manager</th>
                            <th>Discount (%)</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
