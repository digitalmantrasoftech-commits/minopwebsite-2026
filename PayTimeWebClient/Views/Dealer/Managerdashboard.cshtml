                            <label id="idPersantage" style='display: none; width: 5px; float: left; margin-right: 15px; height: 30px;'>(%)</label>
                            <button style='display: none; width: 150px; float: left; margin-right: 18px; height: 30px;' type="button" class="add-partner adddiscount">Add Discount</button>
                            <select style='display: none; width: 150px; float: left; margin-right: 10px; height: 30px; border-radius: 5px !important; ' id='ractmanager'></select>
                        </div>
                    }
                    
                </div>
            </div>
            <div class="card-body">
                <table class="table table_Dashboard_data" id="Dealer_Dashboard_data">
