            <h6>Pendig Activation Partners</h6>
            <h2></h2>
        </a>
         </div>
        
         <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
            <a class="count_company_box No_of_Plan_box">
                <i class="fa fa-desktop"></i>
