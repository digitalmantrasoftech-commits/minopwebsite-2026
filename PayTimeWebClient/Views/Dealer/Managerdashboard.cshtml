    $(".adddiscount").click(function () {

        var sThisVal;
        var dealerId = "";
        sThisVal = $('input[name = dealerActiveorDeactive]:checked');
        if (sThisVal.length > 0) {
            dealerId = $(sThisVal).map(function (index, value) {
                return value.id;
            }).get().join(',');


            var discount = $("#IdaddDiscount").val();


            if (discount != "" && discount != null) {

                if (parseInt(discount) <= 40) {
                    fnAdddiscount(dealerId, parseFloat(discount));
                } else {
                    toastr.error("Discount percentage should be  betweeen 0 to 40");

                }
            } else {
                toastr.error("Please enter discount");
            }

        } else {
            toastr.error("Please select partners.!");
        }


    })

    function fnAdddiscount(dealerId, discount) {
        Swal.fire({
            title: 'Are you sure '+discount+'% disccount applicable to parameter?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, update it!'
        }).then((result) => {
            if (result.value)
            {

            var obj = adddiscountParam(dealerId, discount);
            function adddiscountParam(dealerId, discount) {
            return {
                discountper: discount,
                partnerids: dealerId
            }
        }
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'post',
            data: JSON.stringify(obj),
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Dealers/Addpartnersdisccount',
            async: false,
            success: function (response) {

                if (response.MsgSts == "ok") {
                    toastr.success(response.Msg);
                    getActiveOrPendingDetail(2, 1);
                    $("#IdaddDiscount").val(0);

                } else {
                    toastr.error(response.Msg);
                }
            }
        });
    }else{
        $("#IdaddDiscount").val(0);
    $('input[name=rememberme]').prop('checked', false);
    $('input[name = dealerActiveorDeactive').prop('checked', false);
    getActiveOrPendingDetail(2, 1);
    }
    });

