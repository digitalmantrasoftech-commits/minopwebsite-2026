        background-color: #1c96cd;
        height: 30px;
        line-height: 28px;
        color: white;
        border-radius: 5px !important;
        box-shadow: 1px 1px 5px #ababab;
        border: 1px solid #1c96cd;
        margin: 0px 5px;
    }
</style>
<link href="~/Content/toastr.min.css" rel="stylesheet" />
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/Dealer/Managerdashboard">Home</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>
                Manager Dashboard
            </span>
        </li>
    </ul>

    <button type="button" class="add-partner" data-toggle="modal" data-target="#exampleModal" style="float:right;margin-top:5px;">Add Partner</button>

</div>
<div class="row">
    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
