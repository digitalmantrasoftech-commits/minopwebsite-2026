<div class="modal fade page-header" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Partners Registration</h5>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("Registration", "Dealer", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="DealersName">Partner Company Name<span class="required" aria-required="true"> * </span></label>
                                <input type="text" name="DealersName" class="form-control" id="DealersName" maxlength="100" placeholder="Please enter partner name">
                                <span class="error_span" id="delVal" style="display: none;"></span>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="ContactPerson">Partner Name<span class="required" aria-required="true"> * </span></label>
                                <input type="text" name="ContactPerson" class="form-control" id="ContactPerson" maxlength="50" placeholder="Please enter partner name">
                                <span class="error_span" id="conVal" style="display: none;"></span>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="MobileNo">Mobile<span class="required" aria-required="true"> * </span></label>
                                <input type="text" name="MobileNo" class="form-control" id="MobileNo" maxlength="10" placeholder="Please enter mobile no">
                                <span class="error_span" id="mobVal" style="display: none;"></span>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="Email">Email<span class="required" aria-required="true"> * </span></label>
                                <input type="email" name="Email" class="form-control" id="Email" maxlength="30" placeholder="Please enter email">
                                <span class="error_span" id="emlVal" style="display: none;"></span>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="Password">Password<span class="required" aria-required="true"> * </span></label>
                                <input type="password" class="form-control" id="registerPassword" name="Password" maxlength="30" placeholder="Please enter password">
                                <span class="error_span" id="pasVal" style="display: none;"></span>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="ConformPassword">Confirm Password<span class="required" aria-required="true"> * </span></label>
                                <input type="password" name="Conform_Password" class="form-control" id="ConformPassword" maxlength="50" placeholder="Please enter confirm password">
                                <span class="error_span" id="conPasVal" style="display: none;"></span>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="Website">Website</label>
                                <input type="text" name="Website" class="form-control" id="Website" maxlength="50" placeholder="Please enter website">
                                <span class="error_span" id="webVal" style="display: none;"></span>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <label for="Address">Address</label>
                                <textarea type="text" name="Address" class="form-control" id="Address" maxlength="200" placeholder="Please enter address"></textarea>
                                <span class="error_span" id="adsVal" style="display: none;"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <button class="Register_btn" type="button"    style="background:#3598dc;"    id="registerDealer" onclick="Dealer()"> <i class="fa fa-paper-plane-o"></i>Register</button>
                            <button class="Register_btn" type="button" style="background:#3598dc;" id="registerCancel"> <i class="fa fa-paper-plane-o"></i>Cancel</button>
                        </div>
                    </div>

                }
            </div>
        </div>
    </div>
</div>
<div class="modal fade page-header" id="planModal" tabindex="-1" role="dialog" aria-labelledby="planModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="width:300px">
            <div id="ajax_loaderplan" class="modal_bg loading" aria-hidden="true" style="z-index:100;display:none">
                <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
            </div>

            <div class="modal-header">
                <h5 class="modal-title" id="planModalLabel">Subscription Plan</h5>
            </div>
            <div class="modal-body" style="margin-left:40px">
                @using (Html.BeginForm("Plan", "Dealer", FormMethod.Post))
                {
                    <div class="form_group">
                        <span class="help-block" style="color: red;" hidden id="spvalidation"></span>
                    </div>
                    <div class="form_group">
                        <div class="form-group">
                            <label>Plan Name<span class="required" aria-required="true"> * </span></label>
                            <div class="input-group">
                                <input type="hidden" id="hdnplanid" />
                                <input type="text" name="txtplanname" id="txtplanname" maxlength="50" onkeypress="return blockSpecialCharAllowSpace(event);" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Monthly Subscription Price<span class="required" aria-required="true"> * </span></label>
                            <div class="input-group">
                                <input type="text" name="txtmsp" id="txtmsp" maxlength="3" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Yearly Subscription Price<span class="required" aria-required="true"> * </span></label>
                            <div class="input-group">
                                <input type="text" name="txtysp" id="txtysp" maxlength="3" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Feature<span class="required" aria-required="true"> * </span></label>
                            <div class="input-group">
                                <input type="text" id="txt3" value="0" hidden />

                                <select id="txtfeature" name="txtfeature" class="mt-multiselect btn-sm btn blue btn-outline " aria-haspopup="true" aria-expanded="false" multiple="multiple" data-width="100%">

                                    @*<option value="1">Web</option>
                                        <option value="2">ESS</option>
                                            <option value="3">Face</option>*@
                                </select>
                            </div>
                        </div>
                        <div class="form-group" id="chkisActiveBlock" style="display:none">
                            <label>Is Active ?<span class="required" aria-required="true"> * </span></label>
                            <div class="input-group">
                                <input type="checkbox" class="make-switch" data-size="small" id="chkisActive" data-on-text="Yes" data-off-text="No" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="button" class="add-partner" id="btnsaveplan"><i class="fa fa-paper-plane-o"></i>Save Plan</button>
                        <button type="button" class="add-partner" id="btncancelplan"> <i class="fa fa-close"></i>Cancel</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


