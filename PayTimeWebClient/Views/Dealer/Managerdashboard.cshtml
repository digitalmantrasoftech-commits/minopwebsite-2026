            <i class="fa fa-credit-card"></i>
                    <h6>Total No of Lincence</h6>
                    <h2>379</h2>
                </a>*@
    </div>
</div>
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="dealerdetails">
        @*<div id="ajax_loaderbranch" class="modal_bg loading" aria-hidden="true" style="z-index:100;display:none">
            <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" />
        </div>*@
        <div class="card">
            <div class="card-head">
            @if (_roleid == "21") { 
                            <div id="accountOperation" style="float:left;width:150px;height:30px;">
                                <select id="idoperation"  style="border-radius: 5px !important;">
                                    <option value="0" selected="selected">--Select Operation--</option>
                                    <option value="1">Add Disccount</option>
                                    <option value="2">Assing Manager</option>
                                    <option value="3">Deactive Partner</option>
                                </select>

                            </div>
            }
                <div class="actions_box">
                    
                    @*<label>Action :- </label>*@
                    <button type="button" class="Active_btn dealerActive"><i class=" fa fa-check"></i>Active</button>
                    <button type="button" class="Deactive_btn dealerActive" style="display:none;" ><i class="fa fa-close"></i>Deactive</button>
                    @if (_roleid == "21")
                    {
                        
                        <div id="frmassingtool" style="display:none;float:left">
                            <button type="button" class="add-partner assingmanager" style="display:none;" ><i class="fa fa-pencil"></i>Assing Manager</button>
                            
