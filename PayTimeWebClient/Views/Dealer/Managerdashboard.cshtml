                    <thead>
                        <tr>
                            <th></th>
                            <th>Plan Name</th>
                            <th style="word-wrap:normal">Monthly Subscription <br /> Price(Perday/Peruser)</th>
                            <th>Yearly Subscription <br /> Price(Perday/Peruser)</th>
                            <th>Feature</th>
                            <th>Status</th>
                            @*<th hidden></th>*@
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="Managerdetails" style="display:none">
        <div class="card">
            <div class="card-head" style="text-align:left !important;">
                <div class="actions_box">
                    <button type="button" class="add-partner editManager"><i class="fa fa-pencil"></i> Edit Manager</button>
                    <button type="button" class="add-partner addManager" data-toggle="modal" onclick="fnManagershowModal()">Add Manager</button>
            </div>
            <div class="card-body">
