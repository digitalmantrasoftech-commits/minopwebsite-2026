    function validateplanform() {
        var ret = true;
        if ($('#txtplanname').val().trim() == "") {
            $("#spvalidation").html('Plan name should not be empty or blank').show();
            $("#txtplanname").focus();
            ret = false;
            return false;
        } else {
            $("#spvalidation").html('');
            $("#spvalidation").hide();
        }

        if ($("#txtplanname").val().length < 3) {
            $("#spvalidation").html('Plan name should be greater than 3 character.').show();
            $("#txtplanname").focus();
            ret = false;
            return false;
        } else {
            $("#spvalidation").hide();
        }

        if (parseFloat($('#txtmsp').val()) == 0.0) {
            $("#spvalidation").html('Monthly subscription price should not be zero.').show();
            $("#txtmsp").focus();
            ret = false;
            return false;
        } else {
            $("#spvalidation").html('');
            $("#spvalidation").hide();
        }
        if (parseFloat($('#txtysp').val()) == 0.0) {
            $("#spvalidation").html('Yearly subscription price should not be zero.').show();
            $("#txtysp").focus();
            ret = false;
            return false;
        } else {
            $("#spvalidation").html('');
            $("#spvalidation").hide();
        }
        if ($('#txtfeature').val() == "") {
            $("#spvalidation").html('Plan feature should not be empty or blank').show();
            $("#txtfeature").focus();
            ret = false;
            return false;
        } else {

            var bflst = $('#txtfeature').val();
            var a = bflst.indexOf("1");
            if (a < 0) {
                $("#spvalidation").html('Web feature must be selected for plan').show();
                $("#txtfeature").focus();
                ret = false;
                return false;
            }
            else {
                $("#spvalidation").html('');
                $("#spvalidation").hide();
            }
        }


        return ret;
    }


