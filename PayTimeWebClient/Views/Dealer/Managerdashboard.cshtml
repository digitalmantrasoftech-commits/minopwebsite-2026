    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="palndetails" style="display:none">
        <div class="card">
            
            <div class="card-head" style="text-align:left;">
                <div class="actions_box">
                    <button type="button" class="add-partner editplan"><i class="fa fa-pencil"></i> Edit Plan</button>
                    <button type="button" class="add-partner addplan" data-toggle="modal" onclick="fnshowPlanModal()" ><i class="fa fa-plus"></i> Add Plan</button>
                </div>
            </div>
            <div class="card-body">
