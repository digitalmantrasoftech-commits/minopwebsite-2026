<script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>

<script src="~/Scripts/toastr.min.js"></script>
<script>
    $(document).ready(function () {
        $("#IdaddDiscount").val(0);

        getPendingDealerCount();
        //para 1 means getActiveDealer & iscount 1 means get all active dealer.
        getActiveOrPendingDetail(2, 1);

        getActiveDealerCount();

        getplancount();

        getManagerCount(4, 1);

        //para 2 means getActiveDealer & iscount 1 means get all active dealer.
        dropdwonValue();





        if ('@_roleid' == '21') {
            getBranchId();
            Fillmanagerddl();
            $(".assingmanager").click(function (event) {
                var sThisVal;
                var partnerIds = "";
                var status = false;
                var managerid;
                //var liccount = 0;
                bThisVal = $('input[name = dealerActiveorDeactive]:checked');
                if (bThisVal.length > 0) {
                    partnerIds = $(bThisVal).map(function (index, value) {
                        return value.id;
                    }).get().join(',');
                } else {
                    toastr.error("Please select partner.!");
                    status = false;
                    event.preventDefault();
                    return false;

                }

                if ($("#ractmanager option:selected").val() == "0") {
                    toastr.error("Please select account manager.!");
                    status = false;
                } else {
                    managerid = $("#ractmanager option:selected").val();
                    //var pname = $("#ractmanager option:selected").text();
                    //var regExp = /\(([^)]+)\)/;
                    //var matches = regExp.exec(pname);
                    //liccount = matches[1];
                    //alert(liccount);
                    status = true;
                }

                //var totalLicense = parseInt($(".No_of_Lincence_box").children("h2").text());
                //var totalLength = 0;
                //totalLength = sThisVal.length;

                //if (totalLength <= liccount && totalLength != 0) {
                //    status = true;
                //} else {
                //    if ($("#dealerPlanid option:selected").val() != "-1") {
                //        toastr.error("Please select company as per available licenses is " + liccount + ".!");
                //    }
                //    status = false;
                //}

                if (status == true) {
                    Assingpartnertorsm(partnerIds, managerid);
                }
                return false;
            });
        }

    });


    //4,0,0 for getting AccountManagername;
    $("#accountOperation").change(function () {
        var dValue = $("#idoperation option:selected").val();

        if (dValue === "1") {
            $(".assingmanager").css("display", "none");
            $("#ractmanager").css("display", "none");
            $(".Deactive_btn").css("display", "none");
            $("#IdaddDiscount").css("display", "block");
            $(".adddiscount").css("display", "block");
            $("#idPersantage").css("display", "block");

        } else if (dValue === "2") {
            $("#IdaddDiscount").css("display", "none");
            $(".adddiscount").css("display", "none");
            $("#idPersantage").css("display", "none");
            $(".Deactive_btn").css("display", "none");

            $(".assingmanager").css("display", "inline-block");
            $("#ractmanager").css("display", "inline-block");


        } else if (dValue === "3") {
            $(".Deactive_btn").css("display", "block");
            $("#IdaddDiscount").css("display", "none");
            $(".adddiscount").css("display", "none");
            $("#idPersantage").css("display", "none");
            $(".assingmanager").css("display", "none");
            $("#ractmanager").css("display", "none");

        } else if (dValue === "0") {
            $(".Deactive_btn").css("display", "none");
            $("#IdaddDiscount").css("display", "none");
            $(".adddiscount").css("display", "none");
            $("#idPersantage").css("display", "none");
            $(".assingmanager").css("display", "none");
            $("#ractmanager").css("display", "none");
        }
    })

    function getManagerCountPara(para, iscount) {
        return {
            para:para,
            iscount: iscount,
            dealerId: '@_userid'
        }
    }

    function getManagerCount(para, iscount) {
        
        var obj = getManagerCountPara(para, iscount);
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: JSON.stringify(obj),
            //{ "para": para, "dealerId": '_userid', "iscount": iscount },  //para 1 means get all plan count
            type: 'post',
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Dealers/GetregisterDealers',
            async: false,
            success: function (response) {
                if (response.length > 0) {
                    $(".No_of_Manager_box").children('h2').text(response[0].AccountMangercount);
                } else {
                    $(".No_of_Manager_box").children('h2').text('0');
                }
            }
        });
    }

    function Assingpartnertorsm(partnerids, managerid) {
        var obj = [];
        obj = assignParam(partnerids, managerid);
        $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
