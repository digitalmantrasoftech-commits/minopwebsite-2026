    function blockSpecialCharAllowSpace(evt) {
        var k;
        if (evt.keyCode > 0) {
            k = evt.keyCode;
        } else if (typeof (evt.charCode) != "undefined") {
            k = evt.charCode;
        }
        return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
    }


