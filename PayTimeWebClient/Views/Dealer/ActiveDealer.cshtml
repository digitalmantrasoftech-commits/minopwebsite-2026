@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Partner Active User</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
    <link rel="shortcut icon" href="assets/images/favicon.ico">
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/fonts/stylesheet.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/style.css" />
    <link rel="stylesheet" type="text/css" href="~/LandingAssets/css/font-awesome.min.css" />
</head>
<body>
    <div class="container">
        <div class="row margin-top-40">
            <div class="col-md-12 text-center"><img alt="Porto" width="200" src="~/LandingAssets/images/mini-logo.png"> </div>
            <div class="col-md-12 text-center margin-top-40">
                <h2><span class="success"><i class="fa fa-check-circle"></i> @ViewBag.Meg</span></h2>
            </div>
            <div class="col-md-12 text-center margin-top-40">
                @*<a class="c_login" href="/PayTime/Index">Click to Login!</a>*@
                <a class="c_login" href="//@ViewBag.Url/Dealer/Login">Click to Login!</a>
            </div>
        </div>
        <div class="row services margin-top-40">
            <h2 class="text-center">Amazing Features</h2>
            <div class="col-md-8 col-md-offset-2">
                <div class="col-md-2 wow animated  fadeInDown" data-wow-delay="1s">
                    <div class="services-box2">
                        <div class="icon"><i class="fa fa-clock-o"></i></div>
                    </div>
                </div>
                <div class="col-md-2 wow animated  fadeInDown" data-wow-delay="2s">
                    <div class="services-box2">
                        <div class="icon"><i class="fa fa-calendar"></i></div>
                    </div>
                </div>
                <div class="col-md-2 wow  animated fadeInDown" data-wow-delay="3s">
                    <div class="services-box2">
                        <div class="icon"><i class="fa fa-money"></i></div>
                    </div>
                </div>
                <div class="col-md-2 wow animated  fadeInDown" data-wow-delay="1s">
                    <div class="services-box2">
                        <div class="icon"><i class="fa fa-line-chart"></i></div>
                    </div>
                </div>
                <div class="col-md-2 wow animated  fadeInDown" data-wow-delay="2s">
                    <div class="services-box2">
                        <div class="icon"><i class="fa fa-hand-pointer-o"></i></div>
                    </div>
                </div>
                <div class="col-md-2 wow  animated fadeInDown" data-wow-delay="3s">
                    <div class="services-box2">
                        <div class="icon"><i class="fa fa-newspaper-o"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="footer2">
        <div class="container">
            <div class="row">
                <div class="col-md-12 copyright">
                    <a href="http://mantratec.com">
                        ©
                        <script>document.write(new Date().getFullYear())</script>, Mantratec Softech PVT. LTD. All Rights Reserved
                    </a>
                </div>

            </div>
        </div>
    </div>
</body>
</html>
