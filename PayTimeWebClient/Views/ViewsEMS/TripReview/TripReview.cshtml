<script>
    $(document).ready(function () {

        // Create search inputs in footer
        $("#ExpReview_tbl tfoot th").each(function () {
            var title = $(this).text();
            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
        });


        // DataTable initialisation
        var table = $("#ExpReview_tbl").DataTable({
            dom: "<'row'<'col-lg-3 col-sm-5 col-xs-12'<'record_btn_main'l,><'dt-buttons'Bf>><'col-lg-9 col-sm-7 col-xs-12 mb_margin_bottom_15'>>" +
                "<'row'<'col-sm-12 margin-bottom-10'<'customforms_table ER_tbl_scroll'tr'>>>" +
                "<'row'<'col-md-5 col-sm-5'i><'col-md-7 col-sm-7'p>>",
            paging: true,
            autoWidth: true,
            ordering: false,
            buttons: [
                "excelHtml5",
            ],
            initComplete: function (settings, json) {
                var footer = $("#ExpReview_tbl tfoot tr");
                $("#ExpReview_tbl thead").append(footer);
            }
        });


        // Apply the column Search
        $("#ExpReview_tbl thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });


        // Filter Click Hid/Show Div
        $("#Filsearch_btn").click(function () {
            $("#filtercolumn_block").toggle();
        });


        // Approve Button Click Show Perticular Data Expense
        $("#Approve_Btn").click(function () {
            $("#ExpReview_block").hide();
            $("#Filsearch_btn").hide();
            $("#closebtn").show();
            $("#ExpAction_Details").show();
        });

        $("#closebtn").click(function () {
            $("#ExpReview_block").show();
            $("#Filsearch_btn").show();
            $("#closebtn").hide();
            $("#ExpAction_Details").hide();
        });

        // Send Approval Button Click Open Swal Modal
        $("#Send_Approve_Btn").on('click', function () {
            Swal.fire({
                html: '<div class="swal_title text-left">Approve Trip</div><div class="swal_subtitle grey_font">Are you sure you want to approve this trip?</div><div class="swal_thirdtitle f-12">By approving, you confirm that the trip details are accurate and ready for processing.</div><div class="margin-top-10 text-left"><div class="form-group margin-bottom-0"><label>Reason<span class="required" aria-required="true">*</span></label><textarea class="form-control" name="" id="" placeholder="Enter Reason" maxlength="250"></textarea></div></div>',
                closeOnConfirm: true,
                showCloseButton: false,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonColor: '#d33',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#107E3E',
                confirmButtonText: 'Approve',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            });
        });

        // Send On Hold Button Click Open Swal Modal
        $("#Send_Hold_Btn").on('click', function () {
            Swal.fire({
                html: '<div class="swal_title">On-hold Trip</div><div class="swal_subtitle grey_font">Are you sure you want to put this trip on hold?</div><div class="swal_thirdtitle f-12">Putting this trip on hold will pause the processing. Trip will not move forward until further action is taken.</div><div class="margin-top-10 text-left"><div class="form-group margin-bottom-0"><label>Reason<span class="required" aria-required="true">*</span></label><textarea class="form-control" name="" id="" placeholder="Enter Reason" maxlength="250"></textarea></div></div>',
                closeOnConfirm: true,
                showCloseButton: false,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonColor: '#d33',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#E9730C',
                confirmButtonText: 'On Hold',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            });
        });

        // Send Decline Button Click Open Swal Modal
        $("#Send_Decline_Btn").on('click', function () {
            Swal.fire({
                html: '<div class="swal_title">Decline Trip</div><div class="swal_subtitle grey_font">Are you sure you want to decline this trip?</div><div class="swal_thirdtitle f-12">Declining this trip will reject the submission.</div><div class="margin-top-10 text-left"><div class="form-group margin-bottom-0"><label>Reason<span class="required" aria-required="true">*</span></label><textarea class="form-control" name="" id="" placeholder="Enter Reason" maxlength="250"></textarea></div></div>',
                closeOnConfirm: true,
                showCloseButton: false,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonColor: '#d33',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#CC3535',
                confirmButtonText: 'Decline',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            });
        });
    });
</script>

