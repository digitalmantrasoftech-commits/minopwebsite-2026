<script>
    $(document).ready(function () {

        // Create search inputs in footer
        $("#ExpAccount_tbl tfoot th").each(function () {
            var title = $(this).text();
            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
        });

        // DataTable initialisation
        var table = $("#ExpAccount_tbl").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            ordering: true,
        });
        setTimeout(function () {
            $("#" + "ExpAccount_tbl" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        // Apply the column Search
        $("#ExpAccount_tbl thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });

        // Filter Click Hide/Show Div
        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });
        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        // Reject Button Click Open Swal Modal
        $("#Reject_Btn").on('click', function () {
            Swal.fire({
                html: '<div class="swal_title text-center">Reject Expense Account</div><div class="swal_subtitle grey_font text-center">Are you sure? Do you want to reject the expense account</div>',
                closeOnConfirm: true,
                showCloseButton: false,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonColor: '#d33',
                cancelButtonText: 'Back',
                confirmButtonColor: '#2196F3',
                confirmButtonText: 'Yes',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            });
        });


    });
</script>

