    function GetAllPaymentSheetDetails() {
        checkSession();
        var _ExpenID = 0;

        $.ajax({
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiEMSURL' + 'ExpensePreparationMaster/GetExpensePaymentSheetGetAll/' + _ExpenID,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            timeout: 30000,
            beforeSend: function () {
                $("#ajax_loaderPaymentGetAll").show();
            },
            success: function (response) {
                if (response.Result != null) {
                    const sift = response.Result;

                    $('#Emp_filter').find('option:not(:first)').remove();
                    const uniqueEmpNames = new Set();
                    sift.forEach(function (item) {
                        if (item.empname) {
                            uniqueEmpNames.add(item.empname);
                        }
                    });
                    Array.from(uniqueEmpNames).sort().forEach(function (empName) {
                        $('#Emp_filter').append(`<option value="${empName}">${empName}</option>`);
                    });
                    handleGridVisibility("tblempty", "NotificationGrid-empty1", sift, {
                        imageUrl: "emptyscreen_3.png",
                        subText: "No entries found. Please add a record to get started."
                    });
                }

                $("#ajax_loaderPaymentGetAll").hide();
                var table = "";
                if (response.Result && response.Result.length > 0) {
                    const statusApproveActive = ['Pending'];

                    for (var i = 0; i < response.Result.length; i++) {
                        var item = response.Result[i];
                        var tbl = "<tr class='odd gradeX'>";
                        tbl += "<td class='ExpesneID' hidden>" + item.expenseReqID + "</td>";
                        tbl += "<td class='ExDate'>" + item.ExpenseDate + "</td>";
                        tbl += "<td class='ExType'>" + item.ExpenseType + "</td>";
                        tbl += "<td class='Exempcode'>" + item.EmpCode + "</td>";
                        tbl += "<td class='ExEmpName'>" + generateEmpPhotoHtml(item) + "</td>";
                        tbl += "<td class='ExDepartName'>" + item.DepartmentName + "</td>";
                        tbl += "<td class='ExBranch'>" + item.BranchName + "</td>";
                        tbl += "<td class='ExAmount'>" + item.TotalExpenseAmount + "</td>";
                        tbl += "<td class='downloadDoc'><div class='d-flex align-items-center justify-content-between'><span>View Receipts</span> <a href='javascript:;'><img class='tooltips' src='/assets/images/download_icon.svg' height='18' width='18' data-placement='top' data-original-title='Download Receipts' alt='download icon'></a></div></td>";


                        let statusId = item.Approval4StatusId;
                        let statusName = statusMapping[statusId] || "-";
                        if (statusName === "Approved") statusName = "Settled";
                        const statusClassMapping = {
                            'Settled': 'green_font fixed-column-1',
                            'Rejected': 'red_font fixed-column-1',
                            'Pending': 'fixed-column-1',
                        };
                        let statusClass = statusClassMapping[statusName] || '';
                        tbl += `<td class="${statusClass}">${statusName}</td>`;

                        let canApprove = statusApproveActive.includes(statusName);
                        let approveBtn = `<button class="btn blue_btnnew approve_btn tooltips" data-placement="left" data-original-title="Approve" data-expenseid="${item.expenseReqID}" data-empid="${item.EmpID}" ${canApprove ? '' : 'disabled'}><i class="fa-solid fa-check "></i></button>`;
                        let rejectBtn = `<button class="btn red_btnnew reject_btn tooltips" data-placement="left" data-original-title="Reject" data-expenseid="${item.expenseReqID}" data-empid="${item.EmpID}" ${canApprove ? '' : 'disabled'}><i class="fa-solid fa-xmark"></i></button>`;
                        tbl += `<td class="fixed-column">${approveBtn} ${rejectBtn}</td>`;
                        tbl += "</tr>";
                        table += tbl;
                    }
                }

                if ($.fn.DataTable.isDataTable('#tblexpesnePaymentGetAll')) {
                    $('#tblexpesnePaymentGetAll').DataTable().destroy();
                   // $('#tblexpesnePaymentGetAll tbody').empty();
                }

                $('#tblexpesnePaymentGetAll tbody').append(table);

                PaymentSheet_table = $("#tblexpesnePaymentGetAll").DataTable({
                    dom: _domColumn,
                    language: _languageColumn,
                    paging: true,
                    autoWidth: true,
                    ordering: true,
                    buttons: ["excelHtml5"],
                    columnDefs: [
                        { targets: [5], orderable: false }
                    ],
                    initComplete: function () {
                        var footer = $("#tblexpesnePaymentGetAll tfoot tr");
                        $("#tblexpesnePaymentGetAll thead").append(footer);
                    }
                });

                $("#tblexpesnePaymentGetAll thead").on("keyup", "input", function () {
                    PaymentSheet_table.column($(this).parent().index())
                        .search(this.value)
                        .draw();
                });

                setTimeout(function () {
                    $("#" + "tblexpesnePaymentGetAll" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                    $('.tooltips').tooltip();
                    injectExportButtonsForDataTables(false, function () {
                    });
                    $('.tooltips').tooltip();
                }, 100);
            },
            complete: function () {
                $("#ajax_loaderPaymentGetAll").hide();
            },
            error: function (jqXHR) {
                $('.loading').hide();
                if (jqXHR.status == 500) {
                    toastr.error("Internal Server Error");
                } else if (jqXHR.status == 400) {
                    toastr.error("Bad Request");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            },
        });
    }

    function checkSession() {
        $.ajax({
