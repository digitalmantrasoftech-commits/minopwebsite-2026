    //update review expense
    function updateExpensePaymentStatus(DocuStatus, ApprovalReason, ExpenReqID,PaymentEmpID)
    {
        var _UID = _EID;
        var _RoleId = '@_RoleId';
        var Obpolicyreq =
            {
                UserId: PaymentEmpID,
                RoleId: _RoleId,
                StatusName: DocuStatus,
                ApproveReason: ApprovalReason,
                ExpeReqID: ExpenReqID,
            };
        var delay = 2000;
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiEMSURL' + 'ExpensePreparationMaster/UpdatePaymentsheetRecordByID',
            data: JSON.stringify(Obpolicyreq),
            contentType: "application/json;",
            dataType: "json",
            beforeSend: function ()
            {
                $("#ajax_loaderPaymentGetAll").show();
            },
            success: function (response)
            {
                if (response != null) {
                    if (response.success == true)
                    {
                        toastr.remove();
                        if (DocuStatus == 'Approve')
                        {
                            toastr.success("Expense Payment Approved successfully.");
                        }
                        else if (DocuStatus == 'IsReject')
                        {
                            toastr.success("Expense Payment Reject successfully.");
                        }
                        setTimeout(function ()
                        {
                            window.location.reload(true);
                        }, delay);
                    }
                    else
                    {
                        toastr.remove();
                        toastr.error("failed to update Expense Payment");
                        setTimeout(function ()
                        {
                            window.location.reload(true);
                        }, delay);
                    }
                } else {
                    toastr.remove();
                    toastr.error("failed to update Expense Payment");
                    setTimeout(function () {
                        window.location.reload(true);
                    }, delay);

                }
            },
            complete: function () {
                $("#ajax_loaderPaymentGetAll").hide();
            }
        });
    }

    function generateEmpPhotoHtml(item) {
        if (!item || !item.empname) return "";

        // Prepare initials from empname
        var nameParts = item.empname.replace(/\s+/g, ' ').trim().split(" ");
        var initials = nameParts[0].charAt(0).toUpperCase();
        if (nameParts.length > 1) {
            initials += nameParts[1].charAt(0).toUpperCase();
        }

        const randomColor = "#295097";

        // Return the employee photo + initials HTML block
        return `<div class="emp_box empbox_pending">
            <img alt="" class="user_img img-circle tooltips" data-placement="right" data-original-title="Empcode : ${item.EmpCode ? item.EmpCode : ''}" src="/UploadEmpPhoto/${item.EmpPhoto ? item.EmpPhoto : ''}" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"/>
            <span class="tooltips" data-placement="right" data-original-title="Empcode : ${item.EmpCode}" style="display: none; min-width: 30px; height: 30px; line-height: 30px; text-align: center; background-color: #ecf3ff; color: ${randomColor}; border-radius: 50% !important; border: 1px solid #8ab1f7; margin-right: 8px;">
                ${initials}
            </span><span>${item.empname}</span>
        </div>`;
    }

</script>

