        $("#tbl_Policies").on('click', '.downloadDoc', function (e) {
            e.preventDefault();
            var $td = $(this);
            // read data attributes (preferred)
            var filePath = $td.data('filepath') || $td.attr('data-filepath') || '';
            var fileName = $td.data('filename') || $td.attr('data-filename') || '';

            // fallback: read the visible span text
            if (!fileName) fileName = $td.find('.PolicyFileNameDisplay').text().trim();

            // if filePath contains a path and you want only the base filename:
            if (filePath) {
                fileName = filePath.split(/[\\/]/).pop(); // handles '/' or '\' paths
            }

            // make sure to encode the filename for the URL
            var downloadUrl = '/ExpenseRequestMaster/DownloadFile?fileName=' + encodeURIComponent(fileName);

            var xhr = new XMLHttpRequest();
            xhr.open('GET', downloadUrl);
            xhr.setRequestHeader('Authorization', '@_tokan');
            xhr.responseType = 'blob';
            xhr.onload = function ()
            {
                if (xhr.status === 200)
                {
                    const url = URL.createObjectURL(xhr.response);
                    const link = document.createElement('a');
                    link.href = url;
                    link.target = '_blank';
                    // keep original extension if possible
                    const extMatch = (filePath.match(/(\.[^./\\?]+)(?:\?|$)/) || [,''])[1];
                    link.download = fileName + extMatch;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(url);
                } else
                {
                    toastr.remove();
                    toastr.error('Failed to download the file.');
                }
            };
            xhr.onerror = function(){ toastr.error('Network error while downloading the file.'); };
            xhr.send();
        });

    });

