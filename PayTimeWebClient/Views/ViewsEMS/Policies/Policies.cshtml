            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (data) {
                if (data != null) {
                    var _approvalflow = '<option value="0">Select Approval Flow</option>';
                    for (var i = 0; i < data.length; i++) {
                        if (data[i].Status === "Active") {   // ✅ only active
                            _approvalflow += '<option value="' + data[i].FlowID + '">' + data[i].FlowTitle + '</option>';
                        }
                    }
                    $("#Approvaflow").html(_approvalflow);
                }
            },
            error: function (error) {
                console.error("Error:", error);
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }


    function create() {
        $(function () {

            $("#EmpName").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@_webapiEMSURL' + 'CommanMaster/GetAllWithEmployee?EmpsqlQuery=' + request.term,
                        contentType: "application/json; charset=utf-8",
                        headers: { 'Authorization': '@_tokan' },
                        dataType: "json",
                        type: "GET",
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            if (data.length > 0) {
                                response($.map(data, function (item) {
                                    return {
                                        label: item.EmpName + '(' + item.Empcode + ')',
                                        value: item.EmpName
                                    };
                                }))
                                empid = data.Empid;
                            }
                            else {
                                $("#EmpName").val("");
                                $("#EmpName").focus();
                            }
                        },
                        error: function (response) {
                            toastr.error(response.responseText);
                        },
                        failure: function (response) {
                            toastr.error(response.responseText);
                        }
                    });
                },
                select: function (e, i) {
                    var Empcode = i.item.label.split('(')[1].split(')')[0];
                    var EmpName = i.item.value;
                    var obj = {
                        empcode: Empcode,
                        empName: EmpName
                    };
                    $.ajax({
                        url: '@_webapiEMSURL' + 'CommanMaster/GetAllWithEmployeeByIDFetch',
                        data: JSON.stringify(obj),
                        dataType: "json",
                        type: "POST",
                        headers: { 'Authorization': '@_tokan' },
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            if (data.length > 0) {
                                var autocompleteempId = data[0].EmpId;

                                var found = Object.values(empIds).find(function(value) {
                                    return parseInt(value) === autocompleteempId;
                                });
                                if (parseInt(found) !== autocompleteempId) {
                                    empIds.push(autocompleteempId);
                                    empids = empIds.join(',');
                                    var removeButton = '<a href="#" class="remove_emp_' + autocompleteempId + '"><i class="fa-solid fa-xmark"></i></a>';
                                    var newText = data[0].EmpName + "_" + data[0].Empcode + removeButton;
                                    var newSpan = $('<span></span>').html(newText);
                                    $("#Show_EmpName").append(newSpan);
                                } else {
                                    toastr.error("Employee ID already added.");
                                }
                            }
                            else {
                                empids = "0";
                            }
                        },
                    });
                },
                minLength: 1
            });

            $("#Show_EmpName").on('click', 'a', function() {
                $(this).closest('span').remove();
                var empIdToRemove = $(this).attr('class').split('remove_emp_')[1];
                empIds = empIds.filter(id => id !== empIdToRemove);
                empids = empIds.join(',');
            });
        });
    }

    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }

    function frmClear() {
        $("#PolicyName").val("");
        $("#Effect_Date").val("");
        $("#EmpName").val("");
        $("#App_till").val("0");
        $("#App_till").trigger('change');

        $("#Approvaflow").val("0");
        $("#Approvaflow").trigger('change');

        $("#BranchId").val("0");
        $("#BranchId option[value = '0']").prop('selected', true);
        $("#BranchId").multiselect('refresh');

        $("#DesignationId").val("0");
        $("#DesignationId option[value = '0']").prop('selected', true);
        $("#DesignationId").multiselect('refresh');

        $("#DepartmentId").val("0");
        $("#DepartmentId option[value = '0']").prop('selected', true);
        $("#DepartmentId").multiselect('refresh');

        $("#PolicyType").val("1");
        $("#policydesc").val("");
        $("#FileUpload").val("");
        $(".fileinput-filename").text("");
        $("#policyphotopath").val("");
        $("#policyphotoname").val("");

        empids = "";
        $("#Show_EmpName span").text("");
        $('#Show_EmpName span').remove();
        $("#hfCustomer").val("");
    }

</script>

