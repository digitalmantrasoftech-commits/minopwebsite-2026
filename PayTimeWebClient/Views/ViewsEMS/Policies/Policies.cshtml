        function formatDate(dateString) {
            const dateFormat = "@_isdateformat";

            if (!dateString) return "";

            const parsedDate = moment(dateString);

            if (!parsedDate.isValid()) return "";

            switch (dateFormat) {
                case "dd-M-yyyy":
                    return parsedDate.format("YYYY-MM-DD");
                case "dd-mm-yyyy":
                    return parsedDate.format("YYYY-MM-DD");
                case "M-dd-yyyy":
                    return parsedDate.format("YYYY-MM-DD");
                case "mm-dd-yyyy":
                    return parsedDate.format("YYYY-MM-DD");
                case "yyyy-M-dd":
                    return parsedDate.format("YYYY-MM-DD");
                case "yyyy-mm-dd":
                    return parsedDate.format("YYYY-MM-DD");
                default:
                    return parsedDate.format("YYYY-MM-DD");
                }
            }

