    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
    function truncateApprovalReason(reason, maxChars) {
        if (reason.length <= maxChars) {
            return reason;
        }
        var truncatedText = reason.substring(0, maxChars);
        var lastSpaceIndex = truncatedText.lastIndexOf(" ");
        if (lastSpaceIndex !== -1) {
            truncatedText = truncatedText.substring(0, lastSpaceIndex);
        }
        truncatedText += " ...";

        return truncatedText;
    }

    //update review expense
    function updateTripReviewStatus(DocuStatus, ApprovalReason, TripReqID) {
        var _UID = '@_empid';
        var _RoleId = '@_RoleId';
        var Obpolicyreq =
            {
                UserId: _UID,
                RoleId: _RoleId,
                StatusName: DocuStatus,
                ApproveReason: ApprovalReason,
                ExpeReqID: TripReqID,
            };

        var delay = 2000;
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiEMSURL' + 'ExpenseTripReViewMaster/UpdateReviewTripExpenseStatus',
            data: JSON.stringify(Obpolicyreq),
            contentType: "application/json;",
            dataType: "json",
            beforeSend: function () {
            },
            success: function (response) {
                if (response != null) {
                    if (response.success === true) {
                        toastr.remove();

                        if (DocuStatus === "approve") {
                            toastr.success("Trip Approved successfully.");
                        } else if (DocuStatus === "onhold") {
                            toastr.success("Trip On-Hold Successfully.");
                        } else if (DocuStatus === "decline") {
                            toastr.success("Trip Declined Successfully.");
                        } else {
                            toastr.success("Trip updated successfully.");
                        }

                    } else if (response.success === false) {
                        toastr.remove();
                        toastr.error(response.message);
                    } else {
                        toastr.remove();
                        toastr.error(response.validationErrors);
                    }
                    setTimeout(function () {
                        window.location.reload(true);
                    }, delay);
                }
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }

    function generateApproverAvatarHTML(name, empCode, photoFileName) {
        empCode = '';
        const nameParts = name ? name.trim().split(" ") : ["?"];
        let initials = nameParts[0].charAt(0).toUpperCase();
        if (nameParts.length > 1) {
            initials += nameParts[1].charAt(0).toUpperCase();
        }

        const imagePath = `/UploadEmpPhoto/${photoFileName ? photoFileName : ""}`;

        const altSpan = `<span class="avatar-initials tooltips" data-placement="right" data-original-title="Empcode : ${empCode}"
                  style="display:none;">
                  ${initials}
                </span>`;
        const html = `
    <img alt="" class="user_img zoom-image tooltips"
         data-placement="right" data-original-title="Empcode : ${empCode}"
         src="${imagePath}"
         onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"/>
    ${altSpan}
`;

        return html;
    }
    function updateTimelineProgress() {
        const steps = [
            { status: $('#app1_status').text().trim().toLowerCase(), badgeId: '#custTime_1' },
            { status: $('#app2_status').text().trim().toLowerCase(), badgeId: '#custTime_2' },
            { status: $('#app3_status').text().trim().toLowerCase(), badgeId: '#custTime_3' },
            { status: $('#app4_status').text().trim().toLowerCase(), badgeId: '#custTime_4' }
        ];

        $('.custom-timeline li').removeClass('step-complete step-pending step-declined');

        steps.forEach((step, index) => {
            const li = $('.custom-timeline li').eq(index);
            const $badge = $(step.badgeId);
            if ($badge.length === 0) return;

            $badge.removeClass('custStatus_Approved custStatus_Declined custStatus_OnHold custStatus_Pending');

            switch (step.status) {
                case 'approved':
                    li.addClass('step-complete');
                    $badge.addClass('custStatus_Approved');
                    break;
                case 'declined':
                    li.addClass('step-declined');
                    $badge.addClass('custStatus_Declined');
                    break;
                case 'onhold':
                    li.addClass('step-pending');
                    $badge.addClass('custStatus_OnHold');
                    break;
                default:
                    li.addClass('step-pending');
                    $badge.addClass('custStatus_Pending');
                    break;
            }
        });
    }

