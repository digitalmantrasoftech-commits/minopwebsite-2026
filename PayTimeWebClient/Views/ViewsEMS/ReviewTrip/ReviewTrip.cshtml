    // Function to format date (01 JAN 2024)
    function formatDate(dateString) {
        const dateFormat = "@_isdateformat";

        if (!dateString) return "";

        const parsedDate = moment(dateString);

        if (!parsedDate.isValid()) return "";

        switch (dateFormat) {
            //case "dd-mm-yyyy":
            //    return parsedDate.format("DD-MM-YYYY");
            //case "mm-dd-yyyy":
            //    return parsedDate.format("MM-DD-YYYY");
            //case "yyyy-M-dd":
            //    return parsedDate.format("YYYY-MMM-DD");
            //case "M-dd-yyyy":
            //    return parsedDate.format("MMM-DD-YYYY");
            //case "dd-M-yyyy":
            //    return parsedDate.format("DD-MMM-YYYY");
            //case "yyyy-mm-dd":
            //    return parsedDate.format("YYYY-MM-DD");
            //default:
            //    return parsedDate.format("DD-MM-YYYY");
            case "dd-M-yyyy":
                return parsedDate.format("DD-MMM-YYYY");
            case "dd-mm-yyyy":
                return parsedDate.format("DD-MM-YYYY");
            case "M-dd-yyyy":
                return parsedDate.format("MMM-DD-YYYY");
            case "mm-dd-yyyy":
                return parsedDate.format("MM-DD-YYYY");
            case "yyyy-M-dd":
                return parsedDate.format("YYYY-MMM-DD");
            case "yyyy-mm-dd":
                return parsedDate.format("YYYY-MM-DD");
            default:
                return parsedDate.format("YYYY-MM-DD");
        }
    }

