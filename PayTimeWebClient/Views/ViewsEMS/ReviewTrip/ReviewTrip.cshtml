<script>
    var isdateformat = '@_isdateformat';
    var ReviewTrip_table = "";
    var _approve = "";
    var _onHold = "";
    var _decline = "";
    $(document).ready(function () {
        checkSession();
        // Create search inputs in footer
        $("#tblReviewTrip tfoot th").each(function (index) {
            var title = $(this).text();
            if (index === 4 || index === 5) {
                $(this).html(''); // No input
            }
            else {
                $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
            }

        });
        getReviewTrip();
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiEMSURL' + 'ExpensePolicyMaster/GetPolicyListAll',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                var _empIdnew = '@_empid';
                if (response && response.length > 0) {
                    var matchedPolicy = response.find(function (item) {
                        var ids = item.EmployeeIds ? item.EmployeeIds.split(',').map(id => id.trim()) : [];
                        return ids.includes(_empIdnew);
                    });

                    if (matchedPolicy) {
                        if (matchedPolicy.ApproveTillDay) {
                            sessionStorage.setItem("ApproveTillDay", matchedPolicy.ApproveTillDay);
                        }
                    }
                }
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });

        // Filter Click Hid/Show Div
        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        // Approve Button Click Show Perticular Data Expense
        $("#Approve_Btn").click(function () {
            $("#TripReview_block").hide();
            $("#Filsearch_btn").hide();
            $("#closebtn").show();
            $("#TripAction_Details").show();
        });

        $(function () {
            $("#Emp_filter").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@_webapiEMSURL' + 'CommanMaster/GetAllWithEmployee?EmpsqlQuery=' + request.term,
                        contentType: "application/json; charset=utf-8",
                        headers: { 'Authorization': '@_tokan' },
                        dataType: "json",
                        type: "GET",
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            if (data.length > 0) {
                                response($.map(data, function (item) {
                                    return {
                                        label: item.EmpName + '(' + item.Empid + ')',
                                        value: item.EmpCode
                                    };
                                }))
                            }
                            else {
                                $("#Emp_filter").val("");
                                $("#Emp_filter").focus();
                            }
                        },
                        error: function (response) {
                            alert(response.responseText);
                        },
                        failure: function (response) {
                            alert(response.responseText);
                        }
                    });
                },
                minLength: 1
            });
        });

        var select = $('#Year_filter');
        select.empty();
        select.append('<option value="0">All</option>');
        var currentYear = new Date().getFullYear();

        for (var i = currentYear; i <= currentYear + 5; i++) {
            var option = $('<option></option>').attr("value", i).text(i);
            if (i === 0) {
                option.prop("selected", true);
            }
            select.append(option);
        }

        $(document).on('click', '#clear_operation', function (e) {
            e.preventDefault();
            $('input[type="text"]').val('');
            $('select').each(function () {
                let firstVal = $(this).find('option:first').val();
                $(this).val(firstVal);
                if ($(this).hasClass('select2')) {
                    $(this).trigger('change');
                }
            });
            $('#emp_filter').val('').trigger('change');
            $('#tripstartdate_filter').val('');
            $('#tripenddate_filter').val('');
            $('#status_filter').val('0').trigger('change');
            $('#dataTables_tbl_header').remove();
            $("#NotificationGrid-empty1").hide();
            if ($.fn.DataTable.isDataTable('#tblReviewTrip')) {
                $('#tblReviewTrip').DataTable().clear().destroy();
            }
            $('#tblReviewTrip tbody').empty();
            getReviewTrip();
        });


        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            var selectedDatestart = $('#TripStartDate_filter').val();
            var selectedDateend = $('#TripEndDate_filter').val();

            if (!selectedDatestart || !selectedDateend) return true;

            var filterStart = new Date(selectedDatestart);
            var filterEnd = new Date(selectedDateend);

            var rowStartText = $(ReviewTrip_table.row(dataIndex).node()).find('.TripStartDate').text();
            var rowEndText = $(ReviewTrip_table.row(dataIndex).node()).find('.TripEndDate').text();

            var rowStartDate = new Date(rowStartText);
            var rowEndDate = new Date(rowEndText);

            return rowStartDate >= filterStart && rowEndDate <= filterEnd;
        });

        $("#btnFilterApply").click(function () {

            // Get filter values
            var selectedEmpName = $('#Emp_filter').val();
            var selectedDatestart = $('#TripStartDate_filter').val();
            var selectedDateend = $('#TripEndDate_filter').val();
            var selectedStatus = $('#Status_filter').val();

            // Remove previous errors
            toastr.remove();
            $('.field_error').removeClass('field_error');

            // Validation
            if (selectedEmpName === "1" || !selectedEmpName) {
                toastr.error("Please select an employee.");
                $('#Emp_filter').addClass('field_error');
                return false;
            }

            //if (!selectedDatestart) {
            //    toastr.error("Please select start date.");
            //    $('#TripStartDate_filter').addClass('field_error');
            //    return false;
            //}

            //if (!selectedDateend) {
            //    toastr.error("Please select end date.");
            //    $('#TripEndDate_filter').addClass('field_error');
            //    return false;
            //}

            if (selectedStatus === "0") {
                toastr.error("Please select trip status.");
                $('#Status_filter').addClass('field_error');
                return false;
            }

            // Apply EmpName filter (assuming EmpName is column index 3)
            ReviewTrip_table.column(3).search('^' + selectedEmpName + '$', true, false);

            // Apply TripStatus filter (assuming TripStatus is column index 4)
            if (selectedStatus === "6") {
                // Combined Approved/Declined
                ReviewTrip_table.column(4).search('^(Approved|Declined)$', true, false);
            } else {
                var statusText = $("#Status_filter option:selected").text();
                ReviewTrip_table.column(4).search('^' + statusText + '$', true, false);
            }

            // Trigger redraw to apply all filters including date range
            ReviewTrip_table.draw();
            var info = ReviewTrip_table.page.info();
            if (info.recordsDisplay === 0) {
                const wrapper = $(".filter_portlet_wrapper");
                wrapper.removeClass("full-width");
                $("#NotificationGrid-empty1").show();
                $("#tblempty").hide();
            }
            if (info.recordsDisplay != 0) {
                const wrapper = $(".filter_portlet_wrapper");
                wrapper.addClass("full-width");
                $("#NotificationGrid-empty1").hide();
                $("#tblempty").show();
            }
        });
        $("#tblReviewTrip").on('click', '#Approve_Btn', function () {
            checkSession();
            $("#Send_Approve_Btn, #Send_Hold_Btn, #Send_Decline_Btn").show();
            var TripID = $(this).parent('td').parent('tr').children(1)[0].innerText.trim();
            if (TripID != null || TripID != 0) {
                $("#TripReview_block").hide();
                $("#Filsearch_btn").hide();
                $("#closebtn").show();
                $("#TripAction_Details").show();
                $("#btnsubmitReviewTrip").show();
                $(".title_note").show();
                $("#Filter_search").hide();
                fetchDataQuickView(TripID);
            }
        });

        $("#tblReviewTrip").on('click', '#btnView', function () {
            checkSession();
            $("#Send_Approve_Btn, #Send_Hold_Btn, #Send_Decline_Btn").hide();
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");
            var TripID = $(this).parent('td').parent('tr').children(1)[0].innerText.trim();
            if (TripID != null || expID != 0) {
                $("#TripReview_block").hide();
                $("#Filsearch_btn").hide();
                $("#closebtn").show();
                $("#TripAction_Details").show();
                $("#btnsubmitReviewExp").hide();
                $("#btnsubmitReviewTrip").hide();
                $(".title_note").hide();
                $("#Filter_search").hide();
                fetchDataQuickView(TripID);
            }
        });

        $("#closebtn").click(function () {
            $("#Filter_search").show();
            $("#TripReview_block").show();
            $("#Filsearch_btn").show();
            $("#closebtn").hide();
            $("#TripAction_Details").hide();
        });


        // Send Approval Button Click Open Swal Modal
        $("#Send_Approve_Btn").on('click', function () {

            checkSession();
            _approve = "approve";

            var tripStartDateStr = sessionStorage.getItem("tripStartDate");   // format: DD-MM-YYYY
            var tripEndDateStr = sessionStorage.getItem("tripEndDate");       // format: DD-MM-YYYY
            var approveTillDay = parseInt(sessionStorage.getItem("ApproveTillDays"));

            if (!tripEndDateStr) {
                toastr.remove();
                toastr.error("Trip end date not found. Please try again.");
                return;
            }

            function parseDate(dateStr) {
                if (!dateStr) return null;

                const isoDate = new Date(dateStr);
                if (!isNaN(isoDate.getTime())) {
                    return isoDate;
                }

                const dmyParts = dateStr.split("-");
                if (dmyParts.length === 3) {
                    const day = dmyParts[0];
                    const month = dmyParts[1];
                    const year = dmyParts[2];
                    const formattedDate = `${year}-${month}-${day}T00:00:00`;
                    const dmyDate = new Date(formattedDate);
                    if (!isNaN(dmyDate.getTime())) {
                        return dmyDate;
                    }
                }
                const mdyParts = dateStr.split("-");
                if (mdyParts.length === 3) {
                    const month = mdyParts[0];
                    const day = mdyParts[1];
                    const year = mdyParts[2];
                    const formattedDate = `${year}-${month}-${day}T00:00:00`;
                    const mdyDate = new Date(formattedDate);
                    if (!isNaN(mdyDate.getTime())) {
                        return mdyDate;
                    }
                }

                return null;
            }

            var tripStartDate = parseDate(tripStartDateStr);
            var tripEndDate = parseDate(tripEndDateStr);

            if (!tripStartDate || isNaN(tripStartDate.getTime())) {
                toastr.remove();
                toastr.error("Invalid start date format.");
                return;
            }

            if (!tripEndDate || isNaN(tripEndDate.getTime())) {
                toastr.remove();
                toastr.error("Invalid end date format.");
                return;
            }

            tripEndDate.setHours(0, 0, 0, 0);

            var today = new Date();
            today.setHours(0, 0, 0, 0);

            if (tripStartDate > today) {
                toastr.remove();
                toastr.error("Trip cannot be approved. StartDate is in the future.");
                return;
            }

            var diffTime = today.getTime() - tripEndDate.getTime();
            var diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays > approveTillDay) {
                toastr.remove();
                toastr.error(`Approval not allowed. Trip is older than the allowed policy limit of <b>${approveTillDay}</b> day(s).`);
                return;
            }

            Swal.fire({
                title:
                    "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Success",
                html: `<div class="swal_subtitle">
                <b>Are you sure you want to approve this trip?</b>
                <p>By approving, you confirm that the trip details are accurate and ready for processing.</p>
                <p><b>Note:</b> Once approved, the trip cannot be modified.</p>
               </div>`,
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No',
                confirmButtonText: 'Yes',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then(function (isConfirmed) {
                if (isConfirmed.dismiss === "cancel" || isConfirmed.dismiss === "close") {
                    return;
                }

                var _tripId = $('#_tripReqCodeID').val();
                updateTripReviewStatus(_approve, '', _tripId);
            });

            $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]')
                .closest('.swal2-popup')
                .addClass('swal_success');
        });


        // Send On Hold Button Click Open Swal Modal
        // Send On Hold Button Click
        // -------------------- On Hold Button --------------------
        $("#Send_Hold_Btn").on('click', function () {
            checkSession();
            _onHold = "onhold";
            var _tripId = $('#_tripReqCodeID').val();

            var tripStartDateStr = sessionStorage.getItem("tripStartDate");
            var tripEndDateStr = sessionStorage.getItem("tripEndDate");
            var approveTillDay = parseInt(sessionStorage.getItem("ApproveTillDays"));

            if (!tripEndDateStr) {
                toastr.remove();
                toastr.error("Trip end date not found. Please try again.");
                return;
            }
            var tripStartDate = new Date(tripStartDateStr);
            tripStartDate.setHours(0, 0, 0, 0); // normalize expense date
            var tripEndDate = new Date(tripEndDateStr);
            tripEndDate.setHours(0, 0, 0, 0); // normalize expense date

            //function parseDMY(dateStr) {
            //    if (!dateStr) return null;

            //    const parts = dateStr.split("-");
            //    if (parts.length !== 3) return null;

            //    const d = parts[0];
            //    const m = parts[1];
            //    const y = parts[2];

            //    return new Date(`${y}-${m}-${d}T00:00:00`);
            //}
            if (isNaN(approveTillDay)) {
                toastr.remove();
                toastr.error("Approval policy not found. Please contact admin.");
                return;
            }
            //var tripStartDate = parseDMY(tripStartDateStr);
            //var tripEndDate = parseDMY(tripEndDateStr);
            //tripEndDate.setHours(0, 0, 0, 0);

            var today = new Date();
            today.setHours(0, 0, 0, 0);

            if (isNaN(tripEndDate.getTime())) {
                toastr.remove();
                toastr.error("Invalid trip end date format.");
                return;
            }
            if (tripStartDate > today) {
                toastr.remove();
                toastr.error("Trip cannot be put on hold. StartDate is in the future.");
                return;
            }

            var diffTime = today.getTime() - tripEndDate.getTime();
            var diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays > approveTillDay) {
                toastr.remove();
                toastr.error(`On Hold not allowed. Trip is older than the allowed policy limit of <b>${approveTillDay}</b> day(s).`);
                return;
            }


            Swal.fire({
                title:
                    "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_warning.svg' alt=''>Info",
                html: `<div class="swal_subtitle">
         <b>Are you sure you want to put this trip on hold?</b>
         <p>Putting this trip on hold will pause the processing. Trip will not move forward until further action is taken.</p>
         <div class="margin-top-10 text-left">
             <div class="form-group margin-bottom-0">
                 <label>Reason<span class="required" aria-required="true">*</span></label>
                 <textarea class="form-control" name="onholdReason" id="onholdReason" placeholder="Enter Reason" maxlength="250"></textarea>
             </div>
         </div>
        </div>`,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'Cancel',
                confirmButtonText: 'On Hold',
                allowOutsideClick: false,
                allowEscapeKey: false,
                preConfirm: function () {
                    return new Promise(function (resolve) {
                        var _onholdReason = $('#onholdReason').val().trim();
                        if (_onholdReason === "") {
                            $('#onholdReason').addClass('field_error');
                            toastr.remove();
                            toastr.error("Please enter Reason.");
                            resolve(false);
                        } else {
                            $('#onholdReason').removeClass('field_error');
                            resolve(true);
                        }
                    });
                },
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then(function (isConfirmed) {
                if (isConfirmed.dismiss === "cancel" || isConfirmed.dismiss === "close") {
                    return;
                }

                var _onholdReason = $('#onholdReason').val().trim();
                updateTripReviewStatus(_onHold, _onholdReason, _tripId);
            });

            $('img[src="/assets/images/icons/swal_icon/icon_warning.svg"]')
                .closest('.swal2-popup')
                .addClass('swal_warning');
        });

        // -------------------- Decline Button --------------------
        $("#Send_Decline_Btn").on('click', function () {
            checkSession();

            Swal.fire({
                title:
                    "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error",
                html: `<div class="swal_subtitle"><b>Are you sure you want to decline this trip?</b><p>Declining this trip will reject the submission. Trip will not be processed further.</p><p>Please review the details to ensure an accurate decision.</p><div class="margin-top-10 text-left"><div class="form-group margin-bottom-0"><label>Reason<span class="required" aria-required="true">*</span></label><textarea class="form-control" name="declineReason" id="declineReason" placeholder="Enter Reason" maxlength="250"></textarea></div></div></div>`,
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonColor: '#d33',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#CC3535',
                confirmButtonText: 'Decline',
                allowOutsideClick: false,
                allowEscapeKey: false,
                preConfirm: function () {
                    return new Promise(function (resolve) {
                        _declineReason = $('#declineReason').val().trim();
                        if (_declineReason === "") {
                            $('#declineReason').addClass('field_error');
                            toastr.remove();
                            toastr.error("Please enter Reason.");
                            resolve(false);
                            return false;
                        } else {
                            $('#declineReason').removeClass('field_error');
                            resolve(true);
                        }
                    });
                },
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then(function (isConfirmed) {
                if (isConfirmed.dismiss == "cancel" || isConfirmed.dismiss == "close") {
                    // Cancelled
                } else {
                    var _tripId = $('#_tripReqCodeID').val();
                    var _declineReason = $('#declineReason').val().trim();
                    if (_declineReason === "") {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Reason Required',
                            text: 'Please enter a reason for declining this trip.',
                        });
                        return;
                    }
                    updateTripReviewStatus('decline', _declineReason, _tripId);
                }
            });

            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]')
                .closest('.swal2-popup')
                .addClass('swal_error');
        });

        // -------------------- Restrict Input --------------------
        // Allow only letters, numbers & spaces in Reason fields
        $(document).on("input", "#declineReason, #onholdReason", function () {
            this.value = this.value.replace(/[^a-zA-Z0-9 ]/g, '');
        });

        // Block copy/paste/cut
        $(document).on("paste copy cut", "#declineReason, #onholdReason", function (e) {
            e.preventDefault();
            toastr.warning("Copy & paste not allowed in Reason field.");
        });


    });
    $(function () {
        $("#TripStartDate_filter").datepicker({
            dateFormat: "yy-M-dd",
            showButtonPanel: true,
