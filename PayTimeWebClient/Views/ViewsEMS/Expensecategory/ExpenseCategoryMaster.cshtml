                }
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Category Master</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                @if (isClientDBMatchFlag == "true")
                {
                    <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                }
                else
                {
                    <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
