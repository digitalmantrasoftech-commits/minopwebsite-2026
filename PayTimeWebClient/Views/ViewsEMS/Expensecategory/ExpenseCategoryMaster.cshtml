            @if (obj.CanAdd)
            {
                <div class="emp_btn_block">
                    <div class="text-right">
                        <a href="javascript:;" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Add Category Master" id="AddcategorymasterBtn"><i class="fa-solid fa-plus"></i></a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


@if (obj.CanView)
{
    <div id='ajax_loaderapproval' class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="portlet">
                <div class="portlet-body">
                    <div id="tblempty">
                        <div class="table-responsive" id="tableResponsive">
                            <table class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column" id="tblCategoryGetall">
                            </table>
                        </div>
                    </div>
                    <div id="NotificationGrid-empty">
                        <div class="datanotfound">
                            <img src="" height="148" width="280" alt="Nodata Found Icon">
                            <p class="datanotfound_title"></p> <!-- titleText -->
                            <p class=""></p><!-- subText -->
                        </div>
                    </div>
                    <div id="AddcategorymasterBtn_modal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                        <div class="modal-dialog" style="width:500px;">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal" id="btnClose">×</button>
                                    <h4 class="modal-title">Category Master</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="modal-card">
                                        <fieldset>
                                            <div class="head_box">
                                                <div class="row">
                                                    <div class="af_modal_box">
                                                        <div class="col-xs-6">

                                                            <div class="form-group">
                                                                <label>Category Name<span class="required" aria-required="true">*</span></label>
                                                                <input type="text" class="form-control input-sm" name="" id="txtcategoryname" placeholder="Enter Category Name" maxlength="100">
                                                            </div>
                                                        </div>
                                                        <div class="col-xs-6">
                                                            <div class="form-group">
                                                                <label>Description<span class="required" aria-required="true">*</span></label>
                                                                <input type="text" class="form-control input-sm" name="" id="txtDescription" placeholder="Enter Description" maxlength="150">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <div class="row">
                                        <div class="col-lg-12 text-right">
                                            <input type="hidden" id="txtcategoryid" value="0" />
                                            <input type="button" class="btn clear_btn" data-dismiss="modal" value="Cancel" id="btnCancel" />
                                            <button class="btn save_btn" type="button" id="btnSavecategory"><i class="fa-light fa-floppy-disk"></i> Save</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
else
{
    <script>
        Swal.fire({
            title:
                "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_info.svg' alt=''> Unauthorized Access",
            html:
                "<div class='swal_subtitle'>" +
                "<b>Access denied. You don’t have the required permissions to view this page.</b>" +
                "<p>Please contact your administrator if you believe this is a mistake.</p>" +
                "</div>",
            showCloseButton: true,
            showCancelButton: false,
            focusConfirm: false,
            cancelButtonText: 'Close',
            confirmButtonText: 'Go to Dashboard',
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                popup: 'swal_info',                     // <<-- Add class directly to popup
                confirmButton: 'swal-confirm-button-class',
                cancelButton: 'swal-cancel-button-class'
            }
        }).then(function (result) {
            if (result.isConfirmed) {
                window.location.href = "/MinopProduct/EMSDashboard";
            }
        });
    </script>
}
