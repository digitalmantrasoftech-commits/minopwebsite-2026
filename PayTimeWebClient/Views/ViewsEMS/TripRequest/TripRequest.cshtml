        checkSession();
           $.ajax({
    type: "POST",
    headers: { 'Authorization': '@_tokan' },
    url: '@_webapiEMSURL' + 'ExpensePolicyMaster/GetPolicyListAll',
    contentType: "application/json; charset=utf-8",
    dataType: "json",
    success: function (response) {
        var _empIdnew = '@_empid';
        var tooltipText = "Policy not assigned"; // default

        if (response && response.length > 0) {
            // Find TRP policy for this employee
            var matchedPolicy = response.find(function (item) {
                var ids = item.EmployeeIds
                    ? item.EmployeeIds.split(',').map(id => id.trim())
                    : [];
                return ids.includes(_empIdnew) && item.PolicyCode && item.PolicyCode.startsWith("TRP");
            });

            if (matchedPolicy) {
                sessionStorage.setItem("policyEffectiveDate_TRP", matchedPolicy.EffectiveDate || "");
                sessionStorage.setItem("policyCode", matchedPolicy.PolicyCode || "");
                tooltipText = 'Assigned Travel Policy: ' + matchedPolicy.PolicyCode;
            } else {
                tooltipText = 'No Travel Policy assigned.';
            }
        } else {
            tooltipText = 'No policies found';
        }

        // Apply tooltip
        $('#ExpView')
            .attr('title', tooltipText)
            .attr('data-original-title', tooltipText)
            .tooltip('dispose')
            .tooltip();
    },
    error: function (xhr, status, error) {
        console.error("Error fetching policy list:", error);
    }
});


        // Handle view click to open modal
        $("#ExpView").on('click', function (e) {
            checkSession();
            e.preventDefault();
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiEMSURL' + 'ExpensePolicyMaster/GetPolicyListAll',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response) {
                    var _empIdnew = '@_empid';

                    // Reset modal content
                    $('#pdfViewer').hide().attr('src', '');
                    $('#policyIdText').hide();
                    $('#noPolicyImg').hide();
                    $('#noPolicyMsg').text('');

                    if (response && response.length > 0) {
                        var matchedPolicy = response.find(function (item) {
                            var ids = item.EmployeeIds ? item.EmployeeIds.split(',').map(id => id.trim()) : [];
                            return ids.includes(_empIdnew) && item.PolicyCode.startsWith('TRP');
                        });

                        if (matchedPolicy) {
                            var fileName = matchedPolicy.PolicyFileName.replace(/\\/g, '/');
                            var documentURL = '/UploadEMSDoc/' + fileName;

                            // Check if file exists before showing
                            $.ajax({
                                url: documentURL,
                                type: 'HEAD',
                                success: function () {
                                    // File exists, now set iframe source
                                    $('#pdfViewer').attr('src', documentURL).show();
                                    $('#policyIdText').hide();
                                },
                                error: function () {
                                    // File doesn't exist – show custom image/message
                                    $('#pdfViewer').hide().attr('src', '');
                                    $('#noPolicyImg').attr('src', '/assets/images/emptyscreen_1.png').show(); // <-- Update image path if needed
                                    $('#noPolicyMsg').text("Policy document not found.");
                                    $('#policyIdText').show();
                                }
                            });
                        } else {
                            $('#noPolicyImg').show();
                            $('#noPolicyMsg').text("No policy assigned for this employee.");
                            $('#policyIdText').show();
                        }
                    } else {
                        $('#noPolicyImg').show();
                        $('#noPolicyMsg').text("No policies found.");
                        $('#policyIdText').show();
                    }

                    $('#policy_modal').show();
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching policy:", error);
                    $('#pdfViewer').hide();
                    $('#noPolicyImg').show();
                    $('#noPolicyMsg').text("Error loading policy.");
                    $('#policyIdText').show();
                    $('#policy_modal').show();
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });




    $('#closeModal').on('click', function () {
        $("#policy_modal").hide();
        $('#pdfViewer').attr('src', '').hide(); // Clear and hide PDF
       // $('#policyIdText').text('').hide();     // Clear message
    });

        $("#TripRequest_tbl").on('click', '.clm_delete_btn', function () {
            checkSession();
            var delay = 1000;
            var selectedRow = $(this).closest("tr");
            var tripId = selectedRow.find(".TripID").text();
            var status = 1;

            if (tripId > 0) {
                Swal.fire({
                    title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Delete",
                    html: `<div class="swal_subtitle">
                               <b>Are you sure you want to delete this trip?</b>
                               <p>If you delete this trip, it cannot be recovered.</p>
                               <div class="margin-top-10 text-left"></div>
                           </div>`,
                    closeOnConfirm: true,
                    showCloseButton: true,
                    showCancelButton: true,
                    focusConfirm: false,
                    cancelButtonText: 'Back',
                    confirmButtonText: 'Yes',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    customClass: {
                        confirmButton: 'swal-confirm-button-class',
                        cancelButton: 'swal-cancel-button-class'
                    }
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            type: "POST",
                            url: '@_webapiEMSURL' + 'ExpenseTripRequestMaster/DeleteTripByTripID?TripID=' + tripId + '&EStatus=' + status,
                            headers: { 'Authorization': '@_tokan' },
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            beforeSend: function () {
                                $("#ajax_loader").show();
                            },
                            success: function (response) {
                                toastr.remove();
                                if (response != null) {
                                    if (response.success === true)
                                    {
                                        toastr.success(response.message);
                                    } else
                                    {
                                        toastr.error(response.message);
                                    }
                                }
                                else
                                {
                                    toastr.error("Unexpected error occurred.");
                                }
                                setTimeout(function () {
                                    window.location.reload(true);
                                }, delay);
                            },
                            error: function (xhr) {
                                toastr.remove();
                                if (xhr != null) {
                                    var obj = JSON.parse(xhr.responseText || "{}");
                                    if (obj.MegSts === 'error') {
                                        toastr.error(obj.Meg);
                                    } else {
                                        toastr.error("Request failed.");
                                    }
                                }
                                setTimeout(function () {
                                    window.location.reload(true);
                                }, delay);
                            },
                            complete: function () {
                                $("#ajax_loader").hide();
                            }
                        });
                    }
                });

                // Match styling with other delete popups
                $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]')
                    .closest('.swal2-popup')
                    .addClass('swal_error');
            }
        });

        function checkSession() {
            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                },
                error: function (data) {
                    window.location.href = data;
                }
            });
        }
        function getTriprequestall(_UID, _ComID, _BranchID, _RoleIDnew) {
            checkSession();
            var obj = {
                userId: _UID,
                roleId: _RoleIDnew,
                companyID: _ComID,
                branchId: _BranchID,
                departmentID: "1"
            };
            $("#TripRequest_tbl tfoot th").each(function () {
                var title = $(this).text();
                $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
            });



            $.ajax({
                url: '@_webapiEMSURL' + 'ExpenseTripRequestMaster/GetTripRequestAll',
                type: 'POST',
                headers: { 'Authorization': '@_tokan' },
                contentType: 'application/json', // Set content type to JSON
                dataType: 'json',
                data: JSON.stringify(obj),
                beforeSend: function () {
                    $("#ajax_loader").show();
                },

                success: function (response) {
                    if (response != null) {
                        const List = response;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", List, {
                            imageUrl: "emptyscreen_1.png",
                            subText: "No entries found. Please add a record to get started."
                        });
                    }
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    //var table = "";
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            var tbl = "<tr class='odd gradeX'>";
                            tbl += "<td class='TripID' hidden>" + response[i].TripID;
                            tbl = tbl + "</td>";
                            tbl += "<td class='TripName'>" + response[i].TripName;
                            tbl = tbl + "</td>";
                            tbl += "<td class='TripStartDate'>" + response[i].TripStartDate;
                            tbl = tbl + "</td>";
                            tbl += "<td class='TripEndDate'>" + response[i].TripEndDate;
                            tbl = tbl + "</td>";
                            tbl += "<td class='TripPurpose' hidden>" + response[i].TripPurpose;
                            tbl = tbl + "</td>";
                            //tbl += "<td class='LocationType'>" + response[i].LocationType;
                            //tbl = tbl + "</td>";
                            //tbl += "<td class='receipts downloadDoc' >" + response[i].Receipts;
                            //tbl += "<a href='javascript:;'><img src='/assets/images/download_icon.svg' height='18' width='18' alt='download icon'></a>";
                            //tbl = tbl + "</td>";
                            //tbl += "<td class='reason'>" + response[i].Description;
                            //tbl = tbl + "</td>";
                            var statusClass;
                            var statusClass2;
                            switch (response[i].Statusname)
                            {
