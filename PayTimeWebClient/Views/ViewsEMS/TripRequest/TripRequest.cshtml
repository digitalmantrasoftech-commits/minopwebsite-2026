        var isDateformat = "dd-mm-yyyy";
        newDetail.find('#DepartureDate').datepicker({


            autoclose: true,
            format: isDateformat,
            todayHighlight: true,
            // Add any other datepicker options here
        });


        $("#depart_box__addmore").append(newDetail);
