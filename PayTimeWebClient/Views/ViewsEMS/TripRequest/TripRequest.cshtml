    function generateApproverAvatarHTML(name, empCode, photoFileName) {
        empCode = '';
        const nameParts = name ? name.trim().split(" ") : ["?"];
        let initials = nameParts[0].charAt(0).toUpperCase();
        if (nameParts.length > 1) {
            initials += nameParts[1].charAt(0).toUpperCase();
        }

        const imagePath = `/UploadEmpPhoto/${photoFileName ? photoFileName : ""}`;

        const altSpan = `<span class="avatar-initials tooltips" data-placement="right" data-original-title="Empcode : ${empCode}"
                  style="display:none;">
                  ${initials}
                </span>`;
        const html = `
    <img alt="" class="user_img zoom-image tooltips"
         data-placement="right" data-original-title="Empcode : ${empCode}"
         src="${imagePath}"
         onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"/>
    ${altSpan}
`;

        return html;
    }
    function updateTimelineProgress() {
        const steps = [
            { status: $('#app1_status').text().trim().toLowerCase(), badgeId: '#custTime_1' },
            { status: $('#app2_status').text().trim().toLowerCase(), badgeId: '#custTime_2' },
            { status: $('#app3_status').text().trim().toLowerCase(), badgeId: '#custTime_3' },
            { status: $('#app4_status').text().trim().toLowerCase(), badgeId: '#custTime_4' }
        ];

        $('.custom-timeline li').removeClass('step-complete step-pending step-declined');

        steps.forEach((step, index) => {
            const li = $('.custom-timeline li').eq(index);
            const $badge = $(step.badgeId);
            if ($badge.length === 0) return;

            $badge.removeClass('custStatus_Approved custStatus_Declined custStatus_OnHold custStatus_Pending');

            switch (step.status) {
                case 'approved':
                    li.addClass('step-complete');
                    $badge.addClass('custStatus_Approved');
                    break;
                case 'declined':
                    li.addClass('step-declined');
                    $badge.addClass('custStatus_Declined');
                    break;
                case 'onhold':
                    li.addClass('step-pending');
                    $badge.addClass('custStatus_OnHold');
                    break;
                default:
                    li.addClass('step-pending');
                    $badge.addClass('custStatus_Pending');
                    break;
            }
        });
    }


</script>

