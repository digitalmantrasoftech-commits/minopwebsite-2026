        // Create search inputs in footer
        $("#TripRequest_tbl tfoot th").each(function (index) {
            var title = $(this).text();
            if (index === 4 || index === 5) {
                $(this).html(''); // No input
            }
            else {
                $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
            }
        });

        // Add Expense modal open and close
        $("#TripRequestBtn").on('click', function () {


            //$("#TripStartdt,#DepartureDate").datepicker({
            //    format: isDateformat,
            //    todayHighlight: true,
            //    autoclose: true
            //});

            //$("#TripRequest_modal").show();
            $("#TripRequestBtn").attr("data-toggle", "modal");
            $("#TripRequestBtn").attr("data-target", "#TripRequest_modal");
        });

        $("#TripStartdt").datepicker({
            format: "yyyy-mm-dd", // Set the desired date format
            autoclose: true,       // Automatically close after date selection
            todayHighlight: true,  // Highlight today’s date
        }).on('changeDate', function () {
            // When the start date is selected, clear the end date and reset the end date picker
            var fromDate = $("#TripStartdt").val();
            var newdate = new Date(fromDate);
            $("#TripEnddt").val(""); // Clear the end date field

            // Remove previous datepicker and reinitialize with startDate as fromDate
            $('#TripEnddt').datepicker("remove");
            $("#TripEnddt").datepicker({
                format: "yyyy-mm-dd",  // Ensure the end date format is the same
                startDate: newdate,     // Set the start date for the end date picker
                autoclose: true,        // Automatically close the datepicker
                todayHighlight: true,   // Highlight today's date
            });
        });

        $('#TripPurpose').on('input', function () {
            var maxLength = 30;
            var currentLength = $(this).val().length;
            $('#charCount').text(currentLength + "/" + maxLength);
        });

        // On changing the TripEnddt date
        $("#TripEnddt").change(function () {
            $(this).removeClass('field_error'); // Remove error class if date is selected
        });

        // Input sanitization: Only allow numeric characters and dashes for the date fields
        $('#TripStartdt, #TripEnddt, #DepartureDate').on('input', function () {
            var sanitized = $(this).val().replace(/[^0-9\-]/g, '');  // Allow only numbers and dashes
            $(this).val(sanitized);
        });

        // View Trip Status modal open and close
        $("#ViewTripStatusBtn").on('click', function () {
            $("#ViewTripStatusBtn").attr("data-toggle", "modal");
            $("#ViewTripStatusBtn").attr("data-target", "#ViewTripStatus_modal");
        });
        $('#TripName,#TripPurpose,#DepartFrom,#Destination,#ClientName').on('input', function () {
            var exTitle = $(this).val();
            if (!/^[a-zA-Z0-9\s]*$/.test(exTitle)) {
                $(this).val(exTitle.replace(/[^a-zA-Z0-9\s]/g, ''));
            }
        });
        $('#TripName,#TripPurpose,#DepartFrom,#Destination,#ClientName').keydown(function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });

        var UploadTripDepartList = [];
        $("#TripRequest_tbl").on('click', '.clm_view_btn', function () {
    checkSession();
    $("#ExpView").hide();
    $("#TripRequest_modal, #TripRequest_block, #TripRequestBtn").hide();
    $("#closebtn, #TripView_Details").show();

    // Get TripID from selected row
    var selectedRow = $(this).closest("tr");
    var tripId = selectedRow.find(".TripID").text().trim();
    $("#TripID").val(tripId);

    $.ajax({
        url: '@_webapiEMSURL' + 'ExpenseTripRequestMaster/QuickTripRequestGetByID?TripID=' + tripId,
        type: "GET",
        headers: { 'Authorization': '@_tokan' },
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (data) {
            if (data.length > 0) {
                var firstItem = data[0];

                $('#ViewTripName').html(`${firstItem.TripName} (${firstItem.TripExpReqCode})`);
                $('#ViewTripdesc').html(firstItem.TripPurpose);
                $('#empemail').html(firstItem.EmpEmail);
                $('#empname').html(firstItem.EmpName);
                var rawStartDate = firstItem.TripStartDate.split("T")[0];
                var rawEndDate = firstItem.TripEndDate.split("T")[0];

                var durationInDays = Math.ceil((new Date(rawEndDate) - new Date(rawStartDate)) / (1000 * 60 * 60 * 24)) + 1;


                var formattedsDate = formatDate(rawStartDate);
                var formattedeDate = formatDate(rawEndDate);

                $('#TripDuration').html('Duration: ' + formattedsDate + ' - ' + formattedeDate + ' (' + durationInDays + ' Days)');


                if (firstItem.UploadTripDepartList?.length > 0) {
                    $('.expense_bill_line').empty();
                    firstItem.UploadTripDepartList.forEach(function (uploadItem) {
                        var row = $('<div class="row margin-bottom-10"></div>');
                        row.html(`
                            <div class="col-sm-3 col-xs-6">
                                <div class="mb-0 expense_value" id="ClientNameDateView">${uploadItem.ClientName}</div>
                            </div>
                            <div class="col-sm-2 col-xs-6">
                                <div class="mb-0 expense_value" id="DepartureDateView">${formatDate(uploadItem.DepartureDate.split("T")[0])}</div>
                            </div>
                            <div class="col-sm-3 col-xs-6">
                                <div class="mb-0 expense_value" id="DepartFormDateView">${uploadItem.DepartForm}</div>
                            </div>
                            <div class="col-sm-3 col-xs-6">
                                <div class="mb-0 expense_value" id="DestinationDateView">${uploadItem.Destination}</div>
                            </div>
                                `);
                        $('.expense_bill_line').append(row);
                    });
                }


                if (firstItem.TripDepartureStatusList?.length > 0) {
                    var statusItem = firstItem.TripDepartureStatusList[0];

                    $('#App1_name').html(statusItem.ApproverLevel1Name);
                    $('#App2_name').html(statusItem.ApproverLevel2Name);
                    $('#App3_name').html(statusItem.ApproverLevel3Name);
                    $('#App4_name').html(statusItem.ApproverLevel4Name);

                    $('#ApprovalLevel1ID').html(statusItem.ApprovalLevel1ID);
                    $('#ApprovalLevel2ID').html(statusItem.ApprovalLevel2ID);
                    $('#ApprovalLevel3ID').html(statusItem.ApprovalLevel3ID);


                    $('#app1_photo').html(generateApproverAvatarHTML(statusItem.ApproverLevel1Name, '', statusItem.ApproverLevel1Photo));
                    $('#app2_photo').html(generateApproverAvatarHTML(statusItem.ApproverLevel2Name, '', statusItem.ApproverLevel2Photo));
                    $('#app3_photo').html(generateApproverAvatarHTML(statusItem.ApproverLevel3Name, '', statusItem.ApproverLevel3Photo));


                    updateApprovalStatus(statusItem.ApprovalStatus1, '#app1_status');
                    updateApprovalStatus(statusItem.ApprovalStatus2, '#app2_status');
                    updateApprovalStatus(statusItem.ApprovalStatus3, '#app3_status');
                    updateApprovalStatus(statusItem.ApprovalStatus4, '#app4_status');


                    var maxWords = 250;
                    $('#_approval1Reason').html(truncateApprovalReason(statusItem.Approval1Reason, maxWords));
                    $('#_approval2Reason').html(truncateApprovalReason(statusItem.Approval2Reason, maxWords));
                    $('#_approval3Reason').html(truncateApprovalReason(statusItem.Approval3Reason, maxWords));
                    $('#_approval4Reason').html(truncateApprovalReason(statusItem.Approval4Reason, maxWords));

                    updateTimelineProgress();
                }
            }
        }
    });


    function updateApprovalStatus(status, selector) {
        var statusMap = {
            'Drafted': 'orange_font',
            'Submit': 'blue_font',
            'Pending': 'grey_font',
            'Approved': 'green_font',
            'Declined': 'red_font',
            'ReSubmitted': 'blue_font',
            'OnHold': 'orange_font',
            'IsReject': 'grey_font'
        };
        var cssClass = statusMap[status] || '';
        $(selector).removeClass('grey_font green_font red_font blue_font orange_font yellow_font').addClass(cssClass).text(status);
    }
});



        $("#closebtn").click(function () {
            $("#ExpView").show();
            $("#TripRequest_block").show();
            $("#TripRequestBtn").show();
            $("#closebtn").hide();
            $("#TripView_Details").hide();
