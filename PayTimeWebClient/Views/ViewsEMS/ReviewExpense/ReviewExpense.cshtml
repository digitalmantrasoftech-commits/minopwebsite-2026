                    function updateApprovalStatus(status, selector) {
                        switch (status) {
                            case 'Drafted': $(selector).removeClass().addClass('orange_font').text('Drafted'); break;
                            case 'Submit': $(selector).removeClass().addClass('blue_font').text('Submit'); break;
                            case 'Pending': $(selector).removeClass().addClass('grey_font').text('Pending'); break;
                            case 'Approved': $(selector).removeClass().addClass('green_font').text('Approved'); break;
                            case 'Declined': $(selector).removeClass().addClass('red_font').text('Declined'); break;
                            case 'ReSubmitted': $(selector).removeClass().addClass('blue_font').text('ReSubmitted'); break;
                            case 'OnHold': $(selector).removeClass().addClass('orange_font').text('OnHold'); break;
                            case 'IsReject':
                                $(selector).removeClass().addClass('red_font').text('Rejected');
                                break
                            default: break;
                        }
                    }
                    function checkApproval(levelId, status)
                    {
                        if (levelId == @_empid && (status || '').trim().toLowerCase() === 'approved')
