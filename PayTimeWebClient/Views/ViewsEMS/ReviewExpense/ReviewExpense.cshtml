                                .css("pointer-events", "none")  // no click
                                .css("opacity", "0.6");         // greyed out
                        }
                    }
                }
            }
        });
    }


    // download individual file
    function downloadFile(expDocName) {
        var downloadUrl = '/ExpenseRequestMaster/DownloadFile?fileName=' + expDocName;
        var xhr = new XMLHttpRequest();
        xhr.open('GET', downloadUrl);
        //xhr.setRequestHeader('Authorization', '@_tokan');
        xhr.responseType = 'blob';
        xhr.onload = function () {
            if (xhr.status === 200) {
                var url = URL.createObjectURL(xhr.response);
                var link = document.createElement('a');
                link.href = url;
                link.target = '_blank';
                link.download = expDocName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } else {
                console.error('Error:', xhr.status);
                toastr.remove();
                toastr.error('Error occurred while downloading the file.');
            }
        };
        xhr.send();
    }

    //update review expense
    function updateExpenseReviewStatus(DocuStatus, ApprovalReason, ExpenReqID) {
        var _UID = _EID;
        var _RoleId = '@_RoleId';
        var Obpolicyreq =
            {
                UserId: _UID,
                RoleId: _RoleId,
                StatusName: DocuStatus,
                ApproveReason: ApprovalReason,
                ExpeReqID: ExpenReqID,
            };

        var delay = 2000;
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiEMSURL' + 'ExpenseReViewMaster/UpdateReviewExpenseStatus',
            data: JSON.stringify(Obpolicyreq),
            contentType: "application/json;",
            dataType: "json",
            beforeSend: function () {
            },
            success: function (response) {
                if (response != null) {
                    if (response.success === true) {
                        toastr.remove();
                        if (DocuStatus === "approve") {
                            toastr.success("Expense Approved successfully.");
                        } else if (DocuStatus === "Decline") {
                            toastr.success("Expense Declined successfully.");
                        } else if (DocuStatus === "OnHold") {
                            toastr.success("Expense put On Hold successfully.");
                        } else {
                            toastr.success("Expense updated successfully.");
                        }
                        setTimeout(function () {
                            window.location.reload(true);
                        }, delay);
                    } else {
                        toastr.remove();
                        toastr.error("Failed to update Expense Review Status");
                        setTimeout(function () {
                            window.location.reload(true);
                        }, delay);
                    }
                } else {
                    toastr.remove();
                    toastr.error("Failed to update Expense Review Status");
                    setTimeout(function () {
                        window.location.reload(true);
                    }, delay);
                }

            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }

    function truncateApprovalReason(reason, maxChars) {
        if (reason.length <= maxChars) {
            return reason; // Return the reason as it is if it's already within the limit
        }

        // Trim the reason to the maximum number of characters
        var truncatedText = reason.substring(0, maxChars);

        // Find the last space within the truncated text
        var lastSpaceIndex = truncatedText.lastIndexOf(" ");

        // If the last space exists, truncate at the last space
        if (lastSpaceIndex !== -1) {
            truncatedText = truncatedText.substring(0, lastSpaceIndex);
        }

        // Append ellipsis
        truncatedText += " ...";

        return truncatedText;
    }




