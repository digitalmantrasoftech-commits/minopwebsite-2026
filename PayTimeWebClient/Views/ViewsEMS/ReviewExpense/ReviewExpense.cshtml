<script>
    var isdateformat = '@_isdateformat';
    var ReviewExp_table = "";
    var expDocID = "";
    var expDocName = "";
    var _EID = '@_empid';
    $(document).ready(function () {
        checkSession();

        $("#tblReviewExpense tfoot th").each(function (index) {
            var title = $(this).text();
            if (index === 6 || index === 7) {
                $(this).html(''); // No input
            }
            else {
                $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
            }
        });
        getReviewExpense();

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        $(function () {
            $("#Emp_filter").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@_webapiEMSURL' + 'CommanMaster/GetAllWithEmployee?EmpsqlQuery=' + request.term,
                        contentType: "application/json; charset=utf-8",
                        headers: { 'Authorization': '@_tokan' },
                        dataType: "json",
                        type: "GET",
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            if (data.length > 0) {
                                response($.map(data, function (item) {
                                    return {
                                        label: item.EmpName + '(' + item.Empid + ')',
                                        value: item.EmpCode
                                    };
                                }))
                            }
                            else {
                                $("#Emp_filter").val("");
                                $("#Emp_filter").focus();
                            }
                        },
                        error: function (response) {
                            alert(response.responseText);
                        },
                        failure: function (response) {
                            alert(response.responseText);
                        }
                    });
                },
                minLength: 1
            });
        });
        $(document).on('click', '#clear_operation', function (e) {
            e.preventDefault();
            $('input[type="text"]').val('');
            $('select').each(function () {
                if ($(this).hasClass('select2')) {
                    $(this).val($(this).find('option:first').val()).trigger('change');
                } else {
                    $(this).val($(this).find('option:first').val());
                }
            });
            $('#Emp_filter').val('').trigger('change');
            $('#ExpenseDate_filter').val('');
            $('#Status_filter').val('0').trigger('change');
            $('#dataTables_tbl_header').remove();
            $("#NotificationGrid-empty1").hide();
            getReviewExpense();
        });



        $("#btnFilterApply").click(function () {
            // Get values
            var selectedEmpName = $('#Emp_filter').val();
            var selectedDate = $('#ExpenseDate_filter').val();
            var selectedStatus = $('#Status_filter').val();

            // Remove previous errors and highlights
            toastr.remove();
            $('.field_error').removeClass('field_error');

            // Validate Emp Name
            if (selectedEmpName === "1" || selectedEmpName === null) {
                toastr.error("Please select an employee.");
                $('#Emp_filter').addClass('field_error');
                return false;
            }

            //// Validate Expense Date
            //if (selectedDate === "" || selectedDate === null) {
            //    toastr.error("Please select expense date.");
            //    $('#ExpenseDate_filter').addClass('field_error');
            //    return false;
            //}

            // Validate Status
            if (selectedStatus === "0") {
                toastr.error("Please select expense status.");
                $('#Status_filter').addClass('field_error');
                return false;
            }

            // All validations passed - apply filters
            ReviewExp_table.column(1).search('^' + selectedEmpName + '$', true, false).draw();

            var formattedDate = formatDate(selectedDate);
            ReviewExp_table.column(2).search(formattedDate).draw();

            if (selectedStatus === "6") {
                ReviewExp_table.column(6).search('^(Approved|Declined)$', true, false).draw();
            } else {
                var statusText = $("#Status_filter option:selected").text();
                ReviewExp_table.column(6).search('^' + statusText + '$', true, false).draw();
            }
            var info = ReviewExp_table.page.info();
            if (info.recordsDisplay === 0) {
                const wrapper = $(".filter_portlet_wrapper");
                wrapper.removeClass("full-width");
                $("#NotificationGrid-empty1").show();
                $("#tblempty").hide();
            }
            if (info.recordsDisplay != 0) {
                const wrapper = $(".filter_portlet_wrapper");
                wrapper.addClass("full-width");
                $("#NotificationGrid-empty1").hide();
                $("#tblempty").show();
            }
        });

        $("#tblReviewExpense").on('click', '#Approve_Btn', function () {
            checkSession();
            var expID = $(this).parent('td').parent('tr').children(1)[0].innerText.trim();
            if (expID != null || expID != 0) {
                $("#ExpReview_block").hide();
                $("#Filsearch_btn").hide();
                $("#closebtn").show();
                $("#ExpAction_Details").show();
                $("#btnsubmitReviewExp").show();
                $("#Filter_search").hide();
                 $("#Send_Approve_Btn, #Send_Hold_Btn, #Send_Decline_Btn").show();

                fetchDataQuickView(expID);
            }

            //download document individual
            $(document).on('click', '.downRecipt', function () {
                var parentDiv = $(this).closest('.col-sm-3');
                var FileName = parentDiv.find('.downloadRecipt').val();
                var docid = parentDiv.find('.docid').val();
                expDocName = FileName;
                //expDocID = "1";
                //expDocName = expDocName + "_" + expDocID + "_" + new Date().getFullYear() + '-' + ('0' + (new Date().getMonth() + 1)).slice(-2) + '-' + ('0' + new Date().getDate()).slice(-2) + ' ' + ('0' + new Date().getHours()).slice(-2) + '-' + ('0' + new Date().getMinutes()).slice(-2) + '-' + ('0' + new Date().getSeconds()).slice(-2);

                downloadFile(expDocName);
            });
        });

        $('#btnView').on('click', function () {
            $("#tblempty").hide();
        });

        $("#tblReviewExpense").on('click', '#btnView', function () {
            $("#Send_Approve_Btn").hide();
            $("#Send_Hold_Btn").hide();
            $("#Send_Decline_Btn").hide();
            checkSession();
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");
            var expID = $(this).parent('td').parent('tr').children(1)[0].innerText.trim();
            if (expID != null || expID != 0) {
                $("#ExpReview_block").hide();
                $("#Filsearch_btn").hide();
                $("#closebtn").show();
                $("#ExpAction_Details").show();
                $("#btnsubmitReviewExp").hide();
                $("#Filter_search").hide();
                fetchDataQuickView(expID);
            }

            //download document individual
            $(document).on('click', '.downRecipt', function () {
                var parentDiv = $(this).closest('.col-sm-3');
                var FileName = parentDiv.find('.downloadRecipt').val();
                var docid = parentDiv.find('.docid').val();
                expDocName = FileName;
                //expDocName = expDocName + "_" + docid + "_" + new Date().getFullYear() + '-' + ('0' + (new Date().getMonth() + 1)).slice(-2) + '-' + ('0' + new Date().getDate()).slice(-2) + ' ' + ('0' + new Date().getHours()).slice(-2) + '-' + ('0' + new Date().getMinutes()).slice(-2) + '-' + ('0' + new Date().getSeconds()).slice(-2);

                downloadFile(expDocName);
            });
        });

        $("#closebtn").click(function () {
            $("#Filter_search").show();
            $('.chkemp').remove();
            $("#ExpReview_block").show();
            $("#Filsearch_btn").show();
            $("#closebtn").hide();
            $("#ExpAction_Details").hide();
        });

        $("#Send_Approve_Btn").on('click', function () {
            checkSession();
            //  Get stored session values
            var expenseDateStr = sessionStorage.getItem("ExpenseDate");
            var approveTillDay = parseInt(sessionStorage.getItem("ApproveTillDay"));

            if (expenseDateStr && !isNaN(approveTillDay)) {
                var today = new Date();
                today.setHours(0, 0, 0, 0); // normalize to start of today

                var expenseDate = new Date(expenseDateStr);
                expenseDate.setHours(0, 0, 0, 0); // normalize expense date

                //  1. Block if expense date is in the future
                if (expenseDate > today) {
                    toastr.remove();
                    toastr.error("Approval not allowed. Expense date is in the future.");
                    return;
                }

                //  2. Block if older than allowed policy days
                var diffTime = today.getTime() - expenseDate.getTime();
                var diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

                if (diffDays > approveTillDay) {
                    toastr.remove();
                    toastr.error("Approval not allowed. Expense is older than the allowed policy limit of " + approveTillDay + " day(s).");
                    return;
                }
            }

            //  Allow Swal approval confirmation
            Swal.fire({
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_success.svg' alt=''>Success",
                html: '<div class="swal_subtitle"><b>Are you sure you want to approve this expense?</b><p>By approving, you confirm that the expense details are accurate and ready for processing.</p><p><b>Note:</b> Once approved, the expense cannot be modified.</p></div>',
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No',
                confirmButtonText: 'Yes',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then(function (isConfirmed) {
                if (isConfirmed.dismiss === "cancel" || isConfirmed.dismiss === "close") {
                    return;
                } else {
                    var _exId = $('#_expeReqCodeID').val();
                    updateExpenseReviewStatus('approve', '', _exId);
                }
            });

            $('img[src="/assets/images/icons/swal_icon/icon_success.svg"]')
                .closest('.swal2-popup')
                .addClass('swal_success');
        });




        //  Send On Hold Button Click Event
        // -------------------- On Hold Button --------------------
        $("#Send_Hold_Btn").on('click', function () {
            checkSession();

            //  Get stored session values
            var expenseDateStr = sessionStorage.getItem("ExpenseDate");
            var approveTillDay = parseInt(sessionStorage.getItem("ApproveTillDay"));

            if (expenseDateStr && !isNaN(approveTillDay)) {
                var today = new Date();
                today.setHours(0, 0, 0, 0); // normalize to start of today

                var expenseDate = new Date(expenseDateStr);
                expenseDate.setHours(0, 0, 0, 0); // normalize expense date

                //  1. Block if expense date is in the future
                if (expenseDate > today) {
                    toastr.remove();
                    toastr.error("On Hold not allowed. Expense date is in the future.");
                    return;
                }

                //  2. Block if older than allowed policy days
                var diffTime = today.getTime() - expenseDate.getTime();
                var diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

                if (diffDays > approveTillDay) {
                    toastr.remove();
                    toastr.error("On Hold not allowed. Expense is older than the allowed policy limit of " + approveTillDay + " day(s).");
                    return;
                }
            }

            //  Open Swal confirmation
            Swal.fire({
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_warning.svg' alt=''>Info",
                html: `
            <div class="swal_subtitle">
                <b>Are you sure you want to put this expense on hold?</b>
                <p>Putting this expense on hold will pause the processing. Expense will not move forward until further action is taken.</p>
                <div class="margin-top-10 text-left">
                    <div class="form-group margin-bottom-0">
                        <label>Reason<span class="required" aria-required="true">*</span></label>
                        <textarea class="form-control" name="onholdReason" id="onholdReason" placeholder="Enter Reason" maxlength="250"></textarea>
                    </div>
                </div>
            </div>`,
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'Cancel',
                confirmButtonText: 'On Hold',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then(function (isConfirmed) {
                if (isConfirmed.dismiss === "cancel" || isConfirmed.dismiss === "close") {
                    return;
                } else {
                    var _exId = $('#_expeReqCodeID').val();
                    var _onholdReason = $('#onholdReason').val().trim();

                    //  Block if reason is empty
                    if (_onholdReason === "") {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Reason Required',
                            text: 'Please enter a reason for putting this expense on hold.',
                        });
                        return;
                    }

                    //  Call API if valid
                    updateExpenseReviewStatus('OnHold', _onholdReason, _exId);
                }
            });

            //  Add custom swal style
            $('img[src="/assets/images/icons/swal_icon/icon_warning.svg"]')
                .closest('.swal2-popup')
                .addClass('swal_warning');
        });

        // -------------------- Decline Button --------------------
        $("#Send_Decline_Btn").on('click', function () {
            checkSession();

            Swal.fire({
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Error",
                html: `
            <div class="swal_subtitle">
                <b>Are you sure you want to decline this expense?</b>
                <p>Declining this expense will reject the submission. Expense will not be processed further.</p>
                <p>Please review the details to ensure an accurate decision.</p>
                <div class="margin-top-10 text-left">
                    <div class="form-group margin-bottom-0">
                        <label>Reason<span class="required" aria-required="true">*</span></label>
                        <textarea class="form-control" name="declineReason" id="declineReason" placeholder="Enter Reason" maxlength="250"></textarea>
                    </div>
                </div>
            </div>`,
                closeOnConfirm: true,
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonColor: '#d33',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#CC3535',
                confirmButtonText: 'Decline',
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then(function (isConfirmed) {
                if (isConfirmed.dismiss == "cancel" || isConfirmed.dismiss == "close") {
                    return;
                } else {
                    var _exId = $('#_expeReqCodeID').val();
                    var _declineReason = $('#declineReason').val().trim();

                    if (_declineReason === "") {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Reason Required',
                            text: 'Please enter a reason for declining this expense.',
                        });
                        return;
                    }

                    updateExpenseReviewStatus('Decline', _declineReason, _exId);
                }
            });

            //  Optional: style the modal like the others
            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]')
                .closest('.swal2-popup')
                .addClass('swal_error');
        });

        // -------------------- Validation for both textareas --------------------
        // Allow only letters, numbers & space
        $(document).on("input", "#declineReason, #onholdReason", function () {
            this.value = this.value.replace(/[^a-zA-Z0-9 ]/g, '');
        });

        // Block copy/paste/cut
        $(document).on("paste copy cut", "#declineReason, #onholdReason", function (e) {
            e.preventDefault();
            toastr.warning("Copy & paste not allowed in Reason field.");
        });


    });
    $(function () {
        $("#ExpenseDate_filter").datepicker({
            dateFormat: "yy-M-dd", // Must match response format
            showButtonPanel: true
        });
    });
    //Expense datatable
    function getReviewExpense() {
    var approveCount = 0;
    var declineCount = 0;
    var submitCount = 0;

    var _UID = '@_UserId';
    var _RoleId = '@_RoleId';
    var _branchIdNew = '@_branchid';
    var _cmdidNew = '@_cmpid';
    var _empIdNew = '@_empid';
    var _empNameNew = '@_empName';
    var _EID = '@_empid';

    if ($.fn.DataTable.isDataTable('#tblReviewExpense')) {
        ReviewExp_table.destroy();
    }

    checkSession();

    var obj = {
        UserId: _EID,
        RoleId: _RoleId,
        CompanyID: _cmdidNew,
        BranchId: _branchIdNew,
        DepartmentID: "1",
    };
    $.ajax({
        url: '@_webapiEMSURL' + 'ExpenseReViewMaster/GetAllReviewExpenseList',
        type: 'POST',
        headers: { 'Authorization': '@_tokan' },
        contentType: 'application/json',
        dataType: 'json',
        data: JSON.stringify(obj),
        beforeSend: function () {
            $("#ajax_loader").show();
        },
        success: function (response) {
            if (response != null) {
                const ER = response;
                ER.forEach(item => {
                    sessionStorage.setItem('TripStartDate_' + item.expId, item.TripStartdate);
                    sessionStorage.setItem('TripEndDate_' + item.expId, item.TripEndDate);
                });
                handleGridVisibility("tblempty", "NotificationGrid-empty", ER, {
                    imageUrl: "emptyscreen_3.png",
                    subText: "No matching records found for the selected filters."
                });
            }

            // Populate EmpName dropdown
            $('#Emp_filter').find('option:not(:first)').remove();
            let uniqueEmpNames = [...new Set(response.map(x => x.EmpName).filter(Boolean))];
            $.each(uniqueEmpNames, function (i, name) {
                $('#Emp_filter').append($('<option>', {
                    value: name,
                    text: name
                }));
            });

            // Build table rows
            var table = "";
            if (response != null) {

                for (var i = 0; i < response.length; i++) {
                    var tbl = "<tr class='odd gradeX'>";
                    tbl += "<td class='expId' hidden>" + response[i].expId + "</td>";
                    tbl += "<td class='EmpName'>" + response[i].EmpName + "</td>";
                    tbl += "<td class='Expense-Date'>" + response[i].ExpenseDate + "</td>";
                    tbl += "<td class='ExpenseType'>" + response[i].ExpenseType + "</td>";
                    tbl += "<td class='reason'>" + (response[i].Description || response[i].TripPurpose) + "</td>";
                    tbl += "<td class='ExpenseAmount'>" + (response[i].ExpenseAmount ?? '-') + "</td>";

                    var statusClass = '';
                    var statusText = response[i].ExpenseStatus;

                    switch (response[i].ExpenseStatus) {
                        case 'Drafted':
                            statusClass = 'orange_font';
                            break;
                        case 'Submitted':
                            statusClass = 'blue_font';
                            break;
                        case 'Approved':
                            statusClass = 'green_font';
                            break;
                        case 'On Hold':
                            statusClass = 'orange_font';
                            break;
                        case 'Declined':
                            statusClass = 'red_font';
                            break;
                        case 'Reimbursed':
                            statusClass = 'green_font';
                            break;
                        case 'IsReject':
                            statusClass = 'red_font';
                            statusText = 'Rejected';
                            break;
                    }

                    tbl += "<td class='" + statusClass + "'>" + (statusText || '-') + "</td>";
                    tbl += "<td>";
                    if (['Submitted', 'On Hold', 'Drafted'].includes(response[i].ExpenseStatus)) {
                        tbl += "<a class='btn blue_btnnew tooltips approve_btn' id='Approve_Btn' data-placement='top' data-original-title='Approve'><i class='fa-solid fa-check'></i></a>";
                    } else {
                        tbl += "<a class='btn blue_btnnew tooltips approve_btn disabled' id='Approve_Btn' data-placement='top' data-original-title='Approve' disabled><i class='fa-solid fa-check'></i></a>";
                    }
                    tbl += "<a class='btn blue_btnnew tooltips clm_view_btn' id='btnView' title='View'><i class='fa-regular fa-eye'></i></a>";
                    tbl += "</td></tr>";

                    table += tbl;
                }
            }

            $('#tblReviewExpense tbody').html(table);

            ReviewExp_table = $("#tblReviewExpense").DataTable({
                dom: _domColumn,
                language: _languageColumn,
                paging: true,
                autoWidth: true,
