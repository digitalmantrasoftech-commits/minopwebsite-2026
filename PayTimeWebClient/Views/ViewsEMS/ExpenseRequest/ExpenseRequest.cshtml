                            tbl += "<a class='btn blue_btnnew tooltips clm_view_btn' id='ViewTripReq_btn' title='View'><i class='fa-regular fa-eye'></i></a>";
                        }
                        else if (response[i].StatusID == 11117) // IsReject
                        {
                            tbl += "<a class='btn blue_btnnew tooltips clm_view_btn' id='ViewTripReq_btn' title='View'><i class='fa-regular fa-eye'></i></a>";
                        }

                        else {   //Other
