        $(document).on('click', '#downRecipt', function () {
            var expDocName = $(this).closest('.row').find('.downloadRecipt').val();
            if (!expDocName) {
                toastr.error("File name not found");
                return;
            }
            var downloadUrl = '@_webapiEMSURL' + 'ExpenseRequestMaster/DownloadFile?fileName=' + encodeURIComponent(expDocName);
            var xhr = new XMLHttpRequest();
            xhr.open('GET', downloadUrl, true);
            xhr.setRequestHeader('Authorization', '@_tokan');
            xhr.responseType = 'blob';
            $("#ajax_loader").show();
            xhr.onload = function () {
                $("#ajax_loader").hide();
                if (xhr.status === 200) {
                    var blob = xhr.response;
                    var url = window.URL.createObjectURL(blob);
                    var link = document.createElement('a');
                    link.href = url;
                    link.download = expDocName;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(url);
                    toastr.success("Download started");
                }
                else {
                    toastr.error("File not found");
                }
            };
            xhr.onerror = function () {
                $("#ajax_loader").hide();
                toastr.error("Server error ");
            };
            xhr.send();
        });
