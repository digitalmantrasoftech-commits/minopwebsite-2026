                        function updateApprovalStatus(status, selector) {
                            switch (status) {
                                case 'Drafted':
                                    $(selector).removeClass('grey_font green_font red_font blue_font orange_font').addClass('orange_font').text('Drafted');
                                    break;
                                case 'Submit':
                                    $(selector).removeClass('orange_font grey_font green_font red_font blue_font yellow_font').addClass('blue_font').text('Submit');
                                    break;
                                case 'Pending':
                                    $(selector).removeClass('orange_font green_font').addClass('grey_font').text('Pending');
                                    break;
                                case 'Approved':
                                    $(selector).removeClass('orange_font grey_font').addClass('green_font').text('Approved');
                                    break;
                                case 'Declined':
                                    $(selector).removeClass('orange_font grey_font').addClass('red_font').text('Declined');
                                    break;
                                case 'ReSubmitted':
                                    $(selector).removeClass('orange_font grey_font green_font red_font yellow_font').addClass('blue_font').text('ReSubmitted');
                                    break;
                                case 'OnHold':
                                    $(selector).removeClass('orange_font grey_font green_font red_font blue_font').addClass('orange_font').text('OnHold');
                                    break;
                                case 'IsReject':
                                    $(selector).removeClass('orange_font green_font blue_font yellow_font grey_font')
                                        .addClass('red_font')
                                        .text('Rejected');
                                    break;

                                default:
                                    // handle default case
                                    break;
                            }
                        }
                    }
                }

