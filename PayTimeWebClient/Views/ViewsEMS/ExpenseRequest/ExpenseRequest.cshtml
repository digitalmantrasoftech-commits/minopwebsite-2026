    function normalizeToIsoDate(rawDateString) {
        if (!rawDateString) return null; // Handle empty/undefined

        // Case 1: dd-M-yyyy  => "04-Sep-2025"
        let match = rawDateString.match(/^(\d{2})-([A-Za-z]{3})-(\d{4})$/);
        if (match) {
            let [, day, mon, year] = match;
            const months = { Jan: "01", Feb: "02", Mar: "03", Apr: "04", May: "05", Jun: "06", Jul: "07", Aug: "08", Sep: "09", Oct: "10", Nov: "11", Dec: "12" };
            if (months[mon]) return `${year}-${months[mon]}-${day}`;
        }

        // Case 2: dd-mm-yyyy => "04-09-2025"
        match = rawDateString.match(/^(\d{2})-(\d{2})-(\d{4})$/);
        if (match) {
            let [, day, month, year] = match;
            return `${year}-${month}-${day}`;
        }

        // Case 3: M-dd-yyyy => "Sep-04-2025"
        match = rawDateString.match(/^([A-Za-z]{3})-(\d{2})-(\d{4})$/);
        if (match) {
            let [, mon, day, year] = match;
            const months = { Jan: "01", Feb: "02", Mar: "03", Apr: "04", May: "05", Jun: "06", Jul: "07", Aug: "08", Sep: "09", Oct: "10", Nov: "11", Dec: "12" };
            if (months[mon]) return `${year}-${months[mon]}-${day}`;
        }

        // Case 4: mm-dd-yyyy => "09-04-2025"
        match = rawDateString.match(/^(\d{2})-(\d{2})-(\d{4})$/);
        if (match) {
            let [, month, day, year] = match;
            return `${year}-${month}-${day}`;
        }

        // Case 5: yyyy-M-dd => "2025-Sep-04"
        match = rawDateString.match(/^(\d{4})-([A-Za-z]{3})-(\d{2})$/);
        if (match) {
            let [, year, mon, day] = match;
            const months = { Jan: "01", Feb: "02", Mar: "03", Apr: "04", May: "05", Jun: "06", Jul: "07", Aug: "08", Sep: "09", Oct: "10", Nov: "11", Dec: "12" };
            if (months[mon]) return `${year}-${months[mon]}-${day}`;
        }

        // Case 6: yyyy-mm-dd => already ISO "2025-09-04"
        match = rawDateString.match(/^(\d{4})-(\d{2})-(\d{2})$/);
        if (match) {
            let [, year, month, day] = match;
            return `${year}-${month}-${day}`;
        }

        // Default: try JS Date
        let d = new Date(rawDateString);
        if (!isNaN(d)) {
            let year = d.getFullYear();
            let month = (d.getMonth() + 1).toString().padStart(2, '0');
            let day = d.getDate().toString().padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        return null;
    }


