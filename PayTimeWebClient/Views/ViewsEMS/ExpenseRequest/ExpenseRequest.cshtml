        $(document).on('input', '.er_details__boxdetail #FileUpload', function () {
            var _code = '@_accountcd';
            if (this.files.length === 0)
                return;
            var file = this.files[0];

            var maxSize = 1000 * 1024;
            if (file.size > maxSize) {
                toastr.error("Select file up to 1 MB only.");
                $(this).val("");
                return;
            }
            var allowedExtensions = [".bmp", ".png", ".jpg", ".jpeg", ".pdf"];
            var fileName = file.name.toLowerCase();
            var isValid = allowedExtensions.some(ext => fileName.endsWith(ext));

            if (!isValid) {
