                        var approveCount = 0;
                        var declineCount = 0;
                        var submitCount = 0;
                        var statusClass;
                        var statusArr = response[i].ExpenseStatus ? response[i].ExpenseStatus.split(',') : [];
                        for (var j = 0; j < statusArr.length; j++) {
                            var statusParts = statusArr[j].trim().split('(');
                            var statusName = statusParts[0].trim();
                            var count = 0;
                            //parseInt(statusParts[1].replace(')', '').trim());

                            switch (statusName) {
                                case 'Drafted':
                                    statusClass = 'orange_font';
                                    break;
                                case 'Approved':
                                    statusClass = 'green_font';
                                    approveCount += count;
                                    break;
                                case 'Declined':
                                    statusClass = 'red_font';
                                    declineCount += count;
                                    break;
                                case 'Submitted':
                                    statusClass = 'blue_font';
                                    submitCount += count;
                                    break;
                                case 'On Hold':
                                    statusClass = 'orange_font';
                                    break;
                                case 'IsReject':
                                    statusClass = 'red_font';
                                    break;
                                default:
                                    break;
                            }
                        }

                        var displayStatus = response[i].ExpenseStatus ? response[i].ExpenseStatus.replace(/IsReject/g, "Rejected") : "-";
                        tbl += "<td class='" + statusClass + "'>" + displayStatus + "</td>";
                        tbl += "<td>";


