            <div class="portlet" id="tblSchedulerdetails">
                <div class="portlet-body">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div id="tblempty">
                                <div class="table-responsive" id="tableResponsive">
                                    <table id="tblScheduler" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column" style="display:block;">
                                        <thead>
                                            <tr>
                                                <th style="display:none;">Sr. No</th>
                                                <th>Taskid</th>
                                                <th style="min-width: 120px;">Scheduler Type</th>
                                                <th>Scheduler Date <i class='fa-regular fa-circle-info tooltips' data-placement='bottom' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                                <th>Scheduler Time</th>
                                                <th>Company Name</th>
                                                <th>Branch Name</th>
                                                <th>Send To CompanyHead</th>
                                                <th>Send To DepartmentHead</th>
                                                <th>ReportName</th>
                                                <th>Execute last date</th>
                                                <th>Execute last status</th>
                                                <th>Status</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                            <div id="NotificationGrid-empty" style="display: none">
