        function deprtdetailsbybrnchid(BranchId) {
            $("#divEmp").hide();
            $('#EmpIdTbl tr').remove();
            $('#EmpIdTbl tr').empty();
            $("#EmpIdTbl").empty();
            $('#tblEmp1 tr').remove();
            $('#tblEmp1 tr').empty();
            $("#tblEmp1").empty();

            $.ajax({
                type: "POST",
                url: "/Transactions/GetDeptbyBranch?BranchId=" + BranchId,
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }

                    if (response != null) {
                        $selectDep.multiselect('enable');
                        for (var i = 0; i < response.length; i++) {
                            $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                        }
                        $selectDep.multiselect('rebuild');

                    }
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }

