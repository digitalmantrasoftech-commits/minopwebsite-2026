        $.post("/Transactions/GetEmpByDept?empArr=" + DeptIdlst + ";" + bID, function (response) {
            if (response.isRedirect) {
                window.location.href = response.redirectUrl;
            }
            var table = "";
            if (response != null) {
                for (var i = 0; i < response.length; i++) {

                    var _eid = response[i].EmpId;
                    var tbl = "<tr class='odd gradeX' id='tr_" + response[i].EmpId + "'>";
                    tbl = tbl + "<td id='eid' hidden>" + response[i].EmpId;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='ecode'>" + response[i].Empcode;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='enm'>" + response[i].EmpName;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='epid'>" + response[i].EmpPunchID;
                    tbl = tbl + "</td>";
                    if (ID == "") {
                        tbl = tbl + "<td id=''><input type='checkbox' onchange=EmpIdArray('" + response[i].EmpId + "',checked); class='ClsChkEmp' id='" + response[i].EmpId + "'/>";
                    }
                    else {
                        var _id = ID.split(",");
                        var d = 0;
                        for (l = 0; l < _id.length; l++) {
                            if (_id[l] == _eid) {
                                d = 1;
                                tbl = tbl + "<td id=''><input type='checkbox' onchange=EmpIdArray('" + response[i].EmpId + "',checked); class='ClsChkEmp' id='" + response[i].EmpId + "' checked/>";

                            }
                        }
                        if (d == 0) {
                            tbl = tbl + "<td id=''><input type='checkbox' onchange=EmpIdArray('" + response[i].EmpId + "',checked); class='ClsChkEmp' id='" + response[i].EmpId + "'/>";
                        }
                    }

                    tbl = tbl + "</td>";
                    tbl = tbl + "</tr>";
                    table += tbl;
                }
            }
            $("#tblEmp1").destroy;
            $('#tblEmp1').append(table);
            $('#tblEmp1').dataTable({
                "columnDefs": [
                                    {
                                        "targets": [0],
                                        "visible": false,
                                        "searchable": false,
                                    }

                ],
                "destroy": true,
                "bInfo": false,
                "bPaginate": false,
                "bLengthChange": false,
                "columns": [
                    { "title": "Employee ID" },
                     { "title": "Code" },
                    { "title": "Employee Name" },
                    { "title": "Punch ID" },
                    { "title": "<input type='checkbox' id='CheckAll' onchange='AllCheckedEmp(this)' />" }
                ],
                "order": [[2, 'asc']]
            });
        });
