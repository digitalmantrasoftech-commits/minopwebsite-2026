    function ClearSelectiondata() {
        $("#Taskid").val('0');
        $("#CompanyID").val(null);
        $("#select2-CompanyID-container").html("Select Company");
        $("#select2-CompanyID-container").attr("title", "Select Company");
        $("#BranchId").empty();
        $("#BranchId").append("<option value='0'>Select Branch</option>");
        $("#BranchId").val(0);

        $("#DeptIds option:selected").prop("selected", false);
        $("#DeptIds").multiselect('refresh');
        $("#DeptIds").multiselect('disable');
        $('#DepartmentIdTbl').empty();
        $('#EmpIdTbl tr').remove();
        $('#EmpIdTbl tr').empty();
        $("#EmpIdTbl").empty();
        $("#txt2").val(0);
        $("#txt3").val(0);
        $("#hdnCompanyHead").val("0");
        $("#hdnDepartmentHead").val("0");
        $("#hdnEmployee").val("0");
        $("#ChkAllEmp").prop("checked", false);
        $('.check-container input:checkbox').prop("checked", false);
        $('.mt-checkbox-single input:checkbox').prop("checked", false);
        $("#EmpIds option:selected").prop("selected", false);
        $("#EmpIds").multiselect('refresh');
        $("#EmpIds").multiselect('disable');
        $("#spvalidation").text("");
        $("#spValidation").hide();
        $("#spvalidationemp").text("");
        $("#spvalidationemp").hide();
        $("#spvalidationsent").text("");
        $("#spvalidationsent").hide();
        $("#spvalidationrpt").text("");
        $("#spvalidationrpt").hide();

        $("#spvalidationCustrpt").text("");
        $("#spvalidationCustrpt").hide();

        $("#tblEmp1_wrapper").remove();
        $("#tblEmp1").destroy;
        $("#BranchName").after('<table class="table table-striped table-bordered table-hover table-checkable order-column ClsChkEmp" id="tblEmp1"></table>');
        $("#lblemp").hide();

        $('#CustrptIDstr').val(''),
        $('#CustrptNamestr').val(''),
        $('#CustrptIDstr').text(''),
        $('#CustrptNamestr').text(''),
        selectedEmpArray = new Array();
        selectedrptIdArray = new Array();
        selectedrptNameArray = new Array();
        CustomrptIdArray = new Array();
        CustomrptNameArray = new Array();
        $("#EmpID").val("0")
        allVals = [];
        $("#Triggerid").val(0);

        $('[name="areaofinterest"]').each(function (i, e) {
            if ($(e).is(':checked')) {
                $('[name="areaofinterest"]').removeAttr('checked');
                $('[name="areaofinterest"]').prop("checked", false);
            }
        });

        $('[name="tssMonthsdatearr"]').each(function (i, e) {
            if ($(e).is(':checked')) {
                $('[name="tssMonthsdatearr"]').removeAttr('checked');
                $('[name="tssMonthsdatearr"]').prop("checked", false);
            }
        });

        $('[name="tssMothdaynoarr"]').each(function (i, e) {
            if ($(e).is(':checked')) {
                $('[name="tssMothdaynoarr"]').removeAttr('checked');
                $('[name="tssMothdaynoarr"]').prop("checked", false);
            }
        });

        $('[name="tssmonthdayarr"]').each(function (i, e) {
            if ($(e).is(':checked')) {
                $('[name="tssmonthdayarr"]').removeAttr('checked');
                $('[name="tssmonthdayarr"]').prop("checked", false);
            }
        });

    }

