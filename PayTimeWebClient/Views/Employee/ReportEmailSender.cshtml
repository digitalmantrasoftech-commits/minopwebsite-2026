            headers: { 'Authorization': '@_tokan' },
            async: false,
            url: '@_webapiurl' + '/Employee/GetActiveInactiveSchedularFasttrack',
            contentType: "application/json; charset=utf-8",
            dataType: 'json',
            success: function (data) {
                if (data[0].cnt >= 5) {
                    toastr.remove();
                    toastr.error("Maximum 5 schedular allow.");
                    return false;
