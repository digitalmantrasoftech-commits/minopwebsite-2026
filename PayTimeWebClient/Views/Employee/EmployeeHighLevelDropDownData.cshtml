    function loadFilteredEmployees(searchTerm, currentPage, pageSize, _CompanyID, _branchID, _DeptID)
    {
    $.ajax({
        url: '/DataGridOptimize/GetEmployeeDropdownOptions',
        data:
        {
            searchTerm: searchTerm, pageSize: pageSize, page: 1,
            CompanyID: _CompanyID, BranchID: _branchID, RoleID: 1, sortColumn: '',
            DepartID: _DeptID
        },
        dataType: 'json',
        beforeSend: function () {
            $("#ajax_loader").show();
        },
        success: function (data)
        {            
            $("#ajax_loader").hide();
            if (data.Result && data.Result.EmployeeDropDownData.length > 0)
            {
                appendEmployeesToDropdown(data.Result.EmployeeDropDownData);
                $Employeeselect.multiselect('rebuild');
                $('input.multiselect-search').val(searchTerm); // Retain search term
            }
            else
            {
                $('#EmployeDropDownID').append(new Option('No results found', '', false, false)).multiselect('rebuild');
                $('input.multiselect-search').val(searchTerm); // Keep the search term in the input
                $('input.multiselect-search').focus();
                allDataLoaded = true;
            }
            isFetching = false;
        },
        error: function (xhr, status, error) {
            console.error("Error loading filtered employee data:", error);
            isFetching = false;
        }
    });
    }

    // Append employees to dropdown
    function appendEmployeesToDropdown(employees)
    {
        employees.forEach(function (employee)
        {
            var option = new Option(employee.Name, employee.Id, selectedItems.has(employee.Id), selectedItems.has(employee.Id));
            $('#EmployeDropDownID').append(option);
        });
        $('#EmployeDropDownID').trigger('change');
    }

    
