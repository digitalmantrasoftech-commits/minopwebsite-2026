                    $('input.multiselect-search').val(searchTerm); // Keep the search term in the input
                    $('input.multiselect-search').focus();
                    allDataLoaded = true;
                }
                isFetching = false;
            },
            error: function (xhr, status, error) {
                console.error("Error loading filtered employee data:", error);
                isFetching = false;
            }
        });
