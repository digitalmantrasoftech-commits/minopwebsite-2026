    // Functions for Reset, Filter, and Lazy Load
    function resetDropdown(dropdownId, selectedBranchID, selectedDepartmentID)
    {
        currentPage = 1;
        allDataLoaded = false;
        isFiltered = false;
        const _compyID = $('#ddlCompanyID').val();        

        if (dropdownId === "ddlBranchID")
        {
            $('#ddlBranchID').empty();
            loadInitialBranch('', currentPage, pageSize, _compyID, RoleId);
        }
        else if (dropdownId === "ddlDepartID")
        {
            $('#ddlDepartID').empty();
            loadInitialDepartment('', currentPage, pageSize, _compyID, selectedBranchID);
        }
        else if (dropdownId === "EmployeDropDownID")
        {
            $('#EmployeDropDownID').empty();
            loadInitialEmployees('', currentPage, pageSize, _compyID, RoleId, selectedBranchID, selectedDepartmentID);
        }
    }

    function filterDropdownParameterwise(dropdownId, searchTerm, CompanyID, _branchID, _DeptID)
    {
        currentPage = 1;
        isFiltered = true;

        if (dropdownId === "ddlBranchID") {
            //$('#ddlBranchID').empty();
            loadFilteredBranches(searchTerm, currentPage, pageSize, CompanyID);
        }
        else if (dropdownId === "ddlDepartID") {
            loadFilteredDepartment(searchTerm, currentPage, pageSize, CompanyID, _branchID);
        }
        else if (dropdownId === "EmployeDropDownID") {
            $('#EmployeDropDownID').empty();
            loadFilteredEmployees(searchTerm, currentPage, pageSize, CompanyID, _branchID, _DeptID);
        }
    }



    function filterDropdown(dropdownId, searchTerm, CompanyID, _branchID, _DeptID)
    {
          currentPage = 1;
          isFiltered = true;

        if (dropdownId === "ddlBranchID")
        {
            //$('#ddlBranchID').empty();
            loadSearChableBranchList(searchTerm, currentPage, pageSize, CompanyID);
        }
        else if (dropdownId === "ddlDepartID")
        {            
            loadSearChableDepartmentList(searchTerm, currentPage, pageSize, CompanyID, _branchID);
        }
        else if (dropdownId === "EmployeDropDownID")
        {
            $('#EmployeDropDownID').empty();
            loadSearChableEmployeesList(searchTerm, currentPage, pageSize, CompanyID, _branchID, _DeptID);
        }
    }

    function loadMoreData(dropdownId, searchTerm, currentPage,CompanyID,BranchID,DeptID)
    {
        isFetching = true;

        if (dropdownId === "ddlBranchID")
        {
            loadMoreBranchData(searchTerm, currentPage, pageSize, CompanyID, () =>
            {
                isFetching = false;
            });
        }
        else if (dropdownId === "ddlDepartID")
        {
            $('#ddlDepartID').empty();
            loadMoreDepartment(searchTerm, currentPage, pageSize, CompanyID, BranchID, () => {
                isFetching = false;
            });
        }
        else if (dropdownId === "EmployeDropDownID")
        {
            loadMoreEmployees(searchTerm, currentPage, pageSize, CompanyID, BranchID, DeptID, () => {
                isFetching = false;
            });
        }
    }

    // Update selected items
    function updateSelectedItems()
    {
        $('#EmployeDropDownID option').each(function () {
            if (this.selected) {
                selectedItems.add(this.value);
            } else {
                selectedItems.delete(this.value);
            }
        });
    }

    // Load initial employees    

    function loadInitialEmployees(searchTerm, page, pageSize, _compID, roleID,_branchID,_deptID)
    {
        if (cache['initial'])
        {
            appendEmployeesToDropdown(cache['initial']);
            $Employeeselect.multiselect('rebuild');
        } else
        {
            $.ajax({
                url: '/DataGridOptimize/GetEmployeeDropdownOptions',
                data: {
                    searchTerm: '',
                    pageSize: pageSize,
                    page: page,
                    CompanyID: _compID, RoleID: roleID,
                    BranchID: _branchID,
                    DepartID: _deptID
                },
                dataType: 'json',
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (data)
                {
                    $("#ajax_loader").hide();
                    if (data.Result && data.Result.EmployeeDropDownData)
                    {
                        cache['initial'] = data.Result.EmployeeDropDownData;
                        appendEmployeesToDropdown(data.Result.EmployeeDropDownData);
                        $Employeeselect.multiselect('rebuild');
                    }
                },
                error: function (xhr, status, error)
                {
                    console.error("Error loading initial employee data:", error);
                }
            });
        }
    }

    // Load more employees (infinite scroll)
    function loadMoreEmployees(searchTerm, page, pageSize, CompID, _branchID,_DeptID) {
        $.ajax({
            url: '/DataGridOptimize/GetEmployeeDropdownOptions',
            data: { searchTerm: '', pageSize: pageSize, page: page, CompanyID: CompID, RoleID: 1, BranchID: _branchID, DepartID: _DeptID },
            dataType: 'json',
            success: function (data) {
                if (data.Result && data.Result.EmployeeDropDownData.length > 0) {
                    appendEmployeesToDropdown(data.Result.EmployeeDropDownData);
                    $Employeeselect.multiselect('rebuild');
                    if (selectAllClicked) {
                        data.Result.EmployeeDropDownData.forEach(function (employee) {
                            selectedItems.add(employee.Id);
                        });
                        $Employeeselect.multiselect('select', Array.from(selectedItems));
                    }
                } else {
                    allDataLoaded = true;
                }
                isFetching = false;
            },
            error: function (xhr, status, error) {
                console.error("Error loading more employee data:", error);
                isFetching = false;
            }
        });
    }

