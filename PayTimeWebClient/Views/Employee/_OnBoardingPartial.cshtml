        //***********************************Empjoindate validation**********************************//
        $("#EmpJoiningDate").change(function () {
            if ($("#EmpDOB").val() != null && $("#EmpDOB").val().length > 0) {
                var empDOBStr = $('#EmpDOB').val();
                var joinDateStr = $('#EmpJoiningDate').val();
                let _isdateformat = '@_isdateformat' == "yyyy-M-dd" ? "YYYY-MMM-DD" :
                            '@_isdateformat' == "M-dd-yyyy" ? "MMM-DD-YYYY" :
                            '@_isdateformat' == "dd-M-yyyy" ? "DD-MMM-YYYY" :
                            '@_isdateformat';

                // Parse DOB using moment
                var empdob = moment(empDOBStr, _isdateformat.toUpperCase(), true);
                var joiningdate = moment(joinDateStr, _isdateformat.toUpperCase(), true);

                if (empdob.isValid() && joiningdate.isValid()) {
                    var ageAtJoining = joiningdate.year() - empdob.year();
                    var m = joiningdate.month() - empdob.month();
                    if (m < 0 || (m === 0 && joiningdate.date() < empdob.date())) {
                        ageAtJoining--;
                    }

                    if (ageAtJoining < 18) {
                        event.preventDefault();
                        toastr.remove();
                        toastr.error("The minimum difference between joining date and date of birth should be 18 years.");
                        $("#EmpJoiningDate").addClass('field_error');
                        $("#EmpDOB").addClass('field_error');
                        return;
                    } else {
                        $("#EmpJoiningDate").removeClass('field_error');
                        $("#EmpDOB").removeClass('field_error');
                    }
                }
            }
            $("#EmpJoiningDate").removeClass('field_error');
            $("#EmpResignDate").val("");
            var i = "";
            var k = "";
            if ("@_isdateformat" == "dd-mm-yyyy") {
                var fromDate = $("#EmpJoiningDate").val().split("-");
                var newdate = new Date(fromDate[2], fromDate[1] - 1, fromDate[0]);
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                var fromDate = moment($('#EmpJoiningDate').val(), 'MM-DD-YYYY');
                var newdate = new Date(fromDate);
            }
            else if ("@_isdateformat" == "yyyy-M-dd") {
                var fromDate = moment($('#EmpJoiningDate').val(), 'YYYY-MMM-DD');
                var newdate = new Date(fromDate);
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {
                var fromDate = moment($('#EmpJoiningDate').val(), 'MMM-DD-YYYY');
                var newdate = new Date(fromDate);
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {
                var fromDate = moment($('#EmpJoiningDate').val(), 'DD-MMM-YYYY');
                var newdate = new Date(fromDate);
            }
            else {
                var fromDate = $("#EmpJoiningDate").val();
                var newdate = new Date(fromDate);
            }
            if (newdate.getMonth() <= 8) {
                i = "0" + (newdate.getMonth() + 1);
            }
            else {
                i = (newdate.getMonth() + 1);
            }
            if (newdate.getDate() < 10) {
                k = "0" + (newdate.getDate());
            }
            else {
                k = (newdate.getDate());
            }
            if ("@_isdateformat" == "yyyy-mm-dd") {
                isDateFormat = newdate.getFullYear() + "-" + i + "-" + k;
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                isDateFormat = i + "-" + k + "-" + newdate.getFullYear();
            }
            else if ("@_isdateformat" == "dd-mm-yyyy") {
                isDateFormat = k + "-" + i + "-" + newdate.getFullYear();
            }
            else if ("@_isdateformat" == "yyyy-M-dd") {
                isDateFormat = newdate.getFullYear() + "-" + i + "-" + k;
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {
                isDateFormat = i + "-" + k + "-" + newdate.getFullYear();
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {
                isDateFormat = k + "-" + i + "-" + newdate.getFullYear();
            }
            $('#EmpResignDate').datepicker("remove");
            $("#EmpResignDate").datepicker({
                startDate: newdate,
                autoclose: true,
                format: "@_isdateformat"
            }).on('changeDate', function (ev) {
                $("#EmpResignDate").removeClass('field_error');
            }).data('datepicker');
            $("#EmpResignDate").val("");
        });




