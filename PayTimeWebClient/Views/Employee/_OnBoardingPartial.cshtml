    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
    function populateEducationDetails(empEduArray) {
        addEducationDivModal(counterDiv);
        if (empEduArray && empEduArray.length > 0) {
            empEduArray.forEach(function (eduDetail, index) {
                // Check if we need to create a new detail container or use an existing one
                if (index >= $(".education_details_conatiner_list").length) {
                    addEducationDiv(); // This adds a new blank detail section
                }
                var fromYearParts = eduDetail.FromYear.split("T")[0].split("-");
                var year = fromYearParts[0];
                var month = fromYearParts[1];

                var ToYearParts = eduDetail.ToYear.split("T")[0].split("-");
                var Toyear = ToYearParts[0];
                var Tomonth = ToYearParts[1];
                // Now set the values for this detail section
                var detailSection = $(".education_details_conatiner_list").eq(index);
                detailSection.find('[id^="EmpEduID_"]').val(eduDetail.EduID);
                detailSection.find('[id^="EmpUniversityName_"]').val(eduDetail.UniversityName);
                detailSection.find('[id^="EmpFromYear_"]').val(year + "-" + month);
                detailSection.find('[id^="EmpToYear_"]').val(Toyear + "-" + Tomonth);
                detailSection.find('[id ^= "EmpPercentage_"]').val(eduDetail.Percentage);
                detailSection.find('[id ^= "EmpSpecialization_"]').val(eduDetail.Specialization);
            });
        }
    }

    function populateFamilyDetails(empfamArray) {
        addFamilyDivModal(counterDiv);
        if (empfamArray && empfamArray.length > 0) {
            empfamArray.forEach(function (famDetail, index) {
                // Check if we need to create a new detail container or use an existing one
                if (index >= $(".family_list_container_list").length) {
                    addFamilyDetails(); // This adds a new blank detail section
                }
                // Now set the values for this detail section
                var detailSection = $(".family_list_container_list").eq(index);
                detailSection.find('[id^="EmpFID_"]').val(famDetail.FID);
                detailSection.find('[id^="EmpFName_"]').val(famDetail.Fname);
                detailSection.find('[id^="EmpFRelation_"]').val(famDetail.Relation);
                detailSection.find('[id^="EmpFOccupation_"]').val(famDetail.Occupation);
                detailSection.find('[id^="EmpFAge_"]').val(famDetail.Age);
            });
        }
    }

