            var recdur = $("#RecessDur").val();

            var ans = Math.abs(new Date("2017-09-17 " + shiftdur) - new Date("2017-09-17 " + recdur));
            var seconds = Math.floor(ans / 1000); //ignore any left over units smaller than a second
            var minutes = Math.floor(seconds / 60);
            seconds = seconds % 60;
            var hours = Math.floor(minutes / 60);
            minutes = minutes % 60;
            if (minutes < 9) {
                minutes = "0" + minutes;
            }
            $("#MinHrsFullDay").val(hours + ":" + minutes);
