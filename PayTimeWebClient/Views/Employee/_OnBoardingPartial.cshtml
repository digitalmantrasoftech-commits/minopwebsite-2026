        CalculateHours();
        function CalculateHours() {
            a = $("#StartTime").val();
            b = $("#EndTime").val();
            if (a.length < 5) {
                a = "0" + a;
            }
            if (b.length < 5) {
                b = "0" + b;
            }
            var s = new Date("2017-09-16 " + a);
            var e = new Date("2017-09-17 " + b);

            if (a > b) // for night shift
            {

                var diff = Math.abs(new Date("2017-09-17 " + b) - new Date("2017-09-16 " + a));
                var seconds = Math.floor(diff / 1000); //ignore any left over units smaller than a second
                var minutes = Math.floor(seconds / 60);
                seconds = seconds % 60;
                var hours = Math.floor(minutes / 60);
                minutes = minutes % 60;
                if (minutes < 9) {
                    minutes = "0" + minutes;
                }
                if (hours < 9) {
                    hours = "0" + hours;
                }
                $("#ShiftDur").val(hours + ":" + minutes);
            }
            else if (b > a) //for day shift
            {
                var diff = Math.abs(new Date("01/01/2007 " + b) - new Date("01/01/2007 " + a));
                var seconds = Math.floor(diff / 1000); //ignore any left over units smaller than a second
                var minutes = Math.floor(seconds / 60);
                seconds = seconds % 60;
                var hours = Math.floor(minutes / 60);
                minutes = minutes % 60;
                if (minutes < 9) {
                    minutes = "0" + minutes;
                }
                if (hours < 9) {
                    hours = "0" + hours;
                }
                $("#ShiftDur").val(hours + ":" + minutes);

            }
            else {
                $("#ShiftDur").val("00:00");
            }
        };
