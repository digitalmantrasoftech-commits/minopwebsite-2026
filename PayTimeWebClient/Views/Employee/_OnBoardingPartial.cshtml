        $("#EmpPassbookPhoto").change(function () {
            $("#EmpPassbookPhoto").removeClass('field_error');
            var passbook = this.files; // Get the selected files
            var maxSize = 5 * 1024 * 1024; // 2 MB in bytes
            var validExts = [".bmp", ".png", ".jpg", ".jpeg"];
            if (passbook.length > 0) {
                var file = passbook[0];
                if (file.size > maxSize) {
                    toastr.remove();
                    toastr.error("File size exceeds 5 MB.");
                    $('#EmpPassbookPhoto').val(''); // Reset the file input to clear the selected files
                    return false; // Stop further execution
                }
                // File extension validation
                var fileExt = file.name.substring(file.name.lastIndexOf('.')).toLowerCase(); // Get the file extension in lowercase
                if (!validExts.includes(fileExt)) {
                    toastr.remove();
                    toastr.error("Invalid file selected, valid files are of " + validExts.join(", ") + " types.");
                    $('#EmpPassbookPhoto').val(''); // Reset the file input to clear the selected files
                    return false; // Stop further execution
                }
                //disable the file input
                $('#EmpPassbookPhoto').prop('disabled', true);

                var formData = new FormData();
                formData.append("EmpPassbookPhoto", file);

                // File is valid, submit the file
                $.ajax({
                    url: '/Employee/UploadEmployeeFilesPassBook?EmpCode=' + $("#EmpCode").val(),
                    type: 'POST',
                    data: formData,
                    processData: false, // Tell jQuery not to process the data
                    contentType: false, // Tell jQuery not to set contentType
                    success: function (data) {
                        //enable the file input
                        $('#EmpPassbookPhoto').prop('disabled', false);
                    },
                    error: function (xhr, status, error) {
                        // Enable the file input after upload failure
                        $('#EmpPassbookPhoto').prop('disabled', false);


                    }
                });

            }

        });
