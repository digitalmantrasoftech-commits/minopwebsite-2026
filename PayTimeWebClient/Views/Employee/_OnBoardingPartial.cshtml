        $(".family_list_container_list").each(function (index) {
            var $this = $(this); // Cache the jQuery object to avoid repeated wrapping
            // Define all the fields within the current container using attribute selectors
            var empFName = $this.find('[id^="EmpFName_"]');
            var empFRelation = $this.find('[id^="EmpFRelation_"]');
            var empFOccupation = $this.find('[id^="EmpFOccupation_"]');
            var empFAge = $this.find('[id^="EmpFAge_"]');

            // Check if Name is empty or undefined
            if (empFName.val() === '' || typeof empFName.val() === 'undefined') {
                empFName.addClass('field_error');
                event.preventDefault();
                isValid = false;
            } else {
                empFName.removeClass('field_error');
            }

            // Validate Relation
            if (empFRelation.val() === '0' || typeof empFRelation.val() === 'undefined') {
                empFRelation.addClass('field_error');
                event.preventDefault();
                isValid = false;
            } else {
                empFRelation.removeClass('field_error');
            }

            // Validate Occupation
            if (empFOccupation.val() === '' || typeof empFOccupation.val() === 'undefined') {
                empFOccupation.addClass('field_error');
                event.preventDefault();
                isValid = false;
            } else {
                empFOccupation.removeClass('field_error');
            }

            // Validate Age
            if (empFAge.val() === '' || typeof empFAge.val() === 'undefined') {
                empFAge.addClass('field_error');
                event.preventDefault();
                isValid = false;
            } else {
                empFAge.removeClass('field_error');
            }
        });
        var empdob = new Date($("#EmpDOB").val());
        var joiningdate = new Date($("#EmpJoiningDate").val());
        if (!isNaN(empdob) && !isNaN(joiningdate)) {
            var diffgap = joiningdate.getFullYear() - empdob.getFullYear();
            var monthDiff = joiningdate.getMonth() - empdob.getMonth();
            var dayDiff = joiningdate.getDate() - empdob.getDate();
            if (monthDiff < 0 || (monthDiff === 0 && dayDiff < 0)) {
                diffgap--;
            }
            if (diffgap < 18) {
                event.preventDefault();
                toastr.remove();
                toastr.error("The minimum  difference between joining date and date of birth should be 18 years.");
                $("#EmpDOB").addClass('field_error');
                isValid = false;
            }
        }

        if (!isValid) {
            return false;
        }
        return true;
    }
    function fourthNextValidation() {
        var isValid = true;
        if ($("#EmpStructureID").val() === "0") {
