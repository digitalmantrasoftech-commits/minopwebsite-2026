    function tableGet(obj) {
        // Destroy existing DataTable instances and clear table bodies
        $('#tblonboardingdetails').DataTable().destroy();
        $("#tblonboardingdetails tbody").empty();
        $("#tblonboardingdetails thead tr:eq(1)").remove();
        // Fetch data for the first table
        var _urlcmp = '/Employee/OnBordingGetCompressData';

        $.ajax({
            type: "POST",
            @*headers: { 'Authorization': '@_tokan' },*@
            //url: '@_webapiurl' + 'Employee/OnBordingDataGetAll',
            url: _urlcmp,
            data: JSON.stringify(obj),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (data) {
                var compressedData = atob(data);
