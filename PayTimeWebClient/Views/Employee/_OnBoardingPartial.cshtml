            $('[id^="EmpToYear_"]').datepicker('setEndDate', threeYearsAhead);
        });

        $('[id^="EmpToYear_"]').datepicker({
            autoclose: true,
            format: "yyyy-mm",
            viewMode: "years",
            minViewMode: "months",
            startDate: sixtySixYearsAgo + "-01",
            endDate: currentYear + "-" + (currentMonth < 10 ? '0' + currentMonth : currentMonth)
        });

        // Add change event handlers for validation
        $('[id^="EmpFromYear_"]').change(function () {
            $(this).removeClass('field_error');
        });

        $('[id^="EmpToYear_"]').change(function () {
            $(this).removeClass('field_error');
        });
    }
