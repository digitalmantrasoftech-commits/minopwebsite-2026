        $("#EmpDOB").change(function () {
            $("#EmpDOB").removeClass('field_error');
            $("#EmpAgeOnDate").removeClass('field_error');
            var empDOBStr = $('#EmpDOB').val();
            var joinDateStr = $('#EmpJoiningDate').val();
            // Check if a date is selected
            if (empDOBStr) {
                // Parse the date of birth string into a Date object
               let _isdateformat = '@_isdateformat' == "yyyy-M-dd" ? "YYYY-MMM-DD" :
                            '@_isdateformat' == "M-dd-yyyy" ? "MMM-DD-YYYY" :
                            '@_isdateformat' == "dd-M-yyyy" ? "DD-MMM-YYYY" :
                            '@_isdateformat';

                // Parse DOB using moment
                var empdob = moment(empDOBStr, _isdateformat.toUpperCase(), true);

                if (empdob.isValid()) {
                    var age = moment().diff(empdob, 'years');
                    $("#EmpAgeOnDate").val(age).attr("disabled", true);
                }

                if (joinDateStr) {

                    var joiningdate = moment(joinDateStr, _isdateformat.toUpperCase(), true);

                    if (empdob.isValid() && joiningdate.isValid()) {
                        var ageAtJoining = joiningdate.year() - empdob.year();
                        var m = joiningdate.month() - empdob.month();
                        if (m < 0 || (m === 0 && joiningdate.date() < empdob.date())) {
                            ageAtJoining--;
                        }

                        if (ageAtJoining < 18) {
                            event.preventDefault();
                            toastr.remove();
                            toastr.error("The minimum difference between joining date and date of birth should be 18 years.");
                            $("#EmpDOB").addClass('field_error');
                            $("#EmpJoiningDate").addClass('field_error');
                        } else {
                            $("#EmpDOB").removeClass('field_error');
                            $("#EmpJoiningDate").removeClass('field_error');
                        }
                    }
                }
            }
