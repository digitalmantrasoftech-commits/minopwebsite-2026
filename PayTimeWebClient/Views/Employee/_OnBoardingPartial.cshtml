        $('#EmpAmount').change(function () {
            //EmployeeAmoutChanges();
            if ($("#EmpAmount").val() != null && $("#EmpAmount").val() != "") {
                var ctc_amount = "";
                GetEncryptedCTC($('#EmpAmount').val(), function (Encrypted_ctc) {
                    ctc_amount = Encrypted_ctc;
                    var empPayStructureId = $("#EmpStructureID").val();
                    if (ctc_amount != "") {
                        $.ajax({
                            type: "GET",
                            headers: { 'Authorization': '@_tokan' },
                            url: '@_webapiurlpayroll' + 'PayStructure/GetPayrollCalculationByPayStructure?paystructureid=' + empPayStructureId + '&ctcamount=' + ctc_amount,
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            beforeSend: function () {
                                $(".loading").show();
                            },
                            success: function (response) {
                                if (response.message == "Success" && response.responseCode == 200) {
                                    BindPaystructure = true;
                                    $("#Payroll_details").show();
                                    $("#Gross_monthly_salary").show();
                                    $("#Take_home_salary_per_month").show();
                                    $("#lbl_home_slaary").show();
                                    $("#lbl_gross_slaary").show();
                                    var structure_name = response.resultData.structure_name;
                                    var earnings = response.resultData.earnings;
                                    var deductions = response.resultData.deductions;
                                    var reimbursements = response.resultData.reimbursements;
                                    var netMonthlySalary = response.resultData.netMonthlySalary;
                                    var grossMonthlySalary = response.resultData.grossMonthlyEarning;
                                    if (earnings.length > 0) {
                                        $("#ActualEarning").empty();
                                        var _ActualEarning = "";
                                        for (var i = 0; i < earnings.length; i++) {
                                            _ActualEarning += '<div class="row pay_earning_bg"><div class="col-xs-9"><div class="d-flex justify-content-between"><span class="pay_earning_title"> ' + earnings[i].head_name + '</span><span class="pay_earning_sub">' + earnings[i].strcalcbasedOn + '</span></div></div><div class="col-xs-3"><div class="pay_earning_amount">' + earnings[i].amount + '</div></div></div>';
                                        }
                                        $("#ActualEarning").append(_ActualEarning);
                                    }
                                    if (deductions.length > 0) {
                                        $("#ActualDeduction").empty();
                                        var _ActualDeduction = "";
                                        for (var i = 0; i < deductions.length; i++) {
                                            _ActualDeduction += '<div class="row pay_earning_bg"><div class="col-xs-9"><div class="d-flex justify-content-between"><span class="pay_earning_title">' + deductions[i].head_name + '</span><span class="pay_earning_sub">' + deductions[i].strcalcbasedOn + '</span></div></div><div class="col-xs-3"><div class="pay_earning_amount">' + deductions[i].amount + '</div></div></div>';
                                        }
                                        $("#ActualDeduction").append(_ActualDeduction);
                                    }
                                    $("#Take_home_salary_per_month").html("₹" + netMonthlySalary + "/-");
                                    if (grossMonthlySalary < 0) {
                                        $("#Gross_monthly_salary").html("<span class='currency-symbol'>₹ 0 /-</span>");
                                    } else {
                                        $("#Gross_monthly_salary").html("₹" + grossMonthlySalary + "/-")

                                    }
                                    $("#ctcAmoutEncrypted").val(ctc_amount);
                                }
                                else if (response.resultData.isError == true) {
                                    BindPaystructure = false;
                                    toastr.remove();
                                    $(".loading").hide();
                                    toastr.error(response.resultData.errorMessage);
                                    return false;
                                }
                                $(".loading").hide();
                            },
                            error: function () {
                                $(".loading").hide();
                            }
                        });
                    }
                });
            }
        });

