    function fillempReporting() {
        $('#DepartmentHead').empty();
        $.ajax({
            type: "GET",
            url: '@_webapiurl' + 'Employee/GetAllFasttrackEmployeeReporting',
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response != null) {
                    $("#DepartmentHead").append("<option value='0' selected>Select Department Head</option>");
                    response.sort(function (a, b) {
                        return a.NameOfApplicant.localeCompare(b.NameOfApplicant); // Sort policy names in ascending order
                    });
                    for (var i = 0; i < response.length; i++) {
                        $("#DepartmentHead").append("<option value='" + response[i].OnBordingID + "'>" + response[i].NameOfApplicant + "(" + response[i].EmployeeCode + ")" + "</option>");
                    }
                }
                $(".loading").hide();
            },
            error: function () {
                $(".loading").hide();
            }
        });
    }

