        if ($("#EmpAmount").val() == "") {
            $("#EmpAmount").addClass('field_error');
            event.preventDefault();
            isValid = false;
        }
        else {
            $("#EmpAmount").removeClass('field_error');
        }
        if (BindPaystructure == false) {
            isValid = false;
        }
        if (!isValid) {
            return false;
        }
        return true;
    }
