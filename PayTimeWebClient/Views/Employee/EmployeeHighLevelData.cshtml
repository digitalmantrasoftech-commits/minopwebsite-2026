                                },
                                order: d.order,
                                columns: d.columns,
                                length: d.length,
                                start: d.start,
                                CustFilter: searchCriteria.length > 0 ? searchCriteria : null // Make sure this references the correct variable
                            };
                            return JSON.stringify(requestData);
                        },
                        dataSrc: function (json)
                        {
                            // Log the response structure for debugging
                            if (json.data) {
                                return json.data.Items; // Return the data array if it exists
                            }
                            return []; // Return an empty array if the expected data is not present
                        }
                        //data: function (d)
                        //{
                        //    return JSON.stringify
                        //    (
                        //        {
                        //        draw: d.draw, // Include draw for DataTable to validate response
                        //        search:
                        //        {
                        //            value: d.search.value || '' // Include the search term
                        //        },
                        //        order: d.order, // Keep the order for sorting
                        //        columns: d.columns, // Include columns information
                        //        length: d.length, // Page size
                        //        start: d.start // Start index
                        //    });
                        //},
                        //dataSrc: function (json)
                        //{
                        //    return json.data.Items; // Return the actual data for the table
                        //}
                    };
                }
                else
                {
                    commonConfig.serverSide = false; // Disable server-side processing
                    commonConfig.ajax = null; // Use the initial data provided
                    commonConfig.data = data; // Set data directly for client-side processing
                    commonConfig.deferRender = true; // For performance with large data
                }
                t = $('#tblEmployee').DataTable(commonConfig); // Initialize the DataTable
                $('#tblEmployee_filter').on('click', '[id^="openFilterPopup"]', function ()
                {
                    $('#filterPopup').toggle();
                    // Inject custom search HTML if it's the first time opening the popup
                    if (!$('#popupCustomSearchFields').html().trim()) {
                        var customSearchHTML = `
                                <div class="custom-search-wrapper" id="customSearchFields">
                                    <div class="custom-search-field" id="searchFieldWrapper1">
                                        <select id="searchField1" class="form-control">
                                            <option value="Select">Select</option>
                                            <option value="Name">Name</option>
                                            <option value="Code">Code</option>
                                            <option value="PunchId">Punch ID</option>
                                        </select>
                                        <input type="text" id="searchValue1" class="form-control search_box" placeholder="Search" maxlength="10">
                                    </div>
                                    <button id="addSearchField" class="btn btn-success"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                                    </div>
                                    <div id="_moveDiv" class="moveDiv">
                                        <button type="submit" id="refreshBtn1" class="btn mt-clipboard btn-sm clear_btn">Clear</button>
                                        <button type="submit" id="searchBtn1" class="btn mt-clipboard btn-sm blue">Apply</button>
                                    </div>`;
                        $('#popupCustomSearchFields').html(customSearchHTML);
                    }
                });

                // Attach click event for "addSearchField" button
                $('#tblEmployee_filter').on('click', '#addSearchField', function ()
                {
                    if (fieldCount < 3)
                    { // Limit to a maximum of 3 search fields
                        fieldCount++; // Increment the field count
                        let newSearchFieldHTML = `
                            <div class="custom-search-wrapper" id="customSearchFields${fieldCount}">
                               <div class="custom-search-field" id="searchFieldWrapper${fieldCount}">
                                <select id="searchField${fieldCount}" class="form-control">
                                    <option value="Select">Select</option>
                                    <option value="Name">Name</option>
                                    <option value="Code">Code</option>
                                    <option value="PunchId">Punch ID</option>
                                </select>
                                <input type="text" id="searchValue${fieldCount}" class="form-control search_box" placeholder="Search" maxlength="10">
                                <button id="removeSearchField${fieldCount}" class="btn btn-danger"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                            </div>
                            </div>`;
                        $('#popupCustomSearchFields').append(newSearchFieldHTML);
                        updateDropdownOptions();
                        moveOkButtonToEnd();
                    }

                });
                // Event delegation to handle dynamically generated remove buttons
                $('#tblEmployee_filter').on('click', '[id^="removeSearchField"]', function ()
                {
                    $(this).closest('.custom-search-wrapper').remove(); // Remove the associated search field wrapper
                    fieldCount--; // Decrement the field count
                    updateDropdownOptions();
                })



                //Apply Button Event For Server Side Seraching Check Filter parameter wise
                $('#tblEmployee_filter').on('click', '#searchBtn1', function ()
                {

                    searchCriteria = [];
                    for (let i = 1; i <= fieldCount; i++)
                    {
                        const field = $(`#searchField${i}`).val();
                        const value = $(`#searchValue${i}`).val();
                        if (field == "Select")
                        {
                            alert("select Atleast One Filter Type.");
                            return;
                        }
                        if (value == "")
                        {
                            alert("Enter the select Filter Type value.");
                            return;
                        }
                        if (field !== "Select" && value)
                        {
                            searchCriteria.push({ field, value });
                        }
                    }
                    t.ajax.reload(null, false);
                });

                //Clear Button Event For Refresh model and DataTable
                $('#tblEmployee_filter').on('click', '#refreshBtn1', function ()
                {
                    $('#filterPopup').toggle(); // Or use .modal('toggle') if it's a modal

                    // Clear all search fields
                    $('#popupCustomSearchFields').find('input[type="text"]').val(''); // Clear all text inputs
                    $('#popupCustomSearchFields').find('select').val('Select'); // Reset all dropdowns to "Select"

                    // Optionally reset any dynamically added search fields
                    $('#popupCustomSearchFields').find('.custom-search-wrapper').slice(1).remove(); // Keep the first, remove others if dynamically added


                    searchCriteria = [];
                    // Reload the DataTable with default data (removes any filters applied)
                    t.ajax.reload(); // Use `false` to prevent page reset
                    fieldCount = 1;
                });

                ///key-press Event

                $('#tblEmployee_filter').on('keypress', '#searchValue1, #searchValue2, #searchValue3', function (e)
                {
                    var keyCode = e.which || e.keyCode;

                    // Allow: backspace, delete, tab, escape, enter
                    if (keyCode === 8 || keyCode === 46 || keyCode === 9 || keyCode === 27 || keyCode === 13)
                    {
                        return;
                    }
                    // Allow: A-Z, a-z, 0-9
                    if ((keyCode >= 48 && keyCode <= 57) || // 0-9
                        (keyCode >= 65 && keyCode <= 90) || // A-Z
                        (keyCode >= 97 && keyCode <= 122)) { // a-z
                        return;
                    }
                    // Prevent other characters
                    e.preventDefault();
                });

                //Move Div Class for Apply and Clear Button Detach of popupmodel
                function moveOkButtonToEnd()
                {
                    var okButton = $('#popupCustomSearchFields').find('#_moveDiv').detach(); // Detach the OK button
                    var refreshButton = $('#popupCustomSearchFields').find('#_moveDiv').detach(); // Detach the Refresh button

                    $('#popupCustomSearchFields').append(okButton); // Append OK button to the end
                    $('#popupCustomSearchFields').append(refreshButton); // Append Refresh button to the end

                }
                // Function to get currently selected values and update the options
                function updateDropdownOptions()
                {
                    selectedFields = [];
                    // Gather selected values from each dropdown
                    $('.custom-search-wrapper select').each(function () {
                        const selectedValue = $(this).val();
                        if (selectedValue !== "Select") {
                            selectedFields.push(selectedValue);
                        }
                    });

                    // Update each dropdown's options to exclude already selected values
                    $('.custom-search-wrapper select').each(function ()
                    {
                        const currentDropdown = $(this);
                        const currentSelection = currentDropdown.val();

                        currentDropdown.html('<option value="Select">Select</option>');

                        // Add back unselected options
                        ['Name', 'Code', 'PunchId'].forEach(optionValue =>
                        {
                            if (!selectedFields.includes(optionValue) || optionValue === currentSelection) {
                                currentDropdown.append(new Option(optionValue, optionValue));
                            }
                        });
                        currentDropdown.val(currentSelection);
                    });
                }
                $('#popupCustomSearchFields').on('change', 'select', function ()
                {
                    updateDropdownOptions(); // Re-apply filtering whenever a selection changes
                });
            }
            else
            {
                $("#ajax_loaderbranch").hide();
                $('#tblEmployee').html("<thead><tr role='row'><th class='ui-state-default sorting' tabindex='0' aria-controls='tblEmployee' rowspan='1' colspan='1' style='width: 87px;' aria-label='EmpName: activate to sort column ascending'> EmpName</th><th class='ui-state-default sorting' tabindex='0' aria-controls='tblEmployee' rowspan='1' colspan='1' style='width: 102px;' aria-label='Empcode: activate to sort column ascending'>Empcode</th><th class='ui-state-default sorting' tabindex='0' aria-controls='tblEmployee' rowspan='1' colspan='1' style='width: 135px;' aria-label='EmpPunchID: activate to sort column ascending'>EmpPunchID</th><th class='ui-state-default sorting' tabindex='0' aria-controls='tblEmployee' rowspan='1' colspan='1' style='width: 135px;' aria-label='BranchName: activate to sort column ascending'>BranchName</th><th class='ui-state-default sorting' tabindex='0' aria-controls='tblEmployee' rowspan='1' colspan='1' style='width: 177px;' aria-label='Email: activate to sort column ascending'>Email</th><th class='ui-state-default sorting' tabindex='0' aria-controls='tblEmployee' rowspan='1' colspan='1' style='width: 76px;' aria-label='Status: activate to sort column ascending'>Status</th><th class='ui-state-default sorting' tabindex='0' aria-controls='tblEmployee' rowspan='1' colspan='1' style='width: 77px;' aria-label='Action: activate to sort column ascending'>Action</th></tr></thead><tbody><tr role='row' class='odd'><td colspan='7'>No data available in table</td></tr></tbody>")
            }
        },
        error: function (jqXHR, textStatus, errorThrown)
        {
            console.error('AJAX Error:', textStatus, errorThrown);
            console.error('Response:', jqXHR.responseText); // Log the response text for debugging
        },
        complete: function () {
            $("#ajax_loader").hide(); // Hide the loader
        }
      });
    }*@

</script>

