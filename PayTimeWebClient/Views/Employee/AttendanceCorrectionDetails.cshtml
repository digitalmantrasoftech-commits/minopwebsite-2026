        function calculateTotalHours()
        {
            let inTime = document.getElementById("InPunchTime").value;
            let outTime = document.getElementById("OutPunchTime").value;

            if (inTime && outTime) {
                // Parse the input time (HH:MM format)
                let [inHours, inMinutes] = inTime.split(":").map(Number);
                let [outHours, outMinutes] = outTime.split(":").map(Number);

                // Create Date objects for both
                let inDate = new Date();
                inDate.setHours(inHours, inMinutes, 0, 0);

                let outDate = new Date();
                outDate.setHours(outHours, outMinutes, 0, 0);

                // Handle overnight shifts (e.g., 20:10 - 08:30)
                if (outDate < inDate) {
                    outDate.setDate(outDate.getDate() + 1);
                }

                // Calculate total difference
                let diffMs = outDate - inDate;
                let totalHours = Math.floor(diffMs / (1000 * 60 * 60));
                let totalMinutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

                // Format as HH:MM
                let totalTime = `${String(totalHours).padStart(2, '0')}:${String(totalMinutes).padStart(2, '0')}`;
                document.getElementById("txthours").innerText = totalTime;
                //$("#TotalHoursReq").val() = totalTime;
            }
    }
        function validateOvertime(input)
    {

            input.value = input.value.replace(/\D/g, '');
            let num = parseInt(input.value, 12);
        if (isNaN(num) || num < 0)
        {
                input.value = '';
            } else if (num > 12) {
                input.value = '12';
            }
        }


