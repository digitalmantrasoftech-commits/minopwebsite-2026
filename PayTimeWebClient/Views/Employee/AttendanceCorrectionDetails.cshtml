            $("#tblAttndancelist").on('click', '.ChangeReq', function ()
            {
                var datetime = new Date();
                var hours = datetime.getHours(); //returns 0-23
                var minutes = datetime.getMinutes(); //returns 0-59
                if (minutes < 10)
                    minutesString = 0 + "" + minutes + ""; //+""casts minutes to a string.
                else
                    minutesString = minutes;

                //var Enpid = jQuery(this).closest('tr').attr('ID');
                var Enpid = tblAttndancelist.row($(this).parent('td').parent('tr')).data()["EmpID"]
                //tblAttndancelist
