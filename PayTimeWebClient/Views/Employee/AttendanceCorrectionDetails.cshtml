            function fillEmplist(BranchId, selectedDept) {

                $("#Select_Employee").empty();
                $.ajax({
                    type: "GET",
                    url: "/MasterData/GetEmpByreporting?hierarchyState=" + '@_hierchywis' + "&EmpId=" + pkloginemployeeid,
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    async: "false",
                    success: function (response) {

                        if (response != null) {
                            response.sort(function (a, b) {
                                return a.EmpName.localeCompare(b.EmpName);
                            });
                            for (var i = 0; i < response.length; i++) {
                                $('#Select_Employee').append('<option value="' + response[i].EmpId + '">' + response[i].EmpName + ' ( ' + response[i].Empcode + ')</option>');
                            }
                            if (emprole > 1 && emprole != 6805 && emprole != 6806) {
                                $("#Select_Employee option[value = '" + pkloginemployeeid + "' ]").prop('selected', true);
                            }
                            $SelectEmployee.multiselect('rebuild');
                        }
                        $(".loading").hide();
                        /*GetAttndancelist();*/
                        GetAttendenceSummary();
                    },
                    beforeSend: function () {
                        $(".loading").show();
                    },
                    error: function () {
                        $(".loading").hide();
                    }
                });
            }
