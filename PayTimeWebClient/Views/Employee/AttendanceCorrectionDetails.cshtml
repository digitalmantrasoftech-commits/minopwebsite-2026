                $("#fromdate").val(currentRow.find("td:eq(0)").text());
                var _InTime = currentRow.find("td:eq(3)").text();
                if (_InTime == "" || _InTime == null || _InTime == "00:00")
                {
                    $("#InPunchTime").val(hours + ":" + minutesString);
                }
                else
                {
                    $("#InPunchTime").val(_InTime.substring(0, _InTime.length - 3));
                }
                var _OutTime = currentRow.find("td:eq(4)").text();
                if (_OutTime == "" || _OutTime == null || _OutTime == '<span style="color: red;">MISS PUNCH</span>' || _OutTime == 'MISS PUNCH' || _OutTime == "00:00")
                {
                    $("#OutPunchTime").val(hours + ":" + minutesString);
                }
                else
                {
                    $("#OutPunchTime").val(_OutTime.substring(0, _OutTime.length - 3));
                }
                $("#EmpID").val(Enpid);
                $("#isNight").val(currentRow.find("td:eq(9)").text());

              /*  $("#ApplyReason").val('');*/

                var _CardNo = tblAttndancelist.row($(this).parent('td').parent('tr')).data()["CardNo"];
                $("#PunchIDReq").val(_CardNo);

                ShiftGetAll(0);
                $(".ChangeReq").attr("data-toggle", "modal");
                $(".ChangeReq").attr("data-target", "#frmpopup");

            });
