                        <table id="tblAttndancelist" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column"
                               role="grid" aria-describedby="tblAttndancelist_info" style="width: 100%;"></table>
                    </div>
                </fieldset>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <hr class="save_hr_line" />
                        <u style="color:maroon;">Status color code</u> : <span style="color: #28a745; "> P = Green </span>,<span style="color: #6f42c1; "> H/PH = Purple </span>,<span style="color: #022344; ">
                            A/AB/XX = Black
                        </span>,<span style="color: #007bff;"> W/PW = Skyblue </span>,<span style="color: #fd7e14;"> LH = Orange </span>,
                        <span style="color: #dc3545;"> Leave = Red </span>,<span style="color: #ffc107;"> HD = Yellow </span>,<span style="color: red;"> E = Red </span>,
                        <span style="color: Black;"> Others = Black </span>,<span style="color: Black;">
                            <a class="tooltips" data-placement="top" title="Display data till the current date.">
                                <i class="fa-regular fa-circle-info"></i>
                            </a>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Attendance List model : End-->
<!-- Attendance Correction model : Begin-->
<div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog w-500">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close closecorrection" id="closedcorr" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Attendance Correction</h4>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger popMsg" hidden>
                    <a href="#" class="close" data-dismiss="alert">&times;</a>
                    <strong id="strstg">Error ! </strong> @_error
                </div>
                <div class="modal-card">
                    <div class="row setup-content" id="step-1">
                        <fieldset>
                            <input type="hidden" id="EmpId" value="@Convert.ToInt32(Session["EmpId"])">
                            <input type="hidden" id="PunchIDReq" value="0">
                            <div class="col-md-12">
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label>Shift <span class="required" id="spanshift" aria-required="true">*</span></label>
                                            <select class="form-control input-sm select2" id="ShiftId" name="ShiftId">
                                            </select>
                                            <span class="help-block error_help_block" hidden id="spShiftId"></span>
                                        </div>
                                    </div>
                                    <div class="col-lg-12" style="display:none;">
                                        <div class="form-group data_picker_box">
                                            <label>Select Date<span class="required" aria-required="true"> * </span></label>
                                            <div class="input-group input-group-sm  date date-picker1" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                                                <span class="input-group-btn">
                                                    <button class="btn default" type="button">
                                                        <i class="fa-light fa-calendar-days"></i>
                                                    </button>
                                                </span>
                                                <input type="text" class="form-control" id="fromdate" name="fromdate" placeholder="@_isdateformat" readonly="readonly">
                                                <input type="hidden" id="EmpID" name="EmpID" />
                                                <input type="hidden" id="isNight" name="isNight" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label>IN Time <span class="required" aria-required="true"> *(24 Hr) </span></label>
                                            <a class="tooltips" data-placement="bottom" title="Set in time in 24hr format">
                                                <i class="fa-regular fa-circle-info"></i>
                                            </a>
                                            <div class="input-group input-group-sm" id="OutDiv">
                                                <input type="text" class="form-control timepicker timepicker-24" data-minute-step="1" id="InPunchTime" name="InPunchTime" placeholder="00:00"
                                                       onchange="calculateTotalHours()">
                                                <span class="input-group-btn">
                                                    <button class="btn default" type="button" id="btnouttime">
                                                        <i class="fa-regular fa-clock"></i>
                                                    </button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label>OUT Time <span class="required" aria-required="true"> *(24 Hr)</span></label>
                                            <a class="tooltips" data-placement="bottom" title="Set out time in 24hr format">
                                                <i class="fa-regular fa-circle-info"></i>
                                            </a>
                                            <div class="input-group input-group-sm" id="OutDiv">
                                                <input type="text" class="form-control timepicker timepicker-24" data-minute-step="1" id="OutPunchTime" name="OutPunchTime" placeholder="00:00"
                                                       onchange="calculateTotalHours()">
                                                <span class="input-group-btn">
                                                    <button class="btn default" type="button" id="btnouttime">
                                                        <i class="fa-regular fa-clock"></i>
                                                    </button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label class="control-label">Total Hours</label>
                                            <div>
                                                <div style="pointer-events: none; opacity: 1.2; font-weight: bold;">
                                                    <label class="control-label" id="txthours">00:00</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label class="control-label">Status<span class="required" aria-required="true">*</span></label>
                                            <select class="form-control input-sm select2" id="StatusMode" name="StatusMode">
                                                <option value="1">P</option>
                                                <option value="2">HD</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label class="control-label">Overtime Hours</label>
                                            <input type="number" oninput="validateOvertime(this)" id="txtOverTimehours" placeholder="Please Enter" class="form-control" name=""
                                                   maxlength="2">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-lg-12 form-actions text-right">
                        <button type="button" id="btnSave" class="btn btn-sm blue"><i class="fa-light fa-floppy-disk"></i> Save</button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- Attendance Correction model : End-->
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>
