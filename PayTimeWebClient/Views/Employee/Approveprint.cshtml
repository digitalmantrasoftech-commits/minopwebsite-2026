<script type="text/javascript">
    var delay = 1000;
    var _Reason = "";
    $(document).ready(function () {
        $(document).on('click', '#Reject_Btn', function () {
            checkSession();
            var onboardingID = $("input[name='OnboardingID']").val();
            Swal.fire({
                html: '<div class="swal_title">Are you sure? Do want to reject onboarding Employee.</div><div class="margin-top-10 text-left"><div class="form-group margin-bottom-0"><label>Reason<span class="required" aria-required="true">*</span></label><textarea class="form-control" name="" id="txt_reason" placeholder="Enter Reason" maxlength="250"></textarea></div></div>',
                title: "<img class='margin-right-5' src='/assets/images/icons/swal_icon/icon_error.svg' alt=''>Reject",
                closeOnConfirm: false, // Keep the modal open even when confirming
                showCloseButton: true,
                showCancelButton: true,
                focusConfirm: false,
                cancelButtonText: 'No',
                confirmButtonText: 'Yes',
                allowOutsideClick: false,
                allowEscapeKey: false,
                preConfirm: function () {
                    return new Promise(function (resolve) {
                        _Reason = $('#txt_reason').val();
                        if (_Reason === "") {
                            $('#txt_reason').addClass('field_error');
                            toastr.remove();
                            toastr.error("Please enter Reason.");
                            resolve(false);
                            return false;
                        } else {
                            $('#txt_reason').removeClass('field_error');
                            resolve(true);
                        }
                    });
                },
                customClass: {
                    confirmButton: 'swal-confirm-button-class',
                    cancelButton: 'swal-cancel-button-class'
                }
            }).then(function (result) {
                if (result.isConfirmed) {
                    var txt_reason = $("#txt_reason").val();
                    if (txt_reason.trim() == "") {
                        $("#txt_reason").addClass('field_error');
                        return false;
                    } else {
                        $.ajax({
                            type: "POST",
                            url: '@_webapiurl' + 'Employee/OnBordingEmployeeIsReject?OnBordingId=' + onboardingID + "&RejectReason=" + txt_reason,
                            headers: { 'Authorization': '@_tokan' },
                            contentType: "application/json; charset=utf-8",
                            datatype: "json",
                            async: "false",
                            beforeSend: function () {
                                $(".loading").show();
                            },
                            success: function (response) {
                                if (response.isRedirect) {
                                    window.location.href = response.redirectUrl;
                                }
                                if (response != null) {
                                    if (response.MegSts == 'ok') {
                                        toastr.remove();
                                        toastr.success(response.Meg);
                                        setTimeout(function () {
                                            window.location.href = '/Employee/Onboarding';
                                        }, delay);
                                    }
                                    else {
                                        toastr.remove();
                                        toastr.error(response.Meg);
                                        setTimeout(function () {
                                            window.location.href = '/Employee/Onboarding';
                                        }, delay);
                                    }
                                }
                            },
                            error: function () {
                                $(".loading").hide();
                            },
                            complete: function () {
                                $(".loading").hide();
                            }
                        });
                    }
                }
            });
            $('img[src="/assets/images/icons/swal_icon/icon_error.svg"]').parent().parent().parent().addClass('swal_error');
        });

        $(document).on('click', '#btn_approve', function () {
            checkSession();
            var obj = {
                OnBordingID: $("input[name='OnboardingID']").val(),
                EmailId: $("th.emailid").text().trim(), // Using jQuery's .text() method
                EmpPunchID: $("th.punchid").text().trim() // Using jQuery's .text() method
            };
            $.ajax({
                type: "POST",
                url: '@_webapiurl' + "Employee/OnBordingEmployeeApproval",
                headers: { 'Authorization': '@_tokan' },
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (response, status, xhr) {
                    if (response.MegSts == "Ok") {
                        // Clone the body and remove unwanted elements
                        var $bodyClone = $('body').clone(); // Clone the body using jQuery
                        $bodyClone.find('.page-bar, .page-sidebar-wrapper,.primary-menu, .menu_header_Account_details, .page-footer, .page-header, .reject, .approve, .loading').remove(); // Adjust selectors accordingly

                        // Create a new window
                        var newWindow = window.open('', '_blank'); // Open a new blank window

                        if (newWindow) { // Check if the new window is successfully opened
                            // Write the cloned body content into the new window
                            newWindow.document.open();
                            newWindow.document.write('<html><head><title>Print</title></head><body>' + $bodyClone.html() + '</body></html>');
                            newWindow.document.close();

                            // Wait for the new window to fully load before printing
                            newWindow.onload = function () {
                                newWindow.focus(); // Focus the new window for better user experience
                                newWindow.print(); // Trigger the print dialog

                                // Close the current window and navigate to the new page
                                setTimeout(function () {
                                    window.close(); // Close the current window
                                    // Navigate to the new page and force a reload
                                    newWindow.location.href = '/Employee/Onboarding';
                                    setTimeout(function () {
                                        // Force a reload of the new page
                                        window.location.reload();
                                    }, 1000); // Adjust delay as needed
                                }, 1000); // Adjust delay as needed
                            }
                        } else {
                            toastr.error("Unable to open print window.");
                        }
                        $("#ajax_loader").hide();
                    }
                    else
                    {
                        $("#ajax_loader").hide();
                        toastr.remove();
                        toastr.error(response.MegSts);
                    }
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    $('.loading').hide();
                    if (jqXHR.responseText != null) {
                        var obj = JSON.parse(jqXHR.responseText);
                        if (obj.MegSts == 'error') {
                            toastr.remove();
                            toastr.error(obj.Meg);
                            return false;
                        }
                        else {
                            toastr.remove();
                            toastr.error(obj.Meg);
                        }
                    }
                    if (jqXHR.status == 500) {
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });
        $("#btn_Close").on('click', function () {
            event.preventDefault();
            window.location.href = "/Employee/OnBoarding";
        });
    });
    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
</script>

