    function fillDeptTable(BranchId, selectedDept) {
        $("#ddlDepartmentID").empty();
        $.ajax({
            type: "GET",
            url: "/MasterData/GetDeptbyBranchstr?BranchId=" + BranchId,
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            success: function (response) {
                if (response != null) {
                    for (var i = 0; i < response.length; i++) {
                        $('#ddlDepartmentID').append('<option value="' + response[i].Value + '">' + response[i].Text + '</option>');
                    }
                    $selectDepart.multiselect('rebuild');
                    $(document.body).on('change', '#DeptIds', function () {
                        $("#spvalidation").hide();
                        var deptid = $('#ddlDepartmentID option:selected');
                        var DeptArray = [];
                        $(deptid).each(function (index, deptid) {
                            DeptArray.push([$(this).val()]);
                        });
                        if (DeptArray == "") {
                            $("#txt2").val(0);
                        }
                        else {
                            $("#txt2").val(DeptArray);
                            $("#spValidation").hide();
                        }
                        var ArrDept = $("#txt2").val();
                        DeptIdlst = ArrDept;
                        $("#ddlDepartmentID").val(DeptIdlst);
                    });
                }
                $(".loading").hide();
            },
            beforeSend: function () {
                $(".loading").show();
            },
            error: function () {
                $(".loading").hide();
            }
        });
    }

