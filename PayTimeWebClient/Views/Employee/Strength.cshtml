    function StrengthCalculate(type, result) {
        var curStrength = parseFloat($('#curStrength').val());
        var targetStrength = parseFloat($('#targetStrength').val());
        if (curStrength > 0 && targetStrength > 0) {
            if (type == 1) {
                var percentage = targetStrength * 0.01 * curStrength;
                result = curStrength + percentage;
            }
            else if (type == 2) {
                result = curStrength + targetStrength;
            }
            return result;
        }
        else {
            return result = 0;
        }
    }

    function SaveStrength(StrengthID, departmentid, designationid, strengthTypeid, StatusID, CurStrength, targetStrength, totalStrength, FlagID,RoleID,EmpID) {
        var objDetails = {
            StrengthID: parseInt(StrengthID),
            DepartmentId: parseInt(departmentid),
            DesignationId: parseInt(designationid),
            CurrentStrength: parseInt(CurStrength),
            TargetStrength: parseInt(targetStrength),
            TotalStrength: parseInt(totalStrength),
            StrengthType: parseInt(strengthTypeid),
            StatusID: parseInt(StatusID),
            FlagID: parseInt(FlagID),
            RoleID: parseInt(RoleID),
            EmpId: parseInt(EmpID)
        };
        var delay = 1000;
        $.ajax({
            url: '@_webapiurl' + 'Employee/OnSaveStrengthMasterData',
            type: 'POST',
            headers: { 'Authorization': '@_tokan' },
            contentType: 'application/json',
            dataType: 'json',
            data: JSON.stringify(objDetails),
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (response) {
                $("#ajax_loader").hide();
                if (response != null) {
                    if (response.MegSts == "ok") {
                        toastr.remove();
                        toastr.success(response.Meg);
                        setTimeout(function () {
                            window.location.reload(true);
                        }, delay);
                    } else {
                        toastr.remove();
                        toastr.error(response.Meg);
                        setTimeout(function () {
                            window.location.reload(true);
                        }, delay);
                    }
                } else {
                    toastr.remove();
                    toastr.error(response.Meg);
                    setTimeout(function () {
                        window.location.reload(true);
                    }, delay);
                }
            },
            error: function (response) {
                $("#ajax_loader").hide();
                if (response != null) {
                    toastr.remove();
                    toastr.error(response.Meg);
                    setTimeout(function () {
                        window.location.reload(true);
                    }, delay);
                }
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }

    function DepartmentGetAll(deptId) {
        $('#DepartmentIdPage').empty();
        var DId = 0;
        if (deptId != null) {
            DId = deptId;
        }
        $.ajax({
            type: "GET",
            url: '@_webapiurl' + 'Master/DepartmentGetAll',
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response != null) {
                    $("#DepartmentIdPage").append("<option value='0' selected>Select Department</option>");
                    // Sort the response array by branch name in ascending order
                    response.sort(function (a, b) {
                        return a.DepartmentName.localeCompare(b.DepartmentName);
