                async: "false",
                success: function (response) {
                    if (response != null) {
                        response.sort(function (a, b) {
                            return a.EmpName.localeCompare(b.EmpName);
                        });
                        for (var i = 0; i < response.length; i++) {

                            $('#Select_Employee').append('<option value="' + response[i].EmpId + '">' + response[i].EmpName + ' ( ' + response[i].Empcode + ')</option>');
                        }
                        //if (emprole > 1 && emprole != 6805 && emprole != 6806) {
                        //    $("#Select_Employee option[value = '" + pkloginemployeeid + "' ]").prop('selected', true);
                        //}
                        $SelectEmployee.multiselect('rebuild');
                    }
                    $(".loading").hide();
                    GetAttndancelist(0);
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }

    });

    function calculateTotalHours() {
        let inTime = document.getElementById("InPunchTime").value;
        let outTime = document.getElementById("OutPunchTime").value;

        if (inTime && outTime) {
            // Parse the input time (HH:MM format)
            let [inHours, inMinutes] = inTime.split(":").map(Number);
            let [outHours, outMinutes] = outTime.split(":").map(Number);

            // Create Date objects for both
            let inDate = new Date();
            inDate.setHours(inHours, inMinutes, 0, 0);

            let outDate = new Date();
            outDate.setHours(outHours, outMinutes, 0, 0);

            // Handle overnight shifts (e.g., 20:10 - 08:30)
            if (outDate < inDate) {
                outDate.setDate(outDate.getDate() + 1);
            }

            // Calculate total difference
            let diffMs = outDate - inDate;
            let totalHours = Math.floor(diffMs / (1000 * 60 * 60));
            let totalMinutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

            // Format as HH:MM
            let totalTime = `${String(totalHours).padStart(2, '0')}:${String(totalMinutes).padStart(2, '0')}`;
            document.getElementById("txthours").innerText = totalTime;
            //$("#TotalHoursReq").val() = totalTime;
        }
    }

    function ShiftGetAll(shftId)
    {

            $('#ShiftId').empty();
            var SId = 0;
            if (shftId != null) {
                SId = shftId;
            }
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + 'Master/ShiftMasterGetAll',
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    if (response != null) {
                        $("#ShiftId").append("<option value='0' selected>Select Shift</option>");
                        response.sort(function (a, b) {
                            return a.ShiftName.localeCompare(b.ShiftName);
                        });
                        for (var i = 0; i < response.length; i++) {
                            $("#ShiftId").append("<option value='" + response[i].ShiftId + "'>" + response[i].ShiftName + "</option>");
                        }
                    }
                    if (SId != null & SId != 0) {
                        $("#ShiftId option[value ='" + SId + "']").prop('selected', true);
                        $('#ShiftId').trigger('change.select2');
                    }
                    $(".loading").hide();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
    }

    function validateOvertime(input)
    {

        input.value = input.value.replace(/\D/g, '');
        let num = parseInt(input.value, 12);
        if (isNaN(num) || num < 0) {
            input.value = '';
        } else if (num > 12) {
            input.value = '12';
        }
    }

    function clearFormaftercorrect()
    {
        $("#ShiftId").val(0);
        $("#InPunchTime").val("00:00");
        $("#OutPunchTime").val("00:00");
        document.getElementById("txthours").innerText = "00:00";
    }
