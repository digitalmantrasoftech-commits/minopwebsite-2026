                });
                $('#tbldirectorydetails tr:eq(0) th:eq(0)').html("<a class='btn btn-xs tooltips' title='Columns' onclick='showvisibilityColumn();' id='btnColumnvisibility'><i class='fa-regular fa-columns' style='font-size: 14px; color: #3598dc;'></i></a>All");
