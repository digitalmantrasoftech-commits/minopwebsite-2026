    function showvisibilityColumn() {
        var previousCheckedColumns = checkedColumnsList;
        checkedColumnsList = "";
        var newCheckedColumns = "";
        var inputFieldId = "";
        $('#fieldlst :input').each(function () {
            $('#fieldlst').val('');
            inputFieldId = $(this).attr("id");
            var columnId = inputFieldId.replace("chk_", "");
            $("#" + inputFieldId).prop('checked', false);

            var previousCheckedArray = previousCheckedColumns.split(",");
            for (var i = 0; i <= previousCheckedArray.length; i++) {
                if (previousCheckedArray[i] == columnId) {
                    if (previousCheckedArray[i] == 0) {
                        $("#" + inputFieldId).prop('checked', true);
                        $("#" + inputFieldId).attr('disabled', true);
                    }
                    else {
                        $("#" + inputFieldId).prop('checked', true);
                    }
                    newCheckedColumns += "," + columnId;
                }
            }
        });
        checkedColumnsList = newCheckedColumns;

        $("#btnColumnvisibility").attr("data-toggle", "modal");
        $("#btnColumnvisibility").attr("data-target", "#frmpopupCustomfld");
    }

