        CompanyID = companyIDNew;
        BranchID = BranchIDNew;
        DepartmentID = DepartmentIDNew;
        DesignationID = DesignationIDNew;


        var ObjData =
        {
            OnBoardingID: OnBordingID,
            RoleId: roleid,
            CompanyId: CompanyID,
            BranchId: BranchID,
            LoginEmpId: loginempid,
            DepartmentID: DepartmentID,
            DesignationID: DesignationID,
            DeactivateID: parseInt(DeactivateID),
