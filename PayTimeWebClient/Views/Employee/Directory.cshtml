        $("#btnIactivesubmit").click(function (event) {
            checkSession();
            var empdeactivationID = $("#empdeactivationID option:selected").text();
            var inactivedate = "";
            var resigndate = "";
            var suspenddate = "";
            var errormsg = "";
            if (empdeactivationID == "Select deactivation" || empdeactivationID == "") {
                toastr.remove();
                toastr.error("Please Select deactivation.");
                $("#empdeactivationID").addClass('field_error');
                event.preventDefault();//or return false
                $(".loading").hide();
                return false;
            } else {
                $("#empdeactivationID").removeClass('field_error');
            }

            if ($("#empdeactivationID").val() == 1) {
                if ($("#EmpInactiveResignDate").val() == "") {
                    $("#EmpInactiveResignDate").attr('required', true);
                    toastr.remove();
                    toastr.error("Please enter Resign Date.");
                    $("#EmpInactiveResignDate").addClass('field_error');
                    event.preventDefault(); //or return false
                    return false;
                } else {
                    $("#EmpInactiveResignDate").removeClass('field_error');

                    if ("@_isdateformat" == "dd-mm-yyyy") {
                        var resignEmp = $("#EmpInactiveResignDate").val().split("-");
                        resigndate = resignEmp[2] + "-" + resignEmp[1] + "-" + resignEmp[0];
                    }
                    else if ("@_isdateformat" == "mm-dd-yyyy") {
                        var resignEmp = $("#EmpInactiveResignDate").val().split("-");
                        resigndate = resignEmp[2] + "-" + resignEmp[0] + "-" + resignEmp[1];
