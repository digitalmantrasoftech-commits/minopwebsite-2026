                    initComplete: function (settings, json) {

                        $('#tbldirectorydetails thead th').eq(112).addClass('fixed-column-1');
                        $('#tbldirectorydetails thead th').eq(116).addClass('fixed-column');

                        $("#tbldirectorydetails thead tr:eq(1) th").each(function (index) {
                            var title = $(this).text();
                            if (index == 0) {
                                $(this).html('');
                                $(this).html('<input type="checkbox" class="selectall" id="selectall">');
                                $(this).css('text-align', 'center');
                            } else {
                                $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
                            }
                        });

                        $('.nosearch').parents('th').each(function () {
                            Directory_table.column($(this).index()).search('');
