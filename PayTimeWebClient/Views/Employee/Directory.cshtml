    function CompanyGetAllFilter() {
        $('#ddlCompanyID').empty();
        $.ajax({
            type: "GET",
            url: '@_webapiurl' + 'Master/CompanyGetAll',
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            beforeSend: function () {
                //$(".loading").show();
            },
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response != null) {
                    response.sort(function (a, b) {
                        return a.CompanyName.localeCompare(b.CompanyName); // Sort company names in ascending order
                    });
                    $("#ddlCompanyID").append("<option value='0' selected>Select Company</option>");
                    for (var i = 0; i < response.length; i++) {
                        if (RoleId != 6805 && RoleId != 6806 && RoleId == 1) {

                            $("#ddlCompanyID").append("<option value='" + response[i].CompanyID + "'>" + response[i].CompanyName + "</option>");
                        }
                        else if (RoleId == 6805 || RoleId == 6806) {
                            if (response[i].CompanyID == _companyid) {
                                $("#ddlCompanyID").append("<option value='" + response[i].CompanyID + "'>" + response[i].CompanyName + "</option>");
                            }
                        }
                        else if (RoleId > 1) {
                            if (response[i].CompanyID == _companyid) {
                                $("#ddlCompanyID").append("<option value='" + response[i].CompanyID + "'>" + response[i].CompanyName + "</option>");
                            }
                        }
                    }
                }
                //$(".loading").hide();
            },
            error: function () {
                //$(".loading").hide();
            }
        });
    }

