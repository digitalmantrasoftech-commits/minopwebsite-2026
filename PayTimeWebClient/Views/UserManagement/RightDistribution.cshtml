@model PayTimeWebClient.Models.RoleRightsMapping
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Data;
@using System.Configuration;
@{
    ViewBag.Title = "RoleRights";
    int nn = 0;
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/Scripts/stickythead.js"></script>
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            @if (Convert.ToInt32(Session["IsSchool"]) == 1)
            {
                <li>
                    <a href="/School/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                </li>
            }
            else
            {
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            }
            <li>
                <span><i class="fa-light fa-angle-right"></i> Right Distribution</span>
            </li>
        </ul>
    }
</div>
@if (obj.CanView)
{
    using (Html.BeginForm())
    {
        <div class="portlet">
            <div class="portlet-body">
                <div class="row">                    
                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <div class="form-group margin-0">
                            <label>Select Role</label>
                            @if (ViewBag.RoleList != null)
                            {
                                @Html.DropDownListFor(model => model.RoleId, new SelectList(ViewBag.RoleList, "RoleId", "RoleName"), "Select Role", new { @class = "form-control input-sm select2", onchange = @"var form = document.forms[1];form.action='RightDistribution';form.submit();" })
                            }
                            else
                            {
                                @Html.DropDownList("RoleId", new SelectList(new[] { "" }), "Select Role", new { @class = "form-control input-sm select2" })
                            }
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 text-left padding-top-20">
                            @if (Model.RoleMenuData != null && Model.RoleMenuData.Count() > 0)
                            {
                                <input id="btnRolePermission" class="btn save_btn" name="Command" type="submit" value="Set Permission" />
                            }
                    </div>
                    @if (Model.RoleMenuData != null && Model.RoleMenuData.Count() > 0)
                    {
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <hr class="save_hr_line" />
                            <div>
                                <table id="tblRoleRightsDetails" class="table table-bordered table-hover table-condensed table-striped webgrid">
                                    <thead>
                                        <tr class="ui-state-default">
                                            <th>Check all</th>
                                            <th class="text-center">Menu Name</th>
                                            <th class="text-center">Can View</th>
                                            <th class="text-center">Can Add</th>
                                            <th class="text-center">Can Edit</th>
                                            <th class="text-center">Can Export</th>
                                            <th class="text-center">Can Import</th>
                                        </tr>
                                    </thead>
                                    @if (Model.RoleMenuData != null && Model.RoleMenuData.Count() > 0)
                                    {
                                        var ParentMenu = (Model.RoleMenuData.Where(x => x.ParentMenuName != "" && x.ParentMenuName != "Time Reports").Select(x => x.ParentMenuName)).Distinct();
                                        foreach (string item in ParentMenu)
                                        {
                                            <tr class="@(nn % 2 == 1 ? "row_alternate" : "row_normal")">
                                                <td colspan="8" style="font-weight: bold; font-size: small">
                                                    <input type="checkbox" class="checkallMenu" data-group="@item" style="vertical-align: middle; position: relative; top: -1px;"/>
                                                @item </td>
                                            </tr>
                                            var drSubMenu = Model.RoleMenuData.Where(x => x.ParentMenuName == item);

                                            foreach (var dr in drSubMenu)
                                            {
                                                <tr class="@(nn % 2 == 1 ? "row_alternate" : "row_normal")">
                                                    <td>
                                                        <input type="checkbox" class="checkall" data-group="@item" />
                                                    </td>
                                                    <td>@Convert.ToString(dr.OperationName)</td>
                                                    <td class="text-center">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="checkboxes" id="chkCanView_@dr.OperationId" name="chkCanView_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanView)" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                    <td class="text-center">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="checkboxes" id="chkCanAdd_@dr.OperationId" name="chkCanAdd_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanAdd)" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                    <td class="text-center">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="checkboxes" id="chkCanEdit_@dr.OperationId" name="chkCanEdit_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanEdit)" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                    @*<td class="text-center">
                                <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                    <input type="checkbox" class="checkboxes" id="chkCanDelete_@dr.OperationId" name="chkCanDelete_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanDelete)" />
                                    <span></span>
                                </label>
                            </td>*@
                                                    <td class="text-center">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="checkboxes" id="CanExport_@dr.OperationId" name="CanExport_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanExport)" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                    <td class="text-center">
                                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                                            <input type="checkbox" class="checkboxes" id="CanImport_@dr.OperationId" name="CanImport_@dr.OperationId" checked="@Convert.ToBoolean(dr.CanImport)" />
                                                            <span></span>
                                                        </label>
                                                    </td>
                                                </tr>

                                            }
                                            nn++;
                                        }
                                    }
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

    }
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
<script type="text/javascript" language="javascript">
    var count = 0;
    var form = "Right Distribution";
    var operation = "";
    $(document).ready(function () {

        stickyThead.apply(document.querySelectorAll('.table'))   // this line code - header fix

        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        if ("@_Message" != "") {
            toastr.remove();
            toastr.success("@_Message");
        }
        @*if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
            //$(".alert-danger").show();
            //$(".alert-success").hide();
        }*@
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Right Distribution";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })
    }
    );
    $(document).on("change", ".checkall", function () {
        $(this).closest("tr").find(":checkbox").prop("checked", this.checked);
        var group = $(this).data("group");
        var allChecked = $(".checkall[data-group='" + group + "']").length === $(".checkall[data-group='" + group + "']:checked").length;
        $(".checkallMenu[data-group='" + group + "']").prop("checked", allChecked);
    });
    $(document).on("change", ".checkallMenu", function () {
        var group = $(this).data("group");
        var isChecked = $(this).prop("checked");
        $(".checkall[data-group='" + group + "']").each(function () {
            $(this).prop("checked", isChecked);
            $(this).closest("tr").find(":checkbox").prop("checked", isChecked);
        });
    });
</script>
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>