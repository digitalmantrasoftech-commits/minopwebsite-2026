@model PayTimeWebClient.Models.ProductMenuGroup
@{
    int rowIndex = 0;
    string panelId = "product_" + Model.ProductId;
    string collapseClass = Model.IsExpanded ? "collapse in" : "collapse";
    string ariaExpanded = Model.IsExpanded ? "true" : "false";
}

<div class="product-panel margin-bottom-10">
    <div class="accordian-header product-panel-header" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border: 1px solid #dee2e6; border-radius: 4px; padding: 10px 15px;">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <input type="checkbox" class="checkAllProduct" data-product="@Model.ProductId" style="margin-right: 10px; transform: scale(1.2);" title="Check all menus in @Model.ProductName" />
                <a href="#@panelId" data-toggle="collapse" aria-expanded="@ariaExpanded" aria-controls="@panelId" style="color: #333; text-decoration: none; font-weight: 600; font-size: 14px;">
                    <i class="@Model.IconClass" style="margin-right: 8px; color: #007bff;"></i>
                    @Model.ProductName
                    <span class="badge" style="background-color: #007bff; color: white; margin-left: 8px; font-size: 11px; padding: 3px 8px; border-radius: 10px;"></span>
                    <i class="fa-solid fa-chevron-down arrow_down" style="margin-left: 10px; transition: transform 0.3s;"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="@collapseClass" id="@panelId" aria-expanded="@ariaExpanded">
        <div class="list-box" style="border: 1px solid #dee2e6; border-top: none; border-radius: 0 0 4px 4px; padding: 0;">
            @if (Model.ParentMenuGroups != null && Model.ParentMenuGroups.Any())
            {
                <table class="table table-bordered table-hover table-condensed table-striped webgrid" style="margin-bottom: 0;">
                    <thead>
                        <tr class="ui-state-default">
                            <th style="width: 50px;">Check all</th>
                            <th class="text-center">Menu Name</th>
                            <th class="text-center" style="width: 80px;">Can View</th>
                            <th class="text-center" style="width: 80px;">Can Add</th>
                            <th class="text-center" style="width: 80px;">Can Edit</th>
                            <th class="text-center" style="width: 80px;">Can Export</th>
                            <th class="text-center" style="width: 80px;">Can Import</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int p = 0; p < Model.ParentMenuGroups.Count; p++)
                        {
                            var parentGroup = Model.ParentMenuGroups[p];
                            <!-- Parent Menu Header Row -->
                            <tr class="@(rowIndex % 2 == 1 ? "row_alternate" : "row_normal")" style="background-color: #f1f3f5;">
                                <td colspan="7" style="font-weight: bold; font-size: small; padding: 8px 12px;">
                                    <input type="checkbox" class="checkallMenu" data-group="@(Model.ProductId)_@parentGroup.ParentMenuName" style="vertical-align: middle; position: relative; top: -1px; margin-right: 8px;" />
                                    <i class="fa-solid fa-folder" style="margin-right: 5px; color: #6c757d;"></i>
                                    @parentGroup.ParentMenuName
                                    <span style="color: #6c757d; font-weight: normal; font-size: 12px;">(@parentGroup.ChildMenus.Count)</span>
                                </td>
                            </tr>

                            for (int m = 0; m < parentGroup.ChildMenus.Count; m++)
                            {
                                var menu = parentGroup.ChildMenus[m];
                                <!-- Child Menu Row -->
                                <tr class="@(rowIndex % 2 == 1 ? "row_alternate" : "row_normal")">
                                    <td style="text-align: center;">
                                        <input type="checkbox" class="checkall" data-group="@(Model.ProductId)_@parentGroup.ParentMenuName" />
                                    </td>
                                    <td style="padding-left: 25px;">
                                        <i class="" style="margin-right: 5px; color: #adb5bd;"></i>
                                        @Convert.ToString(menu.OperationName)
                                    </td>
                                    <td class="text-center">
                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                            <input type="checkbox" class="checkboxes" id="chkCanView_@menu.OperationId" name="chkCanView_@menu.OperationId" checked="@Convert.ToBoolean(menu.CanView)" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td class="text-center">
                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                            <input type="checkbox" class="checkboxes" id="chkCanAdd_@menu.OperationId" name="chkCanAdd_@menu.OperationId" checked="@Convert.ToBoolean(menu.CanAdd)" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td class="text-center">
                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                            <input type="checkbox" class="checkboxes" id="chkCanEdit_@menu.OperationId" name="chkCanEdit_@menu.OperationId" checked="@Convert.ToBoolean(menu.CanEdit)" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td class="text-center">
                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                            <input type="checkbox" class="checkboxes" id="CanExport_@menu.OperationId" name="CanExport_@menu.OperationId" checked="@Convert.ToBoolean(menu.CanExport)" />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td class="text-center">
                                        <label class="mt-checkbox mt-checkbox-single mt-checkbox-outline">
                                            <input type="checkbox" class="checkboxes" id="CanImport_@menu.OperationId" name="CanImport_@menu.OperationId" checked="@Convert.ToBoolean(menu.CanImport)" />
                                            <span></span>
                                        </label>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                            rowIndex++;
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="padding: 20px; text-align: center; color: #6c757d;">
                    <i class="fa-solid fa-info-circle" style="margin-right: 5px;"></i>
                    No menus available for this product.
                </div>
            }
        </div>
    </div>
</div>
