@model PayTimeWebClient.Models.Roles
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    int _cmpid = 0;
    int _branchid = 0;

    if (_RoleId == 6805)
    {
        _cmpid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"]);
    }
    if (_RoleId == 6806)
    {
        _cmpid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"]);
        _branchid = Convert.ToInt32(HttpContext.Current.Session["BranchId"]);
    }
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/Scripts/timeme.js"></script>
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<script type="text/javascript">
    var count = 0;
    var form = "Role Master";
    var operation = "";
    $(document).ready(function () {
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        $(".alert").hide();
        $("#ajax_loader").hide();
        if ("@_Message" != "") {
            toastr.remove();
            toastr.success("@_Message");
            $("#ajax_loader").hide();
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
            $("#ajax_loader").hide();
        }

        $('#RoleName').keydown(function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $('#RoleDescription').keydown(function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $('input[type="text"]').on('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.keyCode == 86) {
                e.preventDefault();
                return false;
            }
        });
        $("#RoleName").keypress(function (e) {
            var keyCode = e.which;
            var Responce = validateKeyPress(keyCode);
            if (Responce == true) {
            }
            else { e.preventDefault(); }
        });
        $("#RoleDescription").keypress(function (e) {
            var keyCode = e.which;
            var Responce = validateKeyPress(keyCode);
            if (Responce == true) {
            }
            else { e.preventDefault(); }
        });
        document.oncontextmenu = function () { return false; };
        $(document).mousedown(function (e) {
            if (e.button == 2) {
                return false;
            }
            return true;
        });
        $('#RoleName').keydown(function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $('#RoleDescription').keydown(function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $('#tblrole').DataTable({
            dom: _domCommon,
            language: _languageCommon,
            columnDefs: [
                {
                    targets: 3,
                    orderable:false,
                }
            ]
        });

        setTimeout(function () {
            $("#" + "tblrole" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        $("#AddRole").on('click', function () {
            count++;
            operation = "Add Form";
            frmClear();
            $("#AddRole").attr("data-toggle", "modal");
            $("#AddRole").attr("data-target", "#frmpopup");
        });
        $("#btnrolesubmit").click(function (event) {
            if ($("#RoleName").val().trim() == "") {
                $("#RoleName").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#RoleName").removeClass('field_error');
            }
            if ($("#RoleDescription").val().trim() == "") {
                $("#RoleDescription").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#RoleDescription").removeClass('field_error');
            }
            $("#ajax_loader").show();
        });
        $("#RoleName").keypress(function (e) {
            $("#RoleName").removeClass('field_error');
        });
        $("#RoleDescription").keypress(function (e) {
            $("#RoleDescription").removeClass('field_error');
        });
        $("#RoleName").blur(function () {
            var roleName = removeTags($("#RoleName").val());
            $("#RoleName").val(roleName);
        });
        $("#tblrole").on('click', '.editclass', function () {
            count++;
            operation = "Edit Form";
            frmClear();
            $("#RoleId").val($(this).parent('td').parent('tr').children(1)[0].innerText.trim());
            $("#RoleName").val($(this).parent('td').parent('tr').children(1)[1].innerText.trim());
            $('#RoleDescription').val($(this).parent('td').parent('tr').children(1)[2].innerText.trim());
            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");
        });
        $("#tblrole").on('click', '.deleteclass', function () {
            var flg = 0;
            if (confirm("Are you sure for Delete this Entry?")) {
                $("#RoleId").val($(this).parent('td').parent('tr').children(1)[0].innerText.trim());

                $.post("/UserManagement/DeleteRoleMaster?id=" + $("#RoleId").val(), function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var _response = $.parseJSON(response);
                    if (_response == "OK") {
                        var strid = "Col_" + $("#RoleId").val().trim();
                        $("#" + strid + "").closest('tr').remove();
                        $('#tbluserDetails').DataTable();
                    }
                    else {
                        alert("something wrong occures.");
                    }
                });
            }
        });
        function frmClear() {
            $("#RoleId").val(0);
            $("#RoleName").val("");
            $("#RoleName").attr("placeholder", "Enter Role Name");
            $("#RoleName").attr('required', true);
            $("#RoleName").removeClass('field_error');

            $("#RoleDescription").val("");
            $("#RoleDescription").attr("placeholder", "Enter Role Description");
            $("#RoleDescription").attr('required', true);
            $("#RoleDescription").removeClass('field_error');

            $("#spvalidation").hide();

        }
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Role Master";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })
    });
</script>

<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            @if (Convert.ToInt32(Session["IsSchool"]) == 1)
            {
                <li>
                    <a href="/School/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                </li>
            }
            else
            {
                <li>
                    <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
                </li>
            }
            <li>
                <span><i class="fa-light fa-angle-right"></i> Roles</span>
            </li>
        </ul>
    }
    else
    {
        if (Convert.ToInt32(Session["IsSchool"]) != 1)
        {
            <ul class="page-breadcrumb">
                <li>
                    <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
                </li>
                <li>
                    <span><i class="fa-light fa-angle-right"></i> Roles</span>
                </li>
            </ul>
        }
    }

    <div class="page-toolbar">
        @if (obj.CanAdd)
        {
            <div class="text-right">
                <a href="javascript:void(0)" id="AddRole" class="btn icon_transparent_btn  tooltips" data-placement="left" data-original-title="Add Role"><i class="fa-solid fa-plus"></i></a>
                &nbsp; &nbsp; <b>OR</b>&nbsp; &nbsp;
                <a href="/Paytime/TemplateRole" id="btntemplates" class="btn icon_transparent_btn  tooltips" data-placement="left" data-original-title="Use Templates"><i class="fa-regular fa-file-excel"></i></a>
            </div>
        }

    </div>
</div>

<!-- END PAGE BAR -->
<!-- END PAGE HEADER-->
@if (obj.CanView)
{
    <div class="portlet">
        <div class="portlet-body">
            <div class="row">
                <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
                    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    @if (Model.RoleList != null)
                    {
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tblrole" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column ">
                                <thead>
                                    <tr>
                                        <th hidden>Role ID</th>
                                        <th>Role Name</th>
                                        <th>Role Description</th>
                                        <th style="width: 10%;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.RoleList)
                                    {
                                        <tr>
                                            <td hidden>
                                                @Html.DisplayFor(modelItem => item.RoleId)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelitem => item.RoleName)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelitem => item.RoleDescription)
                                            </td>

                                            <td id="Col_@item.RoleId">
                                                @if (_RoleId == 1)
                                                {
                                                    <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"> </i></a>
                                                }
                                                else if (_RoleId == 6805 && obj.CanEdit && (item.CompanyID != 0 && item.CompanyID == _cmpid))
                                                {
                                                    <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"> </i></a>
                                                }
                                                else if (_RoleId == 6806 && obj.CanEdit && (item.CompanyID != 0 && item.BranchID == _branchid))
                                                {
                                                    <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"> </i></a>
                                                }
                                                else if (_RoleId > 1 && obj.CanEdit && _RoleId != 6805 && _RoleId != 6806)
                                                {
                                                    <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"> </i></a>
                                                }
                                                @*@if (obj.CanEdit)
                                                    {
                                                    <a class="editclass btn btn-xs blue tooltips" title="Edit"><i class="fa-regular fa-pen-to-square"> </i></a>
                                                    }*@
                                                @if (obj.CanDelete)
                                                {
                                                    <span>|</span><span> </span>
                                                    <a class="deleteclass btn red_btnnew tooltips" data-placement="top" title="Delete"><i class="fa-regular fa-trash-can"></i></a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div id="NotificationGrid-empty">
                            <div class="datanotfound">
                                <img src="~/assets/images/emptyscreen_1.png" height="148" width="280" alt="Nodata Found Icon">
                                <p class="datanotfound_title">No data found</p> <!-- titleText -->
                                <p class="">No entries found. Please add a record to get started.</p><!-- subText -->
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog w-500">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Role</h4>
                </div>

                @using (Html.BeginForm())
                {
                    <div class="modal-body">
                        <div class="modal-card">
                            <fieldset>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label class=" control-label">@Html.HiddenFor(model => model.RoleId)Role Name <span class="required" aria-required="true"> * </span></label>
                                            <div class="editor-field">
                                                @*@Html.EditorFor(model => model.RoleName, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "30" } })*@
                                                <input class="form-control input-sm text-box single-line" id="RoleName" maxlength="30"
                                                       name="RoleName" type="text" value="" placeholder="Enter Role Name" required="required" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')">
                                                @Html.ValidationMessageFor(model => model.RoleName)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label class="control-label">Role Description <span class="required" aria-required="true"> * </span></label>
                                            @*@Html.EditorFor(model => model.RoleDescription, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "100" } })*@
                                            <input class="form-control input-sm text-box single-line" id="RoleDescription" maxlength="100" name="RoleDescription" type="text" value="" placeholder="Enter Role Description" required="required" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')">
                                            @Html.ValidationMessageFor(model => model.RoleDescription)
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="row">
                            <div class="col-lg-12 text-right">
                                <button type="submit" class="btn save_btn" id="btnrolesubmit"><i class="fa-light fa-floppy-disk"></i> Save</button>
                            </div>
                        </div>
                    </div>
                }


            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
</script>

