@{
    // Get current product from session
    var currentProductName = HttpContext.Current.Session["SelectedProductName"] != null
        ? HttpContext.Current.Session["SelectedProductName"].ToString()
        : "Time & Attendance";
    var currentProductId = HttpContext.Current.Session["SelectedProductId"] != null
        ? Convert.ToInt32(HttpContext.Current.Session["SelectedProductId"])
        : 1;

    //STATIC TEST VALUES - For testing expired plan functionality
    //int isPlanExp = 1;           // 1 = expired, 0 = active
    //int isFplan = 0;             // 1 = free/trial, 0 = paid
    //int rmDay = 0;               // Days remaining
    //string planExpDate = "2025-03-13";  // Expiry date

    //ORIGINAL SESSION CODE - Uncomment after testing
    int isPlanExp = HttpContext.Current.Session["isPlanExp"] != null
        ? Convert.ToInt32(HttpContext.Current.Session["isPlanExp"]) : 0;
    int isFplan = HttpContext.Current.Session["isFplan"] != null
        ? Convert.ToInt32(HttpContext.Current.Session["isFplan"]) : 0;
    int rmDay = HttpContext.Current.Session["rmDay"] != null
        ? Convert.ToInt32(HttpContext.Current.Session["rmDay"]) : 0;
    string planExpDate = HttpContext.Current.Session["PlanExpDate"] != null
