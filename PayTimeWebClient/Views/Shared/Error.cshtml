@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Something went wrong | MinopCloud</title>
    <link href="~/assets/css/minop-standalone-v2.css?v=20260606" rel="stylesheet" />
</head>
<body class="minop-error-page">
    <main class="minop-error-card" role="main">
        <div class="minop-error-code">!</div>
        <h1 class="minop-error-title">Something went wrong</h1>
        <p class="minop-error-text">We could not complete your request. Please refresh the page or return to the application dashboard.</p>
        <a class="btn btn-primary" href="~/">Return to MinopCloud</a>
    </main>
</body>
</html>
