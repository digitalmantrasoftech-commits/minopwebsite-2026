<script>
    function getCookie(cname) {
        var name = cname + "=";
        var decodedCookie = decodeURIComponent(document.cookie);
        var ca = decodedCookie.split(';');
        for (var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') {
                c = c.substring(1);
            }
            if (c.indexOf(name) == 0) {
                return c.substring(name.length, c.length);
            }
        }
        return "";
    }
    $(window).on('load', function () {
        $(".goog-te-menu-value").html('<span>Select Language</span><img src="https://www.google.com/images/cleardot.gif" alt="" width="1" height="1" class=""><span aria-hidden="true" class="fa fa-angle-down" style="color: rgb(155, 155, 155);"></span>');
    });
    $(document).ready(function () {

        //requestNotificationData();
        $('#btnnoti').click(function () {
            requestNotificationDataread();
            var x = $(this).attr('aria-expanded');
            if (x == 'false') {
                $('#noti_Counter').hide();
                $('#noti_Counter').text('');
            }
        });
        var notiidarr = [];

        function requestNotificationData() {
            $.ajax({
                url: '@_webapiurl' + 'DashBoard/DeveloperGetNotification?p1=0&p2=' + '@_UserId',
                headers: { 'Authorization': '@_tokan' },
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    setNotification(data);
                },

            });
            setTimeout(requestNotificationData, 120000);
        }

        function requestNotificationDataread() {
            if (notiidarr.length > 0) {
                $.ajax({
                    url: '@_webapiurl' + 'DashBoard/DeveloperGetNotification?p1=1&p2=' + '@_UserId',
                    headers: { 'Authorization': '@_tokan' },
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json"

                });
            }
        }

        function setNotification(data) {
            var notiCount = 0;
            notiidarr = [];
            $("#notifications").empty();
            var list = $("#notifications");
            for (var i = 0; i < data.length; i++) {
                if (data[i].IsRead == 0) {
                    notiCount++;
                    notiidarr.push(data[i].Id);
                }
                list.append('<div href="#" class="text-reset notification-item"> <div class="media"> <div class="avatar-xs mr-3"> <span class="avatar-title bg-success rounded-circle font-size-16"> <i class="bx bx-badge-check"></i> </span> </div> <div class="media-body"> <h6 class="mt-0 mb-1 notifi_head">' + data[i].Title + '</h6> <div class="font-size-12 text-muted"> <p class="mb-1">' + data[i].Details + '</p> </div> </div> </div> </div>');
            }
            if (notiCount > 0) {
                $('#noti_Counter').text(notiCount).show();
            }

        }
        $(document).bind("contextmenu", function (e) {
            e.preventDefault();
        });
        $(document).keydown(function (e) {
            if (e.which === 123) {
                return false;
            }
            if (e.ctrlKey && e.shiftKey && e.keyCode == 'I'.charCodeAt(0)) {
                return false;
            }
            if (e.ctrlKey && e.shiftKey && e.keyCode == 'J'.charCodeAt(0)) {
                return false;
            }
            if (e.ctrlKey && e.keyCode == 'U'.charCodeAt(0)) {
                return false;
            }
        });
        $(function () {
            $("#feedback-tab").click(function () {
                $("#feedspvalidation").hide();
                $("#feedspvalidation").val("");
                $("#feedspvalidationErr").hide();
                $("#feedspvalidationErr").val("");
                $("#feedback-form").find("input").val('');
                $("#feedback-form").toggle("slide1");
            });

            $("#feedback-form form").on('submit', function (event) {
                var $form = $(this);
                $.ajax({
                    type: $form.attr('method'),
                    url: $form.attr('action'),
                    data: $form.serialize(),
                    success: function (data) {
                        if (data.isSend == true) {
                            $("#feedspvalidation").html(data.msg).show();
                        }
                        else {
                            $("#feedspvalidationErr").html(data.msg).show();
                        }
                        setTimeout(function () { $("#feedback-form").toggle("slide1").find("textarea").val(''); }, 3000);
                    },
                    error: function (data) {
                        $("#feedspvalidationErr").html(data).show();
                        setTimeout(function () { $("#feedback-form").toggle("slide1").find("textarea").val(''); }, 3000);
                    }
                });
                event.preventDefault();
            });
        });


        var $activeUL = $('#activelink');
        $activeUL.parents('li').addClass('active'); //add active class to all parent li

        var lang = getCookie('culture');
        if (lang != "") {
            $("#drplang").removeAttr('selected')
            $("#drplang").val(lang);
            $('#drplang option[value=' + lang + ']').attr('selected', 'selected');
        }
        $("#drplang").change(function () {
            $.ajax({
                contentType: 'application/json',
                dataType: 'json',
                type: 'post',
                data: '{"lang":"' + $("#drplang").val() + '"}',
                url: '/PayTime/ChangeLanguage',
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (result) {
                    $(".loading").hide();
                    location.reload();
                },
                error: function (result) {
                    $(".loading").hide();
                    location.href = '/PayTime/Index';
                },
            });

        });

    });

    function setHeartbeat() {
        setTimeout("heartbeat()", 300000); // every 5 min
    }

    function heartbeat() {
        $.get(
            "/SessionHeartbeat.ashx",
            null,
            function (data) {
                setHeartbeat();
            },
            "json"
        );
    }
</script>

<script>
    $(document).ready(function () {

        $('.dropdown_profile').click(function (e) {
            e.stopPropagation();
        });

        const $submenu = $('#hoverSubmenu');
        const $submenuTitle = $('#submenuTitle');
        const $menuContainer = $('.primary-menu ul');

        function scrollToItem($item) {
            const containerTop = $menuContainer.offset().top;
            const itemTop = $item.offset().top;
            const scrollTop = $menuContainer.scrollTop();
            const itemHeight = $item.outerHeight();
            const containerHeight = $menuContainer.height();

            if (itemTop < containerTop) {
                $menuContainer.animate({ scrollTop: scrollTop - (containerTop - itemTop) }, 200);
            } else if (itemTop + itemHeight > containerTop + containerHeight) {
                $menuContainer.animate({
                    scrollTop: scrollTop + ((itemTop + itemHeight) - (containerTop + containerHeight))
                }, 200);
            }
        }

        function showSubmenu($item) {

            const menuType = $item.data('menu').replace(" ", "");
            const menus = document.querySelectorAll('.sub-menu');

            menus.forEach(menu => {
                if (menu.id.replace(" ", "") !== menuType.replace(" ", "")) {
                    menu.style.display = "none";
                }
            });


            let title = menuType.charAt(0).toUpperCase() + menuType.slice(1);


            $("#hoverSubmenu").show();
            $("#" + menuType.toLowerCase().replace(" ", "") + "").show();
            $("#sub_" + menuType.toLowerCase().replace(" ", "") + "").show();

            const spriteClass = $item.find('.sprite').attr('class');


            const offset = $item.offset();
            const itemHeight = $item.outerHeight();
            const windowHeight = $(window).height();
            const scrollTop = $(window).scrollTop();

            let top = offset.top - scrollTop;
            let left = $item.outerWidth();

            const submenuHeight = $submenu.outerHeight();
            if (top + submenuHeight > windowHeight) {
                top = windowHeight - submenuHeight - 4;
            }
            if (top < 0) {
                top = 10;
            }

            $submenu.css({
                top: top,
                left: left,
                display: 'block'
            });
        }

        let lastClickedItem = null;
        let submenuTimer = null;
        let submenuHovered = false;

        $('.primary-menu li').on('click', function (e) {
            e.stopPropagation();
            const $clicked = $(this);

            //if (lastClickedItem && lastClickedItem[0] !== $clicked[0]) {
            //    lastClickedItem.removeClass('active');
            //}

            lastClickedItem = $clicked;
            //$('.primary-menu li').removeClass('active');
            //$clicked.addClass('active');

            scrollToItem($clicked);
            setTimeout(() => {
                showSubmenu($clicked);
            }, 220);
        });

        document.querySelectorAll(".sub-menu1 a").forEach(link => {
            link.addEventListener("click", function () {
                // Step 1: Remove active from all menu-items
                document.querySelectorAll(".menu-item").forEach(item => {
                    item.classList.remove("active");
                });

                // Step 2: Get the submenu's ID, e.g., sub_dashboard → Dashboard
                const submenu = this.closest(".sub-menu");
                if (submenu) {
                    const menuKey = submenu.querySelector(".submenu-header").id;
                    const parentMenu = document.querySelector(`.menu-item[data-menu="${menuKey}"]`);

                    if (parentMenu) {
                        parentMenu.classList.add("active");
                    }
                }
            });
        });

        $('.primary-menu li').on('mouseenter', function () {
            clearTimeout(submenuTimer);
            const $hovered = $(this);
            //$('.primary-menu li').removeClass('active');
            //$hovered.addClass('active');
            scrollToItem($hovered);
            showSubmenu($hovered);
        });

        $('.primary-menu li').on('mouseleave', function () {
            submenuTimer = setTimeout(() => {
                if (!submenuHovered && lastClickedItem == null) {
                    $submenu.hide();
                    //$('.primary-menu li').removeClass('active');
                }
            }, 200);
        });

        $submenu.on('mouseenter', function () {
            clearTimeout(submenuTimer);
            submenuHovered = true;
        });

        $submenu.on('mouseleave', function () {
            submenuHovered = false;
            submenuTimer = setTimeout(() => {
                if (!submenuHovered && lastClickedItem == null) {
                    $submenu.hide();
                    //$('.primary-menu li').removeClass('active');
                }
            }, 200);
        });

        $(document).on('click', function () {
            $submenu.hide();
            //$('.primary-menu li').removeClass('active');
            lastClickedItem = null;
        });

        $submenu.on('click', 'li', function (e) {
            e.stopPropagation();
            $submenu.find('li').removeClass('active');
            $(this).addClass('active');
        });

        $('.menu-toggle').on('click', function () {
            $('.primary-menu').toggleClass('active');
        });

        $(window).on('scroll', function () {
            if (lastClickedItem) {
                showSubmenu(lastClickedItem);
            }
        });

        window.addEventListener('DOMContentLoaded', () => {
            const currentPath = window.location.pathname.toLowerCase();
            // Loop through all submenu links
            document.querySelectorAll(".sub-menu1 a").forEach(link => {
                const linkPath = link.getAttribute("href").toLowerCase();

                // Match current URL to menu link
                if (currentPath === linkPath) {
                    // Highlight the clicked submenu link
                    link.parentElement.classList.add("active");

                    // Get the submenu's parent container
                    const submenu = link.closest(".sub-menu");
                    $("#page_title_name").text(link.innerText);
                    if (submenu) {
                        const menuKey = submenu.querySelector(".submenu-header").id.replace(' ', '').replace(' ', '');
                        const parentMenu = document.querySelector(`.menu-item[data-menu="${menuKey}"]`);

                        if (parentMenu) {
                            parentMenu.classList.add("active");
                        }
                    }
                }
            });
        });

    });
</script>