    string _UserImg = HttpContext.Current.Session["photo"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string IsSettingFlag = HttpContext.Current.Session["IsSetting"].ToString();
    int empid = Convert.ToInt32(HttpContext.Current.Session["EmpId"]);
    int _hierchywis = Convert.ToInt32(HttpContext.Current.Session["Ishierchy"]);
    string _ddomain = "";
    string CompanyCode = HttpContext.Current.Session["cmpcode"].ToString();
    int _PlanId = Convert.ToInt32(HttpContext.Current.Session["PlanId"]);
    string _PlanExpDate = HttpContext.Current.Session["PlanExpDate"].ToString();
    string Empname = HttpContext.Current.Session["EmpName"] != null ? HttpContext.Current.Session["EmpName"].ToString() : string.Empty;
    int Is_Payroll = 0;

    MasterDataRestClient _objusedetails = new MasterDataRestClient();
    var _selectedUserMenu = _objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    RoleRightsMapping _obj = new RoleRightsMapping();
    _obj.RoleMenuData = _selectedUserMenu;
    foreach (RoleRightsMapping item in _obj.RoleMenuData)
    {
        if (item.OperationName == "Payroll" || item.OperationName == "Payroll Preparation")
        {
            Is_Payroll = 1;
        }
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
}
