                    var ParentMenu = selectedUserMenu.Where(m => m.ParentMenuId == 0).Select(m => new { m.OperationName, m.ImgClassName }).Distinct();

                    foreach (var item in ParentMenu)
                    {
                        <div id="sub_@item.OperationName.ToLower().Replace(" ","")" class="sub-menu" style="display:none;">
