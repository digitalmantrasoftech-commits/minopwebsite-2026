        function employeeNotifitriggerData(empid)
        {
        $.ajax({
            url: '@_webapiurl' + 'Alert/EmployeewiseTriggerNotificationGetAll?empid=' + empid,
            headers: { 'Authorization': '@_tokan' },
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data)
            {
                if (data != null && data.length > 0)
                {
                    // Example: set checkboxes based on returned data
                    $("#myteam").prop("checked", data[0].MyTeam);
                    $("#myshelf").prop("checked", data[0].Self);
                    $("#inapp").prop("checked", data[0].InAppNotification);
                    $("#email").prop("checked", data[0].Email);
                    $("#push").prop("checked", data[0].PushNotification);
                    $("#message").prop("checked", data[0].Message);

                    $("#inapp").bootstrapSwitch('state', data[0].InAppNotification, true);
                    $("#email").bootstrapSwitch('state', data[0].Email, true);
                    $("#push").bootstrapSwitch('state', data[0].PushNotification, true);
                    $("#message").bootstrapSwitch('state', data[0].Message, true);
                    // update global object
                    notificationSettings =
                    {
                        EmployeeId: empid,
                        MyTeam: data[0].MyTeam,
                        Self: data[0].Self,
                        InAppNotification: data[0].InAppNotification,
                        Email: data[0].Email,
                        PushNotification: data[0].PushNotification,
                        Message: data[0].Message
                    };
                }
            },
            error: function (xhr, status, error)
            {
                console.error("Failed to load notification settings:", error);
            }
        });
     }

</script>

<script>
    $(document).ready(function () {

        // Menu click animation loading progress bar code
        //$('.sub-menu1 li').on('click', function (e) {
