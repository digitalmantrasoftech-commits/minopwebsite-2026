                                        if (itemSub.ActionUrl == "/Utilities/ViewCustomforms")
                                        {
                                            <li>
                                                <a href="javascript:void(0);" onclick="Test('@itemSub.OperationName')">
                                                    <div class="@itemSub.ImgClassName"></div>@itemSub.OperationName
                                                </a>
                                            </li>

                                        }
                                        else if (itemSub.ActionUrl == "/Report/DynamicReportTemplate")
