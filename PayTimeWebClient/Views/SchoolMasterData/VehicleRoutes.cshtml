@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
	ViewBag.Title = "VehicleRoute";
	Layout = "~/Views/Shared/_Layout.cshtml";
	int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
	string _token = HttpContext.Current.Session["tokan"].ToString();
	string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
	MasterDataRestClient objusedetails = new MasterDataRestClient();
	var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
	string action = ViewContext.RouteData.GetRequiredString("action");
	string Controller = ViewContext.RouteData.GetRequiredString("Controller");
	string actionurl = "/" + Controller + "/" + action;
	RoleRightsMapping obj = new RoleRightsMapping();
	obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
	string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
	foreach (RoleRightsMapping item in obj.RoleMenuData)
	{
		obj = item;
	}
}

<style>
    .modal.in .modal-dialog {
        width: inherit !important;
        height: inherit !important;
    }
</style>

<div class="page-bar">
	<ul class="page-breadcrumb">
		<li>
			<a href="/School/AdminDashboard">Home</a>
			<i class="fa fa-circle"></i>
		</li>
		<li>
			<span>VehicleRoute</span>
		</li>
	</ul>
	<div class="page-toolbar">
		@if (obj.CanAdd && Convert.ToInt32(Session["IsSchool"]) == 1)
		{
			<div class="">
                <a href="#" id="btnadd" class="btn btn-sm blue" style="float:right"> <i class="fa fa-plus"></i> Add Route</a>
			</div>
		}
	</div>
</div>
<h1 class="page-title">
	<small></small>
</h1>

@if (obj.CanView && Convert.ToInt32(Session["IsSchool"]) == 1)
{
	<div class="row">
		<div class="col-md-12">
			<div class="portlet ">
				<div class="portlet-body">
					<div>
						<table id="tblVehicleRouteMaster" class="table table-striped table-bordered table-hover table-checkable order-column">
							<thead>
								<tr>
									<th>Sr. No</th>
									<th hidden>Route ID</th>
									<th hidden>Vehicle ID</th>
									<th hidden>shift ID</th>
									<th>Route Name</th>
									<th>Vehicle Number</th>
									<th>Route Start</th>
									<th>Route End</th>
									<th hidden>Route Startloc</th>
									<th hidden>Route Endloc</th>
									<th>Route Type</th>
									<th>Shift</th>
									<th>Start time</th>
									<th>End time</th>
									<th hidden>Driverid</th>
									<th hidden>add1</th>
									<th hidden>add2</th>
									<th>Action</th>
								</tr>
							</thead>
						</table>
					</div>
					<div id="ajax_loaderbranch" class="modal_bg loading" aria-hidden="true">
						<img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
					</div>
					<div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
						<div class="modal-dialog">
							<!-- Modal content-->
							<div class="modal-content">
								<div class="modal-header">
									<button type="button" class="close" data-dismiss="modal">&times;</button>
									<h4 class="modal-title">Vehicle Route</h4>
								</div>
								<div class="modal-body">
									@Html.Partial("_RouteMaps")
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
else
{
	<span style="color:red">Unauthorized Access.</span>
}
<script src="~/LandingAssets/js/jquery.smartWizard.min.js"></script>
<script type="text/javascript">
	var map, marker, infoWindow, pos, geocoder, placeId, request;
	var busstoparray = [];
	var busstoparrayedit = [];
	var markers = [];
	var waypts = [];
	//var labelIndex = 0;
	$(document).ready(function () {

		var t = $('#tblVehicleRouteMaster').DataTable(
		{
			"processing": true,
			"ajax": {
				url: '@_webapiurl' + 'SchoolMaster/RouteGetAll',
				type: "GET",
				headers: { 'Authorization': '@_token' },
				dataSrc: '',
			},
			"columns": [
				{ "data": null },
				{ "data": "RouteId" },
				{ "data": "VehicleId" },
				{ "data": "Shiftid" },
				{ "data": "RouteCode" },
				{ "data": "VehicleNo" },
				{ "data": "RouteStartPlace" },
				{ "data": "RouteEndNamePlace" },
				{ "data": "RouteStart" },
				{ "data": "RouteEnd" },
				{ "data": "Routetype" },
				{ "data": "ShiftName" },
				{ "data": "Starttime" },
				{ "data": "Endtime" },
				{ "data": "DriverId" },
				{ "data": "RouteStartName" },
				{ "data": "RouteEndName" },
			],
			"columnDefs": [
				{
					"targets": [1, 2, 3, 8, 9,14,15,16],
					"visible": false
				},
				{
					"targets": 17,
					"data": null,
					"render": function (data, type, full, meta) {
						if ('@obj.CanEdit.ToString()' == 'True') {
							data = "<a class='editclass btn btn-xs blue tooltips' title='Edit'><i class='fa fa-edit'></i></a";
						}
						else {
							data = "";
						}
						return data;
					}
				},
				{
					"searchable": false,
					"orderable": false,
					"targets": 0
				}
			],
			"order": [[1, 'asc']],
		}
		);
		t.on('order.dt search.dt', function () {
			t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
				cell.innerHTML = i + 1;
			});
		}).draw();

		$("#btnadd").on('click', function () {

		    Addedit();

			$("#btnadd").attr("data-toggle", "modal");
			$("#btnadd").attr("data-target", "#frmpopup");

		});

		$("#tblVehicleRouteMaster").on('click', '.editclass', function () {
		    Addedit();
			$(".editclass").attr("data-toggle", "modal");
			$(".editclass").attr("data-target", "#frmpopup");
		});


		function Addedit() {
		    frmclear();

		    fillVehicledll();
		    fillDriverdll();
		    fillShiftdll();
		    
		    var rid = 0;

		    $("#hdnrtid").val(t.row(rid).data().RouteId);
		    var _VehicleId = t.row(rid).data().VehicleId;
		    var _Shiftid = t.row(rid).data().Shiftid;
		    var _DriverId = t.row(rid).data().DriverId;
		    fillVehicledll(_VehicleId);
		    fillDriverdll(_DriverId);
		    fillShiftdll(_Shiftid);

		    $("#RouteCode").val(t.row(rid).data().RouteCode);
		    $('#searchboxinput').val(t.row(rid).data().RouteStartName);
		    $('#searchboxinput1').val(t.row(rid).data().RouteEndName);
		    $("#hdnfrm").val(t.row(rid).data().RouteStart);
		    $("#hdnto").val(t.row(rid).data().RouteEnd);
		    $('#Routetype').val(t.row(rid).data().Routetype);
		    $('#Starttime').val(t.row(rid).data().Starttime);
		    $('#Endtime').val(t.row(rid).data().Endtime);

		    fillBusstoplist($("#hdnrtid").val());
		    
		    
		}

		

		function Savedata() {
			var _Routeid = $("#hdnrtid").val();

			var obj = {
				RouteId: _Routeid,
				VehicleId: $('#VehicleId').val(),
				RouteCode: $("#RouteCode").val(),
				RouteStart: $("#hdnfrm").val(),
				RouteEnd: $('#hdnto').val(),
				RouteStartname: $('#searchboxinput').val(),
				RouteEndname: $('#searchboxinput1').val(),
				Routetype: $('#Routetype').val(),
				Shiftid: $('#Shiftid').val(),
				Starttime: $('#Starttime').val(),
				Endtime: $('#Endtime').val(),
				DriverId: $('#DriverId').val(),
				busstop: busstoparray
			};

			if (_Routeid == "0") {

				$.ajax({
					type: "POST",
					headers: { 'Authorization': '@_token' },
					url: '@_webapiurl' + 'SchoolMaster/RouteCreate',
					data: JSON.stringify(obj),
					contentType: "application/json; charset=utf-8",
					dataType: "json",
					success: function (response) {
						if (response != null) {
							$("<div class='alert alert-success overlay'><label>" + response.Msg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
							$('#tblVehicleRouteMaster').DataTable().ajax.reload();
							$('#frmpopup').modal('toggle');
						} else {
							$("<div class='alert alert-danger overlay'><label>Successfully route created.</label></div>").insertBefore(".portlet-body").fadeOut(3000);
							$('#tblVehicleRouteMaster').DataTable().ajax.reload();
							$('#frmpopup').modal('toggle');
						}
					},
					error: function (response) {
						if (response != null) {
							var obj = JSON.parse(response.responseText);

							if (obj.MsgSts == 'error') {
								$("<div class='alert alert-danger overlay'><label>" + obj.Msg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
								$('#tblVehicleRouteMaster').DataTable().ajax.reload();
								$('#frmpopup').modal('toggle');
							}
						}
					}
				});
			}
			else {
				$.ajax({
					type: "POST",
					headers: { 'Authorization': '@_token' },
					url: '@_webapiurl' + 'SchoolMaster/RouteUpdate',
					data: JSON.stringify(obj),
					contentType: "application/json; charset=utf-8",
					dataType: "json",
					success: function (response) {
						if (response != null) {
							$("<div class='alert alert-success overlay'><label>" + response.Msg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
							$('#tblVehicleRouteMaster').DataTable().ajax.reload();
							$('#frmpopup').modal('toggle');
						} else {
							$("<div class='alert alert-danger overlay'><label>Successfully route updated.</label></div>").insertBefore(".portlet-body").fadeOut(3000);
							$('#tblVehicleRouteMaster').DataTable().ajax.reload();
							$('#frmpopup').modal('toggle');
						}
					},
					error: function (response) {
						if (response != null) {
							var obj = JSON.parse(response.responseText);

							if (obj.MsgSts == 'error') {
								$("<div class='alert alert-danger overlay'><label>" + obj.Msg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
								$('#tblVehicleRouteMaster').DataTable().ajax.reload();
								$('#frmpopup').modal('toggle');
							}
						}
					}
				});

			}
		}

		function frmclear() {

			$("#hdnrtid").val(0);
			$('#VehicleId').val(0);
			$("#RouteCode").val('');
			$("#hdnfrm").val('');
			$('#hdnto').val('');
			$('#searchboxinput').val('');
			$('#searchboxinput1').val('');

			$('#smartwizard').smartWizard("reset");

			$("#RouteCode").removeClass('field_error');
			$("#Shiftid").removeClass('field_error');
			$("#VehicleId").removeClass('field_error');
			$("#Starttime").removeClass('field_error');
			$("#Endtime").removeClass('field_error');
			$("#DriverId").removeClass('field_error');

			markers = [];
			waypts = [];
			busstoparray = [];
			//busstoparrayedit = [];
			//$('#tblbusstopbody').empty();

			//document.getElementById('total').innerHTML = '0 km';
			//document.getElementById('totaldu').innerHTML = '0 min';

			//labelIndex = 0;

		}

		function fillDriverdll(selectedid) {
			$('#DriverId').empty();
			$.ajax(
			 {
				 type: "GET",
				 headers: { 'Authorization': '@_token' },
			     url: '@_webapiurl' + "/SchoolMaster/GetAllActiveDriver",
				 contentType: "application/json; charset=utf-8",
				 dataType: "json",
				 beforeSend: function () {
				 },
				 success: function (data) {
					 if (data.isRedirect) {
						 window.location.href = data.redirectUrl;
					 }
					 $("#DriverId").append("<option value='0'>Select Driver</option>");
					 for (var x = 0; x < data.length; x++) {
						 $("#DriverId").append("<option value=" + data[x].DriverId + ">" + data[x].DriverName + "</option>");
					 }
					 $("#DriverId option[value = '" + selectedid + "' ]").prop('selected', true);
				 },
				 error: function (jqXHR, ajaxOptions, thrownError) {
				     if (jqXHR.status == 500) { //InternalServerError = 500,
				         toastr.error("InternalServerError");
				     } else if (jqXHR.status == 400) { //BadRequest = 400,
				         toastr.error("BadRequest");
				     } else if (jqXHR.status == 401) {
				         window.location.href = "/PayTime/LoginPage";
				     }
				 }
			 });
		}


		function fillShiftdll(selectedid) {
			$('#Shiftid').empty();
			$.ajax(
			 {
				 type: "GET",
				 headers: { 'Authorization': '@_token' },
				 url: '@_webapiurl' + "Master/ShiftMasterGetAll",
				 contentType: "application/json; charset=utf-8",
				 dataType: "json",
				 beforeSend: function () {
				 },
				 success: function (data) {
					 if (data.isRedirect) {
						 window.location.href = data.redirectUrl;
					 }
					 $("#Shiftid").append("<option value='0'>Select Shift</option>");
					 for (var x = 0; x < data.length; x++) {
						 $("#Shiftid").append("<option value=" + data[x].ShiftId + ">" + data[x].ShiftName + "</option>");
					 }
					 $("#Shiftid option[value = '" + selectedid + "' ]").prop('selected', true);
				 },
				 error: function (jqXHR, ajaxOptions, thrownError) {
				     if (jqXHR.status == 500) { //InternalServerError = 500,
				         toastr.error("InternalServerError");
				     } else if (jqXHR.status == 400) { //BadRequest = 400,
				         toastr.error("BadRequest");
				     } else if (jqXHR.status == 401) {
				         window.location.href = "/PayTime/LoginPage";
				     }
				 }
			 });
		}

		function fillVehicledll(selectedVehicleid) {
			$('#VehicleId').empty();
			$.ajax(
			 {
				 type: "GET",
				 headers: { 'Authorization': '@_token' },
				 url: '@_webapiurl' + "/SchoolMaster/GetAllActiveVehicle",
				 contentType: "application/json; charset=utf-8",
				 dataType: "json",
				 beforeSend: function () {
				 },
				 success: function (data) {
					 if (data.isRedirect) {
						 window.location.href = data.redirectUrl;
					 }
					 $("#VehicleId").append("<option value='0'>Select Vehicle</option>");
					 for (var x = 0; x < data.length; x++) {
						 $("#VehicleId").append("<option value=" + data[x].VehicleId + ">" + data[x].VehicleNo + "</option>");
					 }
					 $("#VehicleId option[value = '" + selectedVehicleid + "' ]").prop('selected', true);
				 },
				 error: function (jqXHR, ajaxOptions, thrownError) {
				     if (jqXHR.status == 500) { //InternalServerError = 500,
				         toastr.error("InternalServerError");
				     } else if (jqXHR.status == 400) { //BadRequest = 400,
				         toastr.error("BadRequest");
				     } else if (jqXHR.status == 401) {
				         window.location.href = "/PayTime/LoginPage";
				     }
				 }
			 });
		}


	    function fillBusstoplist(Routeid) {
	        //busstoparrayedit = [];
	        $('#tblbusstopbody').empty();
			$.ajax({
				type: "POST",
				headers: { 'Authorization': '@_token' },
				url: '@_webapiurl' + "/SchoolMaster/GetBusStopByRoute?id=" + Routeid,
				contentType: "application/json; charset=utf-8",
				dataType: "json",
				success: function (response) {
					if (response != null) {
					    for (var i = 0; i < response.length; i++) {
					        var cnt = i + 1;
					        $('#tblbusstopbody').append('<tr id="rw"+' + cnt + '"><td>' + cnt + '</td><td>' + response[i].Busstopname + '</td></tr>')
						}
					}
				}
			});
		}

		// Step show event
		$("#smartwizard").on("showStep", function (e, anchorObject, stepNumber, stepDirection, stepPosition) {
			if (stepPosition === 'first') {
				$("#prev-btn").addClass('disabled');
				$("#btnfin").hide();
			} else if (stepPosition === 'final') {
				$("#next-btn").addClass('disabled');
				$("#btnfin").show();
			} else {
				$("#btnfin").hide();
				$("#prev-btn").removeClass('disabled');
				$("#next-btn").removeClass('disabled');
			}
		});

		$("#smartwizard").on("leaveStep", function (e, anchorObject, stepNumber, stepDirection) {

			if (stepNumber == 0) {
				var res = validateSteps(stepNumber);
				if (res == true) {

				    //alert($("#hdnrtid").val());

				    var locroute = '../Content/images/DubaiRoute.jpg';
				    var RouteWithbusstop = '../Content/images/RouteWithbusstop.jpg';
				   
				    if ($("#hdnrtid").val() == "0") {
				        
				        $('#maproute').attr("src", locroute);
						//if (navigator.geolocation) {
						//	navigator.geolocation.getCurrentPosition(function (position) {
						//		pos = {
						//			lat: position.coords.latitude,
						//			lng: position.coords.longitude
						//		};
						//		initMap(pos);
						//	}, function () {
						//		handleLocationError(true, infoWindow, map.getCenter());
						//	});
						//} else {
						//	// Browser doesn't support Geolocation
						//	handleLocationError(false, infoWindow, map.getCenter());
						//}
					}
					else {
				        $('#maproute').attr("src", locroute);
						//if (navigator.geolocation) {
						//	navigator.geolocation.getCurrentPosition(function (position) {
						//		pos = {
						//			lat: position.coords.latitude,
						//			lng: position.coords.longitude
						//		};

						//		EditinitMap();

						//	});
						//} else {
						//	// Browser doesn't support Geolocation
						//	handleLocationError(false, infoWindow, map.getCenter());
						//}

					}

				}
				return res;
			}
			if (stepNumber == 1) {
			    $('#Busstop').attr("src", RouteWithbusstop);
			}
		});


		// Your Step validation logic
		function validateSteps(stepnumber) {
			var isStepValid = true;
			if (stepnumber == 0) {
				if ($("#RouteCode").val() == "") {
					$("#RouteCode").addClass('field_error');
					$("#RouteCode").focus();
					isStepValid = false;
				}

				if ($("#Shiftid").val() == "0") {
					$("#Shiftid").addClass('field_error');
					$("#Shiftid").focus();
					isStepValid = false;
				}

				if ($("#VehicleId").val() == "0") {
					$("#VehicleId").addClass('field_error');
					$("#VehicleId").focus();
					isStepValid = false;
				}

				if ($("#Starttime").val() == "") {
					$("#Starttime").addClass('field_error');
					$("#Starttime").focus();
					isStepValid = false;
				}

				if ($("#Endtime").val() == "") {
					$("#Endtime").addClass('field_error');
					$("#Endtime").focus();
					isStepValid = false;
				}

				if ($("#DriverId").val() == "0") {
					$("#DriverId").addClass('field_error');
					$("#DriverId").focus();
					isStepValid = false;
				}

			}



			return isStepValid;
		}
		// Toolbar extra buttons
		var btnFinish = $('<button id="btnfin" style="display:none"></button>').text('Finish')
						 .addClass('btn btn-info')
						 .on('click', function () {
						     $("<div class='alert alert-success overlay'><label>Successfully route created.</label></div>").insertBefore(".portlet-body").fadeOut(3000);
						     $('#tblVehicleRouteMaster').DataTable().ajax.reload();
						     $('#frmpopup').modal('toggle');
							 //Savedata();
						 });
		// Smart Wizard
		$('#smartwizard').smartWizard({
			selected: 0,
			theme: 'default',
			transitionEffect: 'fade',
			showStepURLhash: false,
			useURLhash: false,
			toolbarSettings: {
				toolbarPosition: 'bottom',
				toolbarExtraButtons: [btnFinish]
			}

		});

	});
</script>