@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models
@{
    ViewBag.Title = "TrasactionData";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = string.Empty;
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
}

<script type="text/javascript">
    var schoolid = '@_companyid';
    var emprole = '@_RoleId';
    var stdid = 0;
    var fdate = '';
    var tdate = '';
    var _url = '';

    $(document).ready(function () {

        fillSchooldll(0);
        //fillClassdll(0);
        //$('#ClassId').val(0);





        $("#SchoolId").change(function () {
            if ($("#SchoolId").val() != "0") {
                // alert($("#SchoolId").val());
                //$("#select2-SchoolId-container").removeClass('field_error');
                fillClassdll($("#SchoolId").val());
                

            }
        });

        //$("#ClassId").change(function () {
        //    if ($("#ClassId").val() != "0") {
        //        //$("#select2-ClassId-container").removeClass('field_error');
        //    }
        //});

        $('#FilterFromDate').change(function () {
            $("#FilterToDate").val("");
            var fromDate = $("#FilterFromDate").val();
            var i = "";
            var k = "";
            var newdate = new Date(fromDate);
            if (newdate.getMonth() <= 8) {
                i = "0" + (newdate.getMonth() + 1);
            }
            else {
                i = (newdate.getMonth() + 1);
            }
            if (newdate.getDate() < 10) {
                k = "0" + (newdate.getDate());
            }
            else {
                k = (newdate.getDate());
            }

            $("#FilterToDate").val(newdate.getFullYear() + "-" + i + "-" + k);
            $('#FilterToDate').datepicker("remove");
            $("#FilterToDate").datepicker({
                startDate: newdate,
                autoclose: true,
                endDate: '+0d',
                format: "yyyy-mm-dd",
            }).on('changeDate', function (ev) {
                $("#FilterToDate").removeClass('field_error');
                var fromDate = $("#FilterFromDate").val();
                var toDate = $("#FilterToDate").val();
            }).data('datepicker');

        });


        $("#btntransdata").click(function () {
            //var _sid = $('#SchoolId').val();
            //var _stdid = $('#ClassId').val();
            //var _fdate = $('#FilterFromDate').val();
            //var _tdate = $('#FilterToDate').val();
            var flg = true;
            //if ($('#SchoolId').val() == '0') {
            //    $("#select2-SchoolId-container").addClass('field_error');
            //    flg = false;
            //}
            //else {
            //    $("#select2-SchoolId-container").removeClass('field_error');
            //}

            //if ($('#ClassId').val() == "0") {
            //    $("#select2-ClassId-container").addClass('field_error');
            //    flg = false;
            //}
            //else {
            //    $("#select2-ClassId-container").removeClass('field_error');
            //}

            if ($('#FilterFromDate').val() == "") {
                $("#FilterFromDate").addClass('field_error');
                flg = false;
            }
            else {
                $("#FilterFromDate").removeClass('field_error');
            }
            if ($('#FilterToDate').val() == "") {
                $("#FilterToDate").addClass('field_error');
                flg = false;
            }
            else {
                $("#FilterToDate").removeClass('field_error');
            }
            if (flg) {
                filltable();
            }
        });

    });
    function filltable() {
        var _sid = $('#SchoolId').val();
        var _stdid = $('#ClassId').val();
        var _fdate = $('#FilterFromDate').val();
        var _tdate = $('#FilterToDate').val();

        if ($("#select2-ClassId-container")[0].title == "Select Class") {
            _stdid = 0;
        }

        var _url = '@_webapiurl' + 'SchoolMaster/SchooltrasactiondataAllbyschoolstddate?sid=' + _sid + '&stdid=' + _stdid + '&fromdt=' + _fdate + '&todate=' + _tdate + '';
        
       
        var t = $('#tbltrasactiondata').DataTable(
         {
             "processing": true,
             "ajax": {
                 url: _url,
                 type: "GET",
                 headers: { 'Authorization': '@_tokan' },
                 dataSrc: '',
             },
             "columns": [
                { "data": null },
                { "data": "StudentPunchId", },
                { "data": "TagID", },
                { "data": "StudentName" },
                { "data": "AttnDate" },
                { "data": "InOutTime" },
                { "data": "MsgStatus" }
             ],
             "dom": 'Bflrtip',
             "bDestroy":true,
             "buttons": [
                {
                    title: '',
                    extend: 'excelHtml5',
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6]
                    },
                },
             ],
             "columnDefs": [
                 {
                     "searchable": true,
                     "orderable": true,
                     "targets": [1, 2, 3, 4, 5, 6]
                 }
             ]
             //"order": [[1, 'asc']],
         });

        t.on('order.dt search.dt', function () {
            t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();

        $.fn.dataTable.ext.errMode = 'throw';
    }

    function fillSchooldll(selectedschool) {
        var _url = '@_webapiurl' + 'Master/CompanyGetAll'
        if (emprole == '6805') {
            _url = '@_webapiurl' + 'Master/CompanyGetById?id=' + schoolid;
        }
        $('#SchoolId').empty();
        $.ajax(
            {
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: _url,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                },
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    $("#SchoolId").append("<option value='0'>Select School</option>");
                    for (var x = 0; x < data.length; x++) {
                        $("#SchoolId").append("<option value=" + data[x].CompanyID + ">" + data[x].CompanyName + "</option>");
                    }
                    $("#SchoolId option[value = '" + selectedschool + "' ]").prop('selected', true);

                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
    }

    function fillClassdll(selectedschool) {

        var _urlbr = '@_webapiurl' + 'Master/BranchGetAllbycmp?id=' + selectedschool;
        $('#ClassId').empty();
        $.ajax(
            {
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: _urlbr,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                },
                success: function (data) {
                    
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    $("#ClassId").append("<option value='0'>Select class</option>");
                    for (var x = 0; x < data.length; x++) {
                        $("#ClassId").append("<option value=" + data[x].BranchId + ">" + data[x].branchname + "</option>");
                    }
                    // $("#ClassId option[value = '" + selectedClass + "' ]").prop('selected', true);
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
    }


</script>
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/School/AdminDashboard">Home</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>Transaction Data</span>
        </li>
    </ul>
</div>
<h1 class="page-title">
    <small></small>


</h1>
@if (obj.CanView && Convert.ToInt32(Session["IsSchool"]) == 1)
{
    <div class="row">
        <div class="col-md-12">
            <div class="portlet ">
                <div class="portlet-title">
                    <div class="alert alert-success display-none">
                        <a href="/Utilities/ProcessMaster" class="close" data-dismiss="alert">&times;</a>
                        <strong id="strstg">Success ! </strong> @_Message
                    </div>
                    <div class="alert alert-danger cance display-none">
                        <a href="/Utilities/ProcessMaster" class="close" data-dismiss="alert">&times;</a>
                        <strong id="strstg1">Error ! </strong> @_error
                    </div>
                    <div class="row margin-top-15">
                        <div class="col-md-3">
                            <div class="form-group ">
                                @Html.DropDownList("SchoolId", new SelectList(new[] { "" }), "Select School", new { @class = "form-control input-sm select2" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group ">
                                @Html.DropDownList("ClassId", new SelectList(new[] { "" }),"Select Class", new { @class = "form-control input-sm select2" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="input-group  date date-picker" data-date-format="yyyy-mm-dd" data-date-end-date="0d" data-date-viewmode="years">
                                <span class="input-group-btn">
                                    <button class="btn default btn-sm" type="button">
                                        <i class="fa fa-calendar"></i>
                                    </button>
                                </span>
                                <input type="text" placeholder="From Date" id="FilterFromDate" class="form-control input-sm">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="input-group  date" data-date-format="yyyy-mm-dd" data-date-viewmode="years">
                                <span class="input-group-btn">
                                    <button class="btn default btn-sm" type="button">
                                        <i class="fa fa-calendar"></i>
                                    </button>
                                </span>
                                <input type="text" placeholder="To Date" id="FilterToDate" class="form-control input-sm">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div id='ajax_loaderCompany' class="modal_bg loading">
                                <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
                            </div>
                        </div>
                        @if (obj.CanAdd)
                        {
                            <div class=" col-md-2">
                                <a href="#" id="btntransdata" class="btn blue btn-sm" data-toggle="modal" style="float:right"> <i class="fa fa-edit"></i> Show Transaction </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="portlet-body">
                    <div>
                        <div class="editor-field form-group" id="divSchoolId">

                        </div>

                        <div class="editor-field form-group" id="divClassId">

                        </div>
                    </div>
                    <div>
                        <table id="tbltrasactiondata" class="table table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    <th>Sr. No</th>
                                    <th>Student PunchId</th>
                                    <th>Student TagId</th>
                                    <th>Student Name</th>
                                    <th>Attendance Date</th>
                                    <th>Attendance Time</th>
                                    <th>Mode</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
