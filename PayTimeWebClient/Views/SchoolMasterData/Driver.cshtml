                                                        <textarea id="PermanentAddress" class="form-control input-sm" name="PermanentAddress" rows="5" placeholder="Enter Permanent Address" maxlength="150" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')"></textarea>
