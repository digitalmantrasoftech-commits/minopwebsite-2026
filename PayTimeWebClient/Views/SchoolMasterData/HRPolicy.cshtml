                    $("#MaxOutDur").val(obj.MaxOutDur);
                    $("#TimeBetPunch").val(obj.TimeBetPunch);
                    $("#GraceLateIN").val(obj.GraceLateIN);
                    $("#GraceEarlyOUT").val(obj.GraceEarlyOUT);
                    $("#ApplicationMode").val(obj.ApplicationMode);
                    $("#MonthlyRptStaDay").val(obj.MonthlyRptStaDay);
                    $("#OTMinHour").val(obj.OTMinHour);
                    var OTFormula = obj.OTFormula;
                    if (OTFormula == 1) {
                        $("#WhSh").prop('checked', true);
                        $("#OTFormula").attr("value", 1);
                    }
                    else if (OTFormula == 2) {
                        $("#WhPh").prop('checked', true);
                        $("#OTFormula").attr("value", 2);
                    }
                    else if (OTFormula == 3) {
                        $("#AfEt").prop('checked', true);
                        $("#OTFormula").attr("value", 3);
                    }
