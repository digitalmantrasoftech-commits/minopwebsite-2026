        //});

        $("#tblEmp").empty();
        var bID = $("#ddlBranch").val();
        $.post("/Transactions/GetEnrollEmpByDept?departmentid=" + DeptIdlst + "&branchid=" + bID, function (response) {
            if (response.isRedirect) {
                window.location.href = response.redirectUrl;
            }
            var table = "";
            if (response != null) {
                for (var i = 0; i < response.length; i++) {

                    var tbl = "<tr class='odd gradeX'>";
