        $("#tbldevicemaster").on('click', '.inactiveclass', function () {

            var Deviceid = $(this).parent('td').parent('tr').children(1)[1].innerText;
            var DeviceSrNo = $(this).parent('td').parent('tr').children(1)[7].innerText;
            var isain = 0;
            var linkctl = $(this)[0].attributes[2].value;


            if (linkctl == "Active") {
                isain = 1;
            }

            var obj = {
                id: Deviceid,
                SrNo: DeviceSrNo,
                flg: isain
            };

            //alert(linkctl + '--' + Deviceid + '--' + DeviceSrNo);



            if (confirm("Are you sure for " + linkctl + " this Device?")) {
                $.ajax({
                    type: "POST",
                    url: '/MasterData/ActiveDeActiveDeviceMaster',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        $("<div class='alert alert-success overlay'><label>Device Successfully " + linkctl + ".</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                        location.reload();
                    },
                    error: function (response) {
                        if (response != null) {
                            var obj = JSON.parse(response.responseText);
                            if (obj.sts == 'error') {
                                $("<div class='alert alert-danger overlay'><label>something wrong occures.</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                location.reload();
                            }
                        }
                    }
                });

            }
        });

        $("#tbldevicemaster").on('click', '.deleteclass', function () {
            var flg = 0;
            if (confirm("Are you sure for Delete this Entry?")) {
                var did = $(this).parent('td').parent('tr').children(1)[1].innerText;
                $.post("/MasterData/DeleteDeviceMaster?id=" + did, function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var _response = $.parseJSON(response);
                    if (_response == "OK") {
                        //  alert("Record Deleted Successfully.");
                        _Message = "Record Deleted Successfully";
                        window.location.href = "/SchoolMasterData/Device/";
                    }
                    else {
                        alert("something wrong occures.");
                    }
                });
            }
        });
