                type: 'GET',
                url: "/MasterData/GetDevicebyId",
                data: { id: id },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result.isRedirect) {
                        window.location.href = result.redirectUrl;
                    }
                    var obj = JSON.parse(result);

                    $("#did").html(obj[0].DeviceId);
                    $("#dsr").html(obj[0].DeviceSrNo);
                    $("#dname").html(obj[0].DeviceName);
                    $("#dip").html(obj[0].DeviceIP);
                    $("#dport").html(obj[0].DevicePort);
                    $("#dmode").html(obj[0].Mode);
                    $("#dcode").html(obj[0].DeviceCode);
                    $("#dpassword").html(obj[0].DevicePassword);
                    $("#dtype").html(obj[0].DeviceType);
                    $("#dtypecode").html(obj[0].DeviceTypeCode);
                    if (obj[0].IsPushData == 1) {
                        $("#dispushdata").html("Yes");
                    }
                    else {
                        $("#dispushdata").html("No");
                    }

                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    $('.loading').hide();

