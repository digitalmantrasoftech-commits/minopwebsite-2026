                                lng: position.coords.longitude
                            };
                            initMap(pos);
                        }, function () {
                            pos = new google.maps.LatLng(parseFloat(23.0745648), parseFloat(72.52532870000005));
                            initMap(pos);
                        });
                    } else {
                        // Browser doesn't support Geolocation
                        alert('Browser doesn\'t support Geolocation');
                    }
                }
            });


        }
        function Getposlatlng(strlocation) {
            var input = strlocation.replace('(', '').replace(')', '');
            var latlngStr = input.split(',', 2)
            var latlng = new google.maps.LatLng(parseFloat(latlngStr[0]), parseFloat(latlngStr[1]));
            return latlng;
        }

