        }

       
        function validatesshifttime() {
            var tbl = $('#tblVehicleRouteMaster').DataTable();
            var data = tbl.rows().data();
            for (i = 0; i < data.length; i++) {
                if ($("#VehicleId").val() == data[i].VehicleId && (($("#Starttime").val() >= data[i].Starttime && $("#Starttime").val() <= data[i].Endtime) || ($("#Endtime").val() >= data[i].Starttime && $("#Endtime").val() <= data[i].Endtime))) {
                    alert('This time slot alredy exist on this vehicle');
                    $("#Starttime").val('');
                    $("#Starttime").focus();

                    $("#Endtime").val('');
                    break;
                    return false;
                }
            }
        }

        // Your Step validation logic
        function validateSteps(stepnumber) {
            var isStepValid = true;
            if (stepnumber == 0) {
                if ($("#RouteCode").val() == "") {
