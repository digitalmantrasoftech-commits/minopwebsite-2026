                    isStepValid = false;
                }
                else {
                    $("#Starttime").removeClass('field_error');
                }

                if ($("#Endtime").val() == "") {
                    $("#Endtime").addClass('field_error');
                    $("#Endtime").focus();
                    isStepValid = false;
                }
                else {
                    $("#Endtime").removeClass('field_error');
                }

                if ($("#DriverId").val() == "0") {
                    $("#DriverId").addClass('field_error');
                    $("#DriverId").focus();
                    isStepValid = false;
                }
                else {
                    $("#DriverId").removeClass('field_error');
                }

                if ($("#Schoolid").val() == "0") {
                    $("#Schoolid").addClass('field_error');
                    $("#Schoolid").focus();
                    isStepValid = false;
                }
                else {
                    $("#Schoolid").removeClass('field_error');
                }
                if ($("#Routetype").val() == "0") {
                    $("#Routetype").addClass('field_error');
                    $("#Routetype").focus();
                    isStepValid = false;
                }
                else {
                    $("#Routetype").removeClass('field_error');
                }

                var msg = validateTime();
                if (msg != "") {
                    alert(msg);
                    isStepValid = false;
                }
               
            }



            return isStepValid;
        }
