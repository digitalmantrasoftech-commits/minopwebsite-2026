        function validateTime() {
            var selectedshift = $("#Shiftid option:selected").text();
            var shifttime = selectedshift.substring(selectedshift.indexOf('(') + 1, selectedshift.indexOf(")"));
            var arshifttime = shifttime.split('-');
            var stime = arshifttime[0];
            var etime = arshifttime[1];
            var alertmessage = "";
            if ($("#Routetype").val() == 'Pickup') {

                if ($("#Endtime").val() > stime || stime < $("#Starttime").val()) {
                    $("#Starttime").addClass('field_error');
                    $("#Starttime").focus();
                    alertmessage = 'Route End Time should be less than shift start time and greater than Route start time';

                }
            }
            else if ($("#Routetype").val() == 'drop') {

                if ($("#Starttime").val() > etime || etime < $("#Endtime").val()) {
                    $("#Endtime").addClass('field_error');
                    $("#Endtime").focus();
                    alertmessage='Route End Time should be less than shift start time and greater than Route start time';
                }
            }
            if ($("#Starttime").val() == $("#Endtime").val()) {
                if ($("#Starttime").val('') != '' && $("#Endtime").val('')) {
                    $("#Starttime").addClass('field_error');
                    $("#Starttime").focus();
                    alertmessage+='\n Route duration should be atleast 15 minutes!';
                }
            }
            return alertmessage;
        }

       

