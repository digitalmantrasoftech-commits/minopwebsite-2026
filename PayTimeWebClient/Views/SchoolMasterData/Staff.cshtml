        $("#Name").keypress(function (evt) {
            $("#Name").removeClass('field_error');
            var k;
            if (evt.keyCode > 0) {
                k = evt.keyCode;
            }
            else if (typeof (evt.charCode) != "undefined") {
                k = evt.charCode;
            }
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57));
        });
        $("#SurName").keypress(function (evt) {
            $("#SurName").removeClass('field_error');
            var k;
            if (evt.keyCode > 0) {
                k = evt.keyCode;
            }
            else if (typeof (evt.charCode) != "undefined") {
                k = evt.charCode;
            }
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57));
        });
        $("#Speciality").keypress(function (evt) {
            $("#Speciality").removeClass('field_error');
            var k;
            if (evt.keyCode > 0) {
                k = evt.keyCode;
            }
            else if (typeof (evt.charCode) != "undefined") {
                k = evt.charCode;
            }
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
        });

        $("#tblStaffMaster").on('click', '.editclass', function () {




            $("#Email").removeClass('field_error');
            $("#Speciality").removeClass('field_error');
            $("#ContactNo").removeClass('field_error');
            $("#spscnt").hide();
            $("#Name").removeClass('field_error');
            $("#StaffId").val(t.row($(this).parent('td').parent('tr')).data()["StaffId"]);
            $("#SchoolId").val(t.row($(this).parent('td').parent('tr')).data()["SchoolId"]);
            $("#Name").val(t.row($(this).parent('td').parent('tr')).data()["Name"]);
            $("#SurName").val(t.row($(this).parent('td').parent('tr')).data()["SurName"]);
            $("#DateOfBirth").val(t.row($(this).parent('td').parent('tr')).data()["DateOfBirth"]);
            var DateOfBirth = t.row($(this).parent('td').parent('tr')).data()["DateOfBirth"];
            $("#DateOfBirth").datepicker({ format: 'yyyy/mm/dd' });
            $("#DateOfBirth").datepicker('setDate', new Date(DateOfBirth));
            var gender = t.row($(this).parent('td').parent('tr')).data()["Gender"];
            if (gender == false) {
                $("#GenderM").prop('checked', true);
            }
            if (gender == true) {
                $("#GenderF").prop('checked', true);
            }
            var married = t.row($(this).parent('td').parent('tr')).data()["IsMarried"];
            if (married == false) {
                $("#Empsingle").prop('checked', true);
            }
            else {
                $("#EmpMarried").prop('checked', true);
            }
            $("#ContactNo").val(t.row($(this).parent('td').parent('tr')).data()["ContactNo"]);
            $("#Email").val(t.row($(this).parent('td').parent('tr')).data()["Email"]);
            $("#Address").val(t.row($(this).parent('td').parent('tr')).data()["Address"]);
            $("#Speciality").val(t.row($(this).parent('td').parent('tr')).data()["Speciality"]);
            $("#Salary").val(t.row($(this).parent('td').parent('tr')).data()["Salary"]);
            $("#Punchid").val(t.row($(this).parent('td').parent('tr')).data()["Punchid"]);
            $("#StaffTypeId").val(t.row($(this).parent('td').parent('tr')).data()["StaffTypeId"]);
            $("#ReportingTo").val(t.row($(this).parent('td').parent('tr')).data()["ReportingTo"]);
            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");
            fillSchooldll(t.row($(this).parent('td').parent('tr')).data()["SchoolId"]);
            fillReportingTodll(t.row($(this).parent('td').parent('tr')).data()["ReportingTo"]);
            fillStaffTypedll(t.row($(this).parent('td').parent('tr')).data()["StaffTypeId"]);
            //fillSchooldll();
            //fillReportingTodll();
            //fillStaffTypedll();
        });

        $("#Name").blur(function () {
            var name = $("#Name").val();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "/SchoolMaster/GetstafftypeName?name=" + name,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    if (data != null && data.length > 0) {
                        if (data[0]["name"] == name) {
                            $("#spschnme").html("Staff name must be Unique.").show();
                            $("#Name").val("");
                            $("#Name").focus();
                            $("#Name").addClass('field_error');
                            return false;
                        }
                        else {
                            $("#Name").removeClass('field_error');
                            $("#spschnme").hide();
                            return true;
                        }
                    }
                    else {
                        $("#spschnme").hide();
                    }

                }
            });

        });
        $("#Email").change(function () {
            var filter = new RegExp(/^[_A-Za-z0-9-]+(\.[_A-Za-z0-9-]+)*@@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*(\.[A-Za-z]{2,4})$/);
            if (!filter.test($("#Email").val())) {
                $("#spscheml").html("Please Enter Valid Email ID.").show();
                $("#Email").val("");
                $("#Email").focus();
                $("#Email").addClass('field_error');
                return false;
            }
            var email = $("#Email").val();
            //$.get(url, { email: email }, function (data) {
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "/SchoolMaster/GetEmail?email=" + email,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    if (data != null && data.length > 0) {
                        if (data[0]["email"] == email) {
                            $("#spscheml").html("Email ID must be Unique.").show();
                            $("#Email").val("");
                            $("#Email").focus();
                            $("#Email").addClass('field_error');
                            return false;
                        }
                        else {
                            $("#Email").removeClass('field_error');
                            $("#spscheml").hide();
                            return true;
                        }
                    }
                    else {
                        $("#spscheml").hide();
                    }

                }
            });

        });
        $("#ContactNo").blur(function () {
            var inputStr = $("#ContactNo").val();
            if (inputStr.length < 8) {
                $("#spscnt").html("Please enter atleast 8 number.").show();
                $("#ContactNo").val("");
                $("#ContactNo").focus();
                $("#ContactNo").addClass('field_error');
                //$("#spscnt").html("enter atleast 5 chars in the input box");
            }
            else {
                $("#ContactNo").removeClass('field_error');
                $("#spscnt").hide();
                return true;
            }
        });
        $("#ContactNo").keypress(function (e) {
            if (this.value.length == 0 && e.which == 48) {
                return false;
            }
        });
        $("#Punchid").blur(function () {
            var punchid = $("#Punchid").val();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: "/MasterData/GetEmployeePunchId?EmpPunchID=" + punchid,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    if (data != null && data.length > 0) {
                        var obj = JSON.parse(data);
                        if (obj == "1") {
                            $("#sppunch").html("PunchID must be Unique.").show();
                            $("#Punchid").val("");
                            $("#Punchid").focus();
                            $("#Punchid").addClass('field_error');
                            return false;
                        }
                        else {
                            $("#Punchid").removeClass('field_error');
                            $("#sppunch").hide();
                            return true;
                        }
                    }
                    else {
                        $("#sppunch").hide();
                    }

                }
            });

        });
    });
    function frmClear() {
        $("#StaffId").val(0);
        $("#Name").val("");
        $("#Name").attr("placeholder", "Enter first name");
        $("#Name").removeClass('field_error');
        $("#Email").val("");
        $("#Email").attr("placeholder", "Enter staff email");
        $("#Email").removeClass('field_error');
        $("#SurName").val("");
        $("#SurName").attr("placeholder", "Enter Last Name");
        $("#SurName").removeClass('field_error');
        $("#ContactNo").val("");
        $("#ContactNo").attr("placeholder", "Enter Contact Number");
        $("#ContactNo").removeClass('field_error');
        $("#spscnt").hide();
        $("#Address").val("");
        $("#Address").attr("placeholder", "Enter Address");
        $("#Address").removeClass('field_error');
        $("#Speciality").val("");
        $("#Speciality").attr("placeholder", "Enter Speciality");
        $("#Speciality").removeClass('field_error');
        $("#Salary").val("");
        $("#Salary").attr("placeholder", "Enter Salary");
        $("#Salary").removeClass('field_error');
        $("#Punchid").val("");
        $("#Punchid").attr("placeholder", "Enter Punch Id");
        $("#Punchid").removeClass('field_error');
        $("#spschnme").hide();
        $("#GenderM").prop('checked', true);
        $("#Empsingle").prop('checked', true);
        $("#DateOfBirth").attr('data-date', Date.now);
        $("#DateOfBirth").val("");
    }

    function fillSchooldll(selectedSchoolid) {
        $('#SchoolId').empty();

        var _url = '@_webapiurl' + 'Master/CompanyGetAll'
        if (emprole == '6805') {
            _url = '@_webapiurl' + 'Master/CompanyGetById?id=' + schoolid;
        }
        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             //url: '@_webapiurl' + "/SchoolMaster/SchoolGetAll",
             url: _url,
             contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 $("#SchoolId").append("<option value='0'>Select School</option>");
                 for (var x = 0; x < data.length; x++) {
                     $("#SchoolId").append("<option value=" + data[x].CompanyID + ">" + data[x].CompanyName + "</option>");
                 }
                 $("#SchoolId option[value = '" + selectedSchoolid + "' ]").prop('selected', true);
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }
    function fillReportingTodll(selectedReportingTo) {
        $('#ReportingTo').empty();

        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             url: _url,
             contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 $("#ReportingTo").append("<option value='0'>Select Reporting To</option>");
                 for (var x = 0; x < data.length; x++) {
                     $("#ReportingTo").append("<option value=" + data[x].StaffId + ">" + data[x].Name + "</option>");
                 }
                 $("#ReportingTo option[value = '" + selectedReportingTo + "' ]").prop('selected', true);
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }
