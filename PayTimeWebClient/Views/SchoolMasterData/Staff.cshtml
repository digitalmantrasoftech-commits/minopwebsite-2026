        $("#ContactNo").keypress(function (e) {
            $("#ContactNo").removeClass('field_error');
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
            else {
                return true;
            }
        });
        $('#ContactNo').bind('cut copy paste', function (e) {
            e.preventDefault(); //disable cut,copy,paste
        });
        $("#Punchid").keypress(function (e) {
            $("#Punchid").removeClass('field_error');
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
            else {
                return true;
            }
        });
        $('#Punchid').bind('cut copy paste', function (e) {
            e.preventDefault(); //disable cut,copy,paste
        });
        $("#Salary").keypress(function (e) {
            $("#Salary").removeClass('field_error');
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
            else {
                return true;
            }
        });
        $("#AddStaff").on('click', function () {
            fillSchooldll();
            fillReportingTodll();
            fillStaffTypedll();
            frmClear();
            $("#Email").attr("readOnly", false);
            $("#AddStaff").attr("data-toggle", "modal");
            $("#AddStaff").attr("data-target", "#frmpopup");
        });
        $("#btnstaffsubmit").click(function (event) {
            if ($("#SchoolId").val() == "0") {
                $("#SchoolId").addClass('field_error');
                $("#SchoolId").focus();
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#SchoolId").removeClass('field_error');
            }
            if ($("#Email").val() == "") {
                $("#Email").addClass('field_error');
                $("#Email").focus();
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#Email").removeClass('field_error');
            }
            if ($("#Name").val() == "") {
