            //    event.preventDefault();//or return false
            //    return false;
            //}
            //else {
            //    $("#ReportingTo").removeClass('field_error');
            //}
            var SelectedGender = false;
            if ($("#GenderF").is(":checked")) {
                SelectedGender = true;
            }
            var SelectedEmpMarried = false;
            if ($("#EmpMarried").is(":checked")) {
