                { "data": "ContactNo" },
                { "data": "EmrContactNo" },
                { "data": "Email" },
                { "data": "Address" },
                { "data": "Speciality" },
                { "data": "Salary" },
                { "data": "Punchid" },
                { "data": "StaffTypeId" },
                { "data": "ReportingTo" },
                { "data": "IsActive" }
