                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }
</script>
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/School/AdminDashboard">Home</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>Staff</span>
        </li>
    </ul>
    <div class="page-toolbar">
        @if (obj.CanAdd && Convert.ToInt32(Session["IsSchool"]) == 1)
        {
            <div class="">
                <a href="#" id="AddStaff" class="btn btn-sm blue" style="float:right"> <i class="fa fa-plus"></i> Add Staff</a>
            </div>
        }

    </div>
</div>
<h1 class="page-title">
    <small></small>
</h1>
@if (obj.CanView && Convert.ToInt32(Session["IsSchool"]) == 1)
{
    <div class="row">
        <div class="col-md-12">
            <div class="portlet ">
                <div class="portlet-body">
                    <div>
                        <table id="tblStaffMaster" class="table table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    <th>Sr. No</th>
                                    <th hidden>Staff ID</th>
                                    <th hidden>School Id</th>
                                    <th>Full Name</th>
                                    <th hidden>Name</th>
                                    <th hidden>SurName</th>
                                    <th hidden>Father Name</th>
                                    <th hidden>Mother Name</th>
                                    <th hidden>Date Of Birth</th>
                                    <th hidden>Gender</th>
                                    <th hidden>Is Married</th>
                                    <th>ContactNo</th>
                                    <th hidden>EmrContactNo</th>
                                    <th>Email</th>
                                    <th hidden>Address</th>
                                    <th hidden>Speciality</th>
                                    <th hidden>Salary</th>
                                    <th hidden>Punchid</th>
                                    <th hidden>StaffTypeId</th>
                                    <th hidden>ReportingTo</th>
                                    <th hidden>Is Active</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                    <div id="ajax_loaderbranch" class="modal_bg loading" aria-hidden="true">
                        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
                    </div>
                    <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                        <div class="modal-dialog">
                            <!-- Modal content-->
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Staff</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <fieldset>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        School <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.DropDownList("SchoolId", new SelectList(new[] { "" }), "Select School", new { @class = "form-control input-sm" })
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        @Html.Hidden("StaffId")
                                                        @Html.Hidden("IsActive", true)
                                                        First Name <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.Editor("Name", new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "70" } })

                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Date of birth <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="input-group input-group-sm date date-picker" data-date="@DateTime.Now" data-date-format="yyyy/mm/dd" data-date-viewmode="years" data-date-end-date="0d">
                                                        <span class="input-group-btn">
                                                            <button class="btn default" type="button">
                                                                <i class="fa fa-calendar"></i>
                                                            </button>
                                                        </span>
                                                        <input type="text" placeholder="YYYY/MM/DD" class="form-control" id="DateOfBirth" name="DateOfBirth" required="">
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Gender <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <label class="mt-radio mt-radio-outline">
                                                        Male
                                                        <input value="False" name="Gender" id="GenderM" type="radio" checked>
                                                        <span></span>
                                                    </label>
                                                    <label class="mt-radio mt-radio-outline">
                                                        Female
                                                        <input value="True" name="Gender" id="GenderF" type="radio">
                                                        <span></span>
                                                    </label>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Marital Status <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <label class="mt-radio mt-radio-outline">
                                                        Single
                                                        <input value="False" name="EmpMarried" id="Empsingle" type="radio" checked>
                                                        <span></span>
                                                    </label>
                                                    <label class="mt-radio mt-radio-outline">
                                                        Married
                                                        <input value="True" name="EmpMarried" id="EmpMarried" type="radio">
                                                        <span></span>
                                                    </label>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Speciality <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        <input type="text" id="Speciality" name="Speciality" required="" class="form-control input-sm" placeholder="Enter Policy Name" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')" maxlength="70">
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Salary <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.Editor("Salary", new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "10", @oncopy = "return false", onpaste = "return false" } })
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Staff Type <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.DropDownList("StaffTypeId", new SelectList(new[] { "" }), "Select Staff Type", new { @class = "form-control input-sm" })
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                        <div class="col-md-6">
                                            <fieldset>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Email <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.Editor("Email", new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "50" } })
                                                        <span class="help-block" hidden id="spscheml" style="color:red;"></span>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Last Name <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.Editor("SurName", new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "50" } })
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Contact Number <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.Editor("ContactNo", new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "15" } })
                                                        <span class="help-block" hidden id="spscnt" style="color:red;"></span>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Address <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        <textarea id="Address" class="form-control input-sm" name="Address" rows="5" placeholder="Enter Address" maxlength="150" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')"></textarea>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Punch ID <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.Editor("Punchid", new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "10" } })
                                                        <span class="help-block" hidden id="sppunch" style="color:red;"></span>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        Reporting To
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.DropDownList("ReportingTo", new SelectList(new[] { "" }), "Select Reporting To", new { @class = "form-control input-sm" })
                                                    </div>
                                                </div>
                                                <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                                                <div class="form-group">
                                                    <button type="button" class=" btn btn-sm blue" id="btnstaffsubmit" style="float:right"> <i class="fa fa-check"></i> Save</button>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}

