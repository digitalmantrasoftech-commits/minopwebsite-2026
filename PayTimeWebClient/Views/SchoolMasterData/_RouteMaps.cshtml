<script type="text/javascript">

    //var labels = '123456789';
    var _placename="";
    var _formatted_address="";
    var _place_id="";
    var labelIndex = 0;
    
    function initMap(vpos) {
        map = new google.maps.Map(document.getElementById('map_content'), {
            center: vpos,
            zoom: 15,
            mapTypeId: google.maps.MapTypeId.ROADMAP
        });
        
        map.addListener('click', function (event) {
            pos = event.latLng;
            map = new google.maps.Map(document.getElementById('map_content'), {
                center: pos,
                zoom: 15,
                mapTypeId: google.maps.MapTypeId.ROADMAP
            });
            settextvalue(event, 0);
            var clickHandler = new ClickEventHandler(map, pos);

        });

    }

    function EditinitMap() {

        var directionsService = new google.maps.DirectionsService;
        var directionsDisplay = new google.maps.DirectionsRenderer({
            draggable: true
        });

        var map = new google.maps.Map(document.getElementById('map_content'), {
            center: pos,
            zoom: 15,
        });

        var onChangeHandler = function () {
            calculateAndDisplayRoute(directionsService, directionsDisplay);
        };
       
        directionsDisplay.setMap(map);
        calculateAndDisplayRoute(directionsService, directionsDisplay);

        directionsDisplay.addListener('directions_changed', function () {
            OnDirectionchange(directionsDisplay.getDirections());
        });
    }

    function OnDirectionchange(result) {

        computeTotalDistance(result);
        var origin_Place, Destination_place, origin_Place_id, Destination_place_id, _ctnplaceid;
        $("#hdnfrm").val(result.legs[0].steps[0].start_location.toString());
        $("#hdnto").val(result.legs[0].steps[0].end_location.toString());

        origin_Place_id = result.geocoded_waypoints[0].place_id

        _ctnplaceid = result.geocoded_waypoints["length"];

        if (_ctnplaceid > 2) {
            _ctnplaceid = result.geocoded_waypoints["length"] - 1;
        }
        else {
            _ctnplaceid = 1;
        }

        Destination_place_id = result.geocoded_waypoints[_ctnplaceid].place_id;

        service = new google.maps.places.PlacesService(map);

        service.getDetails({ placeId: origin_Place_id }, function (place, status) {
            if (status === google.maps.places.PlacesServiceStatus.OK) {
                $("#searchboxinput").val(place.name + '|' + place.formatted_address);
            }
        });

        service.getDetails({ placeId: Destination_place_id }, function (place, status) {
            if (status === google.maps.places.PlacesServiceStatus.OK) {
                $("#searchboxinput1").val(place.name + '|' + place.formatted_address);
            }
        });
    }


    function computeTotalDistance(result) {
        
        var total = 0;
        var durtotal = 0;
        var myroute = result.routes[0];
        for (var i = 0; i < myroute.legs.length; i++) {
            total += myroute.legs[i].distance.value;
            durtotal += result.routes[0].legs[0].duration.value;
        }
        total = total / 1000;
        durtotal = Math.floor(durtotal / 60);
        //document.getElementById('total').innerHTML = total + ' km';
        document.getElementById('total').innerHTML = total + ' km';
        document.getElementById('totaldu').innerHTML = durtotal + ' min';
        document.getElementById('TDK').innerHTML = total + ' km';
        document.getElementById('TDM').innerHTML = durtotal + ' min';
        document.getElementById('OP').innerHTML = $("#searchboxinput").val();
        document.getElementById('DP').innerHTML = $("#searchboxinput1").val();

    }

    function Busstopadd() {

        var directionsService = new google.maps.DirectionsService;
        var directionsDisplay = new google.maps.DirectionsRenderer;

        var map = new google.maps.Map(document.getElementById('map'), {
            center: pos,
            zoom: 15,
        });

        labelIndex=1;
        if(busstoparrayedit.length>0)
        {
            $('#tblbusstopbody').empty();

            for(var i=0;i<busstoparrayedit.length;i++){

                var locate = new google.maps.LatLng(parseFloat(busstoparrayedit[i].markerlat), parseFloat(busstoparrayedit[i].markerlng));
                var _place=busstoparrayedit[i].Busstopcode;
                addMarker(locate, map, directionsService, directionsDisplay,_place);
            }
        }

        google.maps.event.addListener(map, 'click', function (event) {
            addMarker(event.latLng, map, directionsService, directionsDisplay,event.placeId);
        });

        directionsDisplay.setMap(map);
        calculateAndDisplayRoute(directionsService, directionsDisplay);

    }


    function calculateAndDisplayRoute(directionsService, directionsDisplay) {

        var origin_Place, Destination_place;
        origin_Place = $("#searchboxinput").val();
        Destination_place = $("#searchboxinput1").val();
        directionsService.route({
            origin: origin_Place,
            destination: Destination_place,
            travelMode: 'DRIVING'
        }, function (response, status) {
            if (status === 'OK') {
                directionsDisplay.setDirections(response);
            } else {
                window.alert('Directions request failed due to ' + status);
            }
        });

    }

    function settextvalue(event, nom) {
        if (event.placeId) {
            service = new google.maps.places.PlacesService(map);
            service.getDetails({
                placeId: event.placeId
            }, function (place, status) {
                if (status === google.maps.places.PlacesServiceStatus.OK) {
                    if (nom == 0) {
                        $("#searchboxinput").val(place.name + '|' + place.formatted_address);
                        $("#hdnfrm").val(event.latLng);
                        //$("#searchboxlbl1").show();
                    }
                    else {
                        //$("#searchboxlbl1").show();
                        //$("#btnsubmit").show();
                        $("#vehicalnolbl").show();
                        $("#Routecodelbl").show();
                        $("#routecode").val('');
                        $("#vehicalno").val('');
                        $("#searchboxinput1").val(place.name + '|' + place.formatted_address);
                        $("#hdnto").val(event.latLng);


                    }

                }
            });
        }




    }

    var ClickEventHandler = function (map, origin) {
        this.origin = origin;
        this.map = map;
        this.directionsService = new google.maps.DirectionsService;
        this.directionsDisplay = new google.maps.DirectionsRenderer({
            draggable: true,
            map: map
        });

        this.directionsDisplay.setMap(map);
        
        this.placesService = new google.maps.places.PlacesService(map);

        this.infowindow = new google.maps.InfoWindow;
        this.infowindowContent = document.getElementById('infowindow-content');
        this.infowindow.setContent(this.infowindowContent);

        // Listen for clicks on the map.
        this.map.addListener('click', this.handleClick.bind(this));
    };

    ClickEventHandler.prototype.handleClick = function (event) {
        console.log('You clicked on: ' + event.latLng);
        settextvalue(event, 1);
        // If the event has a placeId, use it.
        if (event.placeId) {
            console.log('You clicked on place:' + event.placeId);

            // Calling e.stop() on the event prevents the default info window from
            // showing.
            // If you call stop here when there is no placeId you will prevent some
            // other map click event handlers from receiving the event.
            event.stop();
            this.calculateAndDisplayRoute(event.placeId);
            //this.getPlaceInformation(event.placeId);
        }
    };

    ClickEventHandler.prototype.calculateAndDisplayRoute = function (placeId) {

        
        var me = this;
        this.directionsService.route({
            origin: this.origin,
            destination: { placeId: placeId },
            travelMode: 'DRIVING'

        }, function (response, status) {
            if (status === 'OK') {
                me.directionsDisplay.setDirections(response);
                computeTotalDistance(me.directionsDisplay.getDirections());
                map.setZoom(15);
            } else {
                window.alert('Directions request failed due to ' + status);
            }
        });
    };

    
    




    function handleLocationError(browserHasGeolocation, infoWindow, pos) {

        infoWindow.setPosition(pos);
        infoWindow.setContent(browserHasGeolocation ?
                              'Error: The Geolocation service failed.' :
                              'Error: Your browser doesn\'t support geolocation.');
        infoWindow.open(map);
    }
    // Adds a marker to the map.
    function addMarker(location, map, directionsService, directionsDisplay,placeId) {
        // Add the marker at the clicked location, and add the next-available label
        var marker = new google.maps.Marker({
            position: location,
            //map: map,
        });


        var input = location.toString();
        input = input.replace('(', '').replace(')', '');
        var latlngStr = input.split(',', 2);

        var service = new google.maps.places.PlacesService(map);
        service.getDetails({
            placeId: placeId
        }, function(place, status) {
            if (status === google.maps.places.PlacesServiceStatus.OK) {
                _placename= place.name;
                _formatted_address=place.formatted_address;
                _place_id=place.place_id;

                var obj = {
                    RouteId: $("#hdnrtid").val(),
                    Busstopname: _placename,
                    BusstopAddress: _placename+'|'+_formatted_address,
                    Busstopcode: _place_id,
                    markerlat: latlngStr[0].toString(),
                    markerlng: latlngStr[1].toString()
                };
                busstoparray.push(obj);

                var cnt=labelIndex;

                labelIndex++;
                $('#tblbusstopbody').append('<tr id="rw"+'+cnt+'"><td>'+cnt+'</td><td>'+_placename+'</td></tr>');


            }
        });

        markers.push(marker);

        waypts.push({
            location: location,
            stopover: true
        });

        

        directionsService.route({
            origin: $("#searchboxinput").val(),
            destination: $("#searchboxinput1").val(),
            waypoints: waypts,
            optimizeWaypoints: true,
            travelMode: 'DRIVING'

        }, function (response, status) {
            if (status === 'OK') {
                directionsDisplay.setDirections(response);
                computeTotalDistance(response);
                map.setZoom(15);
            } else {
                window.alert('Directions request failed due to ' + status);
            }
        });

        



    }

</script>
