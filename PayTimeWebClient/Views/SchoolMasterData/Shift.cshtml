@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Shift";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    string _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString(); ;

}

<script type="text/javascript">

    var schoolid = '@_companyid';
    var emprole = '@_RoleId';
    var _url = '';

    $(document).ready(function () {

        _url = '@_webapiurl' + 'Master/ShiftMasterGetAll';
        if (emprole == '6805') {
            _url = '@_webapiurl' + 'Master/ShiftMasterGetAllbycmpid?id=' + schoolid;
        }
        var t = $('#tblShiftMaster').DataTable(
        {
            "processing": true,
            "ajax": {
                url: _url,
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                dataSrc: '',
            },
            "columns": [
                { "data": null },
                { "data": "ShiftId" },
                { "data": "ShiftName" },
                {
                    "data": "StartTime",
                    //"render": function (data) {
                    //    var date = new Date(data);
                    //    return (date.getHours() > 10 ? date.getHours() : "0" + date.getHours()) + ":" + (date.getMinutes() > 10 ? date.getMinutes() : "0" + date.getMinutes());
                    //}
                },
                {
                    "data": "EndTime",
                    //"render": function (data) {
                    //    var date = new Date(data);
                    //    return (date.getHours() > 10 ? date.getHours() : "0" + date.getHours()) + ":" + (date.getMinutes() > 10 ? date.getMinutes() : "0" + date.getMinutes());
                    //}
                },
                { "data": "ShiftDur" },
                { "data": "IsActive" },
                { "data": "GraceBefore" }
            ],
            "columnDefs": [
                {
                    "targets": [1, 6,7],
                    "visible": false
                },
                {
                    "targets": 8,
                    "data": null,
                    "render": function (data, type, full, meta) {
                        if ('@obj.CanEdit.ToString()' == 'True') {
                            data = "<a class='editclass btn btn-xs blue tooltips' title='Edit'><i class='fa fa-edit'></i></a";
                        }
                        else {
                            data = "";
                        }
                        return data;
                    }
                },
                 {
                     "searchable": false,
                     "orderable": false,
                     "targets": 0
                 }
            ],
            "order": [[1, 'asc']],
        }
        );
        t.on('order.dt search.dt', function () {
            t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();
        $("#AddShift").on('click', function () {
            frmClear();
            $("#AddShift").attr("data-toggle", "modal");
            $("#AddShift").attr("data-target", "#frmpopup");
        });
        $("#btnShiftSubmit").click(function (event) {
            
            if ($("#shiftname").val() == "" || $("#shiftname").val().replace(" ", "").trim().length <= 0) {
                $("#shiftname").addClass('field_error');
                $("#shiftname").focus();
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#shiftname").removeClass('field_error');
            }
            if ($("#starttime").val() == "00:00") {
                $("#starttime").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#starttime").removeClass('field_error');
            }
            if ($("#endtime").val() == "00:00") {
                $("#endtime").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#endtime").removeClass('field_error');
            }
            if ($("#ShiftDur").val() == "00:00") {
                $("#ShiftDur").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#ShiftDur").removeClass('field_error');
            }

            if ($('#shiftid').val() == "0") {
                var obj = {
                    ShiftId: $('#shiftid').val(),
                    ShiftName: $("#shiftname").val(),
                    StartTime: $("#starttime").val(),
                    EndTime: $("#endtime").val(),
                    ShiftDur: $("#ShiftDur").val(),
                    IsActive: $("#IsActive").val(),
                    GraceBefore: schoolid
                };
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurl' + 'Master/ShiftMasterCreate',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        if (response != null) {
                            $("<div class='alert alert-success overlay'><label>Saved Successfully</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblShiftMaster').DataTable().ajax.reload();
                            $('#frmpopup').modal('toggle');
                        } else {
                            $("<div class='alert alert-danger overlay'><label>Error on save</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblShiftMaster').DataTable().ajax.reload();
                            $('#frmpopup').modal('toggle');
                        }
                    },
                    error: function (response) {
                        if (response != null) {
                            var obj = JSON.parse(response.responseText);
                            if (obj.MsgSts == 'error') {
                                $("<div class='alert alert-danger overlay'><label>" + obj.Msg + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                $('#tblShiftMaster').DataTable().ajax.reload();
                                $('#frmpopup').modal('toggle');
                            }
                        }
                    }
                });
            } else {
               

                var name = $("#shiftname").val();

                $.ajax({
                    type: "GET",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurl' + "/SchoolMaster/ShiftName?name=" + name + "&shiftID=" + $('#shiftid').val(),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        if (data.isRedirect) {
                            window.location.href = data.redirectUrl;
                        }
                        
                        if (data != null && data.length > 0) {
                            if (data[0]["name"] == name) {
                                $("#spschnme").html("Shift name must be Unique.").show();
                                $("#shiftname").val("");
                                $("#shiftname").focus();
                                $("#shiftname").addClass('field_error');
                            }
                        }
                        

                            var obj = {
                                ShiftId: $('#shiftid').val(),
                                ShiftName: $("#shiftname").val(),
                                StartTime: $("#starttime").val(),
                                EndTime: $("#endtime").val(),
                                ShiftDur: $("#ShiftDur").val(),
                                IsActive: $("#IsActive").val(),
                                GraceBefore: $("#GraceBefore").val()
                            };

                            $.ajax({
                                type: "POST",
                                headers: { 'Authorization': '@_tokan' },
                                url: '@_webapiurl' + 'Master/ShiftMasterUpdate',
                                data: JSON.stringify(obj),
                                contentType: "application/json; charset=utf-8",
                                dataType: "json",
                                success: function (response) {
                                    if (response != null) {
                                        $("<div class='alert alert-success overlay'><label>Updated Successfully</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                        $('#tblShiftMaster').DataTable().ajax.reload();
                                        $('#frmpopup').modal('toggle');
                                    } else {
                                        $("<div class='alert alert-danger overlay'><label>Error on updation</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                        $('#tblShiftMaster').DataTable().ajax.reload();
                                        $('#frmpopup').modal('toggle');
                                    }
                                }
                            });

                    }
                });
            }
        });
        $("#shiftname").keypress(function (e) {
            $("#shiftname").removeClass('field_error');
        });
        $("#shiftname").keypress(function (evt) {
            $("#shiftname").removeClass('field_error');
            var k;
            if (evt.keyCode > 0) {
                k = evt.keyCode;
            }
            else if (typeof (evt.charCode) != "undefined") {
                k = evt.charCode;
            }
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
        })
        $("#tblShiftMaster").on('click', '.editclass', function () {
            $("#shiftname").removeClass('field_error');
            $("#starttime").removeClass('field_error');
            $("#endtime").removeClass('field_error');
            $("#shiftid").val(t.row($(this).parent('td').parent('tr')).data()["ShiftId"]);
            $("#shiftname").val(t.row($(this).parent('td').parent('tr')).data()["ShiftName"]);
            $("#GraceBefore").val(t.row($(this).parent('td').parent('tr')).data()["GraceBefore"]);
            //alert($("#GraceBefore").val());
            var starttimedb = t.row($(this).parent('td').parent('tr')).data()["StartTime"];


            //var startdate = new Date(starttimedb);
            //var starttime = (startdate.getHours() > 10 ? startdate.getHours() : "0" + startdate.getHours()) + ":" + (startdate.getMinutes() > 10 ? startdate.getMinutes() : "0" + startdate.getMinutes());
            $("#starttime").val(starttimedb);
            var endtimedb = t.row($(this).parent('td').parent('tr')).data()["EndTime"];
            //var enddate = new Date(endtimedb);
            //var endtime = (enddate.getHours() > 10 ? enddate.getHours() : "0" + enddate.getHours()) + ":" + (enddate.getMinutes() > 10 ? enddate.getMinutes() : "0" + enddate.getMinutes());
            $("#endtime").val(endtimedb);
            $("#ShiftDur").val(t.row($(this).parent('td').parent('tr')).data()["ShiftDur"]);
            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");
        });

        $("#shiftname").blur(function (e) {
            var name = $("#shiftname").val();
            if (name.replace(" ", "").trim().length <= 0) {
                $("#spschnme").html('Shift Name may not be empty!').show();
            }
            else {
                $("#shiftname").removeClass('field_error');
                $("#spschnme").hide();
            }




            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "/SchoolMaster/ShiftName?name=" + name,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    if (data != null && data.length > 0) {
                        if (data[0]["name"] == name) {
                            $("#spschnme").html("Shift name must be Unique.").show();
                            $("#shiftname").val("");
                            $("#shiftname").focus();
                            $("#shiftname").addClass('field_error');
                            e.preventDefault();
                            return false;
                            
                        }
                        else {
                            $("#shiftname").removeClass('field_error');
                            $("#spschnme").hide();
                            return true;
                        }
                    }
                    else {
                        $("#spschnme").hide();
                    }

                }
            });

        });
        $("#starttime").change(function () {
            CalculateHours();
        });

        $("#endtime").change(function () {

            CalculateHours();
        });
    });

    

    function frmClear() {
        $("#shiftid").val(0);
        $("#starttime").val("00:00");
        $("#endtime").val("00:00");
        $("#ShiftDur").val("00:00");
        $("#shiftname").val("");
        $("#shiftname").attr("placeholder", "Enter Shift name");
        $("#shiftname").removeClass('field_error');
        $("#spschnme").hide();
        $("#starttime").removeClass('field_error');
        $("#endtime").removeClass('field_error');
    }
    function CalculateHours() {
        a = $("#starttime").val();
        b = $("#endtime").val();
        if (a.length < 5) {
            a = "0" + a;
        }
        if (b.length < 5) {
            b = "0" + b;
        }
        var s = new Date("2017-09-16 " + a);
        var e = new Date("2017-09-17 " + b);

        if (a > b) // for night shift
        {

            var diff = Math.abs(new Date("2017-09-17 " + b) - new Date("2017-09-16 " + a));
            var seconds = Math.floor(diff / 1000); //ignore any left over units smaller than a second
            var minutes = Math.floor(seconds / 60);
            seconds = seconds % 60;
            var hours = Math.floor(minutes / 60);
            minutes = minutes % 60;
            if (minutes < 9) {
                minutes = "0" + minutes;
            }
            if (hours < 9) {
                hours = "0" + hours;
            }
            $("#ShiftDur").val(hours + ":" + minutes);
        }
        else if (b > a) //for day shift
        {
            var diff = Math.abs(new Date("01/01/2007 " + b) - new Date("01/01/2007 " + a));
            var seconds = Math.floor(diff / 1000); //ignore any left over units smaller than a second
            var minutes = Math.floor(seconds / 60);
            seconds = seconds % 60;
            var hours = Math.floor(minutes / 60);
            minutes = minutes % 60;
            if (minutes < 9) {
                minutes = "0" + minutes;
            }
            if (hours < 9) {
                hours = "0" + hours;
            }
            $("#ShiftDur").val(hours + ":" + minutes);

        }
        else {
            $("#ShiftDur").val("00:00");
        }



    };
</script>
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/School/AdminDashboard">Home</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>Shift</span>
        </li>
    </ul>

    <div class="page-toolbar">
        @if (obj.CanAdd && Convert.ToInt32(Session["IsSchool"]) == 1)
        {
            <div class="">
                <a href="#" id="AddShift" class="btn btn-sm blue" style="float:right"> <i class="fa fa-plus"></i> Add Shift</a>
            </div>
        }

    </div>
</div>
<h1 class="page-title">
    <small></small>
</h1>
@if (obj.CanView && Convert.ToInt32(Session["IsSchool"]) == 1)
{
    <div class="row">
        <div class="col-md-12">
            <div class="portlet ">
                <div class="portlet-body">
                    <div>
                        <table id="tblShiftMaster" class="table table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    <th>Sr. No</th>
                                    <th hidden>Shift ID</th>
                                    <th>Shift</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Shift Duration</th>
                                    <th hidden>Is Active</th>
                                    <th hidden>companyid</th>
                                    <th>Action</th>

                                </tr>
                            </thead>
                        </table>
                    </div>
                    <div id="ajax_loaderbranch" class="modal_bg loading" aria-hidden="true">
                        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
                    </div>
                    <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                        <div class="modal-dialog">
                            <!-- Modal content-->
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Shift</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <fieldset>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        @Html.Hidden("shiftid")
                                                        @Html.Hidden("GraceBefore")
                                                        @Html.Hidden("IsActive", true)

                                                        Name <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.Editor("shiftname", new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "50" } })
                                                        <span class="help-block" hidden id="spschnme" style="color:red;"></span>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="row">
                                                                <div class="col-md-6">
                                                                    <div class="form-group">
                                                                        <label class=" control-label">Start Time <span class="required" aria-required="true"> * </span></label>
                                                                        <div class="input-group input-group-sm" id="StartDiv">
                                                                            <input type="text" class="form-control timepicker timepicker-24" id="starttime" name="starttime" placeholder="00:00">
                                                                            <span class="input-group-btn">
                                                                                <button class="btn default" type="button" id="btnIntime">
                                                                                    <i class="fa fa-clock-o"></i>
                                                                                </button>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <div class="form-group">
                                                                        <label class=" control-label">End Time <span class="required" aria-required="true"> * </span></label>
                                                                        <div class="input-group input-group-sm" id="EndDiv">
                                                                            <input type="text" class="form-control timepicker timepicker-24" id="endtime" name="endtime" placeholder="00:00">
                                                                            <span class="input-group-btn">
                                                                                <button class="btn default" type="button" id="btnIntime">
                                                                                    <i class="fa fa-clock-o"></i>
                                                                                </button>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="form-group">
                                                                <label>Shift Duration In hrs</label>
                                                                <input type="text" class="form-control input-sm" readonly id="ShiftDur" name="ShiftDur">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                                                <div class="form-group">
                                                    <button type="button" class=" btn btn-sm blue" id="btnShiftSubmit" style="float:right"> <i class="fa fa-check"></i> Save</button>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
