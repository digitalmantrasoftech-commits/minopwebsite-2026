@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Class";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = string.Empty;
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
}

<script type="text/javascript">
    var schoolid = '@_companyid';
    var emprole = '@_RoleId';
    var _url = '';
    

    _url = '@_webapiurl' + 'Master/BranchGetAll'
    if (emprole == '6805') {
        _url = '@_webapiurl' + 'Master/BranchGetAllbycmp?id=' + schoolid;
    }

    $(document).ready(function () {
        var t = $('#tblClassMaster').DataTable(
         {
             "processing": true,
             "ajax": {
                 url: _url,
                 type: "GET",
                 headers: { 'Authorization': '@_tokan' },
                 dataSrc: '',
             },
             "columns": [
                 { "data": null },
                 { "data": "BranchId" },
                 { "data": "branchname" },
                 { "data": "CompanyName" },
                 { "data": "IsActive" }
             ],
             "columnDefs": [
                 {
                     "targets": [1, 4],
                     "visible": false
                 },
                 {
                     "targets": 5,
                     "data": null,
                     "render": function (data, type, full, meta) {
                         if ('@obj.CanEdit.ToString()' == 'True') {
                             data = "<a class='editclass btn btn-xs blue tooltips' title='Edit'><i class='fa fa-edit'></i></a";
                         }
                         else {
                             data = "";
                         }
                         return data;
                     }
                 },
                  {
                      "searchable": false,
                      "orderable": false,
                      "targets": 0
                  }
             ],
             "order": [[1, 'asc']],
         }
         );
        t.on('order.dt search.dt', function () {
            t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();
        $("#AddClass").on('click', function () {
            frmClear();
            $("#AddClass").attr("data-toggle", "modal");
            $("#AddClass").attr("data-target", "#frmpopup");
        });
        fillcompanydll();
        $("#btnClassSubmit").click(function (event) {

            
            if ($("#CompanyID").val() == "") {
                $("#CompanyID").addClass('field_error');
                $("#CompanyID").focus();
                event.preventDefault();
                return false;
            }
            else {
                $("#CompanyID").removeClass('field_error');
            }
            if ($("#ClassName").val() == "") {
                
                $("#ClassName").addClass('field_error');
                $("#ClassName").focus();
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#ClassName").removeClass('field_error');
            }


            if ($("#ClassName").val() == " ") {
                $("#ClassName").addClass('field_error');
                $("#ClassName").focus();
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#ClassName").removeClass('field_error');
            }
            //if (!validateclass()) {
            //    return false;
            //}
            
            var obj = {
                BranchId: $('#ClassId').val(),
                CompanyId: $("#CompanyID").val(),
                BranchName: $("#ClassName").val(),
                IsActive: $("#IsActive").val()
            };
            
            if ($('#ClassId').val() == "0") {
                
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurl' + 'Master/BranchCreate',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        if (response != null) {
                            $("<div class='alert alert-success overlay'><label>Saved Successfully</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblClassMaster').DataTable().ajax.reload();
                            $('#frmpopup').modal('toggle');
                        } else {
                            $("<div class='alert alert-danger overlay'><label>Error on save</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblClassMaster').DataTable().ajax.reload();
                            $('#frmpopup').modal('toggle');
                        }
                    },
                    error: function (response) {
                        if (response != null) {
                            var obj = JSON.parse(response.responseText);
                            if (obj.MegSts == 'error') {
                                $("<div class='alert alert-danger overlay'><label>" + obj.Meg.replace("Branch", "Class") + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                $('#tblClassMaster').DataTable().ajax.reload();
                                $('#frmpopup').modal('toggle');
                            }
                        }
                    }
                });
            } else 
            {
                
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurl' + 'Master/BranchUpdate',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        if (response != null) {
                            $("<div class='alert alert-success overlay'><label>Updated Successfully</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblClassMaster').DataTable().ajax.reload();
                            $('#frmpopup').modal('toggle');
                        } else {
                            $("<div class='alert alert-danger overlay'><label>Error on updation</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblClassMaster').DataTable().ajax.reload();
                            $('#frmpopup').modal('toggle');
                        }
                    },
                    error: function (response) {
                        if (response != null) {
                            var obj = JSON.parse(response.responseText);
                            if (obj.MegSts == 'error') {
                                $("<div class='alert alert-danger overlay'><label>" + obj.Meg.replace("Branch", "Class") + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                $('#tblClassMaster').DataTable().ajax.reload();
                                $('#frmpopup').modal('toggle');
                            }
                        }
                    }
                });
            }
        });
        $("#ClassName").keypress(function (e) {
            $("#ClassName").removeClass('field_error');
        });
        $("#tblClassMaster").on('click', '.editclass', function () {
            $("#CompanyID").removeClass('field_error');
            $("#ClassName").removeClass('field_error');
            $("#spschnme").html('');
            $("#spschnme").hide();
            var companyid = "";
            companyid = t.row($(this).parent('td').parent('tr')).data()["CompanyID"];
            $('#CompanyID').val(companyid);
            $("#ClassId").val(t.row($(this).parent('td').parent('tr')).data()["BranchId"]);
            $("#ClassName").val(t.row($(this).parent('td').parent('tr')).data()["branchname"]);
            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");
           
        });

        $("#ClassName").keypress(function (evt) {
            $("#ClassName").removeClass('field_error');
            var k;
            if (evt.keyCode > 0) {
                k = evt.keyCode;
            }
            else if (typeof (evt.charCode) != "undefined") {
                k = evt.charCode;
            }
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
        });

        $("#ClassName").blur(function () {
            validateclass();
        });
    });

    function validateclass() {
        var editStatus;
        var name = $("#ClassName").val();
        var companyID = $("#CompanyID option:selected").val();
        $.ajax({
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + "/Master/BranchGetAll",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                if (data != null && data.length > 0) {
                    
                    if(data.filter(x => x.CompanyID == companyID).filter(x => x.branchname == name).length > 0)
                    {
                        $("#spschnme").html("Class name must be Unique.").show();
                        $("#ClassName").focus();
                        $("#ClassName").addClass('field_error');
                        editStatus = false;
                    }else{
                        $("#ClassName").removeClass('field_error');
                        $("#spschnme").html('');
                        $("#spschnme").hide();
                        editStatus = true;
                    }
                }
                else{
                    
                        $("#ClassName").removeClass('field_error');
                        $("#spschnme").html('');
                        $("#spschnme").hide();
                        editStatus = true;
                }
               
                
                //if (data != null && data.length > 0) {
                //    for (var i = 0; i < data.length; i++) {
                //          if (data[i]["CompanyID"] == $("#CompanyID").val()) {
                //            if (data[i]["branchname"].toLowerCase() == name.toLowerCase()) {
                //                $("#spschnme").html("Class name must be Unique.").show();
                //                $("#ClassName").focus();
                //                $("#ClassName").addClass('field_error');
                //                return false;
                //            }
                //            else {
                //                $("#ClassName").removeClass('field_error');
                //                $("#spschnme").html('');
                //                $("#spschnme").hide();
                //            }
                //        }
                //    }
                //}
                //else {
                //    $("#ClassName").removeClass('field_error');
                //    $("#spschnme").html('');
                //    $("#spschnme").hide();
                //    return true;
                //}
            }
        });

        return editStatus;
    }

    function fillcompanydll(selectedCompanyid) {
        $('#CompanyID').empty();
        var _urlcmp = '@_webapiurl' + 'Master/CompanyGetAll'
        if (emprole == '6805') {
            _urlcmp = '@_webapiurl' + 'Master/CompanyGetById?id=' + schoolid;
        }

        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             url: _urlcmp,
             //data: { CountryId: Countryid },
             contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
                 //     $(".loading").show();
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 //      $(".loading").hide();
                 $("#CompanyID").append("<option value=''>Select School</option>");
                 for (var x = 0; x < data.length; x++) {
                     $("#CompanyID").append("<option value=" + data[x].CompanyID + ">" + data[x].CompanyName + "</option>");
                 }
                 $("#CompanyID option[value = '" + selectedCompanyid + "' ]").prop('selected', true);
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }
    function frmClear() {
        $("#ClassId").val(0);
        $("#ClassName").val("");
        $("#CompanyID").val("");
        $("#CountryID").val("");
        $("#CompanyID").removeClass('field_error');
        $("#ClassName").attr("placeholder", "Enter Class name");
        $("#ClassName").removeClass('field_error');
        $("#spschnme").hide();
    }
</script>
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/School/AdminDashboard">Home</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>Class</span>
        </li>
    </ul>

    <div class="page-toolbar">
        @if (obj.CanAdd && Convert.ToInt32(Session["IsSchool"]) == 1)
        {
            <div class="">
                <a href="#" id="AddClass" class="btn btn-sm blue" style="float:right"> <i class="fa fa-plus"></i> Add Class</a>
            </div>
        }

    </div>
</div>
<h1 class="page-title">
    <small></small>
</h1>
@if (obj.CanView && Convert.ToInt32(Session["IsSchool"]) == 1)
{
    <div class="row">
        <div class="col-md-12">
            <div class="portlet ">
                <div class="portlet-body">
                    <div>
                        <table id="tblClassMaster" class="table table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    <th>Sr. No</th>
                                    <th hidden>Class ID</th>
                                    <th>Class</th>
                                    <th>School</th>
                                    <th hidden>Is Active</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                    <div id="ajax_loaderbranch" class="modal_bg loading" aria-hidden="true">
                        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
                    </div>
                    <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                        <div class="modal-dialog">
                            <!-- Modal content-->
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Class</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <fieldset class="form-horizontal">
                                                <div class="form-group">
                                                    <div class="editor-label   col-md-4 control-label">
                                                        School Name <span class="required" aria-required="true"> * </span>
                                                    </div>
                                                    <div class="editor-field col-md-7">
                                                        @Html.DropDownList("CompanyID", new SelectList(new[] { "" }), "Select School", new { @class = "form-control input-sm" })
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class=" col-md-4 control-label">
                                                        @Html.Hidden("ClassId")
                                                        @Html.Hidden("IsActive", true)
                                                        Class Name <span class="required" aria-required="true"> * </span>
                                                    </div>

                                                    <div class="editor-field col-md-7">
                                                        <input type="text" id="ClassName" name="ClassName" required="" class="form-control input-sm" placeholder="Enter Class Name" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')" maxlength="40">
                                                        <span class="help-block" hidden id="spschnme" style="color:red;"></span>
                                                    </div>
                                                </div>
                                                <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                                                <div class="form-group">
                                                    <button type="button" class=" btn btn-sm blue" id="btnClassSubmit" style="float:right"> <i class="fa fa-check"></i> Save</button>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}

