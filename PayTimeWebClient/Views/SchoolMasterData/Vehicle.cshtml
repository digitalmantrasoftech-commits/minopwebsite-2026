    function fillDeviceTypedll(selectedDeviceTypeId) {
        $('#TrackingDevicetypeid').empty();
        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             url: '@_webapiurl' + "/Master/DeviceTypeGetAll",
             contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 $("#TrackingDevicetypeid").append("<option value='0'>Select Device Type</option>");
                 for (var x = 0; x < data.length; x++) {
                     $("#TrackingDevicetypeid").append("<option value=" + data[x].DeviceTypeCode + ">" + data[x].DeviceType + "</option>");
                 }
                 $("#TrackingDevicetypeid option[value = '" + selectedDeviceTypeId + "' ]").prop('selected', true);
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }

    function fillIMEIdll(selectedImeiId) {
        $('#Imeiid').empty();
        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             url: '@_webapiurl' + "/Master/DeviceGetAllGrid?compCode='" + '@_compcode' + "'",
             contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
