@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Division";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }

    string _companyid = string.Empty;
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }

}

<script type="text/javascript">

    var schoolid = '@_companyid';
    var emprole = '@_RoleId';
    var _urldivision = '@_webapiurl' + 'Master/DepartmentGetAll';

    if (emprole == '6805') {
        _urldivision = '@_webapiurl' + 'Master/DepartmentGetAllbycmp?id=' + schoolid;
    }


    $(document).ready(function () {
        var t = $('#tblDivisionMaster').DataTable(
         {
             "processing": true,
             "ajax": {
                 url: _urldivision,
                 type: "GET",
                 headers: { 'Authorization': '@_tokan' },
                 dataSrc: '',
             },
             "columns": [
                 { "data": null },
                 { "data": "DepartmentId" },
                 { "data": "DepartmentName" },
                 { "data": "IsActive" }
             ],
             "columnDefs": [
                 {
                     "targets": [1, 3],
                     "visible": false
                 },
                 {
                     "targets": 4,
                     "data": null,
                     "render": function (data, type, full, meta) {
                         if ('@obj.CanEdit.ToString()' == 'True') {
                             if (emprole == '6805') {
                                 if (data.CompanyID > 0) {
                                     data = "<a class='editclass btn btn-xs blue tooltips' title='Edit'><i class='fa fa-edit'></i></a>";
                                 }
                                 else {
                                     data = "";
                                 }
                             }
                             else {
                                 data = "<a class='editclass btn btn-xs blue tooltips' title='Edit'><i class='fa fa-edit'></i></a>";
                             }


                         }
                         else {
                             data = "";
                         }
                         return data;
                     }
                 },
                  {
                      "searchable": false,
                      "orderable": false,
                      "targets": 0
                  }
             ],
             "order": [[1, 'asc']],
         }
         );
        t.on('order.dt search.dt', function () {
            t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();
        $("#AddDivision").on('click', function () {
            frmClear();
            $("#AddDivision").attr("data-toggle", "modal");
            $("#AddDivision").attr("data-target", "#frmpopup");
        });
        $("#btnDivisionSubmit").click(function (event) {
            if ($("#DivName").val() == "") {
                $("#DivName").addClass('field_error');
                $("#DivName").focus();
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#DivName").removeClass('field_error');
            }

            var name = $("#DivName").val();
            var obj = {
                DepartmentId: $('#DivId').val(),
                DepartmentName: $("#DivName").val(),
                IsActive: $("#IsActive").val(),
                CompanyID: schoolid
            };
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "/SchoolMaster/DivName?name=" + name + "&DepartmentId=" + $('#DivId').val(),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    //if (data != null && data.length > 0) {
                    //    if (data[0]["name"].toLowerCase() == name.toLowerCase()) {
                    //        $("#spschnme").html("Division name must be Unique.").show();
                    //        $("#DivName").val("");
                    //        $("#DivName").focus();
                    //        $("#DivName").addClass('field_error');
                    //        event.preventDefault();
                    //        return false;
                    //    }
                    //}
                    //else {
                        $("#DivName").removeClass('field_error');
                        $("#spschnme").hide();

                        if ($('#DivId').val() == "0") {
                            $.ajax({
                                type: "POST",
                                headers: { 'Authorization': '@_tokan' },
                                url: '@_webapiurl' + 'Master/DepartmentCreate',
                                data: JSON.stringify(obj),
                                contentType: "application/json; charset=utf-8",
                                dataType: "json",
                                success: function (response) {
                                    if (response != null) {
                                        $("<div class='alert alert-success overlay'><label>Saved Successfully</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                        $('#tblDivisionMaster').DataTable().ajax.reload();
                                        $('#frmpopup').modal('toggle');
                                    } else {
                                        $("<div class='alert alert-danger overlay'><label>Error on save</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                        $('#tblDivisionMaster').DataTable().ajax.reload();
                                        $('#frmpopup').modal('toggle');
                                    }
                                },
                                error: function (response) {
                                    if (response != null) {
                                        var obj = JSON.parse(response.responseText);
                                        if (obj.MegSts == 'error') {
                                            $("<div class='alert alert-danger overlay'><label>" + obj.Meg.replace("Department", "Division") + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                            $('#tblDivisionMaster').DataTable().ajax.reload();
                                            $('#frmpopup').modal('toggle');
                                        }
                                    }
                                }
                            });
                        } else {
                            $.ajax({
                                type: "POST",
                                headers: { 'Authorization': '@_tokan' },
                                url: '@_webapiurl' + 'Master/DepartmentUpdate',
                                data: JSON.stringify(obj),
                                contentType: "application/json; charset=utf-8",
                                dataType: "json",
                                success: function (response) {
                                    if (response != null) {
                                        $("<div class='alert alert-success overlay'><label>Updated Successfully</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                        $('#tblDivisionMaster').DataTable().ajax.reload();
                                        $('#frmpopup').modal('toggle');
                                    } else {
                                        $("<div class='alert alert-danger overlay'><label>Error on updation</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                        $('#tblDivisionMaster').DataTable().ajax.reload();
                                        $('#frmpopup').modal('toggle');
                                    }
                                }
                            });
                        //}
                        return true;
                    }
                }
            });




        });
        $("#DivName").keypress(function (e) {
            $("#DivName").removeClass('field_error');
        });
        $("#tblDivisionMaster").on('click', '.editclass', function () {
            $("#DivName").removeClass('field_error');
            $("#DivId").val(t.row($(this).parent('td').parent('tr')).data()["DepartmentId"]);
            $("#DivName").val(t.row($(this).parent('td').parent('tr')).data()["DepartmentName"]);
            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");
        });

        $("#DivName").keypress(function (evt) {
            $("#DivName").removeClass('field_error');
            var k;
            if (evt.keyCode > 0) {
                k = evt.keyCode;
            }
            else if (typeof (evt.charCode) != "undefined") {
                k = evt.charCode;
            }
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
        });

        $("#DivName1").blur(function () {
            var name = $("#DivName").val();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "/SchoolMaster/DivName?name=" + name,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    if (data != null && data.length > 0) {
                        if (data[0]["name"].toLowerCase() == name.toLowerCase()) {
                            $("#spschnme").html("Division name must be Unique.").show();
                            $("#DivName").val("");
                            $("#DivName").focus();
                            $("#DivName").addClass('field_error');
                            return false;
                        }
                        else {
                            $("#DivName").removeClass('field_error');
                            $("#spschnme").hide();
                            return true;
                        }
                    }
                    else {
                        $("#spschnme").hide();
                    }

                }
            });

        });
    });
    function frmClear() {
        $("#DivId").val(0);
        $("#DivName").val("");
        $("#DivName").attr("placeholder", "Enter Division name");
        $("#DivName").removeClass('field_error');
        $("#spschnme").hide();
    }
</script>
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/School/AdminDashboard">Home</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>Division</span>
        </li>
    </ul>

    <div class="page-toolbar">
        @if (obj.CanAdd && Convert.ToInt32(Session["IsSchool"]) == 1)
        {
            <div class="">
                <a href="#" id="AddDivision" class="btn btn-sm blue" style="float:right"> <i class="fa fa-plus"></i> Add Division</a>
            </div>
        }

    </div>
</div>
<h1 class="page-title">
    <small></small>
</h1>
@if (obj.CanView && Convert.ToInt32(Session["IsSchool"]) == 1)
{
    <div class="row">
        <div class="col-md-12">
            <div class="portlet ">
                <div class="portlet-body">
                    <div>
                        <table id="tblDivisionMaster" class="table table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    <th>Sr. No</th>
                                    <th hidden>Division ID</th>
                                    <th>Division</th>
                                    <th hidden>Is Active</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                    <div id="ajax_loaderbranch" class="modal_bg loading" aria-hidden="true">
                        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
                    </div>
                    <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                        <div class="modal-dialog">
                            <!-- Modal content-->
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Division</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <fieldset>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        @Html.Hidden("DivId")
                                                        @Html.Hidden("IsActive", true)
                                                        Name <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        <input type="text" id="DivName" name="DivName" required="" class="form-control input-sm" placeholder="Enter Division Name" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')" maxlength="50">
                                                        <span class="help-block" hidden id="spschnme" style="color:red;"></span>
                                                    </div>
                                                </div>
                                                <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                                                <div class="form-group">
                                                    <button type="button" class=" btn btn-sm blue" id="btnDivisionSubmit" style="float:right"> <i class="fa fa-check"></i> Save</button>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}

