@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Staff Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();

    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);

    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _companyid = "0";
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
   
}

<script type="text/javascript">

    var schoolid = '@_companyid';
    var emprole = '@_RoleId';

    
    var _urlStafftpe = '@_webapiurl' + 'Master/DesignationGetAll';

    if (emprole == '6805') {
        _urlStafftpe = '@_webapiurl' + 'Master/DesignationGetAllbyCmpId?id=' + schoolid;
    }

    $(document).ready(function () {

        var t = $('#tblStaffTypeMaster').DataTable(
        {
            "processing": true,
            "ajax": {
                url: _urlStafftpe,
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                dataSrc: '',
            },
            "columns": [
                { "data": null },
                { "data": "DesignationId" },
                { "data": "DesignationName" },
                { "data": "IsActive" }
            ],
            "columnDefs": [
                {
                    "targets": [1, 3],
                    "visible": false
                },
                {
                    "targets": 4,
                    "data": null,
                    "render": function (data, type, full, meta) {
                        if ('@obj.CanEdit.ToString()' == 'True') {
                            data = "<a class='editclass btn btn-xs blue tooltips' title='Edit'><i class='fa fa-edit'></i></a";
                        }
                        else {
                            data = "";
                        }
                        return data;
                    }
                },
                 {
                     "searchable": false,
                     "orderable": false,
                     "targets": 0
                 }
            ],
            "order": [[1, 'asc']],
        }
        );
        t.on('order.dt search.dt', function () {
            t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();
        $("#AddStaffType").on('click', function () {
            frmClear();
            $("#SchoolEmail").attr("readOnly", false);
            $("#AddStaffType").attr("data-toggle", "modal");
            $("#AddStaffType").attr("data-target", "#frmpopup");
        });
        $("#btnstafftypesubmit").click(function (event) {
            if ($("#StaffTypeName").val() == "") {
                $("#StaffTypeName").addClass('field_error');
                $("#StaffTypeName").focus();
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#StaffTypeName").removeClass('field_error');
            }
            var obj = {
                DesignationId: $('#StaffTypeId').val(),
                DesignationName: $("#StaffTypeName").val(),
                IsActive: $("#IsActive").val(),
                CompanyID: schoolid
            };
            if ($('#StaffTypeId').val() == "0") {
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurl' + 'Master/DesignationCreate',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        if (response != null) {
                            $("<div class='alert alert-success overlay'><label>Saved Successfully</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblStaffTypeMaster').DataTable().ajax.reload();
                            $('#frmpopup').modal('toggle');
                        } else {
                            $("<div class='alert alert-danger overlay'><label>Error on save</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblStaffTypeMaster').DataTable().ajax.reload();
                            $('#frmpopup').modal('toggle');
                        }
                    },
                    error: function (response) {
                        if (response != null) {
                            var obj = JSON.parse(response.responseText);
                            if (obj.MegSts == 'error') {
                                $("<div class='alert alert-danger overlay'><label>" + obj.Meg.replace("Designation", "Staff type") + "</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                                $('#tblStaffTypeMaster').DataTable().ajax.reload();
                                $('#frmpopup').modal('toggle');
                            }
                        }
                    }
                });
            } else {
                $.ajax({
                    type: "POST",
                    headers: { 'Authorization': '@_tokan' },
                    url: '@_webapiurl' + 'Master/DesignationUpdate',
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        if (response != null) {
                            $("<div class='alert alert-success overlay'><label>Updated Successfully</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblStaffTypeMaster').DataTable().ajax.reload();
                            $('#frmpopup').modal('toggle');
                        } else {
                            $("<div class='alert alert-danger overlay'><label>Error on updation</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                            $('#tblStaffTypeMaster').DataTable().ajax.reload();
                            $('#frmpopup').modal('toggle');
                        }
                    }
                });
            }
        });
        $("#StaffTypeName").keypress(function (e) {
            $("#StaffTypeName").removeClass('field_error');
        });
        $("#StaffTypeName").keypress(function (evt) {
            $("#StaffTypeName").removeClass('field_error');
            var k;
            if (evt.keyCode > 0) {
                k = evt.keyCode;
            }
            else if (typeof (evt.charCode) != "undefined") {
                k = evt.charCode;
            }
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
        })
        $("#tblStaffTypeMaster").on('click', '.editclass', function () {
            $("#StaffTypeName").removeClass('field_error');
            $("#StaffTypeId").val(t.row($(this).parent('td').parent('tr')).data()["DesignationId"]);
            $("#StaffTypeName").val(t.row($(this).parent('td').parent('tr')).data()["DesignationName"]);
            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");
        });

        $("#StaffTypeName").blur(function () {
            var name = $("#StaffTypeName").val();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "/SchoolMaster/GetstafftypeName?name=" + name,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    if (data != null && data.length > 0) {
                        if (data[0]["name"].toLowerCase() == name.toLowerCase()) {
                            $("#spschnme").html("Staff type name must be unique.").show();
                            $("#StaffTypeName").val("");
                            $("#StaffTypeName").focus();
                            $("#StaffTypeName").addClass('field_error');
                            return false;
                        }
                        else {
                            $("#StaffTypeName").removeClass('field_error');
                            $("#spschnme").hide();
                            return true;
                        }
                    }
                    else {
                        $("#spschnme").hide();
                    }

                }
            });

        });
    });
    function frmClear() {
        $("#AccountCode").val('@_companyCode');
        $("#StaffTypeId").val(0);
        $("#StaffTypeName").val("");
        $("#StaffTypeName").attr("placeholder", "Enter staff type name");
        $("#StaffTypeName").removeClass('field_error');
        $("#spschnme").hide();
    }
</script>
<div class="page-bar">

    <ul class="page-breadcrumb">
        <li>
            <a href="/School/AdminDashboard">Home</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>Staff Type</span>
        </li>
    </ul>


    <div class="page-toolbar">
        @if (obj.CanAdd && Convert.ToInt32(Session["IsSchool"]) == 1)
        {
            <div class="">
                <a href="#" id="AddStaffType" class="btn btn-sm blue" style="float:right"> <i class="fa fa-plus"></i> Add Staff Type</a>
            </div>
        }

    </div>
</div>
<h1 class="page-title">
    <small></small>
</h1>
@if (obj.CanView && Convert.ToInt32(Session["IsSchool"]) == 1)
{
    <div class="row">
        <div class="col-md-12">
            <div class="portlet ">
                <div class="portlet-body">
                    <div>
                        <table id="tblStaffTypeMaster" class="table table-striped table-bordered table-hover table-checkable order-column">
                            <thead>
                                <tr>
                                    <th>Sr. No</th>
                                    <th hidden>Staff Type ID</th>
                                    <th>Staff Type</th>
                                    <th hidden>Is Active</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                    <div id="ajax_loaderbranch" class="modal_bg loading" aria-hidden="true">
                        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading"/>
                    </div>
                    <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                        <div class="modal-dialog">
                            <!-- Modal content-->
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Staff Type</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <fieldset>
                                                <div class="form-group">
                                                    <label class=" control-label">
                                                        @Html.Hidden("StaffTypeId")
                                                        @Html.Hidden("IsActive", true)
                                                        Name <span class="required" aria-required="true"> * </span>
                                                    </label>

                                                    <div class="editor-field">
                                                        @Html.Editor("StaffTypeName", new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = "50" } })
                                                        <span class="help-block" hidden id="spschnme" style="color:red;"></span>
                                                    </div>
                                                </div>
                                                <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                                                <div class="form-group">
                                                    <button type="button" class=" btn btn-sm blue" id="btnstafftypesubmit" style="float:right"> <i class="fa fa-check"></i> Save</button>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}
