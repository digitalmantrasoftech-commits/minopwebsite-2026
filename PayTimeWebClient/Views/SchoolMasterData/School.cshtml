                                                        Address <span class="required" aria-required="true"> * </span>
                                                    </label>
                                                    <div class="editor-field">
                                                        <input type="text" id="SchoolAddress" class="form-control input-sm" placeholder="Enter school Address" name="SchoolAddress" />
                                                        @*<textarea id="SchoolAddress" class="form-control input-sm"  rows="4" placeholder="Enter school Address" maxlength="150"></textarea>*@
                                                        <span class="help-block" hidden id="spschadd" style="color:red;"></span>
                                                        <input type="hidden" id="sclLetlng" name="sclLetlng" />
                                                    </div>
                                                </div>
                                                <div class="form-group" hidden>
                                                    <label class=" control-label">
                                                        SMS Event Type <span class="required" aria-required="true"> * </span>
                                                    </label>
                                                    <div class="editor-field">
                                                        @Html.DropDownList("smseventtypeid", new SelectList(new[] { "" }), "Select SMS Event Type", new { @class = "form-control input-sm", @disabled = "disabled" })
                                                    </div>
                                                </div>
                                                <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                                                <div class="form-group">
                                                    <button type="button" class=" btn btn-sm blue" id="btnschoolsubmit" style="float:right"> <i class="fa fa-check"></i> Save</button>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div id="map"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">Unauthorized Access.</span>
}

