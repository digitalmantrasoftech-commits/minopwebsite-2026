        function fillParentTable(selectedParent) {
            $("#ParentIds").empty();
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "/SchoolMaster/ParentGetAll",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            if (selectedParent.length != 0) {
                                var re = new RegExp("(^|,)" + response[i].ParentId + "($|,)");
                                if (re.test(selectedParent) == true) {
                                    $('#ParentIds').append('<option value=" ' + response[i].ParentId + '" selected>' + response[i].ParentName + '</option>');
                                }
                                else {
                                    $('#ParentIds').append('<option value=" ' + response[i].ParentId + ' ">' + response[i].ParentName + '</option>');
                                }
                            }
                            else {
                                $('#ParentIds').append('<option value=" ' + response[i].ParentId + ' ">' + response[i].ParentName + '</option>');
                            }
                        }
                        $selectPar.multiselect('rebuild');
                    }
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }
