                $("#spEmail").hide();
            }

        });


        $("#Email").change(function () {
            var EmpEmail = $("#Email").val();
            var url = "/MasterData/GetEmployeeEmail";
            $.get(url, { EmpEmail: EmpEmail }, function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                if (data != null) {
                    var obj = JSON.parse(data);
                    if (obj.MegSts == "Email error") {
                        $("#spEmail").html(obj.Meg).show();
                        $("#Email").val("");
                        $("#Email").focus();
                    }
                }
                else {
                    $("#spEmail").hide();
                }


            });
        });


