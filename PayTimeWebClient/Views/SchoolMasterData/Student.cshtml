                        { "title": "Is Active" },
                        { "title": "Photos" },
                        { "title": "" }
                    ]
                });
            },
            error: function () {
            }
        });
    }
    function valid() {
        var allVals = [];
        $("#ctblpar .ClsChkPar").each(function () {
            if ($(this).is(':checked') == true) {
                allVals.push($(this).attr("id"));
            }
        });
        if (allVals.length == 0) {
            $(".parentpopMsg").text("Please select parents");
            $(".parentpopMsg").show();
            return false;
        }
        return true;
    }
    function fillShiftdll(selectedShift) {
        $('#shiftid').empty();
        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             url: '@_webapiurl' + "Master/ShiftMasterGetAll",
             //contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 $("#shiftid").append("<option value='0'>Select shift</option>");
                 if (emprole == 6805) {
                     for (var x = 0; x < data.length; x++) {
                         if (data[x].GraceBefore.toString() == schoolid) {
                             $("#shiftid").append("<option value=" + data[x].ShiftId + ">" + data[x].ShiftName + "</option>");
                         }
                     }
                 }
                 else {
                     for (var x = 0; x < data.length; x++) {
                         $("#shiftid").append("<option value=" + data[x].ShiftId + ">" + data[x].ShiftName + "</option>");
                     }
                 }

                 $("#shiftid option[value = '" + selectedShift + "' ]").prop('selected', true);

             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 $('.loading').hide();

                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             },
         });
    }

    function fillRoutedll(selectedRoute) {
        $('#routeid').empty();
        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             url: '@_webapiurl' + "SchoolMaster/RouteGetAll",
             //contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 $("#routeid").append("<option value='0'>Select Bus Route</option>");
                 for (var x = 0; x < data.length; x++) {
                     $("#routeid").append("<option value=" + data[x].RouteId + ">" + data[x].RouteCode + "</option>");
                 }
                 $("#routeid option[value = '" + selectedRoute + "' ]").prop('selected', true);
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }
    function fillBusStopdll(selectedBusStopId) {
        $("#busstopid").empty();
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + "SchoolMaster/GetBusStopByRoute?id=" + $("#routeid").val(),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                $("#ajax_loaderCompany").hide();
                if (response != null) {
                    $("#busstopid").append("<option value='0'> Select Bus Stop </option>");
                    for (var i = 0; i < response.length; i++) {
                        $("#busstopid").append("<option value='" + response[i].Busstopid + "'>" + response[i].Busstopname + "</option>");
                    }
                    $("#busstopid option[value = '" + selectedBusStopId + "' ]").prop('selected', true);
                }
            }
        });
    }
