            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response != null) {
                    $('#Viewtblbusstopbody').empty();

                    for (var i = 0; i < response.length; i++) {
                        if (response[i].markertype == 0 || response[i].markertype == 1) {
                            var locate = new google.maps.LatLng(parseFloat(response[i].markerlat), parseFloat(response[i].markerlng));
                            var cnt = i + 1;
                            //if (response[i].markertype == 0) {
                            //    _tital = 'B'
                            //}
