    function CreateRectangle(_bounds, _Map) {
        _Rectangle = new google.maps.Rectangle({
            strokeColor: '#FF0000',
            strokeOpacity: 0.8,
            strokeWeight: 2,
            fillColor: '#FF0000',
            fillOpacity: 0.35,
            editable: true,
            map: _Map,
            bounds: _bounds
        });
        google.maps.event.addListener(_Rectangle, 'bounds_changed', function () {
            _Getbound = _Rectangle.bounds;
            _center = _Getbound.getCenter();
            NorthEast = _Getbound.getNorthEast();
            SouthWest = _Getbound.getSouthWest();
            $('#hdn_Getbound').val(_Getbound);
            $('#hdn_center').val(_center);
            $('#hdn_NorthEast').val(NorthEast);
            $('#hdn_SouthWest').val(SouthWest);
        });
