    var removecircle = function () {
        if (all_overlays.length > 0) {
            for (var i = 0; i < all_overlays.length; i++) {
                all_overlays[i].overlay.setMap(null);
            }
        }
        else {
            var Geooverlay = $('#hdn_Geooverlay').val();
            if (Geooverlay == 'circle') {
                _circle.setMap(null);
            }
            else if (Geooverlay == 'polygon') {
                _Polygon.setMap(null);
            }
            else if (Geooverlay == 'polyline') {
                _Polyline.setMap(null);
            }
            else if (Geooverlay == 'rectangle') {
                _Rectangle.setMap(null);
            }
        }
        all_overlays = [];
    }
