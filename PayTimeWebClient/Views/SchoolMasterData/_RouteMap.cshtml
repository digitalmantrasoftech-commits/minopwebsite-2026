                                var marker = new google.maps.Marker({
                                    position: locate,
                                    label: cnt.toString(),
                                    map: mapview
                                });

                            }
                            else if (response[i].markertype == 1) {
                                var marker = new google.maps.Marker({
                                    position: locate,
                                    label: cnt.toString(),
                                    map: mapview,
                                    icon: iconBase + 'dd-via.png'
                                });

                            }

                            if (response[i].markertype == 0) {
                                $('#Viewtblbusstopbody').append('<tr id="rw' + cnt + '"><td><b>' + cnt + '</b></td><td>' + response[i].Busstopname + '</td><td>Busstop</td></tr>');
                            }
                            if (response[i].markertype == 1) {
                                $('#Viewtblbusstopbody').append('<tr id="rw' + cnt + '"><td><b>' + cnt + '</b></td><td>' + response[i].Busstopname + '</td><td>WayPoint</td></tr>');
                            }


                            waypoints.push({ location: locate, stopover: true });
                            var request = {
                                origin: startltlg,
                                destination: endltlg,
                                waypoints: waypoints,
                                optimizeWaypoints: true,
                                travelMode: google.maps.TravelMode.DRIVING
                            };
                            directionsService.route(request, function (response, status) {
                                if (status == google.maps.DirectionsStatus.OK) {
                                    directionsDisplay.setDirections(response);
                                }
                            });
                        }
                    }
                }
            }
        });
        directionsDisplay.setMap(mapview);
        //Add GeoFencing
        $.ajax({
            type: "POST",
            headers: { 'Authorization': apiToken },
