    function computeTotalDistance(result) {

        var total = 0;
        var durtotal = 0;
        var myroute = result.routes[0];
        for (var i = 0; i < myroute.legs.length; i++) {
            total += myroute.legs[i].distance.value;
            durtotal += result.routes[0].legs[0].duration.value;
        }
        total = total / 1000;
        durtotal = Math.floor(durtotal / 60);
        //document.getElementById('total').innerHTML = total + ' km';
        document.getElementById('total').innerHTML = total + ' km';
        document.getElementById('totaldu').innerHTML = durtotal + ' min';
        document.getElementById('TDK').innerHTML = total + ' km';
        document.getElementById('TDM').innerHTML = durtotal + ' min';
        document.getElementById('OP').innerHTML = $("#searchboxinput").val();
        document.getElementById('DP').innerHTML = $("#searchboxinput1").val();

    }

