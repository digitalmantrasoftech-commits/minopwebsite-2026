    function initMap(vpos) {


        map = new google.maps.Map(document.getElementById('map_content'), {
            center: vpos,
            zoom: 10,
            mapTypeId: google.maps.MapTypeId.ROADMAP
        });


        geocoder = new google.maps.Geocoder();
        directionsService = new google.maps.DirectionsService();
        directionsDisplay = new google.maps.DirectionsRenderer({
            suppressMarkers: true,
            draggable: true
        });
        directionsDisplay.setMap(map);
        showsmarker(map, vpos, 'school', false);
        showsmarker(map, vpos, 'start', true);
        showsmarker(map, vpos, 'end', true);
        Placeservice(vpos, geocoder, 'start');
        Placeservice(vpos, geocoder, 'end');

        new AutocompleteDirectionsHandler(map);
    }

    function showsmarker(map, pos, id, isdraggable) {

        if (id == 'start') {
            markerstart = new google.maps.Marker({
                position: pos,
                map: map,
                draggable: isdraggable,
                icon: iconBase + 'trip-start.png',
                title: "Start"
            });
            markerstart.setVisible(true);
            if ($("#hdnrtid").val() == 0) {
                $("#hdnfrm").val(markerstart.getPosition().toString());
            }
            markerstart.addListener('dragend', function () {
                directionsDisplay.set('directions', null);
                Placeservice(markerstart.getPosition(), geocoder, 'start');
            });
        }
        if (id == 'end') {
            markerend = new google.maps.Marker({
                position: pos,
                map: map,
                draggable: isdraggable,
                icon: iconBase + 'trip-end.png',
                title: "end"
            });
            markerend.setVisible(true);
            if ($("#hdnrtid").val() == 0) {
                $("#hdnto").val(markerend.getPosition().toString());
            }
            markerend.addListener('dragend', function () {
                directionsDisplay.set('directions', null);
                Placeservice(markerend.getPosition(), geocoder, 'end');
            });
        }


        if (id == 'school') {
            schoolmarker = new google.maps.Marker({
                position: pos,
                map: map,
                icon: iconBase + 'School.png',
                title: "school"
            });
        }
    }

    function showroute() {
        waypoints = [];
        for (var i = 0; i < placearr.length; i++) {
            if (placearr[i]['Ptype'] == 0 || placearr[i]['Ptype'] == 1) {
                var lg = placearr[i]['latlng'];
                var alg = lg.split(',');
                var locate = new google.maps.LatLng(parseFloat(alg[0]), parseFloat(alg[1]));
                waypoints.push({ location: locate, stopover: true });
            }
        }
        var sinput = $("#hdnfrm").val().replace('(', '').replace(')', '');
        var einput = $("#hdnto").val().replace('(', '').replace(')', '');


        var pos_source = sinput.split(',', 2);
        var pos_dest = einput.split(',', 2);

        var start = new google.maps.LatLng(parseFloat(pos_source[0]), parseFloat(pos_source[1]));
        var end = new google.maps.LatLng(parseFloat(pos_dest[0]), parseFloat(pos_dest[1]));

        var request = {
            origin: start,
            destination: end,
            waypoints: waypoints,
            optimizeWaypoints: true,
            travelMode: google.maps.TravelMode.DRIVING
        };
        directionsService.route(request, function (response, status) {
            if (status == google.maps.DirectionsStatus.OK) {


                directionsDisplay.setDirections(response);

                //response.routes[0].legs[0].start_address
                //response.routes[0].legs[0].end_address
                //response.routes[0].legs[0].distance.text
                //response.routes[0].legs[0].duration.text
                //response.routes[0].legs[0].start_location.toString()
                //response.routes[0].legs[0].end_location.toString();
                //$("#hdnfrm").val(response.routes[0].legs[0].start_location.toString());
                //$("#hdnto").val(response.routes[0].legs[0].end_location.toString());
                $("#searchboxinput").val(response.routes[0].legs[0].start_address);
                //$("#searchboxinput1").val(response.routes[0].legs[0].end_address);
                computeTotalDistance(directionsDisplay.getDirections());
            }
        });


    }

    function Placeservice(latlng, geocoder, point) {
        //var input = event.latLng.toString().replace('(', '').replace(')', '');
        var _placename = '';
        //var latlngStr = input.split(',', 2)
        //var latlng = { lat: parseFloat(latlngStr[0]), lng: parseFloat(latlngStr[1]) };

        //alert(latlng.toString());
        geocoder.geocode({ 'location': latlng }, function (results, status) {
            if (status === 'OK') {
                if (results[0]) {
                    _placename = results[0].formatted_address;


                    if (point == 'se') {
                        //AutocompleteDirectionsHandler.prototype.setupPlaceChangedListener(destinationAutocomplete, 'DEST');
                        $("#hdnfrm").val(latlng.toString());
                        $("#hdnto").val(latlng.toString());
                        document.getElementById('start').value = _placename;
                        document.getElementById('end').value = _placename;
                        $("#searchboxinput").val(_placename);
                        $("#searchboxinput1").val(_placename);
                    }
                    if (point == 'start') {
                        document.getElementById('start').value = _placename;
                        //AutocompleteDirectionsHandler.prototype.setupPlaceChangedListener(originAutocomplete, 'ORIG');
                        $("#hdnfrm").val(latlng.toString());
                        $("#searchboxinput").val(_placename);
                    }
                    if (point == 'end') {
                        document.getElementById('end').value = _placename;
                        //AutocompleteDirectionsHandler.prototype.setupPlaceChangedListener(destinationAutocomplete, 'DEST');
                        $("#hdnto").val(latlng.toString());
                        $("#searchboxinput1").val(_placename);
                    }

                    showroute();

                } else {
                    window.alert('No results found');

                }
            } else {
                window.alert('Geocoder failed due to: ' + status);
            }
        });


    }


    function AutocompleteDirectionsHandler(map) {
        this.map = map;
        originPlaceId = null;
        destinationPlaceId = null;
        this.travelMode = 'DRIVING';

        var busstopsearch = document.getElementById('start_busstop');
        //var modeSelector = document.getElementById('mode-selector');
        this.directionsService = new google.maps.DirectionsService;
        this.directionsDisplay = new google.maps.DirectionsRenderer({ suppressMarkers: true });
        this.directionsDisplay.setMap(map);

        originAutocomplete = new google.maps.places.Autocomplete(originInput);
        destinationAutocomplete = new google.maps.places.Autocomplete(destinationInput);
        var busstopAutocomplete = new google.maps.places.Autocomplete(busstopsearch);

        //this.setupClickListener('changemode-walking', 'WALKING');
        //this.setupClickListener('changemode-transit', 'TRANSIT');
        //this.setupClickListener('changemode-driving', 'DRIVING');

        this.setupPlaceChangedListener(originAutocomplete, 'ORIG');
        this.setupPlaceChangedListener(destinationAutocomplete, 'DEST');
        this.setupPlaceChangedListener(busstopAutocomplete, 'BUSSTOP');
        //this.map.controls[google.maps.ControlPosition.TOP_LEFT].push(originInput);
        //this.map.controls[google.maps.ControlPosition.TOP_LEFT].push(destinationInput);
        //this.map.controls[google.maps.ControlPosition.TOP_LEFT].push(modeSelector);
    }



    AutocompleteDirectionsHandler.prototype.setupPlaceChangedListener = function (autocomplete, mode) {

        //alert(mode);

        var me = this;
        autocomplete.bindTo('bounds', map);
        autocomplete.addListener('place_changed', function () {
            var place = autocomplete.getPlace();
            if (!place.place_id) {
                window.alert("Please select an option from the dropdown list.");
                return;
            }
            if (mode == 'ORIG') {
                originPlaceId = place.place_id;
                markerstart.setVisible(false);
                showsmarker(map, Getposlatlng(place.geometry.location.toString()), 'start', true);
                $("#searchboxinput").val(place.name + '|' + place.formatted_address);
                $("#hdnfrm").val(place.geometry.location.toString());

            } else if (mode == 'DEST') {
                destinationPlaceId = place.place_id;
                $("#searchboxinput1").val(place.name + '|' + place.formatted_address);
                markerend.setVisible(false);
                showsmarker(map, Getposlatlng(place.geometry.location.toString()), 'end', true);
                $("#hdnto").val(place.geometry.location.toString());
            }
            else if (mode == 'BUSSTOP') {

                me.map.setCenter(place.geometry.location);
                me.map.setZoom(15);
            }
            directionsDisplay.set('directions', null);
            showroute();
            //me.route();
        });

    };


    AutocompleteDirectionsHandler.prototype.route = function () {
        if (!originPlaceId || !destinationPlaceId) {
            return;
        }
        var me = this;

        this.directionsService.route({
            origin: { 'placeId': originPlaceId },
            destination: { 'placeId': destinationPlaceId },
            waypoints: waypts,
            optimizeWaypoints: true,
            travelMode: this.travelMode
        }, function (response, status) {
            if (status === 'OK') {

                me.directionsDisplay.setDirections(response);
                computeTotalDistance(me.directionsDisplay.getDirections());
            } else {
                window.alert('Directions request failed due to ' + status);
            }
        });
    };

