            if ($("#ddlBranch").val() == "0") {
                $("<div class='alert alert-danger overlay'><label>Please select Class</label></div>").insertBefore(".portlet-body").fadeOut(3000);
                return false;
            }

            clearform();

            $("#btnstudenttransfer").attr("data-toggle", "modal");
            $("#btnstudenttransfer").attr("data-target", "#frmpopup");
            filldepartment();
        });
        function clearform() {
            $("#ddlSchool").val("0");
            $("#ddlClass").val("0");
            $("#ddldivision").val("0");
            $("#DeptIds").val("0");
            $("#tblEmp").empty();
