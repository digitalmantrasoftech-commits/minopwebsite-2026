    function save() {
        if (valid()) {
            var allVals = [];
            $("#tblEmp .ClsChkEmp").each(function () {
                if ($(this).is(':checked') == true) {
                    allVals.push($(this).attr("id"));
                }
            });

            if ($("#ddlSchool").val() == "0") {
                $("<div class='alert alert-danger overlay'><label>Please select School</label></div>").insertBefore(".popMsg").fadeOut(3000);
                return false;
            }
            
            if ($("#ddlClass").val() == "0") {
                $("<div class='alert alert-danger overlay'><label>Please select Class</label></div>").insertBefore(".popMsg").fadeOut(3000);
                return false;
            }
          
            if ($("#ddldivision").val() == "0") {
                $("<div class='alert alert-danger overlay'><label>Please select Division</label></div>").insertBefore(".popMsg").fadeOut(3000);
                return false;
            }
           

            var obj = {
                "Studentids": allVals,
                "NewSchool": $("#ddlSchool").val(),
                "Newclass": $("#ddlClass").val(),
                "Newdivision": $("#ddldivision").val()
            };

            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + "SchoolMaster/StudentTransfer",
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: "false",
                beforeSend: function () {
                    $("#ajax_loaderCompany").show();
                },
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    if (response != null) {
                        if (response.MsgSts == "ok") {
                            $('#frmpopup').modal('toggle');
                            $(".alert-danger").hide();
                            $(".alert-success").text(response.Msg);
                            $(".alert-success").show();
                            $('.alert-success').fadeIn('fast').delay(3000).fadeOut('slow');
                            $("#ddlcompany").val(0);
                            $("#ddlBranch").val(0);
                        }
                        else {
                            $(".alert-danger").text(response.Msg);
                            $(".alert-danger").show();
                            $('.alert-danger').fadeIn('fast').delay(3000).fadeOut('slow');
                        }
                    }
                    $("#ajax_loaderCompany").hide();
                },
                error: function (response) {
                    $("#ajax_loaderCompany").hide();
                },
            });
        }
    }

    function getEmp() {
        $("#lblemp").show();
        $("#tblEmp").empty();
        var bID = $("#ddlBranch").val();
        $.post("/Transactions/GetEmpByDept?empArr=" + DeptIdlst + ";" + bID, function (response) {
            if (response.isRedirect) {
                window.location.href = response.redirectUrl;
            }
            var table = "";
            if (response != null) {
                for (var i = 0; i < response.length; i++) {

                    var tbl = "<tr class='odd gradeX'>";
                    tbl = tbl + "<td id='eid' hidden>" + response[i].EmpId;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='ecode'>" + response[i].Empcode;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='enm'>" + response[i].EmpName;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id='epid'>" + response[i].EmpPunchID;
                    tbl = tbl + "</td>";
                    tbl = tbl + "<td id=''><input type='checkbox'  class='ClsChkEmp' id='" + response[i].EmpId + "'/>";
                    tbl = tbl + "</td>";
                    tbl = tbl + "</tr>";
                    table += tbl;
                }
            }
            $("#tblEmp").destroy;
            $('#tblEmp').append(table);
            $('#tblEmp').dataTable({
                "columnDefs": [
                                    {
                                        "targets": [0],
                                        "visible": false,
                                        "searchable": false,
                                    }

                ],
                "destroy": true,
                "bInfo": false,
                "bPaginate": false,
                "bLengthChange": false,
                "columns": [
                    { "title": "Employee ID" },
                    { "title": "Code" },
                    { "title": "Name" },
                    { "title": "Punch ID" },
                    { "title": "<input type='checkbox' class='ClsChkAllDept' onchange='AllCheckedEmp(this)' />" }
                ]
            });
        });
    }
    function AllCheckedDept(ths) {
        $(".popMsg").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkDept").prop('checked', true);

        }
        else {
            $(".ClsChkDept").prop('checked', false);
        }

    }
    function AllCheckedEmp(ths) {
        $(".popMsg").hide();
        if ($(ths).prop('checked') == true) {
            $(".ClsChkEmp").prop('checked', true);

        }
        else {
            $(".ClsChkEmp").prop('checked', false);
        }

    }
    var _urlschool = '@_webapiurl' + 'Master/CompanyGetAll';
    var _urlclass = '@_webapiurl' + "Master/BranchGetAll";
    if (emprole == '6805') {
        _urlschool = '@_webapiurl' + 'Master/CompanyGetById?id=' + schoolid;
        _urlclass = '@_webapiurl' + 'Master/BranchGetAllbycmp?id=' + schoolid;
    }
    function fillcompany(selectedcompanyid) {
        $('#ddlcompany').empty();

        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             url: _urlschool,
             //contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 $("#ddlcompany").append("<option value='0'>Select School</option>");
                 for (var x = 0; x < data.length; x++) {
                     $("#ddlcompany").append("<option value=" + data[x].CompanyID + ">" + data[x].CompanyName + "</option>");
                 }
                 //$("#ddlcompany").append("<option value='-1'>All Company</option>");
                 $("#ddlcompany option[value = '" + selectedcompanyid + "' ]").prop('selected', true);
                 fillbranch(0);
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }
    function fillSchool(selectedschoolid) {
        $('#ddlSchool').empty();
        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             url: _urlschool,
             //contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 $("#ddlSchool").append("<option value='0'>Select School</option>");
                 for (var x = 0; x < data.length; x++) {
                     $("#ddlSchool").append("<option value=" + data[x].CompanyID + ">" + data[x].CompanyName + "</option>");
                 }
                 //$("#ddlcompany").append("<option value='-1'>All Company</option>");
                 $("#ddlSchool option[value = '" + selectedschoolid + "' ]").prop('selected', true);
                 fillClass(0);
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }
    function fillClass(selectedschoolid) {

        $('#ddlClass').empty();
        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             url: _urlclass,
             //contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 $("#ddlClass").append("<option value='0'>Select Class</option>");
                 for (var x = 0; x < data.length; x++) {
                     if (data[x].CompanyID == selectedschoolid) {
                         $("#ddlClass").append("<option value=" + data[x].BranchId + ">" + data[x].branchname + "</option>");
                     }
                 }
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }
    function filldivision(classid) {
        $("#ddldivision").empty();
        $.ajax({
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            url:'@_webapiurl'+ "Master/DepartmentGetAll",
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            async: "false",
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                $("#ddldivision").append("<option value='0'>Select Division</option>");
                if (response != null) {
                    for (var i = 0; i < response.length; i++) {
                            $('#ddldivision').append('<option value=" ' + response[i].DepartmentId + ' ">' + response[i].DepartmentName + '</option>');
                    }
                }
            }
        });
    }
    function fillbranch(selectedcompanyid) {
        $('#ddlBranch').empty();
        $.ajax(
         {
             type: "GET",
             headers: { 'Authorization': '@_tokan' },
             url: _urlclass,
             //contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 $("#ddlBranch").append("<option value='0'>Select Class</option>");
                 for (var x = 0; x < data.length; x++) {
                     if (data[x].CompanyID == selectedcompanyid) {
                         $("#ddlBranch").append("<option value=" + data[x].BranchId + ">" + data[x].branchname + "</option>");
                     }
                 }

                 //$("#ddlBranch").append("<option value='-1'>All Class</option>");
                 if (selectedcompanyid == '-1') {
                     $("#ddlBranch option[value = '-1' ]").prop('selected', true);
                 }


             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }
    function valid() {
        var allVals = [];
        $("#tblEmp .ClsChkEmp").each(function () {
            if ($(this).is(':checked') == true) {
                allVals.push($(this).attr("id"));
            }
        });
        if (allVals.length == 0) {
            if($("#DeptIds").val()==0 || $("#DeptIds").val()==null ){
                $("<div class='alert alert-danger overlay'><label>Please select Division</label></div>").insertBefore(".popMsg").fadeOut(3000);
            }
            else
            {
                $("<div class='alert alert-danger overlay'><label>Please select Student</label></div>").insertBefore(".popMsg").fadeOut(3000);
            }
           
            return false;
        }
       
        return true;
    }

</script>
