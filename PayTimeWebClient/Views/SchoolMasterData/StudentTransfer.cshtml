                                $("#spValidation").hide();
                            }
                            var ArrDept = $("#txt2").val();
                            DeptIdlst = ArrDept;
                            getEmp();
                        });
                    }
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }

        $("#btnSave").click(function () {
            save();
        });


