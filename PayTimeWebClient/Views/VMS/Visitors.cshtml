@{
    if (HttpContext.Current.Session["tokan"] == null || string.IsNullOrEmpty(HttpContext.Current.Session["tokan"].ToString()))
    {
        Response.Redirect("~/Account/Logoff");
        return;
    }
    ViewBag.Title = "Visitors";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
}

@*<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">*@

<script>
    // ==================== VMS BASE URL ====================
    // Change this to your VMS_Frontend project URL
    var _vmsBaseUrl = "https://localhost:44369";
    // ======================================================

    var visitorTable;
    var allVisitors = [];

    $(document).ready(function () {

        // DataTable initialisation (empty, will be loaded via AJAX)
        $("#tblbuwise tfoot th").each(function () {
            var title = $(this).text();
            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
        });

        visitorTable = $("#tblbuwise").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            ordering: true,
            columnDefs: [
                { orderable: false, targets: [8] }
            ],
        });
        setTimeout(function () {
            $("#" + "tblbuwise" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        // Apply the column Search
        $("#tblbuwise thead").on("keyup", "input", function () {
            visitorTable.column($(this).parent().index())
                .search(this.value)
                .draw();
        });

        // Load visitors on page load
        loadVisitors();

        // Filter Click Open Modal Code =========================
        $("#AddVisitor_btn").on('click', function () {
            clearAddVisitorForm();
            $("#AddVisitor_btn").attr("data-toggle", "modal");
            $("#AddVisitor_btn").attr("data-target", "#AddVisitor_btn_modal");
        });

        $(".RescheduleBtn").on('click', function () {
            $(".RescheduleBtn").attr("data-toggle", "modal");
            $(".RescheduleBtn").attr("data-target", "#RescheduleBtn_modal");
        });

        $(".CheckIn").on('click', function () {
            $(".CheckIn").attr("data-toggle", "modal");
            $(".CheckIn").attr("data-target", "#CheckIn_modal");
        });

        $(".RePrint").on('click', function () {
            $(".RePrint").attr("data-toggle", "modal");
            $(".RePrint").attr("data-target", "#RePrint_modal");
        });

        //  Dropdown Multiselect code
        var $Floorselect = $("#FloorID").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Floor'
        });

        // Check In Modal Step Navigation ========================
        $(document).on('click', '#NextBtn', function () {
            var $stepper = $("#CheckIn_modal .checkin-stepper");
            $stepper.find(".stepper-circle").addClass("completed");
            $stepper.find(".stepper-circle:last").html('<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13.3334 4L6.00008 11.3333L2.66675 8" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');
            $stepper.find(".stepper-line").addClass("completed");
            $stepper.find(".stepper-label").removeClass("active");
            $stepper.find(".stepper-label:last").addClass("active");
            $("#CheckIn_modal .checkin-section").hide();
            $("#CheckIn_modal .checkin-step-2").show();
            $(".checkin-footer-step1").hide();
            $(".checkin-footer-step2").show();
        });

        $(document).on('click', '#PrevBtn', function () {
            var $stepper = $("#CheckIn_modal .checkin-stepper");
            $stepper.find(".stepper-circle:last").removeClass("completed").html("");
            $stepper.find(".stepper-line").addClass("completed");
            $stepper.find(".stepper-label").removeClass("active");
            $stepper.find(".stepper-label:first").addClass("active");
            $("#CheckIn_modal .checkin-section").show();
            $("#CheckIn_modal .checkin-step-2").hide();
            $(".checkin-footer-step1").show();
            $(".checkin-footer-step2").hide();
        });

        // Authorization Type Radio Toggle
        $(document).on('change', 'input[name="authType"]', function () {
            if ($(this).val() === 'assign_floor') {
                $(".authorize-assign-floor").show();
                $(".authorize-admit-card").hide();
            } else {
                $(".authorize-assign-floor").hide();
                $(".authorize-admit-card").show();
            }
        });

        // Browse Photo - trigger file input
        $(document).on('click', '#btnBrowsePhoto', function () {
            $('#fileAdmitPhoto').click();
        });

        // File selected - show file name
        $(document).on('change', '#fileAdmitPhoto', function () {
            var file = this.files[0];
            if (file) {
                $('#fileName').text(file.name);
                $('#fileInfo').show();
            }
        });

        // Remove file
        $(document).on('click', '#btnRemoveFile', function () {
            $('#fileAdmitPhoto').val('');
            $('#fileName').text('');
            $('#fileInfo').hide();
        });

        // Select All Devices checkbox
        $(document).on('change', '#chkAllDevices', function () {
            $('.chkDevice').prop('checked', $(this).prop('checked'));
        });
        $(document).on('change', '.chkDevice', function () {
            var total = $('.chkDevice').length;
            var checked = $('.chkDevice:checked').length;
            $('#chkAllDevices').prop('checked', total === checked);
        });

        // Reset modal on close
        $("#CheckIn_modal").on('hidden.bs.modal', function () {
            var $stepper = $(this).find(".checkin-stepper");
            $stepper.find(".stepper-circle:last").removeClass("completed").html("");
            $stepper.find(".stepper-label").removeClass("active");
            $stepper.find(".stepper-label:first").addClass("active");
            $(this).find(".checkin-section").show();
            $(this).find(".checkin-step-2").hide();
            $(".checkin-footer-step1").show();
            $(".checkin-footer-step2").hide();
            $('input[name="authType"][value="assign_floor"]').prop('checked', true);
            $(".authorize-assign-floor").show();
            $(".authorize-admit-card").hide();
        });

        // ==================== FORM SUBMIT HANDLERS ====================

        // Register Visitor Submit
        $("#SubmitVisitor").on('click', function () {
            var visitorData = {
                VisitorName: $("#txtVisitorName").val(),
                VisitorEmail: $("#txtVisitorEmail").val(),
                VisitorCompany: $("#txtVisitorCompany").val(),
                HostEmployee: $("#ddlHostEmployee").val(),
                VisitDate: $("#txtVisitDate").val(),
                VisiteTime: $("#txtVisitTime").val(),
                Purpose: $("#txtPurposeOfVisit").val(),
                PhoneNumber: $("#txtVisitorPhone").val(),
                VisitorType: $("#ddlVisitorType option:selected").val(),
                Location: $("#ddlVisitLocation option:selected").val(),
                NoOfVisitor: $("#txtNoOfVisitors").val(),
                Gender: $("#ddlGender option:selected").val(),
                CreateBy :"555"
            };

            if (!visitorData.VisitorName || !visitorData.VisitorEmail || !visitorData.VisitDate || !visitorData.VisitorCompany)
            {
                toastr.error("Please fill in all required fields.");
                return;
            }

            createVisitor(visitorData);
        });

        // Reschedule Submit
        $("#SubmitRescheduleBtn").on('click', function () {
            var visitorId = $("#hdnRescheduleVisitorId").val();
            var newDate = $("#txtRescheduleDate").val();
            var newTime = $("#txtRescheduleTime").val();

            if (!newDate) {
                toastr.error("Please select a visit date.");
                return;
            }

            rescheduleVisitor(visitorId, newDate, newTime);
        });

        // Check In Submit
        $(document).on('click', '#CheckInBtn', function () {
            var visitorId = $("#hdnCheckInVisitorId").val();
            checkInVisitor(visitorId);
        });

        // Clear Add Visitor Form
        $("#ClearVisitorBtn").on('click', function () {
            clearAddVisitorForm();
        });

        // Clear Reschedule Form
        $("#ClearRescheduleBtn").on('click', function () {
            $("#txtRescheduleDate").val('');
            $("#txtRescheduleTime").val('');
        });
    });

    // ==================== AJAX FUNCTIONS ====================

    // Load all visitors
    function loadVisitors() {
        showLoader();        
        $.ajax({
            url: _vmsBaseUrl + "/Visitor/GetAll",
            type: "GET",
            dataType: "json",
            success: function (response) {
                hideLoader();                
                if (response.Success && response.Data) {

                    allVisitors = response.Data;
                    bindVisitorTable(allVisitors);
                    updateSummary(allVisitors);
                    $("#NotificationGrid-empty").hide();
                    $("#tableResponsive").show();
                } else {
                    allVisitors = [];
                    bindVisitorTable([]);
                    updateSummary([]);
                    $("#NotificationGrid-empty").show();
                    $("#tableResponsive").hide();
                }
            },
            error: function (xhr, status, error) {
                hideLoader();
                toastr.error("Failed to load visitors. Please try again.");
                console.error("Load Visitors Error:", error);
                $("#NotificationGrid-empty").show();
                $("#tableResponsive").hide();
            }
        });
    }

    // Bind visitor data to DataTable
    function bindVisitorTable(visitors) {
        visitorTable.clear();

        $.each(visitors, function (index, v) {
            
            var checkIn = v.CheckIn ? formatDateTime(v.CheckIn) : "--:--:--";
            var checkOut = v.CheckOut ? formatDateTime(v.CheckOut) : "--:--:--";
            var statusClass = getStatusClass(v.Status);
            var statusText = v.Status || "Pending";
            var visitDate = v.VisitDate ? formatDate(v.VisitDate) : "2026-03-02";
            var visitorType = v.VisitorType || "";
            var noOfVisitors = v.NoOfVisitor || "";

            var actionBtns = getActionButtons(v);

            visitorTable.row.add([
                v.VisitorName || "",
                v.HostEmployee || "",
                visitDate,
                v.Purpose || "",
                '<span>' + checkIn + '</span> / <span>' + checkOut + '</span>',
                visitorType,
                '<span class="' + statusClass + '">' + statusText + '</span>',
                v.CreateBy || "",
                actionBtns
            ]);
        });

        visitorTable.draw();

        // Re-bind tooltips after draw
        setTimeout(function () {
            $('.tooltips').tooltip();
        }, 100);
    }

    // Get action buttons based on status
    function getActionButtons(visitor) {
        var btns = '';
        var id = visitor.Id;

        if (visitor.Status === "Pending" || visitor.Status === "Approved") {
            btns += '<a class="btn blue_btnnew tooltips btnReschedule" data-placement="left" data-original-title="Reschedule" data-id="' + id + '" onclick="openRescheduleModal(' + id + ')"><i class="fa-regular fa-timer"></i></a> ';
            btns += '<a class="btn blue_btnnew tooltips btnCheckIn" data-placement="left" data-original-title="Check In" data-id="' + id + '" onclick="openCheckInModal(' + id + ')"><i class="fa-solid fa-check"></i></a> ';
        }

        if (visitor.Status === "CheckedIn") {
            btns += '<a class="btn blue_btnnew tooltips btnRePrint" data-placement="left" data-original-title="Re-Print" data-id="' + id + '" onclick="openRePrintModal(' + id + ')"><i class="fa-regular fa-print"></i></a> ';
            btns += '<a class="btn blue_btnnew tooltips btnCheckOut" data-placement="left" data-original-title="Check Out" data-id="' + id + '" onclick="checkOutVisitor(' + id + ')"><i class="fa-solid fa-xmark"></i></a> ';
        }

        if (visitor.Status === "CheckedOut") {
            btns += '<a class="btn blue_btnnew tooltips btnRePrint" data-placement="left" data-original-title="Re-Print" data-id="' + id + '" onclick="openRePrintModal(' + id + ')"><i class="fa-regular fa-print"></i></a> ';
        }

        if (visitor.Status === "Rejected") {
            btns += '<a class="btn blue_btnnew tooltips btnRePrint" data-placement="left" data-original-title="Re-Print" data-id="' + id + '" onclick="openRePrintModal(' + id + ')"><i class="fa-regular fa-print"></i></a> ';
        }

        return btns;
    }

    // Update summary counts
    function updateSummary(visitors) {
        var total = visitors.length;
        var activeToday = 0;
        var pending = 0;
        var completed = 0;
        var today = new Date().toDateString();

        $.each(visitors, function (i, v) {
            if (v.Status === "Pending") pending++;
            if (v.Status === "CheckedOut") completed++;
            if (v.Status === "CheckedIn") {
                activeToday++;
            }
            if (v.Status === "Approved") {
                var visitDate = new Date(v.VisitDate).toDateString();
                if (visitDate === today) activeToday++;
            }
        });

        $("#spnTotalRecords").text(total);
        $("#spnActiveToday").text(activeToday);
        $("#spnPending").text(pending);
        $("#spnCompleted").text(completed);
    }

    // Create new visitor
    function createVisitor(visitorData) {
        showLoader();        
        $.ajax({
            url: _vmsBaseUrl + "/Visitor/Create",
            type: "POST",
            data: visitorData,
            dataType: "json",            
            success: function (response) {
                hideLoader();
                if (response.Success) {
                    toastr.success("Visitor registered successfully.");
                    $("#AddVisitor_btn_modal").modal('hide');
                    clearAddVisitorForm();
                    loadVisitors();
                } else {
                    toastr.error(response.Message || "Failed to register visitor.");
                }
            },
            error: function (xhr, status, error) {
                hideLoader();
                toastr.error("Failed to register visitor. Please try again.");
                console.error("Create Visitor Error:", error);
            }
        });
    }

    // Reschedule visitor
    function rescheduleVisitor(visitorId, newDate, newTime) {
        showLoader();
        $.ajax({
            url: _vmsBaseUrl + "/Visitor/Edit",
            type: "POST",
            data: {
                Id: visitorId,
                VisitDate: newDate
            },
            dataType: "json",
            success: function (response) {
                hideLoader();
                if (response.Success) {
                    toastr.success("Visitor rescheduled successfully.");
                    $("#RescheduleBtn_modal").modal('hide');
                    loadVisitors();
                } else {
                    toastr.error(response.Message || "Failed to reschedule visitor.");
                }
            },
            error: function (xhr, status, error) {
                hideLoader();
                toastr.error("Failed to reschedule visitor. Please try again.");
                console.error("Reschedule Visitor Error:", error);
            }
        });
    }

    // Check in visitor
    function checkInVisitor(visitorId) {
        showLoader();
        $.ajax({
            url: _vmsBaseUrl + "/Visitor/CheckIn",
            type: "POST",
            data: { id: visitorId },
            dataType: "json",
            success: function (response) {
                hideLoader();
                if (response.Success) {
                    toastr.success("Visitor checked in successfully.");
                    $("#CheckIn_modal").modal('hide');
                    loadVisitors();
                } else {
                    toastr.error(response.Message || "Failed to check in visitor.");
                }
            },
            error: function (xhr, status, error) {
                hideLoader();
                toastr.error("Failed to check in visitor. Please try again.");
                console.error("Check In Error:", error);
            }
        });
    }

    // Check out visitor
    function checkOutVisitor(visitorId) {
        if (!confirm("Are you sure you want to check out this visitor?")) return;

        showLoader();
        $.ajax({
            url: _vmsBaseUrl + "/Visitor/CheckOut",
            type: "POST",
            data: { id: visitorId },
            dataType: "json",
            success: function (response) {
                hideLoader();
                if (response.Success) {
                    toastr.success("Visitor checked out successfully.");
                    loadVisitors();
                } else {
                    toastr.error(response.Message || "Failed to check out visitor.");
                }
            },
            error: function (xhr, status, error) {
                hideLoader();
                toastr.error("Failed to check out visitor. Please try again.");
                console.error("Check Out Error:", error);
            }
        });
    }

    // Get visitor by ID
    function getVisitorById(visitorId, callback) {
        showLoader();
        $.ajax({
            url: _vmsBaseUrl + "/Visitor/GetById/" + visitorId,
            type: "GET",
            dataType: "json",
            success: function (response) {
                hideLoader();
                if (response.Success && response.Data) {
                    callback(response.Data);
                } else {
                    toastr.error("Visitor details not found.");
                }
            },
            error: function (xhr, status, error) {
                hideLoader();
                toastr.error("Failed to load visitor details.");
                console.error("GetById Error:", error);
            }
        });
    }

    // ==================== MODAL OPEN FUNCTIONS ====================

    // Open Reschedule Modal with visitor data
    function openRescheduleModal(visitorId) {
        $("#hdnRescheduleVisitorId").val(visitorId);
        $("#txtRescheduleDate").val('');
        $("#txtRescheduleTime").val('');
        $("#RescheduleBtn_modal").modal('show');
    }

    // Open Check In Modal with visitor details
    function openCheckInModal(visitorId) {
        $("#hdnCheckInVisitorId").val(visitorId);
        getVisitorById(visitorId, function (visitor) {
            // Populate Visitor Details
            $("#ciVisitorName").text(visitor.VisitorName || "-");
            $("#ciAssignedDate").text(visitor.CreatedDate ? getTimeAgo(visitor.CreatedDate) : "-");
            $("#ciCreatedBy").text(visitor.CreateBy || "-");
            $("#ciStatus").text(visitor.Status || "Pending");
            $("#ciFromDate").text(visitor.VisitDate ? formatDate(visitor.VisitDate) : "-");
            $("#ciToDate").text(visitor.VisitDate ? formatDate(visitor.VisitDate) : "-");

            var noOfVisitors = visitor.NoOfVisitor || "-";
            $("#ciNoOfVisitors").text(noOfVisitors);
            $("#ciPurpose").text(visitor.Purpose || "-");

            // Populate Host Details
            $("#ciHostName").text(visitor.HostEmployee || "-");
            $("#ciHostRole").text(visitor.Department || "-");
            $("#ciHostDept").text(visitor.Department || "-");

            $("#CheckIn_modal").modal('show');
        });
    }

    // Open Re-Print Modal with visitor details
    function openRePrintModal(visitorId) {
        getVisitorById(visitorId, function (visitor) {
            // Populate Visitor Details
            $("#rpVisitorName").text(visitor.VisitorName || "-");
            $("#rpAssignedDate").text(visitor.CreatedDate ? getTimeAgo(visitor.CreatedDate) : "-");
            $("#rpCreatedBy").text(visitor.CreateBy || "-");
            $("#rpStatus").text(visitor.Status || "Pending");
            $("#rpFromDate").text(visitor.VisitDate ? formatDate(visitor.VisitDate) : "-");
            $("#rpToDate").text(visitor.VisitDate ? formatDate(visitor.VisitDate) : "-");

            var noOfVisitors = visitor.NoOfVisitor || "-";
            $("#rpNoOfVisitors").text(noOfVisitors);
            $("#rpPurpose").text(visitor.Purpose || "-");

            // Populate Host Details
            $("#rpHostName").text(visitor.HostEmployee || "-");
            $("#rpHostRole").text(visitor.Department || "-");
            $("#rpHostDept").text(visitor.Department || "-");

            // Set photo if available
            if (visitor.PhotoPath) {
                $("#rpVisitorPhoto").attr("src", visitor.PhotoPath);
            }

            $("#RePrint_modal").modal('show');
        });
    }

    // ==================== HELPER FUNCTIONS ====================

    function formatDate(dateStr) {
        debugger;
        if (!dateStr) return "";
        var d = new Date(dateStr);
        var day = ("0" + d.getDate()).slice(-2);
        var month = ("0" + (d.getMonth() + 1)).slice(-2);
        var year = d.getFullYear();
        return day + "-" + month + "-" + year;
    }

    function formatDateTime(dateStr) {
        debugger;
        if (!dateStr) return "--:--:--";
        var d = new Date(dateStr);
        var hours = ("0" + d.getHours()).slice(-2);
        var minutes = ("0" + d.getMinutes()).slice(-2);
        var seconds = ("0" + d.getSeconds()).slice(-2);
        return hours + ":" + minutes + ":" + seconds;
    }

    function getTimeAgo(dateStr) {
        var d = new Date(dateStr);
        var now = new Date();
        var diffMs = now - d;
        var diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        if (diffDays === 0) return "Today";
        if (diffDays === 1) return "1 Day Ago";
        return diffDays + " Days Ago";
    }

    function getStatusClass(status) {
        switch (status) {
            case "Approved": return "green_font";
            case "Rejected": return "red_font";
            case "Pending": return "orange_font";
            case "CheckedIn": return "blue_font";
            case "CheckedOut": return "green_font";
            default: return "";
        }
    }

    function clearAddVisitorForm() {
        $("#txtVisitorName").val('');
        $("#txtVisitorEmail").val('');
        $("#ddlVisitorType").val('1');
        $("#ddlVisitLocation").val('1');
        $("#txtNoOfVisitors").val('');
        $("#ddlGender").val('1');
        $("#txtVisitorCompany").val('');
        $("#ddlHostEmployee").val('1');
        $("#txtVisitDate").val('');
        $("#txtVisitTime").val('');
        $("#txtPurposeOfVisit").val('');
        $("#txtVisitorPhone").val('');
    }

    function showLoader() {
        $("#ajax_loader").show();
    }

    function hideLoader() {
        $("#ajax_loader").hide();
    }
</script>

