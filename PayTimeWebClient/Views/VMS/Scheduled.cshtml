}

<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">

<script>
    $(document).ready(function () {

        // Filter Click Open Modal Code =========================
        $(".sch-view-details-btn").on('click', function () {
            $(".sch-view-details-btn").attr("data-toggle", "modal");
            $(".sch-view-details-btn").attr("data-target", "#ViewDetails_modal");
