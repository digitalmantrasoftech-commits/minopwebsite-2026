</script>

<!-- Page Bar : Begin -->
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
        </li>
        <li>
            <span><i class="fa-light fa-angle-right"></i> Scheduled Visits</span>
        </li>
    </ul>

    <!-- Header Row : Begin -->
    <div class="d-flex align-items-center">
        <div class="sch-title">Scheduled Visits</div>
        <div style="min-width: 120px;">
            <div class="dropdown_box margin-left-15">
                <div class="form-group margin-bottom-0">
                    <select id="" class="btn blue btn-outline select2" data-width="100%">
                        <option value="1">Today</option>
                        <option value="2">This Week</option>
                        <option value="3">This Month</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

</div>
<!-- Page Bar : End -->
<!-- Ajax Loader : Begin -->
<div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
