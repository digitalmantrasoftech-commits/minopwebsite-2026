<!-- View Details Modal : Begin -->
<div id="ViewDetails_modal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Scheduled Visit Details</h4>
            </div>
            <div class="modal-body">
                <div class="checkin-modal-card">
                    <!-- Visitor Details Section : Begin -->
                    <div class="checkin-section" style="margin-top: 0;">
                        <p class="checkin-section-title">Visitor Details</p>
                        <div class="checkin-visitor-wrapper">
                            <div class="checkin-detail-card">
                                <!-- Row 1: Name, Assigned date, Created by | Status -->
                                <div class="checkin-fields-row checkin-fields-between">
                                    <div class="checkin-fields-group">
                                        <div class="checkin-field">
                                            <span class="checkin-field-label">Name</span>
                                            <span class="checkin-field-value">Rajesh Kumar</span>
                                        </div>
                                        <div class="checkin-field">
                                            <span class="checkin-field-label">Assigned date</span>
                                            <span class="checkin-field-value">4 Days Ago</span>
                                        </div>
                                        <div class="checkin-field">
                                            <span class="checkin-field-label">Created by</span>
                                            <span class="checkin-field-value">Rajesh Kumar</span>
                                        </div>
                                    </div>
                                    <div class="checkin-field">
                                        <span class="checkin-field-label">Status</span>
                                        <span class="checkin-status-badge">Pending</span>
                                    </div>
                                </div>
                                <!-- Row 2: From, To, No. of Visitors -->
                                <div class="checkin-fields-row">
                                    <div class="checkin-fields-group">
                                        <div class="checkin-field">
                                            <span class="checkin-field-label">From</span>
                                            <span class="checkin-field-value">21-01-2026</span>
                                        </div>
                                        <div class="checkin-field">
                                            <span class="checkin-field-label">To</span>
                                            <span class="checkin-field-value">21-01-2026</span>
                                        </div>
                                        <div class="checkin-field">
                                            <span class="checkin-field-label">No. of Visitors</span>
                                            <span class="checkin-field-value">02</span>
                                        </div>
                                    </div>
                                </div>
                                <!-- Row 3: Purpose of visit -->
                                <div class="checkin-fields-row">
                                    <div class="checkin-field checkin-field-full">
                                        <span class="checkin-field-label">Purpose of visit</span>
                                        <span class="checkin-field-value">Dolores maiores quia labore dolores omnis fugit, eos blanditiis, a, rerum nulla numquam aut sit nemo sunt vel eos, nihil doloribus doloribus sequi fu.</span>
                                    </div>
                                </div>
                            </div>
                            <div class="checkin-qr-block">
                                <div class="checkin-qr-code">
                                    <img src="~/assets/images/QRcode.svg" alt="QR Code" />
                                </div>
                                <p class="checkin-qr-text">Scan to validate</p>
                            </div>
                        </div>
                    </div>
                    <!-- Visitor Details Section : End -->
                    <!-- Host Details Section : Begin -->
                    <div class="checkin-section">
                        <p class="checkin-section-title">Host Details</p>
                        <div class="checkin-detail-card checkin-host-wrapper">
                            <div class="checkin-host-left">
                                <div class="checkin-field">
                                    <span class="checkin-field-label">Image</span>
                                    <div class="checkin-host-image">
                                        <img src="~/assets/images/avtar.png" alt="Host Image" />
                                    </div>
                                </div>
                            </div>
                            <div class="checkin-host-right">
                                <div class="checkin-fields-group">
                                    <div class="checkin-field">
                                        <span class="checkin-field-label">Name</span>
                                        <span class="checkin-field-value">Rajesh Kumar</span>
                                    </div>
                                    <div class="checkin-field">
                                        <span class="checkin-field-label">Role</span>
                                        <span class="checkin-field-value">Project Manager</span>
                                    </div>
                                    <div class="checkin-field">
                                        <span class="checkin-field-label">Department</span>
                                        <span class="checkin-field-value">Software SaaS</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Host Details Section : End -->
                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                        <button type="button" class="sch-btn-accept" id="AcceptBtn"><i class="fa-regular fa-check"></i> Accept</button>
                        <button type="button" class="sch-btn-reject margin-left-5" id="RejectBtn"><i class="fa-regular fa-xmark"></i> Reject</button>
                    </div>
