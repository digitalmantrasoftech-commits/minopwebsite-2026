@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Data;
@using System.Configuration;
@{
    ViewBag.Title = "VMS Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["WebApiEMS"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    string _dbName = HttpContext.Current.Session["DbName"].ToString();

    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false";
}

<style>
    .highcharts-figure,
    .highcharts-data-table table {
        max-width: 100%;
        margin: 10px auto;
    }
</style>

<script>
    $(document).ready(function () {

        //Add Customwidget modal open code
        $("#customwidget_btn").on('click', function () {
            $("#customwidget_btn").attr("data-toggle", "modal");
            $("#customwidget_btn").attr("data-target", "#customwidget_modal");
        });

        $("#TotalVisitor").on('click', function () {
            $("#TotalVisitor").attr("data-toggle", "modal");
            $("#TotalVisitor").attr("data-target", "#TotalVisitor_modal");
        });

        //TotalVisitor Modal in datatable code ============================
        var table = $("#totalvisitor_table").DataTable({
            dom: _domCommon,
            language: _languageCommon,
            ordering: true,
        });
        setTimeout(function () {
            $("#" + "totalvisitor_table" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        // Apply the column Search
        $("#totalvisitor_table thead").on("keyup", "input", function () {
            table.column($(this).parent().index())
                .search(this.value)
                .draw();
        });


        // Visitor Overview Chart Code : Begin ===================================================
        Highcharts.chart('VisitorOverview', {
            chart: {
                type: 'spline',
                style: {
                    fontFamily: 'Roboto'
                }
            },

            legend: {
                enabled: false
            },

            title: {
                text: ''
            },

            subtitle: {
                text: ''
            },

            yAxis: {
                min: 0,
                tickInterval: 100,
                title: {
                    text: ''
                },
                labels: {
                    formatter: function () {
                        return this.value;
                    }
                }
            },

            xAxis: {
                categories: ['Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug']
            },

            tooltip: {
                pointFormat: '<b>{point.y} Visit</b>',
                stickOnContact: true
            },

            plotOptions: {
                series: {
                    cursor: 'pointer',
                    lineWidth: 1,
                    marker: {
                        radius: 3
                    },
                    dataLabels: {
                        enabled: false
                    }
                }
            },

            series: [{
                name: 'Visit',
                data: [100, 200, 300, 100, 120, 250],
                color: '#62B2FD'
            }],

            responsive: {
                rules: [{
                    condition: {
                        maxWidth: 550
                    },
                    chartOptions: {
                        chart: {
                            spacingLeft: 3,
                            spacingRight: 3
                        },
                        legend: {
                            itemWidth: 150
                        },
                        xAxis: {
                            categories: ['Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug'],
                            title: ''
                        },
                        yAxis: {
                            visible: false
                        }
                    }
                }]
            }
        });
        // Visitor Overview Chart Code : End ===================================================

        // Visitor Type Chart Code : Begin ===================================================
        Highcharts.chart('VisitorType', {
            chart: {
                type: 'column'
            },

            title: {
                text: ''
            },

            legend: {
                enabled: false
            },

            xAxis: {
                categories: ['Vendor', 'Interviewee', 'Security', 'Auditor', 'Auditor 1', 'Auditor 2']
            },

            yAxis: {
                min: 0,
                tickInterval: 100,
                title: {
                    text: ''
                },
                labels: {
                    formatter: function () {
                        return this.value;
                    }
                }
            },

            tooltip: {
                useHTML: true,
                formatter: function () {
                    return `<b>${this.x}</b><br>Visitors: ${this.y}`;
                }
            },

            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0,
                    color: '#62B2FD'
                }
            },

            series: [{
                name: 'Visitors',
                data: [150, 425, 235, 100, 270, 185]
            }]
        });
        // Visitor Type Chart Code : End ===================================================



    });
</script>

