@using System.Configuration;
@{
    ViewBag.Title = "location";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _webapiVMSURL = ConfigurationManager.AppSettings["WebApiVMS"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
}

<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<script>
    //var BASE_URL = "https://localhost:44369/";
    var _LocationData = [];
    var isEdit = false;

    $(document).ready(function () {
        GetAllLocationDetails();

        // Add
        $("#Addlocation_btn").click(function () {

            isEdit = false;
            frmClear();
            loadBranches();
            $("#modalTitle").text("Add Location");
            $("#Addlocation_btn_modal").modal("show");
        });

        // Clear
        $("#btnClear, #btnClose").click(function () {
            frmClear();
        });

        // Edit
        $("#tbladdlocation").on('click', '.editBtn', function () {

            var id = $(this).data('id');

            var selectedData = _LocationData.find(x => x.LocationId == id);

            if (!selectedData) {
                toastr.error("Data not found!");
                return;
            }

            isEdit = true;
            frmClear();

            loadBranches(selectedData.BranchId);

            $("#LocationId").val(selectedData.LocationId);
            $("#FloorName").val(selectedData.FloorName);
            $("#Location").val(selectedData.Location);

            $("#modalTitle").text("Edit Location");
            $("#Addlocation_btn_modal").modal("show");
        });

        // Save
        $("#btnSave").click(function () {

            if ($("#FloorName").val().trim() == "") {
                $("#FloorName").addClass('field_error').focus();
                return false;
            }

            if ($("#Location").val().trim() == "") {
                $("#Location").addClass('field_error').focus();
                return false;
            }

            if ($("#BranchID").val() == "") {
                $("#BranchID").addClass('field_error').focus();
                return false;
            }

            var model = {
                LocationId: $("#LocationId").val(),
                FloorName: $("#FloorName").val(),
                Location: $("#Location").val(),
                BranchId: $("#BranchID").val()
            };

            var url = isEdit
                ? '@_webapiVMSURL' + 'Visitor/UpdateLocation'
                : '@_webapiVMSURL' + 'Visitor/CreateLocation';

            $.ajax({
                type: "POST",
                headers: { 'Authorization':'@_tokan'},
                url: url,
                data: JSON.stringify(model),
                contentType: "application/json",

                beforeSend: function () {
                    $("#ajax_loader").show();
                },

                success: function (res) {
                    if (res.success) {
                        toastr.success(res.message);
                        GetAllLocationDetails();
                        $("#Addlocation_btn_modal").modal("hide");
                    } else {
                        toastr.error(res.message);
                    }
                },

                error: function () {
                    toastr.error("Error occurred");
                },

                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });

    });

    // Load Locations
    function GetAllLocationDetails() {

        $.ajax({
            type: "GET",
            //url: BASE_URL + "Visitor/GetLocations",
            headers: { 'Authorization':'@_tokan'},
            url: '@_webapiVMSURL' + 'Visitor/GetLocations',
            beforeSend: function () {
                $("#ajax_loader").show();
            },

            success: function (response) {

                if (response != null) {
                    handleGridVisibility("tblempty", "NotificationGrid-empty", response, {
                        imageUrl: "emptyscreen_1.png",
                        subText: "No entries found."
                    });
                }

                if ($.fn.DataTable.isDataTable('#tbladdlocation')) {
                    $('#tbladdlocation').DataTable().clear().destroy();
                    $("#dataTables_tbl_header").remove()
                }

                _LocationData = response;

                var html = "";

                $.each(response, function (i, item) {

                    html += "<tr>";
                    html += "<td>" + item.FloorName + "</td>";
                    html += "<td>" + item.Location + "</td>";
                    html += "<td>" + item.Branchname + "</td>";
                    html += "<td>";
                    html += "<a class='editBtn btn btn-xs seagreen_btnnew tooltips' data-id='" + item.LocationId + "' title='Edit'>";
                    html += "<i class='fa-regular fa-pen-to-square'></i></a>";
                    html += "</td>";
                    html += "</tr>";
                });

                $("#tbladdlocation tbody").html(html);

                $("#tbladdlocation").DataTable({
                    destroy: true,
                    dom: _domCommon,
                    language: _languageCommon,
                    ordering: true,
                    order: [],
                    columnDefs: [
                        { targets: [3], orderable: false }
                    ]
                });
                setTimeout(function () {
                    $("#" + "tbladdlocation" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                    $('.tooltips').tooltip();
                }, 100);

                injectExportButtonsForDataTables(false, function () {
                });
                $('.tooltips').tooltip();
            },

            error: function () {
                toastr.error("Error loading data");
            },

            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }

    // Load Branch
    function loadBranches(selectedId = null) {
        $.ajax({
            headers: { 'Authorization':'@_tokan'},
            url: '@_webapiVMSURL' + 'Visitor/GetBranch',
            type: "GET",
            success: function (data) {

                console.log("Branch Data:", data);

                $("#BranchID").empty().append('<option value="">Select Branch</option>');

                $.each(data, function (i, item) {
                    var id = item.BranchId;
                    var name = item.Branchname;

                    var selected = (selectedId == id) ? "selected" : "";

                    $("#BranchID").append(
                        `<option value="${id}" ${selected}>${name}</option>`
                    );
                });
            }
        });
    }

    // Clear
    function frmClear() {
        $("#LocationId").val("");
        $("#FloorName").val("").removeClass('field_error');
        $("#Location").val("").removeClass('field_error');
        $("#BranchID").val("").removeClass('field_error');
    }
</script>

<!-- Page Bar : Begin -->
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
        </li>
        <li>
            <span><i class="fa-light fa-angle-right"></i> Location</span>
        </li>
    </ul>
    <div class="emptotalcount">
        <div class="page-toolbar page-toolbar_payroll">
            <div class="emp_btn_block">
                <div class="text-right">
                    <a href="javascript:;" class="btn icon_transparent_btn tooltips" id="Addlocation_btn" data-placement="left" data-original-title="Add Location">
                        <i class="fa-solid fa-plus"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Page Bar : End -->
<!-- Ajax Loader : Begin -->
<div id="ajax_loader" class="modal_bg loading" aria-hidden="true">
    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
</div>
<!-- Ajax Loader : End -->
<!-- Body Block : Begin -->
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="portlet">
            <div class="portlet-body">

                <div id="tblempty">
                    <div class="table-responsive" id="tableResponsive">
                        <table class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column"
                               id="tbladdlocation">

                            <thead>
                                <tr>
                                    <th>Floor Name</th>
                                    <th>Location</th>
                                    <th>Branch</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody></tbody>

                        </table>
                    </div>
                </div>

                <!-- NoDataFound Block : Begin -->
                <div id="NotificationGrid-empty">
                    <div class="datanotfound">
                        <img src="" height="148" width="280" alt="Nodata Found Icon" />
                        <p class="datanotfound_title"></p>
                        <p class=""></p>
                    </div>
                </div>
                <!-- NoDataFound Block : End -->
                <!-- Add Location Modal : Begin -->
                <div id="Addlocation_btn_modal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
                    <div class="modal-dialog" style="width:500px;">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" id="btnClose">&times;</button>
                                <h4 class="modal-title" id="modalTitle">Add Location</h4>
                            </div>
                            <div class="modal-body">
                                <div class="modal-card">
                                    <fieldset>
                                        <div class="head_box">
                                            <div class="row">
                                                <div class="af_modal_box">

                                                    <div class="col-xs-6">
                                                        <div class="form-group">
                                                            <label>Floor Name <span class="required" aria-required="true">*</span></label>
                                                            <input type="text" class="form-control input-sm" id="FloorName" placeholder="Enter Floor Name" maxlength="100" />
                                                        </div>
                                                    </div>

                                                    <div class="col-xs-6">
                                                        <div class="form-group">
                                                            <label>Location <span class="required" aria-required="true">*</span></label>
                                                            <input type="text" class="form-control input-sm" id="Location" placeholder="Enter Location" maxlength="150" />
                                                        </div>
                                                    </div>

                                                    <div class="col-xs-12">
                                                        <div class="form-group">
                                                            <label>Branch <span class="required" aria-required="true">*</span></label>
                                                            <select id="BranchID" class="form-control input-sm">
                                                                <option value="">Select Branch</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <div class="row">
                                    <div class="col-lg-12 text-right">
                                        <input type="hidden" id="LocationId" value="0" />
                                        <input type="button" class="btn clear_btn" data-dismiss="modal" value="Cancel" id="btnClear" />
                                        <button class="btn save_btn" type="button" id="btnSave">
                                            <i class="fa-light fa-floppy-disk"></i> Save
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Add Location Modal : End -->

            </div>
        </div>
    </div>
</div>
<!-- Body Block : End -->
