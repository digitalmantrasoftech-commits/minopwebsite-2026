<script>
    var cmpId1 = '@Cmpid';
    var roleId1 = '@_RoleId';

    if (roleId1 == 1) {
        cmpId1 = 0;
    }

    console.log('@WidgetId');
    window.AppConfig = {
        token: '@_tokan',
        roleId: '@_RoleId',
        webApiUrl: '@_webapiurl',
        cmpId: cmpId1,
        branchId: '@_branchid',
        empid: '@empid',
        widgetId: '@WidgetId',
        UserId: '@UserId',
        DataThreshHold : '@_DatagridThsold',
        DateFormate: '@_isdateformat',
        CompanyCode: '@_compcode',
        webApiEmsUrl:'@_webapiEMSURL'
    };

    // code for hashing my external js
    let jsFileUrl = "/Pages_JS/Dashboard/AdminDashBoardV2.js";
    let url = "/Pages_JS/Dashboard/AdminDashBoardV2.js";

    async function loadAndExecuteJS(url) {

        try {


            const response = await fetch(url);
            const jsContent = await response.text();


            const script = document.createElement('script');
            script.type = 'text/javascript';
            script.text = jsContent;
            document.body.appendChild(script);


            //const hashedContent = CryptoJS.SHA256(jsContent).toString(CryptoJS.enc.Hex);
            //const hashDisplayElement = document.createElement('div');
            //hashDisplayElement.textContent = `SHA-256 Hash: ${hashedContent}`;
            //document.body.appendChild(hashDisplayElement);


        } catch (error) {
            console.error('Error loading or executing external JS:', error);
        }
    }


    loadAndExecuteJS(jsFileUrl);
</script>

