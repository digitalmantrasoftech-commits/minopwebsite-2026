            empid = '@compempid'; // Use compempid if roleId1 is 6806 or 6805
        } else {
            empid = '@empid'; // Use empid otherwise
        }
    window.AppConfig = {
        token: '@_tokan',
        roleId: '@_RoleId',
        webApiUrl: '@_webapiurl',
        cmpId: cmpId1,
        branchId: '@_branchid',
        empid: empid,
        DepartmentId:'@DepartmentId',
        UserId: '@UserId',
