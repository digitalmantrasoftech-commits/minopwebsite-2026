        // ========= Employee Dashboard Drag & Drop Card Reorder =========
        var EMP_STORAGE_LEFT = 'empDashboardLeftOrder_' + uniqueid + '_' + UserId1;
        var EMP_STORAGE_RIGHT = 'empDashboardRightOrder_' + uniqueid + '_' + UserId1;

        function empAddDragHandles(containerId) {
            $('#' + containerId + ' > div').each(function () {
                var $header = $(this).find('.card_header').first();
                if ($header.length && !$header.find('.drag-handle').length) {
                    var $firstChild = $header.children().first();
                    var $handle = $('<span class="drag-handle tooltips" data-placement="top" data-original-title="Drag to reorder"><i class="fa-light fa-grip-dots-vertical"></i></span>');
                    if ($firstChild.hasClass('d-flex')) {
                        $firstChild.prepend($handle);
                    } else {
                        $header.prepend($handle);
                    }
                }
            });
        }

        function empGetCardOrder(containerId) {
            var order = [];
            $('#' + containerId + ' > div').each(function () {
                var id = $(this).attr('id');
                if (id) {
                    order.push(id);
                }
            });
            return order;
        }

        function empSaveCardOrder(containerId, storageKey) {
            var order = empGetCardOrder(containerId);
            try {
                localStorage.setItem(storageKey, JSON.stringify(order));
            } catch (e) { }
        }

        function empRestoreCardOrder(containerId, storageKey) {
            try {
                var saved = localStorage.getItem(storageKey);
                if (!saved) return;
                var order = JSON.parse(saved);
                if (!Array.isArray(order) || order.length === 0) return;

                var $container = $('#' + containerId);
                var $children = $container.children();
                var idMap = {};

                $children.each(function () {
                    var id = $(this).attr('id');
                    if (id) {
                        idMap[id] = $(this);
                    }
                });

                for (var i = 0; i < order.length; i++) {
                    if (idMap[order[i]]) {
                        $container.append(idMap[order[i]]);
                        delete idMap[order[i]];
                    }
                }
                for (var key in idMap) {
                    $container.append(idMap[key]);
                }
            } catch (e) { }
        }

        // Restore card order IMMEDIATELY to prevent position flash
        empRestoreCardOrder('emp-sortable-left', EMP_STORAGE_LEFT);
        empRestoreCardOrder('emp-sortable-right', EMP_STORAGE_RIGHT);

        function initEmpDashboardSortable() {
            var leftEl = document.getElementById('emp-sortable-left');
            var rightEl = document.getElementById('emp-sortable-right');

            if (leftEl) {
                empAddDragHandles('emp-sortable-left');
                $('#emp-sortable-left .drag-handle.tooltips').tooltip({ container: 'body', trigger: 'hover' });
                Sortable.create(leftEl, {
                    handle: '.drag-handle',
                    group: 'empDashboard',
                    animation: 250,
                    ghostClass: 'sortable-ghost',
                    chosenClass: 'sortable-chosen',
                    dragClass: 'sortable-drag',
                    easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
                    onEnd: function () {
                        empSaveCardOrder('emp-sortable-left', EMP_STORAGE_LEFT);
                        empSaveCardOrder('emp-sortable-right', EMP_STORAGE_RIGHT);
                    }
                });
            }

            if (rightEl) {
                empAddDragHandles('emp-sortable-right');
                $('#emp-sortable-right .drag-handle.tooltips').tooltip({ container: 'body', trigger: 'hover' });
                Sortable.create(rightEl, {
                    handle: '.drag-handle',
                    group: 'empDashboard',
                    animation: 250,
                    ghostClass: 'sortable-ghost',
                    chosenClass: 'sortable-chosen',
                    dragClass: 'sortable-drag',
                    easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
                    onEnd: function () {
                        empSaveCardOrder('emp-sortable-left', EMP_STORAGE_LEFT);
                        empSaveCardOrder('emp-sortable-right', EMP_STORAGE_RIGHT);
                    }
                });
            }
        }

        // Only delay Sortable init + drag handles, NOT the order restore
        setTimeout(function () {
            initEmpDashboardSortable();
        }, 1500);

    </script>
