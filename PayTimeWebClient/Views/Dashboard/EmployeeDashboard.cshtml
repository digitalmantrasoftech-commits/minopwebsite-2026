        function filterFunction() {
            // Get input value and convert to lowercase
            const input = document.getElementById("myInput");
            const filter = input.value.toLowerCase();

            // Get all list items
            const ul = document.getElementById("nameList");
            const li = ul.getElementsByTagName("li");

            // Loop through all list items and hide those that don't match the query
            for (let i = 0; i < li.length; i++) {
                const a = li[i].getElementsByTagName("a")[0];
                const textValue = a.textContent || a.innerText;

                // Check if list item matches the filter
                if (textValue.toLowerCase().indexOf(filter) > -1) {
                    li[i].style.display = ""; // Show matching items
                } else {
                    li[i].style.display = "none"; // Hide non-matching items
                }
            }
        }
