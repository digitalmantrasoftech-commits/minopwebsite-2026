    <script>
        // Open congratulations box on button click
        $('#btn_open_congrats').on('click', function () {
            $('#congrats_overlay').addClass('show');
        });

        // Close button click - close the congratulations box
        $('#btn_close_congrats').on('click', function () {
            $('#congrats_overlay').removeClass('show');
        });

        // Download Certificate button - close congrats box and open certificate modal
        $('#btn_download_certificate').on('click', function () {
            $('#congrats_overlay').removeClass('show');
            $('#certificate_modal').modal('show');
        });

        // When certificate modal opens, ensure congrats overlay is hidden
        $('#certificate_modal').on('show.bs.modal', function () {
            $('#congrats_overlay').removeClass('show');
        });

        // Download Certificate as PDF
        $('#DownloadCertificate').on('click', function () {
            var btn = $(this);
            btn.prop('disabled', true).html('<i class="fa-regular fa-spinner fa-spin"></i> Downloading...');

            var element = document.querySelector('.certificate-wrapper');
            var scale = 2;

            domtoimage.toPng(element, {
                quality: 1.0,
                width: element.offsetWidth * scale,
                height: element.offsetHeight * scale,
                style: {
                    transform: 'scale(' + scale + ')',
                    transformOrigin: 'top left'
                },
                bgcolor: '#ffffff'
            }).then(function (dataUrl) {
                var { jsPDF } = window.jspdf;
                var pdf = new jsPDF('l', 'mm', 'a4'); // landscape A4
                var pageWidth = pdf.internal.pageSize.getWidth();
                var pageHeight = pdf.internal.pageSize.getHeight();
                var margin = 10;
                var availWidth = pageWidth - (margin * 2);
                var availHeight = pageHeight - (margin * 2);
                var imgRatio = element.offsetWidth / element.offsetHeight;
                var fitWidth = availWidth;
                var fitHeight = fitWidth / imgRatio;
                if (fitHeight > availHeight) {
                    fitHeight = availHeight;
                    fitWidth = fitHeight * imgRatio;
                }
                var x = (pageWidth - fitWidth) / 2;
                var y = (pageHeight - fitHeight) / 2;
                pdf.addImage(dataUrl, 'PNG', x, y, fitWidth, fitHeight);
                pdf.save('Certificate.pdf');

                btn.prop('disabled', false).html('<i class="fa-regular fa-download"></i> Download');
            }).catch(function () {
                btn.prop('disabled', false).html('<i class="fa-regular fa-download"></i> Download');
                alert('Error generating PDF. Please try again.');
            });
        });
    </script>

