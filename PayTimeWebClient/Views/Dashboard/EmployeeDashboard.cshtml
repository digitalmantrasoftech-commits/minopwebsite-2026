        CompanyCode: '@_compcode',
        locakattendeceday: '@_lockAttendanceDay',
        planid: '@_PlanId',
        worf: '@_worf',
        empdata: '@ViewBag.empdata',
        IsApprovalForWebpunch: '@IsApprovalForWebpunch',
        firstempid:'@firstempid',
        hierarchy: '@hierarchy',
        originalemployeeid: '@empid',
        webApiEmsUrl:'@_webapiEMSURL'

    };
    // code for hashing my external js
    let jsFileUrl = "/Js_split/Employeedashboard.js";
    let url = "/Js_split/Employeedashboard.js";

    async function loadAndExecuteJS(url) {

        try {


            const response = await fetch(url);
            const jsContent = await response.text();


            const script = document.createElement('script');
            script.type = 'text/javascript';
            script.text = jsContent;
            document.body.appendChild(script);


            //const hashedContent = CryptoJS.SHA256(jsContent).toString(CryptoJS.enc.Hex);
            //const hashDisplayElement = document.createElement('div');
            //hashDisplayElement.textContent = `SHA-256 Hash: ${hashedContent}`;
            //document.body.appendChild(hashDisplayElement);


        } catch (error) {
            console.error('Error loading or executing external JS:', error);
        }
    }

    loadAndExecuteJS(jsFileUrl);
</script>

<style type="text/css">
    .policymodal_block {
        position: fixed;
        top: 0px;
        left: 0px;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 11111;
    }

        .policymodal_block .modal_box {
            position: relative;
            width: 80%;
            height: calc(100vh - 40px);
            margin: 20px auto 20px auto;
            background: #fff;
            border-radius: 8px !important;
            overflow: hidden;
        }

    .closeModal {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #ffffff;
        font-size: 20px;
        border: none;
        border-radius: 3px !important;
        width: 30px;
        height: 30px;
    }

    .page-footer {
        display: block;
    }

    .filter_portlet_wrapper {
        overflow-x: visible;
    }

    .card_summarylist .personal_block {
        overflow: auto;
    }

    @@media (min-width: 300px) and (max-width: 767px) {
        .introjs-tooltip, .introjs-overlay, .introjs-helperLayer {
            display: none !important;
        }
    }

    .introjs-helperLayer {
        background-color: transparent !important;
    }

    .intro-visible {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
    }

    .introjs-tooltip.introjs-floating {
        margin-top: -210px !important;
    }

    /* for position set of emplyooee page */
    .introjs-right {
        top: 80px !important;
    }

        .introjs-right .left-bottom {
            bottom: 158px;
        }

    .swal2-container {
        z-index: 10000;
    }
</style>

