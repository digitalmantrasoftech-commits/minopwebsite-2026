            function GetIdAnnoucement(annoucementId) {
                const params = new URLSearchParams({
                    annoucementId: annoucementId,
                    reqid:3
                });
                const urlWithQuery = `${webApiUrl}DashBoard/EditAnnoucementdata?${params.toString()}`;
                $.ajax({
                    type: "GET",
                    url: urlWithQuery,
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("Authorization", token);
                    },
                    success: function (data) {



                        if (data.isRedirect) {
                            window.location.href = data.redirectUrl;
                        } else {
                            var i = 0;
                            var j = 0;
                            var companyids = data[0].companyid;
                            companyids = companyids.split(",");

                            for (i = 0; i < companyids.length; i++) {
                                var optionVal = companyids[i].trim();
                                $("#CompanyID").find("option[value='" + optionVal + "']").prop("selected", "selected");
                            }


                            $('#CompanyID').multiselect('rebuild');


                            var companyValue = $('#CompanyID').val();
                            if (companyValue) {
                                //fillBranchbycompnyid this function do both fillation of branch and also work at edition time set branch.
                                fillBranchbycompnyid(companyValue, data[0].branchid);
                            }

                            $('#BranchID').multiselect('rebuild');

                            var startdate = convertToDateFormate(data[0].startdate);
                            var enddate = convertToDateFormate(data[0].enddate);
                            $('#startDate').val(startdate);
                            $('#endDate').val(enddate);
                            $('#title').val(data[0].annoucementtitle);
                            $('#descriptions').val(data[0].Description);
                            if (data[0].Email === 1) {
                                $("#emailnoti").prop("checked", true);
                            } else {
                                $("#emailnoti").prop("checked", false);
                            }

                            // Check if SMS notification should be enabled
                            if (data[0].SMS === 1) {
                                $("#smsnoti").prop("checked", true);
                            } else {
                                $("#smsnoti").prop("checked", false);
                            }
                            if (data[0].AnnoucementImage != null && data[0].AnnoucementImage !== "") {
                                $('#empimg').attr('src', data[0].AnnoucementImage);
                                $('#Photo').val(data[0].AnnoucementImage);
                            }

                        }
                    },
