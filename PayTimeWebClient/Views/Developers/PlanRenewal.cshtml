@{
    ViewBag.Title = "PlanRenewal";
    Layout = "";
}

<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="" name="author" />
</head>

<style>
    body {
        background-color: #f2f8fd;
        margin: 0;
        padding: 0;
        font-family: "Roboto", sans-serif;
    }

    .licence-block {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .Licence-expire {
        width: 100%;
        max-width: 100%;
        height: 100vh;
    }

        .Licence-expire .main-box {
            margin-right: 40px;
        }

            .Licence-expire .main-box img.licence-logo {
                margin-bottom: 30px;
                width: 170px;
                height: 51px;
            }

            .Licence-expire .main-box .title {
                color: #c22131;
                font-size: 35px;
                font-weight: 600;
            }

            .Licence-expire .main-box .sub-title {
                color: #1f1f1f;
                font-size: 16px;
                line-height: 24px;
                font-weight: 500;
                margin-top: 10px;
            }

            .Licence-expire .main-box .contact-licence {
                display: flex;
                justify-content: space-around;
            }

                .Licence-expire .main-box .contact-licence a {
                    margin: 30px 0px 10px 0;
                    display: flex;
                    align-items: center;
                    text-decoration: none;
                    color: #04406e;
                    width: 100%;
                }

                    .Licence-expire .main-box .contact-licence a span {
                        margin-left: 10px;
                    }
</style>

<div class="Licence-expire">
    <div class="Licence-block">
        <div class="main-box">
            <img src="~/AssetsNew/images/logo.png" class="licence-logo" alt="logo" />
            <div class="title">Your minop developer account has expired.</div>
            <div class="sub-title">The minop developer account has expired. <br />Please contact to your partner or contact support</div>
            <div class="contact-licence">
                <a href="mailto:servico@mantratec.com"><img src="../assets/images/email-licence.png" /><span>servico@mantratec.com</span></a>
                <a href="tel:079-49068000"><img src="../assets/images/mobile-licence.png" /><span>+91-79-49068000</span></a>
            </div>
            <a href="https://app.minopcloud.com/Paytime/DevelopersAccount"><span>Login Here</span></a>
        </div>
        <div class="img-box">
            <img src="../assets/images/Licence-expire-animation.gif" />
        </div>
    </div>
</div>