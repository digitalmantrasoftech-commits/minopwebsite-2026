    function Employeeselect() {
        // Initialize the global `allEmp` array

        // Iterate over each checkbox with class 'clsChkEmp'
        $("#tblempmaster .clsChkEmp").each(function () {
            var $row = $(this).closest('tr');
            // Check if the checkbox is checked
            if ($(this).is(':checked')) {
                // Extract employee details from the row
                var empPunchID = $row.find('td').eq(2).text(); // Correct index for EmpPunchID
                var empName = $row.find('td').eq(3).text();   // Correct index for EmpName

                // Create employee object
                var objemp = {
                    EmpPunchID: empPunchID,
                    EmpName: empName,
                    Deviceid: "" // Initialize Deviceid as an empty string
                };

                // Add employee object to the array if not already present
                if (!allEmp.some(emp => emp.EmpPunchID === objemp.EmpPunchID)) {
                    allEmp.push(objemp);
                }
            } else {
                // Remove employee from the array if unchecked
                var empPunchID = $row.find('td').eq(2).text();
                allEmp = allEmp.filter(emp => emp.EmpPunchID !== empPunchID);
            }
        });

        // Return true if at least one employee is selected
        return allEmp.length > 0;
    }

