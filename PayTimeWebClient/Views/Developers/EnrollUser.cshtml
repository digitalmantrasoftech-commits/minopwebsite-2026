    function CheckSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
   function Deviceselect()
   {
       var device = [];
       $("#tbldevice .clsChkDevice").each(function (key, value)
        {
            if ($(this).is(':checked') == true)
            {
                device.push($(this).parent('td').parent('tr').children(key)[3].innerText);
            }
        });
       if (device.length == 0) {
           toastr.remove();
           toastr.error("Please select device.");
            return false;
        }
       var Emp = [];
        for (d = 0; d < device.length; d++)
        {
            for (i = 0; i < allEmp.length; i++)
            {
                var FinallEmp = {};
                FinallEmp.EmpId = allEmp[i].EmpPunchID;
                FinallEmp.EmpName = allEmp[i].EmpName;
                FinallEmp.DeviceId = device[d];
                var matchedDevice = DeviceFlags.find(function (dev) {
                    return dev.deviceSrno === device[d];
                });
                if (matchedDevice) {
                    FinallEmp.FlageDeviceCodeTypeCheck = matchedDevice.DeviceTypeCode;
                }
                else {
                    FinallEmp.FlageDeviceCodeTypeCheck = 0; // Default flag value if no match found
                }
                Emp.push(FinallEmp);
            }
        }
       var request =
        {
            ObjEmp: Emp
        }
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'DeviceDemo/EnrollDeveloper',
            data: JSON.stringify(request),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function () {
                $(".loading").show();
            },
            success: function (response) {
                if (response != null) {
                    toastr.remove();
                    toastr.success(response.Msg);
                    $('#tblEnrollUsers').DataTable().ajax.reload();
                    $('#frmpopup').modal('toggle');
                }
            },
            complete: function () {
                $(".loading").hide();
            },
            error: function (response) {
                if (response != null) {
                    var obj = JSON.parse(response.responseText);

                    if (obj.MsgSts == 'error') {
                        toastr.remove();
                        toastr.error(obj.Msg);
                        $('#tblEnrollUsers').DataTable().ajax.reload();
                        $('#frmpopup').modal('toggle');

                    }
                }
            }
        });
    }
    function Step1ShowHide() {
        //*****show/Hide setup-content perticular step*****//
