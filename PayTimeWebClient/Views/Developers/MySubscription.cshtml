@using System.Configuration;
@{
    ViewBag.Title = "MySubscription";
    Layout = "~/Views/Shared/_LayoutDevelopers.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    int _companyid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"].ToString());
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
}
<script type="text/javascript">
    var companyid = '@_companyid';
    $(document).ready(function () {
        GetCompanyDetails();
        GetPlanDetails();
    });
    function GetCompanyDetails() {
        $.ajax({
            url: '@_webapiurl' + '/DashBoard/GetCompanyDetailsDeveloper?CompanyId=' + companyid,
            type: "GET",
            dataType: "json",
            success: function (result) {
                if (result && result.length > 0) {
                    $("#lblcmpname").text(result[0].CompanyName);
                    $("#lblcmpemail").text(result[0].CompanyEmail);
                    $("#lblwebsite").text(result[0].CompanyUrl);
                    $("#lblcontact").text(result[0].CompanyContact);
                }
            },
            error: function (jqXHR, ajaxOptions, thrownError) {
                if (jqXHR.status == 500) {
                    toastr.error("InternalServerError");
                } else if (jqXHR.status == 400) {
                    toastr.error("BadRequest");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            }

        });
    }
    function GetPlanDetails() {
        $.ajax({
        url: '@_webapiurl' + '/DashBoard/GetPlanDetailsDeveloper?CompanyId=' + companyid,
        type: "GET",
        dataType: "json",
        success: function (result) {
            if (result && result.length > 0) {
                $("#lblstartdt").text(result[0].StartDate);
                $("#lblenddt").text(result[0].EndDate);
                $("#lblproduct").text(result[0].Product);
                $("#lblusers").text(result[0].IsDeviceLimit);
                $("#lblDuration").text(result[0].Duration);
            }
        },
        error: function (jqXHR, ajaxOptions, thrownError) {
            if (jqXHR.status == 500) {
                toastr.error("InternalServerError");
            } else if (jqXHR.status == 400) {
                toastr.error("BadRequest");
            } else if (jqXHR.status == 401) {
                window.location.href = "/PayTime/LoginPage";
            }
        }

    });
    }
</script>

