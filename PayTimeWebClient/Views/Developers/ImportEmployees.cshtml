@{
    ViewBag.Title = "ImportEmployees";
    Layout = "~/Views/Shared/_LayoutDevelopers.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
}
<link href="~/Content/toastr.min.css" rel="stylesheet" />
<script src="~/Scripts/toastr.min.js"></script>

<style>
    .sample_sheet_box p {
        margin: 0;
        font-size: 13px;
        line-height: 32px;
        color: #4db3a2;
    }

    .sample_sheet_box a.green-dark {
        font-size: 13px;
        padding: 5px 12px;
    }

    .save_btn {
        display: inline-block;
        background-color: var(--navyblue_color);
        border-radius: 3px !important;
        height: 30px;
        line-height: 30px !important;
        padding: 0 10px;
        color: #fff;
        font-size: 12px;
        border: 1px solid var(--navyblue_color);
    }

        .save_btn:active, .save_btn:focus, .save_btn:hover {
            background-color: var(--navyblue_hover);
            color: #fff;
            outline: 0;
            text-decoration: none;
        }

    .input-group-addon {
        font-size: 12px;
    }

    .save_hr_line {
        border-top: 1px dashed var(--navyblue_color);
        margin: 10px 0;
    }
</style>

<script type="text/javascript">
    $(document).ready(function () {
        $('#tblImportError').DataTable({
            dom: _domCommon,
            language: _languageCommon,
            "columnDefs": [
                {
                    "targets": [0],
                    "orderable": false,
                    "searchable": false
                }
            ],
            "order": [[2, 'asc']]
        });

        setTimeout(function () {
            $("#" + "tblImportError" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        if ("@_Message" != "") {
            toastr.remove();
            toastr.success("@_Message");
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
        }
        $("#fileUpload").change(function () {
            var fileInput = $("#fileUpload").val();
            if (fileInput) {
                var validExts = [".xlsx", ".xls", ".csv"];
                var fileExt = fileInput.substring(fileInput.lastIndexOf('.'));

                if (validExts.indexOf(fileExt) === -1) {
                    toastr.remove();
                    toastr.error("Invalid file selected, valid files are of " + validExts.toString() + " types.");
                    $("#fileUpload").val("");  // Clear the file input
                    return false;
                }
            }
        });
        $('#btnImport').click(function (event) {
            if ($('#fileUpload')[0].files.length === 0) {
                toastr.remove();
                toastr.error("Please upload file.");
                event.preventDefault(); // Prevent form submission or default behavior
                return false;
            }
        });
    });
</script>

<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/Developers/DevelopersDashboard">@PayTimeWebClient.Resource.Resource.mnuHome</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>Import Employees</span>
        </li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="portlet margin-bottom-15">
            <div class="portlet-body">
                @using (Html.BeginForm("ImportEmployees", "Developers", FormMethod.Post, new { enctype = "multipart/form-data", @class = "margin-bottom-15", id = "uploadForm" }))
                {
                    <div class="row">
                        <div class="col-lg-9 col-md-6 col-sm-12 col-xs-12">
                            <div class="form-group" style="margin-bottom:0;">
                                <label for="fileUploadInput">Select File<span class="required" aria-required="true"> *</span></label>
                                <div class="fileinput fileinput-new" data-provides="fileinput">
                                    <div class="input-group">
                                        <div class="form-control uneditable-input input-fixed input" data-trigger="fileinput">
                                            <i class="fa fa-file fileinput-exists"></i>&nbsp;
                                            <span class="fileinput-filename"> </span>
                                        </div>
                                        <span class="input-group-addon btn blue btn-file">
                                            <span class="fileinput-new"> Select File </span>
                                            <span class="fileinput-exists"> Change </span>
                                            <input type="file" name="fileUpload" id="fileUpload">
                                        </span>
                                        <a href="javascript:;" class="input-group-addon btn red fileinput-exists" data-dismiss="fileinput"> Remove </a>
                                        <span class="col-lg-8">
                                            <button type="submit" id="btnImport" class="btn save_btn"><i class="fa fa-upload"></i> Import</button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <hr class="save_hr_line" />
                        </div>
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-10">
                                    <div class="row sample_sheet_box">
                                        <div class="col-lg-8">
                                            <p>Download the attached sample CSV, which can be used as a template to import your data into the application</p>
                                        </div>
                                        <div class="col-lg-4">
                                            <a class=" btn green-dark" href="~/SampleXlFile/DeveloperEmp.xlsx"><i class="fa fa-file-excel-o"></i> Sample Sheet</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>


        @if (TempData["IsValid"] != null)
        {
            if (Convert.ToBoolean(TempData["IsValid"]) == false)
            {
                <div class="portlet">
                    <div class="portlet-body">
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tblImportError" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column ">
                                <thead>
                                    <tr>
                                        <th>No</th>
                                        <th hidden>error Id</th>
                                        <th>EmpPunchID</th>
                                        <th>Empname</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int n = 1;
                                    }
                                    @foreach (var i in ViewBag.Importfailloglist)
                                    {
                                        <tr class="odd gradeX">
                                            <td id="sr">@n</td>
                                            <td id="hdnImportedFailId" hidden>@i.ImportedFailId</td>
                                            <td id="EmpPunchID">@i.EmpPunchID</td>
                                            <td id="Empname">@i.EmpName</td>
                                            <td id="Reason">@i.Reason</td>
                                        </tr>
                                        n++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="col-md-12">
                    <div class="form-group">
                        <h1>File is validated and imported successfully.</h1>
                    </div>
                </div>
            }
        }



    </div>
</div>