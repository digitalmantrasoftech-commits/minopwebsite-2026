
@{
    ViewBag.Title = "Download";
    Layout = "~/Views/Shared/_LayoutDevelopers.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
}
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/Developers/DevelopersDashboard">@PayTimeWebClient.Resource.Resource.mnuHome</a>
            <i class="fa fa-circle"></i>
        </li>
        <li>
            <span>Download</span>
        </li>
    </ul>
</div>

<div class="portlet">
    <div class="portlet-body">
        <div class="row">
            <div class="col-lg-12">
                <h4 style="font-weight: 400;">Click on the image to download sample.</h4>
            </div>
            <div class="col-lg-3">
                <a download="DotNetSample.zip" href="~/Downloads/DotNetSample.zip" title="Dot Net Sample">
                    <img alt="Dot Net Sample" src="~/assets/img/DotNetImage.jpg">
                </a>
            </div>
            <div class="col-lg-3">
                <a download="phpSample.zip" href="~/Downloads/MinopDeveloperAPI.zip" title="php Sample">
                    <img alt="php Sample" src="~/assets/img/Slimphp.png">
                </a>
            </div>
        </div>
    </div>
</div>
