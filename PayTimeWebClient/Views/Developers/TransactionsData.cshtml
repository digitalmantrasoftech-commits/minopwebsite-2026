    $(document).ready(function () {

        $("#PunchID").keypress(function (e) {
            var keyCode = e.which;
            var Responce = validateKeyPress(keyCode);
            if (Responce == true) {
            }
            else { e.preventDefault(); }
        });

        $("#PunchID").blur(function () {
            var PunchID = removeTags($("#PunchID").val());
            $("#PunchID").val(PunchID);
        });


        var currentDate = new Date(); // Get the current date
        var fromDate = formatDate(currentDate); // Format the current date
        var toDate = formatDate(currentDate); // Format the current date

        function formatDate(date) {
            var day = date.getDate();
            var month = date.getMonth() + 1; // Months are zero-based
            var year = date.getFullYear();

            // Add leading zeros if necessary
            if (day < 10) {
                day = '0' + day;
            }
            if (month < 10) {
                month = '0' + month;
            }

            return year + '-' + month + '-' + day; // Format: YYYY-MM-DD
        }

        $("#FilterFromDate").val(fromDate);
        $("#FilterToDate").val(toDate);


        $("#FilterFromDate").change(function () {
            FilterFromDate();
        });

        $("#FilterToDate").change(function () {
            FilterToDate();
        })

        GetAllManualPunchData();

        $("#SearchFilter").click(function () {
            var Is_Flag = 0;
            if ($("#FilterFromDate").val() == "") {
                toastr.remove();
                toastr.error("Select FromDate");
                return false;
                Is_Flag = 1;
            } else {
            }

            if ($("#FilterToDate").val() == "") {
                toastr.remove();
                toastr.error("Select ToDate");
                return false;
                Is_Flag = 1;

            } else {
            }
            if (Is_Flag == 0) {
                GetAllManualPunchData();
            }
        });
    });
    Date.prototype.toInputFormat = function () {
        var yyyy = this.getFullYear().toString();
        var mm = (this.getMonth() + 1).toString(); // getMonth() is zero-based
        var dd = this.getDate().toString();
        return yyyy + "-" + (mm[1] ? mm : "0" + mm[0]) + "-" + (dd[1] ? dd : "0" + dd[0]); // padding
    };

    function FilterFromDate() {
        var date = new Date($("#FilterFromDate").val()),
         days = 30;
        //if (!isNaN(date.getTime())) {
        //    date.setDate(date.getDate() + days);
        //    $("#FilterToDate").val(date.toInputFormat());
        //}
        if ($('#FilterFromDate').val() != "") {
            var start = $('#FilterFromDate').val();
            var end = $('#FilterToDate').val();
            if (end != "") {
                var diff = Date.parse(end) - Date.parse(start);
                days = diff / 1000 / 60 / 60 / 24;
                if (days > 31) {
                    days = 31;
                }
            }
            else {
                end = 31;
            }

            var date = new Date($("#FilterFromDate").val()), daynew, daynew = days
            if (!isNaN(date.getTime())) {
                date.setDate(date.getDate() + daynew);
                $("#FilterToDate").val(date.toInputFormat());
            }

        }
    };
    function FilterToDate() {

        var date = new Date($("#FilterToDate").val()),
         days = 30;
        //if (!isNaN(date.getTime())) {
        //    date.setDate(date.getDate() - days);

        //    $("#FilterFromDate").val(date.toInputFormat());
        //}
        if ($('#FilterToDate').val() != "") {
            var start = $('#FilterFromDate').val();
            var end = $('#FilterToDate').val();
            if (start != "") {
                var diff = Date.parse(end) - Date.parse(start);
                days = diff / 1000 / 60 / 60 / 24;
                if (days > 31) {
                    days = 31;
                }
            }
            else {
                days = 31;
            }
            var date = new Date($("#FilterToDate").val()), daynew, daynew = days

            if (!isNaN(date.getTime())) {
                date.setDate(date.getDate() - daynew);
                $("#FilterFromDate").val(date.toInputFormat());
            }
        }
    };
    fillDeviceCode();
    function fillDeviceCode() {
        $("#ddlDevice").empty();
        $.ajax({
            type: "GET",
            url: '@_webapiurl' + 'Master/GetDeviceCode',
            contentType: "application/json; charset=utf-8",
            headers: { 'Authorization': '@_tokan' },
            datatype: "json",
            async: "false",
            success: function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response != null) {
                    $("#ddlDevice").append("<option value='0'> Select DeviceCode </option>");
                    for (var i = 0; i < response.length; i++) {
                        $("#ddlDevice").append("<option value='" + response[i].DeviceCode + "'>" + response[i].DeviceCode + " ( " + response[i].DeviceSrNo + " )</option>");
                    }
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                $("#ddlDevice").append("<option value='0'> Select DeviceCode </option>");
                if (jqXHR.status == 500) { //InternalServerError = 500,
                    toastr.error("InternalServerError");
                } else if (jqXHR.status == 400) { //BadRequest = 400,
                    toastr.error("BadRequest");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            }
        });
    }

    function GetAllManualPunchData()
    {
        var bID = $("#ddlBranch").val();
        var FilterFromDate = $("#FilterFromDate").val();
        var FilterToDate = $("#FilterToDate").val();
        var PunchId = $("#PunchID").val();
        var DeviceCode = $("#ddlDevice").val();
        // var obj = { "BranchID": bID, "FilterFromDate": FilterFromDate, "FilterToDate": FilterToDate, "PunchID": PunchId, "DeviceCode": DeviceCode };
        $("#dataTables_tbl_header").remove();
        $('#tblTransactionData').destroy; // (You should call destroy() as a function if needed)
   

        var _ojbClassTransParamData =
        {
            BranchID: 0,
            FilterFromDate: FilterFromDate,
            FilterToDate: FilterToDate,
            PunchId: PunchId,
            DeviceCode: DeviceCode,
            DataGridThreSold: '@_DatagridThsold',
            webapiurl: '@_webapiurl',
            tokan: '@_tokan',
            pageSize: 10,
            page: 1,
            _PunchID: PunchId
        };
        LoadTransctionDeviceData(_ojbClassTransParamData);
    }

