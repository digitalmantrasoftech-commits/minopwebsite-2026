@model PayTimeWebClient.Models.Devices
@{
    ViewBag.Title = "Device";
    Layout = "~/Views/Shared/_LayoutDevelopers.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _IsDeviceLimit = Convert.ToInt32(HttpContext.Current.Session["IsDeviceLimit"]);

}


<script src="~/Scripts/toastr.min.js"></script>
<link href="~/Content/toastr.min.css" rel="stylesheet" />
<script type="text/javascript">

    $(document).ready(function () {

        $(".alert").hide();
        $("#TempSrno").hide();
        if ("@_Message" != "")
        {
            toastr.remove();
            toastr.success("@_Message");
            //$(".alert-danger").hide();
            //$(".alert-success").show();
        }

        if ('@_error' != "")
        {
            toastr.remove();
            toastr.error('@_error');
        //$(".alert-danger").show();
        //$(".alert-success").hide();
        }
        var dip = '115.124.96.52';
        var dport = '1018';
        $('#tbldevice').DataTable({
            dom: _domCommon,
            language: _languageCommon,
        });

        setTimeout(function () {
            $("#" + "tbldevice" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);

        $("#AddDevice").on('click', function () {
            if (@_IsDeviceLimit <= document.getElementById("hdndevicecnt").innerText)
            {
                toastr.remove();
                toastr.error("Your current plan does not support adding more devices. Please upgrade to increase your device limit.");
                return false;
            }


        $("#DivSrNo").show();
        $("#DeviceYes").prop('checked', true);
        $("#srlbl").show();
        $("#DeviceSrNo").val("");
        $("#DeviceSrNo").show();
        $("#spipaddd").text(dip);
        $("#spdeviceport").text(dport);
        frmClear();
        $("#AddDevice").attr("data-toggle", "modal");
        $("#AddDevice").attr("data-target", "#frmpopup");

        });

        $("#DeviceSrNo").change(function () {
        var DeviceSrNo = $("#DeviceSrNo").val();
        var DeviceCode = $("#DeviceCode").val();
        var url = "/Developers/GetDeviceSrCode";
        $.get(url, { DeviceSrNo: DeviceSrNo, DeviceCode: "" }, function (data) {
        if (data.isRedirect) {
        window.location.href = data.redirectUrl;
        }
        if (data != null) {
        var obj = JSON.parse(data);
        if (obj.Meg == "Serial No already exist.") {
        $("#spDeviceSrNo").html(obj.Meg).show();
        $("#DeviceSrNo").val("");
        $("#DeviceSrNo").focus();
        }
        else
        {
        $("#spDeviceCode").hide();
        $("#spDeviceSrNo").hide();
        }
        }
        else {
        $("#spDeviceCode").hide();
        $("#spDeviceSrNo").hide();
        }
        });
        });
        $("#DeviceTypeCode").change(function () {
        $("#DeviceTypeCode").removeClass('field_error');
        var dip = '115.124.96.52';
        var dport = '1018';
        if ($("#DeviceTypeCode").val() == "36") {
        dip = '115.124.96.52'; dport = '9090';
        }
        if ($("#DeviceTypeCode").val() == "38") {
        dip = '115.124.96.52'; dport = '8081';
        }
        $("#spipaddd").text(dip);
        $("#spdeviceport").text(dport);
        });
        $("#DeviceCode").change(function () {
        var DeviceSrNo = $("#DeviceSrNo").val();
        var DeviceCode = $("#DeviceCode").val();
        var url = "/Developers/GetDeviceSrCode";
        $.get(url, { DeviceSrNo: "", DeviceCode: DeviceCode }, function (data) {
        if (data.isRedirect) {
        window.location.href = data.redirectUrl;
        }
        if (data != null) {
        var obj = JSON.parse(data);
        if (obj.Meg == "Device Code already exist.") {
        $("#spDeviceCode").html(obj.Meg).show();
        $("#DeviceCode").val("");
        $("#DeviceCode").focus();
        }
        else {
        $("#spDeviceCode").hide();
        $("#spDeviceSrNo").hide();
        }
        }
        else {
        $("#spDeviceCode").hide();
        $("#spDeviceSrNo").hide();
        }


        });
        });

        $("#btnsubmit").click(function (event) {

        if ($("#DeviceSrNo").val() == "") {
        $("#DeviceSrNo").addClass('field_error');
        event.preventDefault();//or return false
        return false;
        }
        else {
        $("#DeviceSrNo").removeClass('field_error');
        }
        if ($("#DeviceName").val() == "") {
        $("#DeviceName").addClass('field_error');
        event.preventDefault();//or return false
        return false;
        }
        else {
        $("#DeviceName").removeClass('field_error');
        }
        if ($("#DeviceIP").val() == "") {
        $("#DeviceIP").addClass('field_error');
        event.preventDefault();//or return false
        return false;
        }
        else {
        $("#DeviceIP").removeClass('field_error');
        }
        if ($("#DevicePort").val() == "") {
        $("#DevicePort").addClass('field_error');
        event.preventDefault();//or return false
        return false;
        }
        else {
        $("#DevicePort").removeClass('field_error');
        }
        if ($("#DeviceCode").val() == "") {
        $("#DeviceCode").addClass('field_error');
        event.preventDefault();//or return false
        return false;
        }
        else {
        $("#DeviceCode").removeClass('field_error');
        }
        if ($("#DeviceTypeCode").val() == "" || $("#DeviceTypeCode").val() == null) {
        $("#DeviceTypeCode").addClass('field_error');
        event.preventDefault();//or return false
        return false;
        }
        else {
        $("#DeviceTypeCode").removeClass('field_error');
        }
        var ipaddress = $("#DeviceIP").val();
        if (/^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/.test(ipaddress)) {
        $("#spvalidation").hide();
        $("#DeviceIP").removeClass('field_error');
        }
        else {
        $("#DeviceIP").addClass('field_error');
        $("#spvalidation").html("You have entered an invalid IP address!").show();
        $("#DeviceIP").focus();
        return false;
        }
        });

        $("#tbldevice").on('click', '.editclass', function () {
        frmClear();


        $("#DeviceId").val($(this).parent('td').parent('tr').children(1)[1].innerText);

        $("#DeviceName").val($(this).parent('td').parent('tr').children(1)[6].innerText);
        if ($(this).parent('td').parent('tr').children(1)[4].innerText == "--NA--") {
        $("#DeviceSrNo").val($(this).parent('td').parent('tr').children(1)[7].innerText);
        $("#TempSrno").val($(this).parent('td').parent('tr').children(1)[7].innerText);
        $("#DivSrNo").show();
        $("#DeviceNo").prop('checked', true);
        $("#srlbl").hide();
        $("#DeviceSrNo").hide();
        }
        else {

        $("#DeviceSrNo").val($(this).parent('td').parent('tr').children(1)[7].innerText);
        $("#TempSrno").val($(this).parent('td').parent('tr').children(1)[7].innerText);
        $("#DivSrNo").hide();
        $("#DeviceYes").prop('checked', true);
        $("#srlbl").show();
        $("#DeviceSrNo").show();
        }
        $("#DeviceCode").val($(this).parent('td').parent('tr').children(1)[8].innerText);
        $('#DeviceIP').val($(this).parent('td').parent('tr').children(1)[9].innerText);
        $('#DevicePort').val($(this).parent('td').parent('tr').children(1)[10].innerText);


        var IsPushData = $(this).parent('td').parent('tr').children(1)[12].innerText;
        if (IsPushData == 1) {
        $("#IsPushData").prop('checked', true);
        }
        else {
        $("#IsPushData").prop('checked', false);
        }

        var _devicetypecode = $(this).parent('td').parent('tr').children(1)[15].innerText;
        dip = '115.124.96.52'; dport = '1018';
        if (_devicetypecode == "36") {
        dip = '115.124.96.52'; dport = '9090';

        }
        if (_devicetypecode == "38") {
        dip = '115.124.96.52'; dport = '8081';

        }
        $("#spipaddd").text(dip);
        $("#spdeviceport").text(dport);

        $('#DevicePassword').val($(this).parent('td').parent('tr').children(1)[13].innerText);
        $('#DeviceTypeCode').val(_devicetypecode);
        $(".editclass").attr("data-toggle", "modal");
        $(".editclass").attr("data-target", "#frmpopup");
        });
        });
        function frmClear() {
        $("#DeviceId").val(0);
        $("#DeviceSrNo").focus();
        $("#DeviceSrNo").val("");
        $("#DeviceCode").val("");
        $("#DeviceName").val("");
        $("#DeviceIP").val("");
        $("#DevicePort").val("");
        //$("#IsPushData").prop('checked', true);
        $("#spvalidation").text("");
        $("#DevicePassword").val("");
        $("#DeviceTypeCode").val("");
        $("#spvalidation").hide();
        $("#spDeviceCode").hide();
        $("#spDeviceSrNo").hide();

        $("#DeviceSrNo").removeClass('field_error');
        $("#DeviceName").removeClass('field_error');
        $("#DeviceCode").removeClass('field_error');
        $("#DeviceIP").removeClass('field_error');
        $("#DevicePort").removeClass('field_error');
        $("#DeviceTypeCode").removeClass('field_error');
        $("#ddlCompany1").val("0");
        //$("#select2-ddlCompany1-container").html("Select Company");
        //$("#select2-ddlCompany1-container").attr("title", "Select Company");
        $("#BranchId").empty();
        $("#BranchId").append("<option value='0' selected> Select Branch </option>");
        }
        function Clear() {
        $("#ddlCompany").val("0");
        $("#select2-ddlCompany-container").html("Select Company");
        $("#select2-ddlCompany-container").attr("title", "Select Company");
        $("#ddlBranch").empty();
        $("#ddlBranch").append("<option value='0' selected> Select Branch </option>");

        $("#DepartmentID option:selected").prop("selected", false);
        $("#DepartmentID").multiselect('refresh');
        $("#DepartmentID").multiselect('disable');
        //$(".alert-danger").hide();
        //$(".alert-success").hide();
        $("#tblEmp tbody").empty();
        $("#DeptIds option:selected").prop("selected", false);
        $("#DeptIds").multiselect('refresh');
        $("#DeptIds").empty();
        $("#DeptIds").multiselect('disable');
        $(".ClsChkAllDept").prop('checked', false);
        $(".ClsChkAllEmp").prop('checked', false);
        var nextStepWizard = $('div.setup-panel div a[href="#step-1"]').parent().children("a");
        nextStepWizard.removeAttr('disabled').trigger('click');

        }
</script>

<div class="page-bar">
    <div class="page-toolbar">
        <div class="text-right">
            <a href="#" id="AddDevice" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Add Device"><i class="fa-solid fa-plus"></i></a>
        </div>
    </div>
</div>

<!-- END PAGE TITLE-->
<!-- END PAGE HEADER-->
<div id="ajax_loaderDevice" class="modal_bg loading" aria-hidden="true">
    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
</div>
<div class="row">
    <div class="col-md-12">
        <div class="portlet">
            <div class="portlet-body">
                <div class="table-responsive" id="tableResponsive">
                    <table id="tbldevice" class="table new_datatbl table-striped table-bordered table-hover table-checkable order-column">
                        <thead>
                            <tr>
                                <th>Sr. No</th>
                                <th hidden>Device ID</th>
                                <th hidden>Company ID</th>
                                <th hidden>Company Code</th>
                                <th hidden>Branch ID</th>
                                <th hidden>Branch Name</th>
                                <th> Device</th>
                                <th>Device SrNo</th>
                                <th>Device Code</th>
                                <th> Device IP </th>
                                <th hidden>Device Port</th>
                                <th> Mode </th>
                                <th hidden> IsPushData </th>
                                <th hidden>Device Password</th>
                                <th>Device Type</th>
                                <th hidden>Typecode</th>
                                <th>Status</th>
                                <th>Last Activity</th>
                                <th> Actions </th>
                            </tr>
                        </thead>
                        @{
                            int n = 1;
                        }
                        <tbody>
                            @if (Model.DeviceList != null)
                            {

                                foreach (var i in Model.DeviceList)
                                {
                                    <tr class="odd gradeX">
                                        <td>@n</td>
                                        <td id="devicecode" hidden>@i.DeviceId</td>
                                        <td id="CompanyID" hidden>@i.CompanyId</td>
                                        <td id="CompanyCode" hidden>@i.CompanyCode</td>
                                        <td id="BranchID" hidden>@i.BranchId</td>
                                        <td id="BranchName" hidden>@i.BranchName</td>
                                        <td id="Devicenames">
                                            @i.DeviceName
                                            @*<a class="dvclass bg-hover-blue" id="devicenm">
                                                    <span id="sp2">@i.DeviceName</span>
                                                </a>*@
                                        </td>
                                        <td>@i.DeviceSrNo</td>
                                        <td>@i.DeviceCode</td>
                                        <td>@i.DeviceIP</td>
                                        <td hidden>@i.DevicePort </td>
                                        <td>@i.Mode</td>
                                        <td hidden>@i.IsPushData</td>
                                        <td hidden>@i.DevicePassword</td>
                                        <td>@i.DeviceType</td>
                                        <td hidden>@i.DeviceTypeCode</td>
                                        @if (i.DeviceStatus.ToLower() == "Standby")
                                        {
                                            <td style="color:#FFBF00;"><b>@i.DeviceStatus</b></td>
                                        }
                                        else if (i.DeviceStatus.ToLower() == "online")
                                        {
                                            <td style="color:green;"><b>@i.DeviceStatus</b></td>
                                        }
                                        else
                                        {
                                            <td style="color:#FFBF00;"><b> @i.DeviceStatus</b></td>
                                        }
                                        <td>@i.LastActivity</td>
                                        <td id="Col_@i.DeviceCode">
                                            <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>
                                        </td>
                                    </tr>
                                    n++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <label id="hdndevicecnt" hidden>@Model.DeviceList.Count()</label>
                <label id="hdndeviceid" hidden></label>
                <label id="hdndeviceCode" hidden></label>
            </div>
        </div>
    </div>
</div>
<div id="frmpopup" class="modal fade  bs-modal-lg" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Device</h4>
            </div>
            @using (Html.BeginForm("Device", "Developers"))
            {
                <div class="modal-body">
                    <div class="modal-card">
                        <div class="row">
                            <div class="col-md-6">
                                <fieldset>
                                    <div class="form-group" hidden>
                                        <label>Device ID </label>
                                        <input type="text" class="form-control input-sm" id="DeviceId" name="DeviceId">
                                    </div>
                                    <div class="form-group" id="srlbl">
                                        <label>Device Sr.No</label>  <a class="badge badge-primary tooltips" data-placement="right" title="" data-original-title="Device serial number is unique identification number of your device"><i class="fa-light fa-question"></i></a>
                                        <input type="text" class="form-control input-sm" placeholder="Enter Device Sr.No" id="DeviceSrNo" name="DeviceSrNo" maxlength="50">
                                        <input type="text" class="form-control input-sm" id="TempSrno" hidden>
                                        <span class="help-block" style="color:red;" hidden id="spDeviceSrNo"></span>
                                    </div>
                                    <div class="form-group">
                                        <label>Device Name <span class="required" aria-required="true"> * </span></label>
                                        <input type="text" class="form-control input-sm" placeholder="Enter Device Name" id="DeviceName" name="DeviceName" required="" maxlength="80">
                                    </div>
                                    <div class="form-group">
                                        <label>Device IP <span class="required" aria-required="true"> * </span></label>
                                        <input type="text" class="form-control input-sm" placeholder="Enter Device IP" id="DeviceIP" name="DeviceIP" required="" pattern="((^|\.)((25[0-5])|(2[0-4]\d)|(1\d\d)|([1-9]?\d))){4}$">
                                        <span class="help-block" style="color:red;" hidden id="spvalidation"></span>
                                    </div>
                                    <div class="form-group">
                                        <label>Device Port <span class="required" aria-required="true"> * </span></label>
                                        <input type="text" class="form-control input-sm" placeholder="Enter Device Port Number" id="DevicePort" name="DevicePort" required="" maxlength="11">
                                    </div>
                                    <div class="form-group" hidden>
                                        <label class="check mt-checkbox mt-checkbox-outline">
                                            <input name="IsPushData" value="1" type="checkbox" id="IsPushData" checked disabled>Push Data
                                            <span></span>
                                        </label>
                                    </div>
                                </fieldset>
                            </div>
                            <div class="col-md-6">
                                <fieldset>
                                    <div class="form-group">
                                        <label>Device Type <span class="required" aria-required="true"> * </span></label>
                                        @if (Model.DeviceTypeList != null)
                                        {
                                            @Html.DropDownList("DeviceTypeCode", new SelectList(ViewBag.DeviceTypelst, "DeviceTypeCode", "DeviceType"), "Select Device Type", new { @class = "form-control input-sm" })
                                        }
                                        else
                                        {
                                            @Html.DropDownList("DeviceTypeCode", new SelectList(new[] { "" }), "Select Device Type", new { @class = "form-control input-sm" })
                                        }
                                    </div>
                                    <div class="form-group">
                                        <label>Device Code <span class="required" aria-required="true"> * </span>(Entered DeviceId which is configured in your device should be unique) </label>
                                        <input type="text" class="form-control input-sm" placeholder="Enter Device Code" id="DeviceCode" name="DeviceCode" required>
                                        <span class="help-block" style="color:red;" hidden id="spDeviceCode"></span>
                                    </div>
                                    <div class="form-group">
                                        <label>Device Password</label>
                                        <input type="password" class="form-control input-sm" placeholder="Enter Device Password" id="DevicePassword" name="DevicePassword">
                                    </div>
                                </fieldset>
                            </div>
                            <div class="col-lg-12">
                                <label><b>Important Note :</b>You must configure Server IP address as:<span id="spipaddd"></span> and Server Port as:<span id="spdeviceport"></span> in your device. </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="col-lg-12 editor-field text-right col-md-12">
                        <button type="submit" class="btn btn-sm blue" id="btnsubmit"><i class="fa-light fa-floppy-disk"></i> Save</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script>
    $('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');
                        /*$('.overlay').fadeIn('fast').delay(5000).fadeOut('slow');*/
</script>
