<div class="row">
    <div id="frmKYCDetails" class="modal fade bs-modal-lg modal-scroll modal-overflow in" role="dialog" data-keyboard="false" data-backdrop="static" style="right: 0px !important; left: auto; top: auto; bottom: 0 !important;">
        <div class="modal-dialog modal-sm" style="margin:0;">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" id="closekycdetails" onclick="closekycdetails();">&times;</button>
                    <h4 class="modal-title">KYC Details</h4>
                </div>
                <div class="modal-body">
                    <fieldset>
                        <div class="row">
                            <div class="col-md-12">
                                <div id="spKycvalidation" style="color:red;"></div>
                            </div>
                            <div class="col-md-12" id="empget">
                                <div class="form-group">
                                    <input type="hidden" id="KycCompanyID" />
                                    <label>  Mobile No <span class="required" aria-required="true"> * </span> </label>
                                    <input type="text" multiple class="form-control input-sm" name="KycMobileno" id="KycMobileno" placeholder="Mobile No" maxlength="10">
                                </div>
                                <div class="form-group">
                                    <label>Address <span class="required" aria-required="true"> * </span></label>
                                    <textarea class="form-control" rows="4" name="KycAddress" id="KycAddress" placeholder="Address" maxlength="150" onkeyup="this.value = this.value.replace(/[<>]/g, '').replace(/\//g, '')"></textarea>
                                </div>
                                <button class="btn blue btn-sm nextBtn pull-right" type="button" id="btnKycSave" onclick="SaveKycdetails();"> Save </button>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</div>

