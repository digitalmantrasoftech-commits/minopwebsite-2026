@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutDevelopers.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _companyid = HttpContext.Current.Session["CompanyId"].ToString();
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
}

<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/Scripts/toastr.min.js"></script>
<link href="~/Content/toastr.min.css" rel="stylesheet" />

<link href="~/assets/plugins/codemirror/codemirror.css" rel="stylesheet" type="text/css" />
<link href="~/assets/plugins/codemirror/neat.css" rel="stylesheet" />

