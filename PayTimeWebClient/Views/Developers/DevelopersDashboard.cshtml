<script type="text/javascript">
    $(document).ready(function () {
        var token = '@_tokan';
        var webapiurl = '@_webapiurl';
        $(".alert").hide();
        if ("@_Message" != "") {
            toastr.remove();
            toastr.success("@_Message");
            //$(".alert-danger").hide();
            //$(".alert-success").show();
        }

        if ('@_error' != "") {
            toastr.remove();
            toastr.error('@_error');
            //$(".alert-danger").show();
            //$(".alert-success").hide();
        }
        $('#KycAddress').keypress(function (e) {
            var keyCode = e.which;
            var Responce = validateAddress(keyCode);
            if (Responce == true) {
            }
            else { e.preventDefault(); }
        });
        $("#KycMobileno").change(function () {
            $('#KycMobileno').removeClass('field_error');
        });
        $("#KycAddress").change(function () {
            $("#KycAddress").removeClass('field_error');
        });
        $('#KycMobileno').keydown(function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $("#KycMobileno").keypress(function (e) {
            $("#KycMobileno").removeClass('field_error');
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
            else {
                return true;
            }
        });
        $("#KycMobileno").change(function () {
            var kycMobileNo = $("#KycMobileno").val();
            var regex = /^[789]\d{9}$/;
            if (!regex.test(kycMobileNo)) {
                $("#KycMobileno").addClass('field_error');
                $(this).val("");
                return false;
            }
        });
        $('#KycMobileno').on('paste', function (e) {
            e.preventDefault();
        });
        $('#KycAddress').on('paste', function (e) {
            e.preventDefault();
        });
        $("#SayHelloURL").change(function () {
            var url = $("#SayHelloURL").val();
            var pattern = /^(http|https)?:\/\/[a-zA-Z0-9-\.]+\.[a-z]{2,4}/;
            if (pattern.test(url)) {
                return true;
            } else {
                $("#SayHelloURL").removeClass('field_error');
                $("#SayHelloURL").val('');
                return false;
            }
        });
        $("#TransactionDataURL").change(function () {
            var url = $("#TransactionDataURL").val();
            var pattern = /^(http|https)?:\/\/[a-zA-Z0-9-\.]+\.[a-z]{2,4}/;
            if (pattern.test(url)) {
                return true;
            } else {
                $("#TransactionDataURL").removeClass('field_error');
                $("#TransactionDataURL").val('');
                return false;
            }

        })
        $("#btnSubmit").click(function (event) {
            if ($("#SayHelloURL").val() == "") {
                $("#SayHelloURL").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#SayHelloURL").removeClass('field_error');
            }
            if ($("#TransactionDataURL").val() == "") {
                $("#TransactionDataURL").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#TransactionDataURL").removeClass('field_error');
            }
        });

        //-- Stop Developer GetKyc Details
        @*$.ajax({
            type: "GET",
            url: "@_webapiurl" + "DashBoard/DeveloperGetKycDetails",
            data: { CompanyID: '@_companyid' },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                $('#KycAddress').val(data[0].CompanyAddress);
                $('#KycMobileno').val(data[0].CompanyContact);
                $('#KycCompanyID').text(data[0].CompanyID);
                if ($('#KycAddress').val() == "" || $("#KycMobileno") == "") {
                    $('#frmKYCDetails').show();
                }
                else {
                    $('#frmKYCDetails').hide();
                }
            },
            error: function () {
            }
        });*@
        function checkUrl(url) {
            //regular expression for URL
            var pattern = /^(http|https)?:\/\/[a-zA-Z0-9-\.]+\.[a-z]{2,4}/;
            if (pattern.test(url)) {
                return true;
            } else {
                return false;
            }
        }

    });
    function SaveKycdetails() {
        if ($("#KycMobileno").val().trim() == "") {
            $("#KycMobileno").addClass('field_error');
            $("#KycMobileno").focus();
            event.preventDefault();//or return false
            return false;
        }
        else {
            $("#KycMobileno").removeClass('field_error');
        }
        if ($("#KycAddress").val().trim() == "") {
            $("#KycAddress").addClass('field_error');
            $("#KycAddress").focus();
            event.preventDefault();//or return false
            return false;
        }
        else {
            $("#KycAddress").removeClass('field_error');
        }
        if ($("#KycMobileno").val().length != 10) {
            $("#spKycvalidation").text("Please enter mobile no 10 digits.");
            return false;
        }
        if ($("#KycAddress").val().length < 10) {
            $("#spKycvalidation").text("Please enter Kyc address minimum 10 digits.");
            return false;
        }
        var obj = {
            CmpID: '@_companyid',
            CompanyID: $('#KycCompanyID').text(),
            KycMobileno: $("#KycMobileno").val(),
            Kycaddress: $("#KycAddress").val(),
        }
        $.ajax({
            type: "GET",
            url: "@_webapiurl" + "DashBoard/UpdateDeveloperKycDetails",
            data: obj,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            beforeSend: function (xhr) {
                //loadingAjax('ajax_loaderallemp');
            },
            success: function (data) {
                if (data = "Ok") {
                    $("#spKycvalidation").text('Updated kycdetails successfully.');
                    $('#frmKYCDetails').hide();
                }
                else {
                    $("#spKycvalidation").text('Error in updating Kycdetails.');
                    $('#frmKYCDetails').show();

                }
            },
            error: function () {
                alert('Error on UpdateKycDetails');
                console.log("Error on UpdateKycDetails");
            }
        });

    };
    function closekycdetails() {
        $('#frmKYCDetails').hide();
    }
</script>

<div class="row margin-top-5">
    @if (ViewBag.AllCounter != null)
    {
        foreach (var i in ViewBag.AllCounter)
        {
            <div class="col-md-4 col-sm-12">
                <div class="row">
                    <div class="col-lg-6 col-xs-6">
                        <div class="dashboard-stat card dashboard-stat-v2" id="showtrans" data-step="1" data-intro="This shows Count of total transaction data.!">
                            <div class="visual">
                                <i class="fa-light fa-chart-waterfall"></i>
                            </div>
                            <div class="details">
                                <div class="number">
                                    <span data-counter="counterup" id="allempcounter" data-value="@i.transactiondatacount">0</span>
                                </div>
                            </div>
                            <div class="desc">Transaction Data</div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-xs-6">
                        <div class="dashboard-stat card dashboard-stat-v2" id="showdevice" data-step="1" data-intro="This shows total count of device.!">
                            <div class="visual">
                                <i class="fa-light fa-fax"></i>
                            </div>
                            <div class="details">
                                <div class="number">
                                    <span id="getdevicecounter" data-counter="counterup" data-value="@i.devicecount">0</span>
                                </div>
                            </div>
                            <div class="desc">Device</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    <div class="col-md-8 col-sm-12">
        <div class="row">
            <div class="col-lg-6">
                <div class="portlet light bordered margin-bottom-15">
                    <div class="api_block">
                        <h4 class="title_block font-blue bold uppercase"><i class="fa-light fa-code"></i> Say Hello Api : </h4>
                        <p>The api where device will send its status.</p>
                        <p>when device is online it will send its unique serial number, dateTime as request every 1 min and in response it takes acknowledgment as status in 0 or 1. </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="portlet light bordered margin-bottom-15">
                    <div class="api_block">
                        <h4 class="title_block font-blue bold uppercase"><i class="fa-light fa-code"></i> Transaction Data Api : </h4>
                        <p>The api where device will send its punch data.</p>
                        <p>Device will send transaction data like transaction Id,transaction DateTime, mode, deviceid, punchid etc as request parameter for every punch and in response it takes acknowledgment as transaction id and status of the transaction in 0 or 1. </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

