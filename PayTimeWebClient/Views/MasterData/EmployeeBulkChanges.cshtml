    // Helper functions
    function disableFormFields() {
        $CompanyID.prop('disabled', true);
        $BranchId.prop('disabled', true);
        $DepartmentId.prop('disabled', true);
        $DesignationId.prop('disabled', true);
        $ShiftId.prop('disabled', true);
        $RoleId.prop('disabled', true);
        $ShiftGroupId.prop('disabled', true);
        $PolicyId.prop('disabled', true);
        $ReligionId.prop('disabled', true);
        $Reportingto.prop('disabled', true);
    }

    function enableFormFields() {
        $CompanyID.prop('disabled', false);
        $BranchId.prop('disabled', false);
        $DepartmentId.prop('disabled', false);
        $DesignationId.prop('disabled', false);
        $ShiftId.prop('disabled', false);
        $RoleId.prop('disabled', false);
        $ShiftGroupId.prop('disabled', false);
