    function Save() {
        var selectedEmployee = [];
        $('#EmpIds :selected').each(function () {
            selectedEmployee.push($(this).val());
        });
        var selectedbranch = [];
        $('#BranchGeolocation :selected').each(function () {
            selectedbranch.push($(this).val());
        });
        var obj = {
            Empidlst: selectedEmployee.join(','),
            Company: $CompanyID.val(),
            Branch: $BranchId.val() || "0",
            Department: $DepartmentId.val() || "0",
            Designation: $DesignationId.val() || "0",
            Shift: $ShiftId.val() || "0",
            ShiftGroup: $ShiftGroupId.val() || "0",
            Role: $RoleId.val() || "0",
            Policy: $PolicyId.val() || "0",
            Religion: $ReligionId.val() || "0",
            BranchGeoLocation: selectedbranch.join(','),
            IsActive: $IsActive.val(),
            reporting_manager: $Reportingto.val() || "0"
        };
        var delay = 1000;
        $.ajax({
            type: "POST",
            url: '@_webapiurl' + "Master/EmployeeBulkChanges",
            headers: { 'Authorization': '@_tokan' },
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify(obj),
            dataType: "json",
            beforeSend: function () {
                $("#ajax_loader").show();
            },
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                if (data.MegSts == "OK") {
                    toastr.remove();
                    toastr.success(data.Meg);
                    setTimeout(function () {
                        window.location.reload(true);
                    }, delay);
                } else {
                    toastr.remove();
                    toastr.error(data.Meg);
                }
                $("#EmpIds option:selected").prop("selected", false);
                $Empselect.multiselect('refresh');
                $txt4.val(0);
                frmclear();
            },
            error: function (jqXHR, ajaxOptions, thrownError) {
                if (jqXHR.status == 500) { //InternalServerError = 500,
                    toastr.error("InternalServerError");
                } else if (jqXHR.status == 400) { //BadRequest = 400,
                    toastr.error("BadRequest");
                } else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
            },
            complete: function () {
                $("#ajax_loader").hide();
            }
        });
    }

