    }

    function getEmp() {
        $('#EmpIds').empty();
        var url = '';
        var cID = $("#fltCompanyID").val();
        var bID = $("#fltBranchID").val();
        var bid = Array.isArray(bID) ? bID.join() : bID;
        var depid = $("#fltDepartment").val();
        if (depid == null) {
            var DID = "";
        }
        else {
            var DID = Array.isArray(depid) ? depid.join() : depid;
        }
        var desgid = $("#fltDesignation").val();
        if (desgid == null) {
            var desid = "";
        }
        else {
            var desid = Array.isArray(desgid) ? desgid.join() : desgid;
        }
        if (RoleId > 1 && RoleId != 6805 && RoleId != 6806) {
            var url = '@_webapiurl' + 'Master/EmployeeGetAll?roleid=' + RoleId + "&loginempid=" + empid;
             $.ajax({
             method: "GET",
             url: url,
             contentType: "application/json; charset=utf-8",
             headers: { 'Authorization': '@_tokan' },
             dataType: "json",
             async: "false",
             beforeSend: function () {
                 $("#ajax_loader").show();
             },
                 success: function (response) {

                    if (response != null) {
                        const emp = response;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", emp, {
                            imageUrl: "emptyscreen_3.png",
                            subText: "No matching records found for the selected filters."
                        });
                    }
                 $('#EmpIds').empty();
                 if (response != null && response.length > 0) {
                     response.sort(function (a, b) {
                         return a.EmpName.localeCompare(b.EmpName);
                     });
                     for (var i = 0; i < response.length; i++) {
                         if (response[i].EmpId != empid) {
                             $('#EmpIds').append('<option value=" ' + response[i].EmpId + '" >' + response[i].EmpName + '(' + response[i].Empcode + ')' + '</option>');
                         }
                     }
                     $Empselect.multiselect('rebuild');
                 }
                 else {
                     const wrapper = $(".filter_portlet_wrapper");
                     wrapper.removeClass("full-width");
                     $Empselect.multiselect('rebuild');
                     disableFormFields();
                 }
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             },
             complete: function () {
                 $("#ajax_loader").hide();
             }
         });
        }
        else {
              var filterStr = bid + ";" + DID + ";" + desid;
              var filterObj = {
                  BranchStr: bid,
                  DeptStr: DID,
                  DesgStr: desid
              };
              $.ajax({
                type: "POST",
                url: "/Transactions/GetEmpByEmpBluckchanges",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(filterObj),
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                  success: function (response) {
                      if (response != null) {
                          const emp = response;
                          handleGridVisibility("tblempty", "NotificationGrid-empty", emp, {
                              imageUrl: "emptyscreen_3.png",
                              subText: "No matching records found for the selected filters."
                          });
                      }
                    $('#EmpIds').empty();
                    if (response != null && response.length > 0) {
                        response.sort(function (a, b) {
                            return a.EmpName.localeCompare(b.EmpName);
                        });
                        for (var i = 0; i < response.length; i++) {
                            $('#EmpIds').append('<option value=" ' + response[i].EmpId + '" >' + response[i].EmpName + '(' + response[i].Empcode + ')' + '</option>');
                        }
                        $Empselect.multiselect('rebuild');
                    }
                    else {
                        const wrapper = $(".filter_portlet_wrapper");
                        wrapper.removeClass("full-width");
                        $Empselect.multiselect('rebuild');
                        disableFormFields();
                    }
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    if (jqXHR.status == 500) { //InternalServerError = 500,
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) { //BadRequest = 400,
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }
    }
    function fltCompanyGetAll() {
