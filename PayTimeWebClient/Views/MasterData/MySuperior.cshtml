@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "My Superior";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //string _Message = ViewBag.msg;
    //string _error = ViewBag.error;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
      ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
      : "false"; // Default to "false" if the session is null
}

<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/orgchart/2.1.3/css/jquery.orgchart.min.css'>
<script src="~/Scripts/orgchart.min.js"></script>

<style type="text/css">
    .radiobtn_box {
        display: flex;
        align-items: center;
        font-weight: 600;
        padding-bottom: 10px;
        border-bottom: 1px solid #999999;
    }

        .radiobtn_box .chart_box {
            margin-right: 15px;
        }
    /* ================= Tree Chart Css : BEGIN ================= */
    .tree {
        min-height: 20px;
        margin-bottom: 10px;
        background-color: #fbfbfb;
        -webkit-border-radius: 4px;
        -moz-border-radius: 4px;
        border-radius: 4px;
        -webkit-box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);
        -moz-box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);
        box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);
    }

        .tree ul {
            padding-left: revert;
        }

        .tree li {
            list-style-type: none;
            margin: 0;
            padding: 10px 0 0 0;
            position: relative;
        }

            .tree li::before, .tree li::after {
                content: '';
                left: -25px;
                position: absolute;
                right: auto;
            }

            .tree li::before {
                border-left: 1px solid #999;
                bottom: 50px;
                height: 100%;
                top: 0;
                width: 1px;
            }

            .tree li::after {
                border-top: 1px solid #999;
                height: 20px;
                top: 30px;
                width: 25px;
            }

            .tree li span {
                -moz-border-radius: 5px;
                -webkit-border-radius: 5px;
                border: 1px solid #cfcfcf;
                border-radius: 5px;
                display: inline-block;
                padding: 3px 8px;
                text-decoration: none;
                width: 100%;
            }

                .tree li span i {
                    margin-right: 6px;
                    color: var(--navyblue_color);
                }

                .tree li span img.emp_image {
                    width: 32px;
                    height: 32px;
                    border-radius: 50% !important;
                    margin-right: 6px;
                }

            .tree li.parent_li > span {
                cursor: pointer;
            }

        .tree > ul > li::before, .tree > ul > li::after {
            border: 0;
        }

        .tree li:last-child::before {
            height: 30px;
        }

        .tree li.parent_li > span:hover, .tree li.parent_li > span:hover + ul li span {
            background: #dcedf9;
            border: 1px solid #94a0b4;
            color: #000;
        }
    /* ================= Tree Chart Css : END ================= */


    /* ================= Organization Chart Css : BEGIN ================= */
    #chart-container {
        height: 370px;
        /*height: 480px;*/
        border: 2px dashed #aaa;
        border-radius: 5px !important;
        text-align: center;
        margin-top: 10px;
        overflow: auto !important;
    }

    .orgchart {
        background: #fff;
        /*display: flex;
        justify-content: center;*/
    }

        .orgchart .node {
            width: 150px;
            margin-top: 20px;
        }

            .orgchart .node:hover, .orgchart .node.focused {
                box-shadow: 0 0px 2px 3px rgba(236, 243, 255);
                border-radius: 5px !important;
                background-color: transparent;
            }

    #github-link {
        position: fixed;
        top: 0px;
        right: 10px;
        font-size: 3em;
    }

    .orgchart .verticalNodes ul {
        padding-left: 25px;
    }

    .orgchart .verticalNodes > td::before {
        border: 1px solid var(--navyblue_color);
    }

    .orgchart .verticalNodes ul > li::after, .orgchart .verticalNodes ul > li::before {
        border-color: var(--navyblue_color);
        left: -11px;
    }

    .orgchart .verticalNodes > td > ul > li:first-child::before {
        height: 72px;
    }

    .orgchart .verticalNodes ul > li:first-child::after {
        top: 68px;
    }

    .orgchart .verticalNodes ul > li::before {
        top: 0px;
        height: 70px;
    }

    .orgchart .verticalNodes > td > ul > li:first-child::before {
        width: calc(50% - 0px);
    }

    .orgchart .node .title {
        background-color: transparent;
        color: #111;
        font-size: 13px;
    }

    .orgchart .node .content {
        border: none;
        background-color: transparent;
        font-size: 12px;
        margin-left: 0;
        padding: 0;
    }

    .orgchart .lines .topLine {
        border-top: 2px solid var(--navyblue_color);
    }

    .orgchart .lines .downLine {
        background-color: var(--navyblue_color);
    }

    .orgchart .lines .leftLine {
        border-left: 1px solid var(--navyblue_color);
    }

    .orgchart .lines .rightLine {
        border-right: 1px solid var(--navyblue_color);
    }

    .orgchart > table:first-child {
        margin: 5px auto;
    }

    .orgchart .node .content.img_height {
        height: 25px;
        overflow: inherit;
    }

        .orgchart .node .content.img_height img {
            height: 40px;
            width: 40px;
            border: 2px solid var(--navyblue_color);
            border-radius: 50% !important;
            position: relative;
            top: -20px;
        }

    .orgchart .node .title .symbol {
        display: none;
    }

    .mysuperiors_box {
        border: 1px solid var(--navyblue_color);
        border-radius: 5px !important;
        padding: 0 5px;
    }

    .orgchart table tbody tr td .node.firstlevel {
        padding-top: 3px;
    }
    /* ================= Organization Chart Css : END ================= */
</style>

