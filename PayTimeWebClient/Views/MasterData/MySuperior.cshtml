<script>
    $("document").ready(function () {
        var _EmphierID = '@Convert.ToInt32(Session["EmpId"])'
        var roleID = '@_RoleId';
        var treeChartGenerated = false;
        var flowChartGenerated = false;
        getEmployeeHierachytree();
        treeChartGenerated = true;
        function getEmployeeHierachy() {
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + 'Master/GetMySuperior?loginempId=' + _EmphierID + '&roleid=' + roleID,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response != null) {

                        var oc = $("#chart-container").orgchart({
                            data: response[0],
                            nodeTemplate: nodeTemplate,
                            nodeTitle: "EmpName",
                            nodeId: "ReportingTo",
                            nodeContent: "EmpCode",
                            pan: true,
                            zoom: true,
                            draggable: true,

                            createNode: function ($node, data) {
                                $node[0].id = getId();
                                //Mouse doubleclick
                                $node.on("dblclick", function () {
                                    self.Data.SelectTextsInColumn(1, false, data.path);
                                });

                            }
                        });
                    } else {

                    }
                },
                error: function (response) {

                }
            });
        }
        function getEmployeeHierachytree() {
            $.ajax({
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + 'Master/GetMySuperior?loginempId=' + _EmphierID + '&roleid=' + roleID,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response != null) {
                        var parentElement = $('#tree_chart');

                        // Create the tree container elements
                        var treeDiv = $('<div>').addClass('tree');
                        var treeUl = $('<ul>').css('padding-left', '0px');

                        // Generate the tree structure
                        generateTree(response[0], treeUl);

                        // Append the tree elements to the parent container
                        treeDiv.append(treeUl);
                        parentElement.append(treeDiv);

                    } else {

                    }
                },
                error: function (response) {

                }
            });
        }

        function generateTree(data, treeUl) {
            //var ul = $('<ul>').css('padding-left', '0');
            //parentElement.append(ul);

            var li = $('<li>');
            treeUl.append(li);


            var span = $('<span>').html(data.EmpName + ' (' + data.DesignationName + ') - ' + data.EmpCode);
            li.append(span);
            var icon;
            if (data.children && data.children.length > 0) {
                icon = $('<i>').addClass('fa-regular fa-square-minus');
                span.prepend(icon);
                li.addClass('parent');

                var childUl = $('<ul>');
                li.append(childUl);


                data.children.forEach(function (child) {
                    var childLi = $('<li>');
                    childUl.append(childLi);
                    generateTree(child, childLi);
                });
            }
            //var avtarimage = "/UploadEmpPhoto/avtar.png";
            //var imgSrc = data.EmpPhoto ? data.EmpPhoto : avtarimage;
            //if (data.EmpPhoto != null) {
            //    span.prepend('<img class="emp_image" src="' + imgSrc + '" />');
            //}

            const randomColor = "#295097";
            var nameParts = data.EmpName.replace(/\s+/g, ' ').trim().split(" ");
            var initials = nameParts[0].charAt(0).toUpperCase();
            if (nameParts.length > 1) {
                initials += nameParts[1].charAt(0).toUpperCase();
            }

            span.prepend(`<img alt="" class="emp_image" src="${data.EmpPhoto}"                         
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"/>
                          <span style="display: none; min-width: 32px; width: auto; height: 32px; line-height: 32px; padding: 0; text-align: center; background-color: #ecf3ff; color: ${randomColor}; border-radius: 50% !important; border: 1px solid #8ab1f7; margin-right: 8px;">
                          ${initials}</span>`);
            if (icon) {
                icon.click(function () {
                    $(this).toggleClass('fa-plus-square fa-minus-square');
                    $(this).siblings('ul').toggle();
                });
            }
            span.click(function () {
                $(this).siblings('i').toggleClass('fa-regular fa-square-minus fa-regular fa-square-minus');
                $(this).siblings('ul').toggle();
            });

        }

        var getId = function () {
            return new Date().getTime() * 1000 + Math.floor(Math.random() * 1001);
        };



        //var nodeTemplate = function (data) {
        //    directReports = "";
        //    var avtarimage = "/UploadEmpPhoto/avtar.png";
        //    var imgSrc = data.EmpPhoto ? data.EmpPhoto : avtarimage;
        //    //var content = $("<div>", { class: "content img_height" }).append(img).append(span);
        //    var content = $("<div>", { class: "content img_height" }).append($("<img>", { src: imgSrc }));
        //    var title = $("<div>", { class: "title" }).text(data.EmpName + " " + directReports);
        //    var empcode = $("<div>", { class: "content" }).text(data.EmpCode);
        //    var designation = $("<div>", { class: "content" }).text(data.DesignationName);
        //    var result = $("<div class='mysuperiors_box'>").append(content, title, empcode, designation);
        //    return result;

        //};

        var nodeTemplate = function (data) {
            var directReports = "";
            var imgSrc = data.EmpPhoto;

            // Generate initials from EmpName
            var nameParts = data.EmpName.trim().split(" ");
            var initials = nameParts[0].charAt(0).toUpperCase();
            if (nameParts.length > 1) {
                initials += nameParts[1].charAt(0).toUpperCase();
            }

            // Optional: Generate random pastel color
            //var randomColor = "#" + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0');
            const randomColor = "#295097";

            // Create image element
            var img = $("<img>", {
                src: imgSrc,
                alt: "",
                class: "emp_image",                
                onerror: "this.style.display='none'; this.nextElementSibling.style.display='inline-block';"
            });

            // Create initials fallback span
            var span = $("<span>", {
                text: initials,
                style: `display: none; min-width: 40px; width: auto; height: 40px; line-height: 38px; padding: 0; text-align: center; background-color: #ecf3ff;
                color: ${randomColor}; border-radius: 50% !important; border: 1px solid #8ab1f7; position: relative; top: -20px;`});

            // Combine image and initials in one content div
            var content = $("<div>", { class: "content img_height" }).append(img, span);

            // Other details
            var title = $("<div>", { class: "title" }).text(data.EmpName + " " + directReports);
            var empcode = $("<div>", { class: "content" }).text(data.EmpCode);
            var designation = $("<div>", { class: "content" }).text(data.DesignationName);

            // Final wrapper
            var result = $("<div class='mysuperiors_box'>").append(content, title, empcode, designation);
            return result;
        };



        // Select Radio Show/Hide Div Jquery Code
        $('#radio_tree').change(function () {
            $(this).checked = true;
            $("#tree_chart").show();
            $("#flow_chart").hide();

            $("#radio_flow").checked = false;
            if (!treeChartGenerated) {
                getEmployeeHierachytree();
                treeChartGenerated = true;
            }
        });
        $('#radio_flow').change(function () {
            $("#tree_chart").hide();
            $("#flow_chart").show();
            $(this).checked = true;
            $("#radio_tree").checked = false;
            if (!flowChartGenerated) {
                getEmployeeHierachy();
                flowChartGenerated = true;
            }
        });


        // Plus Minus Click Data Show Jquery
        $(function () {
            $('.tree li:has(ul)').addClass('parent_li').find(' > span').attr('title', '');
            $('.tree li.parent_li > span').on('click', function (e) {
                var children = $(this).parent('li.parent_li').find(' > ul > li');
                if (children.is(":visible")) {
                    children.hide('fast');
                    $(this).attr('title', '').find(' > i').addClass('fa-plus-square').removeClass('fa-minus-square');
                } else {
                    children.show('fast');
                    $(this).attr('title', '').find(' > i').addClass('fa-minus-square').removeClass('fa-plus-square');
                }
                e.stopPropagation();
            });
        });







        (function ($) {
            function download(content, fileName, contentType) {
                var a = document.createElement("a");
                var file = new Blob([content], { type: contentType });
                a.href = URL.createObjectURL(file);
                a.download = fileName;
                a.click();
            }
            $(function () {
                var getId = function () {
                    return new Date().getTime() * 1000 + Math.floor(Math.random() * 1001);
                };

                var nodeTemplate = function (data) {
                    directReports = "";
                    var content = $("<div>", { class: "content img_height" }).append($("<img>", { src: data.image }));
                    var title = $("<div>", { class: "title" }).text(data.name + " " + directReports);
                    var empcode = $("<div>", { class: "content" }).text(data.empcode);
                    var designation = $("<div>", { class: "content" }).text(data.designation);

                    var result = $("<div class='mysuperiors_box'>").append(content, title, empcode, designation);
                    return result;

                };

                var oc = $("#chart-container").orgchart({
                    data: datascource,
                    nodeTemplate: nodeTemplate,
                    nodeTitle: "name",
                    nodeId: "id",
                    nodeContent: "title",
                    pan: true,
                    zoom: true,
                    draggable: true,
                    createNode: function ($node, data) {
                        $node[0].id = getId();
                        //Mouse doubleclick
                        $node.on("dblclick", function () {
                            self.Data.SelectTextsInColumn(1, false, data.path);
                        });

                    }
                });

                $("#btn-export").on("click", function () {
                    $("#btn-reset").click(); //clears any highlighted nodes
                    exportFilename = "PostsOrgChart.json";
                    exportFileExtnesion = $("[id$='chart-export-panel']")
                      .find(":checked")
                      .val();

                    if (exportFileExtnesion == "json") {
                        var hierarchy = oc.getHierarchy("True");
                        var tree = JSON.stringify(hierarchy);
                        download(tree, exportFilename, "text/plain");
                    } else {
                        oc.export(exportFilename, exportFileExtnesion);
                    }
                });

                oc.$chartContainer.on("click", ".node", function () {
                    var $this = $(this);
                    $("#selected-node").val($this.find(".title").text()).data("node", $this);
                    $("#selected-node-content")
                      .val($this.find(".content").html())
                      .data("node", $this);

                    //alert($this.find('.title').text() + ' ' + $this.find('.content').text());
                });

                oc.$chartContainer.on("click", ".orgchart", function (event) {
                    if (!$(event.target).closest(".node").length) {
                        $("#selected-node").val("");
                        $("#selected-node-content").val("");
                    }
                });

                $('input[name="chart-state"]').on("click", function () {
                    $(".orgchart").toggleClass("edit-state", this.value !== "view");
                    $("#edit-panel").toggleClass("edit-state", this.value === "view");
                    if ($(this).val() === "edit") {
                        $(".orgchart")
                          .find(".hidden")
                          .removeClass("hidden")
                          .end()
                          .find(".hierarchy")
                          .removeClass(
                            "isCollapsedDescendant isChildrenCollapsed isSiblingsCollapsed isCollapsedSibling"
                          )
                          .find(".node")
                          .removeClass("slide-up slide-down slide-right slide-left");
                    } else {
                        $("#btn-reset").trigger("click");
                    }
                });

                $('input[name="node-type"]').on("click", function () {
                    var $this = $(this);
                    if ($this.val() === "parent") {
                        $("#edit-panel").addClass("edit-parent-node");
                        $("#new-nodelist").children(":gt(0)").remove();
                    } else {
                        $("#edit-panel").removeClass("edit-parent-node");
                    }
                });

                $("#btn-add-input").on("click", function () {
                    $("#new-nodelist").append(
                      '<li><label>new node:</label><input type="text" class="new-node" placeholder="New PostID"><label>new node content:</label><input type="text" class="new-node-content" placeholder="New Content"></li>'
                    );
                });

                $("#btn-remove-input").on("click", function () {
                    var inputs = $("#new-nodelist").children("li");
                    if (inputs.length > 1) {
                        inputs.last().remove();
                    }
                });

                $("#btn-add-nodes").on("click", function () {
                    var $chartContainer = $("#chart-container");
                    var nodeVals = [];
                    $("#new-nodelist")
                      .find(".new-node")
                      .each(function (index, item) {
                          var validVal = item.value.trim();
                          if (validVal.length) {
                              nodeVals.push(validVal);
                          }
                      });
                    console.log(nodeVals);
                    var $node = $("#selected-node").data("node");
                    if (!nodeVals.length) {
                        alert("Please input value for new node");
                        return;
                    }
                    var nodeType = $('input[name="node-type"]:checked');
                    if (!nodeType.length) {
                        alert("Please select a node type");
                        return;
                    }
                    if (nodeType.val() !== "parent" && !$(".orgchart").length) {
                        alert(
                          "Please create the root node firstly when you want to build up the orgchart from the scratch"
                        );
                        return;
                    }
                    if (nodeType.val() !== "parent" && !$node) {
                        alert("Please select one node in orgchart");
                        return;
                    }
                    if (nodeType.val() === "parent") {
                        if (!$chartContainer.children(".orgchart").length) {
                            // if the original chart has been deleted
                            oc = $chartContainer.orgchart({
                                data: { name: nodeVals[0] },
                                chartClass: "edit-state",
                                exportButton: true,
                                exportFilename: "PostsOrgChart",
                                createNode: function ($node, data) {
                                    $node[0].id = getId();
                                }
                            });
                        } else {
                            oc.addParent($chartContainer.find(".node:first"), {
                                name: nodeVals[0],
                                title: "parent",
                                id: getId(),
                                className: "new-parent"
                            });
                        }
                    } else if (nodeType.val() === "siblings") {
                        if ($node[0].id === oc.$chart.find(".node:first")[0].id) {
                            alert(
                              "You are not allowed to directly add sibling nodes to root node"
                            );
                            return;
                        }
                        oc.addSiblings(
                          $node,
                          nodeVals.map(function (item) {
                              return {
                                  name: item,
                                  title: "sibling",
                                  relationship: "110",
                                  id: getId(),
                                  className: "new-sibling"
                              };
                          })
                        );
                    } else {
                        if (!$node.siblings(".nodes").length) {
                            var rel = nodeVals.length > 1 ? "110" : "100";
                            oc.addChildren(
                              $node,
                              nodeVals.map(function (item) {
                                  return {
                                      name: item,
                                      title: "child",
                                      relationship: rel,
                                      id: getId(),
                                      className: "new-child"
                                  }; //this is a new child node
                              })
                            );
                        } else {
                            oc.addSiblings(
                              $node.siblings(".nodes").find(".node:first"),
                              nodeVals.map(function (item) {
                                  return {
                                      name: item,
                                      title: "child-sibling",
                                      relationship: "110",
                                      id: getId(),
                                      className: "new-child-sibling"
                                  }; //this is a new child sibling node
                              })
                            );
                        }
                    }
                });

                $("#btn-delete-nodes").on("click", function () {
                    var $node = $("#selected-node").data("node");
                    if (!$node) {
                        alert("Please select one node in orgchart");
                        return;
                    } else if ($node[0] === $(".orgchart").find(".node:first")[0]) {
                        if (
                          !window.confirm("Are you sure you want to delete the whole chart?")
                        ) {
                            return;
                        }
                    }
                    oc.removeNodes($node);
                    $("#selected-node").val("").data("node", null);
                    $("#selected-node-content").val("").data("node", null);
                });

                $("#btn-reset").on("click", function () {
                    $(".orgchart").find(".focused").removeClass("focused");
                    $("#selected-node").val("");
                    $("#selected-node-content").val("");
                    $("#new-nodelist")
                      .find("input:first")
                      .val("")
                      .parent()
                      .siblings()
                      .remove();
                    $("#new-node-content").val("");
                    $("#node-type-panel").find("input").prop("checked", false);
                });

                $("#btn-edit-selected-node").on("click", function () {
                    var $node = $("#selected-node").data("node");
                    //console.log($node[0]);

                    if (!$node) {
                        alert("Please select one node in orgchart");
                        return;
                    } else {
                        //selected node content is this: $node.find(".title").text() + " " + $node.find(".content").text()
                        //Need to replace with inputbox contents
                        //console.log($("#selected-node").val());
                        $(".node.focused .title").html($("#selected-node").val());
                        $(".node.focused .content").html($("#selected-node-content").val());
                    }
                });
            });
        })(jQuery);

    })

</script>
