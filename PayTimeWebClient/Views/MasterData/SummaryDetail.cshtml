@{
    ViewBag.Title = "Endpointurl";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<style>
    .CodeMirror {
        height: auto !important;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {
        var ComponentsCodeEditors = {
            init: function () {
                var t, r;

                t = document.getElementsByClassName("code_editor")[0], CodeMirror.fromTextArea(t, { lineNumbers: !0, matchBrackets: !0, styleActiveLine: !0, theme: "neat", mode: "javascript", readOnly: !0 })
                r = document.getElementsByClassName("code_editor")[1], CodeMirror.fromTextArea(r, { lineNumbers: !0, matchBrackets: !0, styleActiveLine: !0, theme: "neat", mode: "javascript", readOnly: !0 })

            }
        }; jQuery(document).ready(function () { ComponentsCodeEditors.init() });

        var token = '@_tokan';
        var webapiurl = '@_webapiurl';
        GetUrl();
        $(".alert").hide();
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }
        //$("#EndPointUrl").change(function () {
        //    var url = $("#EndPointUrl").val();
        //    var pattern = /^(http|https)?:\/\/[a-zA-Z0-9-\.]+\.[a-z]{2,4}/;
        //    if (pattern.test(url)) {
        //        return true;
        //    } else {
        //        $("#EndPointUrl").removeClass('field_error');
        //        $("#EndPointUrl").val('');
        //        return false;
        //    }
        //});

        $("#btntestapi").click(function () {
            $.ajax({
                type: "POST",
                headers: { 'Authorization': '@_tokan' },
                url: '@_webapiurl' + '/Master/testProcessapi',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loaderaddon").show();
                },
                success: function (response) {

                    if (response.MegSts == "Success") {
                        toastr.remove();
                        toastr.success(response.Meg);
                        //$("#btntestapi").attr("disabled", "disabled");
                    } else if (response.MegSts == "error") {
                        toastr.remove();
                        toastr.error(response.Meg);
                    }
                },
                complete: function () {
                    $("#ajax_loaderaddon").hide();
                }
            });
        })
        $("#btnSubmit").click(function (event) {
            if ($("#EndPointUrl").val() == "") {
                toastr.remove();
                // toastr.error("Please Enter Endpointurl");
                $("#EndPointUrl").addClass('field_error');
                event.preventDefault();//or return false
                //GetUrl();
                //setTimeout(function () {
                //    $("#EndPointUrl").removeClass('field_error');
                //}, 3000);
            }
            else if ($("#EndPointUrl").val() != "") {
                var url = $("#EndPointUrl").val();
                var pattern = /^(http|https)?:\/\/[a-zA-Z0-9-\.]+\.[a-z]{2,4}/;
                if (pattern.test(url)) {
                    $("#EndPointUrl").removeClass('field_error');
                    var EndPointUrl = $("#EndPointUrl").val();
                    $.ajax({
                        type: 'POST',
                        url: '@_webapiurl' + '/Master/CreateEndpointurl?Url=' + EndPointUrl,
                        headers: { 'Authorization': '@_tokan' },
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        async: "false",
                        success: function (data) {
                            if (data != null) {
                                if (data.MegSts != null) {
                                    $("#EndPointUrl").val("");
                                    toastr.remove();
                                    toastr.success(data.MegSts);
                                    GetUrl();
                                }
                                if (data.Meg != null) {
                                    $("#EndPointUrl").val("");
                                    toastr.remove();
                                    toastr.error(data.Meg);
                                    GetUrl();
                                }

                            }
                        }

                    })
                } else {
                    $("#EndPointUrl").removeClass('field_error');
                    $("#EndPointUrl").val('');
                    toastr.remove();
                    toastr.error("Please enter valid endpointurl");
                    return false;
                }
            }
        });
        function checkUrl(url) {
            //regular expression for URL
            var pattern = /^(http|https)?:\/\/[a-zA-Z0-9-\.]+\.[a-z]{2,4}/;
            if (pattern.test(url)) {
                return true;
            } else {
                return false;
            }
        }
        function GetUrl() {
            $.ajax({
                type: 'GET',
                url: '@_webapiurl' + '/Master/GetEndpointUrl',
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: "false",
                success: function (data) {

                    if (data != null) {
                        if (data.Meg != null) {
                            $("#EndPointUrl").val(data.Meg);
                            $("#btntestapi").attr("disabled", false);
                        } else {
                            $("#btntestapi").attr("disabled", "disabled");
                        }
                    }
                }

            })
        }

    });
</script>

