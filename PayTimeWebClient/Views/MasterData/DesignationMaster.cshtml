                                        else {
                                            if ($(this).val() == _value) {
                                                $("#" + _chkID + "").prop('checked', 'checked');
                                            }
                                        }
                                        j += 1;
                                    });
                                }

                            });
                        });
                    },
                    error: function (data) {
                        //alert('error : --- Company _ GetformdataWithdetails');
                    }
                });
            }
        });
        $("#tbldesignation").on('click', '.deleteclass', function () {
            var flg = 0;
            if (confirm("Are you sure for Delete this Entry?")) {
                $("#DesignationId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
                $.post("/MasterData/DeleteDesignation?id=" + $("#DesignationId").val(), function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var _response = $.parseJSON(response);
                    if (_response == "OK") {
                        var strid = "Col_" + $("#DesignationId").val().trim();
                        $("#" + strid + "").closest('tr').remove();
                        $('#tbldesignation').DataTable();
                    }
                    else {
                        alert("something wrong occures.");
                    }
                });
            }
        });
        function frmClear() {
            $("#DesignationId").val(0);
            $("#DesignationName").val("");
            $("#DesignationName").removeClass('field_error');
            $("#DesignationName").attr("placeholder", "Enter Designation Name");
            $("#DesignationName").attr('required', true);
            $("#spDesignationName").hide();
        }
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Designation Master";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })
    });



    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }


</script>

