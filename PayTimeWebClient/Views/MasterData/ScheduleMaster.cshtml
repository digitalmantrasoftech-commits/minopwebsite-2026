@model PayTimeWebClient.Models.ScheduleAction
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Schedule Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<script type="text/javascript">
    $(document).ready(function () {
        $(".alert").hide();
        if ("@_Message" != "") {
            $(".alert-danger").hide();
            $(".alert-success").show();
        }
        if ('@_error' != "") {
            $(".alert-danger").show();
            $(".alert-success").hide();
        }
        $('#tblSchedule').DataTable();
        $("#btnAddScheduler").click(function () {
            ClearSelection();
            $("#btnAddScheduler").attr("data-toggle", "modal");
            $("#btnAddScheduler").attr("data-target", "#frmpopup");
        });
        var $selectDep = $("#DeptIds").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true
        });

        $('#CompanyID').change(function () {
            $("#CompanyID").removeClass('field_error');
            var s = $('#CompanyID').val();
            fillBranchbycompnyid(s, "");
        });

        $('#BranchId').change(function () {
            $("#BranchId").removeClass('field_error');
            $("#spvalidation").text("");
            $("#spValidation").hide();
            $("#txt3").val(0);
            $("#DeptIds").empty();
            $("#DeptIds option:selected").prop("selected", false);
            $("#DeptIds").multiselect('refresh');
            var s = $('#BranchId').val();
            $('#BranchName').val($('#BranchId :selected').text());
            $('#EmpIdTbl tr').remove();
            $('#EmpIdTbl tr').empty();
            $("#EmpIdTbl").empty();
            $.ajax({
                type: "POST",
                url: "/Transactions/GetDeptbyBranch?BranchId=" + $('#BranchId :selected').val(),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    if (response != null) {
                        $selectDep.multiselect('enable');
                        for (var i = 0; i < response.length; i++) {
                            $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                        }
                        $selectDep.multiselect('rebuild');

                    }
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        });


        $('#btnSubmit').click(function (event) {
            if (Isvalidfilter()) {

            }
        });
    });

    function fillBranchbycompnyid(companyid, selectbranch) {
        $('#BranchId').empty();
        $.ajax(
         {
             type: "GET",
             url: "/MasterData/GetBranchbycomapny",
             data: { comapanyid: companyid },
             contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
                 $("#ajax_loader").show();
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 $("#ajax_loader").hide();
                 var markup = '';

                 for (var x = 0; x < data.length; x++) {
                     markup += "<option value=" + data[x].BranchId + ">" + data[x].BranchName + "</option>";
                 }
                 var newOption = '<option selected="selected"  value="">Select Branch</option>';

                 $('#BranchId').html(newOption);
                 $('#BranchId').append(markup);
                 $('#BranchId').val(selectbranch);
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }
    function ClearSelection() {
        $("#CompanyID").val(null);
        $("#select2-CompanyID-container").html("Select Company");
        $("#select2-CompanyID-container").attr("title", "Select Company");
        $("#BranchId").empty();
        $("#BranchId").append("<option value='0'>Select Branch</option>");
        $("#BranchId").val(0);
        $("#DeptIds option:selected").prop("selected", false);
        $("#DeptIds").multiselect('refresh');
        $("#DeptIds").multiselect('disable');
        $("#CompanyID").removeClass('field_error');
        $("#BranchId").removeClass('field_error');
    }
    function Isvalidfilter() {
        if ($('#CompanyID').val() <= 0) {
            $("#CompanyID").addClass('field_error');
            $("#CompanyID").focus();
            event.preventDefault();
            return false;
        }
        else {
            $("#CompanyID").removeClass('field_error');
        }
        if ($('#BranchId').val() <= 0) {
                $("#BranchId").addClass('field_error');
                $("#BranchId").focus();
                event.preventDefault();
                return false;
        }
        else {
            $("#BranchId").removeClass('field_error');
        }
        //else if (selectedrptIdArray.length <= 0) {
        //    $("#spvalidationrpt").html("Please select at least one report").show();
        //    $('#rptIDstr').focus();
        //    return false;
        //}
    }

</script>
