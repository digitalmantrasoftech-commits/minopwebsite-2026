<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Transaction Year</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Transaction Year</span>
            </li>
        </ul>
    }
    @if (obj.CanAdd)
    {
        <div class="page-toolbar">
            <a href="javascript:void(0)" id="AddTransactionYear" class="btn icon_transparent_btn  tooltips" data-placement="left" data-original-title="Add Transaction Year"><i class="fa-solid fa-plus"></i></a>
        </div>
    }
</div>
@if (obj.CanView)
{
    <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="portlet">
                <div class="portlet-body">
                    @if (ViewBag.TransactionYearGetAll != null)
                    {
                        <div class="table-responsive" id="tableResponsive">
                            <table class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column" id="tblTransactionDetails">
                                <thead>
                                    <tr>
                                        <th hidden>Sr. No</th>
                                        <th hidden>ID</th>
                                        <th>Transaction Year</th>
                                        <th>From Year</th>
                                        <th>From Month</th>
                                        <th>To Year</th>
                                        <th>To Month</th>
                                        <th>Status</th>
                                        @*<th>Action</th>*@
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int j = 1;
                                    }
                                    @if (ViewBag.TransactionYearGetAll != null)
                                    {

                                        foreach (var i in ViewBag.TransactionYearGetAll)
                                        {


                                            <tr class="odd gradeX">
                                                <td hidden>@j</td>
                                                <td id="tid" hidden>@i.TransactionYearId</td>
                                                <td id="tname">@i.TransactionYearName</td>
                                                <td id="fyear">@i.FromYear</td>
                                                @*<td id="fm">@i.FromDate.Split('-')[1].ToString()</td>*@
                                                <td id="fm">
                                                    @if (i.FromDate.Split('-')[1].ToString() == "01")
                                                    {
                                                        <span>JAN</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "02")
                                                    {
                                                        <span>FEB</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "03")
                                                    {
                                                        <span>MAR</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "04")
                                                    {
                                                        <span>APR</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "05")
                                                    {
                                                        <span>MAY</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "06")
                                                    {
                                                        <span>JUN</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "07")
                                                    {
                                                        <span>JUL</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "08")
                                                    {
                                                        <span>AUG</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "09")
                                                    {
                                                        <span>SEP</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "10")
                                                    {
                                                        <span>OCT</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "11")
                                                    {
                                                        <span>NOV</span>
                                                    }
                                                    else if (i.FromDate.Split('-')[1].ToString() == "12")
                                                    {
                                                        <span>DEC</span>
                                                    }
                                                </td>
                                                <td id="tyear">@i.ToYear</td>
                                                <td id="tm">
                                                    @if (i.ToDate.Split('-')[1].ToString() == "01")
                                                    {
                                                        <span>JAN</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "02")
                                                    {
                                                        <span>FEB</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "03")
                                                    {
                                                        <span>MAR</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "04")
                                                    {
                                                        <span>APR</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "05")
                                                    {
                                                        <span>MAY</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "06")
                                                    {
                                                        <span>JUN</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "07")
                                                    {
                                                        <span>JUL</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "08")
                                                    {
                                                        <span>AUG</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "09")
                                                    {
                                                        <span>SEP</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "10")
                                                    {
                                                        <span>OCT</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "11")
                                                    {
                                                        <span>NOV</span>
                                                    }
                                                    else if (i.ToDate.Split('-')[1].ToString() == "12")
                                                    {
                                                        <span>DEC</span>
                                                    }
                                                </td>
                                                @if (i.IsActive)
                                                {
                                                    <td>Active</td>
                                                }
                                                else
                                                {
                                                    <td>Deactive</td>
                                                }
                                                @*<td>
                                                        <div class="btn-group-inline">
                                                            @if (obj.CanEdit)
                                                            {
                                                                <button class="editclass btn btn-xs blue tooltips" title="Edit">
                                                                    <i class="fa-regular fa-pen-to-square"> </i>
                                                                </button>
                                                            }
                                                            @if (obj.CanDelete)
                                                            {
                                                                <button class="btn btn-xs red deleteclass">
                                                                    <i class="fa-regular fa-trash-can"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    </td>*@
                                            </tr>
                                            j++;
                                        }
                                    }
                                    else
                                    {
                                        <tr colspan="8" class="odd gradeX">No Data Available</tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div id="NotificationGrid-empty">
