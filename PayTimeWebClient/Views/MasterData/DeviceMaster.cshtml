        function DepartmentGetAll(deptId) {
            $('#DepartmentId').empty();
            var DId = 0;
            if (deptId != null) {
                DId = deptId;
            }
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + 'Master/DepartmentGetAll',
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    if (response != null) {
                        $("#DepartmentId").append("<option value='0' selected>Select Department</option>");
                        // Sort the response array by branch name in ascending order
                        response.sort(function (a, b) {
                            return a.DepartmentName.localeCompare(b.DepartmentName);
                        });
                        for (var i = 0; i < response.length; i++) {
                            $("#DepartmentId").append("<option value='" + response[i].DepartmentId + "'>" + response[i].DepartmentName + "</option>");
                        }
                    }
                    if (DId != null & DId != 0) {
                        $("#DepartmentId option[value ='" + deptId + "']").prop('selected', true);
                        $('#DepartmentId').trigger('change.select2');
                    }
                    $(".loading").hide();
                    departmentid = $("#DepartmentId option:selected").val();
                    $("#DepartmentId").val(departmentid);
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }

