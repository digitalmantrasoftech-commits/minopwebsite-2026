            $("#DeviceSrNo").removeClass('field_error');
            $("#spDeviceSrNo").hide();
        });
        $("#DeviceName").keypress(function (e) {
            $("#DeviceName").removeClass('field_error');
        });
        $("#DeviceCode").bind("paste", function (e) {
            e.preventDefault();
        });
        $("#DeviceCode").bind('mouseenter', function (e) {
            var val = $(this).val();
            if (val != '0') {
                val = val.replace(/[^0-9]+/g, "")
                $(this).val(val);
            }
        });
        $("#DeviceCode").keypress(function (e) {
            $("#spDeviceCode").hide();
            $("#DeviceCode").removeClass('field_error');
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }

        });
        $("#DeviceIP").keypress(function (e) {
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57) && e.which != 46) {
                return false;
            }
            else {
                return true;
            }
            $("#DeviceIP").removeClass('field_error');
        });
        $("#DevicePort").bind("paste", function (e) {
            e.preventDefault();
        });
        $("#DevicePort").bind('mouseenter', function (e) {
            var val = $(this).val();
            if (val != '0') {
                val = val.replace(/[^0-9]+/g, "")
                $(this).val(val);
            }
        });
        $("#DevicePort").keypress(function (e) {

            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
            else {
                $("#DevicePort").removeClass('field_error');
                return true;
            }
        });
        $("#DeviceTypeCode").change(function () {
            $("#DeviceTypeCode").removeClass('field_error');
            var dip = '115.124.96.52';
            var dport = '1018';
            var deviceip = "http://service.minopcloud.com";
            if ($("#DeviceTypeCode").val() == "36") {
                dip = '115.124.96.52';
                dip = dip.bold();
                dip = dip.fontsize(3);
                dport = '9090';
                dport = dport.bold();
                dport = dport.fontsize(3);
            }
            if ($("#DeviceTypeCode").val() == "38") {
                dip = '115.124.96.52';
                dip = dip.bold();
                dip = dip.fontsize(3);
                dport = '8081';
                dport = dport.bold();
                dport = dport.fontsize(3);
            }
            $("#spipaddd").html(dip);
            $("#spdeviceport").html(dport);
            if ($("#DeviceTypeCode").val() == "33" || $("#DeviceTypeCode").val() == "34" || $("#DeviceTypeCode").val() == "37") {
                deviceip = " <a href='http://service.minopcloud.com' target='_blank'> http://service.minopcloud.com </a> ";
                //deviceip = deviceip.bold();
                deviceip = deviceip.fontsize(3);
            }
            if ($("#DeviceTypeCode").val() == "33" || $("#DeviceTypeCode").val() == "34" || $("#DeviceTypeCode").val() == "37") {
                $("#spipaddd").html(deviceip);
                $("#spdeviceport").html("--NA--");
                $("#spdeviceMFS").hide();
            }
            else {
                $("#spipaddd").html(dip);
                $("#spdeviceport").html(dport);
                $("#spdeviceMFS").show();
            }
        });
        $("#Mode").change(function () {
            $("#Mode").removeClass('field_error');
        });
        $("#CompanyId").change(function () {
            $("#CompanyId").next('.select2-container').find('.select2-selection').removeClass('field_error');
        });
        $("#BranchId").change(function () {
            $("#BranchId").next('.select2-container').find('.select2-selection').removeClass('field_error');
        });
        $("#DeviceName").change(function () {
            $("#DeviceName").removeClass('field_error');
        });
        $("#DeviceIP").change(function () {
            $("#DeviceIP").removeClass('field_error');
        });
        $("#DeviceCode").change(function () {
            $("#DeviceCode").removeClass('field_error');
        });
        $("#tbldevicemaster").on('click', '.editclass', function () {
            frmClear();

            const table = $('#tbldevicemaster').DataTable();
            const rowData = table.row($(this).closest('tr')).data(); // reliable source of all data

            CompanyDropdown.extraParams = { RoleId: '@_RoleId', CompanyID: '@_companyid' };

            $.ajax({
                    type : "GET",
                    url: '@_webapiurl' + "Master/CompanyGetById?id=" + rowData.CompanyId,
                    headers: { 'Authorization': '@_tokan' },
                    dataType: "json",
                    async : false,
                    success: function (response) {
                        if (response != null && response != [] && response != '') {
                            var newOption = new Option(response[0].CompanyName, response[0].CompanyID, true, true);
                            $('#CompanyId').append(newOption).trigger('change');
                        }
                    }
            })

