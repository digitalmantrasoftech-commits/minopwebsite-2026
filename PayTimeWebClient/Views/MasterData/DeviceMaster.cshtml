@model PayTimeWebClient.Models.Devices
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Data;
@using System.Linq;
@{
    ViewBag.Title = "Device Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _cmpCode = HttpContext.Current.Session["cmpcode"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    bool _DevicePunchType = false;
    if (ViewBag.DevicePunchType == true)
    {
        _DevicePunchType = true;
    }
    string _companyid = string.Empty;
    int _empid = 0;
    if (_RoleId == 6805)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
    }
    string _branchid = string.Empty;
    if (_RoleId == 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
        _empid = Convert.ToInt32(HttpContext.Current.Session["EmpId"].ToString());
    }
    if (_RoleId > 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _companyid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();
    }
    Int64 _DatagridThsold = 0;

    _DatagridThsold = Convert.ToInt64(HttpContext.Current.Session["DataGridThresold"]);

    bool DevicePunchTypeStatus = ViewBag.DevicePunchType != null ? (bool)ViewBag.DevicePunchType : false;
    int _ChunkSize = Convert.ToInt32(HttpContext.Current.Session["DataDropDownThreShold"]);

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<script src="~/Pages_JS/VirtuallScroll/NormalDropDownVirtualClientServer.js"></script>
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/Pages_JS/MasterData/DeviceMasterDataGridPagination.js?v=1.0"></script>
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">
<script>
    let canEdit = '@obj.CanEdit';
    let canDelete = '@obj.CanDelete';
    let DevicePunchTypeStatus = '@DevicePunchTypeStatus';
    let CompanyDropdown = null;
    let BranchDropdown = null;
</script>
<script type="text/javascript">

    $(document).ready(function () {

        fillDevice();
        document.oncontextmenu = function () { return false; };
        $(document).mousedown(function (e) {
            if (e.button == 2) {
                return false;
            }
            return true;
        });
        $(window).load(function () {
             CompanyDropdown = new Select2Dropdown({
                    dropdownId: "CompanyId", // ID of the dropdown
                    apiUrl: '@_webapiurl' + 'DataDropDownOptimize/GetCompanyDropDownPaginated', // API URL for fetching data
                    dataKey: "Id", // Key for value
                    labelKey: "Name", // Key for text
                    token: '@_tokan', // Optional auth token
                    chunkSize : Number('@_ChunkSize'),
            });
             BranchDropdown = new Select2Dropdown({
                    dropdownId: "BranchId", // ID of the dropdown
                    apiUrl: '@_webapiurl' + 'DataDropDownOptimize/GetBranchDropDownPaginated', // API URL for fetching data
                    dataKey: "Id", // Key for value
                    labelKey: "Name", // Key for text
                    token: '@_tokan', // Optional auth token
                    chunkSize : Number('@_ChunkSize')
             });

        })
        $("#DeviceSrNo").keypress(function (e) {
            var keyCode = e.which;
            var Responce = validateKeyPress(keyCode);
            if (Responce == true) {
            }
            else { e.preventDefault(); }
        });

        DepartmentGetAll();

        $('#DeviceName').keydown(function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $('input[type="text"]').on('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.keyCode == 86) {
                e.preventDefault();
                return false;
            }
        });
        $('#DeviceName').keypress(function (e) {
            var keynum;
            if (window.event) { // IE
                keynum = e.keyCode;
            } else if (e.which) { // Netscape/Firefox/Opera
                keynum = e.which;
            }
            if (keynum == 62 || keynum == 60)
                e.preventDefault();
        });
        // blur function blanck space  avoided
        $("#DeviceSrNo").blur(function () {
            var DevSrno = removeTags($("#DeviceSrNo").val());
            $("#DeviceSrNo").val(DevSrno);
        });
        $("#DeviceName").blur(function () {
            var Devname = removeTags($("#DeviceName").val());
            $("#DeviceName").val(Devname);
        });
        $(".alert").hide();
        $("#TempSrno").hide();

        var dip = '115.124.96.52';
        var dport = '1018';
        $("#ajax_loader").hide();
        if ("@_Message" != "") {
            var delay = 1000;
            toastr.remove();
            toastr.success("@_Message");
            $("#ajax_loader").hide();
            setTimeout(function () {
              //  window.location.href = "/MasterData/DeviceMaster";
            }, delay);
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
            $("#ajax_loader").hide();
        }
        var $select = $("#DeptIds").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true
        });
        //$selectdeptids = $("#DepartmentIds").multiselect({
        //    selectAllValue: 'multiselect-all',
        //    enableCaseInsensitiveFiltering: true,
        //    includeSelectAllOption: true,
        //    allSelectedText: 'All Select',
        //    enableFiltering: true,
        //    maxHeight: '300',
        //    buttonWidth: '100%',
        //    enableClickableOptGroups: true
        //});
        // Popup code
        var navListItems = $('div.setup-panel div a'),
                allWells = $('.setup-content'),
                allNextBtn = $('.nextBtn');
        allPrevBtb = $('.prevbtn');
        allWells.hide();
        navListItems.click(function (e) {
            e.preventDefault();
            var $target = $($(this).attr('href')),
                    $item = $(this);
            if (!$item.hasClass('disabled')) {
                navListItems.removeClass('btn-primary').addClass('btn-default');
                $item.addClass('btn-primary');
                allWells.hide();
                $target.show();
            }
        });

        $("#frstNext").click(function (event) {
            if ($("#txt2").val() == 0) {
                toastr.remove();
                toastr.error("Please select at least one department.");
                return false;
            }
            $(".popMsg").hide();
            getEmp();
            var nextStepWizard = $('#frmpopupupload div.setup-panel div a[href="#step-2"]').parent().children("a");
            nextStepWizard.removeAttr('disabled').trigger('click');
        });
        allPrevBtb.click(function () {
            var curStep = $(this).closest(".setup-content"),
                curStepBtn = curStep.attr("id"),
                nextStepWizard = $('div.setup-panel div a[href="#' + curStepBtn + '"]').parent().prev().children("a"),
                isValid = true;
            if (isValid)
                nextStepWizard.removeAttr('disabled').trigger('click');
        });
        $('div.setup-panel div a.btn-primary').trigger('click');

        $("#ddlCompany").change(function () {
            if ($("#ddlCompany").val() == "0") {
                $("#tblManualPunch tbody").remove();
                $("#divmanual").hide();
                $("#ddlBranch").empty();
                $("#ddlBranch").append("<option value='0' selected>Select Branch </option>");
            }
            if ($("#ddlCompany").val() != 0) {
                $('#btnAddManualPunch').attr("disabled", "disabled");
                $("#btnAddManualPunch").unbind("click");
                $('#btnClearData').attr("disabled", "disabled");
                $("#btnClearData").unbind("click");
                $("#ddlBranch").empty();
                $("#ajax_loaderCompany").show();
                $.post("/Transactions/FillBranch?id=" + $("#ddlCompany").val(), function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    $("#ajax_loaderCompany").hide();
                    if (response != null) {
                        $("#ddlBranch").append("<option value='0'> Select Branch </option>");
                        for (var i = 0; i < response.length; i++) {
                            $("#ddlBranch").append("<option value='" + response[i].BranchId + "'>" + response[i].BranchName + "</option>");
                        }
                    }
                });
            }
        });


        $("#CompanyId").change(function () {
            $("#BranchId").val(null).trigger("change");
            if ($("#CompanyId").val() == "0" || $("#CompanyId").val() == null ) {
                $("#tblManualPunch tbody").remove();
                $("#divmanual").hide();
                BranchDropdown.extraParams = { CompanyID: $("#CompanyId").val(), BranchID: '@_branchid', RoleId: '@_RoleId', EmpID: '@_empid' };
                $("#BranchId").select2('close');
                $("#BranchId").trigger('change');
            }
            else {
                $('#btnAddManualPunch').attr("disabled", "disabled");
                $("#btnAddManualPunch").unbind("click");
                $('#btnClearData').attr("disabled", "disabled");
                $("#btnClearData").unbind("click");
                BranchDropdown.extraParams = { CompanyID: $("#CompanyId").val(), BranchID: '@_branchid', RoleId: '@_RoleId', EmpID: '@_empid' }
                $("#BranchId").select2('close');
                $("#BranchId").trigger('change');
                $("#ajax_loaderCompany").show();
                $("#ajax_loaderCompany").hide();
            }

        });


        $("#ddlBranch").change(function () {
            if ($("#ddlBranch").val() == "0") {
            }
            if ($("#ddlBranch").val() != "0") {
                $("#tblEmp tbody").empty();
                $("#tblDept tbody").empty();
                $(".ClsChkAllDept").prop('checked', false);
                $(".ClsChkAllEmp").prop('checked', false);
                var nextStepWizard = $('div.setup-panel div a[href="#step-1"]').parent().children("a");
                nextStepWizard.removeAttr('disabled').trigger('click');
                $("#DeptIds").empty();
                $.ajax({
                    type: "POST",
                    url: "/Transactions/GetDeptbyBranch?BranchId=" + $("#ddlBranch").val(),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    async: "false",
                    success: function (response) {
                        if (response.isRedirect) {
                            window.location.href = response.redirectUrl;
                        }
                        if (response != null) {
                            for (var i = 0; i < response.length; i++) {
                                $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                            }
                            $select.multiselect('rebuild');
                            $(document.body).on('change', '#DeptIds', function () {
                                $(".popMsg").hide();
                                var deptid = $('#DeptIds option:selected');
                                var DeptArray = [];
                                $(deptid).each(function (index, deptid) {
                                    DeptArray.push([$(this).val()]);
                                });
                                if (DeptArray == "") {
                                    $("#txt2").val(0);
                                }
                                else {
                                    $("#txt2").val(DeptArray);
                                    $("#spValidation").hide();
                                }
                                var ArrDept = $("#txt2").val();
                                DeptIdlst = ArrDept;
                                getEmp();
                            });
                        }
                        $(".loading").hide();
                    },
                    beforeSend: function () {
                        $(".loading").show();
                    },
                    error: function () {
                        $(".loading").hide();
                    }
                });
                //                    var nextStepWizard1 = $('div.setup-panel div a[href="#cstep-1"]').parent().children("a");
                //                    nextStepWizard1.removeAttr('disabled').trigger('click');
            }
        });


        $("#AddDevice").on('click', function () {
            $("#DivSrNo").show();
            $("#DeviceYes").prop('checked', true);
            $("#srlbl").show();
            $("#DeviceSrNo").val("");
            $("#DeviceSrNo").show();
            $("#spipaddd").html(dip);
            $("#spdeviceport").html(dport);
            frmClear();
            $("#AddDevice").attr("data-toggle", "modal");
            $("#AddDevice").attr("data-target", "#frmpopup");
            fillCompany();
            BranchDropdown.extraParams = { CompanyID: $("#CompanyId").val(), BranchID: '@_branchid', RoleId: '@_RoleId', EmpID : '@_empid' }
            $("#CompanyId").trigger('change');
            $("#BranchId").trigger('change');
        });

        $("#DeviceInfo").on('click', function () {
            $("#DeviceInfo").attr("data-toggle", "modal");
            $("#DeviceInfo").attr("data-target", "#DeviceInfomodal");
        });

        $("#DeviceSrNo").change(function () {
            var DeviceSrNo = $("#DeviceSrNo").val();
            var DeviceCode = $("#DeviceCode").val();
            var url = "/MasterData/GetDeviceSrCode";
            $.get(url, { DeviceSrNo: DeviceSrNo, DeviceCode: "" }, function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                if (data != null) {
                    var obj = JSON.parse(data);
                    if (obj.Meg == "Serial No already exist.") {
                        toastr.remove();
                        toastr.error("Serial no already exist.");
                        $("#DeviceSrNo").val("");
                        $("#DeviceSrNo").focus();
                    }
                }
                else {
                    $("#spDeviceCode").hide();
                    $("#spDeviceSrNo").hide();
                }
            });
        });

        $("#DeviceCode").change(function () {
            var DeviceSrNo = $("#DeviceSrNo").val();
            var DeviceCode = $("#DeviceCode").val();
            var url = "/MasterData/GetDeviceSrCode";
            $.get(url, { DeviceSrNo: "", DeviceCode: DeviceCode }, function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                if (data != null) {
                    var obj = JSON.parse(data);
                    if (obj.Meg == "Device Code already exist.") {
                        toastr.remove();
                        toastr.error("Device code already exist.");
                        $("#DeviceCode").val("");
                        $("#DeviceCode").focus();
                    }
                }
                else {
                    $("#spDeviceCode").hide();
                    $("#spDeviceSrNo").hide();
                }


            });
        });

        $('input[name=IsDeviceSrNo]').click(function () {
            if ($("#DeviceYes").is(':checked')) {
                $("#srlbl").show();
                $("#DeviceSrNo").val("");
                $("#DeviceSrNo").show();
            }
            else {
                $("#srlbl").hide();
                $("#DeviceSrNo").hide();
            }
            if ($("#DeviceNo").is(':checked')) {

                if ($("#TempSrno").val() != "") {
                    var srval = $("#TempSrno").val();
                    $("#DeviceSrNo").val(srval);
                }
                $("#srlbl").hide();
                $("#DeviceSrNo").hide();
            }
            else {
                $("#srlbl").show();
                $("#DeviceSrNo").show();
            }
        });
        $("#btnsubmit").click(function (event) {

            if ($("#CompanyId").val() == "0" || $("#CompanyId").val() == null) {
                $("#CompanyId").next('.select2-container').find('.select2-selection').addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }

            if ($("#BranchId").val() == "0" || $("#BranchId").val() == null ) {
                $("#BranchId").next('.select2-container').find('.select2-selection').addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }

            if ('@_DevicePunchType' == true) {
                departmentid = $("#DepartmentId option:selected").val();
                if (departmentid == "" || departmentid == 0) {
                    $("#DepartmentId").next('.select2-container').find('.select2-selection').focus();
                    $("#DepartmentId").next('.select2-container').find('.select2-selection').addClass('field_error');
                    toastr.remove();
                    toastr.error("Please select Department");
                    return false;
                }
                else {

                    $("#DepartmentId").val(departmentid);
                    $("#DepartmentId").next('.select2-container').find('.select2-selection').removeClass('field_error');
                }
            }

            if ($("#DeviceSrNo").val() == "") {
                $("#DeviceSrNo").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#DeviceSrNo").removeClass('field_error');
            }
            if ($("#DeviceName").val() == "") {
                $("#DeviceName").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#DeviceName").removeClass('field_error');
            }
            if ($("#DeviceIP").val() == "") {
                $("#DeviceIP").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#DeviceIP").removeClass('field_error');
            }
            if ($("#DevicePort").val() == "") {
                $("#DevicePort").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#DevicePort").removeClass('field_error');
            }
            if ($("#Mode").val() == null) {
                $("#Mode").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#Mode").removeClass('field_error');
            }
            if ($("#DeviceCode").val() == "") {
                $("#DeviceCode").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#DeviceCode").removeClass('field_error');
            }
            if ($("#DeviceTypeCode").val() == "" || $("#DeviceTypeCode").val() == null) {
                $("#DeviceTypeCode").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#DeviceTypeCode").removeClass('field_error');
            }
            var ipaddress = $("#DeviceIP").val();
            if (/^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/.test(ipaddress)) {
                $("#spvalidation").hide();
                $("#DeviceIP").removeClass('field_error');
            }
            else {
                $("#DeviceIP").addClass('field_error');
                toastr.remove();
                toastr.error("You have entered an invalid IP address!");
                $("#DeviceIP").focus();
                return false;
            }
            $("#ajax_loader").show();
        });
        $("#DeviceIP").change(function () {
            var ipaddress = $("#DeviceIP").val();
            if (/^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/.test(ipaddress)) {
                $("#spvalidation").hide();
                $("#DeviceIP").removeClass('field_error');
