                                                                    <input type="text" id="BranchSettingId" name="BranchSettingId" readonly />
                                                                </div>
                                                            </div>
                                                            <div class="form-group" hidden>
                                                                <label for="coid" class="col-md-4 control-label">Company ID</label>
