                                                                    <input type="text" id="comid" name="comid" readonly />
                                                                </div>
                                                            </div>
                                                            <div class="form-group" hidden>
                                                                <label for="coid" class="col-md-4 control-label">Branch ID</label>
                                                                <div class="col-md-4">
                                                                    <input type="text" id="BranchID1" name="BranchID1" readonly />
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="col-md-4 control-label">Time Zone <span class="required" aria-required="true"> * </span></label>   <a class="tooltips tooltip_left" data-placement="right" title="" data-original-title="timezone configuration indicate application timezone"><i class="fa-regular fa-question"></i></a>
                                                                <div class="col-md-7">
                                                                    @if (ViewBag.TimeZones != null)
                                                                    {
                                                                        @Html.DropDownList("TimeZone", ViewBag.TimeZones as List<SelectListItem>, "Select TimeZone", new { @class = "form-control input-sm" })
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DropDownList("TimeZone", new List<SelectListItem>(), new { @class = "form-control" })
                                                                    }

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="col-md-4 control-label">Language <span class="required" aria-required="true"> * </span></label>  <a class="tooltips tooltip_left" data-placement="right" title="" data-original-title="language configuration indicate application language"><i class="fa-regular fa-question"></i></a>
                                                                <div class="col-md-7">
                                                                    <select id="Language" name="Language" class="form-control input-sm" required="">
                                                                        <option value="" selected disabled>Select Language</option>
                                                                        <option value="English">English</option>
                                                                        <option value="Hindi">Hindi</option>
                                                                        <option value="Gujarati">Gujarati</option>
                                                                        <option value="Germany">Germany</option>
                                                                    </select>

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="col-md-4 control-label">Currency Format <span class="required" aria-required="true"> * </span></label>  <a class="tooltips tooltip_left" data-placement="right" title="" data-original-title="currency format indicate application and your financial report genrated on selected currency format"><i class="fa-regular fa-question"></i></a>
                                                                <div class="col-md-7">
                                                                    <select id="Currency" name="Currency" class="form-control input-sm" required="">
                                                                        <option value="" selected disabled>Select Currency Format</option>
                                                                        <option value="USD">US Dollar</option>
                                                                        <option value="GBP">British Pound</option>
                                                                        <option value="INR">Indian Rupee</option>
                                                                    </select>

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="col-md-4 control-label">Date Format <span class="required" aria-required="true"> * </span></label>  <a class="tooltips tooltip_left" data-placement="right" title="" data-original-title="date format indicate application display date in same format"><i class="fa-regular fa-question"></i></a>
                                                                <div class="col-md-7">
                                                                    <select id="DatetimeFormat" name="DatetimeFormat" class="form-control input-sm" required="">
                                                                        <option value="" selected disabled>Select Date Format</option>
                                                                        <option value="dd/mm/yyyy">DD/MM/YYYY</option>
                                                                        <option value="mm/dd/yyyy">MM/DD/YYYY</option>
                                                                    </select>

                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="col-md-4 control-label">Transaction Year <span class="required" aria-required="true"> * </span></label>  <a class="tooltips tooltip_left" data-placement="right" title="" data-original-title="transaction year indicate your financial reports genrated on selected transaction year"><i class="fa-regular fa-question"></i></a>
                                                                <div class="col-md-7">

                                                                    <select id="TrancationYearId" name="TrancationYearId" class="form-control input-sm" required="">
                                                                        <option value="0" selected disabled>Select Transaction Year</option>
                                                                        @if (ViewBag.gettransasctionYear != null)
                                                                        {
                                                                            foreach (var i in ViewBag.gettransasctionYear)
                                                                            {
                                                                                <option value="@i.TransactionYearId">@i.TransactionYearName</option>
                                                                            }
                                                                        }

                                                                    </select>

                                                                </div>
                                                            </div>
                                                            <div class="form-group ">
                                                                <div class="col-md-12 text-right">
                                                                    <button type="button" id="btnBranchSetting" class=" btn btn-sm blue"> <i class="fa-light fa-floppy-disk"></i> Save</button>
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @*<div class="modal-footer">
                                          <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                    </div>*@
                            </div>
                        </div>
                    </div>

