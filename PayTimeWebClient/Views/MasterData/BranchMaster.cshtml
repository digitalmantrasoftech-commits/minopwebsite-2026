                                                }

                                            </div>
                                            <div class="row">
                                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                    <div class="form-group">
                                                        <label class="control-label">Branch Address <span class="required" aria-required="true"> * </span></label>
                                                        <textarea id="BranchAddress" class="form-control" placeholder="Enter Branch Address" name="BranchAddress" rows="2"></textarea>
                                                        <span class="help-block" hidden id="spschadd" style="color: red;"></span>
                                                        <input type="hidden" id="Letlng" name="Letlng" />
