        padding: 0px 0 0px 0;
    }
</style>
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="@(isClientDBMatchFlag == "True" ? "/Admin/AdminDashboard" : "/Dashboard/AdminDashboard")"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Shift</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Shift</span>
            </li>
        </ul>
    }
    <div class="page-toolbar">
        @if (obj.CanAdd)
        {
            <div class="text-right">
                <a href="javascript:void(0)" id="AddShift" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Add Shift"><i class="fa-solid fa-plus"></i></a>
                &nbsp; &nbsp; <b>OR</b>&nbsp; &nbsp;
                <a href="/Paytime/TemplateShift" id="btntemplates" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Use Templates"><i class="fa-light fa-file"></i></a>
            </div>
        }
    </div>
</div>
