    $(document).ready(function () {
        $("#filtersaction").show();
        $('#FromDate').datepicker({
            format: "@_isdateformat",
            autoclose: true
        });
        $('#ToDate').datepicker({
            format: "@_isdateformat",
            autoclose: true

        });
        frmclear();
        $("#Clear_OPration").click(function () {
            frmclear();
            $("#NotificationGrid-empty").hide();
            $("#tableResponsive").hide();
            $("#NotificationGrid-empty1").show();
        });
        $("#hideDiv").css("display", "block");
        if ($('#Select_Operation').val() == 0) {
            $("#tableResponsive").hide();
            $("#NotificationGrid-empty").show();
        }
        $("#Search_OPration").click(function (event) {
            $("#FromDate").removeClass('field_error');
            $("#ToDate").removeClass('field_error');
            if ($("#FromDate").val() == "") {
                $("#FromDate").addClass('field_error');
                $("#FromDate").focus();
                event.preventDefault();
                return false;
            }
            else {
                $("#FromDate").removeClass('field_error');
            }
            if ($("#ToDate").val() == "") {
                $("#ToDate").focus();
                $("#ToDate").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#ToDate").removeClass('field_error');
            }
            if ("@_isdateformat" == "dd-mm-yyyy")
            {
                var fromDate = $("#FromDate").val().split("-");
                var datefrom = new Date(fromDate[2], fromDate[1] - 1, fromDate[0]);
            }
            else {
                var datefrom = new Date($('#FromDate').val());
            }
            if ("@_isdateformat" == "dd-mm-yyyy")
            {
                var toDate = $("#ToDate").val().split("-");
                var todate = new Date(toDate[2], toDate[1] - 1, toDate[0]);
            }
            else {
                var todate = new Date($('#ToDate').val());
            }
            if (datefrom > todate) {
                toastr.remove();
                toastr.error("To date should be greater than from date.");
                return false;
            }
            $("#dataTables_tbl_header").remove();
            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").show();
            }
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");
            if ($('#Select_Operation').val() == 1) {
                employee(1, 1);
            }
            if ($('#Select_Operation').val() == 2) {
                device(1, 2);
            }
            if ($('#Select_Operation').val() == 3) {
                shift(1, 3);
            }
            if ($('#Select_Operation').val() == 4) {
                Policy(1, 4);
            }
            if ($('#Select_Operation').val() == 5) {
                Attendance(1, 5);
            }
            if ($('#Select_Operation').val() == 6) {
                Branch(1, 6);
            }
            
        });
        $('#Select_Operation').on('change', function () {
            $("#tableResponsive").show();
            if ($.fn.DataTable.isDataTable('#tblshift')) {
                $('#tblshift').DataTable().clear().destroy();
                $("#dataTables_tbl_header").remove();

            }

            if ($.fn.DataTable.isDataTable('#tblAuditpolicy')) {
                $('#tblAuditpolicy').DataTable().clear().destroy();
                $("#dataTables_tbl_header").remove();

            }

            if ($.fn.DataTable.isDataTable('#tblbranch')) {
                $('#tblbranch').DataTable().clear().destroy();
                $("#dataTables_tbl_header").remove();
            }
            $("#divemployee").css("display", "none");
            $("#divdevice").css("display", "none");
            $("#divshift").css("display", "none");
            $("#divpolicy").css("display", "none");
            $("#divattendance").css("display", "none");
            $("#divbranch").css("display", "none");
            if (this.value == "0") {
                $("#Select_Fromdt").hide();
                $("#Select_Todt").hide();
                $("#Search_OPration").hide();
                $("#FromDate").val('');
                $("#ToDate").val('');
                $("#Search_OPtion").hide();
                $("#NotificationGrid-empty").show();
                $("#tableResponsive").hide();
                $("#Clear_OPration").hide();
            }
            else if (this.value == 1 || this.value == "2" || this.value == "3" || this.value == "4" || this.value == "5" || this.value == "6") {
                $("#Select_Fromdt").show();
                $("#Select_Todt").show();
                $("#Search_OPration").show();
                $("#Clear_OPration").show();
                $("#FromDate").val('');
                $("#ToDate").val('');
                $("#Search_OPtion").show();
                $("#FromDate").removeClass('field_error');
                $("#ToDate").removeClass('field_error');
            }

            $("#FromDate").datepicker('setEndDate', new Date());
            $("#ToDate").datepicker('setEndDate', new Date());
            if (this.value == "1") {
                employee(0, 1);
                $("#divemployee").css("display", "block");
            }
            else {
                $("#divemployee").css("display", "none");
            }
            if (this.value == "2") {
                device(0, 2);
                $("#divdevice").css("display", "block");
            }
            else {
                $("#divdevice").css("display", "none");
            }
            if (this.value == "3") {
                shift(0, 3);
                $("#divshift").css("display", "block");
                $("#NotificationGrid-empty1").hide();
            }
            else {
                $("#divshift").css("display", "none");
            }
            if (this.value == "4") {
                Policy(0, 4);
                $("#divpolicy").css("display", "block");
                $("#NotificationGrid-empty1").hide();
            }
            else {
                $("#divpolicy").css("display", "none");
            }
            if (this.value == "5") {
                Attendance(0, 5);
                $("#divattendance").css("display", "block");
            }
            else {
                $("#divattendance").css("display", "none");
            }
            if (this.value == "6") {
                Branch(0, 6);
                $("#divbranch").css("display", "block");
                $("#NotificationGrid-empty1").hide();
            }
            else {
                $("#divbranch").css("display", "none");
            }

        });
        //$("#filter_open_div").show();
        //$("#Filter_search").click(function () {
        //    $("#filter_open_div").toggle();
        //});

        $("#Filter_search").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.toggleClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $('.filter_portlet_tbl').toggle();
                $('.filter_portlet_wrapper .filter_boxModal').css('width', '100%');
            }
        });

        // Close filter panel on close button click
        $(".filterclose_btn").click(function () {
            const wrapper = $(".filter_portlet_wrapper");
            wrapper.addClass("full-width");

            var screenWidth = $(window).width();
            if (screenWidth >= 300 && screenWidth <= 600) {
                $(".filter_portlet_tbl").css("display", "block");
            }
        });

        $("#Select_Operation").change(function () {
            const selectedValue = $(this).val()

            if (selectedValue == 3 || selectedValue == 4 || selectedValue == 6) {
                $("#tableResponsive").show();
                $("#hideDiv").show();
                $("#NotificationGrid-empty").hide();
            }
        });

    });

