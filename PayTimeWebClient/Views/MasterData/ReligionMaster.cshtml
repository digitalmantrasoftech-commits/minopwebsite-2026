@model PayTimeWebClient.Models.Religion
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Religion Master";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    int _cmpid = 0;
    int _branchid = 0;
    string _empid = "0";
    if (_RoleId != 1 && _RoleId != 6805 && _RoleId != 6806)
    {
        _empid = HttpContext.Current.Session["EmpId"].ToString();
    }
    if (_RoleId == 6805)
    {
        _cmpid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"]);
    }
    if (_RoleId == 6806)
    {
        _cmpid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"]);
        _branchid = Convert.ToInt32(HttpContext.Current.Session["BranchId"]);
    }
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _webapiurl = System.Configuration.ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
    Int64 _DatagridThsold = 0;

    _DatagridThsold = Convert.ToInt64(HttpContext.Current.Session["DataGridThresold"]);
}
<link href="~/Newlayout/css/payrollstructure.css" rel="stylesheet">
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/Pages_JS/MasterData/ReligionDataGridPagination.js"></script>
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<script type="text/javascript">
    var count = 0;
    var form = "Religion Master";
    var operation = "";
    var roleid = '@_RoleId';
    var loginempid = '@_empid';
    var DataGridThreSold = '@_DatagridThsold';
    var cmpid = '@_cmpid';
    var branchid = '@_branchid';
    var table = "";
    var canDelete = '@obj.CanDelete';
    var canEdit = '@obj.CanEdit';
    var token = '@_tokan';
    var webapiurl = '@_webapiurl';
    $(document).ready(function () {
        /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
        timeMeInitialize();
        $('input[type="text"]').on('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.keyCode == 86) {
                e.preventDefault();
                return false;
            }

        });
        document.oncontextmenu = function () { return false; };
        $(document).mousedown(function (e) {
            if (e.button == 2) {
                return false;
            }
            return true;
        });
        $("#ReligionName").keypress(function (e) {
            var keyCode = e.which;
            var Responce = validateKeyPress(keyCode);
            if (Responce == true) {
            }
            else {
                e.preventDefault();
            }
        });

        $("#ReligionName").keypress(function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $("#ReligionName").blur(function () {
            var ReligionName = removeTags($("#ReligionName").val());
            $("#ReligionName").val(ReligionName);
        });
        $(".alert").hide();
        $("#ajax_loader").hide();
        if ("@_Message" != "") {
            toastr.remove();
            toastr.success("@_Message");
            $("#ajax_loader").hide();
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
            $("#ajax_loader").hide();
        }
        //$('#tblReligion').DataTable(
        //    {
        //        dom: 'lBfrtip',
        //        buttons: [
        //            {
        //                extend: 'excelHtml5',
        //                text: 'Excel',
        //                titleAttr: 'Excel',
        //                exportOptions: {
        //                    columns: [2]
        //                }
        //            }
        //        ]
        //    });

        var ObjData =
        {
            RoleId: roleid,
            CompanyID: cmpid,
            BranchID: branchid,
            LoginEmpId: loginempid,
            //DepartmentID: DepartmentID,
            //DesignationID: DesignationID,
            DataGridThreSold: DataGridThreSold
        };
        _urlNew = webapiurl + 'DataGridOptimize/GetReligionGridData';
        loadReligionData(1, ObjData);

        $("#AddReligion").on('click', function () {
            count++;
            operation = "Add Form";
            frmClear();
            $("#AddReligion").attr("data-toggle", "modal");
            $("#AddReligion").attr("data-target", "#frmpopup");
        });

        $("#btnRegSubmit").click(function (event) {
            if ($("#ReligionName").val().trim() == "") {
                $("#ReligionName").addClass('field_error');
                event.preventDefault();//or return false
                return false;
            }
            else {
                $("#ReligionName").removeClass('field_error');
            }
            $("#ajax_loader").show();
        });
        $("#ReligionName").keypress(function (e) {
            $("#ReligionName").removeClass('field_error');
        });
        $("#tblReligion").on('click', '.editclass', function () {
            count++;
            operation = "Edit Form";
            $("#ReligionName").removeClass('field_error');
            $("#spReligionName").hide();
            $("#ReligionId").val(table.row($(this).parent('td').parent('tr')).data()["ReligionId"]);
            $("#ReligionName").val(table.row($(this).parent('td').parent('tr')).data()["ReligionName"]);
            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");
        });
        $("#tblReligion").on('click', '.deleteclass', function () {
            var flg = 0;
            if (confirm("Are you sure for Delete this Entry?")) {
                $("#ReligionId").val(table.row($(this).parent('td').parent('tr')).data()["ReligionId"]);
                $.post("/MasterData/DeleteReligion?id=" + $("#ReligionId").val(), function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var _response = $.parseJSON(response);
                    if (_response == "OK") {
                        var strid = "Col_" + $("#ReligionId").val().trim();
                        $("#" + strid + "").closest('tr').remove();
                        $('#tblReligion').DataTable();
                    }
                    else {
                        alert("something wrong occures.");
                    }
                });
            }

        });
        function frmClear() {
            $("#ReligionId").val(0);
            $("#ReligionName").val("");
            $("#ReligionName").removeClass('field_error');
            $("#ReligionName").attr("placeholder", "Enter Religion Name");
            $("#ReligionName").attr('required', true);
            $("#spReligionName").hide();
        }
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Religion Master";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })
    });

</script>

<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                @if (isClientDBMatchFlag == "True")
                {
                    <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                }
                else
                {
                    <a href="/Dashboard/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                }
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Religion</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Religion</span>
            </li>
        </ul>
    }
    <div class="page-toolbar">

        @if (obj.CanAdd)
        {
            <div class="">
                <a href="javascript:void(0)" id="AddReligion" class="btn icon_transparent_btn tooltips" data-placement="left" data-original-title="Add Religion"><i class="fa-solid fa-plus"></i></a>
            </div>
        }
    </div>
</div>
<!-- END PAGE BAR -->
