@model PayTimeWebClient.Models.LeaveTypeMaster
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "Leave Type Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _dbName = HttpContext.Current.Session["DbName"].ToString();
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _cmpid = 0;
    int _branchid = 0;
    if (_RoleId == 6805)
    {
        _cmpid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"]);
    }
    if (_RoleId == 6806)
    {
        _cmpid = Convert.ToInt32(HttpContext.Current.Session["ClientCompanyId"]);
        _branchid = Convert.ToInt32(HttpContext.Current.Session["BranchId"]);
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
      ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
      : "false"; // Default to "false" if the session is null
}
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script src="~/Scripts/timeme.js"></script>
<div class="page-bar">
    @if (_RoleId == 1 || _RoleId == 6805 || _RoleId == 6806)
    {
        <ul class="page-breadcrumb">
            <li>
                @if (isClientDBMatchFlag == "True")
                {
                    <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                }
                else
                {
                    <a href="/Dashboard/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                }
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Leave Type</span>
            </li>
        </ul>
    }
    else
    {
        <ul class="page-breadcrumb">
            <li>
                <a href="/Dashboard/EmployeeDashboard"><i class="fa-regular fa-house"></i></a>
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Leave Type</span>
            </li>
        </ul>
    }
    <div class="page-toolbar">
        @if (obj.CanAdd)
        {
            <div class="text-right">
                <a href="javascript:void(0)" id="AddUser" class="btn icon_transparent_btn  tooltips" data-placement="left" data-original-title="Add Leave Type"><i class="fa-solid fa-plus"></i></a>
            </div>
        }
    </div>
</div>

<!-- END PAGE BAR -->
<!-- END PAGE HEADER-->
@if (obj.CanView)
{
    <script type="text/javascript">
        var count = 0;
        var form = "LeaveType Master";
        var operation = "";
        $(document).ready(function () {
            /*timeMeInitialize function is  a javascript library which displays a timer to display how long you are actively viewing the current webpage.*/
            timeMeInitialize();
            $('input[type="text"]').on('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.keyCode == 86) {
                    e.preventDefault();
                    return false;
                }

            });
            document.oncontextmenu = function () { return false; };
            $(document).mousedown(function (e) {
                if (e.button == 2) {
                    return false;
                }
                return true;
            });
            $("#LeaveTypeName").keypress(function (e) {
                var keyCode = e.which;
                var Responce = validateKeyPress(keyCode);
                if (Responce == true) {
                }
                else { e.preventDefault(); }
            });
            $("#Description").keypress(function (e) {
                var keyCode = e.which;
                var Responce = validateKeyPress(keyCode);
                if (Responce == true) {
                }
                else { e.preventDefault(); }
            });
            $("#LeaveTypeName").blur(function () {
                var leaveTypeName = removeTags($("#LeaveTypeName").val());
                $("#LeaveTypeName").val(leaveTypeName);
            });
            $("#Description").blur(function () {
                var description = removeTags($("#Description").val());
                $("#Description").val(description);
            });
            var CarrayForwrdLeave = document.getElementById('CarrayForwrdLeave');
            var EncashableLeave = document.getElementById('EncashableLeave');

            var MinleaveLimit = document.getElementById('MinleaveLimit');
            MinleaveLimit.onkeydown = function (e) {
                if (!((e.keyCode > 95 && e.keyCode < 106)
                    || (e.keyCode > 47 && e.keyCode < 58)
                    || e.keyCode == 8)) {
                    return false;
                }
            }
            CarrayForwrdLeave.onkeydown = function (e) {
                if (!((e.keyCode > 95 && e.keyCode < 106)
                    || (e.keyCode > 47 && e.keyCode < 58)
                    || e.keyCode == 8)) {
                    return false;
                }
            }
            EncashableLeave.onkeydown = function (e) {
                if (!((e.keyCode > 95 && e.keyCode < 106)
                    || (e.keyCode > 47 && e.keyCode < 58)
                    || e.keyCode == 8)) {
                    return false;
                }
            }
            var LimitDays = document.getElementById('LimitDays');
            LimitDays.onkeydown = function (e) {
                if (!((e.keyCode > 95 && e.keyCode < 106)
                    || (e.keyCode > 47 && e.keyCode < 58)
                    || e.keyCode == 8)) {
                    return false;
                }
            }

            frmClear();
            $("#IsCarrayForwrd").change(function () {
                if (this.checked) {
                    //spnisencashable
                    $("#spniscarryforward").show();
                    $("#spnisencashable").hide();
                    $(".errMsg").hide();
                    $("#CarrayForwrdLeave").prop('disabled', false);
                    $("#IsEncashable").prop('checked', false);
                    $("#EncashableLeave").prop('disabled', true);
                    $("#EncashableLeave").val("");
                    $("#EncashableLeave").removeClass('field_error');
                }
                else {
                    $("#spniscarryforward").hide();
                    $("#spnisencashable").show();
                    $("#CarrayForwrdLeave").prop('disabled', true);
                    $("#CarrayForwrdLeave").val("");
                    $("#IsEncashable").prop('checked', true);
                    $("#EncashableLeave").prop('disabled', false);
                }
            });
            $("#IsEncashable").change(function () {
                if (this.checked) {
                    $("#spnisencashable").show();
                    $("#spniscarryforward").hide();
                    $(".errMsg").hide();
                    $("#EncashableLeave").prop('disabled', false);
                    $("#IsCarrayForwrd").prop('checked', false);
                    $("#CarrayForwrdLeave").prop('disabled', true);
                    $("#CarrayForwrdLeave").val("");
                    $("#CarrayForwrdLeave").removeClass('field_error');

                }
                else {
                    $("#spnisencashable").hide();
                    $("#spniscarryforward").show();
                    $("#EncashableLeave").prop('disabled', true);
                    $("#EncashableLeave").val("");
                    $("#IsCarrayForwrd").prop('checked', true);
                    $("#CarrayForwrdLeave").prop('disabled', false);
                }
            });
            $("#IsDocRequire").change(function () {
                if (this.checked) {
                    $("#spDocRequired").show();
                    $(".errMsg").hide();
                    $("#LimitDays").prop('disabled', false);

                }
                else {
                    $("#spDocRequired").hide();
                    $("#LimitDays").prop('disabled', true);
                    $("#LimitDays").val("");
                }
            });

            $("#ajax_loader").hide();
            $(".alert").hide();
            if ("@_Message" != "") {
                toastr.remove();
                toastr.success("@_Message");
                $("#ajax_loader").hide();
            }
            if ('@_error' != "") {
                toastr.remove();
                toastr.error("@_error");
                $("#ajax_loader").hide();
            }

            let table = $('#tbluserDetails').DataTable({
                dom: _domCommon,
                language: _languageCommon,
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: 'Excel',
                        titleAttr: 'Download Excel',
                        className: 'buttons-excel',
                        exportOptions: {
                            columns: ':visible'
                        },
                    }
                ],
                "columnDefs": [
                    {
                        "orderable": false,
                        "targets": 12
                    },
                    ]
            });

            setTimeout(function () {
                $("#" + "tbluserDetails" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                $('.tooltips').tooltip();
            }, 100);


            $("#LimitDays").on("input", function () {
                var inputValue = $(this).val();

                // Remove any non-digit characters
                var cleanedValue = inputValue.replace(/\D/g, "");

                // Truncate the value to maximum length of 2
                cleanedValue = cleanedValue.slice(0, 2);
                $(this).val(cleanedValue);
            });
            $("#CarrayForwrdLeave").on("input", function () {
                // Get the current value of the input field
                var inputValue = $(this).val();
                // Remove any non-digit characters
                var cleanedValue = inputValue.replace(/\D/g, "");
                // Truncate the value to maximum length of 2
                cleanedValue = cleanedValue.slice(0, 2);
                $(this).val(cleanedValue);
            });

            $("#EncashableLeave").on("input", function () {
                // Get the current value of the input field
                var inputValue = $(this).val();
                // Remove any non-digit characters
                var cleanedValue = inputValue.replace(/\D/g, "");
                // Truncate the value to maximum length of 2
                cleanedValue = cleanedValue.slice(0, 2);
                $(this).val(cleanedValue);
            });

            $("#LimitDays").on("input", function () {
                var inputValue = $(this).val();
                // Remove any non-digit characters
                var cleanedValue = inputValue.replace(/\D/g, "");

                // Remove leading zeroes from the cleaned value
                cleanedValue = cleanedValue.replace(/^0+/, '');
                $(this).val(cleanedValue);
            });

            $("#AddUser").on('click', function () {
                count++;
                operation = "Add Form";
                frmClear();
                $("#AddUser").attr("data-toggle", "modal");
                $("#AddUser").attr("data-target", "#frmpopup");

            });

            $("#tbluserDetails").on('click', '.editclass', function () {
                count++;
                operation = "Edit Form";
                frmClear();
                if ($(this).parent('td').parent('tr').children(1)[3].innerText == 'False') {
                    $("#IsCarrayForwrd").prop('checked', false);
                    $("#CarrayForwrdLeave").val("");
                    $("#spniscarryforward").hide();
                    $("#spnisencashable").show();
                }
                else {
                    $("#spniscarryforward").show();
                    $("#spnisencashable").hide();
                    $("#IsCarrayForwrd").prop('checked', true);
                    $("#CarrayForwrdLeave").attr('disabled', false);
                    $("#CarrayForwrdLeave").val($(this).parent('td').parent('tr').children(1)[4].innerText);
                }
                if ($(this).parent('td').parent('tr').children(1)[5].innerText == 'False') {
                    $("#spnisencashable").hide();
                    $("#spniscarryforward").show();
                    $("#IsEncashable").prop('checked', false);
                    $("#EncashableLeave").val("");

                }
                else {
                    $("#spnisencashable").show();
                    $("#spniscarryforward").hide();
                    $("#IsEncashable").prop('checked', true);
                    $("#EncashableLeave").attr('disabled', false);
                    $("#EncashableLeave").val($(this).parent('td').parent('tr').children(1)[6].innerText);
                }
                if ($(this).parent('td').parent('tr').children(1)[8].innerText.trim() == 'False') {
                    $("#spDocRequired").hide();
                    $("#LimitDays").prop('disabled', true);
                    $("#LimitDays").val("");
                    $("#IsDocRequire").prop('checked', false)
                }
                else {
                    $("#IsDocRequire").prop('checked', true)
                    $("#spDocRequired").show();
                    $("#LimitDays").prop('disabled', false);
                    $("#LimitDays").val($(this).parent('td').parent('tr').children(1)[9].innerText.trim());
                }

                $("#LeaveTypeId").val($(this).parent('td').parent('tr').children(1)[0].innerText);
                $("#LeaveTypeName").val($(this).parent('td').parent('tr').children(1)[1].innerText);
                $('#Description').val($(this).parent('td').parent('tr').children(1)[2].innerText);
                var minleaveLimit = $(this).parent('td').parent('tr').children(1)[10].innerText.trim();

                if (minleaveLimit === '0') {
                    $("#MinleaveLimit").val('0');
                } else {
                    $("#MinleaveLimit").val(minleaveLimit);
                }

                if ($(this).parent('td').parent('tr').children(1)[7].innerText.trim() == 'True') {
                    $("#HalfLeave").prop('checked', true);
                }
                else {
                    $("#HalfLeave").prop('checked', false);
                }
                if ($(this).parent('td').parent('tr').children(1)[11].innerText.trim() == 'False') {
                    $("#IsLeaveApprove").prop('checked', false)
                }
                else {
                    $("#IsLeaveApprove").prop('checked', true)
                }
                $(".editclass").attr("data-toggle", "modal");
                $(".editclass").attr("data-target", "#frmpopup");

            });
            //$("#tbluserDetails").on('click', '.deleteclass', function () {
            //    var flg = 0;
            //    if (confirm("Are you sure?")) {
            //        $("#LeaveTypeId").val($(this).parent('td').parent('tr').children(1)[0].innerText);

            //        $.post("/MasterData/DeleteLeaveType?id=" + $("#LeaveTypeId").val(), function (response) {
            //            //alert($.parseJSON(response));
            //            var _response = $.parseJSON(response);
            //            if (_response == "OK") {
            //                var strid = "Col_" + $("#LeaveTypeId").val().trim();
            //                //alert(strid);
            //                $("#" + strid + "").closest('tr').remove();
            //                $('#tbluserDetails').DataTable();
            //            }
            //            else {
            //                alert("something wrong occures.");
            //            }
            //        });
            //    }
            //});

            $("#LeaveTypeName").keypress(function (e) {
                $("#LeaveTypeName").removeClass('field_error');
            });
            $("#Description").keypress(function (e) {
                $("#Description").removeClass('field_error');
            });
            $("#MinleaveLimit").keypress(function (e) {
                $("#MinleaveLimit").removeClass('field_error');
            });
            $("#CarrayForwrdLeave").keypress(function (e) {
                $("#CarrayForwrdLeave").removeClass('field_error');
            });
            $("#EncashableLeave").keypress(function (e) {
                $("#EncashableLeave").removeClass('field_error');
            });
            $("#LimitDays").keypress(function (e) {
                $("#LimitDays").removeClass('field_error');
            });
            //$(document).on('click', '#export-button', function () {
            //    debugger;
            //    var fileName = `LeaveType - ${getFileSafeDateTime()}`;
            //    var reportName = `LeaveType - ${getFormattedDateTime()}`;
            //    exportTableToExcelFileNormal(fileName, reportName)
            //});
            function frmClear() {
                $("#spnisencashable").hide();
                $("#spniscarryforward").hide();
                $("#spDocRequired").hide();

                $("#LeaveTypeId").val(0);
                $("#LeaveTypeName").val("");
                $("#LeaveTypeName").attr("placeholder", "Enter Leave Type Name");
                $("#LeaveTypeName").attr('required', true);
                $("#LeaveTypeName").removeClass('field_error');

                $("#Description").val("");
                $("#Description").attr("placeholder", "Enter Leave Description");
                $("#Description").attr('required', true);
                $("#Description").removeClass('field_error');

                $("#MinleaveLimit").val("0");
                $("#MinleaveLimit").attr("placeholder", "Enter Maximum Leave Limit");
                $("#MinleaveLimit").attr('required', true);
                $("#MinleaveLimit").removeClass('field_error');

                $("#IsCarrayForwrd").prop('checked', false);
                $("#IsEncashable").prop('checked', false);
                $("#HalfLeave").prop('checked', false);
                $("#IsDocRequire").prop('checked', false);
                $("#IsLeaveApprove").prop('checked', false);
                $("#CarrayForwrdLeave").val("");
                $("#CarrayForwrdLeave").removeClass('field_error');
                $("#EncashableLeave").val("");
                $("#EncashableLeave").removeClass('field_error');
                $("#EncashableLeave").prop('disabled', true);
                $("#CarrayForwrdLeave").prop('disabled', true);

                $("#LimitDays").val("");
                $("#LimitDays").removeClass('field_error');
                $("#LimitDays").prop('disabled', true);
                $(".errMsg").text("");

            }
            window.onload = function () {

                timeSpentOnPage();
            }
            $(window).on("beforeunload", function () {
                if (operation == "" || operation == null || operation == '') {
                    operation = "View LeaveType Master";
                }
                var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
                var timeSpent = timeSpentOnPage();
                analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
            })
        });

        function valid() {
            if ($("#LeaveTypeName").val().trim() == "") {
                $("#LeaveTypeName").addClass('field_error');
                return false;
            }
            if ($("#Description").val().trim() == "") {
                $("#Description").addClass('field_error');
                return false;
            }
            if ($("#MinleaveLimit").val().trim() == "") {
                $("#MinleaveLimit").addClass('field_error');
                return false;
            }
            if ($('#IsCarrayForwrd').is(':checked') != true && $('#IsEncashable').is(':checked') != true) {
                toastr.remove();
                toastr.error("Please enter carry forward or encashable leave.");
                return false;
            }

            if ($('#IsCarrayForwrd').is(':checked') == true) {
                if ($("#CarrayForwrdLeave").val().trim() == "") {
                    $("#CarrayForwrdLeave").addClass('field_error');
                    return false;
                }
            }
            if ($('#IsEncashable').is(':checked') == true) {
                if ($("#EncashableLeave").val().trim() == "") {
                    $("#EncashableLeave").addClass('field_error');
                    return false;
                }
            }
            if ($('#IsDocRequire').is(':checked') == true) {
                if ($("#LimitDays").val().trim() == "") {
                    $("#LimitDays").addClass('field_error');
                    return false;
                }
            }
            $("#ajax_loader").show();
            return true;
        }

    </script>


    <div class="portlet">
        <div class="portlet-body">
            <div class="row">
                <div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
                    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    @if (Model.LeaveTypelist.Count() > 0)
                    {
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tbluserDetails" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column">
                                <thead>
                                    <tr>
                                        <th hidden>@Html.DisplayNameFor(model => model.LeaveTypeId)</th>
                                        <th>Leavetype Name</th>
                                        <th>Description</th>
                                        <th>Is Carryforward</th>
                                        <th>Carryforward Leave</th>
                                        <th>Is Encashable</th>
                                        <th>Encashable Leave</th>
                                        <th hidden>HalfLeave</th>
                                        <th hidden>Document Required</th>
                                        <th hidden>Limit Days</th>
                                        <th hidden>MinleaveLimit</th>
                                        <th hidden>Auto Leave Approve </th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.LeaveTypelist != null)
                                    {
                                        foreach (var item in Model.LeaveTypelist)
                                        {
                                            <tr>
                                                <td hidden>
                                                    @Html.DisplayFor(modelItem => item.LeaveTypeId)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelitem => item.LeaveTypeName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelitem => item.Description)
                                                </td>
                                                <td>
                                                    @(item.IsCarrayForwrd == false ? "False" : "True")
                                                </td>
                                                <td>

                                                    @Html.DisplayFor(modelitem => item.CarrayForwrdLeave)

                                                </td>
                                                <td>
                                                    @(item.IsEncashable == false ? "False" : "True")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelitem => item.EncashableLeave)
                                                </td>
                                                <td hidden>
                                                    @(item.HalfLeave == false ? "False" : "True")
                                                </td>
                                                <td hidden>
                                                    @(item.IsDocRequire == false ? "False" : "True")
                                                </td>
                                                <td hidden>
                                                    @Html.DisplayFor(modelitem => item.LimitDays)
                                                </td>
                                                <td hidden>
                                                    @Html.DisplayFor(modelitem => item.MinleaveLimit)
                                                </td>
                                                <td hidden>
                                                    @(item.IsLeaveApprove == false ? "False" : "True")
                                                </td>
                                                <td id="Col_@item.LeaveTypeId">
                                                    @if (_RoleId == 1 && obj.CanEdit)
                                                    {
                                                        <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"> </i></a>
                                                    }
                                                    else if (_RoleId == 6805 && obj.CanEdit && (item.CompanyID != 0 && item.CompanyID == _cmpid))
                                                    {
                                                        <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"> </i></a>
                                                    }
                                                    else if (_RoleId == 6806 && obj.CanEdit && (item.CompanyID != 0 && item.BranchID == _branchid))
                                                    {
                                                        <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"> </i></a>
                                                    }
                                                    else if (_RoleId > 1 && obj.CanEdit && _RoleId != 6805 && _RoleId != 6806)
                                                    {
                                                        <a class="editclass btn seagreen_btnnew tooltips" data-placement="top" data-original-title="Edit"><i class="fa-regular fa-pen-to-square"> </i></a>
                                                    }
                                                    @if (obj.CanDelete)
                                                    {
                                                        <span>|</span><span> </span> <a style="font-weight:bold; text-decoration:none;pointer-events:painted;cursor:pointer" class="deleteclass btn btn-xs red tooltips" title="Delete">
                                                            <i class="fa-regular fa-trash-can"></i>
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr colspan="8" class="odd gradeX">No Data Available</tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div id="NotificationGrid-empty">
                            <div class="datanotfound">
                                <img src="~/assets/images/emptyscreen_1.png" height="148" width="280" alt="Nodata Found Icon">
                                <p class="datanotfound_title">No data found</p> <!-- titleText -->
                                <p class="">No entries found. Please add a record to get started.</p><!-- subText -->
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>


    <div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Leave Type</h4>
                </div>

                @using (Html.BeginForm("LeaveTypeMaster", "MasterData"))
                {
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <span class="errMsg help-block"></span>
                            </div>
                        </div>
                        <div class="modal-card">
                            <fieldset>
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <div class="editor-label control-label">
                                                @Html.HiddenFor(model => model.LeaveTypeId)
                                                Leave Type Name <span class="required" aria-required="true"> * </span>
                                            </div>
                                            <div class="editor-field">
                                                @Html.EditorFor(model => model.LeaveTypeName, new { htmlAttributes = new { @maxlength = "2", @class = "form-control input-sm" } })
                                                @Html.ValidationMessageFor(model => model.LeaveTypeName)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <div class="editor-label control-label">
                                                Description<span class="required" aria-required="true"> * </span>
                                            </div>
                                            <div class="editor-field">
                                                @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @maxlength = "100", @class = "form-control input-sm" } })
                                                @Html.ValidationMessageFor(model => model.Description)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group checkbox_with_input_box">
                                            <div class="editor-label control-label">
                                                Is carryforward <span class="required" aria-required="true" id="spniscarryforward" hidden> * </span><label class="check mt-checkbox mt-checkbox-outline pull-right">
                                                    @Html.CheckBoxFor(model => model.IsCarrayForwrd)
                                                    <span></span>
                                                </label>

                                                <div class="editor-field mt-2">
                                                    @Html.EditorFor(model => model.CarrayForwrdLeave, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                                    @Html.ValidationMessageFor(model => model.IsCarrayForwrd)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group checkbox_with_input_box">
                                            <div class="editor-label control-label">
                                                Is Encashable <span class="required" aria-required="true" id="spnisencashable" hidden> * </span> <label class="check mt-checkbox mt-checkbox-outline pull-right">
                                                    @Html.CheckBoxFor(model => model.IsEncashable)
                                                    <span></span>
                                                </label>
                                            </div>
                                            <div class="editor-field mt-2">
                                                @Html.EditorFor(model => model.EncashableLeave, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                                @Html.ValidationMessageFor(model => model.IsEncashable)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <div class="editor-label control-label">
                                                Half Leave
                                                <label class="check mt-checkbox mt-checkbox-outline  pull-right">
                                                    @Html.CheckBoxFor(model => model.HalfLeave)
                                                    <span></span>
                                                </label>
                                            </div>
                                            <br />
                                            <div class="editor-label control-label">
                                                Auto Approval Leave(Y/N)
                                                <label class="check mt-checkbox mt-checkbox-outline  pull-right">
                                                    @Html.CheckBoxFor(model => model.IsLeaveApprove)
                                                    <span></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group checkbox_with_input_box">
                                            <div class="editor-label control-label">
                                                Document Required <span class="required" aria-required="true" id="spDocRequired" hidden> * </span><label class="check mt-checkbox mt-checkbox-outline pull-right">
                                                    @Html.CheckBoxFor(model => model.IsDocRequire)
                                                    <span></span>
                                                </label>

                                                <div class="editor-field mt-2">
                                                    @Html.EditorFor(model => model.LimitDays, new { htmlAttributes = new { @class = "form-control input-sm", placeholder = "Days Required for Document" } })
                                                    @Html.ValidationMessageFor(model => model.LimitDays)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="form-group">
                                            <div class="editor-label control-label">
                                                Maximum Leave Apply<span class="required" aria-required="true"> * </span>
                                                <a class="tooltips" data-placement="top" title="You cannot apply for more leave than the maximum limit.">
                                                    <i class="fa-regular fa-circle-info"></i>
                                                </a>
                                            </div>
                                            <div class="editor-field">
                                                @Html.EditorFor(model => model.MinleaveLimit, new { htmlAttributes = new { @maxlength = "100", @class = "form-control input-sm" } })
                                                @Html.ValidationMessageFor(model => model.MinleaveLimit)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                                <button type="submit" class="btn save_btn" onclick="return valid();"> <i class="fa-light fa-floppy-disk"></i> Save</button>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

}
else
{
    <span style="color:red">Unauthorized Access.</span>
}

