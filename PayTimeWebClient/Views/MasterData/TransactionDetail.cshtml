            $.ajax(
             {
                 type: "GET",
                 url: "/MasterData/GetBranchbycomapnyid?CompanyID=" + companyid,
                 contentType: "application/json; charset=utf-8",
                 dataType: "json",
                 success: function (data) {
                     var markup = '';
                     for (var x = 0; x < data.length; x++) {
                         if (selectedBranch.length != 0) {
                             var re = new RegExp("(^|,)" + data[x].BranchId + "($|,)");
                             if (re.test(selectedBranch) == true) {
                                 markup += '<option selected="selected" value="' + data[x].BranchId + '" >' + data[x].BranchName + '</option>';
                             }
                             else {
                                 markup += "<option value=" + data[x].BranchId + ">" + data[x].BranchName + "</option>";
                             }
                         }
                         else {
                             markup += "<option value=" + data[x].BranchId + ">" + data[x].BranchName + "</option>";
                         }
                     }
                     $('#BranchIds').append(markup);
                     $Branchselect.multiselect('rebuild');
                     $(document.body).on('change', '#BranchIds', function () {
                         $("#spvalidation").hide();
                         var branid = $('#BranchIds option:selected');
                         var BranchArray = [];
                         $(branid).each(function (index, branid) {
                             BranchArray.push([$(this).val()]);
                         });
                         if (BranchArray == "") {
                             $("#txt2").val(0);
                         }
                         else {
                             $("#txt2").val(BranchArray);
                             $("#spValidation").hide();
                         }
                         var Arrbranch = $("#txt2").val();
                         BranchIdlst = Arrbranch;
                         $("#BranchId").val(BranchIdlst);
                         getEmp();
                     });
                 },
                 error: function (jqXHR, ajaxOptions, thrownError) {
                     if (jqXHR.status == 500) { //InternalServerError = 500,
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) { //BadRequest = 400,
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                 }
             });
        }

        function getEmp() {
            $('#EmpIds').empty();
            var cID = $("#CompanyID").val();
            var bID = $("#BranchIds").val();
            $.ajax({
                type: "GET",
                //url: "/MasterData/GetEmployeeByComBranch?BranchID=" + bID + "&CompanyId=" + cID,
                url: '@_webapiurl' + 'Master/GetEmployeeByComBranch?ComapnyId=' + cID + '&Branchid=' + bID,
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    $('#EmpIds').empty();
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            $('#EmpIds').append('<option value=" ' + response[i].EmpId + ' ">' + response[i].EmpName + '</option>');
                        }
                        $Employee.multiselect('rebuild');
                        $(document.body).on('change', '#EmpIds', function () {
                            $("#tbldepartment1").destroy;
                            $("#spvalidation").hide();
                            var Empid = $('#EmpIds option:selected');
                            var Emparray = [];
                            $(Empid).each(function (index, deptid) {
                                Emparray.push([$(this).val()]);
                            });
                            if (Emparray == "") {
                                $("#txt4").val(0);
                            }
                            else {
                                $("#txt4").val(Emparray);
                                $("#spValidation").hide();
                            }
                            var ArrEmp = $("#txt4").val();
                            EmpIdlst = ArrEmp;
                        });
                    }

                }
            });
        }

        function velidate() {
            if ($("#CompanyID").val() == "0" || $("#CompanyID").val() == null) {
                toastr.remove();
                toastr.error("Please select company.");
                $("#CompanyID").addClass('field_error');
                event.preventDefault();
                Isflag = 1;
                return false;
            } else {
                $("#CompanyID").removeClass('field_error');
                Isflag = 0
            }
            if ($("#BranchIds").val() == "0" || $("#BranchIds").val() == null) {
                toastr.remove();
                toastr.error("Please select branch.");
                $("#BranchIds").addClass('field_error');
                event.preventDefault();
                Isflag = 1;
                return false;
            } else {
                $("#BranchIds").removeClass('field_error');
                Isflag = 0
            }
            if ($("#EmpIds").val() == "0" || $("#EmpIds").val() == null) {
                toastr.remove();
                toastr.error("Please select employee.");
                $("#EmpIds").addClass('field_error');
                event.preventDefault();
                Isflag = 1;
                return false;
            } else {
                $("#EmpIds").removeClass('field_error');
                Isflag = 0
            }
            if ($("#MonthIds").val() == "" || $("#MonthIds").val() == null) {
                toastr.remove();
                toastr.error("Please select Month.");
                $("#Month").addClass('field_error');
                event.preventDefault();
                Isflag = 1;
                return false;
            } else {
                $("#Month").removeClass('field_error');
                Isflag = 0
            }
        }
        function getmonth() {
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + '/Master/GetMonth',
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            $('#MonthIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                        }
                    }

                }
            });
        }

        $("#Filter_search").click(function () {
            $("#filter_open_div").toggle();
        });
    });

</script>
