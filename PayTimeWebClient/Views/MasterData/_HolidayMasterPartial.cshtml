<script type="text/javascript">
    var isDateFormat = '@_isdateformat';
    var token = '@_tokan';
    var webapiurl = '@_webapiurl';
    var roleid = '@_RoleId';
    var loginempid = '@_empid';
    var DataGridThreSold = '@_DatagridThsold';
    var cmpid = '@_cmpid';
    var branchid = '@_branchid';
    var table = "";
    var canDelete = '@obj.CanDelete';
    var canEdit= '@obj.CanEdit';
    $(document).ready(function () {
        $('input[type="text"]').on('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.keyCode == 86) {
                e.preventDefault();
                return false;
            }
        });
        var $Companyselect = $("#CompanyID").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Company',
        });
        var $Branchselect = $("#BranchId").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Branch',
        });

        var $Religionselect = $("#ReligionId").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true,
            nonSelectedText: 'Select Religion',
        });
        function toggleReligionDropdown() {
            if ($("#ComplsuryH").is(":checked")) {
                $("#ReligionId").val("");
                $("#ReligionId option[value = '0']").prop('selected', true);
                $("#ReligionId").multiselect('refresh');
                $('#ReligionId').closest(".multiselect-native-select").find("button").prop("disabled", true); // Disable dropdown
            } else {
                $('#ReligionId').closest(".multiselect-native-select").find("button").prop("disabled", false); // Enable dropdown
            }
        }

        // Set initial state on page load
        toggleReligionDropdown();

        // Listen for changes on the radio buttons
        $("input[name='IsHolidayType']").on("change", function () {
            toggleReligionDropdown();
        });
        $('#CompanyID').change(function () {
            var s = $('#CompanyID').val();
            fillBranchbycompnyid(s, "");
        });
        $('#BranchId').change(function () {
            var s = $('#BranchId').val();
            $("#txt2").val(s);
        });
        document.oncontextmenu = function () { return false; };
        $(document).mousedown(function (e) {
            if (e.button == 2) {
