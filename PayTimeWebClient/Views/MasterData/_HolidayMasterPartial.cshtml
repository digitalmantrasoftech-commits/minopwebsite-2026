        };
        _urlNew = webapiurl + 'DataGridOptimize/GetHolidayGridData';
        loadHolidayData(1, ObjData);

        $('.tooltips').tooltip();
        $("#AddHoliday").on('click', function () {
            frmClear();
            let format = '@_isdateformat' == "yyyy-M-dd" ? "YYYY-MMM-DD" : '@_isdateformat' == "M-dd-yyyy" ? "MMM-DD-YYYY" : '@_isdateformat' == "dd-M-yyyy" ? "DD-MMM-YYYY" : '@_isdateformat';
            let curdate = new Date();
            curdate = moment(curdate).format(format.toUpperCase());
            //$("#HolidayDatedp").datepicker({ format: format, autoclose: true });
            $("#HolidayDatedp").datepicker('setDate', curdate);

            //$("#HolidayToDatedp").datepicker({ format: format, autoclose: true });
            $("#HolidayToDatedp").datepicker('setDate', curdate);
            $("#AddHoliday").attr("data-toggle", "modal");
            $("#AddHoliday").attr("data-target", "#frmpopup");
            var cp = $('#CompanyID').val();
            fillBranchbycompnyid(cp, "");
            toggleReligionDropdown();
        });
        $('#HolidayName').keydown(function (e) {
            if (this.value.length === 0 && e.which === 32) e.preventDefault();
        });
        $("#HolidayName").blur(function () {
            var holidayName = removeTags($("#HolidayName").val());
            $("#HolidayName").val(holidayName);
        });

        $("#btnSubmitHoliday").click(function (event) {
            if ($("#HolidayName").val().trim() == "") {
                $("#HolidayName").addClass('field_error');
                event.preventDefault();//or return false
                $(".loading").hide();
                return false;
            }
            else {
                $("#HolidayName").removeClass('field_error');
            }
            if ($("#HolidayDate").val() == "") {
                $("#HolidayDate").addClass('field_error');
                event.preventDefault();//or return false
                $(".loading").hide();
                return false;
            }
            else {
                $("#HolidayDate").removeClass('field_error');
            }
            if ($("#HolidayToDate").val() == "") {
                $("#HolidayToDate").addClass('field_error');
                event.preventDefault();//or return false
                $(".loading").hide();
                return false;
            }
            else {
                $("#HolidayToDate").removeClass('field_error');
            }
            var fromDate = $("#HolidayDate").val();
            var toDate = $("#HolidayToDate").val();
            var dateFormate = '@_isdateformat';
            if (dateFormate == "yyyy-M-dd") {
                dateFormate = "YYYY-MMM-DD";
            }
            else if (dateFormate == "dd-M-yyyy") {
                dateFormate = "DD-MMM-YYYY";
            }
            else if (dateFormate == "M-dd-yyyy") {
                dateFormate = "MMM-DD-YYYY";
            }
            var fromDateMoment = moment(fromDate, dateFormate.toUpperCase());
            var toDateMoment = moment(toDate, dateFormate.toUpperCase());
            if (fromDateMoment > toDateMoment) {
                toastr.remove();
                toastr.error("Holiday To Date must be bigger than or equal to Holiday From Date.");

                $("#HolidayToDate").addClass('field_error');
                event.preventDefault(); // Prevent form submission
                $(".loading").hide();
                return false;
            } else {
                $("#HolidayDate").removeClass('field_error');
                $("#HolidayToDate").removeClass('field_error');
            }

            var _CompanyId = $("#CompanyID option:selected").text();
            if (_CompanyId == "Select Company" || _CompanyId == "") {
                toastr.remove();
                toastr.error("Please select company.");
                $("#CompanyID").addClass('field_error');
                event.preventDefault();//or return false
                $(".loading").hide();
                return false;
            }
            else {
                $("#CompanyID").removeClass('field_error');
            }
            var _BranchId = $("#BranchId option:selected").text();
            if (_BranchId == "Select Branch" || _BranchId == "") {
                toastr.remove();
                toastr.error("Please select branch.");
                $("#BranchId").addClass('field_error');
                event.preventDefault();//or return false
                $(".loading").hide();
                return false;
            }
            else {
                $("#BranchId").removeClass('field_error');
            }
            var selectedComapny = [];
            var selectedBranch = [];
            var selectedReligionIds = [];
            $('#CompanyID :selected').each(function () {
                if (selectedComapny == "") {
                    selectedComapny = $(this).val();
                }
                else {
                    selectedComapny += "," + $(this).val();
                }
            })

            var selectedBranch = "";
            $('#BranchId :selected').each(function () {
                if (selectedBranch == "") {
                    selectedBranch = $(this).val();
                }
                else {
                    selectedBranch += "," + $(this).val();
                }
            });

            var selectedReligionIds = "";
            $('#ReligionId :selected').each(function () {
                if (selectedReligionIds == "") {
                    selectedReligionIds = $(this).val();
                }
                else {
                    selectedReligionIds += "," + $(this).val();
                }
            });

            $("#CompanyIDs").val(selectedComapny);
            $("#BranchIds").val(selectedBranch);
            $("#ReligionIds").val(selectedReligionIds);
            $(".loading").show();

        });

        $("#HolidayName").keypress(function (e) {
            $("#HolidayName").removeClass('field_error');

        });
        $("#HolidayDate").focus(function (e) {
            $("#HolidayDate").removeClass('field_error');
        });
        $("#HolidayToDate").focus(function (e) {
            $("#HolidayToDate").removeClass('field_error');
        });

        $("#tblHolidays").on('click', '.editclass', function () {
            debugger
            frmClear();
            $("#CountryId").val("0");
            $("#StateId").val("0");
            var stateid = "";
            var countryid = "";

            $("#HolidayId").val(table.row($(this).parent('td').parent('tr')).data()["HolidayId"]);
            $("#HolidayName").val(table.row($(this).parent('td').parent('tr')).data()["HolidayName"]);
            var Holidaydate = table.row($(this).closest('tr')).data()["HolidayDate"];
            var Holidaytodate = table.row($(this).closest('tr')).data()["HolidayToDate"];

            $("#HolidayDate").val(Holidaydate);
            $("#HolidayToDate").val(Holidaytodate);
            $("#HolidayDate").datepicker({ format: isDateFormat });
            $("#HolidayToDate").datepicker({ format: isDateFormat });
            if ("@_isdateformat" == "dd-mm-yyyy") {
                var holidayDateParts = Holidaydate.split("-");
                var holidayToDateParts = Holidaytodate.split("-");
                $("#HolidayDate").datepicker('setDate', new Date(holidayDateParts[2], holidayDateParts[1] - 1, holidayDateParts[0]));
                $("#HolidayToDate").datepicker('setDate', new Date(holidayToDateParts[2], holidayToDateParts[1] - 1, holidayToDateParts[0]));
            }
            else if ("@_isdateformat" == "mm-dd-yyyy") {
                var holidayDate = moment(Holidaydate, 'MM-DD-YYYY').toDate();
                var holidayToDate = moment(Holidaytodate, 'MM-DD-YYYY').toDate();
                $("#HolidayDate").datepicker('setDate', holidayDate);
                $("#HolidayToDate").datepicker('setDate', holidayToDate);
            }
            else if ("@_isdateformat" == "yyyy-M-dd") {
                var holidayDate = moment(Holidaydate, 'YYYY-MMM-DD').toDate();
                var holidayToDate = moment(Holidaytodate, 'YYYY-MMM-DD').toDate();
                $("#HolidayDate").datepicker('setDate', holidayDate);
                $("#HolidayToDate").datepicker('setDate', holidayToDate);
            }
            else if ("@_isdateformat" == "M-dd-yyyy") {                
                var holidayDate = moment(Holidaydate, 'MMM-DD-YYYY').toDate();
                var holidayToDate = moment(Holidaytodate, 'MMM-DD-YYYY').toDate();
                $("#HolidayDate").datepicker('setDate', holidayDate);
                $("#HolidayToDate").datepicker('setDate', holidayToDate);
            }
            else if ("@_isdateformat" == "dd-M-yyyy") {                
                //var holidayDate = moment(Holidaydate, 'DD-MMM-YYYY').toDate();
                //var holidayToDate = moment(Holidaytodate, 'DD-MMM-YYYY').toDate();
                var fromDate = moment(Holidaydate, 'DD-MMM-YYYY');
                var toDate = moment(Holidaytodate, 'DD-MMM-YYYY');

                if (fromDate.isValid()) {
                    $("#HolidayDate").datepicker('setDate', fromDate.toDate());
                } 

                if (toDate.isValid()) {
                    $("#HolidayToDate").datepicker('setDate', toDate.toDate());
                } 
            }
            else {
                $("#HolidayDate").datepicker('setDate', new Date(Holidaydate));
                $("#HolidayToDate").datepicker('setDate', new Date(Holidaytodate));
            }

            var brnm = table.row($(this).parent('td').parent('tr')).data()["BranchId"];
            var cmpnm = table.row($(this).parent('td').parent('tr')).data()["CompanyId"];
            var selectedCompany = cmpnm.split(",");
            for (var i in selectedCompany) {
                var optionVal = selectedCompany[i].trim(); // Ensure there are no leading/trailing spaces

                // Check if optionVal is valid (not empty or undefined)
                if (optionVal) {
                    // Proceed to select the option only if optionVal is valid
                    $("#CompanyID").find("option[value=" + optionVal + "]").prop("selected", "selected");
                }
            }
            $("#CompanyID").multiselect("rebuild");

            //fillBranchbycompnyid(cmpnm, brnm);
            //if (brnm == "" || brnm == null || brnm == 0) {
            //    $("#BranchId").val(null);
            //}
            //else {
            //    $("#BranchId option:contains(" + brnm + ")").attr('selected', 'selected');
            //}

            $.get("/MasterData/GetBranchbycomapnyid?companyid=" + cmpnm,
                function (response) {
                    $('#BranchId').empty();
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var brnid = "0";
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            $("#BranchId").append("<option value='" + response[i].BranchId + "'>" + response[i].BranchName + "</option>");
                            if (response[i].BranchName == brnm) {
                                brnid = response[i].BranchId;
                            }
                        }
                        var selectedBranch = brnm.split(",");
                        for (var i in selectedBranch) {
                            var optionVal = selectedBranch[i];
                            $("#BranchId").find("option[value=" + optionVal + "]").prop("selected", "selected");
                        }
                        $("#BranchId").multiselect("rebuild");
                    }
                });
            $("#TimeZoneId").val(table.row($(this).parent('td').parent('tr')).data()["TimeZoneId"]);
            var religion = table.row($(this).parent('td').parent('tr')).data()["ReligionId"];

            var selectedReligion = religion.split(",");
            for (var i in selectedReligion) {
                var optionVal = selectedReligion[i];
                $("#ReligionId").find("option[value=" + optionVal + "]").prop("selected", "selected");
            }
            $("#ReligionId").multiselect("rebuild");
            var isHtype = table.row($(this).parent('td').parent('tr')).data()["IsHolidayType"];

            if (isHtype == "False" || isHtype == "false" || isHtype == 0) {
                $("#OptionalH").prop('checked', true);
                $("#ComplsuryH").prop('checked', false);
                toggleReligionDropdown();
            }
            else {
                $("#ComplsuryH").prop('checked', true);
                $("#OptionalH").prop('checked', false);
                toggleReligionDropdown();
            }
            var HolidayApplicable = table.row($(this).parent('td').parent('tr')).data()["HolidayApplicable"];
            if (HolidayApplicable == 0) {
                $("#DefaultH").prop('checked', true);
                $("#NationalH").prop('checked', false);
                $("#InternationalH").prop('checked', false);
            }
            if (HolidayApplicable == 1) {
                $("#NationalH").prop('checked', true);
                $("#DefaultH").prop('checked', false);
                $("#InternationalH").prop('checked', false);
            }
            if (HolidayApplicable == 2) {
                $("#InternationalH").prop('checked', true);
                $("#DefaultH").prop('checked', false);
                $("#NationalH").prop('checked', false);
            }


            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");

        });

        $('#CountryId').change(function () {
            var s = $('#CountryId').val();
            fillStatedll(s, "");

        });
        function frmClear() {
            $("#HolidayId").val(0);
            $("#HolidayName").val("");
            $("#HolidayName").attr("placeholder", "Enter Holiday Name");
            $("#HolidayName").attr('required', true);
            $("#HolidayName").removeClass('field_error');

            $("#CompanyID").val("0");
            $("#CompanyID option[value = '0']").prop('selected', true);
            $("#CompanyID").multiselect('refresh');

            $("#BranchId").val("0");
            $("#BranchId option[value = '0']").prop('selected', true);
            $("#BranchId").multiselect('refresh');

            $("#HolidayDate").val("");
            $("#HolidayDate").attr('required', true);
            $("#HolidayDate").removeClass('field_error');
            $("#HolidayToDate").val("");
            $("#HolidayToDate").attr('required', true);
            $("#HolidayToDate").removeClass('field_error');
            $("#TimeZoneId").val("");
            $("#TimeZoneId option[value = '0']").prop('selected', true);

            $("#ReligionId").val("");
            $("#ReligionId option[value = '0']").prop('selected', true);
            $("#ReligionId").multiselect('refresh');

            $("#CountryId").val("");
            $("#CountryId option[value = '0']").prop('selected', true);

            $("#StateId").val("");
            $("#StateId option[value = '0']").prop('selected', true);

            $("#BranchId").val("");
            $("#BranchId option[value = '0']").prop('selected', true);


            $("#OptionalH").prop('checked', true);

            $("#DefaultH").prop('checked', true);

        }
        function fillStatedll(Countryid, selectedstate) {
            $('#StateId').empty();
            $.ajax(
             {
                 headers: { 'Authorization': '@_tokan' },
                 url: '@_webapiurl' + "/Master/StateMasterGetByCountryId",
                 data: { CountryId: Countryid },
                 contentType: "application/json; charset=utf-8",
                 dataType: "json",

                 success: function (data) {
                     if (data.isRedirect) {
                         window.location.href = data.redirectUrl;
                     }
                     var markup = '';

                     for (var x = 0; x < data.length; x++) {
                         markup += "<option value=" + data[x].StateId + ">" + data[x].StateName + "</option>";
                     }
                     var newOption = '<option selected="selected"  value="">All</option>';

                     $('#StateId').html(newOption);
                     $('#StateId').append(markup);
                     $('#StateId').val(selectedstate);
                 },
                 error: function (jqXHR, ajaxOptions, thrownError) {

                     if (jqXHR.status == 500) { //InternalServerError = 500,
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) { //BadRequest = 400,
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                 }
             });
        }
        function fillBranchbycompany(companyid, selectbranch) {
            $('#BranchId').empty();
            $.ajax(
             {
                 type: "GET",
                 url: "/MasterData/GetBranchbycomapnyholiday",
                 data: { comapanyid: companyid },
                 contentType: "application/json; charset=utf-8",
                 dataType: "json",

                 success: function (data) {
                     if (data.isRedirect) {
                         window.location.href = data.redirectUrl;
                     }
                     var markup = '';

                     for (var x = 0; x < data.length; x++) {
                         markup += "<option value=" + data[x].BranchId + ">" + data[x].BranchName + "</option>";
                     }

                     var newOption = '<option selected="selected"  value="">All</option>';
                     $('#BranchId').html(newOption);
                     $('#BranchId').append(markup);
                     $('#BranchId').val(selectbranch);
                 },
                 error: function (jqXHR, ajaxOptions, thrownError) {
                     if (jqXHR.status == 500) { //InternalServerError = 500,
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) { //BadRequest = 400,
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                 }
             })
        }
        function fillBranchbycompnyid(companyid, selectedBranch) {
            $('#BranchId').empty();

            $.ajax(
             {
                 type: "GET",
                 url: "/MasterData/GetBranchbycomapnyid?CompanyID=" + companyid,
                 contentType: "application/json; charset=utf-8",
                 dataType: "json",
                 success: function (data) {
                     var markup = '';
                     for (var x = 0; x < data.length; x++) {
                         if (selectedBranch.length != 0) {
                             var re = new RegExp("(^|,)" + data[x].BranchId + "($|,)");
                             if (re.test(selectedBranch) == true) {
                                 markup += '<option selected="selected" value="' + data[x].BranchId + '" >' + data[x].BranchName + '</option>';
                             }
                             else {
                                 markup += "<option value=" + data[x].BranchId + ">" + data[x].BranchName + "</option>";
                             }
                         }
                         else {
                             markup += "<option value=" + data[x].BranchId + ">" + data[x].BranchName + "</option>";
                         }
                     }
                     $('#BranchId').append(markup);
                     $Branchselect.multiselect('rebuild');
                 },
                 error: function (jqXHR, ajaxOptions, thrownError) {
                     if (jqXHR.status == 500) { //InternalServerError = 500,
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) { //BadRequest = 400,
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                 }
             });
        }
    });


</script>
