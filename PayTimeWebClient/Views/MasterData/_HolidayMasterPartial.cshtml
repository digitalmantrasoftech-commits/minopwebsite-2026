<div id="frmpopup" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Holiday</h4>
            </div>

            @using (Html.BeginForm("HolidayMaster", "MasterData"))
            {
                //@Html.ValidationSummary(false)
                <div class="modal-body">
                    <div class="modal-card">
                        <fieldset>
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label class="editor-label control-label">
                                            @Html.HiddenFor(model => model.HolidayId)
                                            Holiday Name <span class="required" aria-required="true"> * </span>
                                        </label>
                                        <div class="editor-field">
                                            @Html.EditorFor(model => model.HolidayName, new { htmlAttributes = new { @class = "form-control input-sm", @maxlength = 30 } })

                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <div class="form-group data_picker_box">
                                        <label>From Date<span class="required" aria-required="true"> * </span></label>
                                        <div class="editor-field">
                                            <div class="input-group input-group-sm date date-picker" id="HolidayDatedp" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                                                <span class="input-group-btn">
                                                    <button class="btn default" type="button">
                                                        <i class="fa-light fa-calendar-days"></i>
                                                    </button>
                                                </span>
                                                @if (_isdateformat == "dd-M-yyyy" || _isdateformat == "M-dd-yyyy" || _isdateformat == "yyyy-M-dd")
                                                {
                                                    <input type="text" placeholder="@_isdateformat.Replace("M","MMM")" class="form-control" id="HolidayDate" name="HolidayDate" readonly="readonly">
                                                }
                                                else
                                                {
                                                    <input type="text" placeholder="@_isdateformat" class="form-control" id="HolidayDate" name="HolidayDate" readonly="readonly">
                                                }
                                            </div>
                                            <span class="error_help_block" hidden id="spHolidayDate"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <div class="form-group data_picker_box">
                                        <label>To Date<span class="required" aria-required="true"> * </span></label>
                                        <div class="editor-field">
                                            <div class="input-group input-group-sm date date-picker" id="HolidayToDatedp" data-date="@DateTime.Now" data-date-format="@_isdateformat" data-date-viewmode="years">
                                                <span class="input-group-btn">
                                                    <button class="btn default" type="button">
                                                        <i class="fa-light fa-calendar-days"></i>
                                                    </button>
                                                </span>
                                                @if (_isdateformat == "dd-M-yyyy" || _isdateformat == "M-dd-yyyy" || _isdateformat == "yyyy-M-dd")
                                                {
                                                    <input type="text" placeholder="@_isdateformat.Replace("M","MMM")" class="form-control" id="HolidayToDate" name="HolidayToDate" readonly="readonly">
                                                }
                                                else
                                                {
                                                    <input type="text" placeholder="@_isdateformat" class="form-control" id="HolidayToDate" name="HolidayToDate" readonly="readonly">
                                                }
                                            </div>
                                            <span class="error_help_block" hidden id="spHolidayDate"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" hidden>
                                    @if (ViewBag.TimeZones != null)
                                    {
                                        <div class="form-group">
                                            <label>Select TimeZone</label>
                                            @Html.DropDownList("TimeZoneId", ViewBag.TimeZones as List<SelectListItem>, "All", new { @class = "form-control input-sm" })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-group">
                                            <label>Select TimeZone</label>
                                            @Html.DropDownList("TimeZoneId", new List<SelectListItem>(), "All", new { @class = "form-control input-sm" })
                                        </div>
                                    }
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="display:none;">
                                    <div class="form-group">
                                        <label>Select Country</label>
                                        @if (Model.Countrylist != null)
                                        {
                                            @Html.DropDownListFor(model => model.CountryId, new SelectList(Model.Countrylist, "CountryId", "CountryName"), "All", new { @class = "form-control input-sm" })
                                        }
                                        else
                                        {
                                            @Html.DropDownList("CountryId", new SelectList(new[] { "" }), "All", new { @class = "form-control input-sm" })
                                        }
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="display:none;">
                                    <div class="form-group">
                                        <label>Select State</label>
                                        @Html.DropDownList("StateId", new SelectList(new[] { "" }), "All", new { @class = "form-control input-sm" })
                                        <span class="error_help_block" hidden id="spStateid"></span>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label>Select Company<span class="required" aria-required="true"> * </span></label>
                                        @if (Model.CompanyList != null)
                                        {
                                            @Html.DropDownListFor(model => model.CompanyID, new SelectList(Model.CompanyList, "CompanyID", "CompanyName"), new { @class = "form-control input-sm", @multiple = "multiple" })
                                        }
                                        else
                                        {
                                            @Html.DropDownList("CompanyID", new SelectList(new[] { "" }), new { @class = "form-control input-sm", @multiple = "multiple" })
                                        }

                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label>Select Branch<span class="required" aria-required="true"> * </span></label>
                                        @*@if (Model.BranchList != null)
                                            {
                                                    @Html.DropDownListFor(model => model.BranchId, new SelectList(Model.BranchList, "BranchId", "BranchName"), new { @class = "form-control input-sm", @multiple = "multiple" })
                                            }
                                            else
                                            {
                                                    @Html.DropDownList("BranchId", new SelectList(new[] { "" }), new { @class = "form-control input-sm", @multiple = "multiple" })
                                                }*@
                                        <input type="text" id="txt2" value="0" hidden />
                                        <select id="BranchId" name="BranchId" class="mt-multiselect btn blue btn-outline" multiple="multiple" data-width="100%"></select>
                                    </div>
                                </div>
                                @if (_isReligion)
                                {
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" id="dvReligions">
                                        <div class="form-group" id="divReligion">
                                            <label>Select Religion</label>

                                            @if (Model.ReligionList != null)
                                            {
                                                @Html.DropDownListFor(model => model.ReligionId, new SelectList(Model.ReligionList, "ReligionId", "ReligionName"), new { @class = "form-control input-sm", @multiple = "multiple" })
                                            }
                                            else
                                            {
                                                @Html.DropDownList("ReligionId", new SelectList(new[] { "" }), new { @class = "form-control input-sm", @multiple = "multiple" })
                                            }
                                        </div>
                                    </div>
                                }
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label class="control-label">Is Holiday ?</label><br />
                                        <label class="mt-radio mt-radio-outline">
                                            Optional
                                            <input value="False" name="IsHolidayType" id="OptionalH" type="radio">
                                            <span></span>
                                        </label>
                                        <label class="mt-radio mt-radio-outline">
                                            Compulsory
                                            <input value="True" name="IsHolidayType" id="ComplsuryH" type="radio">
                                            <span></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" hidden>
                                    <div class="form-group">
                                        <label>Is Holiday ?</label>
                                        <label class="mt-radio mt-radio-outline">
                                            Is Default
                                            <input value="0" name="HolidayApplicable" id="DefaultH" type="radio">
                                            <span></span>
                                        </label>
                                        <label class="mt-radio mt-radio-outline">
                                            Is National
                                            <input value="1" name="HolidayApplicable" id="NationalH" type="radio">
                                            <span></span>
                                        </label>
                                        <label class="mt-radio mt-radio-outline">
                                            Is International
                                            <input value="2" name="HolidayApplicable" id="InternationalH" type="radio">
                                            <span></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-right">
                            <button type="submit" id="btnSubmitHoliday" class="btn save_btn"><i class="fa-light fa-floppy-disk"></i> Save</button>
                            @Html.HiddenFor(x => x.BranchIds)
                            @Html.HiddenFor(x => x.CompanyIDs)
                            @Html.HiddenFor(x => x.ReligionIds)
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

