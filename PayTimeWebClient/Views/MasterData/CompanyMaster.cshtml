        $('#fieldlst :input').each(function () {
            var _idfield = $(this).attr("id");
            var _rmidfield = _idfield.replace("chk_", "");
            $("#" + _idfield).prop('checked', false);
            var _ss = _chkarrylstsp.split(",")
            for (var i = 0; i <= _ss.length; i++) {
