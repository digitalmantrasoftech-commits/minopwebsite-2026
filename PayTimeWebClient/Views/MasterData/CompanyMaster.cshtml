        function CustomizeColumnView() {
            _chkarrylst = 0;
            $('#fieldlst :input').each(function () {
                var _idfield = $(this).attr("id");
                var column = t.column($(this).attr('data-column'));
                column.visible(false);
                $.each($("input[id='" + _idfield + "']:checked"), function () {
                    var _chkid = _idfield;
                    column.visible(true);
                    var _rmidfield = _idfield.replace("chk_", "");
                    _chkarrylst += "," + _rmidfield;
                });
            });
            $("#tblCompanyDetails thead tr:eq(1)").remove();

            var footer = '<tr class="footer">';
            $("#tblCompanyDetails thead th").each(function (index) {
                var headerText = $(this).text().trim();
                if (_isServerSide && ["Company Name", "Company EmailId", "Company URL", "Company Contact"].includes(headerText)) {
                    footer += `<th><input type="text" class="search_input" data-column="${headerText}" placeholder="Search" /><i class="clm-search" id=""></i></th>`;
                }
                else if (!_isServerSide && ["Company Name", "Company EmailId", "Company URL", "Company Contact"].includes(headerText)) {
                    footer += `<th><input type="text" class="search_input" data-column="${headerText}" placeholder="Search" /><i class="clm-search" id=""></i></th>`;
                }
                else {
                    footer += '<th></th>';
                }
            });
            footer += '</tr>';

            $("#tblCompanyDetails thead").append(footer);

            $('#frmpopupCustomfld').modal('toggle');
        }

