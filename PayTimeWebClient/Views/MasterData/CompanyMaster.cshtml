            if (num == "NaN") {
                $('#' + container + '').val('');
                return false;
            }
            var cleanNum = num.toFixed(2);
            $(this).val(cleanNum);
            if (num / cleanNum < 1) {
                toastr.remove();
                toastr.error("Please enter only 2 decimal places, we have truncated extra points.");
                $('#' + container + '').val('');
                return false;
            }

        });

