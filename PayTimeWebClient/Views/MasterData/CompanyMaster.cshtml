                toastr.remove();
                toastr.error("Company name must be greater than 3 character.");
                $("#CompanyName").val("");
                $("#CompanyName").focus();
                $("#CompanyName").addClass('field_error');
                return false;
            }
            else {
                $("#CompanyName").removeClass('field_error');
                //$("#spvalidation").hide();
            }
        });
        $("#CompanyContact").keypress(function (e) {
            $("#CompanyContact").removeClass('field_error');
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
            else {
                return true;
            }
        });
        $("#MobNoSMS").keypress(function (e) {

            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                return false;
            }
            else {
                return true;
            }
        });

        $("#CompanyUrl").change(function () {
            var cmnurl = "";
            cmnurl = ValidateURL($("#CompanyUrl").val());
            if (cmnurl != "success") {
                toastr.remove();
                toastr.error(cmnurl);
                $("#CompanyUrl").val("");
                $("#CompanyUrl").focus();
                $("#CompanyUrl").addClass('field_error');
                event.preventDefault();
                return false;
            }
            else {
                $("#CompanyUrl").removeClass('field_error');
                $("#spvalidation").hide();
                return true;
            }
        });

        $("#CompanyEmail").change(function () {
            var EmailMsg = "";
            EmailMsg = ValidateEmailid($("#CompanyEmail").val());
            if (EmailMsg != "success") {
                toastr.remove();
                toastr.error(EmailMsg);
                $("#CompanyEmail").val("");
                $("#CompanyEmail").focus();
                $("#CompanyEmail").addClass('field_error');
                return false;
            }
            var emailid = $("#CompanyEmail").val();
            var url = "/MasterData/GetCompaniesEmail";
            $.get(url, { emailid: emailid }, function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
                if (data != null) {
                    if (data == emailid) {
                        toastr.remove();
                        toastr.error("Email id must be unique.");
                        $("#CompanyEmail").val("");
                        $("#CompanyEmail").focus();
                        $("#CompanyEmail").addClass('field_error');
                        return false;
                    }
                    else {
                        $("#CompanyEmail").removeClass('field_error');
                        return true;
                    }
                }
                else {
                    $("#spvalidation").hide();
                }

            });
        });
        $("#MobNoSMS").change(function () {
            if ($("#MobNoSMS").val().length > 10) {
                return false;
            }
            var smsmsg = "";
            smsmsg = ValidateMobNumber($("#MobNoSMS").val());
            if (smsmsg != "success") {
                toastr.remove();
                toastr.error(smsmsg);
                $("#MobNoSMS").focus();
                $("#MobNoSMS").val("");
                $("#MobNoSMS").addClass('field_error');
                return false;
            }
            else {
                $("#MobNoSMS").removeClass('field_error');
                $("#spvalidation").hide();
                return true;
            }
        });
