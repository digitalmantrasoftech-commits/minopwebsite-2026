@using System.Configuration;
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "IdentityVerfication";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    string _companyCode = HttpContext.Current.Session["cmpcode"].ToString();
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _PlanId = HttpContext.Current.Session["planId"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<style>
    /* Default styles for the image */
    .zoom-image {
        border-radius: 50%;
        width: 34px;
        height: 34px;
        transition: transform 0.5s; /* Smooth zoom transition */
    }

        /* Style for the image when hovered */
        .zoom-image:hover {
            transform: scale(2.5); /* Increase the size to zoom in */
        }
</style>

<script type="text/javascript">
    $(document).ready(function () {
        var _url = '@_webapiurl' + 'Master/IsEmployeeVerifyData'
        var t = $('#tblIdentityVerification').DataTable(
        {
             dom: _domCommon,
             language: _languageCommon,
            "bPaginate": true,
            "ajax": {
                url: _url,
                type: "GET",
                headers: { 'Authorization': '@_tokan' },
                dataSrc: '',
                beforeSend: function () {
                    $('#ajax_loaderDevice').show();
                },
                complete: function () {
                    $('#ajax_loaderDevice').hide();
                }
            },
            "columns": [
                { "data": "" },
                { title: "Employee Name", "data": "EmpName" },
                { title: "Empcode", "data": "Empcode" },
                { title: "EmpPunchID", "data": "EmpPunchID"},
                { title: "Email", "data": "Email"},
                { title: "EmpPhoto", "data": "EmpPhoto" },
                { title: "EmpId", "data": "EmpId", visible: false},
            ],
            "columnDefs": [
                //{
                //    "targets": [1],
                //    "visible": false
                //},
                 {
                     "searchable": false,
                     "orderable": false,
                     "targets": 0,
                     "render": function (data, type, full, meta) {
                         data = "<td id=''><input type='checkbox'  class='ClsChkEmp' id='" + full.EmpId + "'/>";
                         return data;
                     }
                 },
                {
                    "targets": 5,
                    "data": null,
                    "render": function (data, type, row) {
                        // Extract initials
                        var photo = 'https://www.minopcloud.com/UploadEmpPhoto/' + data;
                        var nameParts = row.EmpName.replace(/\s+/g, ' ').trim().split(" ");
                        var initials = nameParts[0].charAt(0).toUpperCase();
                        if (nameParts.length > 1) {
                            initials += nameParts[1].charAt(0).toUpperCase();
                        }
                        //const colors = ["#e74c3c", "#8e44ad", "#3498db", "#16a085", "#f39c12", "#d35400", "#2c3e50"];
                        //const randomColor = colors[Math.floor(Math.random() * colors.length)];
                        const randomColor = "#295097";

                        return `<div style="display: flex; align-items: center;">
                                    <img alt="" class="zoom-image tooltips" data-placement="right" data-original-title="Empcode : ${row.Empcode}" src="${photo}" style="border-radius: 50%!important;width:34px;height:34px; border: 1px solid #8ab1f7; margin-right: 8px;"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"/>
                                    <span  class="zoom-image tooltips"  data-placement="right" data-original-title="Empcode : ${row.Empcode}" style="display: none; border-radius: 50%!important; min-width: 34px; height: 34px; line-height: 30px; text-align: center; background-color: #ecf3ff; color:  ${randomColor}; border-radius: 50% !important; border: 1px solid #8ab1f7; margin-right: 8px;">
                                    ${initials}</span> ${row.EmpName} </div>`;
                    }
                }
            ],
                "order": [[2, 'asc']],

                "initComplete": function (settings, json) {
                    // Example: Hide loader, show table, or run any post-load logic
                    if (json != null) {
                        const iv = json;
                        handleGridVisibility("tblempty", "NotificationGrid-empty", iv, {
                            imageUrl: "emptyscreen_1.png",
                            subText: "No entries found. Please add a record to get started."
                        });
                    }
                }

        }
        ).draw();
        setTimeout(function () {
            $("#" + "tblIdentityVerification" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        $("#selectall").on("change", function (e) {
            if ($(this).is(":checked")) {
                $("#tblIdentityVerification .ClsChkEmp").each(function () {
                    $(this).prop('checked', true);
                });
            } else {
                $("#tblIdentityVerification .ClsChkEmp").each(function () {
                    $(this).prop('checked', false);
                });
            }
        });
        $("#btnactive").click(function () {
            checkSession();
            lst = []
            $("#tblIdentityVerification .ClsChkEmp").each(function (key, value) {
                if ($(this).is(':checked') == true) {
                    var empID = t.row($(this).parent('td').parent('tr')).data()["EmpId"];
                    var EmpPhoto = t.row($(this).parent('td').parent('tr')).data()["EmpPhoto"];
                    var Email = t.row($(this).parent('td').parent('tr')).data()["Email"];
                    var EmpName = t.row($(this).parent('td').parent('tr')).data()["EmpName"];
                    var obj = {
                        EmpId: empID,
                        EmpPhoto: EmpPhoto,
                        IsApprove: 1,
                        Email: Email,
                        EmpName: EmpName
                    };
                    lst.push(obj);
                }
            });
                if (lst.length == 0) {
                    event.preventDefault();
                    toastr.remove();
                    toastr.error("Please select employee.");
                    return false;
                }
                var Url = '/ESS/ISPhotoVerifyData'
                $.ajax({
                    url: Url,
                    type: 'POST',
                    headers: { 'Authorization': '@_tokan' },
                    data: JSON.stringify(lst),
                    contentType: "application/json; charset=utf-8",
                    beforeSend: function () {
                        $("#ajax_loaderDevice").show();
                    },
                    success: function (data) {
                        if (data = "OK") {
                            $("#selectall").prop('checked', false);
                            toastr.remove();
                            toastr.success("Identity verification approved successfully.");
                            $('#tblIdentityVerification').DataTable().ajax.reload();
                            $("#ajax_loaderDevice").hide();
                        }
                        else {
                            toastr.remove();
                            toastr.error("Error in Photo verification.");
                            $("#ajax_loaderDevice").hide();
                        }
                    },
                    statusCode: {
                        404: function (content) { alert('cannot find resource'); },
                        500: function (content) { alert('internal server error'); }
                    },
                    error: function (req, status, errorObj) {
                        $("#ajax_loaderDevice").hide();
                    }
                });

            });

        $("#btnDeactive").click(function () {
            checkSession();
            lst = []
            $("#tblIdentityVerification .ClsChkEmp").each(function (key, value) {
                if ($(this).is(':checked') == true) {
                    var empID = t.row($(this).parent('td').parent('tr')).data()["EmpId"];
                    var EmpPhoto = t.row($(this).parent('td').parent('tr')).data()["EmpPhoto"];
                    var Email = t.row($(this).parent('td').parent('tr')).data()["Email"];
                    var EmpName = t.row($(this).parent('td').parent('tr')).data()["EmpName"];
                    var obj = {
                        EmpId: empID,
                        EmpPhoto: EmpPhoto,
                        IsApprove: 2,
                        Email: Email,
                        EmpName: EmpName
                    };
                    lst.push(obj);
                }
            });

                if (lst.length == 0) {
                    event.preventDefault();
                    toastr.remove();
                    toastr.error("Please select Employee.");
                    return false;
                }
                var Url = '/ESS/ISPhotoVerifyData'
                $.ajax({
                    url: Url,
                    type: 'POST',
                    headers: { 'Authorization': '@_tokan' },
                    data: JSON.stringify(lst),
                    contentType: "application/json; charset=utf-8",
                    beforeSend: function () {
                        $("#ajax_loaderDevice").show();
                    },
                    success: function (data) {
                        if (data = "OK") {
                            $("#selectall").prop('checked', false);
                            toastr.remove();
                            toastr.success("Identity verification rejected successfully.");
                            $('#tblIdentityVerification').DataTable().ajax.reload();
                            $("#ajax_loaderDevice").hide();
                        }
                        else {
                            toastr.remove();
                            toastr.error("Error in photo verification.");
                            $("#ajax_loaderDevice").hide();
                        }
                    },
                    statusCode: {
                        404: function (content) { alert('cannot find resource'); },
                        500: function (content) { alert('internal server error'); }
                    },
                    error: function (req, status, errorObj) {
                        $("#ajax_loaderDevice").hide();
                    }
                });

            });
        });
    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }

</script>
<div class="page-bar">
    @if (_RoleId == 1)
    {
        <ul class="page-breadcrumb">
            <li>
                @if (isClientDBMatchFlag == "True")
                {
                    <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                }
                else
                {
                    <a href="/Dashboard/AdminDashboard"><i class="fa-regular fa-house"></i></a>
                }
            </li>
            <li>
                <span><i class="fa-light fa-angle-right"></i> Identity Verification</span>
            </li>
        </ul>
    }
    <div class="page-toolbar text-right">
        <button type="button" id="btnactive" class="icon_transparent_btn tooltips" data-placement="left" data-original-title="Approve" data-toggle="tooltip"><i class="fa-solid fa-check"></i></button>
        <button type="button" id="btnDeactive" class="icon_transparent_btn tooltips margin-left-5" data-placement="left" data-original-title="Reject" data-toggle="tooltip"><i class="fa-solid fa-xmark"></i></button>
    </div>
</div>

@if (_RoleId == 1 && (_PlanId == "3" || _PlanId == "6"))
{
    <div id="ajax_loaderDevice" class="modal_bg loading" aria-hidden="true">
        <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" alt="loading" title="loading" />
    </div>
    <div class="portlet">
        <div class="portlet-body">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div id="tblempty">
                        <div class="table-responsive" id="tableResponsive">
                            <table id="tblIdentityVerification" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column ">
                                <thead>
                                    <tr>
                                        <th style="align-content:center"><input type="checkbox" id="selectall"></th>
                                        <th>Employee Name</th>
                                        <th>Employee Code</th>
                                        <th>Employee PunchId</th>
                                        <th>Employee Email</th>
                                        <th>Employee Photo</th>
                                        <th hidden>Employee ID</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                    <div id="NotificationGrid-empty" style="display: none">
                        <div class="datanotfound">
                            <img src="" height="148" width="280" alt="Nodata Found Icon">
                            <p class="datanotfound_title"></p> <!-- titleText -->
                            <p class=""></p><!-- subText -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <span style="color:red">@PayTimeWebClient.Resource.Resource.UnauthorizedAccess.</span>
}