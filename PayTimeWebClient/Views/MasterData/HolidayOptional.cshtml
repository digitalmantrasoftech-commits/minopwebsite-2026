                                <th hidden>IsHolidayType</th>
                                <th hidden>HolidayApplicable</th>
                                <th hidden>CountryID</th>
                                <th hidden>StateID</th>
                                <th hidden>Company Id</th>

                                <th>Entry Date <i class='fa-regular fa-circle-info' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                @if (_RoleId == 1)
                                {
                                    <th>Edit</th>
                                }
                                <th hidden>Updated Date <i class='fa-regular fa-circle-info' title='Date format is : @_isdateformat.ToUpper()' style='color: #295097;'></i></th>
                                <th hidden>Action</th>
                            </tr>*@

                    </thead>

                </table>
            </div>
        </div>
    </div>
</div>

