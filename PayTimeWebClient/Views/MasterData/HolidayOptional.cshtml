@model PayTimeWebClient.Models.Holidays
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{

    ViewBag.Title = "Holiday Optional";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // bool _isReligion = ViewBag.isReligion;
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _OptHolidayLimit = Convert.ToInt32(HttpContext.Current.Session["OptHolidayLimit"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string _lockAttendanceDay = HttpContext.Current.Session["lockAttendanceDay"].ToString();
    string _PlanId = HttpContext.Current.Session["planId"].ToString();
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    //int _cmpid = 0;
    //int _branchid = 0;
    string _cmpid = "0";
    string _branchid = "0";
    string _empid = "0";
    string _empName = "0";

    if (_RoleId != 1 )
    {
        _empid = HttpContext.Current.Session["EmpId"].ToString();
        _empName = HttpContext.Current.Session["EmpName"].ToString();
        _cmpid = HttpContext.Current.Session["ClientCompanyId"].ToString();
        _branchid = HttpContext.Current.Session["BranchId"].ToString();

    }

    string _isdateformat = HttpContext.Current.Session["IsDateFormat"].ToString();
    string _dbName = HttpContext.Current.Session["DbName"].ToString();

    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
    ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
    : "false"; // Default to "false" if the session is null
}

<style>
    .viewclass {
        width: 24px;
        height: 21px;
        line-height: 21px !important;
        margin-left: 0 !important;
    }
</style>
<script src="~/Scripts/timeme.js"></script>
<script src="~/AssetsNew/js/CommonValidation.js"></script>
<script type="text/javascript">
    var isDateFormat = '@_isdateformat';
    var count = 0;
    var _NewEmpID = "@_empid";
    var _NewEmpName = "@_empName";
    var operation = "";
    var delay = 2000;
    var HolidayLimit = "@_OptHolidayLimit";
    var _RoleIDnew = '@_RoleId';
    var isactive = 1;
    var Dt_table = "";
    $(document).ready(function () {
       
        tbloptional_Holiday();
        filloptholiday();
        $("#tblholidayoptional thead").on("keyup", "input", function () {
            t.column($(this).parent().index())
            .search(this.value)
            .draw();
        });

        $("#tblholidayoptional tfoot th").each(function () {
            var title = $(this).text();
            $(this).html('<input type="text" class="search_input" placeholder="Search" /><i class="clm-search" id=""></i>');
        });

        function frmClear() {
            $("#OptHoliday").val("");
            $("#HolidayDate").val("");
            $("#HolidayToDate").val("");
            $("#Empname").val("");
        }
        function filloptholiday() {
            $('#OptHoliday').empty();
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + "Master/GetHolidayOptionalall",
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (data) {

                    if (data != null && data.length > 0) {
                        var _optholi;
                        for (var i = 0; i < data.length; i++) {
                            _optholi += '<option value="' + data[i].HolidayId + '">' + data[i].HolidayName + '</option>';
                        }
                        $("#OptHoliday").append(_optholi);
                    } else {
                        $("#OptHoliday").html('<option value="0">Select OptHoliday</option>');
                    }
                },
                error: function (error) {
                   
                    console.error("Error fetching optional holidays: " + error.statusText);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        }

        $("#OptHoliday").on('change', function () {

            var HolidayId = $('#OptHoliday').val();

            $.ajax({
                type: "GET",
                url: '@_webapiurl' + 'Master/GetHolidayOptionaldate?HolidayId=' + HolidayId,
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    $("#ajax_loader").show();
                },
                success: function (data) {
                    if (data && data.length > 0) {
                        // Assuming the response contains a single object with the HolidayDate field
                        $("#HolidayDate").val(data[0].HolidayDate);
                    }
                },
                error: function (error) {
                    //alert("Error fetching cities: " + error.statusText);
                },
                complete: function () {
                    $("#ajax_loader").hide();
                }
            });
        });


        $("#tblholidayoptionalseleted").on('click', '.clm_edit_btn', function () {

            frmClear();
            var _empid = $(this).parent('td').parent('tr').children(1)[1].innerText;
            $("#empid").val(_empid);
            $("#Empname").val($(this).parent('td').parent('tr').children(1)[4].innerText);
            $("#HolidayDate").val($(this).parent('td').parent('tr').children(1)[6].innerText);
            $("#OptHolidayId").val($(this).parent('td').parent('tr').children(1)[2].innerText);
            var _opt = $(this).parent('td').parent('tr').children(1)[3].innerText.trim();
            $("#OptHoliday option[value = '" + _opt + "' ]").prop("selected", true);

            $('#OptHoliday').trigger('change.select2');

            $("#Empname").prop("disabled", true);
            $("#HolidayDate").prop("disabled", true);
            $("#tblholidayoptionalseleted").attr("data-toggle", "modal");
            $("#tblholidayoptionalseleted").attr("data-target", "#frmpopup");
        });
        //Update
        $("#btnSubmit").click(function () {

            if (($("#OptHoliday").val() == null || $("#OptHoliday").val() == "0")) {
                $("#OptHoliday").addClass('field_error');
                toastr.remove();
                toastr.error("Please Optinal Holiday.");
                event.preventDefault();
                return false;
            }

    
            var createdDate = new Date().toString("YYYY-MM-dd HH:mm:ss");
            var empid = $("#empid").val();
            var isactive = 1;
            var holidayid = $("#OptHoliday").val();
            var OptHolidayId = $("#OptHolidayId").val();

            var obj = {
                EmpId: empid,
                HolidayId: holidayid,
                CreatedDate: createdDate,
                IsActive : isactive,
                OptHolidayId: OptHolidayId
            };

            $.ajax({
                url: '@_webapiurl' + 'Master/OptionalHolidayUpdate',
                type: 'POST',
                headers: { 'Authorization': '@_tokan' },
                data: JSON.stringify(obj),
                contentType: "application/json; charset=utf-8",
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (data) {

                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    if (data.MegSts == "ok") {
                        toastr.remove();
                        toastr.success(data.Meg);
                        $(".loading").hide();
                        setTimeout(function () {
                            window.location.reload(true);
                        }, delay);

                    }
                    else {
                        toastr.error("already exist");
                    }
                }
            });

        });


        $("#btnactive").click(function () {

            checkSession();
            var HolidayOptionalRequest = [];

            var obj = null;
            var objHoliday = null;
            var checkboxChecked = false;

            $("#tblholidayoptional .checkbox").each(function (key, value) {
                if ($(this).is(':checked')) {
                    checkboxChecked = true;
                    var row = $(this).closest('tr');

                    var obj = {
                        holidayname: row.find('.HolidayName').text().trim(),
                        holidayDate: row.find('.HolidayDate').text().trim(),
                        holidayToDate: row.find('.HolidayToDate').text().trim(),
                        CreatedDate: row.find('.CreatedDate').text().trim(),
                        HolidayId: row.find('.HolidayId').text().trim(),
                        EmpId: _NewEmpID,
                        IsActive: isactive
                    };

                    HolidayOptionalRequest.push(obj);
                }
            });

            if (!checkboxChecked) {
                toastr.error("Please select Holiday.");
                return false;
            }

            var checkedCount = $('#tblholidayoptional .checkbox:checked').length;
            if (checkedCount != HolidayLimit) {
                toastr.error("Please select " + HolidayLimit + " holiday limit ");
                return false;
            }

            var requestData = {
                HolidayOptionalRequest: HolidayOptionalRequest
            };
            $.ajax({
                url: '@_webapiurl' + 'Master/HolidayMasterOptionalCreate',
                type: 'POST',
                headers: { 'Authorization': '@_tokan' },
                data: JSON.stringify(requestData),
                contentType: "application/json; charset=utf-8",
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (data) {

                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                    if (data.MegSts == "ok") {
                        toastr.remove();
                        toastr.success(data.Meg);
                        $(".loading").hide();
                        setTimeout(function () {
                            window.location.reload(true);
                        }, delay);

                        if ($.fn.dataTable.isDataTable('#tblholidayoptionalseleted')) {
                            $('#tblholidayoptionalseleted').DataTable().destroy();
                        }

                        objHoliday = {
                            Roleid: _RoleIDnew,
                            EmpId: _NewEmpID
                        };


                        $('#tblholidayoptionalseleted').DataTable({

                            ajax: {
                                url: '@_webapiurl' + 'Master/GetHolidayOptionalSelected',
                                method: 'GET',
                                headers: { 'Authorization': '@_tokan' },
                                dataSrc: function (json) {
                                    return json.data;
                                },
                                data: objHoliday,
                                dataType: 'json',
                                contentType: 'application/json',
                                beforeSend: function () {
                                    $('#ajax_loaderbranch').show();
                                },
                                error: function (xhr, error, thrown) {
                                    console.log("AJAX error: ", error);
                                    console.log("Response: ", xhr.responseText);
                                },
                                complete: function () {
                                    $('#ajax_loaderbranch').hide();
                                }
                            },
                            columns: [
                                { data: 'HolidayId', visible: false },
                                { data: 'EmpId', visible: false },
                                { data: 'EmpName' },
                                { data: 'HolidayName' },
                                { data: 'HolidayDate' },
                                { data: 'HolidayToDate' },
                                { data: 'CreatedDate' },
                                { data: 'CountryId', visible: false },
                                { data: 'BranchId', visible: false },
                                { data: 'IsHolidayType', visible: false },
                                { data: 'IsActive', visible: false }

                            ]
                        });

                    } else {
                        toastr.remove();
                        toastr.error("Error.");
                        $(".loading").hide();
                    }
                },
                statusCode: {
                    404: function (content) { alert('cannot find resource'); },
                    500: function (content) { alert('internal server error'); }
                },
                error: function (jqXHR, ajaxOptions, thrownError) {
                    $(".loading").hide();
                    if (jqXHR.status == 500) {
                        toastr.error("InternalServerError");
                    } else if (jqXHR.status == 400) {
                        toastr.error("BadRequest");
                    } else if (jqXHR.status == 401) {
                        window.location.href = "/PayTime/LoginPage";
                    }
                }
            });
        });


        function tbloptional_Holiday() {

            $('#tblholidayoptional').DataTable().destroy();

            $.ajax({
                url: '@_webapiurl' + "Master/HolidayGetOptionalAll?cmpid=@_cmpid&branchid=@_branchid",
                method: 'GET',
                headers: { 'Authorization': '@_tokan' },
                dataType: 'json',
                contentType: 'application/json',
                beforeSend: function () {
                    $('#ajax_loaderbranch').show();
                },
                buttons: [
                       "excelHtml5",
                ],
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    $('#tblholidayoptional tbody').empty();

                    var table = '';

                    for (var i = 0; i < response.length; i++) {

                        var tbl = "<tr class='odd gradeX'>";
                        tbl += "<td><input type='checkbox' class='checkbox' /></td>";  // Add checkbox
                        tbl += "<td class='HolidayId'hidden>" + response[i].HolidayId + "</td>";
                        // tbl += "<td hidden>" + response[i].EmpId + "</td>";
                        tbl += "<td class='HolidayName'>" + response[i].HolidayName + "</td>";
                        tbl += "<td class='HolidayDate'>" + response[i].HolidayDate + "</td>";
                        tbl += "<td class='HolidayToDate'>" + response[i].HolidayToDate + "</td>";
                        tbl += "<td class='CreatedDate'>" + response[i].CreatedDate + "</td>";
                        tbl += "<td hidden>" + response[i].CountryId + "</td>";
                        tbl += "<td hidden>" + response[i].BranchId + "</td>";
                        tbl += "<td hidden>" + response[i].IsHolidayType + "</td>";
                        tbl += "<td hidden>" + response[i].IsActive + "</td>";
                        tbl += "</tr>";
                        table += tbl;

                    }

                    $('#tblholidayoptional tbody').append(table);
                    $("#tblholidayoptional").DataTable({
                        paging: true,
                        autoWidth: true,
                        ordering: false,
                        buttons: ["excelHtml5"],
                    });

                    $("#tblholidayoptional").on("keyup", "input", function () {
                        var t = $("#tblholidayoptional").DataTable();
                        t.column($(this).parent().index())
                            .search(this.value)
                            .draw();
                    });

                    $('#tblholidayoptional').on('click', '.checkbox', function () {
                        var checkedCount = $('#tblholidayoptional .checkbox:checked').length;

                        if (this.checked && checkedCount > HolidayLimit) {
                            alert("You can only select up to " + HolidayLimit + " holidays.");
                            this.checked = false;
                        }

                    });
                    $('#tblholidayoptionalseleted').DataTable().destroy();
                    var objHoliday = {
                        Roleid: _RoleIDnew,
                        EmpId: _NewEmpID,
                    };

                    $.ajax({
                        url: '@_webapiurl' + 'Master/GetHolidayOptionalSelected',
                        method: 'GET',
                        headers: { 'Authorization': '@_tokan' },
                        data: objHoliday,
                        dataType: 'json',
                        contentType: 'application/json',
                        beforeSend: function () {
                            $('#ajax_loaderbranch').show();
                        },
                        success: function (response) {

                            if (response.isRedirect) {
                                window.location.href = response.redirectUrl;
                            }
                            $('#tblholidayoptionalseleted tbody').empty();

                            var table = '';
                            var _Flag = 0;

                            if (response != null && response.length > 0) {
                                for (var i = 0; i < response.length; i++) {

                                    if (response[i].Flag == 1) {
                                        if (_Flag == 0) {
                                            _Flag = 1;
                                        }
                                    }
                                    var tbl = "<tr class='odd gradeX'>";
                                    tbl += "<td hidden>" + response[i].HolidayId + "</td>";

                                    tbl += "<td  hidden>" + response[i].EmpId + "</td>";
                                    tbl += "<td  class='OptHolidayId'hidden>" + response[i].OptHolidayId + "</td>";
                                    tbl += "<td  class='HolidayID'hidden>" + response[i].HolidayID + "</td>";
                                    tbl += "<td class='EmpName'>" + response[i].EmpName + "</td>";
                                    tbl += "<td class='HolidayName'>" + response[i].HolidayName + "</td>";
                                    tbl += "<td class='HolidayDate'>" + response[i].HolidayDate + "</td>";
                                    tbl += "<td class='HolidayToDate'>" + response[i].HolidayToDate + "</td>";
                                    tbl += "<td class='CreatedDate'>" + response[i].CreatedDate + "</td>";
                                    tbl += "<td hidden>" + response[i].CountryId + "</td>";
                                    tbl += "<td hidden>" + response[i].BranchId + "</td>";
                                    tbl += "<td hidden>" + response[i].IsHolidayType + "</td>";
                                    tbl += "<td hidden>" + response[i].IsActive + "</td>";

                                    if (_RoleIDnew == 1) {
                                        tbl += "<td><a class='editclass btn blue_btnnew tooltips clm_edit_btn' data-placement='top' title='Edit'><i class='fa-regular fa-pen-to-square'></i></a></td>";
                                    }
                                    tbl += "</tr>";
                                    table += tbl;
                                }

                                if (_Flag == 0) {
                                    $('#tblholidayoptionalseleted tbody').append(table);

                                    var t = $("#tblholidayoptionalseleted").DataTable({
                                        paging: true,
                                        autoWidth: true,
                                        ordering: false,
                                        buttons: ["excelHtml5"],
                                    });

                                    $("#tblholidayoptionalseleted").on("keyup", "input", function () {
                                        t.column($(this).parent().index())
                                            .search(this.value)
                                            .draw();
                                    });

                                    $('#tblholidayoptionalseleted').show();
                                    $('.portletduplicate').css('display', 'block');
                                    $('.portlet').css('display', 'block');
                                    $('#tblholidayoptionalseleted').show();
                                }
                                else {
                                    $('#tblholidayoptionalseleted tbody').append(table);

                                    var t = $("#tblholidayoptionalseleted").DataTable({
                                        paging: true,
                                        autoWidth: true,
                                        ordering: false,
                                        buttons: ["excelHtml5"],
                                    });

                                    $("#tblholidayoptionalseleted").on("keyup", "input", function () {
                                        t.column($(this).parent().index())
                                            .search(this.value)
                                            .draw();
                                    });

                                    $('#tblholidayoptionalseleted').show();
                                    $('.portletduplicate').css('display', 'block');
                                    $('.portlet').css('display', 'none');
                                    $("#btnactive").hide();
                                    // $("#btnactive").prop('disabled', true);
                                }
                            } else {
                                $('#tblholidayoptionalseleted').hide();
                                // $('.portletduplicate').hide();
                                $('.portletduplicate').css('display', 'none');
                                $('.portlet').css('display', 'block');
                                $('#tblholidayoptionalseleted').show();
                                var t = $("#tblholidayoptionalseleted").DataTable({
                                    paging: true,
                                    autoWidth: true,
                                    ordering: false,
                                    buttons: ["excelHtml5"],
                                });
                            }
                            if (_RoleIDnew == 1) {
                                $('.portlet').css('display', 'none');
                                $('.portletduplicate').css('display', 'block');
                            }

                        },
                        complete: function () {
                            $('#ajax_loaderbranch').hide();
                        }
                    });


                    //$('#ajax_loaderbranch').hide();
                    //},
                    //error: function (xhr, status, error) {
                    //    if (xhr.status == 500) {
                    //        toastr.error("InternalServerError");
                    //    } else if (xhr.status == 400) {
                    //        toastr.error("BadRequest");
                    //    } else if (xhr.status == 401 || xhr.status == 302) {
                    //        window.location.href = "/PayTime/LoginPage";
                    //    } else {
                    //        console.error(error);
                    //    }
                    //},
                    //complete: function () {
                    //    $("#ajax_loaderbranch").hide();
                    //}
                }
            });

            //}
        }
        function checkSession() {
            $.ajax({
                type: "GET",
                async: false,
                url: "/ESS/checkSession",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    }
                },
                error: function (data) {
                    window.location.href = data;
                }
            });
        }
    });

</script>



