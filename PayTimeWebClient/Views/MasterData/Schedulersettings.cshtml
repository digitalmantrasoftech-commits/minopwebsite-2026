@model PayTimeWebClient.Models.Scheduler
@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@{
    ViewBag.Title = "Scheduler Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;

    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
    RoleRightsMapping obj = new RoleRightsMapping();
    obj.RoleMenuData = selectedUserMenu.Where(m => m.ActionUrl == actionurl);
    foreach (RoleRightsMapping item in obj.RoleMenuData)
    {
        obj = item;
    }
    string isClientDBMatchFlag = HttpContext.Current.Session["IsClientDBMatch"] != null
   ? HttpContext.Current.Session["IsClientDBMatch"].ToString()
   : "false"; // Default to "false" if the session is null


}
<script type="text/javascript">
    $(document).ready(function () {
        var $selectDep = $("#DeptIds").multiselect({
            selectAllValue: 'multiselect-all',
            enableCaseInsensitiveFiltering: true,
            includeSelectAllOption: true,
            allSelectedText: 'All Select',
            enableFiltering: true,
            maxHeight: '300',
            buttonWidth: '100%',
            enableClickableOptGroups: true
        });
        $(".alert").hide();
        frmClear();
        if ("@_Message" != "") {
            toastr.succes("@_Message");
            //$(".alert-danger").hide();
            //$(".alert-success").show();
        }
        if ('@_error' != "") {
            toastr.remove();
            toastr.error("@_error");
            //$(".alert-danger").show();
            //$(".alert-success").hide();
        }
        var schedulercount =  @Model.Schedulersettingslist.Count();
        if (schedulercount > 0) {
            $("#Addscheduler").prop("disabled", true)
            $("#Addscheduler").prop("readonly", true);
            $("#Addscheduler").addClass("disabled");
        }
        $('#tblSchedulersettings').DataTable({
            dom: _domCommon,
            language: _languageCommon,
            "paging":   true,
            "ordering": false,
            "searching": true,
            "info": false
        }); setTimeout(function () {
            $("#" + "tblSchedulersettings" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
            $('.tooltips').tooltip();
        }, 100);
        $("#Addscheduler").on('click', function () {
            frmClear();
            var dt = new Date();
            var time = dt.getHours() + ":" + dt.getMinutes();
            $('#tssStarttime').val(time);
            $("#tssIsActive").prop('checked', false);
            $("#Addscheduler").attr("data-toggle", "modal");
            $("#Addscheduler").attr("data-target", "#frmpopup");
            $("input:checkbox").prop('checked', false);

        });
        $(':input[type=number]').on('mousewheel', function (e) {
            e.preventDefault();
        });
        $(":input[type=number]").keypress(function (e) {
            //if the letter is not digit then display error and don't type anything
            if (this.value.length == 0 && e.which != 8 && e.which != 0 && (e.which <= 48 || e.which > 57)) {
                return false;
            }
        });
        $("#tssIntervalday").keypress(function (e) {
            if (this.value.length > 2) {
                return false;
            }
        });
        $("#tssIntervalweek").keypress(function (e) {
            if (this.value.length > 1) {
                return false;
            }
        });
        //$('#tssStarttime').timepicker({
        //    timeFormat: 'HH:mm',
        //    minuteStep: 1,
        //    showMeridian: false
        //});
        $("#tssAction").change(function () {
            $("#tssAction").removeClass('field_error');
            var actionid = $("#tssAction").val();
            if (actionid == 0) {
                $("#fsattenProcess").show();
            }
            else {
                $("#fsattenProcess").hide();
            }
        });
        $('#tssNametxt').bind('cut copy paste', function (e) {
            e.preventDefault(); //disable cut,copy,paste
        });

        $('#tssNametxt').blur(function ()
        {
            CheckIsSchedulerExist($("#tssNametxt").val());
        });
        $('#tssDescription').bind('cut copy paste', function (e) {
            e.preventDefault(); //disable cut,copy,paste
        })
        $("#tssTriggerid").change(function () {
            frmclerDaily();
            frmclerWeekly();
            frmclearMonthly();
            Hidefieldset();
            $("#tssTriggerid").removeClass('field_error');
            var trv = $("#tssTriggerid").val();
            //if (trv == 1) {
            //    $("#fsonetiem").show();
            //}
            if (trv == 2) {
                $("#fsdaily").show();
                $("#tssIntervalday").val(1);
            }
            if (trv == 3) {
                $("#fsweekly").show();
                $("#tssIntervalweek").val(1);

            }
            if (trv == 4) {
                $("#fsmonthly").show();
                $("#fsdaysofmo").hide();
                $("#fsmonthdayno").hide();
                $("#tssIntervalmonth").val(1);
                document.getElementById("monthrule1").checked = false;
                document.getElementById("monthrule2").checked = false;
            }

        });
        $("#monthrule1").change(function () {
            var monthrulval = $("#monthrule1").val();
            $("#fsdaysofmo").hide();
            $("#fsmonthdayno").hide();
            $('input[name="tssMothdaynoarr"]').prop('checked', false);
            $('input[name="tssmonthdayarr"]').prop('checked', false);
            $("#checkboxpanelmonthlyday").removeClass('field_error');
            $("#checkboxpanalmonthdayno").removeClass('field_error');
            if (monthrulval == 1) {
                $("#fsdaysofmo").show();
            }
        });
        $("#monthrule2").change(function () {
            var monthrulval = $("#monthrule2").val();
            $("#fsdaysofmo").hide();
            $("#fsmonthdayno").hide();
            $('input[name="tssMonthsdatearr"]').prop('checked', false);
            $("#checkboxpanalMonthsdate").removeClass('field_error');
            if (monthrulval == 2) {
                $("#fsmonthdayno").show();
            }
        });

        $("#tblSchedulersettings").on('click', '.editclass', function () {
            frmClear();
            $('#spIsChecked').hide();
            $(".editclass").attr("data-toggle", "modal");
            $(".editclass").attr("data-target", "#frmpopup");
            $("#tssId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
            $("#tssActionid").val($(this).parent('td').parent('tr').children(1)[2].innerText);
            $("#tssNametxt").val($(this).parent('td').parent('tr').children(1)[3].innerText);
            var tssId = $("#tssId").val();
            $.get("/MasterData/FillSchedulerbyID?id=" + tssId, function (response) {
                if (response.isRedirect) {
                    window.location.href = response.redirectUrl;
                }
                if (response != null) {
                    var obj = JSON.parse(response);
                    $("#tssDescription").val(obj.tssDescription);
                    $("#tssTriggerid").val(obj.tssTriggerid);
                    $("#tssTriggerid").trigger("change");
                    $("#tssStartdate").datepicker("setDate", obj.tssStartdate);
                    $('#tssStarttime').val(obj.tssStarttime);
                    $('#tssIntervalday').val(obj.tssIntervalday);
                    $('#tssIntervalweek').val(obj.tssIntervalweek);
                    $('#tssIsActive').val(obj.tssIsActive);
                    if (obj.tssIsActive) {
                        $("#tssIsActive").prop('checked', true);
                    }
                    else {
                        $("#tssIsActive").prop('checked', false);
                    }
                    var weekarray = obj.tssWeekday.split(",");
                    for (i = 0; i < weekarray.length; i++) {
                        var week = "#tssWeekday" + weekarray[i];
                        $(week).prop("checked", true);
                    }
                    var montharray = obj.tssmonths.split(",");
                    for (i = 0; i < montharray.length; i++) {
                        var month = "#tssMonths" + montharray[i];
                        $(month).prop("checked", true);
                    }
                    if (obj.tssMothdayno != "") {
                        $('#monthrule1').prop("checked", true);
                        $("#monthrule1").trigger("change");
                        var monthdatearray = obj.tssMothdayno.split(",");
                        for (i = 0; i < monthdatearray.length; i++) {
                            var monthdate = "#tssMonthsdate" + monthdatearray[i];
                            $(monthdate).prop("checked", true);
                        }
                    }
                    if (obj.tssMonthday !="") {
                        $('#monthrule2').prop("checked", true);
                        $("#monthrule2").trigger("change");
                        var monthdayarray = obj.tssMonthday.split(",");
                        for (i = 0; i < monthdayarray.length; i++) {
                            var monthday = "#tssMothdayno" + monthdayarray[i];
                            $(monthday).prop("checked", true);
                        }
                    }
                    if (obj.tssMonthdayrule != "") {
                        var tssMonthdayrulearray = obj.tssMonthdayrule.split(",");
                        for (i = 0; i < tssMonthdayrulearray.length; i++) {
                            var tssMonthdayrule = "#tssmonthday" + tssMonthdayrulearray[i];
                            $(tssMonthdayrule).prop("checked", true);
                        }
                    }
                    if (obj.saReportId==0) {
                        $('#tssAction').val(0);
                        $("#tssAction").trigger("change");
                    }
                    $('#CompanyID').val(obj.CompanyID);
                    $("#CompanyID").trigger("change");
                    fillBranchbycompnyid(obj.CompanyID, obj.BranchId);
                    $("#BranchId option[value = '" + obj.BranchId + "' ]").prop('selected', true);
                    $('#BranchId').trigger('change');
                    var dataarray = obj.DepartmentId.split(",");
                    $("#DeptIds").val(dataarray);
                    $("#DeptIds").multiselect("refresh");
                    //$("#BranchId").trigger("change",2);
                    fillDeptTable(obj.BranchId, obj.DepartmentId);
                }
            });
        });

        $("#tblSchedulersettings").on('click', '.deleteclass', function () {
            $("#tssId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
            swal({
                title: "Important!",
                text: "Are you sure for Delete this scheduler?",
                type: "error",
                showCancelButton: true,
                confirmButtonText: "Yes, delete it!",
                closeOnConfirm: true,
                confirmButtonClass: "btn-danger"

            },
             function (isConfirm) {
                 if (isConfirm) {
                     $.ajax({
                         url: '/MasterData/DeleteScheduler?id=' + $("#tssId").val(),
                         type: 'POST',
                         contentType: "application/json; charset=utf-8",
                         success: function (data) {
                             if (data = "OK") {
                                 $(".alert-danger").hide();
                                 $(".alert-success").text("Scheduler deleted sucessfully.");
                                 $('.alert-success').fadeIn('fast').delay(2000).fadeOut('slow');
                                 window.location.href = "/MasterData/Schedulersettings";
                             }
                             else {
                                 $(".alert-success").hide();
                                 $(".alert-danger").text("Error in deleting scheduler.");
                                 $('.alert-danger').fadeIn('fast').delay(2000).fadeOut('slow');
                             }
                         },
                         statusCode: {
                             404: function (content) { alert('cannot find resource'); },
                             500: function (content) { alert('internal server error'); }
                         },
                         error: function (req, status, errorObj) {
                             // handle status === "timeout"
                             // handle other errors
                         }
                     });
                     return true;
                 }
                 else {
                     return false;
                 }
             });
        });

        $("#tblSchedulersettings").on('click', '.Inactiveclass', function () {
            $("#tssId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
            var isactive = false;
            $.ajax({
                url: '/MasterData/ActiveInactiveScheduler?id=' + $("#tssId").val()+"&Isactive="+isactive,
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data = "OK") {
                        $(".alert-danger").hide();
                        $(".alert-success").text("Scheduler deactivated sucessfully.");
                        $('.alert-success').fadeIn('fast').delay(2000).fadeOut('slow');
                        window.location.href = "/MasterData/Schedulersettings";
                    }
                    else {
                        $(".alert-success").hide();
                        $(".alert-danger").text("Error in deactivating scheduler.");
                        $('.alert-danger').fadeIn('fast').delay(2000).fadeOut('slow');
                    }
                },
                statusCode: {
                    404: function (content) { alert('cannot find resource'); },
                    500: function (content) { alert('internal server error'); }
                },
                error: function (req, status, errorObj) {
                    // handle status === "timeout"
                    // handle other errors
                }
            });
        });

        $("#tblSchedulersettings").on('click', '.Activeclass', function () {
            $("#tssId").val($(this).parent('td').parent('tr').children(1)[1].innerText);
            var isactive = true;
            $.ajax({
                url: '/MasterData/ActiveInactiveScheduler?id=' + $("#tssId").val() + "&Isactive=" + isactive,
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data = "OK") {
                        $(".alert-danger").hide();
                        $(".alert-success").text("Scheduler Activated sucessfully.");
                        $('.alert-success').fadeIn('fast').delay(2000).fadeOut('slow');
                        window.location.href = "/MasterData/Schedulersettings";
                    }
                    else {
                        $(".alert-success").hide();
                        $(".alert-danger").text("Error in activing scheduler.");
                        $('.alert-danger').fadeIn('fast').delay(2000).fadeOut('slow');
                    }
                },
                statusCode: {
                    404: function (content) { alert('cannot find resource'); },
                    500: function (content) { alert('internal server error'); }
                },
                error: function (req, status, errorObj) {
                    // handle status === "timeout"
                    // handle other errors
                }
            });
        });


        $('#CompanyID').change(function () {
            $("#spvalidation").text("");
            $("#spValidation").hide();
            $("#select2-CompanyID-container").removeClass('field_error');
            var s = $('#CompanyID').val();
            $('#CompanyName').val($('#CompanyID :selected').text());
            fillBranchbycompnyid(s, "");
        });

        $('#BranchId').change(function () {
            $("#select2-BranchId-container").removeClass('field_error');
            $("#spvalidation").text("");
            $("#spValidation").hide();
            $("#txt3").val(0);
            $("#DeptIds").empty();
            $("#DeptIds option:selected").prop("selected", false);
            $("#DeptIds").multiselect('refresh');
            var s = $('#BranchId').val();
            $('#BranchName').val($('#BranchId :selected').text());
            $('#EmpIdTbl tr').remove();
            $('#EmpIdTbl tr').empty();
            $("#EmpIdTbl").empty();
            $.ajax({
                type: "POST",
                url: "/Transactions/GetDeptbyBranch?BranchId=" + $('#BranchId :selected').val(),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    if (response != null) {
                        $selectDep.multiselect('enable');
                        for (var i = 0; i < response.length; i++) {
                            $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                        }
                        $selectDep.multiselect('rebuild');

                    }
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        });


        $('#ChkAll').click(function (e) {
            $('#EmpIdTbl tr').remove();
            var table = $(e.target).closest('table');
            $('td input:checkbox', table).prop('checked', this.checked);
            for (i = 0; i < $('td input:checkbox', table).length; i++) {

                if ($('td input:checkbox', table)[i].checked == true) {
                    var DeptCode = $('td input:checkbox', table)[i].value;
                    fillEmpTable(DeptCode, true);
                }
                else {
                    $('#EmpIdTbl tr').remove();
                }
            }
        });

        $(document.body).on('change', '#DeptIds', function () {
            var deptid = $('#DeptIds option:selected');
            var DeptArray = [];
            $(deptid).each(function (index, deptid) {
                DeptArray.push([$(this).val()]);
            });
            if (DeptArray == "") {
                $("#txt3").val(0);
            }
            else {
                $("#txt3").val(DeptArray);
                $("#spValidation").hide();
            }
            var ArrDept = $("#txt3").val();
            DeptIdlst = ArrDept;
        });

        $("#btnsave").click(function (e) {
            if ($("#tssNametxt").val() == "") {
                $("#tssNametxt").addClass('field_error');
                e.preventDefault();
                return false;
            }
            else {
                $("#tssNametxt").removeClass('field_error');
            }

            if ($("#spIsChecked").is(":visible")) {
                $("#tssNametxt").addClass('field_error');
                $("#tssNametxt").focus();
                event.preventDefault();
                return false;
            }
            else {
                $("#tssNametxt").removeClass('field_error');
            }

            if ($("#tssTriggerid").val() == 0) {
                $("#tssTriggerid").addClass('field_error');
                e.preventDefault();
                return false;
            }
            else {
                $("#tssTriggerid").removeClass('field_error');
            }

            if ($("#tssStartdate").val() == "") {
                $("#tssStartdate").addClass('field_error');
                e.preventDefault();
                return false;
            }
            else {
                $("#tssStartdate").removeClass('field_error');
            }
            if ($("#tssStarttime").val() == "") {
                $("#tssStarttime").addClass('field_error');
                e.preventDefault();
                return false;
            }
            else {
                $("#tssStarttime").removeClass('field_error');
            }




            if ($("#tssTriggerid").val() == 2) {

                if ($("#tssIntervalday").val() == "" || $("#tssIntervalday").val() == 0 || $("#tssIntervalday").val() < 0) {
                    $("#tssIntervalday").addClass('field_error');
                    e.preventDefault();
                    return false;
                }
                else {
                    $("#tssIntervalday").removeClass('field_error');
                }
            }
            if ($("#tssTriggerid").val() == 3) {
                if ($("#tssIntervalweek").val() == "" || $("#tssIntervalweek").val() == 0 || $("#tssIntervalweek").val() < 0) {
                    $("#tssIntervalweek").addClass('field_error');
                    e.preventDefault();
                    return false;
                }
                else {
                    $("#tssIntervalweek").removeClass('field_error');
                }
                if ($("#tssWeekday1").prop('checked') == false && $("#tssWeekday2").prop('checked') == false && $("#tssWeekday3").prop('checked') == false && $("#tssWeekday4").prop('checked') == false && $("#tssWeekday5").prop('checked') == false && $("#tssWeekday6").prop('checked') == false && $("#tssWeekday7").prop('checked') == false) {
                    $("#checkboxpanelweeklyday").addClass('field_error');
                    e.preventDefault();
                    return false;
                }
                else {
                    $("#checkboxpanelweeklyday").removeClass('field_error');
                }
            }

            if ($("#tssTriggerid").val() == 4) {
                if ($("#tssIntervalmonth").val() == "" || $("#tssIntervalmonth").val() == 0 || $("#tssIntervalmonth").val() < 0) {
                    $("#tssIntervalmonth").addClass('field_error');
                    e.preventDefault();
                    return false;
                }
                else {
                    $("#tssIntervalmonth").removeClass('field_error');
                }
                var MonthIsChecked = $('input[name="tssMonthsarr"]:checked').length > 0;
                if (!MonthIsChecked)
                {
                    $("#checkboxpanelMonths").addClass('field_error');
                    e.preventDefault();
                    return false;
                }
                else {
                    $("#checkboxpanelMonths").removeClass('field_error');
                }

                var monthrule = $('input[name="monthrule"]:checked').length > 0;
                if (!monthrule) {
                    $("#radiopanalMonthsrule").addClass('field_error');
                    e.preventDefault();
                    return false;
                }
                else {
                    $("#radiopanalMonthsrule").removeClass('field_error');
                }

                if (document.getElementById("monthrule1").checked) {
                    var MonthdateIsChecked = $('input[name="tssMonthsdatearr"]:checked').length > 0;
                    if (!MonthdateIsChecked) {
                        $("#checkboxpanalMonthsdate").addClass('field_error');
                        e.preventDefault();
                        return false;
                    }
                    else {
                        $("#checkboxpanalMonthsdate").removeClass('field_error');
                    }

                }

                if (document.getElementById("monthrule2").checked) {

                    var MonthdaynoIsChecked = $('input[name="tssMothdaynoarr"]:checked').length > 0;
                    if (!MonthdaynoIsChecked) {
                        $("#checkboxpanalmonthdayno").addClass('field_error');
                        e.preventDefault();
                        return false;
                    }
                    else {
                        $("#checkboxpanalmonthdayno").removeClass('field_error');
                    }

                    var MonthdayIsChecked = $('input[name="tssmonthdayarr"]:checked').length > 0;
                    if (!MonthdayIsChecked) {
                        $("#checkboxpanelmonthlyday").addClass('field_error');
                        e.preventDefault();
                        return false;
                    }
                    else {
                        $("#checkboxpanelmonthlyday").removeClass('field_error');
                    }


                }
                if ($("#tssAction").val() == -1) {
                    $("#tssAction").addClass('field_error');
                    e.preventDefault();
                    return false;
                }
                else {
                    $("#tssAction").removeClass('field_error');
                }


            }
            $("#tssNametxt").keypress(function (e) {
                $("#tssNametxt").removeClass('field_error');
            });
            $("#tssStartdate").focus(function () {
                $("#tssStartdate").removeClass('field_error');
            });
            $("#tssStarttime").focus(function (e) {
                $("#tssStarttime").removeClass('field_error');
            });

            $("#tssWeekday1").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssWeekday2").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssWeekday3").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssWeekday4").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssWeekday5").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssWeekday6").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssIntervalweek").change(function () {
                $("#tssIntervalweek").removeClass('field_error');
            });
            $("#tssIntervalmonth").change(function () {
                $("#tssIntervalmonth").removeClass('field_error');
            });
            $("#tssMothdayno").change(function () {
                $("#tssMothdayno").removeClass('field_error');
            });
            $("#tssmonthweekday1").change(function () {
                $("#checkboxpanalmonthdayno").removeClass('field_error');
            });
            $("#tssmonthweekday2").change(function () {
                $("#checkboxpanalmonthdayno").removeClass('field_error');
            });
            $("#tssmonthweekday3").change(function () {
                $("#checkboxpanalmonthdayno").removeClass('field_error');
            });
            $("#tssmonthweekday4").change(function () {
                $("#checkboxpanalmonthdayno").removeClass('field_error');
            });
            $("#tssmonthweekday5").change(function () {
                $("#checkboxpanalmonthdayno").removeClass('field_error');
            });
            $("#tssmonthday1").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssmonthday2").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssmonthday3").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssmonthday4").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssmonthday5").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssmonthday6").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });
            $("#tssmonthday7").change(function () {
                $("#checkboxpanelweeklyday").removeClass('field_error');
            });

            if ($("#tssAction").val() == -1) {
                $("#tssAction").addClass('field_error');
                e.preventDefault();
                return false;
            }
            else {
                $("#tssAction").removeClass('field_error');
            }

            if ($('#CompanyID').val() <= 0) {
                $("#CompanyID").addClass('field_error');
                $("#select2-CompanyID-container").addClass('field_error');
                e.preventDefault();
                return false;
            }
            else {
                $("#CompanyID").removeClass('field_error');
                $("#select2-CompanyID-container").removeClass('field_error');
            }

            if ($('#BranchId').val() <= 0) {
                $("#BranchId").addClass('field_error');
                $("#select2-BranchId-container").addClass('field_error');
                e.preventDefault();
                return false;
            }
            else {
                $("#BranchId").removeClass('field_error');
                $("#select2-BranchId-container").removeClass('field_error');
            }

            if ($("#DeptIds").val() == null)
            {
                $("#DeptIds").addClass('field_error');
                e.preventDefault();
                return false;
            }
            else {
                $("#DeptIds").removeClass('field_error');
            }

        });
        $('#tssIsActive').change(function () {
            if ($('#tssIsActive').is(':checked')) {
                $('#tssIsActive').val(true);
            }
            else {
                $('#tssIsActive').val(false);
            }
        });
        $('#tssIsActive').val(false);
        function fillBranchbycompnyid(companyid, selectbranch) {
            $('#BranchId').empty();
            $.ajax(
             {
                 type: "GET",
                 url: "/MasterData/GetBranchbycomapny",
                 data: { comapanyid: companyid },
                 contentType: "application/json; charset=utf-8",
                 dataType: "json",
                 beforeSend: function () {
                     $("#ajax_loader").show();
                 },
                 success: function (data) {
                     if (data.isRedirect) {
                         window.location.href = data.redirectUrl;
                     }
                     $("#ajax_loader").hide();
                     var markup = '';

                     for (var x = 0; x < data.length; x++) {
                         markup += "<option value=" + data[x].BranchId + ">" + data[x].BranchName + "</option>";
                     }
                     var newOption = '<option selected="selected"  value="">Select Branch</option>';

                     $('#BranchId').html(newOption);
                     $('#BranchId').append(markup);
                     $('#BranchId').val(selectbranch);
                 },
                 error: function (jqXHR, ajaxOptions, thrownError) {
                     if (jqXHR.status == 500) { //InternalServerError = 500,
                         toastr.error("InternalServerError");
                     } else if (jqXHR.status == 400) { //BadRequest = 400,
                         toastr.error("BadRequest");
                     } else if (jqXHR.status == 401) {
                         window.location.href = "/PayTime/LoginPage";
                     }
                 }
             });
        }
        function fillDeptTable(BranchId, selectedDept) {
            $("#DeptIds").empty();
            $.ajax({
                type: "POST",
                url: "/Transactions/GetDeptbyBranch?BranchId=" + BranchId,
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                success: function (response) {
                    if (response != null) {
                        for (var i = 0; i < response.length; i++) {
                            if (selectedDept.length != 0) {
                                var re = new RegExp("(^|,)" + response[i].Value + "($|,)");
                                if (re.test(selectedDept) == true) {
                                    $('#DeptIds').append('<option value=" ' + response[i].Value + '" selected>' + response[i].Text + '</option>');
                                }
                                else {
                                    $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                                }
                            }
                            else {
                                $('#DeptIds').append('<option value=" ' + response[i].Value + ' ">' + response[i].Text + '</option>');
                            }
                        }
                        $selectDep.multiselect('rebuild');
                    }
                    $(".loading").hide();
                },
                beforeSend: function () {
                    $(".loading").show();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }


        function frmclerDaily() {
            $("#tssIntervalday").val(0);
            $("#tssIntervalday").removeClass('field_error');

        }
        function frmclerWeekly() {
            $("#tssIntervalweek").val(0);


            $("#tssWeekday1").prop('checked', false);
            $("#tssWeekday2").prop('checked', false);
            $("#tssWeekday3").prop('checked', false);
            $("#tssWeekday4").prop('checked', false);
            $("#tssWeekday5").prop('checked', false);
            $("#tssWeekday6").prop('checked', false);
            $("#tssWeekday7").prop('checked', false);

            $("#tssIntervalweek").removeClass('field_error');
            $("#checkboxpanelweeklyday").removeClass('field_error');
            $("#tssWeekday").val("0");
        }
        function frmclearMonthly() {
            $("#tssIntervalmonth").val(0);
            $("#tssIntervalmonth").removeClass('field_error');
            frmclearmonthlyrule1();
            frmclearmonthlyrule2();
        }

        function frmclearmonthlyrule1() {
            $("#tssMothdayno").val(0);
            $("#tssMothdayno").removeClass('field_error');

        }
        function frmclearmonthlyrule2() {
            $("#tssmonthweekday1").prop('checked', false);
            $("#tssmonthweekday2").prop('checked', false);
            $("#tssmonthweekday3").prop('checked', false);
            $("#tssmonthweekday4").prop('checked', false);
            $("#tssmonthweekday5").prop('checked', false);

            $("#tssmonthday1").prop('checked', false);
            $("#tssmonthday2").prop('checked', false);
            $("#tssmonthday3").prop('checked', false);
            $("#tssmonthday4").prop('checked', false);
            $("#tssmonthday5").prop('checked', false);
            $("#tssmonthday6").prop('checked', false);
            $("#tssmonthday7").prop('checked', false);

            $("#checkboxpanalmonthdayno").removeClass('field_error');
            $("#checkboxpanelweeklyday").removeClass('field_error');


            $("#tssMonthday").val("0");
            $("#tssMonthdayrule").val("0");

        }



        function frmClear() {
            frmclerDaily();
            frmclerWeekly();
            frmclearMonthly();
            $("#tssId").val(0);
            $("#tssNametxt").val("");
            $("#tssDescription").val("");
            $("#tssTriggerid").val(0);
            $("#tssAction").val(-1);
            Hidefieldset();
            $("#tssNametxt").removeClass('field_error');
            $("#tssStartdate").removeClass('field_error');
            $("#tssStarttime").removeClass('field_error');
            $("#checkboxpanelMonths").removeClass('field_error');
            $("#tssTriggerid").removeClass('field_error');
            $("#tssAction").removeClass('field_error');
            $("#checkboxpanalmonthdayno").removeClass('field_error');
            $("#checkboxpanelmonthlyday").removeClass('field_error');
            $("#radiopanalMonthsrule").removeClass('field_error');
            $("#CompanyID").val(null);
            $("#select2-CompanyID-container").html("Select Company");
            $("#select2-CompanyID-container").attr("title", "Select Company");
            $("#BranchId").empty();
            $("#BranchId").append("<option value='0'>Select Branch</option>");
            $("#BranchId").val(0);
            $("#DeptIds option:selected").prop("selected", false);
            $("#DeptIds").multiselect('refresh');
            $("#DeptIds").multiselect('disable');
            $("#CompanyID").removeClass('field_error');
            $("#BranchId").removeClass('field_error');
            $("#fsattenProcess").hide();
            $('#spIsChecked').hide();

        }
        function Hidefieldset() {
            $("#fsonetiem").hide();
            $("#fsdaily").hide();
            $("#fsweekly").hide();
            $("#fsmonthly").hide();
        }

    });
    function blockSpecialChar(e) {
        var k = e.keyCode;
        return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || (k >= 48 && k <= 57) || k == 32);
    }

    function CheckIsSchedulerExist(name) {
        $.ajax(
         {
             type: "GET",
             url: "/MasterData/CheckIsSchedulerExist",
             data: { Name: name },
             contentType: "application/json; charset=utf-8",
             dataType: "json",
             beforeSend: function () {
             },
             success: function (data) {
                 if (data.isRedirect) {
                     window.location.href = data.redirectUrl;
                 }
                 if (data.IsExist == true) {
                     $('#spIsChecked').html("Scheduler with this name already exists.")
                     $('#spIsChecked').show()
                     $("#tssNametxt").addClass('field_error');
                     $("#tssNametxt").focus();
                     event.preventDefault();
                     return false;
                 }
                 else {
                     $('#spIsChecked').hide()
                     $("#tssNametxt").removeClass('field_error');
                 }
             },
             error: function (jqXHR, ajaxOptions, thrownError) {
                 if (jqXHR.status == 500) { //InternalServerError = 500,
                     toastr.error("InternalServerError");
                 } else if (jqXHR.status == 400) { //BadRequest = 400,
                     toastr.error("BadRequest");
                 } else if (jqXHR.status == 401) {
                     window.location.href = "/PayTime/LoginPage";
                 }
             }
         });
    }


