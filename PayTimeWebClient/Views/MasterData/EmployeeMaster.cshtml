                         $('#BranchIdsfilter').append(markup);
                         $Branchselect.multiselect('rebuild');
                         $(document.body).on('change', '#BranchIdsfilter', function () {
                             //$("#spvalidation").hide();
                             var branid = $('#BranchIdsfilter option:selected');
                             var BranchArray = [];
                             $(branid).each(function (index, branid) {
                                 BranchArray.push([$(this).val()]);
                             });
