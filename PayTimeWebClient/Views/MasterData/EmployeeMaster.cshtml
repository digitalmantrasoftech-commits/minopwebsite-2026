        function Binddropdown(ctlname, ctlmaster, ctlurl, selectedBU) {
            debugger;

            var objreq = {
                searchfrom: ctlmaster,
                searchval: ctlname ?? "",
                tblname: "All",
                selectedBU: selectedBU
            };

            $("#" + ctlname).empty();

            $("#" + ctlname).append(
                $("<option></option>")
                    .val("")
                    .html("Select " + ctlmaster)
            );

            $.ajax({
                type: 'POST',
                url: "/Utilities/" + ctlurl,
                data: JSON.stringify(objreq),
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                cache: false,
                success: function (json) {

                    // Get session value
                    selectedSubBUId = sessionStorage.getItem("selectedSubBUId");

                    $.each(json, function (i, item) {

                        var option = $("<option></option>")
                            .val(item.value)
                            .html(item.label);

                        if (item.value == selectedSubBUId) {
                            option.prop("selected", true);
                        }

                        $("#" + ctlname).append(option);

                    });

                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    console.log('error', textStatus, errorThrown);
                }
            });
        }

