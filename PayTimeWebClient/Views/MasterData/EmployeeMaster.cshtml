            $("#EmpPhotoFile").change(function () {
                var GetfileName = document.getElementById('EmpPhotoFile');
                var selectedfile = GetfileName.files[0].size;
                var filename = GetfileName.files[0].name;
                var validFileSize = 5 * 1024 * 1024; // 5 MB in bytes
                if (selectedfile > validFileSize) {
                    toastr.remove();
                    toastr.error("Select file between 0 to 5 MB.");
                    $(this).val("");
                    return false;
                }
                $("#ajax_loaderbranch").show();
                var allowedFiles = [".bmp", ".png", ".jpg", ".jpeg"];
                var fileUpload = $("#EmpPhotoFile");
                var regex = new RegExp("([a-zA-Z0-9\s_\\.\-:])+(" + allowedFiles.join('|') + ")$");
                if (!regex.test(fileUpload.val().toLowerCase())) {
                    toastr.remove();
                    toastr.error("Please upload files having extensions:" + allowedFiles.join(', ') + " only.");
                    $(this).val("");
                    $("#ajax_loaderbranch").hide();
                    return false;
                } else {

                    var file = GetfileName.files[0];
                    var filebase64 = "";
                    if ('@_isPlanId' != '3' && '@_isPlanId' != '6') {
                        $("#ajax_loaderbranch").hide();
                        $("#EmpPhoto").val(filename);
                    }
                    else {
                        if (file) {
                            var reader = new FileReader();
                            reader.onload = function (event) {
                                const image = new Image();
                                image.src = event.target.result;
                                image.onload = function () {
                                    const maxWidth = 1920; // Max width for the resized image
                                    const maxHeight = 1080; // Max height for the resized image

                                    let width = image.width;
                                    let height = image.height;

                                    // Maintain aspect ratio
                                    if (width > maxWidth) {
                                        height *= maxWidth / width;
                                        width = maxWidth;
                                    }
                                    if (height > maxHeight) {
                                        width *= maxHeight / height;
                                        height = maxHeight;
                                    }

                                    const canvas = document.createElement('canvas');
                                    canvas.width = width;
                                    canvas.height = height;

                                    const ctx = canvas.getContext('2d');
                                    ctx.drawImage(image, 0, 0, width, height);

                                    // Convert canvas content to data URL
                                    const resizedDataUrl = canvas.toDataURL('image/jpeg'); // You can change the format if needed

                                    // Base64 of the resized image
                                    const resizedBase64 = resizedDataUrl.split(',')[1];
                                    if (resizedBase64 != "") {
                                        $.ajax({
                                            type: "POST",
                                            url: '@_webapiurl' + 'dvc/GetFaceQuality',
                                            data: {
                                                image: resizedBase64,
                                                qualityThreshold: '@_facequalitythreshold'
                                            },
                                            success: function (response) {
                                                $("#ajax_loaderbranch").hide();
                                                if (response.highQualityface) {
                                                    $("#EmpphotoBase").val(resizedBase64);
                                                    return true;
                                                } else {
                                                    if (response.message != null) {
                                                        if (response.message == "Invalid image. Please pass base-64 string of any .jpg .jpeg .png .bmp.") {
                                                            toastr.remove();
                                                            toastr.error("Please upload files having extensions of .jpg .jpeg .png .bmp.");
                                                        }
                                                        else if (response.message == "image quality is low, Please select image with proper quality.") {
                                                            toastr.remove();
                                                            toastr.error("Please upload a higher-quality image.");
                                                        }
                                                        else if (response.message == "No face is detected in the image.") {
                                                            toastr.remove();
                                                            toastr.error("There was no face identified, so please upload the new image.");
                                                        }
                                                        else if (response.message == "Something went wrong on face detect") {
                                                            toastr.remove();
                                                            toastr.error("Face not detected ,please upload image with proper face.");
                                                        }
                                                        else {
                                                            toastr.remove();
                                                            toastr.error(response.message);
                                                        }
                                                        $(".profile_img  img").attr("src", "");
                                                        $(".fileInput").fileinput("reset");
                                                        $(".btn-block").show();
                                                        $(".change").hide();
                                                        $(".remove").hide();
                                                        $("#EmpPhotoFile").val('');
                                                        return false;
                                                    } else {
                                                        toastr.remove();
                                                        toastr.error("File quality is low, Please select file with proper quality.");
                                                        $(".profile_img  img").attr("src", "");
                                                        $(".fileInput").fileinput("reset");
                                                        $(".btn-block").show();
                                                        $(".change").hide();
                                                        $(".remove").hide();
                                                        $("#EmpPhotoFile").val('');
                                                        return false;
                                                    }
                                                }
                                            },
                                            error: function (response) {
                                                $("#ajax_loaderbranch").hide();
                                                toastr.remove();
                                                toastr.error("Please upload the high quality photo.");
                                                $(".profile_img  img").attr("src", "");
                                                $(".fileInput").fileinput("reset");
                                                $(".btn-block").show();
                                                $(".change").hide();
                                                $(".remove").hide();
                                                $("#EmpPhotoFile").val('');
                                                return false;
                                            }
                                        });

                                    } else {
                                        toastr.remove();
                                        toastr.error("File not in  proper format.");
                                        $(this).val("");
                                        return false;
                                    }
                                }
                                image.onerror = function () {
                                    toastr.remove();
                                    toastr.error("Error loading the image. Please check the file format.");
                                    $("#ajax_loaderbranch").hide();
                                    $(this).val("");
                                    $(".emp_profile_img  img").attr("src", "");
                                    $(".fileInput").fileinput("reset");
                                    $(".btn-block").show();
                                    $(".change").hide();
                                    $(".remove").hide();
                                    $("#EmpPhotoFile").val('');
                                    return false;
                                };
                            }
                            reader.readAsDataURL(file);
                        }
                    }
                }
            });

