                                        $("#PolicyId").append("<option value='" + response[i].PolicyId + "'>" + response[i].PolicyName + "</option>");
                                    }
                                }

                            }
                        }

                    }
                    if (pId != null & pId != 0) {
                        $("#PolicyId option[value ='" + pId + "']").prop('selected', true);
                        $('#PolicyId').trigger('change.select2');
                    }
                    $(".loading").hide();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }
        function fillempReporting() {
            $('#DepartmentHead').empty();
            $.ajax({
                type: "GET",
                url: '@_webapiurl' + 'Master/EmployeeGetAllReporting',
                headers: { 'Authorization': '@_tokan' },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                async: "false",
                beforeSend: function () {
                    $(".loading").show();
                },
                success: function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    if (response != null) {
                        $("#DepartmentHead").append("<option value='0' selected>Select Department Head</option>");
                        response.sort(function (a, b) {
                            return a.EmpName.localeCompare(b.EmpName); // Sort policy names in ascending order
                        });
                        for (var i = 0; i < response.length; i++) {
                            $("#DepartmentHead").append("<option value='" + response[i].EmpId + "'>" + response[i].EmpName + "(" + response[i].Empcode + ")" + "</option>");
                        }
                    }
                    $(".loading").hide();
                },
                error: function () {
                    $(".loading").hide();
                }
            });
        }
    </script>

