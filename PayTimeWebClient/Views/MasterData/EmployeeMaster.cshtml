            function EmployeeFilter(branchIDs, companyIDs, departmentIDs, designationIDs)
            {
                var obj =
                {
                    "BranchIDs": branchIDs || [],
                    "CompanyIDs": companyIDs || [],
                    "DepartmentIDs": departmentIDs || [],
                    "DesignationIDs": designationIDs || []
                };
                var mainObj =
                {
                    "CompanyID": "0",
                    "BranchID": "0",
                    "EmpID": "0",
                    "EmployeeFilter": obj
                };
                // Assuming _RoleId is a variable
                if (RoleId == 6805)
                {
                    mainObj =
                    {
                        "CompanyID": _companyid,
                        "BranchID": "0",
                        "EmpID": "0",
                        "EmployeeFilter": obj
                    };
                }

                if (RoleId == 6806)
                {
                    mainObj = {
                        "CompanyID": "0",
                        "BranchID": _branchid,
                        "EmpID": "0",
                        "EmployeeFilter": obj
                    };
                }
                // Return or use mainObj as needed
                return mainObj;
            }

