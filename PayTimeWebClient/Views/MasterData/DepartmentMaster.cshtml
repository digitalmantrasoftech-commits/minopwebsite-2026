            /*checkedColumnsList = checkedColumnIds.join(",");*/

            // Remove existing footer
            $("#tbldepartment thead tr:eq(1)").remove();

            // Add new footer based on visible columns with search inputs
            var visibleColumns = t.columns(':visible').indexes().toArray();
            var footer = '<tr class="footer">';

            $("#tbldepartment thead th").each(function (index) {
                var headerText = $(this).text().trim();
                if (_isServerSide && ["Department Name", "Department EmailId", "Department Headname"].includes(headerText)) {
                    footer += `<th><input type="text" class="search_input" data-column="${headerText}" placeholder="Search" /><i class="clm-search" id=""></i></th>`;
                }
                else if (!_isServerSide && ["Department Name", "Department EmailId","Department Headname"].includes(headerText)) {
                    footer += `<th><input type="text" class="search_input" data-column="${headerText}" placeholder="Search" /><i class="clm-search" id=""></i></th>`;
                }
                else {
                    footer += '<th></th>';
                }
            });
            footer += '</tr>';
