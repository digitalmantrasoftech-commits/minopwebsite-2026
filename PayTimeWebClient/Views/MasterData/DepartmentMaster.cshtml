            //    return false;
            //}
            //else {
            //    $("#DeparmentEmailID").removeClass('field_error');
            //    $("#spDepEmail").hide();
            //}
            var EmailMsg = "";
            EmailMsg = ValidateEmailid($("#DeparmentEmailID").val());
            if (EmailMsg != "success") {
                toastr.remove();
                toastr.error(EmailMsg);
                $("#DeparmentEmailID").val("");
                $("#DeparmentEmailID").focus();
                $("#DeparmentEmailID").addClass('field_error');
                return false;
            }
            else {
                $("#DeparmentEmailID").removeClass('field_error');
                $("#spDepEmail").hide();
            }
        });
        window.onload = function () {
            timeSpentOnPage();
        }
        $(window).on("beforeunload", function () {
            if (operation == "" || operation == null || operation == '') {
                operation = "View Department Master";
            }
            var url = '@_webapiurl' + '/DashBoard/AddAnalyticsUser';
            var timeSpent = timeSpentOnPage();
            analyticsDataUsage(url, '@_dbName', form, '@_tokan', count, operation, timeSpent)
        })
    });
    function showvisibilityColumn() {
        var _chkarrylstsp = _chkarrylst;
        var _lst = 0;
        $('#fieldlst :input').each(function () {
            var _idfield = $(this).attr("id");
            var _rmidfield = _idfield.replace("chk_", "");
            $("#" + _idfield).prop('checked', false);
            var _ss = _chkarrylstsp.split(",")
            for (var i = 0; i <= _ss.length; i++) {
                if (_ss[i] == _rmidfield) {
                    $("#" + _idfield).prop('checked', true);
                    var _rmidfield = _idfield.replace("chk_", "");
                    _lst += "," + _rmidfield;
                }
            }
        });
        _chkarrylst = _lst;
        $("#btnColumnvisibility").attr("data-toggle", "modal");
        $("#btnColumnvisibility").attr("data-target", "#frmpopupCustomfld");
    }
    function checkSession() {
        $.ajax({
            type: "GET",
            async: false,
            url: "/ESS/checkSession",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.isRedirect) {
                    window.location.href = data.redirectUrl;
                }
            },
            error: function (data) {
                window.location.href = data;
            }
        });
    }
