    function fillDepartmentHeadById(DeptHeadId) {
         const DepartmentHeadDropdown = new Select2Dropdown({
                    dropdownId: "DepartmentHead", // ID of the dropdown
                    apiUrl: '@_webapiurl' + 'DataDropDownOptimize/GetEmployeeSimpleDropDownData', // API URL for fetching data
                    dataKey: "Id", // Key for value
                    labelKey: "Name", // Key for text
                    token: '@_tokan', // Optional auth token
                    chunkSize : Number('@_ChunkSize')
         });

          $.ajax({
                    type : "GET",
                    url: '@_webapiurl' + "Master/EmployeeGetById?id=" + DeptHeadId,
                    headers: { 'Authorization': '@_tokan' },
                    dataType: "json",
                    success: function (response) {
                        if (response != null && response != [] && response != '') {
                            let textWithCode = response[0].EmpName + " (" + response[0].Empcode + ")";
                            // Create a DOM Option and pre-select by default
                            var newOption = new Option(textWithCode, DeptHeadId, true, true);
                            // Append it to the select
                            $('#DepartmentHead').append(newOption).trigger('change');
                        }
                    }
                })
    }
