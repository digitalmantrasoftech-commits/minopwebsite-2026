        $("#btnApply").click(function (event) {
            _chkarrylst = 0;
            $('#fieldlst :input').each(function () {
                var _idfield = $(this).attr("id");
                var column = t.column($(this).attr('data-column'));
                column.visible(false);
                $.each($("input[id='" + _idfield + "']:checked"), function () {
                    var _chkid = _idfield;
