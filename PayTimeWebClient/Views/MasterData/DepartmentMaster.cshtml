            $("#tbldepartment thead").append(footer);
            $('#frmpopupCustomfld').modal('toggle');

        });

        $("#tbldepartment").on('click', '.deleteclass', function () {
            var flg = 0;
            if (confirm("Are you sure for Delete this Entry?")) {
                var did = $(this).parent('td').parent('tr').children(1)[1].innerText;
                $.post("/MasterData/DeleteDepartment?id=" + did, function (response) {
                    if (response.isRedirect) {
                        window.location.href = response.redirectUrl;
                    }
                    var _response = $.parseJSON(response);
                    if (_response == "OK") {
                        alert("Record deleted successfully.");
                        window.location.href = "/MasterData/DepartmentMaster/";
                    }
                    else {
                        alert("Something wrong occures.");
                    }
                });
            }
        });

        function frmClear() {
            $("#DepartmentId").val(0);
            $("#DepartmentName").val("");
            $("#DepartmentHead").val(0);
            $('#DepartmentHead').trigger('change.select2');
            $("#DeparmentEmailID").val("");
            $("#DeptIsEmail").prop('checked', false);
            $("#DepartmentName").removeClass('field_error');
            $("#DeparmentEmailID").removeClass('field_error');
            $("#spDepEmail").hide();
        }
        $("#DeparmentEmailID").change(function () {
            //var filter = new RegExp(/^[_A-Za-z0-9-]+(\.[_A-Za-z0-9-]+)*@@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*(\.[A-Za-z]{2,4})$/);
