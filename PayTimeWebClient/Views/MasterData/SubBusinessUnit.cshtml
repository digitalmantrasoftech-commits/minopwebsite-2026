@using PayTimeWebClient.Helper;
@using PayTimeWebClient.Models;
@using System.Configuration;
@{
    ViewBag.Title = "SubBusinessUnit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _Message = ViewBag.msg;
    string _error = ViewBag.error;
    int _RoleId = Convert.ToInt32(HttpContext.Current.Session["RoleId"]);
    int _UserId = Convert.ToInt32(HttpContext.Current.Session["UserId"]);
    int _cmpid = Convert.ToInt32(HttpContext.Current.Session["CompanyId"]);

    string _tokan = HttpContext.Current.Session["tokan"].ToString();
    string _webapiEMSURL = ConfigurationManager.AppSettings["WebApiEMS"].ToString();
    string _webapiurl = ConfigurationManager.AppSettings["webapipaytime"].ToString();
    string _accountcd = HttpContext.Current.Session["cmpcode"].ToString();
    MasterDataRestClient objusedetails = new MasterDataRestClient();
    var selectedUserMenu = objusedetails.RoleRightsGetAll(_RoleId).Where(y => y.IsActive == true);
    string action = ViewContext.RouteData.GetRequiredString("action");
    string Controller = ViewContext.RouteData.GetRequiredString("Controller");
    string actionurl = "/" + Controller + "/" + action;
}

<link href="/Newlayout/css/payrollstructure.css" rel="stylesheet">
<script src="~/Scripts/Helpers/noDataHandler.js"></script>
<script>
    $(document).ready(function () {
        LoadBUList();
        GetAllSubBuDetails();
        $("#AddSubBU_btn").click(function () {
            resetSubBUModal();
            $("#SubBUModalTitle").text("Add SubBU");
            $("#AddSubBU_btn_modal").modal("show");
        });
        function resetSubBUModal() {
            $("#hdnSubBUId").val(0);
            $("#ddlBUName").val("").trigger("change");
            $("#txtSubBUName").val("");
        }
        $("#btnClearSubBU").click(function () {
            $("#txtSubBUName").val('').focus();
            $("#ddlBUName").val(null).trigger('change');
        });
    });
    function LoadBUList() {
        $.ajax({
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Master/BUGetAll',
            success: function (response) {

                let options = "";

                (response || [])
                    .filter(x => x.IsActive == 1)
                    .forEach(x => {
                        options += `<option value="${x.BUId}">${x.BUName}</option>`;
                    });

                $("#ddlBUName").html(options).select2();
            },
            error: function () {
                toastr.error("Failed to load BU list.");
            }
        });
    }
    function GetAllSubBuDetails() {
        $.ajax({
            type: "GET",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Master/SubBUGetAll',
            dataType: "json",
            beforeSend: function () {
                //$("#ajax_loaderbranch").show();
            },
            success: function (response) {
                //$("#ajax_loaderbranch").hide();
                handleGridVisibility("tblempty", "NotificationGrid-empty", response, {
                    imageUrl: "emptyscreen_1.png",
                    subText: "No entries found. Please add a record to get started."
                });

                if (!response || response.length === 0) {
                    $("#ddlBUName").html("<option value='0'>Select BU</option>");
                    return;
                }
                _BUData = response;
                if (!response || response.length === 0) return;
                _BUData = response;
                if ($.fn.DataTable.isDataTable('#tblsubbuwise')) {
                    $('#tblsubbuwise').DataTable().clear().destroy();
                    $('#dataTables_tbl_header').remove();
                }
                var html = "";
                response.forEach(function (item) {

                    html += "<tr>";
                    html += "<td>" + item.SubBUName + "</td>";
                    html += "<td>" + item.BUName + "</td>";
                    html += "<td>";

                    // Edit Button
                    html += "<a class='editclass btn btn-xs seagreen_btnnew tooltips' " +
                        "title='Edit' data-buid='" + item.SubBUId + "'>" +
                        "<i class='fa-regular fa-pen-to-square'></i></a> ";

                    // Active / Inactive Button
                    if (item.IsActive == 1) {
                        html += "<a class='statusclass btn blue_btnnew tooltips' " +
                            "title='Inactive' data-subbuid='" + item.SubBUId + "' data-status='1'>" +
                            "<i class='fa-solid fa-xmark'></i></a> ";
                    } else {
                        html += "<a class='statusclass btn blue_btnnew tooltips' " +
                            "title='Active' data-subbuid='" + item.SubBUId + "' data-status='0'>" +
                            "<i class='fa-solid fa-check'></i></a> ";

                    }

                    html += "</td>";
                    html += "</tr>";
                });

                $("#tblsubbuwise").html(html);
                $('#tblsubbuwise').DataTable({
                    destroy: true,
                    dom: _domCommon,
                    language: _languageCommon,
                    ordering: true,
                    order: [],
                    columnDefs: [
                        { targets: [2], orderable: false }
                    ],
                    columns: [
                        { title: "Sub Business Unit" },
                        { title: "Business Unit" },
                        { title: "Action" }
                    ],
                    initComplete: function () {
                        const visibleTable = this.api().table().node().id;
                        $("#buttons").append(`
                                  <div id="export-button" class="export-button tooltips" data-placement="bottom" data-original-title="Download" data-table-id="${visibleTable}">
                                      <img src="../Newlayout/images/download_icon.svg" alt="Download icon">
                                  </div>
                              `);
                    },
                });
                setTimeout(function () {
                    $("#" + "tblsubbuwise" + "_wrapper #dataTables_tbl_header").insertBefore($("#tableResponsive"));
                    $('.tooltips').tooltip();
                }, 100);
                $('.tooltips').tooltip();
            },
            error: function (jqXHR) {
                $("#ajax_loaderbranch").hide();
                if (jqXHR.status == 500) {
                    toastr.error("Internal Server Error");
                }
                else if (jqXHR.status == 401) {
                    window.location.href = "/PayTime/LoginPage";
                }
                else {
                    toastr.error("Something went wrong.");
                }
            }
        });
    }
    $(document).on("click", "#btnSaveSubBU", function () {
        var subBUName = $("#txtSubBUName").val().trim();
        var buId = $("#ddlBUName").val();
        if (buId === "") {
            toastr.remove();
            toastr.error("Please select Business Unit.");
            return;
        }
        if (subBUName === "") {
            toastr.remove();
            toastr.error("Please enter Sub Business Unit.");
            return;
        }
        var model = {
            SubBUId: $("#hdnSubBUId").val() || 0,
            BUId: $("#ddlBUName").val(),
            SubBUName: subBUName,
            IsActive: 1,
            UserId: typeof _UserId !== "undefined" ? _UserId : null,
            CompanyID: typeof _CompanyID !== "undefined" ? _CompanyID : null,
            BranchID: typeof _BranchID !== "undefined" ? _BranchID : null
        };
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Master/SubBUSave',
            data: JSON.stringify(model),
            contentType: "application/json",
            success: function (response) {
                if (response.Status == -1) {
                    GetAllSubBuDetails();
                    toastr.remove();
                    toastr.warning(response.Message);
                    resetSubBUModal();
                }
                else if (response.Status == 1 || response.Status == 2) {
                    GetAllSubBuDetails();
                    toastr.remove();
                    toastr.success(response.Message);
                    $("#AddSubBU_btn_modal").modal("hide");

                }
                else {
                    toastr.error(response.Message);
                }
            },
            error: function () {
                toastr.error("Server error.");
            }
        });
    });
    $(document).on("click", ".editclass", function () {
        var subBUId = $(this).data("buid");
        var item = _BUData.find(x => x.SubBUId == subBUId);
        if (!item) return;
        $("#SubBUModalTitle").text("Edit SubBU");
        $("#hdnSubBUId").val(item.SubBUId);
        $("#ddlBUName").val(item.BUId).trigger("change");
        $("#txtSubBUName").val(item.SubBUName);

        $("#AddSubBU_btn_modal").modal("show");
    });
    $(document).on("click", ".statusclass", function () {
        var subBUId = $(this).data("subbuid");
        var currentStatus = $(this).data("status");
        var newStatus = currentStatus == 1 ? 0 : 1;
        $.ajax({
            type: "POST",
            headers: { 'Authorization': '@_tokan' },
            url: '@_webapiurl' + 'Master/SubBUDelete',
            data: JSON.stringify({
                SubBUId: subBUId,
                IsActive: newStatus,
                UserId: typeof _UserId !== "undefined" ? _UserId : null
            }),
            contentType: "application/json",
            success: function (response) {
                if (response.Status == 1) {
                    toastr.remove();
                    toastr.success(response.Message);
                    GetAllSubBuDetails();
                } else {
                    toastr.remove();
                    toastr.error(response.Message);
                }
            },
            error: function () {
                toastr.error("Server error.");
            }
        });
    });
    function validateBUName(input) {
        input.value = input.value
            //.replace(/[^a-zA-Z\s]/g, '')   
            .replace(/^\s+/g, '')          
            .replace(/\s{2,}/g, ' ');    
    }

</script>

<!-- Page Bar : Begin -->
<div class="page-bar">
    <ul class="page-breadcrumb">
        <li>
            <a href="/Admin/AdminDashboard"><i class="fa-regular fa-house"></i></a>
        </li>
        <li>
            <span><i class="fa-light fa-angle-right"></i> SubBU</span>
        </li>
    </ul>
    <div class="page-toolbar">
        <a href="javascript:;" class="btn icon_transparent_btn tooltips" id="AddSubBU_btn" data-placement="left" data-original-title="Add SubBU"><i class="fa-solid fa-plus"></i></a>
    </div>
</div>
<!-- Page Bar : End -->
<!-- Ajax Loader : Begin -->
<div id='ajax_loader' class="modal_bg loading" aria-hidden="true">
    <img src="~/LandingAssets/images/loading.gif" style="cursor: auto; width:80px;" />
</div>
<!-- Ajax Loader : End -->
<!-- Body Block : Begin -->
<div class="row">
    <div class="col-lg-12">
        <div class="portlet">
            <div class="portlet-body">
                <div id="tblempty">
                    <div class="table-responsive" id="tableResponsive">
                        <table id="tblsubbuwise" class="new_datatbl table table-striped table-bordered table-hover table-checkable order-column">
                        </table>
                    </div>
                </div>
                <!-- NoDataFound Block : End -->
                <div id="NotificationGrid-empty">
                    <div class="datanotfound">
                        <img src="" height="148" width="280" alt="Nodata Found Icon">
                        <p class="datanotfound_title"></p> <!-- titleText -->
                        <p class=""></p><!-- subText -->
                    </div>
                </div>
                <!-- NoDataFound Block : End -->

            </div>
        </div>
    </div>
</div>
<!-- Body Block : End -->
<!-- Discontinuation Modal : Begin -->
<div id="AddSubBU_btn_modal" class="modal fade" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog w-500">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title" id="SubBUModalTitle">Add SubBU</h4>
            </div>
            <div class="modal-body">
                <div class="modal-card">
                    <div class="row">
                        <input type="hidden" id="hdnSubBUId" value="0" />
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">Business Unit<span class="required" aria-required="true">*</span> </label>
                                <select class="form-control input-sm select2" id="ddlBUName" name="ddlBUName" style="width:100%;">
                                    <option value="">Select Business Unit</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">Sub Business Unit <span class="required" aria-required="true">*</span></label>
                                <input type="text" id="txtSubBUName" maxlength="50" placeholder="Please Enter" class="form-control"  oninput="validateBUName(this)" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-lg-12 text-right">
                        <button type="button" class="btn clear_btn" id="btnClearSubBU"><i class="fa-regular fa-xmark"></i> Clear</button>
                        <button type="button" class="btn save_btn" id="btnSaveSubBU"><i class="fa-regular fa-check"></i> Submit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Discontinuation Modal : End -->
